rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isBootstrapAdminEmail() {
      return isAuth() &&
      request.auth.token.email != null &&
      request.auth.token.email == 'servicioweb.pmi@gmail.com';
    }

    function myRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.exists && userDoc.data.role != null ? userDoc.data.role : null;
    }

    function isAdmin() {
      return isAuth() && (isBootstrapAdminEmail() || myRole() == 'admin');
    }

    function isTrainer() {
      return isAuth() && myRole() == 'trainer';
    }

    function isStaff() {
      return isAuth() && (isAdmin() || isTrainer());
    }

    // ── Usuarios ─────────────────────────────────────────────────────────────

    // Cada usuario puede leer/escribir su propio perfil.
    // Admins pueden leer todos los perfiles.
    // Trainers pueden leer los perfiles de sus clientes asignados.
    // Solo admins pueden cambiar el rol o bloquear/desbloquear.
    // 
    // NOTA: isBlocked NO se verifica en read porque causaría una referencia
    // circular (isBlocked hace get() del mismo documento que se está leyendo).
    // La verificación de bloqueo se aplica en update y create.
    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isTrainer() && resource.data.assignedTrainerId == request.auth.uid)
      );
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && !(resource != null && 'isBlocked' in resource.data && resource.data.isBlocked == true) && (
      // El propio usuario puede actualizar su perfil, excepto role y isBlocked
      (request.auth.uid == userId &&
      !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
      !('isBlocked' in request.resource.data.diff(resource.data).affectedKeys())) ||
      // Admins pueden actualizar cualquier campo (incluyendo role, isBlocked)
      isAdmin()
      );
      allow delete: if isAdmin();
    }


    // ── Rutinas ──────────────────────────────────────────────────────────────
    // Plantillas (clientId == ''): cualquier usuario autenticado puede leerlas.
    // Rutinas asignadas (clientId != ''): el cliente asignado, el trainer creador, o admin.
    // Staff (admin/trainer) puede crear, editar o eliminar.
    match /workouts/{workoutId} {
      allow read: if isAuth() && (
      resource.data.clientId == '' ||
      resource.data.clientId == request.auth.uid ||
      resource.data.trainerId == request.auth.uid ||
      isAdmin()
      );
      allow create: if isAuth() && isStaff();
      allow update: if isAuth() && isStaff();
      allow delete: if isAuth() && isStaff();
    }

    // ── Dietas ───────────────────────────────────────────────────────────────
    // Plantillas (clientId == ''): cualquier usuario autenticado puede leerlas.
    // Dietas asignadas (clientId != ''): el cliente asignado, el trainer creador, o admin.
    // Staff (admin/trainer) puede crear, editar o eliminar.
    match /diets/{dietId} {
      allow read: if isAuth() && (
      resource.data.clientId == '' ||
      resource.data.clientId == request.auth.uid ||
      resource.data.trainerId == request.auth.uid ||
      isAdmin()
      );
      allow create: if isAuth() && isStaff();
      allow update: if isAuth() && isStaff();
      allow delete: if isAuth() && isStaff();
    }

    // ── Progreso ─────────────────────────────────────────────────────────────
    // Cada usuario puede leer/escribir su propio progreso.
    // Trainers pueden leer/escribir el progreso de sus clientes.
    // Admins pueden leer todo (pero no escribir directamente).
    match /progress/{progressId} {
      allow read: if isAuth() && (
      resource.data.userId == request.auth.uid ||
      resource.data.trainerId == request.auth.uid ||
      isAdmin()
      );
      allow create: if isAuth() && (
      request.resource.data.userId == request.auth.uid ||
      isTrainer()
      );
      allow update: if isAuth() && (
      resource.data.userId == request.auth.uid ||
      isTrainer()
      );
      allow delete: if isAdmin();
    }

    // ── Chat ─────────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if isAuth() && (
      resource.data.participants.hasAny([request.auth.uid]) ||
      isAdmin()
      );
    }

    // ── Alertas ──────────────────────────────────────────────────────────────
    // Solo admins pueden gestionar alertas globales.
    // Usuarios autenticados pueden leer alertas activas.
    match /alerts/{alertId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ── Chat History (para métricas/soporte) ─────────────────────────────────
    match /chatHistory/{historyId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}