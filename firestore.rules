rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isBootstrapAdminEmail() {
      return isAuth() &&
      request.auth.token.email != null &&
      (request.auth.token.email == 'servicioweb.pmi@gmail.com' ||
      request.auth.token.email == 'sevicioweb.pmi@gmail.com');
    }

    function myRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.exists && userDoc.data.role != null ? userDoc.data.role : null;
    }

    function isBlocked(uid) {
      let userDoc = get(/databases/$(database)/documents/users/$(uid));
      return userDoc.exists && userDoc.data.isBlocked == true;
    }

    function isAdmin() {
      return isAuth() && (isBootstrapAdminEmail() || myRole() == 'admin');
    }

    function isTrainer() {
      return isAuth() && myRole() == 'trainer';
    }

    function isStaff() {
      return isAuth() && (isAdmin() || isTrainer());
    }

    // ── Usuarios ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isTrainer() && resource.data.assignedTrainerId == request.auth.uid && !isBlocked(userId))
      );
      
      // IMPORTANTE: Permitir crear el documento propio
      // Sin restricciones en los campos que se pueden crear (el registro necesita crear el perfil completo)
      allow create: if isAuth() && request.auth.uid == userId;
      
      allow update: if isAuth() && (
        // El propio usuario puede actualizar su perfil
        (request.auth.uid == userId &&
          // No puede cambiarse el rol a sí mismo (solo si incluye el campo)
          (!('role' in request.resource.data.keys()) || resource.data.role == request.resource.data.role) &&
          // No puede desbloquearse a sí mismo (solo si incluye el campo)
          (!('isBlocked' in request.resource.data.keys()) || resource.data.isBlocked == request.resource.data.isBlocked)) ||
        // Admins pueden actualizar cualquier campo (incluyendo role, isBlocked)
        (isAdmin() && !isBlocked(userId))
      );
      
      allow delete: if isAdmin();
    }


    // ── Rutinas ──────────────────────────────────────────────────────────────
    match /workouts/{workoutId} {
      allow read: if isAuth() && (
      resource.data.clientId == '' ||
      resource.data.clientId == request.auth.uid ||
      resource.data.trainerId == request.auth.uid ||
      isAdmin()
      );
      allow create, update, delete: if isStaff();
    }

    // ── Dietas ───────────────────────────────────────────────────────────────
    match /diets/{dietId} {
      allow read: if isAuth() && (
      resource.data.clientId == '' ||
      resource.data.clientId == request.auth.uid ||
      resource.data.trainerId == request.auth.uid ||
      isAdmin()
      );
      allow create, update, delete: if isStaff();
    }


    // ── Chat (Mensajes) ───────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isAuth() && resource.data.participants.hasAny([request.auth.uid]);

      allow create: if isAuth() && (
      request.resource.data.senderId == request.auth.uid &&
      request.resource.data.participants.hasAny([request.auth.uid]) &&
      request.resource.data.participants.size() == 2
      );

      allow update: if isAuth() && resource.data.participants.hasAny([request.auth.uid]) && (
      request.resource.data.keys().hasOnly(['isRead', 'read', 'updatedAt']) &&
      request.resource.data.isRead == true
      );

      allow delete: if false;
    }

    // ── Progreso (progress_logs) ──────────────────────────────────────────────
    match /progress_logs/{logId} {
      allow read: if isAuth() && (
      resource.data.clientId == request.auth.uid ||
      (isTrainer() && get(/databases/$(database)/documents/users/$(resource.data.clientId)).data.assignedTrainerId == request.auth.uid) ||
      isAdmin()
      );

      allow create: if isAuth() && (
      request.resource.data.clientId == request.auth.uid ||
      isAdmin()
      );

      allow update, delete: if isAuth() && (
      resource.data.clientId == request.auth.uid ||
      isAdmin()
      );
    }

    // ── Biblioteca y Plantillas Semilla ──────────────────────────────────────────
    match /exercise_templates/{templateId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /exercises_library/{exerciseId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /meal_templates/{templateId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /diet_templates/{templateId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /workout_templates/{templateId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }
  }
}