rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de Autorización y Roles ──────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isBootstrapAdminEmail() {
      return isAuth() &&
        request.auth.token.email != null &&
        (request.auth.token.email == 'servicioweb.pmi@gmail.com' ||
         request.auth.token.email == 'sevicioweb.pmi@gmail.com');
    }

    function hasRole(role) {
      return isAuth() && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role == role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role)
      );
    }

    function isAdmin() {
      return isAuth() && (
        isBootstrapAdminEmail() ||
        hasRole('admin')
      );
    }

    function isTrainer() {
      return isAuth() && (
        isAdmin() ||
        hasRole('trainer')
      );
    }

    function isStaff() {
      return isAuth() && (
        isAdmin() ||
        isTrainer()
      );
    }

    // ── Usuarios (/users/{userId}) ──────────────────────────────────────────
    match /users/{userId} {
      // 🔒 CRÍTICO: Permitir lectura si es el propio usuario, admin, staff/trainer,
      // clientes asignados al trainer, o perfiles de trainer/admin consultados.
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isStaff() ||
        resource.data.assignedTrainerId == request.auth.uid ||
        resource.data.role == 'trainer' ||
        resource.data.role == 'admin'
      );

      // 🔒 CRÍTICO: Restringe el rol en create para evitar escalada de privilegios.
      allow create: if isAuth() && (
        (request.auth.uid == userId &&
         (!('role' in request.resource.data) || request.resource.data.role == 'client')) ||
        isAdmin()
      );

      allow update: if isAuth() && (
        // El propio usuario puede actualizar su perfil sin cambiar rol ni bloqueo
        (request.auth.uid == userId &&
          (!('role' in request.resource.data) || resource.data.role == request.resource.data.role) &&
          (!('isBlocked' in request.resource.data) || resource.data.isBlocked == request.resource.data.isBlocked) &&
          (!('assignedTrainerId' in request.resource.data) ||
           (isAdmin() || (isTrainer() && resource.data.assignedTrainerId == request.auth.uid)))) ||
        // Trainers pueden gestionar información de sus clientes asignados
        (isTrainer() && (
          resource.data.role == 'client' &&
          (!('role' in request.resource.data) || request.resource.data.role == 'client')
        )) ||
        // Admins pueden actualizar cualquier campo
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── Rutinas (/workouts/{workoutId}) ──────────────────────────────────────
    match /workouts/{workoutId} {
      // 🔒 CRÍTICO: Permite lectura si es rutina pública, del cliente, o creada/asignada por el trainer/staff
      allow read: if isAuth() && (
        resource.data.clientId == '' ||
        resource.data.clientId == null ||
        resource.data.clientId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        resource.data.assignedBy == request.auth.uid ||
        isStaff()
      );

      // 🔒 CRÍTICO: Trainer o Admin pueden crear rutinas para sus clientes
      allow create: if isAuth() && isStaff() && (
        request.resource.data.trainerId == request.auth.uid ||
        request.resource.data.assignedBy == request.auth.uid ||
        isAdmin()
      );

      // 🔒 CRÍTICO: Trainer propietario o Admin pueden editar y eliminar
      allow update, delete: if isAuth() && (
        (isTrainer() && (resource.data.trainerId == request.auth.uid || resource.data.assignedBy == request.auth.uid)) ||
        isAdmin()
      );
    }

    // ── Dietas (/diets/{dietId}) ─────────────────────────────────────────────
    match /diets/{dietId} {
      // 🔒 CRÍTICO: Permite lectura si es dieta pública, del cliente, o creada/asignada por el trainer/staff
      allow read: if isAuth() && (
        resource.data.clientId == '' ||
        resource.data.clientId == null ||
        resource.data.clientId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        resource.data.assignedBy == request.auth.uid ||
        isStaff()
      );

      // 🔒 CRÍTICO: Trainer o Admin pueden crear dietas para sus clientes
      allow create: if isAuth() && isStaff() && (
        request.resource.data.trainerId == request.auth.uid ||
        request.resource.data.assignedBy == request.auth.uid ||
        isAdmin()
      );

      // 🔒 CRÍTICO: Trainer propietario o Admin pueden editar y eliminar
      allow update, delete: if isAuth() && (
        (isTrainer() && (resource.data.trainerId == request.auth.uid || resource.data.assignedBy == request.auth.uid)) ||
        isAdmin()
      );
    }

    // ── Chat / Mensajes (/messages/{messageId}) ──────────────────────────────
    match /messages/{messageId} {
      allow read: if isAuth() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        (resource.data.participants != null && resource.data.participants.hasAny([request.auth.uid])) ||
        isAdmin()
      );

      allow create: if isAuth() && (
        request.resource.data.senderId == request.auth.uid ||
        (request.resource.data.participants != null && request.resource.data.participants.hasAny([request.auth.uid]))
      );

      allow update: if isAuth() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        (resource.data.participants != null && resource.data.participants.hasAny([request.auth.uid])) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── Progreso (/progress_logs/{logId}) ────────────────────────────────────
    match /progress_logs/{logId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isStaff()
      );

      allow create: if isAuth() && (
        request.resource.data.clientId == request.auth.uid ||
        isStaff()
      );

      allow update, delete: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        (isTrainer() && resource.data.trainerId == request.auth.uid) ||
        isAdmin()
      );
    }

    // ── Plantillas de Rutinas y Dietas ───────────────────────────────────────
    match /workout_templates/{templateId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /diet_templates/{templateId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /exercise_templates/{templateId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /meal_templates/{templateId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    // ── Biblioteca de Ejercicios (/exercises_library/{exerciseId}) ───────────
    match /exercises_library/{exerciseId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Biblioteca de Alimentos (/foods_library/{foodId}) ─────────────────────
    // 🔒 CRÍTICO: Cualquier usuario autenticado puede LEER foods_library.
    // Solo staff (admin/trainer) puede CREAR o ACTUALIZAR alimentos.
    // NUNCA permitir delete físico — soft delete con isActive: false.
    match /foods_library/{foodId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if false; // 🔒 CRÍTICO: Soft delete only. NUNCA delete físico.
    }

    // ── Preferencias de ejercicios del cliente (/user_exercise_prefs/{userId}) ─
    match /user_exercise_prefs/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isStaff()
      );

      allow create, update: if isAuth() && (
        request.auth.uid == userId ||
        isStaff()
      );

      allow delete: if isAdmin();
    }

    // ── Conversaciones (/conversations/{convId}) ─────────────────────────────
    match /conversations/{convId} {
      allow read, write: if isAuth();
    }

    // ── Logs de aplicación (/app_logs/{logId}) ────────────────────────────────
    match /app_logs/{logId} {
      // Solo admins pueden leer logs (contienen emails hash, rutas, errores técnicos)
      allow read: if isAdmin();

      // Solo usuarios autenticados pueden CREAR logs.
      // Se valida coherencia de campos críticos y sanitización básica.
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userRole in ['client', 'trainer', 'admin', 'unknown']
        && request.resource.data.level in ['warn', 'error', 'critical']
        && request.resource.data.timestamp is timestamp
        && request.resource.data.activity is string
        && request.resource.data.action is string
        && request.resource.data.hash is string
        && request.resource.data.sessionId is string
        && request.resource.data.environment is string
        // Sanitización forzada: no se permiten campos sensibles en payload
        && !('password' in request.resource.data.payload)
        && !('token' in request.resource.data.payload)
        && !('secret' in request.resource.data.payload)
        && !('medicalRecord' in request.resource.data.payload)
        && !('diagnosis' in request.resource.data.payload)
        && !('medication' in request.resource.data.payload)
        && !('allergies' in request.resource.data.payload)
        && !('dietaryRestrictions' in request.resource.data.payload);

      // Los logs son inmutables: no se permiten updates.
      allow update: if false;

      // Solo admins pueden eliminar logs.
      allow delete: if isAdmin();
    }

    // ── Deduplicación auxiliar (/app_logs_dedup/{hash}) ───────────────────────
    // Colección interna para control de duplicados. No accesible desde cliente.
    match /app_logs_dedup/{dedupId} {
      allow read: if false;
      allow create: if isAuth() && request.auth.uid == request.resource.data.createdBy;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Tokens rotativos IA (/ia_log_tokens/{tokenId}) ────────────────────────
    // Solo admins pueden gestionar tokens.
    match /ia_log_tokens/{tokenId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Tickets de Soporte (/support_tickets/{ticketId}) ──────────────────────
    // Cualquier usuario autenticado puede crear un ticket de reporte.
    // El reporterUid debe coincidir con el auth.uid del creador.
    // Solo el reporter puede leer su propio ticket (o admins lectura total).
    // Solo admins pueden actualizar (cambiar estado, añadir notas, contactar).
    // No se permite borrado físico (auditable, tickets nunca se eliminan).
    match /support_tickets/{ticketId} {
      allow create: if isAuth()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.category in ['bug', 'misconduct', 'vulnerability', 'inquiry', 'suggestion', 'other']
        && request.resource.data.severity in ['low', 'medium', 'high', 'critical']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastActivityAt is timestamp
        && (!('isAnonymous' in request.resource.data) || request.resource.data.isAnonymous == true || request.resource.data.isAnonymous == false);

      allow read: if isAuth() && (
        // El reporter lee su propio ticket
        request.auth.uid == resource.data.reporterUid ||
        // Admins leen todos los tickets
        isAdmin()
      );

      allow update: if isAdmin() &&
        // Solo admins pueden actualizar (cambiar estado, añadir notas, contactar, etc.)
        // El reporter solo puede actualizar campos específicos si no es anónimo:
        // (NO permitido actualizar description/title una vez creado — el ticket se lockea)
        (true);

      allow delete: if false; // 🔒 CRÍTICO: Los tickets nunca se borran físicamente.
                               // Se cambian de estado a 'closed' cuando se resuelven.
    }

    // ── Propuestas de Personalización de Planes (/plan_proposals/{proposalId}) 
    // Los alumnos pueden crear propuestas para que su entrenador las revise y asesore.
    match /plan_proposals/{proposalId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isStaff()
      );

      // Alumno crea propuesta para su entrenador asignado
      allow create: if isAuth() && (
        request.resource.data.clientId == request.auth.uid &&
        request.resource.data.status == 'pending_review'
      );

      // Entrenador asignado o Admin revisa, aprueba o asesora
      allow update: if isAuth() && (
        (isTrainer() && resource.data.trainerId == request.auth.uid) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }
  }
}