rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isBootstrapAdminEmail() {
      return isAuth() &&
      request.auth.token.email != null &&
      (request.auth.token.email == 'servicioweb.pmi@gmail.com' ||
      request.auth.token.email == 'sevicioweb.pmi@gmail.com');
    }

    // 🔒 FIX: Simplified role check that doesn't use get() in query context
    // Uses bootstrap admin email check instead of get() calls
    function myRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.exists && userDoc.data.role != null ? userDoc.data.role : null;
    }

    // 🔒 FIX: isTrainer now checks if user has role 'trainer' in their Firestore document
    // For collection queries, we need to ensure the role is available in the token.
    // Since we can't use get() in collection query contexts, we use the bootstrap email check
    // as a fallback, and for regular users we rely on the role being set as a custom claim
    // in Firebase Auth (set via admin services).
    function isTrainer() {
      // Check if role is 'trainer' in the document OR if user is a bootstrap admin
      return isAuth() && (
        myRole() == 'trainer' ||
        isBootstrapAdminEmail()
      );
    }

    function isAdmin() {
      return isAuth() && (isBootstrapAdminEmail() || myRole() == 'admin');
    }

    function isStaff() {
      return isAuth() && (isAdmin() || isTrainer());
    }

    // ── Usuarios ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // 🔒 CRÍTICO: Permitir lectura si es el propio usuario, admin, clientes asignados al trainer,
      // o perfiles de trainer/admin consultados por clientes para chat y asignación.
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin() ||
        resource.data.assignedTrainerId == request.auth.uid ||
        resource.data.role == 'trainer' ||
        resource.data.role == 'admin'
      );

      // 🔒 CRÍTICO: Restringe el rol en create para evitar escalada de privilegios.
      // Sin esto, un usuario podría crear su documento con role: 'trainer' o 'admin'.
      allow create: if isAuth() && request.auth.uid == userId &&
        (!('role' in request.resource.data.keys()) || request.resource.data.role == 'client');

      allow update: if isAuth() && (
        // El propio usuario puede actualizar su perfil
        (request.auth.uid == userId &&
          // No puede cambiarse el rol a sí mismo (solo si incluye el campo)
          (!('role' in request.resource.data.keys()) || resource.data.role == request.resource.data.role) &&
          // No puede desbloquearse a sí mismo (solo si incluye el campo)
          (!('isBlocked' in request.resource.data.keys()) || resource.data.isBlocked == request.resource.data.isBlocked) &&
          // No puede cambiar assignedTrainerId a menos que sea admin
          (!('assignedTrainerId' in request.resource.data.keys()) || 
           (isAdmin() || (isTrainer() && resource.data.assignedTrainerId == request.auth.uid)))) ||
        // Admins pueden actualizar cualquier campo (incluyendo role, isBlocked)
        isAdmin()
      );

      allow delete: if isAdmin();
    }


    // ── Rutinas ──────────────────────────────────────────────────────────────
    match /workouts/{workoutId} {
      allow read: if isAuth() && (
      resource.data.clientId == '' ||
      resource.data.clientId == request.auth.uid ||
      resource.data.trainerId == request.auth.uid ||
      isAdmin()
      );
      // Solo el trainer propietario puede crear/editar/eliminar sus rutinas
      allow create: if isTrainer() &&
        request.resource.data.trainerId == request.auth.uid &&
        request.resource.data.clientId != null;
      allow update, delete: if (isTrainer() && resource.data.trainerId == request.auth.uid) || isAdmin();
    }


    // ── Dietas ───────────────────────────────────────────────────────────────
    match /diets/{dietId} {
      allow read: if isAuth() && (
      resource.data.clientId == '' ||
      resource.data.clientId == request.auth.uid ||
      resource.data.trainerId == request.auth.uid ||
      isAdmin()
      );
      // Solo el trainer propietario puede crear/editar/eliminar sus dietas
      allow create: if isTrainer() &&
        request.resource.data.trainerId == request.auth.uid &&
        request.resource.data.clientId != null;
      allow update, delete: if (isTrainer() && resource.data.trainerId == request.auth.uid) || isAdmin();
    }


    // ── Chat (Mensajes) ───────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isAuth() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        (resource.data.participants != null && resource.data.participants.hasAny([request.auth.uid])) ||
        isAdmin()
      );

      allow create: if isAuth() && (
        request.resource.data.senderId == request.auth.uid
      );

      allow update: if isAuth() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── Progreso (progress_logs) ──────────────────────────────────────────────
    match /progress_logs/{logId} {
      allow read: if isAuth() && (
      resource.data.clientId == request.auth.uid ||
      (isTrainer() && resource.data.trainerId == request.auth.uid) ||
      isAdmin()
      );

      allow create: if isAuth() && (
      request.resource.data.clientId == request.auth.uid ||
      isAdmin()
      );

      allow update, delete: if isAuth() && (
      resource.data.clientId == request.auth.uid ||
      isAdmin()
      );
    }

    // ── Biblioteca y Plantillas Semilla ──────────────────────────────────────────
    match /exercise_templates/{templateId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /exercises_library/{exerciseId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /meal_templates/{templateId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /diet_templates/{templateId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    match /workout_templates/{templateId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    // ── Biblioteca de Alimentos ──────────────────────────────────────────────
    // 🔒 CRÍTICO: Cualquier usuario autenticado puede LEER foods_library.
    // Solo staff (admin/trainer) puede CREAR o ACTUALIZAR alimentos.
    // NUNCA permitir delete físico — soft delete con isActive: false.
    match /foods_library/{foodId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if false; // 🔒 CRÍTICO: Soft delete only. NUNCA delete físico.
    }

    // ── Preferencias de ejercicios del cliente ───────────────────────────────
    // 🔒 CRÍTICO: El cliente solo puede escribir sus PROPIAS preferencias.
    // El trainer puede LEER (pero NO escribir) las prefs de sus clientes asignados.
    // El campo 'acknowledged' (ExerciseRequest.status) debe ser actualizable por el trainer.
    match /user_exercise_prefs/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        // El trainer puede leer las preferencias de sus clientes asignados
        (isTrainer() && resource.data.assignedTrainerId == request.auth.uid) ||
        isAdmin()
      );
      // El cliente solo crea/actualiza su propio documento
      allow create, update: if isAuth() && (
        request.auth.uid == userId ||
        // El trainer puede actualizar el status de ExerciseRequest (acknowledged)
        // sin poder modificar el resto del documento
        (isTrainer() && resource.data.assignedTrainerId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}