---
import PublicPageLayout from '@/layouts/PublicPageLayout.astro';
import UICard from '@/components/UICard.astro';
import UILogoIcon from '@/components/UILogoIcon.astro';
import { translations, type Language } from '@/i18n/translations';

import { getLangFromURL } from '@/lib/i18n/server';
const lang = getLangFromURL(Astro.url) as Language;
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<PublicPageLayout currentPath="/register">
  <div class="w-full max-w-sm mx-auto animate-fade-in-scale">
    <!-- Logo -->
    <div class="mb-8 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-[var(--brand-hover)] to-[var(--brand)] shadow-[var(--shadow-glow-md)]">
        <UILogoIcon size="h-7 w-7" class="text-[var(--text-on-brand)]" />
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">{t('app.name')}</h1>
      <p data-i18n="app.tagline" class="mt-1 text-sm font-medium text-[var(--text-secondary)]">{t('app.tagline')}</p>
    </div>

      <!-- Card -->
      <UICard variant="elevated" padding="md" class="animate-pulse-glow">
        <h2 data-i18n="auth.register.title" class="mb-6 text-center text-lg font-semibold text-[var(--text-primary)]">{t('auth.register.title')}</h2>

        <!-- Botón Google -->
        <button
          id="googleBtn"
          class="group flex w-full items-center justify-center gap-3 rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-6 py-3 text-sm font-medium text-[var(--text-secondary)] transition-all duration-200 hover:border-[var(--border-strong)] hover:bg-[var(--surface-3)] hover:text-[var(--text-primary)] active:scale-[0.98]"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <span data-i18n="auth.google.register">{t('auth.google.register')}</span>
        </button>

        <!-- Separador -->
        <div class="my-6 flex items-center gap-3">
          <div class="flex-1 border-t border-[var(--border-subtle)]" />
          <span data-i18n="auth.or" class="text-xs font-medium uppercase tracking-wider text-[var(--text-tertiary)]">{t('auth.or')}</span>
          <div class="flex-1 border-t border-[var(--border-subtle)]" />
        </div>

        <!-- Formulario Email -->
        <form id="registerForm" class="flex flex-col gap-4">
          <!-- Nombre -->
          <div>
            <label for="name" data-i18n="auth.name" class="mb-1.5 block text-sm font-medium text-[var(--text-secondary)]">{t('auth.name')}</label>
            <input
              id="name"
              type="text"
              placeholder={t('auth.name.placeholder')}
              data-i18n-placeholder="auth.name.placeholder"
              required
              autocomplete="name"
              aria-describedby="nameHelp"
              class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-4 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all duration-200 focus:border-[var(--brand)] focus:bg-[var(--surface-3)] focus:shadow-[0_0_0_3px_var(--brand-dim)]"
            />
            <p id="nameHelp" data-i18n="auth.help.name" class="mt-1 text-xs text-[var(--text-tertiary)]">{t('auth.help.name')}</p>
            <p id="nameError" class="mt-1 hidden text-xs text-[var(--danger)]"></p>
          </div>

          <!-- Email -->
          <div>
            <label for="email" data-i18n="auth.email" class="mb-1.5 block text-sm font-medium text-[var(--text-secondary)]">{t('auth.email')}</label>
            <div class="relative">
              <input
                id="email"
                type="email"
                placeholder={t('auth.email.placeholder')}
                data-i18n-placeholder="auth.email.placeholder"
                required
                autocomplete="email"
                aria-describedby="emailHelp"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-4 py-2.5 pr-10 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all duration-200 focus:border-[var(--brand)] focus:bg-[var(--surface-3)] focus:shadow-[0_0_0_3px_var(--brand-dim)]"
              />
              <svg id="emailCheck" class="hidden absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--success)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </div>
            <p id="emailHelp" data-i18n="auth.help.email" class="mt-1 text-xs text-[var(--text-tertiary)]">{t('auth.help.email')}</p>
            <p id="emailError" class="mt-1 hidden text-xs text-[var(--danger)]"></p>
          </div>

          <!-- Contraseña con indicador de fortaleza y toggle -->
          <div>
            <label for="password" data-i18n="auth.password" class="mb-1.5 block text-sm font-medium text-[var(--text-secondary)]">{t('auth.password')}</label>
            <div class="relative">
              <input
                id="password"
                type="password"
                placeholder={t('auth.password.placeholder')}
                data-i18n-placeholder="auth.password.placeholder"
                required
                minlength="6"
                autocomplete="new-password"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-4 py-2.5 pr-20 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all duration-200 focus:border-[var(--brand)] focus:bg-[var(--surface-3)] focus:shadow-[0_0_0_3px_var(--brand-dim)]"
              />
              <div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1">
                <span id="passwordStrength" class="text-xs font-medium text-[var(--text-tertiary)]"></span>
                <button
                  type="button"
                  id="togglePassword"
                  class="rounded-lg p-1.5 text-[var(--text-tertiary)] transition-colors hover:bg-[var(--surface-3)] hover:text-[var(--text-primary)]"
                  aria-label={t('auth.password.show')}
                >
                  <svg id="eyeIcon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  </svg>
                </button>
              </div>
            </div>
            <!-- Requisitos de contraseña -->
            <div class="mt-2 space-y-1">
              <p data-i18n="auth.password.requirements.length" class="text-xs text-[var(--text-tertiary)]">{t('auth.password.requirements.length')}</p>
              <div class="grid grid-cols-3 gap-1.5 text-xs">
                <div id="reqUppercase" class="flex items-center gap-1 text-[var(--text-tertiary)]">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  <span data-i18n="auth.password.requirements.uppercase">{t('auth.password.requirements.uppercase')}</span>
                </div>
                <div id="reqLowercase" class="flex items-center gap-1 text-[var(--text-tertiary)]">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  <span data-i18n="auth.password.requirements.lowercase">{t('auth.password.requirements.lowercase')}</span>
                </div>
                <div id="reqNumber" class="flex items-center gap-1 text-[var(--text-tertiary)]">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  <span data-i18n="auth.password.requirements.number">{t('auth.password.requirements.number')}</span>
                </div>
              </div>
            </div>
            <p id="passwordError" class="mt-1 hidden text-xs text-[var(--danger)]"></p>
          </div>

          <!-- Confirmar contraseña -->
          <div>
            <label for="confirmPassword" data-i18n="auth.password.confirm" class="mb-1.5 block text-sm font-medium text-[var(--text-secondary)]">{t('auth.password.confirm')}</label>
            <div class="relative">
              <input
                id="confirmPassword"
                type="password"
                placeholder={t('auth.password.confirm.placeholder')}
                data-i18n-placeholder="auth.password.confirm.placeholder"
                required
                autocomplete="new-password"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-4 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all duration-200 focus:border-[var(--brand)] focus:bg-[var(--surface-3)] focus:shadow-[0_0_0_3px_var(--brand-dim)]"
              />
            </div>
            <div class="mt-1 flex items-center gap-1.5 text-xs">
              <svg id="confirmCheck" class="hidden h-3.5 w-3.5 text-[var(--success)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span id="confirmText" class="text-[var(--text-tertiary)]"></span>
            </div>
            <p id="confirmError" class="mt-1 hidden text-xs text-[var(--danger)]"></p>
          </div>

          <!-- Términos y condiciones -->
          <div class="flex items-start gap-2">
            <input
              id="terms"
              type="checkbox"
              required
              class="mt-0.5 h-4 w-4 rounded-lg border border-[var(--border-default)] bg-[var(--surface-2)] text-[var(--brand)] focus:ring-2 focus:ring-[var(--brand-dim)] focus:ring-offset-0"
            />
            <label for="terms" class="text-xs text-[var(--text-secondary)]">
              <span data-i18n="auth.terms">{t('auth.terms')}</span>{' '}
              <a href="/terms" target="_blank" data-i18n="auth.terms.link" class="font-medium text-[var(--brand)] hover:text-[var(--brand-hover)] underline">
                {t('auth.terms.link')}
              </a>
            </label>
          </div>
          <p id="termsError" class="hidden text-xs text-[var(--danger)]"></p>

          <!-- Botón Submit -->
          <button
            id="registerBtn"
            type="submit"
            data-i18n="auth.register.btn"
            class="mt-2 flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-6 py-3 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all duration-200 hover:shadow-[var(--shadow-glow-md)] hover:brightness-105 active:scale-[0.98] disabled:opacity-50 disabled:pointer-events-none"
          >
            {t('auth.register.btn')}
          </button>
        </form>

      <!-- Error -->
      <div id="errorMsg" class="mt-5 hidden items-center gap-2 rounded-xl bg-[var(--danger-dim)] border border-[var(--danger)] px-4 py-3 text-sm text-[var(--danger)]">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
        </svg>
        <span id="errorText"></span>
      </div>
    </UICard>

    <p class="mt-8 text-center text-sm text-[var(--text-tertiary)]">
      <span data-i18n="auth.has.account">{t('auth.has.account')}</span>
      <a href="/login" data-i18n="auth.login.link" class="font-medium text-[var(--brand)] transition-colors duration-200 hover:text-[var(--brand-hover)]">{t('auth.login.link')}</a>
    </p>
  </div>
</PublicPageLayout>

<script>
  import { authService } from '@/services/authService';
  import { setUser, setAuthLoading } from '@/stores/authStore';
  import { isValidEmail, isValidPassword, isValidName } from '@/lib/validators';
  import { t } from '@/i18n/client';
  import type { FirebaseError } from 'firebase/app';
  // Nota: No redirigimos automáticamente al cargar /register para evitar loops con el guard de dashboard.

  const nameInput = document.getElementById('name') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const emailCheck = document.getElementById('emailCheck');
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const registerForm = document.getElementById('registerForm') as HTMLFormElement;
  const registerBtn = document.getElementById('registerBtn') as HTMLButtonElement;
  const googleBtn = document.getElementById('googleBtn') as HTMLButtonElement;
  const errorMsg = document.getElementById('errorMsg') as HTMLDivElement;
  const errorText = document.getElementById('errorText') as HTMLSpanElement;
  const termsCheckbox = document.getElementById('terms') as HTMLInputElement;

  const nameError = document.getElementById('nameError') as HTMLParagraphElement;
  const emailError = document.getElementById('emailError') as HTMLParagraphElement;
  const passwordError = document.getElementById('passwordError') as HTMLParagraphElement;
  const termsError = document.getElementById('termsError') as HTMLParagraphElement;

  function showFieldError(el: HTMLParagraphElement, msg: string) {
    el.textContent = msg;
    el.classList.remove('hidden');
  }

  function hideFieldErrors() {
    [nameError, emailError, passwordError, termsError].forEach((el) => {
      el.classList.add('hidden');
    });
  }

  function showError(msg: string) {
    errorText.textContent = msg;
    errorMsg.classList.remove('hidden');
    errorMsg.classList.add('flex');
  }

  function hideError() {
    errorMsg.classList.add('hidden');
    errorMsg.classList.remove('flex');
  }

  function redirectByRole(role: string) {
    if (role === 'client') {
      window.location.href = '/onboarding';
      return;
    }
    const routes: Record<string, string> = {
      admin: '/dashboard',
      trainer: '/dashboard',
    };
    window.location.href = routes[role] || '/onboarding';
  }

  // 🔍 Indicador de fortaleza de contraseña
  const passwordStrength = document.getElementById('passwordStrength') as HTMLSpanElement;
  const reqUppercase = document.getElementById('reqUppercase');
  const reqLowercase = document.getElementById('reqLowercase');
  const reqNumber = document.getElementById('reqNumber');
  const confirmPasswordInput = document.getElementById('confirmPassword') as HTMLInputElement;
  const confirmCheck = document.getElementById('confirmCheck');
  const confirmText = document.getElementById('confirmText');
  const confirmError = document.getElementById('confirmError');
  const togglePasswordBtn = document.getElementById('togglePassword');
  const eyeIcon = document.getElementById('eyeIcon');

  function updatePasswordStrength(password: string) {
    const hasUppercase = /[A-Z]/.test(password);
    const hasLowercase = /[a-z]/.test(password);
    const hasNumber = /[0-9]/.test(password);
    const hasLength = password.length >= 8;

    // Actualizar iconos de requisitos
    if (reqUppercase) {
      reqUppercase.classList.toggle('text-[var(--success)]', hasUppercase);
      reqUppercase.classList.toggle('text-[var(--text-tertiary)]', !hasUppercase);
    }
    if (reqLowercase) {
      reqLowercase.classList.toggle('text-[var(--success)]', hasLowercase);
      reqLowercase.classList.toggle('text-[var(--text-tertiary)]', !hasLowercase);
    }
    if (reqNumber) {
      reqNumber.classList.toggle('text-[var(--success)]', hasNumber);
      reqNumber.classList.toggle('text-[var(--text-tertiary)]', !hasNumber);
    }

    // Calcular fortaleza
    const score = [hasUppercase, hasLowercase, hasNumber, hasLength].filter(Boolean).length;
    let strength = '';
    let color = '';

    if (password.length === 0) {
      strength = '';
      color = '';
    } else if (score <= 2) {
      strength = t('auth.password.weak');
      color = 'text-[var(--danger)]';
    } else if (score === 3) {
      strength = t('auth.password.fair');
      color = 'text-[var(--warning)]';
    } else if (score === 4 && password.length >= 8) {
      strength = t('auth.password.good');
      color = 'text-[var(--info)]';
    } else {
      strength = t('auth.password.strong');
      color = 'text-[var(--success)]';
    }

    if (passwordStrength) {
      passwordStrength.textContent = strength;
      passwordStrength.className = `text-xs font-medium ${color}`;
    }

    // Actualizar validación de confirmación si hay texto
    if (confirmPasswordInput.value) {
      updateConfirmValidation();
    }
  }

  function updateConfirmValidation() {
    const password = passwordInput.value;
    const confirm = confirmPasswordInput.value;

    if (!confirm) {
      if (confirmCheck) confirmCheck.classList.add('hidden');
      if (confirmText) confirmText.textContent = '';
      if (confirmError) confirmError.classList.add('hidden');
      return;
    }

    const matches = password === confirm;
    if (confirmCheck) {
      confirmCheck.classList.toggle('hidden', !matches);
      confirmCheck.classList.toggle('text-[var(--success)]', matches);
      confirmCheck.classList.toggle('text-[var(--danger)]', !matches);
    }
    if (confirmText) {
      confirmText.textContent = matches ? t('auth.password.confirm.placeholder') : t('auth.password.mismatch');
      confirmText.className = matches ? 'text-xs text-[var(--success)]' : 'text-xs text-[var(--danger)]';
    }
    if (confirmError) {
      confirmError.classList.toggle('hidden', matches);
    }
  }

  // Validación de email en tiempo real
  emailInput.addEventListener('input', (e) => {
    const email = (e.target as HTMLInputElement).value.trim();
    if (email && isValidEmail(email)) {
      emailCheck?.classList.remove('hidden');
    } else {
      emailCheck?.classList.add('hidden');
    }
  });

  passwordInput.addEventListener('input', (e) => {
    updatePasswordStrength((e.target as HTMLInputElement).value);
  });

  confirmPasswordInput.addEventListener('input', () => {
    updateConfirmValidation();
  });

  // Toggle mostrar/ocultar contraseña
  if (togglePasswordBtn && passwordInput) {
    togglePasswordBtn.addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      if (confirmPasswordInput) confirmPasswordInput.type = isPassword ? 'text' : 'password';
      
      if (eyeIcon) {
        eyeIcon.innerHTML = isPassword
          ? '<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3.68 3.68m12.728 12.728L21 21m-3.75-9.75a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />'
          : '<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />';
      }
      
      if (togglePasswordBtn) {
        togglePasswordBtn.setAttribute('aria-label', isPassword ? t('auth.password.hide') : t('auth.password.show'));
      }
    });
  }

  registerForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    hideFieldErrors();

    const name = nameInput.value.trim();
    const email = emailInput.value.trim();
    const password = passwordInput.value;

    let hasError = false;

    const nameValidation = isValidName(name);
    if (!nameValidation.valid) {
      showFieldError(nameError, nameValidation.error!);
      hasError = true;
    }

    if (!isValidEmail(email)) {
      showFieldError(emailError, t('auth.email.error.invalid'));
      hasError = true;
    }

    const passwordValidation = isValidPassword(password);
    if (!passwordValidation.valid) {
      showFieldError(passwordError, passwordValidation.errors[0]!);
      hasError = true;
    }

    // Validar que las contraseñas coincidan
    const confirmPassword = confirmPasswordInput.value;
    if (password !== confirmPassword) {
      if (confirmError instanceof HTMLParagraphElement) {
        showFieldError(confirmError, t('auth.password.mismatch'));
      }
      hasError = true;
    }

    // Validar términos y condiciones
    if (!termsCheckbox.checked) {
      if (termsError instanceof HTMLParagraphElement) {
        showFieldError(termsError, t('auth.terms.required'));
      }
      hasError = true;
    }

    if (hasError) return;

    registerBtn.disabled = true;
    registerBtn.innerHTML = `<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg> ${t('auth.loading.register')}`;

    try {
      const user = await authService.registerUser(name, email, password);
      setUser(user);
      setAuthLoading(false);

      // 🔒 CRÍTICO: Pasar datos del formulario al onboarding via sessionStorage
      sessionStorage.setItem('registerFormData', JSON.stringify({
        name: name || null,
        email: email || null,
      }));

      redirectByRole(user.role);
    } catch (err: unknown) {
      const fbErr = err as FirebaseError & { message?: string };
      const code = fbErr.code || fbErr.message || '';
      const messages: Record<string, string> = {
        'auth/email-already-in-use': t('error.email-in-use'),
        'auth/invalid-email': t('error.invalid-email'),
        'auth/weak-password': t('error.weak-password'),
        'auth/operation-not-allowed': t('error.operation-not-allowed'),
      };
      showError(messages[code] || t('error.default.register'));
    } finally {
      registerBtn.disabled = false;
      registerBtn.textContent = t('auth.register.btn');
    }
  });

  googleBtn.addEventListener('click', async () => {
    hideError();
    googleBtn.disabled = true;
    googleBtn.textContent = t('auth.loading.google');

    try {
      const user = await authService.loginWithGoogle();
      setUser(user);
      setAuthLoading(false);

      // 🔒 CRÍTICO: Pasar datos extra de Google al onboarding via sessionStorage
      if (user.role === 'client') {
        const gd = {
          firstName: user.firstName || null,
          lastName: user.lastName || null,
          fullName: user.name || null,
          photoURL: user.photoURL || null,
          preferredLanguage: user.preferredLanguage || null,
          phoneNumber: user.phoneNumber || null,
          emailVerified: user.emailVerified,
        };
        sessionStorage.setItem('googleAuthData', JSON.stringify(gd));
      }

      redirectByRole(user.role);
    } catch (err: unknown) {
      const fbErr = err as FirebaseError;
      const code = fbErr.code || '';
      if (code !== 'auth/popup-closed-by-user' && code !== 'auth/cancelled-popup-request') {
        showError(t('error.google.register'));
      }
    } finally {
      googleBtn.disabled = false;
      googleBtn.innerHTML = `
        <svg class="h-5 w-5" viewBox="0 0 24 24">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        ${t('auth.google.register')}
      `;
    }
  });
</script>