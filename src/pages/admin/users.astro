---
import AdminLayout from "@/layouts/AdminLayout.astro";
import ConfirmModal from "@/components/ConfirmModal.astro";
import SkeletonGroup from "@/components/SkeletonGroup.astro";
import PageTransition from "@/components/PageTransition.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<AdminLayout>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <PageTransition animation="fade-up" stagger>
      <!-- Header -->
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h1 data-i18n="admin.users" class="text-2xl font-bold">{t("admin.users")}</h1>
          <p data-i18n="admin.users.desc" class="mt-1 text-sm text-[var(--text-tertiary)]">{t("admin.users.desc")}</p>
        </div>
        <!-- Contadores de métricas -->
        <div class="flex items-center gap-2 text-xs">
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5">
            <span id="stat-total" class="font-semibold text-[var(--text-primary)]">0</span>
            <span class="text-[var(--text-tertiary)]"> {t("admin.users.total")}</span>
          </div>
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5">
            <span id="stat-clients" class="font-semibold text-[var(--brand)]">0</span>
            <span class="text-[var(--text-tertiary)]"> {t("admin.users.clientsShort")}</span>
          </div>
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5">
            <span id="stat-unassigned" class="font-semibold text-[var(--warning)]">0</span>
            <span class="text-[var(--text-tertiary)]"> ⚠️</span>
          </div>
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5">
            <span id="stat-blocked" class="font-semibold text-[var(--danger)]">0</span>
            <span class="text-[var(--text-tertiary)]"> 🔒</span>
          </div>
        </div>
      </div>

      <!-- Filtros de alta precisión -->
      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <!-- Búsqueda -->
        <div class="relative">
          <svg
            class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--text-tertiary)]"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
            ></path>
          </svg>
          <input
            id="search-input"
            type="text"
            placeholder={t("admin.search")}
            data-i18n-placeholder="admin.search"
            class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] py-2.5 pl-10 pr-4 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm transition-all focus:border-[var(--border-brand)] focus:outline-none focus:ring-1 focus:ring-[var(--brand-dim)]"
          />
        </div>
        <!-- Filtro por rol -->
        <select
          id="role-filter"
          class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2.5 text-sm text-[var(--text-secondary)] backdrop-blur-sm"
        >
          <option value="all" data-i18n="admin.all">{t("admin.all")}</option>
          <option value="client">Clientes</option>
          <option value="trainer">Entrenadores</option>
          <option value="admin">Admins</option>
        </select>
        <!-- Filtro por estado -->
        <select
          id="status-filter"
          class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2.5 text-sm text-[var(--text-secondary)] backdrop-blur-sm"
        >
          <option value="all" data-i18n="admin.all">{t("admin.all")}</option>
          <option value="active">{t("admin.users.onlyActive")}</option>
          <option value="blocked">{t("admin.users.onlyBlocked")}</option>
        </select>
      </div>

      <!-- Filtro por asignación de entrenador -->
      <div class="mt-3 flex items-center gap-2">
        <span class="text-xs text-[var(--text-tertiary)]">{t("admin.users.trainerAssign")}:</span>
        <select
          id="trainer-assign-filter"
          class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2 text-sm text-[var(--text-secondary)] backdrop-blur-sm"
        >
          <option value="all" data-i18n="admin.all">{t("admin.all")}</option>
          <option value="assigned">{t("admin.users.withTrainer")}</option>
          <option value="unassigned">⚠️ {t("admin.users.withoutTrainer")}</option>
        </select>
      </div>

      <!-- Users list -->
      <div id="users-container" class="mt-4 space-y-3">
        <SkeletonGroup variant="list" />
      </div>
    </PageTransition>
  </div>

  <!-- ==================== USER EDIT MODAL ==================== -->
  <div id="user-modal-overlay" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm">
    <div class="flex min-h-full items-center justify-center p-4">
      <div
        class="w-full max-w-lg rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 shadow-2xl backdrop-blur-xl"
      >
        <!-- Modal header -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div
              id="modal-avatar"
              class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--brand-dim)] text-sm font-medium text-[var(--brand)]"
            >
              ?
            </div>
            <div>
              <h3 id="modal-title" data-i18n="admin.modal.edit.title" class="text-lg font-semibold text-[var(--text-primary)]">
                {t("admin.modal.edit.title")}
              </h3>
              <p id="modal-role-badge" class="text-xs text-[var(--text-tertiary)]">—</p>
            </div>
          </div>
          <button
            data-action="close-user-modal"
            class="rounded-lg p-1.5 text-[var(--text-tertiary)] hover:text-[var(--text-secondary)] hover:bg-[var(--surface-3)] transition-all"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <div id="modal-body" class="mt-6 space-y-4">
          <!-- Name -->
          <div>
            <label data-i18n="admin.modal.field.name" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5"
              >{t("admin.modal.field.name")}</label
            >
            <input
              id="modal-name"
              type="text"
              class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm transition-all focus:border-[var(--border-brand)] focus:outline-none focus:ring-1 focus:ring-[var(--brand-dim)]"
            />
          </div>

          <!-- Email -->
          <div>
            <label data-i18n="admin.modal.field.email" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5"
              >{t("admin.modal.field.email")}</label
            >
            <input
              id="modal-email"
              type="email"
              class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm transition-all focus:border-[var(--border-brand)] focus:outline-none focus:ring-1 focus:ring-[var(--brand-dim)]"
            />
          </div>

          <!-- Role -->
          <div>
            <label data-i18n="admin.modal.field.role" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5"
              >{t("admin.modal.field.role")}</label
            >
            <select
              id="modal-role"
              class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] backdrop-blur-sm transition-all focus:border-[var(--border-brand)] focus:outline-none focus:ring-1 focus:ring-[var(--brand-dim)]"
            >
              <option value="admin">Admin</option>
              <option value="trainer">Trainer</option>
              <option value="client">Client</option>
            </select>
          </div>

          <!-- Trainer Assignment -->
          <div id="modal-trainer-field" class="hidden">
            <label data-i18n="admin.modal.field.trainer" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5"
              >{t("admin.modal.field.trainer")}</label
            >
            <select
              id="modal-trainer"
              class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] backdrop-blur-sm transition-all focus:border-[var(--border-brand)] focus:outline-none focus:ring-1 focus:ring-[var(--brand-dim)]"
            >
              <option value="" data-i18n="admin.modal.trainer.none">{t("admin.modal.trainer.none")}</option>
            </select>
          </div>

          <!-- Block/Unblock toggle -->
          <div
            id="modal-block-field"
            class="flex items-center justify-between rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-4)] p-3"
          >
            <div>
              <p data-i18n="admin.modal.blocked" class="text-sm font-medium text-[var(--text-secondary)]">
                {t("admin.modal.blocked")}
              </p>
              <p id="modal-block-info" data-i18n="admin.modal.blocked.info" class="text-xs text-[var(--text-tertiary)]">
                {t("admin.modal.blocked.info")}
              </p>
            </div>
            <button
              id="modal-block-btn"
              data-action="toggle-block-user"
              data-i18n="admin.modal.block.btn"
              class="rounded-lg px-3 py-1.5 text-xs font-medium transition-all"
            >
              {t("admin.modal.block.btn")}
            </button>
          </div>

          <!-- Info: created at, last update -->
          <div
            id="modal-info"
            class="flex justify-between text-xs text-[var(--text-disabled)] pt-1"
          >
            <span id="modal-created-at">—</span>
            <span id="modal-updated-at">—</span>
          </div>

          <!-- Acceso directo a planes del usuario -->
          <div id="modal-plans" class="hidden grid grid-cols-2 gap-2 pt-1">
            <a
              id="modal-workouts-link"
              href="#"
              class="flex items-center justify-center gap-1.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-xs font-medium text-[var(--text-secondary)] transition-all hover:border-[var(--border-brand)]"
            >
              🏋️ {t("admin.modal.viewWorkouts")}
            </a>
            <a
              id="modal-diets-link"
              href="#"
              class="flex items-center justify-center gap-1.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-xs font-medium text-[var(--text-secondary)] transition-all hover:border-[var(--border-brand)]"
            >
              🥗 {t("admin.modal.viewDiets")}
            </a>
          </div>

          <!-- Primary actions -->
          <div class="flex flex-col gap-2 pt-2">
            <div class="flex gap-2">
              <button
                id="modal-save-btn"
                data-action="save-user-edit"
                data-i18n="admin.modal.save"
                class="flex-1 rounded-xl bg-[var(--brand)] px-4 py-2.5 text-sm font-medium text-[var(--text-on-brand)] transition-all hover:bg-[var(--brand-hover)] active:scale-[0.98]"
              >
                {t("admin.modal.save")}
              </button>
              <button
                data-action="close-user-modal"
                data-i18n="admin.modal.cancel"
                class="flex-1 rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-4 py-2.5 text-sm font-medium text-[var(--text-secondary)] transition-all hover:bg-[var(--surface-3)]"
              >
                {t("admin.modal.cancel")}
              </button>
            </div>

            <!-- Secondary actions -->
            <div class="grid grid-cols-2 gap-2 pt-1">
              <button
                id="modal-view-medical-btn"
                data-action="view-medical-profile"
                class="rounded-xl border border-blue-700/30 bg-[var(--info-dim)] px-4 py-2 text-xs font-medium text-[var(--info)] transition-all hover:bg-blue-500/20 hidden"
              >
                <svg
                  class="h-3.5 w-3.5 inline-block mr-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"
                  ></path>
                </svg>
                {t("admin.modal.medical")}
              </button>
              <button
                id="modal-reset-pwd-btn"
                data-action="reset-user-password"
                class="rounded-xl border border-amber-700/30 bg-amber-500/10 px-4 py-2 text-xs font-medium text-amber-400 transition-all hover:bg-amber-500/20"
              >
                <svg
                  class="h-3.5 w-3.5 inline-block mr-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182"
                  ></path>
                </svg>
                {t("admin.modal.reset.pwd")}
              </button>
              <button
                id="modal-delete-btn"
                data-action="delete-current-user"
                class="rounded-xl border border-red-900/30 bg-[var(--danger-dim)] px-4 py-2 text-xs font-medium text-[var(--danger)] transition-all hover:bg-[var(--danger-dim)]"
              >
                <svg
                  class="h-3.5 w-3.5 inline-block mr-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"
                  ></path>
                </svg>
                {t("admin.modal.delete")}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== MEDICAL PROFILE MODAL ==================== -->
  <div id="medical-modal-overlay" class="fixed inset-0 z-[60] hidden bg-black/60 backdrop-blur-sm">
    <div class="flex min-h-full items-center justify-center p-4">
      <div
        class="w-full max-w-lg rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 shadow-2xl backdrop-blur-xl"
      >
        <div class="flex items-center justify-between">
          <h3 data-i18n="admin.modal.medical" class="text-lg font-semibold text-[var(--text-primary)]">{t("admin.modal.medical")}</h3>
          <button
            data-action="close-medical-modal"
            class="rounded-lg p-1.5 text-[var(--text-tertiary)] hover:text-[var(--text-secondary)] hover:bg-[var(--surface-3)] transition-all"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div id="medical-modal-body" class="mt-4 space-y-3 text-sm text-[var(--text-secondary)]">
          <p data-i18n="admin.loading" class="text-[var(--text-tertiary)]">{t("admin.loading")}</p>
        </div>
      </div>
    </div>
  </div>

  <ConfirmModal />
</AdminLayout>

<script>
  import { logger } from "@/lib/shared/logger";
  import { requireAdmin } from "@/lib/shared/authGuard";
  import {
    subscribeToUsers,
    subscribeToTrainers,
    subscribeToWorkoutCounts,
    subscribeToDietCounts,
    renderUserCardExtended,
    initGlobalActions,
    updateUserProfile,
    deleteUser,
    toggleUserBlock,
    type AdminUser,
    type TrainerOption,
  } from "@/lib/admin/adminUtils";
  import {
    ICONS,
    showToast,
    showConfirm,
    escapeHtml,
    formatDate,
    getRoleBadge,
    renderEmptyState,
  } from "@/lib/shared/ui";
  import { doc, getDoc } from "firebase/firestore";
  import { db } from "@/lib/firebase";
  import { sendPasswordResetEmail } from "firebase/auth";
  import { auth } from "@/lib/firebase";
  import { t } from "@/i18n/client";

  // === State ===
  let unsubUsers: (() => void) | null = null;
  let unsubTrainers: (() => void) | null = null;
  let unsubWorkouts: (() => void) | null = null;
  let unsubDiets: (() => void) | null = null;
  let allUsers: AdminUser[] = [];
  let allTrainers: { uid: string; name: string }[] = [];
  let trainerNameMap: Map<string, string> = new Map();
  let workoutCounts: Map<string, number> = new Map();
  let dietCounts: Map<string, number> = new Map();
  let editingUserId: string | null = null;

  requireAdmin(() => {
    initUsers();
    initEventDelegation();
  });

  // Cleanup subscriptions on page unload
  window.addEventListener("beforeunload", () => {
    unsubUsers?.();
    unsubTrainers?.();
    unsubWorkouts?.();
    unsubDiets?.();
  });

  // === Event Delegation (replaces window.__* globals) ===
  function initEventDelegation(): void {
    document.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest("[data-action]") as HTMLElement | null;
      if (!btn) return;

      const action = btn.dataset.action;

      switch (action) {
        case "close-user-modal":
          closeUserModal();
          break;
        case "close-medical-modal":
          closeMedicalModal();
          break;
        case "save-user-edit":
          await saveUserEdit();
          break;
        case "toggle-block-user":
          await toggleBlockUser();
          break;
        case "view-medical-profile":
          await viewMedicalProfile();
          break;
        case "reset-user-password":
          await resetUserPassword();
          break;
        case "delete-current-user":
          await deleteCurrentUser();
          break;
      }
    });
  }

  // === Init ===
  function initUsers(): void {
    const container = document.getElementById("users-container")!;
    const roleFilter = document.getElementById("role-filter") as HTMLSelectElement;
    const statusFilter = document.getElementById("status-filter") as HTMLSelectElement;
    const trainerAssignFilter = document.getElementById("trainer-assign-filter") as HTMLSelectElement;
    const searchInput = document.getElementById("search-input") as HTMLInputElement;

    // Leer posibles filtros iniciales por URL (?role=trainer / ?role=client)
    const urlParams = new URLSearchParams(window.location.search);
    const roleParam = urlParams.get("role");
    if (roleParam && roleFilter && ["client", "trainer", "admin"].includes(roleParam)) {
      roleFilter.value = roleParam;
    }

    let searchTimeout: ReturnType<typeof setTimeout> | null = null;

    // Enriquecer usuarios con nombre de entrenador y conteos de planes
    function enrichUsers(): AdminUser[] {
      return allUsers.map((u) => ({
        ...u,
        assignedTrainerName: u.assignedTrainerId ? trainerNameMap.get(u.assignedTrainerId) || u.assignedTrainerId : undefined,
        workoutsCount: u.role === "client" ? (workoutCounts.get(u.uid) ?? 0) : undefined,
        dietsCount: u.role === "client" ? (dietCounts.get(u.uid) ?? 0) : undefined,
      }));
    }

    function renderUsers(): void {
      const roleVal = roleFilter.value;
      const statusVal = statusFilter.value;
      const assignVal = trainerAssignFilter.value;
      const query = searchInput.value.trim().toLowerCase();

      const enriched = enrichUsers();
      let filtered = enriched;

      if (roleVal !== "all") filtered = filtered.filter((u) => u.role === roleVal);
      if (statusVal === "active") filtered = filtered.filter((u) => !u.isBlocked);
      if (statusVal === "blocked") filtered = filtered.filter((u) => u.isBlocked);
      if (assignVal === "assigned") filtered = filtered.filter((u) => !!u.assignedTrainerId);
      if (assignVal === "unassigned") filtered = filtered.filter((u) => !u.assignedTrainerId);

      if (query) {
        filtered = filtered.filter(
          (u) =>
            u.name.toLowerCase().includes(query) ||
            u.email.toLowerCase().includes(query) ||
            (u.assignedTrainerName || "").toLowerCase().includes(query),
        );
      }

      // Contadores (sobre el total enriquecido, no sobre el filtrado)
      const totalEl = document.getElementById("stat-total");
      const clientsEl = document.getElementById("stat-clients");
      const unassignedEl = document.getElementById("stat-unassigned");
      const blockedEl = document.getElementById("stat-blocked");
      if (totalEl) totalEl.textContent = String(enriched.length);
      if (clientsEl) clientsEl.textContent = String(enriched.filter((u) => u.role === "client").length);
      if (unassignedEl) unassignedEl.textContent = String(enriched.filter((u) => u.role === "client" && !u.assignedTrainerId).length);
      if (blockedEl) blockedEl.textContent = String(enriched.filter((u) => u.isBlocked).length);

      if (filtered.length === 0) {
        const message = query
          ? `${t("common.noResults")} "${searchInput.value.trim()}"`
          : t("common.noData");
        container.innerHTML = renderEmptyState(ICONS.users, message);
        return;
      }

      container.innerHTML = filtered.map((user) => renderUserCardExtended(user, true)).join("");

      initGlobalActions("admin");
      // Open modal when clicking user card or edit button
      document.querySelectorAll("[data-user-card]").forEach((card) => {
        card.addEventListener("click", () => {
          const uid = (card as HTMLElement).dataset.uid;
          if (uid) openUserModal(uid);
        });
      });

      document.querySelectorAll("[data-edit-user]").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const uid = (btn as HTMLElement).dataset.uid;
          if (uid) openUserModal(uid);
        });
      });
    }

    // Load trainers + admins for assignment dropdown
    unsubTrainers = subscribeToTrainers((trainers) => {
      allTrainers = trainers;
      trainerNameMap = new Map(trainers.map((tr) => [tr.uid, tr.name]));
      updateTrainerSelect();
      renderUsers();
    });

    unsubWorkouts = subscribeToWorkoutCounts((counts) => {
      workoutCounts = counts;
      renderUsers();
    });

    unsubDiets = subscribeToDietCounts((counts) => {
      dietCounts = counts;
      renderUsers();
    });

    unsubUsers = subscribeToUsers((users) => {
      allUsers = users;
      renderUsers();
    });

    roleFilter.addEventListener("change", renderUsers);
    statusFilter.addEventListener("change", renderUsers);
    trainerAssignFilter.addEventListener("change", renderUsers);

    searchInput.addEventListener("input", () => {
      if (searchTimeout) clearTimeout(searchTimeout);
      searchTimeout = setTimeout(renderUsers, 200);
    });
  }

  // === Modal Functions ===
  function openUserModal(uid: string): void {
    const user = allUsers.find((u) => u.uid === uid);
    if (!user) return;

    editingUserId = uid;

    // Set avatar
    const avatar = document.getElementById("modal-avatar")!;
    avatar.textContent = (user.name || "?").charAt(0).toUpperCase();

    // Set title
    document.getElementById("modal-title")!.textContent = user.name || t("common.unnamed");

    // Set role badge
    const badge = getRoleBadge(user.role);
    document.getElementById("modal-role-badge")!.innerHTML =
      `<span class="rounded-full px-2 py-0.5 text-xs font-medium ${badge.class}">${badge.label}</span>`;

    // Set form fields
    (document.getElementById("modal-name") as HTMLInputElement).value = user.name;
    (document.getElementById("modal-email") as HTMLInputElement).value = user.email;
    (document.getElementById("modal-role") as HTMLSelectElement).value = user.role;

    // Show/hide trainer field based on role
    const trainerField = document.getElementById("modal-trainer-field")!;
    if (user.role === "client" || user.role === "admin") {
      trainerField.classList.remove("hidden");
      const trainerSelect = document.getElementById("modal-trainer") as HTMLSelectElement;
      trainerSelect.value = user.assignedTrainerId || "";
    } else {
      trainerField.classList.add("hidden");
    }

    // Show medical profile button only for clients
    const medicalBtn = document.getElementById("modal-view-medical-btn")!;
    medicalBtn.classList.toggle("hidden", user.role !== "client");

    // Block/Unblock button
    const blockBtn = document.getElementById("modal-block-btn")!;
    const blockInfo = document.getElementById("modal-block-info")!;
    if (user.isBlocked) {
      blockBtn.textContent = t("admin.user.unblock");
      blockBtn.className =
        "rounded-lg px-3 py-1.5 text-xs font-medium bg-[var(--brand-dim)] text-[var(--brand)] border border-[var(--border-brand)] hover:bg-[var(--brand-dim)] transition-all";
      blockInfo.textContent = `${t("admin.user.blockedOn")} ${user.blockedAt ? formatDate(user.blockedAt) : "—"}`;
    } else {
      blockBtn.textContent = t("admin.user.block");
      blockBtn.className =
        "rounded-lg px-3 py-1.5 text-xs font-medium bg-[var(--danger-dim)] text-[var(--danger)] border border-[var(--danger)] hover:bg-[var(--danger-dim)] transition-all";
      blockInfo.textContent = t("admin.modal.blocked.info");
    }

    // Info dates
    document.getElementById("modal-created-at")!.textContent =
      `${t("admin.created")}: ${formatDate(user.createdAt)}`;
    document.getElementById("modal-updated-at")!.textContent =
      `${t("admin.updated")}: ${formatDate(user.updatedAt)}`;

    // Enlaces directos a planes (solo para clientes)
    const plansBox = document.getElementById("modal-plans")!;
    const workoutsLink = document.getElementById("modal-workouts-link") as HTMLAnchorElement;
    const dietsLink = document.getElementById("modal-diets-link") as HTMLAnchorElement;
    if (user.role === "client") {
      plansBox.classList.remove("hidden");
      workoutsLink.href = `/admin/workouts?clientId=${user.uid}`;
      dietsLink.href = `/admin/diets?clientId=${user.uid}`;
    } else {
      plansBox.classList.add("hidden");
    }

    // Update trainer list
    updateTrainerSelect();

    document.getElementById("user-modal-overlay")!.classList.remove("hidden");
  }

  function updateTrainerSelect(): void {
    const select = document.getElementById("modal-trainer") as HTMLSelectElement;
    if (!select) return;
    const currentValue = select.value;
    select.innerHTML = `<option value="">${t("admin.modal.trainer.none")}</option>`;
    (allTrainers as TrainerOption[]).forEach((trainer) => {
      const opt = document.createElement("option");
      opt.value = trainer.uid;
      opt.textContent = trainer.role === "admin" ? `${trainer.name} (Admin)` : trainer.name;
      select.appendChild(opt);
    });
    select.value = currentValue;
  }

  // === Modal Actions (replaced window.__* functions) ===
  function closeUserModal(): void {
    editingUserId = null;
    document.getElementById("user-modal-overlay")!.classList.add("hidden");
  }

  function closeMedicalModal(): void {
    document.getElementById("medical-modal-overlay")!.classList.add("hidden");
  }

  async function saveUserEdit(): Promise<void> {
    if (!editingUserId) return;

    const name = (document.getElementById("modal-name") as HTMLInputElement).value.trim();
    const email = (document.getElementById("modal-email") as HTMLInputElement).value.trim();
    const role = (document.getElementById("modal-role") as HTMLSelectElement).value as
      "admin" | "trainer" | "client";
    const assignedTrainerId =
      (document.getElementById("modal-trainer") as HTMLSelectElement).value || null;

    if (!name) {
      showToast({ message: "El nombre es obligatorio", type: "error" });
      return;
    }

    const saveBtn = document.getElementById("modal-save-btn")!;
    saveBtn.textContent = "Guardando...";
    (saveBtn as HTMLButtonElement).disabled = true;

    try {
      const success = await updateUserProfile(editingUserId, {
        name,
        email,
        role,
        assignedTrainerId,
      });
      if (success) {
        showToast({ message: "Usuario actualizado correctamente", type: "success" });
        closeUserModal();
      } else {
        showToast({ message: "Error al guardar los cambios", type: "error" });
      }
    } catch (error) {
      logger.error("Admin", "Error saving user:", error);
      showToast({ message: "Error al guardar los cambios", type: "error" });
    } finally {
      saveBtn.textContent = "Guardar Cambios";
      (saveBtn as HTMLButtonElement).disabled = false;
    }
  }

  async function toggleBlockUser(): Promise<void> {
    if (!editingUserId) return;
    const user = allUsers.find((u) => u.uid === editingUserId);
    if (!user) return;

    const newBlockedState = !user.isBlocked;
    const action = newBlockedState ? "bloquear" : "desbloquear";

    const confirmed = await showConfirm({
      title: `¿${newBlockedState ? "Bloquear" : "Desbloquear"} usuario?`,
      message: `¿Estás seguro de ${action} a ${user.name}?`,
      confirmText: newBlockedState ? "Bloquear" : "Desbloquear",
      cancelText: "Cancelar",
      variant: newBlockedState ? "danger" : "warning",
    });
    if (!confirmed) return;

    try {
      await toggleUserBlock(editingUserId, newBlockedState);
      showToast({
        message: `Usuario ${newBlockedState ? "bloqueado" : "desbloqueado"} correctamente`,
        type: "success",
      });
      // Update local state
      user.isBlocked = newBlockedState;
      if (newBlockedState) {
        user.blockedAt = { toDate: () => new Date() };
      } else {
        user.blockedAt = null;
      }
      // Refresh modal
      openUserModal(editingUserId);
    } catch (error) {
      logger.error("Admin", "Error toggling block:", error);
      showToast({ message: `Error al ${action} al usuario`, type: "error" });
    }
  }

  async function viewMedicalProfile(): Promise<void> {
    if (!editingUserId) return;

    const body = document.getElementById("medical-modal-body")!;
    body.innerHTML = '<p class="text-[var(--text-tertiary)]">Cargando perfil médico...</p>';
    document.getElementById("medical-modal-overlay")!.classList.remove("hidden");

    try {
      const docSnap = await getDoc(doc(db, "users", editingUserId));
      if (!docSnap.exists()) {
        body.innerHTML = '<p class="text-[var(--danger)]">Usuario no encontrado</p>';
        return;
      }

      const data = docSnap.data();
      const mp = data.medicalProfile;

      if (!mp) {
        body.innerHTML = `
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-4)] p-6 text-center">
            <p class="text-[var(--text-tertiary)]">Este cliente no ha completado su perfil médico</p>
          </div>
        `;
        return;
      }

      body.innerHTML = `
        <div class="space-y-3">
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-4)] p-4">
            <h4 class="text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider mb-2">Información General</h4>
            <div class="grid grid-cols-2 gap-2 text-sm">
              ${mp.birthDate ? `<div><span class="text-[var(--text-tertiary)]">Edad:</span> <span class="text-[var(--text-primary)]">${calculateAge(mp.birthDate)} años</span></div>` : ""}
              ${mp.height ? `<div><span class="text-[var(--text-tertiary)]">Altura:</span> <span class="text-[var(--text-primary)]">${mp.height} cm</span></div>` : ""}
              ${mp.initialWeight ? `<div><span class="text-[var(--text-tertiary)]">Peso inicial:</span> <span class="text-[var(--text-primary)]">${mp.initialWeight} kg</span></div>` : ""}
              ${mp.experience ? `<div><span class="text-[var(--text-tertiary)]">Experiencia:</span> <span class="text-[var(--text-primary)] capitalize">${mp.experience}</span></div>` : ""}
              ${mp.goals?.length ? `<div class="col-span-2"><span class="text-[var(--text-tertiary)]">Objetivos:</span> <span class="text-[var(--text-primary)]">${mp.goals.join(", ")}</span></div>` : ""}
            </div>
          </div>

          ${
            mp.allergies?.length
              ? `
            <div class="rounded-xl border border-amber-900/30 bg-amber-500/5 p-4">
              <h4 class="text-xs font-semibold text-amber-400 uppercase tracking-wider mb-2">Alergias</h4>
              <div class="flex flex-wrap gap-1.5">
                ${mp.allergies.map((a: string) => `<span class="rounded-full bg-amber-500/10 px-2.5 py-0.5 text-xs text-amber-300 border border-amber-500/20">${escapeHtml(a)}</span>`).join("")}
              </div>
            </div>
          `
              : ""
          }

          ${
            mp.injuries?.length
              ? `
            <div class="rounded-xl border border-red-900/30 bg-[var(--danger-dim)] p-4">
              <h4 class="text-xs font-semibold text-[var(--danger)] uppercase tracking-wider mb-2">Lesiones</h4>
              <div class="flex flex-wrap gap-1.5">
                ${mp.injuries.map((i: string) => `<span class="rounded-full bg-[var(--danger-dim)] px-2.5 py-0.5 text-xs text-[var(--danger)] border border-[var(--danger)]">${escapeHtml(i)}</span>`).join("")}
              </div>
            </div>
          `
              : ""
          }

          ${
            mp.conditions?.length
              ? `
            <div class="rounded-xl border border-orange-900/30 bg-[var(--warning-dim)] p-4">
              <h4 class="text-xs font-semibold text-[var(--warning)] uppercase tracking-wider mb-2">Condiciones Médicas</h4>
              <div class="flex flex-wrap gap-1.5">
                ${mp.conditions.map((c: string) => `<span class="rounded-full bg-[var(--warning-dim)] px-2.5 py-0.5 text-xs text-[var(--warning)] border border-[var(--warning)]">${escapeHtml(c)}</span>`).join("")}
              </div>
            </div>
          `
              : ""
          }

          ${
            !mp.allergies?.length && !mp.injuries?.length && !mp.conditions?.length
              ? `
            <div class="rounded-xl border border-emerald-900/30 bg-[var(--brand-dim)] p-4 text-center">
              <p class="text-sm text-[var(--brand)]">No hay alertas médicas registradas</p>
            </div>
          `
              : ""
          }
        </div>
      `;
    } catch (error) {
      logger.error("Admin", "Error loading medical profile:", error);
      body.innerHTML = '<p class="text-[var(--danger)]">Error al cargar el perfil médico</p>';
    }
  }

  async function resetUserPassword(): Promise<void> {
    if (!editingUserId) return;

    const user = allUsers.find((u) => u.uid === editingUserId);
    if (!user || !user.email) {
      showToast({ message: "Este usuario no tiene email registrado", type: "error" });
      return;
    }

    const confirmed = await showConfirm({
      title: "Resetear contraseña",
      message: `¿Enviar email de recuperación a ${user.email}?`,
      confirmText: "Enviar",
      cancelText: "Cancelar",
      variant: "warning",
    });
    if (!confirmed) return;

    try {
      await sendPasswordResetEmail(auth, user.email);
      showToast({ message: `Email de recuperación enviado a ${user.email}`, type: "success" });
    } catch (error) {
      logger.error("Admin", "Error sending password reset:", error);
      showToast({ message: "Error al enviar el email de recuperación", type: "error" });
    }
  }

  async function deleteCurrentUser(): Promise<void> {
    if (!editingUserId) return;
    const user = allUsers.find((u) => u.uid === editingUserId);
    if (!user) return;

    const confirmed = await showConfirm({
      title: "Eliminar usuario",
      message: `¿Estás seguro de eliminar a ${user.name}? Esta acción no se puede deshacer.`,
      confirmText: "Eliminar",
      cancelText: "Cancelar",
      variant: "danger",
    });
    if (!confirmed) return;

    try {
      await deleteUser(editingUserId);
      showToast({ message: "Usuario eliminado correctamente", type: "success" });
      closeUserModal();
    } catch (error) {
      logger.error("Admin", "Error deleting user:", error);
      showToast({ message: "Error al eliminar el usuario", type: "error" });
    }
  }

  // Role dropdown change handler - show/hide trainer field
  document
    .getElementById("modal-role")
    ?.addEventListener("change", function (this: HTMLSelectElement) {
      const trainerField = document.getElementById("modal-trainer-field")!;
      const medicalBtn = document.getElementById("modal-view-medical-btn")!;
      if (this.value === "client") {
        trainerField.classList.remove("hidden");
        medicalBtn.classList.remove("hidden");
      } else if (this.value === "admin") {
        trainerField.classList.remove("hidden");
        medicalBtn.classList.add("hidden");
      } else {
        trainerField.classList.add("hidden");
        medicalBtn.classList.add("hidden");
      }
    });

  function calculateAge(birthDate: unknown): number {
    if (!birthDate) return 0;
    try {
      const date = (birthDate as { toDate?: () => Date }).toDate
        ? (birthDate as { toDate: () => Date }).toDate()
        : new Date(birthDate as string);
      const diff = Date.now() - date.getTime();
      return Math.floor(diff / (1000 * 60 * 60 * 24 * 365.25));
    } catch {
      return 0;
    }
  }
</script>
