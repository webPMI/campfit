---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getT, getLanguage } from '@/lib/shared/i18n';

const lang = getLanguage(Astro.url.searchParams.get('lang'));
const t = getT(lang);
---

<AdminLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <h1 class="text-2xl font-bold">{t('admin.clients')}</h1>
      <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t('admin.clients.desc')}</p>

      <div id="clients-container" class="mt-6 space-y-3">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-8 text-center backdrop-blur-sm">
          <p class="text-sm text-[var(--text-tertiary)]">{t('admin.loading')}</p>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { requireAdmin } from '@/lib/shared/authGuard';
  import { getT } from '@/lib/shared/i18n';
  import { subscribeToUsersByRole, renderClientCard, getUserName } from '@/lib/admin/adminUtils';
  import { ICONS, renderEmptyState, renderLoadingState } from '@/lib/shared/ui';

  const t = getT();

  requireAdmin(() => {
    initClients();
  });

  async function initClients(): Promise<void> {
    const container = document.getElementById('clients-container')!;

    container.innerHTML = renderLoadingState();

    subscribeToUsersByRole('client', async (clients) => {
      if (clients.length === 0) {
        container.innerHTML = renderEmptyState(ICONS.clients, t('admin.no.clients'));
        return;
      }

      // Resolver nombres de trainers asignados
      const clientsWithTrainerNames = await Promise.all(
        clients.map(async (client) => {
          if (client.assignedTrainerId) {
            const trainerName = await getUserName(client.assignedTrainerId);
            return { ...client, assignedTrainerName: trainerName };
          }
          return client;
        }),
      );

      container.innerHTML = clientsWithTrainerNames.map((client) => renderClientCard(client)).join('');
    });
  }
</script>
