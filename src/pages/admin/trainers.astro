---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getT, getLanguage } from '@/lib/shared/i18n';

const lang = getLanguage(Astro.url.searchParams.get('lang'));
const t = getT(lang);
---

<AdminLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <h1 class="text-2xl font-bold">{t('admin.trainers')}</h1>
      <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t('admin.trainers.desc')}</p>

      <div id="trainers-container" class="mt-6 space-y-3">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-8 text-center backdrop-blur-sm">
          <p class="text-sm text-[var(--text-tertiary)]">{t('admin.loading')}</p>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { requireAdmin } from '@/lib/shared/authGuard';
  import { getT } from '@/lib/shared/i18n';
  import { subscribeToUsersByRole, renderTrainerCard, getTrainerClientCount, type AdminUser } from '@/lib/admin/adminUtils';
  import { ICONS, renderEmptyState, renderLoadingState } from '@/lib/shared/ui';

  const t = getT();

  requireAdmin(() => {
    initTrainers();
  });

  async function initTrainers(): Promise<void> {
    const container = document.getElementById('trainers-container')!;

    container.innerHTML = renderLoadingState();

    subscribeToUsersByRole('trainer', async (trainers) => {
      if (trainers.length === 0) {
        container.innerHTML = renderEmptyState(ICONS.trainers, t('admin.no.trainers'));
        return;
      }

      // Obtener conteo real de clientes para cada trainer
      const trainersWithCounts = await Promise.all(
        trainers.map(async (trainer) => {
          const clientCount = await getTrainerClientCount(trainer.uid);
          return { ...trainer, clientCount } as AdminUser & { clientCount: number };
        }),
      );

      container.innerHTML = trainersWithCounts.map((trainer) => renderTrainerCard(trainer)).join('');
    });
  }
</script>
