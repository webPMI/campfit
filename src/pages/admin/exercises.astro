---
import AdminLayout from "@/layouts/AdminLayout.astro";
import PageTransition from "@/components/PageTransition.astro";
import Skeleton from "@/components/Skeleton.astro";
---

<AdminLayout title="Biblioteca de Ejercicios — Admin">
  <PageTransition>
    <div class="mx-auto max-w-7xl px-4 py-8 space-y-6">

      <!-- Header principal -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-2xl">🏋️</span>
            <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">
              Biblioteca de Ejercicios
            </h1>
          </div>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">
            Gestiona el catálogo centralizado de ejercicios multilenguaje y sus metadatos.
          </p>
        </div>
        <button
          id="btn-new-exercise"
          class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-4 py-2.5 text-sm font-bold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all hover:opacity-95 active:scale-95 shrink-0"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
          </svg>
          Añadir Ejercicio
        </button>
      </div>

      <!-- Tarjetas de estadísticas del catálogo -->
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs font-medium text-[var(--text-tertiary)]">Total Ejercicios</p>
          <p id="stat-total" class="mt-1 text-2xl font-black text-[var(--text-primary)]">—</p>
        </div>
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs font-medium text-[var(--text-tertiary)]">Activos</p>
          <p id="stat-active" class="mt-1 text-2xl font-black text-emerald-400">—</p>
        </div>
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs font-medium text-[var(--text-tertiary)]">Grupos Musculares</p>
          <p id="stat-muscles" class="mt-1 text-2xl font-black text-[var(--brand)]">—</p>
        </div>
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs font-medium text-[var(--text-tertiary)]">Categorías</p>
          <p id="stat-categories" class="mt-1 text-2xl font-black text-blue-400">—</p>
        </div>
      </div>

      <!-- Barra de Filtros y Búsqueda -->
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-5">
        <!-- Búsqueda por texto -->
        <div class="relative sm:col-span-2 md:col-span-2">
          <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--text-disabled)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
          </svg>
          <input
            type="text"
            id="search-input"
            placeholder="Buscar por nombre (ES/EN/CA), tag..."
            class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] pl-10 pr-4 py-2.5 text-sm text-[var(--text-primary)] placeholder-[var(--text-disabled)] focus:border-[var(--border-brand)] focus:outline-none transition-all"
          />
        </div>

        <!-- Filtro por Músculo -->
        <select id="filter-muscle" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2.5 text-xs text-[var(--text-secondary)] focus:border-[var(--border-brand)] focus:outline-none transition-all">
          <option value="">Todos los músculos</option>
          <option value="chest">💪 Pecho</option>
          <option value="back">🔙 Espalda</option>
          <option value="shoulders">🏋️ Hombros</option>
          <option value="biceps">💪 Bíceps</option>
          <option value="triceps">💪 Tríceps</option>
          <option value="forearms">💪 Antebrazos</option>
          <option value="core">🎯 Core</option>
          <option value="quadriceps">🦵 Cuádriceps</option>
          <option value="hamstrings">🦵 Isquiotibiales</option>
          <option value="glutes">🍑 Glúteos</option>
          <option value="calves">🦵 Gemelos</option>
          <option value="full_body">🌐 Cuerpo completo</option>
          <option value="cardio">❤️ Cardio</option>
        </select>

        <!-- Filtro por Categoría -->
        <select id="filter-category" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2.5 text-xs text-[var(--text-secondary)] focus:border-[var(--border-brand)] focus:outline-none transition-all">
          <option value="">Todas las categorías</option>
          <option value="strength">🏋️ Fuerza</option>
          <option value="cardio">🏃 Cardio</option>
          <option value="flexibility">🧘 Flexibilidad</option>
          <option value="balance">⚖️ Equilibrio</option>
          <option value="plyometric">💥 Pliométrico</option>
          <option value="functional">⚙️ Funcional</option>
          <option value="rehabilitation">🩺 Rehabilitación</option>
          <option value="sport_specific">⚽ Deporte específico</option>
        </select>

        <!-- Filtro por Estado -->
        <select id="filter-status" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2.5 text-xs text-[var(--text-secondary)] focus:border-[var(--border-brand)] focus:outline-none transition-all">
          <option value="active" selected>🟢 Solo Activos</option>
          <option value="inactive">🔴 Solo Inactivos</option>
          <option value="all">🌐 Todos</option>
        </select>
      </div>

      <!-- Estado de carga -->
      <div id="loading-state" class="py-12 text-center space-y-3">
        <Skeleton className="h-16 w-full rounded-2xl mb-2" />
        <Skeleton className="h-16 w-full rounded-2xl mb-2" />
        <Skeleton className="h-16 w-full rounded-2xl mb-2" />
      </div>

      <!-- Estado vacío -->
      <div id="empty-state" class="hidden rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-12 text-center">
        <span class="text-4xl">🏋️</span>
        <h3 class="mt-3 text-lg font-bold text-[var(--text-primary)]">No se encontraron ejercicios</h3>
        <p class="mt-1 text-xs text-[var(--text-tertiary)]">Prueba cambiando los filtros de búsqueda o añade uno nuevo.</p>
      </div>

      <!-- Contador de resultados -->
      <p id="result-count" class="hidden text-xs font-semibold text-[var(--text-tertiary)]"></p>

      <!-- Lista / Grid de Ejercicios -->
      <div id="exercises-container" class="hidden space-y-3">
        <!-- Renderizado dinámico mediante JS -->
      </div>

    </div>
  </PageTransition>

  <!-- Modal Formulario (Crear / Editar Ejercicio) -->
  <div id="exercise-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
    <!-- Backdrop -->
    <div id="modal-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>

    <!-- Contenido del Modal -->
    <div class="relative w-full max-w-3xl max-h-[90vh] overflow-y-auto rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 shadow-2xl space-y-5 custom-scrollbar">
      
      <!-- Header Modal -->
      <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-4">
        <div class="flex items-center gap-2">
          <span class="text-xl">🏋️</span>
          <h2 id="modal-title" class="text-lg font-bold text-[var(--text-primary)]">Añadir Ejercicio</h2>
        </div>
        <button id="modal-close" type="button" class="rounded-lg p-1.5 text-[var(--text-tertiary)] hover:bg-[var(--surface-3)] hover:text-[var(--text-primary)] transition-all">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="exercise-form" class="space-y-4">
        <input type="hidden" id="exercise-id" value="" />
        <input type="checkbox" id="exercise-active" class="hidden" checked />

        <!-- Nombres multilenguaje -->
        <div class="space-y-2">
          <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider">Nombre del Ejercicio (Multilenguaje)</label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <span class="block text-[11px] text-[var(--text-tertiary)] mb-1">🇪🇸 Español (obligatorio)</span>
              <input type="text" id="name-es" required class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-sm text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none" placeholder="Ej: Sentadilla con barra" />
            </div>
            <div>
              <span class="block text-[11px] text-[var(--text-tertiary)] mb-1">🇬🇧 Inglés</span>
              <input type="text" id="name-en" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-sm text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none" placeholder="Ej: Barbell Back Squat" />
            </div>
            <div>
              <span class="block text-[11px] text-[var(--text-tertiary)] mb-1">🏴 Catalán</span>
              <input type="text" id="name-ca" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-sm text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none" placeholder="Ej: Esquat amb barra" />
            </div>
          </div>
        </div>

        <!-- Clasificación Principal -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Categoría</label>
            <select id="exercise-category" required class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none">
              <option value="strength">🏋️ Fuerza</option>
              <option value="cardio">🏃 Cardio</option>
              <option value="flexibility">🧘 Flexibilidad</option>
              <option value="balance">⚖️ Equilibrio</option>
              <option value="plyometric">💥 Pliométrico</option>
              <option value="functional">⚙️ Funcional</option>
              <option value="rehabilitation">🩺 Rehabilitación</option>
              <option value="sport_specific">⚽ Deporte específico</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Dificultad</label>
            <select id="exercise-difficulty" required class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none">
              <option value="beginner">🟢 Principiante</option>
              <option value="intermediate" selected>🟡 Intermedio</option>
              <option value="advanced">🔴 Avanzado</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Músculo Principal</label>
            <select id="primary-muscle" required class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none">
              <option value="chest">💪 Pecho</option>
              <option value="back">🔙 Espalda</option>
              <option value="shoulders">🏋️ Hombros</option>
              <option value="biceps">💪 Bíceps</option>
              <option value="triceps">💪 Tríceps</option>
              <option value="forearms">💪 Antebrazos</option>
              <option value="core">🎯 Core</option>
              <option value="quadriceps" selected>🦵 Cuádriceps</option>
              <option value="hamstrings">🦵 Isquiotibiales</option>
              <option value="glutes">🍑 Glúteos</option>
              <option value="calves">🦵 Gemelos</option>
              <option value="full_body">🌐 Cuerpo completo</option>
              <option value="cardio">❤️ Cardio</option>
            </select>
          </div>
        </div>

        <!-- Equipamiento y Valores por Defecto -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Series por Defecto</label>
            <input type="number" id="default-sets" min="1" max="20" value="3" required class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Reps por Defecto</label>
            <input type="number" id="default-reps" min="1" max="100" value="10" required class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Descanso (seg)</label>
            <input type="number" id="default-rest" min="0" max="600" step="5" value="90" required class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Duración (seg opcional)</label>
            <input type="number" id="default-duration" min="0" max="3600" step="5" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none" placeholder="Ej: 45" />
          </div>
        </div>

        <!-- Equipamiento Necesario (Checkboxes) -->
        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider">Equipamiento Necesario</label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-3">
            <label class="flex items-center gap-2 text-xs text-[var(--text-primary)] cursor-pointer">
              <input type="checkbox" class="equipment-check accent-[var(--brand)]" data-equip="barbell" /> 🏋️ Barra
            </label>
            <label class="flex items-center gap-2 text-xs text-[var(--text-primary)] cursor-pointer">
              <input type="checkbox" class="equipment-check accent-[var(--brand)]" data-equip="dumbbell" /> 💪 Mancuernas
            </label>
            <label class="flex items-center gap-2 text-xs text-[var(--text-primary)] cursor-pointer">
              <input type="checkbox" class="equipment-check accent-[var(--brand)]" data-equip="kettlebell" /> 🔔 Kettlebell
            </label>
            <label class="flex items-center gap-2 text-xs text-[var(--text-primary)] cursor-pointer">
              <input type="checkbox" class="equipment-check accent-[var(--brand)]" data-equip="cable" /> 🪝 Polea
            </label>
            <label class="flex items-center gap-2 text-xs text-[var(--text-primary)] cursor-pointer">
              <input type="checkbox" class="equipment-check accent-[var(--brand)]" data-equip="machine" /> 🤖 Máquina
            </label>
            <label class="flex items-center gap-2 text-xs text-[var(--text-primary)] cursor-pointer">
              <input type="checkbox" class="equipment-check accent-[var(--brand)]" data-equip="bodyweight" checked /> 🧍 Peso corporal
            </label>
            <label class="flex items-center gap-2 text-xs text-[var(--text-primary)] cursor-pointer">
              <input type="checkbox" class="equipment-check accent-[var(--brand)]" data-equip="bench" /> 🪑 Banco
            </label>
            <label class="flex items-center gap-2 text-xs text-[var(--text-primary)] cursor-pointer">
              <input type="checkbox" class="equipment-check accent-[var(--brand)]" data-equip="rack" /> 🏗️ Rack / Jaula
            </label>
          </div>
        </div>

        <!-- URL Video / Multimedia y Contraindicaciones / Tags -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">URL Demostración (YouTube / Video)</label>
            <input type="url" id="video-url" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none" placeholder="https://youtube.com/watch?v=..." />
          </div>
          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Tags (separados por coma)</label>
            <input type="text" id="exercise-tags" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none" placeholder="compound, powerlifting, core" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Contraindicaciones Médicas (separadas por coma)</label>
          <input type="text" id="exercise-contra" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--border-brand)] focus:outline-none" placeholder="lumbar_herniation, knee_pain, shoulder_impingement" />
          <span class="text-[10px] text-[var(--text-disabled)] mt-0.5 block">Se usarán para alertar al entrenador si el cliente padece esa condición médica.</span>
        </div>

        <!-- Botones de Acción -->
        <div class="flex items-center justify-between border-t border-[var(--border-subtle)] pt-4">
          <button
            type="button"
            id="btn-delete-exercise"
            class="hidden flex items-center gap-1.5 rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-2 text-xs font-medium text-red-400 hover:bg-red-500/20 transition-all"
          >
            <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
            <span>Desactivar (soft delete)</span>
          </button>
          <div class="flex gap-3 ml-auto">
            <button type="button" id="btn-modal-cancel" class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-4 py-2 text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all">
              Cancelar
            </button>
            <button type="submit" id="btn-save-exercise" class="flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-5 py-2 text-xs font-bold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] hover:opacity-95 transition-all disabled:opacity-50">
              <span id="save-label">Guardar Ejercicio</span>
            </button>
          </div>
        </div>

      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { requireRole } from "@/lib/shared/authGuard";
  import { showToast, escapeHtml, showConfirm } from "@/lib/shared/ui";
  import { logger } from "@/lib/shared/logger";
  import {
    subscribeToAllExercises,
    generateExerciseSearchIndex,
    searchExercisesLocal,
    MUSCLE_LABELS,
    CATEGORY_LABELS_EX,
    DIFFICULTY_LABELS,
    type ExerciseItem,
    type MuscleGroup,
    type ExerciseCategory,
    type EquipmentType,
  } from "@/lib/shared/exerciseLibrary";
  import {
    collection,
    doc,
    addDoc,
    updateDoc,
    serverTimestamp,
  } from "firebase/firestore";
  import { db } from "@/lib/firebase";

  const COLLECTION = "exercises_library";

  let allExercises: ExerciseItem[] = [];
  let filtered: ExerciseItem[] = [];
  let currentUserId = "";

  requireRole(["admin"], (user) => {
    currentUserId = user.uid;
    init();
  });

  function init() {
    const searchInput = document.getElementById("search-input") as HTMLInputElement;
    const filterMuscle = document.getElementById("filter-muscle") as HTMLSelectElement;
    const filterCategory = document.getElementById("filter-category") as HTMLSelectElement;
    const filterStatus = document.getElementById("filter-status") as HTMLSelectElement;
    const btnNew = document.getElementById("btn-new-exercise")!;
    const modalBackdrop = document.getElementById("modal-backdrop")!;
    const modalClose = document.getElementById("modal-close")!;
    const btnCancel = document.getElementById("btn-modal-cancel")!;
    const btnDelete = document.getElementById("btn-delete-exercise")!;
    const form = document.getElementById("exercise-form") as HTMLFormElement;

    // Suscripción al catálogo completo
    const unsub = subscribeToAllExercises((exercises) => {
      allExercises = exercises;
      updateStats(exercises);
      applyFilters();
    });
    window.addEventListener("beforeunload", () => unsub());

    // Eventos de filtro
    searchInput?.addEventListener("input", applyFilters);
    filterMuscle?.addEventListener("change", applyFilters);
    filterCategory?.addEventListener("change", applyFilters);
    filterStatus?.addEventListener("change", applyFilters);

    // Abrir nuevo
    btnNew.addEventListener("click", () => openModal(null));

    // Cerrar modal
    [modalBackdrop, modalClose, btnCancel].forEach(el => el.addEventListener("click", closeModal));

    // Soft delete toggle
    btnDelete.addEventListener("click", async () => {
      const id = (document.getElementById("exercise-id") as HTMLInputElement).value;
      if (!id) return;
      const ref = doc(db, COLLECTION, id);
      const currentActive = !(document.getElementById("exercise-active") as HTMLInputElement).checked;
      const confirmed = await showConfirm({
        title: currentActive ? "¿Reactivar Ejercicio?" : "¿Desactivar Ejercicio?",
        message: currentActive
          ? "¿Deseas reactivar este ejercicio para que vuelva a estar visible en el catálogo de entrenadores y atletas?"
          : "¿Deseas desactivar este ejercicio? No se borrará de Firestore pero no aparecerá a entrenadores ni clientes.",
        confirmText: currentActive ? "Reactivar" : "Desactivar",
        variant: currentActive ? "info" : "warning",
      });
      if (!confirmed) return;
      try {
        await updateDoc(ref, { isActive: currentActive, updatedAt: serverTimestamp() });
        showToast({ message: currentActive ? "Ejercicio reactivado" : "Ejercicio desactivado", type: "success" });
        closeModal();
      } catch (err) {
        logger.error("admin/exercises", "Error toggling isActive:", err);
        showToast({ message: "Error al actualizar el estado", type: "error" });
      }
    });

    // Guardar Submit
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById("btn-save-exercise") as HTMLButtonElement;
      saveBtn.disabled = true;
      try {
        await saveExerciseItem();
        closeModal();
      } catch (err) {
        logger.error("admin/exercises", "Error saving exercise:", err);
        showToast({ message: "Error al guardar el ejercicio", type: "error" });
      } finally {
        saveBtn.disabled = false;
      }
    });

    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });
  }

  function applyFilters() {
    const searchVal = (document.getElementById("search-input") as HTMLInputElement)?.value ?? "";
    const muscleVal = (document.getElementById("filter-muscle") as HTMLSelectElement)?.value ?? "";
    const catVal = (document.getElementById("filter-category") as HTMLSelectElement)?.value ?? "";
    const statusVal = (document.getElementById("filter-status") as HTMLSelectElement)?.value ?? "active";

    filtered = allExercises.filter(ex => {
      if (statusVal === "active" && !ex.isActive) return false;
      if (statusVal === "inactive" && ex.isActive) return false;
      if (catVal && ex.category !== catVal) return false;
      if (muscleVal && !ex.muscleGroups.includes(muscleVal as MuscleGroup)) return false;
      return true;
    });

    if (searchVal.trim()) {
      filtered = searchExercisesLocal(searchVal, filtered);
    }

    renderExercises(filtered);
  }

  function updateStats(exercises: ExerciseItem[]) {
    const active = exercises.filter(ex => ex.isActive);
    const muscles = new Set(exercises.flatMap(ex => ex.muscleGroups));
    const cats = new Set(exercises.map(ex => ex.category));

    document.getElementById("stat-total")!.textContent = String(exercises.length);
    document.getElementById("stat-active")!.textContent = String(active.length);
    document.getElementById("stat-muscles")!.textContent = String(muscles.size);
    document.getElementById("stat-categories")!.textContent = String(cats.size);
  }

  function renderExercises(exercises: ExerciseItem[]) {
    const loading = document.getElementById("loading-state")!;
    const empty = document.getElementById("empty-state")!;
    const container = document.getElementById("exercises-container")!;
    const count = document.getElementById("result-count")!;

    loading.classList.add("hidden");

    if (exercises.length === 0) {
      empty.classList.remove("hidden");
      container.classList.add("hidden");
      count.classList.add("hidden");
      return;
    }

    empty.classList.add("hidden");
    container.classList.remove("hidden");
    count.classList.remove("hidden");
    count.textContent = `${exercises.length} ejercicio${exercises.length !== 1 ? "s" : ""}`;

    container.innerHTML = exercises.map(ex => renderExerciseRow(ex)).join("");

    container.querySelectorAll("[data-edit-exercise]").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-edit-exercise")!;
        const ex = allExercises.find(item => item.id === id);
        if (ex) openModal(ex);
      });
    });
  }

  function renderExerciseRow(ex: ExerciseItem): string {
    const nameEs = escapeHtml(ex.translations.es);
    const nameEn = escapeHtml(ex.translations.en || "");
    const primaryMuscle = ex.muscleGroups[0] ? (MUSCLE_LABELS[ex.muscleGroups[0]] ?? ex.muscleGroups[0]) : "—";
    const categoryLabel = CATEGORY_LABELS_EX[ex.category] ?? ex.category;
    const diffLabel = DIFFICULTY_LABELS[ex.difficulty] ?? ex.difficulty;

    const badges = [
      !ex.isActive ? '<span class="bg-red-500/15 text-red-400 text-[10px] px-1.5 py-0.5 rounded-full font-medium">Inactivo</span>' : "",
      ex.videoUrl ? '<span class="bg-blue-500/15 text-blue-400 text-[10px] px-1.5 py-0.5 rounded-full font-medium">🎬 Video</span>' : "",
    ].filter(Boolean).join(" ");

    return `
      <div class="group flex items-center gap-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-4 py-3 hover:border-[var(--border-brand)] hover:bg-[var(--surface-3)] transition-all ${!ex.isActive ? "opacity-60" : ""}">
        <div class="flex-shrink-0 flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--surface-4)] text-xl">
          🏋️
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="font-semibold text-sm text-[var(--text-primary)] truncate">${nameEs}</span>
            <span class="text-[10px] text-[var(--text-disabled)]">${nameEn}</span>
            ${badges}
          </div>
          <div class="mt-1 flex items-center gap-3 text-[11px] text-[var(--text-tertiary)] flex-wrap">
            <span>${primaryMuscle}</span>
            <span class="text-[var(--border-strong)]">·</span>
            <span>${categoryLabel}</span>
            <span class="text-[var(--border-strong)]">·</span>
            <span>${diffLabel}</span>
            <span class="text-[var(--border-strong)]">·</span>
            <span>📋 ${ex.defaultSets}x${ex.defaultReps} (${ex.defaultRestSeconds}s)</span>
          </div>
        </div>
        <button
          data-edit-exercise="${ex.id}"
          class="flex-shrink-0 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] opacity-0 group-hover:opacity-100 hover:border-[var(--border-brand)] hover:text-[var(--brand)] transition-all"
        >
          Editar
        </button>
      </div>
    `;
  }

  function openModal(ex: ExerciseItem | null) {
    const modal = document.getElementById("exercise-modal")!;
    const title = document.getElementById("modal-title")!;
    const btnDelete = document.getElementById("btn-delete-exercise")!;
    const form = document.getElementById("exercise-form") as HTMLFormElement;

    form.reset();

    if (ex) {
      title.textContent = "Editar ejercicio";
      btnDelete.classList.remove("hidden");
      (document.getElementById("exercise-id") as HTMLInputElement).value = ex.id;
      (document.getElementById("name-es") as HTMLInputElement).value = ex.translations.es;
      (document.getElementById("name-en") as HTMLInputElement).value = ex.translations.en || "";
      (document.getElementById("name-ca") as HTMLInputElement).value = ex.translations.ca || "";
      (document.getElementById("exercise-category") as HTMLSelectElement).value = ex.category;
      (document.getElementById("exercise-difficulty") as HTMLSelectElement).value = ex.difficulty;
      (document.getElementById("primary-muscle") as HTMLSelectElement).value = ex.muscleGroups[0] || "quadriceps";
      (document.getElementById("default-sets") as HTMLInputElement).value = String(ex.defaultSets);
      (document.getElementById("default-reps") as HTMLInputElement).value = String(ex.defaultReps);
      (document.getElementById("default-rest") as HTMLInputElement).value = String(ex.defaultRestSeconds);
      (document.getElementById("default-duration") as HTMLInputElement).value = ex.defaultDurationSeconds ? String(ex.defaultDurationSeconds) : "";
      (document.getElementById("video-url") as HTMLInputElement).value = ex.videoUrl || "";
      (document.getElementById("exercise-tags") as HTMLInputElement).value = (ex.tags ?? []).join(", ");
      (document.getElementById("exercise-contra") as HTMLInputElement).value = (ex.contraindications ?? []).join(", ");
      (document.getElementById("exercise-active") as HTMLInputElement).checked = ex.isActive;

      // Equipamiento checkboxes
      document.querySelectorAll<HTMLInputElement>(".equipment-check").forEach(cb => {
        cb.checked = ex.equipment?.includes(cb.dataset.equip as EquipmentType) ?? false;
      });

      const btnDeleteLabel = btnDelete.querySelector("span") ?? btnDelete;
      btnDeleteLabel.textContent = ex.isActive ? " Desactivar (soft delete)" : " Reactivar";
    } else {
      title.textContent = "Añadir ejercicio";
      btnDelete.classList.add("hidden");
      (document.getElementById("exercise-id") as HTMLInputElement).value = "";
      (document.getElementById("exercise-active") as HTMLInputElement).checked = true;
    }

    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    setTimeout(() => (document.getElementById("name-es") as HTMLInputElement)?.focus(), 50);
  }

  function closeModal() {
    document.getElementById("exercise-modal")!.classList.add("hidden");
    document.body.style.overflow = "";
  }

  async function saveExerciseItem() {
    const id = (document.getElementById("exercise-id") as HTMLInputElement).value;
    const nameEs = (document.getElementById("name-es") as HTMLInputElement).value.trim();
    const nameEn = (document.getElementById("name-en") as HTMLInputElement).value.trim();
    const nameCa = (document.getElementById("name-ca") as HTMLInputElement).value.trim();
    const category = (document.getElementById("exercise-category") as HTMLSelectElement).value as ExerciseCategory;
    const difficulty = (document.getElementById("exercise-difficulty") as HTMLSelectElement).value as "beginner" | "intermediate" | "advanced";
    const primaryMuscle = (document.getElementById("primary-muscle") as HTMLSelectElement).value as MuscleGroup;
    const sets = parseInt((document.getElementById("default-sets") as HTMLInputElement).value);
    const reps = parseInt((document.getElementById("default-reps") as HTMLInputElement).value);
    const rest = parseInt((document.getElementById("default-rest") as HTMLInputElement).value);
    const durationVal = (document.getElementById("default-duration") as HTMLInputElement).value;
    const videoUrl = (document.getElementById("video-url") as HTMLInputElement).value.trim();
    const tagsRaw = (document.getElementById("exercise-tags") as HTMLInputElement).value;
    const contraRaw = (document.getElementById("exercise-contra") as HTMLInputElement).value;

    const tags = tagsRaw.split(",").map(t => t.trim()).filter(Boolean);
    const contraindications = contraRaw.split(",").map(c => c.trim()).filter(Boolean);
    const translations = { es: nameEs, en: nameEn, ca: nameCa };
    const muscleGroups: MuscleGroup[] = [primaryMuscle];
    const searchIndex = generateExerciseSearchIndex(translations, tags, muscleGroups);

    const equipment = Array.from(document.querySelectorAll<HTMLInputElement>(".equipment-check:checked"))
      .map(cb => cb.dataset.equip as EquipmentType)
      .filter(Boolean);

    const data: Partial<ExerciseItem> = {
      translations,
      searchIndex,
      category,
      difficulty,
      muscleGroups,
      equipment: equipment.length > 0 ? equipment : ["bodyweight"],
      defaultSets: sets,
      defaultReps: reps,
      defaultRestSeconds: rest,
      ...(durationVal ? { defaultDurationSeconds: parseInt(durationVal) } : {}),
      ...(videoUrl ? { videoUrl } : {}),
      tags,
      contraindications,
      isActive: (document.getElementById("exercise-active") as HTMLInputElement).checked,
      updatedAt: serverTimestamp(),
    };

    if (id) {
      await updateDoc(doc(db, COLLECTION, id), data as Record<string, unknown>);
      logger.info("admin/exercises", `Ejercicio actualizado: ${id}`);
      showToast({ message: `✅ "${nameEs}" actualizado correctamente`, type: "success" });
    } else {
      const docRef = await addDoc(collection(db, COLLECTION), {
        ...data,
        createdBy: currentUserId,
        createdAt: serverTimestamp(),
      });
      logger.info("admin/exercises", `Ejercicio creado: ${docRef.id}`);
      showToast({ message: `✅ "${nameEs}" añadido al catálogo`, type: "success" });
    }
  }
</script>
