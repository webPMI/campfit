---
---
import AdminLayout from "@/layouts/AdminLayout.astro";
import PageTransition from "@/components/PageTransition.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<AdminLayout>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <PageTransition animation="fade-up" stagger>
      <!-- Header -->
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div>
          <h1 data-i18n="admin.logs" class="text-2xl font-bold">{t("admin.logs")}</h1>
          <p data-i18n="admin.logs.desc" class="mt-1 text-sm text-[var(--text-tertiary)]">
            {t("admin.logs.desc") || "Registro de errores y warnings de la aplicación"}
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="refresh-logs-btn"
            class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] hover:bg-[var(--surface-4)] transition-all"
          >
            {t("admin.refresh") || "Actualizar"}
          </button>
          <button
            id="cleanup-logs-btn"
            class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] hover:bg-[var(--danger)] hover:text-white hover:border-[var(--danger)] transition-all"
          >
            {t("admin.logs.cleanup") || "Limpiar antiguos"}
          </button>
        </div>
      </div>

      <!-- Filters -->
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <select
          id="filter-level"
          class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-secondary)] backdrop-blur-sm"
        >
          <option value="all">{t("admin.all") || "Todos"}</option>
          <option value="critical">Critical</option>
          <option value="error">Error</option>
          <option value="warn">Warning</option>
        </select>

        <select
          id="filter-feature"
          class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-secondary)] backdrop-blur-sm"
        >
          <option value="all">{t("admin.all") || "Todos"}</option>
          <option value="auth">Auth</option>
          <option value="diet">Diet</option>
          <option value="workout">Workout</option>
          <option value="chat">Chat</option>
          <option value="clinical">Clinical</option>
          <option value="progress">Progress</option>
          <option value="system">System</option>
        </select>

        <input
          id="filter-search"
          type="text"
          placeholder={t("admin.search") || "Buscar..."}
          class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm"
        />

        <button
          id="apply-filters-btn"
          class="rounded-lg bg-[var(--brand)] px-3 py-2 text-xs font-medium text-[var(--text-on-brand)] hover:bg-[var(--brand-hover)] transition-all"
        >
          {t("admin.apply") || "Aplicar filtros"}
        </button>
      </div>

      <!-- Logs table -->
      <div class="mt-6 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead class="bg-[var(--surface-4)]">
              <tr>
                <th class="px-4 py-3 text-left font-medium text-[var(--text-tertiary)]">{t("admin.logs.timestamp") || "Fecha"}</th>
                <th class="px-4 py-3 text-left font-medium text-[var(--text-tertiary)]">{t("admin.logs.user") || "Usuario"}</th>
                <th class="px-4 py-3 text-left font-medium text-[var(--text-tertiary)]">{t("admin.logs.activity") || "Actividad"}</th>
                <th class="px-4 py-3 text-left font-medium text-[var(--text-tertiary)]">{t("admin.logs.level") || "Nivel"}</th>
                <th class="px-4 py-3 text-left font-medium text-[var(--text-tertiary)]">{t("admin.logs.message") || "Mensaje"}</th>
                <th class="px-4 py-3 text-left font-medium text-[var(--text-tertiary)]">{t("admin.logs.occurrences") || "Ocurrencias"}</th>
                <th class="px-4 py-3 text-right font-medium text-[var(--text-tertiary)]">{t("admin.logs.actions") || "Acciones"}</th>
              </tr>
            </thead>
            <tbody id="logs-table-body" class="divide-y divide-[var(--border-subtle)]">
              <tr>
                <td colspan="7" class="px-4 py-8 text-center text-[var(--text-tertiary)]">
                  {t("admin.logs.loading") || "Cargando logs..."}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pagination -->
      <div id="logs-pagination" class="mt-4 flex items-center justify-between">
        <div class="text-xs text-[var(--text-tertiary)]">
          <span id="logs-count">0</span> {t("admin.logs.total") || "logs encontrados"}
        </div>
        <div class="flex gap-2">
          <button
            id="prev-page-btn"
            disabled
            class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] disabled:opacity-50 disabled:cursor-not-allowed hover:bg-[var(--surface-4)] transition-all"
          >
            {t("admin.prev") || "Anterior"}
          </button>
          <button
            id="next-page-btn"
            disabled
            class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] disabled:opacity-50 disabled:cursor-not-allowed hover:bg-[var(--surface-4)] transition-all"
          >
            {t("admin.next") || "Siguiente"}
          </button>
        </div>
      </div>
    </PageTransition>
  </div>

  <!-- Detail Modal -->
  <div id="log-detail-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm">
    <div class="flex min-h-full items-center justify-center p-4">
      <div class="w-full max-w-2xl rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 shadow-2xl backdrop-blur-xl">
        <div class="flex items-center justify-between">
          <h3 data-i18n="admin.logs.detail" class="text-lg font-semibold">{t("admin.logs.detail") || "Detalle del log"}</h3>
          <button id="close-detail-modal" class="rounded-lg p-1.5 text-[var(--text-tertiary)] hover:text-[var(--text-secondary)] hover:bg-[var(--surface-3)] transition-all">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <div id="log-detail-content" class="mt-4 space-y-4 text-xs">
          <!-- Content injected via JS -->
        </div>

        <div class="mt-6 flex justify-end gap-2">
          <button
            id="close-detail-btn"
            class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-4 py-2 text-xs font-medium text-[var(--text-secondary)] hover:bg-[var(--surface-3)] transition-all"
          >
            {t("admin.close") || "Cerrar"}
          </button>
          <button
            id="delete-log-btn"
            class="rounded-lg bg-[var(--danger)] px-4 py-2 text-xs font-medium text-white hover:bg-[var(--danger-hover)] transition-all"
          >
            {t("admin.delete") || "Eliminar"}
          </button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // ... JS omitted for brevity
</script>
