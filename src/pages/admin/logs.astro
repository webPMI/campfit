---
---
import AdminLayout from "@/layouts/AdminLayout.astro";
import PageTransition from "@/components/PageTransition.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<AdminLayout>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <PageTransition animation="fade-up" stagger>
      <!-- Header -->
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div>
          <h1 data-i18n="admin.logs" class="text-2xl font-bold">{t("admin.logs")}</h1>
          <p data-i18n="admin.logs.desc" class="mt-1 text-sm text-[var(--text-tertiary)]">
            {t("admin.logs.desc") || "Registro de errores y warnings de la aplicación"}
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="refresh-logs-btn"
            class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] hover:bg-[var(--surface-4)] transition-all"
          >
            {t("admin.refresh") || "Actualizar"}
          </button>
          <button
            id="cleanup-logs-btn"
            class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] hover:bg-[var(--danger)] hover:text-white hover:border-[var(--danger)] transition-all"
          >
            {t("admin.logs.cleanup") || "Limpiar antiguos"}
          </button>
        </div>
      </div>

      <!-- Filters -->
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <select
          id="filter-level"
          class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-secondary)] backdrop-blur-sm"
        >
          <option value="all">{t("admin.all") || "Todos"}</option>
          <option value="critical">Critical</option>
          <option value="error">Error</option>
          <option value="warn">Warning</option>
        </select>

        <select
          id="filter-feature"
          class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-secondary)] backdrop-blur-sm"
        >
          <option value="all">{t("admin.all") || "Todos"}</option>
          <option value="auth">Auth</option>
          <option value="diet">Diet</option>
          <option value="workout">Workout</option>
          <option value="chat">Chat</option>
          <option value="clinical">Clinical</option>
          <option value="progress">Progress</option>
          <option value="system">System</option>
        </select>

        <input
          id="filter-search"
          type="text"
          placeholder={t("admin.search") || "Buscar..."}
          class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm"
        />

        <button
          id="apply-filters-btn"
          class="rounded-lg bg-[var(--brand)] px-3 py-2 text-xs font-medium text-[var(--text-on-brand)] hover:bg-[var(--brand-hover)] transition-all"
        >
          {t("admin.apply") || "Aplicar filtros"}
        </button>
      </div>

      <!-- Logs table -->
      <div class="mt-6 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead class="bg-[var(--surface-4)]">
              <tr>
                <th class="px-4 py-3 text-left font-medium text-[var(--text-tertiary)]">{t("admin.logs.timestamp") || "Fecha"}</th>
                <th class="px-4 py-3 text-left font-medium text-[var(--text-tertiary)]">{t("admin.logs.user") || "Usuario"}</th>
                <th class="px-4 py-3 text-left font-medium text-[var(--text-tertiary)]">{t("admin.logs.activity") || "Actividad"}</th>
                <th class="px-4 py-3 text-left font-medium text-[var(--text-tertiary)]">{t("admin.logs.level") || "Nivel"}</th>
                <th class="px-4 py-3 text-left font-medium text-[var(--text-tertiary)]">{t("admin.logs.message") || "Mensaje"}</th>
                <th class="px-4 py-3 text-left font-medium text-[var(--text-tertiary)]">{t("admin.logs.occurrences") || "Ocurrencias"}</th>
                <th class="px-4 py-3 text-right font-medium text-[var(--text-tertiary)]">{t("admin.logs.actions") || "Acciones"}</th>
              </tr>
            </thead>
            <tbody id="logs-table-body" class="divide-y divide-[var(--border-subtle)]">
              <tr>
                <td colspan="7" class="px-4 py-8 text-center text-[var(--text-tertiary)]">
                  {t("admin.logs.loading") || "Cargando logs..."}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pagination -->
      <div id="logs-pagination" class="mt-4 flex items-center justify-between">
        <div class="text-xs text-[var(--text-tertiary)]">
          <span id="logs-count">0</span> {t("admin.logs.total") || "logs encontrados"}
        </div>
        <div class="flex gap-2">
          <button
            id="prev-page-btn"
            disabled
            class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] disabled:opacity-50 disabled:cursor-not-allowed hover:bg-[var(--surface-4)] transition-all"
          >
            {t("admin.prev") || "Anterior"}
          </button>
          <button
            id="next-page-btn"
            disabled
            class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] disabled:opacity-50 disabled:cursor-not-allowed hover:bg-[var(--surface-4)] transition-all"
          >
            {t("admin.next") || "Siguiente"}
          </button>
        </div>
      </div>
    </PageTransition>
  </div>

  <!-- Detail Modal -->
  <div id="log-detail-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm">
    <div class="flex min-h-full items-center justify-center p-4">
      <div class="w-full max-w-2xl rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 shadow-2xl backdrop-blur-xl">
        <div class="flex items-center justify-between">
          <h3 data-i18n="admin.logs.detail" class="text-lg font-semibold">{t("admin.logs.detail") || "Detalle del log"}</h3>
          <button id="close-detail-modal" class="rounded-lg p-1.5 text-[var(--text-tertiary)] hover:text-[var(--text-secondary)] hover:bg-[var(--surface-3)] transition-all">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <div id="log-detail-content" class="mt-4 space-y-4 text-xs">
          <!-- Content injected via JS -->
        </div>

        <div class="mt-6 flex justify-end gap-2">
          <button
            id="close-detail-btn"
            class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-4 py-2 text-xs font-medium text-[var(--text-secondary)] hover:bg-[var(--surface-3)] transition-all"
          >
            {t("admin.close") || "Cerrar"}
          </button>
          <button
            id="delete-log-btn"
            class="rounded-lg bg-[var(--danger)] px-4 py-2 text-xs font-medium text-white hover:bg-[var(--danger-hover)] transition-all"
          >
            {t("admin.delete") || "Eliminar"}
          </button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  const API = '/api/admin/logs';
  const PAGE_SIZE = 50;

  const els = {
    level: document.getElementById('filter-level'),
    feature: document.getElementById('filter-feature'),
    search: document.getElementById('filter-search'),
    apply: document.getElementById('apply-filters-btn'),
    table: document.getElementById('logs-table-body'),
    count: document.getElementById('logs-count'),
    prev: document.getElementById('prev-page-btn'),
    next: document.getElementById('next-page-btn'),
    refresh: document.getElementById('refresh-logs-btn'),
    cleanup: document.getElementById('cleanup-logs-btn'),
    detailModal: document.getElementById('log-detail-modal'),
    detailContent: document.getElementById('log-detail-content'),
    closeDetail: document.getElementById('close-detail-modal'),
    closeDetailBtn: document.getElementById('close-detail-btn'),
    deleteBtn: document.getElementById('delete-log-btn'),
  };

  let currentStartAfter = null;
  let currentLogs = [];

  const toQuery = () => {
    const p = new URLSearchParams();
    const level = els.level.value;
    const feature = els.feature.value;
    const search = els.search.value.trim();
    if (level && level !== 'all') p.set('level', level);
    if (feature && feature !== 'all') p.set('feature', feature);
    if (search) p.set('search', search);
    if (currentStartAfter) p.set('startAfter', currentStartAfter);
    p.set('limit', String(PAGE_SIZE));
    return p.toString();
  };

  const load = async () => {
    els.table.innerHTML = '<tr><td colspan="7" class="px-4 py-8 text-center text-[var(--text-tertiary)]">Cargando...</td></tr>';
    const res = await fetch(`${API}?${toQuery()}`, { headers: { Accept: 'application/json' } });
    const data = await res.json();
    currentLogs = data.logs || [];
    els.count.textContent = String(data.total || 0);
    renderTable(currentLogs);
    els.prev.disabled = !data.hasMore;
    els.next.disabled = !data.hasMore;
    currentStartAfter = data.nextCursor;
  };

  const renderTable = (logs) => {
    if (!logs.length) {
      els.table.innerHTML = '<tr><td colspan="7" class="px-4 py-8 text-center text-[var(--text-tertiary)]">Sin logs</td></tr>';
      return;
    }
    const levelBadge = (level) => {
      const map = {
        critical: 'bg-red-500/15 text-red-600',
        error: 'bg-orange-500/15 text-orange-600',
        warn: 'bg-yellow-500/15 text-yellow-700',
      };
      const cls = map[level] || 'bg-gray-500/15 text-gray-600';
      return `<span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium ${cls}">${level.toUpperCase()}</span>`;
    };
    els.table.innerHTML = logs.map((log) => {
      const date = log.timestamp ? new Date(log.timestamp.seconds ? log.timestamp.seconds * 1000 : log.timestamp).toLocaleString() : '—';
      return `
        <tr class="hover:bg-[var(--surface-3)] transition-colors">
          <td class="px-4 py-3 whitespace-nowrap text-[var(--text-tertiary)]">${escapeHtml(date)}</td>
          <td class="px-4 py-3 whitespace-nowrap text-[var(--text-secondary)]">${escapeHtml(String(log.userId || '—'))}</td>
          <td class="px-4 py-3 whitespace-nowrap text-[var(--text-secondary)]">${escapeHtml(String(log.activity || '—'))}</td>
          <td class="px-4 py-3 whitespace-nowrap">${levelBadge(log.level || 'error')}</td>
          <td class="px-4 py-3 text-[var(--text-primary)] line-clamp-1">${escapeHtml(String(log.message || '—'))}</td>
          <td class="px-4 py-3 text-center text-[var(--text-secondary)]">${log.occurrenceCount ?? 1}</td>
          <td class="px-4 py-3 text-right">
            <button data-id="${log.id}" data-action="detail" class="text-[var(--brand)] hover:underline text-[10px]">Ver</button>
          </td>
        </tr>
      `;
    }).join('');

    els.table.querySelectorAll('[data-action="detail"]').forEach((btn) => {
      btn.addEventListener('click', () => openDetail(btn.dataset.id));
    });
  };

  const openDetail = (id) => {
    const log = currentLogs.find((l) => l.id === id);
    if (!log) return;
    const date = log.timestamp ? new Date(log.timestamp.seconds ? log.timestamp.seconds * 1000 : log.timestamp).toLocaleString() : '—';
    els.detailContent.innerHTML = `
      <div class="grid grid-cols-2 gap-4">
        <div><span class="text-[var(--text-tertiary)]">ID</span><p class="mt-1 font-mono">${escapeHtml(log.id)}</p></div>
        <div><span class="text-[var(--text-tertiary)]">Timestamp</span><p class="mt-1">${escapeHtml(date)}</p></div>
        <div><span class="text-[var(--text-tertiary)]">Level</span><p class="mt-1">${escapeHtml(String(log.level))}</p></div>
        <div><span class="text-[var(--text-tertiary)]">Feature</span><p class="mt-1">${escapeHtml(String(log.feature || '—'))}</p></div>
        <div><span class="text-[var(--text-tertiary)]">User</span><p class="mt-1">${escapeHtml(String(log.userId || '—'))}</p></div>
        <div><span class="text-[var(--text-tertiary)]">Role</span><p class="mt-1">${escapeHtml(String(log.userRole || '—'))}</p></div>
        <div class="col-span-2"><span class="text-[var(--text-tertiary)]">Message</span><p class="mt-1">${escapeHtml(String(log.message || '—'))}</p></div>
        <div class="col-span-2"><span class="text-[var(--text-tertiary)]">Activity</span><p class="mt-1">${escapeHtml(String(log.activity || '—'))} · ${escapeHtml(String(log.action || '—'))}</p></div>
        <div class="col-span-2"><span class="text-[var(--text-tertiary)]">URL</span><p class="mt-1 break-all">${escapeHtml(String(log.url || '—'))}</p></div>
        <div class="col-span-2"><span class="text-[var(--text-tertiary)]">UA</span><p class="mt-1 break-all">${escapeHtml(String(log.userAgent || '—'))}</p></div>
        <div class="col-span-2"><span class="text-[var(--text-tertiary)]">Stack</span><pre class="mt-1 whitespace-pre-wrap rounded-lg bg-[var(--surface-4)] p-3 text-[10px]">${escapeHtml(String(log.errorStack || '—'))}</pre></div>
      </div>
    `;
    els.deleteBtn.onclick = () => deleteLog(log.id);
    els.detailModal.classList.remove('hidden');
  };

  const deleteLog = async (id) => {
    await fetch(`${API}?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
    els.detailModal.classList.add('hidden');
    load();
  };

  const escapeHtml = (str) => String(str).replace(/[&<>"']/g, (m) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));

  els.apply.addEventListener('click', () => { currentStartAfter = null; load(); });
  els.prev.addEventListener('click', () => load());
  els.next.addEventListener('click', () => load());
  els.refresh.addEventListener('click', () => load());
  els.closeDetail.addEventListener('click', () => els.detailModal.classList.add('hidden'));
  els.closeDetailBtn.addEventListener('click', () => els.detailModal.classList.add('hidden'));

  load();
</script>