  import { requireAdmin } from '@/lib/admin/adminAuth';
  import { subscribeToUsers } from '@/lib/admin/adminSubscriptions';
  import { subscribeToConversation, sendMessage, markAllAsRead } from '@/lib/shared/chat';
  import { escapeHtml, getRoleBadge } from '@/lib/shared/ui';
  import { db } from '@/lib/firebase';
  import { collection, query, where, onSnapshot } from 'firebase/firestore';
  import type { AdminUser } from '@/lib/admin/types';
  import type { ChatMessage } from '@/lib/shared/chat';

  const unsubInit = requireAdmin(async (user) => {
    initAdminChat(user.uid);
  });

  let adminId: string = '';
  let allUsers: AdminUser[] = [];
  let userMessagesMap = new Map<string, { lastMessage: ChatMessage | null; unreadCount: number }>();
  let selectedUser: AdminUser | null = null;
  let activeRoleFilter: string = 'all';
  let unsubUsers: (() => void) | null = null;
  let unsubConversation: (() => void) | null = null;
  let unsubNotifications: (() => void) | null = null;

  document.addEventListener('astro:before-swap', () => {
    unsubInit?.();
    unsubUsers?.();
    unsubConversation?.();
    unsubNotifications?.();
