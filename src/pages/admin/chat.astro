---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<AdminLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold">Mensajería de Soporte (Admin)</h1>
          <p class="mt-1 text-sm theme-text-tertiary">Chatea en tiempo real con todos los alumnos de la plataforma</p>
        </div>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
        <!-- Conversation List -->
        <div class="lg:col-span-1">
          <div class="rounded-xl border theme-border theme-surface-secondary backdrop-blur-sm overflow-hidden">
            <div class="border-b theme-border p-3">
              <input id="chat-search" type="text" placeholder="Buscar alumno..." class="w-full rounded-lg border theme-border theme-surface-secondary/60 px-3 py-2 text-xs theme-text-primary placeholder-zinc-600 focus:outline-none focus:theme-border-focus/50" />
            </div>
            <div id="conversation-list" class="divide-y divide-zinc-800/40 max-h-[70vh] overflow-y-auto">
              <div class="p-6 text-center">
                <p class="text-xs theme-text-tertiary">Cargando alumnos...</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Chat View -->
        <div class="lg:col-span-2">
          <div id="chat-view" class="hidden rounded-xl border theme-border theme-surface-secondary backdrop-blur-sm overflow-hidden flex flex-col" style="height: min(70vh, 600px);">
            <!-- Chat Header -->
            <div id="chat-header" class="flex items-center gap-3 border-b theme-border p-4">
              <div class="flex h-9 w-9 items-center justify-center rounded-full theme-brand/10 text-sm font-medium theme-text-brand">?</div>
              <div>
                <p class="text-sm font-medium theme-text-primary">Selecciona un chat</p>
                <p class="text-xs theme-text-tertiary">Inicia una conversación</p>
              </div>
            </div>

            <!-- Messages -->
            <div id="messages-container" class="flex-1 overflow-y-auto p-4 space-y-3">
              <div class="flex h-full items-center justify-center">
                <p class="text-sm theme-text-tertiary">Selecciona un alumno para chatear</p>
              </div>
            </div>

            <!-- Input -->
            <div class="border-t theme-border p-3">
              <div class="flex items-center gap-2">
                <input id="chat-input" type="text" placeholder="Escribe un mensaje..." class="flex-1 rounded-xl border theme-border theme-surface-secondary/60 px-4 py-2.5 text-sm theme-text-primary placeholder-zinc-600 focus:outline-none focus:theme-border-focus/50" />
                <button id="btn-send-message" class="rounded-xl theme-brand/10 border theme-border-focus/20 px-4 py-2.5 text-sm font-medium theme-text-brand hover:theme-brand/20 transition-all disabled:opacity-40 disabled:cursor-not-allowed" disabled>
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                  </svg>
                </button>
                <button id="btn-send-alert" class="rounded-xl bg-red-500/10 border border-red-500/20 px-3 py-2.5 text-sm font-medium text-red-400 hover:bg-red-500/20 transition-all disabled:opacity-40 disabled:cursor-not-allowed" title="Enviar llamado de atención" disabled>
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Empty State -->
          <div id="chat-empty" class="rounded-xl border theme-border theme-surface-secondary p-8 text-center backdrop-blur-sm flex flex-col items-center justify-center" style="height: min(70vh, 600px);">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl theme-surface-hover">
              <svg class="h-7 w-7 theme-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
              </svg>
            </div>
            <p class="text-sm theme-text-tertiary">Selecciona un alumno de la lista para comenzar a chatear</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { requireAdmin } from '@/lib/shared/authGuard';
  import { db } from '@/lib/firebase';
  import { doc, getDoc, collection, addDoc, query, where, orderBy, onSnapshot, updateDoc, serverTimestamp, limit } from 'firebase/firestore';
  import { subscribeToUsersByRole } from '@/lib/admin/adminUtils';
  import { getUserInitial, formatTime, escapeHtml, showToast } from '@/lib/shared/ui';
  import { renderMessageBubble } from '@/lib/trainer/trainerUtils';
  import { logger } from '@/lib/shared/logger';

  interface Client {
    uid: string;
    name: string;
    email: string;
    hasActiveAlert?: boolean;
  }

  interface Message {
    id: string;
    senderId: string;
    receiverId: string;
    content: string;
    type: 'text' | 'alert';
    isRead: boolean;
    createdAt: any;
  }

  let unsubClients: (() => void) | null = null;
  let unsubConversations: (() => void) | null = null;
  let allClients: Client[] = [];
  let conversations: { clientId: string; lastMessage: Message | null; unread: number }[] = [];
  let selectedClient: Client | null = null;
  let currentUnsub: (() => void) | null = null;
  let adminUid: string = '';

  const unsubscribeAuth = requireAdmin((user) => {
    adminUid = user.uid;
    initChat();
  });

  document.addEventListener('astro:before-swap', () => {
    unsubscribeAuth?.();
    unsubClients?.();
    unsubConversations?.();
    currentUnsub?.();
  });

  async function initChat(): Promise<void> {
    const conversationList = document.getElementById('conversation-list')!;
    const chatSearch = document.getElementById('chat-search') as HTMLInputElement;
    const chatView = document.getElementById('chat-view')!;
    const chatEmpty = document.getElementById('chat-empty')!;
    const messagesContainer = document.getElementById('messages-container')!;
    const chatInput = document.getElementById('chat-input') as HTMLInputElement;
    const btnSend = document.getElementById('btn-send-message')!;
    const btnAlert = document.getElementById('btn-send-alert')!;

    // 1. Subscribe to all clients
    unsubClients = subscribeToUsersByRole('client', (clients) => {
      allClients = clients.map(c => ({
        uid: c.uid,
        name: c.name,
        email: c.email,
        hasActiveAlert: c.hasActiveAlert
      }));
      renderConversations();
    });

    // 2. Subscribe to admin conversations
    const q = query(
      collection(db, 'messages'),
      where('participants', 'array-contains', adminUid),
      orderBy('createdAt', 'desc'),
      limit(100)
    );

    unsubConversations = onSnapshot(q, (snapshot) => {
      const messages = snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      })) as Message[];

      const clientMap = new Map<string, Message[]>();
      messages.forEach((m) => {
        const clientId = m.senderId === adminUid ? m.receiverId : m.senderId;
        if (!clientMap.has(clientId)) clientMap.set(clientId, []);
        clientMap.get(clientId)!.push(m);
      });

      conversations = Array.from(clientMap.entries())
        .map(([clientId, msgs]) => {
          const sorted = msgs.sort((a, b) => {
            const timeA = a.createdAt?.toDate?.()?.getTime() || 0;
            const timeB = b.createdAt?.toDate?.()?.getTime() || 0;
            return timeB - timeA;
          });
          return {
            clientId,
            lastMessage: sorted[0] || null,
            unread: msgs.filter((m) => m.receiverId === adminUid && !m.isRead).length,
          };
        })
        .sort((a, b) => {
          const timeA = a.lastMessage?.createdAt?.toDate?.()?.getTime() || 0;
          const timeB = b.lastMessage?.createdAt?.toDate?.()?.getTime() || 0;
          return timeB - timeA;
        });

      renderConversations();
    }, (error) => {
      logger.error('AdminChat', 'Error al suscribirse a mensajes del chat:', error);
    });

    chatSearch.addEventListener('input', () => renderConversations());

    btnSend.addEventListener('click', async () => {
      const content = chatInput.value.trim();
      if (!content || !selectedClient) return;
      await sendMessage(selectedClient.uid, content, 'text');
    });

    btnAlert.addEventListener('click', async () => {
      const content = chatInput.value.trim();
      if (!content || !selectedClient) return;
      await sendMessage(selectedClient.uid, content, 'alert');
    });

    chatInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') btnSend.click();
    });

    (window as any).__selectConversation = (clientId: string) => {
      const client = allClients.find((c) => c.uid === clientId);
      if (!client) return;
      selectedClient = client;

      chatView.classList.remove('hidden');
      chatEmpty.classList.add('hidden');
      btnSend.removeAttribute('disabled');
      btnAlert.removeAttribute('disabled');
      chatInput.removeAttribute('disabled');
      chatInput.focus();

      const chatHeader = document.getElementById('chat-header')!;
      chatHeader.innerHTML = `
        <div class="flex h-9 w-9 items-center justify-center rounded-full theme-brand/10 text-sm font-medium theme-text-brand">
          ${getUserInitial(client.name)}
        </div>
        <div>
          <p class="text-sm font-medium theme-text-primary">${escapeHtml(client.name)}</p>
          <p class="text-xs theme-text-tertiary">${escapeHtml(client.email)}</p>
        </div>
      `;

      if (currentUnsub) currentUnsub();
      currentUnsub = null;

      const conversationQuery = query(
        collection(db, 'messages'),
        where('participants', 'array-contains', adminUid),
        orderBy('createdAt', 'asc')
      );

      currentUnsub = onSnapshot(conversationQuery, (snapshot) => {
        const msgs = snapshot.docs
          .map(doc => ({ id: doc.id, ...doc.data() }) as Message)
          .filter(m => m.senderId === clientId || m.receiverId === clientId);

        if (msgs.length === 0) {
          messagesContainer.innerHTML = `
            <div class="flex h-full items-center justify-center">
              <p class="text-sm theme-text-tertiary">No hay mensajes aún. ¡Envía el primero!</p>
            </div>
          `;
          return;
        }

        // Mark unread as read
        msgs.forEach(async (m) => {
          if (m.receiverId === adminUid && !m.isRead) {
            await updateDoc(doc(db, 'messages', m.id), { isRead: true });
          }
        });

        messagesContainer.innerHTML = msgs
          .map((m, idx) => {
            const isOwn = m.senderId === adminUid;
            const prevMsg = idx > 0 ? msgs[idx - 1] : null;
            const isFirstOfBlock = !prevMsg || prevMsg.senderId !== m.senderId;
            return renderMessageBubble(m, isOwn, client.name, isFirstOfBlock);
          })
          .join('');

        scrollToBottom();
      });

      renderConversations();
    };
  }

  async function sendMessage(clientId: string, content: string, type: 'text' | 'alert') {
    const chatInput = document.getElementById('chat-input') as HTMLInputElement;
    try {
      // 1. Add doc to messages subcollection
      await addDoc(collection(db, 'messages'), {
        senderId: adminUid,
        receiverId: clientId,
        participants: [adminUid, clientId],
        content,
        type,
        isRead: false,
        createdAt: serverTimestamp()
      });

      // 2. If it is an alert, also set hasActiveAlert on user document
      if (type === 'alert') {
        await updateDoc(doc(db, 'users', clientId), { hasActiveAlert: true });
      }

      chatInput.value = '';
      scrollToBottom();
    } catch (err) {
      logger.error('AdminChat', 'Error al enviar mensaje:', err);
      showToast({ message: 'Error al enviar mensaje', type: 'error' });
    }
  }

  function renderConversations(): void {
    const conversationList = document.getElementById('conversation-list')!;
    const chatSearch = document.getElementById('chat-search') as HTMLInputElement;
    const searchTerm = chatSearch.value.toLowerCase();

    // Queremos listar todos los alumnos del sistema, ordenándolos para mostrar
    // primero aquellos con los que tenemos una conversación activa.
    const items = allClients
      .map((client) => {
        const conv = conversations.find(c => c.clientId === client.uid);
        return {
          client,
          lastMessage: conv?.lastMessage || null,
          unread: conv?.unread || 0
        };
      })
      .filter(item => item.client.name.toLowerCase().includes(searchTerm))
      .sort((a, b) => {
        const timeA = a.lastMessage?.createdAt?.toDate?.()?.getTime() || 0;
        const timeB = b.lastMessage?.createdAt?.toDate?.()?.getTime() || 0;
        return timeB - timeA;
      });

    if (items.length === 0) {
      conversationList.innerHTML = `<div class="p-6 text-center"><p class="text-xs theme-text-tertiary">Sin alumnos</p></div>`;
      return;
    }

    conversationList.innerHTML = items
      .map((item) => {
        const client = item.client;
        const name = client.name;
        const initial = getUserInitial(name);
        const hasAlert = client.hasActiveAlert;
        const lastMsg = item.lastMessage?.content || 'Sin mensajes';
        const time = item.lastMessage ? formatTime(item.lastMessage.createdAt) : '';
        const isSelected = selectedClient?.uid === client.uid;

        return `
          <div class="flex items-center gap-3 p-3 cursor-pointer transition-all hover:theme-surface-secondary/40 ${isSelected ? 'theme-surface-secondary/40' : ''}" onclick="window.__selectConversation('${client.uid}')">
            <div class="relative shrink-0">
              <div class="flex h-10 w-10 items-center justify-center rounded-full theme-brand/10 text-sm font-medium theme-text-brand">
                ${initial}
              </div>
              ${hasAlert ? '<div class="absolute -right-0.5 -top-0.5 h-3 w-3 rounded-full bg-red-500 animate-pulse border-2 border-zinc-900"></div>' : ''}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between">
                <p class="text-sm font-medium theme-text-primary truncate">${escapeHtml(name)}</p>
                <span class="text-[10px] theme-text-tertiary shrink-0 ml-2">${time}</span>
              </div>
              <div class="flex items-center justify-between mt-0.5">
                <p class="text-xs theme-text-tertiary truncate">${escapeHtml(lastMsg.substring(0, 40))}${lastMsg.length > 40 ? '...' : ''}</p>
                ${item.unread > 0 ? `<span class="flex h-4 w-4 items-center justify-center rounded-full theme-brand text-[9px] font-bold theme-text-primary shrink-0 ml-2">${item.unread}</span>` : ''}
              </div>
            </div>
          </div>
        `;
      })
      .join('');
  }

  function scrollToBottom(): void {
    const container = document.getElementById('messages-container')!;
    setTimeout(() => {
      container.scrollTop = container.scrollHeight;
    }, 50);
  }
</script>
