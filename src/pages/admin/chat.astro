  async function sendMessage(clientId: string, content: string, type: 'text' | 'alert') {
    const chatInput = document.getElementById('chat-input') as HTMLInputElement;
    try {
      // 1. Add doc to messages subcollection
      await addDoc(collection(db, 'messages'), {
        senderId: adminUid,
        receiverId: clientId,
        participants: [adminUid, clientId],
        content,
        type,
        isRead: false,
        createdAt: serverTimestamp()
      });

      // 2. If it is an alert, also set hasActiveAlert on user document
      if (type === 'alert') {
        await updateDoc(doc(db, 'users', clientId), { hasActiveAlert: true });
      }

      chatInput.value = '';
      scrollToBottom();
    } catch (err) {
      logger.error('AdminChat', 'Error al enviar mensaje:', err);
      showToast({ message: 'Error al enviar mensaje', type: 'error' });
    }
  }

