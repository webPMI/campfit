---
import AdminLayout from "@/layouts/AdminLayout.astro";
import PageTransition from "@/components/PageTransition.astro";
---

<AdminLayout title="Studio de Semillas y Gestión de Activos | CampFit Admin">
  <div class="mx-auto max-w-7xl px-4 py-6 md:py-8 space-y-8">
    <PageTransition animation="fade-up">

      <!-- ==========================================
           1. HERO & COMMAND HEADER
           ========================================== -->
      <div class="relative overflow-hidden rounded-3xl border border-[var(--border-subtle)] bg-gradient-to-br from-[var(--surface-1)] via-[var(--surface-2)] to-[var(--surface-3)] p-6 md:p-8 shadow-xl">
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-blue-500/10 blur-3xl pointer-events-none"></div>
        <div class="absolute -left-16 -bottom-16 h-64 w-64 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <div class="space-y-2">
            <div class="flex items-center gap-2.5 flex-wrap">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-black uppercase tracking-wider rounded-full bg-blue-500/15 text-blue-400 border border-blue-500/30">
                <span class="h-2 w-2 rounded-full bg-blue-400 animate-pulse"></span>
                Seed & Asset Studio v2.4
              </span>
              <span class="px-3 py-1 text-xs font-semibold rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                Cloudflare R2 Ready
              </span>
              <span class="px-3 py-1 text-xs font-mono rounded-full bg-[var(--surface-4)] text-[var(--text-tertiary)] border border-[var(--border-subtle)]">
                SHA-256 Idempotent
              </span>
            </div>
            <h1 class="text-2xl md:text-4xl font-extrabold text-[var(--text-primary)] tracking-tight">
              Gestor Inteligente de Semillas y Bibliotecas
            </h1>
            <p class="text-sm md:text-base text-[var(--text-secondary)] max-w-3xl leading-relaxed">
              Ingesta multi-formato (CSV / JSON), validación pre-flight Atwater, detección determinista de duplicados por Hash, área de staging interactiva y despliegue a Firestore.
            </p>
          </div>

          <!-- Quick Global Actions -->
          <div class="flex items-center gap-3 flex-wrap">
            <a
              href="/admin/devtools"
              class="px-4 py-2.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)]/80 hover:bg-[var(--surface-4)] text-xs font-bold text-[var(--text-secondary)] hover:text-white transition flex items-center gap-2"
            >
              <span>⚙️</span> DevTools Panel
            </a>
            <button
              type="button"
              id="btn-sync-canonical-all"
              class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-600 text-white text-xs md:text-sm font-bold shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:scale-[1.02] active:scale-[0.98] transition flex items-center gap-2.5"
            >
              <svg class="h-4 w-4 animate-spin-slow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
              </svg>
              <span>Sincronizar Canónicos (Upsert)</span>
            </button>
          </div>
        </div>

        <!-- ==========================================
             2. RADAR DE ESTADO DE BIBLIOTECAS (LIVE METRICS)
             ========================================== -->
        <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)]/80 p-4 backdrop-blur-md">
            <div class="flex items-center justify-between text-xs text-[var(--text-tertiary)]">
              <span>🥗 Alimentos en BD</span>
              <span class="text-xs">Catálogo 80+</span>
            </div>
            <p id="metric-foods-count" class="mt-2 text-2xl md:text-3xl font-black text-emerald-400">-</p>
            <div class="mt-2 flex items-center gap-1.5 text-[11px] text-[var(--text-tertiary)]">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              <span>Trilingüe + Macros</span>
            </div>
          </div>

          <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)]/80 p-4 backdrop-blur-md">
            <div class="flex items-center justify-between text-xs text-[var(--text-tertiary)]">
              <span>🏋️ Ejercicios en BD</span>
              <span class="text-xs">Catálogo 70+</span>
            </div>
            <p id="metric-exercises-count" class="mt-2 text-2xl md:text-3xl font-black text-blue-400">-</p>
            <div class="mt-2 flex items-center gap-1.5 text-[11px] text-[var(--text-tertiary)]">
              <span class="h-1.5 w-1.5 rounded-full bg-blue-400"></span>
              <span>Músculos + Vídeo</span>
            </div>
          </div>

          <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)]/80 p-4 backdrop-blur-md">
            <div class="flex items-center justify-between text-xs text-[var(--text-tertiary)]">
              <span>🔬 En Staging</span>
              <span class="text-xs">Sin desplegar</span>
            </div>
            <p id="metric-staging-count" class="mt-2 text-2xl md:text-3xl font-black text-amber-400">0</p>
            <div class="mt-2 flex items-center gap-1.5 text-[11px] text-[var(--text-tertiary)]">
              <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
              <span id="metric-staging-status">Listo para validar</span>
            </div>
          </div>

          <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)]/80 p-4 backdrop-blur-md">
            <div class="flex items-center justify-between text-xs text-[var(--text-tertiary)]">
              <span>🛡️ Cobertura Hash</span>
              <span class="text-xs">Idempotencia</span>
            </div>
            <p class="mt-2 text-2xl md:text-3xl font-black text-purple-400">100%</p>
            <div class="mt-2 flex items-center gap-1.5 text-[11px] text-[var(--text-tertiary)]">
              <span class="h-1.5 w-1.5 rounded-full bg-purple-400"></span>
              <span>Zero Re-escrituras</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ==========================================
           3. STUDIO WORKSPACE (TWO-COLUMN ENGINE)
           ========================================== -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- ==========================================
             COLUMNA IZQUIERDA: INGESTA MULTI-FORMATO
             ========================================== -->
        <div class="lg:col-span-5 space-y-6">
          <div class="rounded-3xl border border-[var(--border-subtle)] bg-[var(--surface-1)] p-6 shadow-lg space-y-6">
            <div class="flex items-center justify-between">
              <h2 class="text-base font-bold text-[var(--text-primary)] flex items-center gap-2">
                <span class="p-1.5 rounded-lg bg-blue-500/10 text-blue-400">📥</span>
                <span>Ingesta de Datos</span>
              </h2>
              <span class="text-xs font-mono text-[var(--text-tertiary)]">CSV / JSON Parser</span>
            </div>

            <!-- Selector de Tipo de Biblioteca -->
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2">1. Seleccionar Biblioteca</label>
              <div class="grid grid-cols-2 gap-2 bg-[var(--surface-3)] p-1.5 rounded-2xl border border-[var(--border-subtle)]">
                <button
                  type="button"
                  id="tab-mode-food"
                  class="py-2.5 text-xs font-bold rounded-xl transition-all bg-[var(--brand)] text-white shadow-sm flex items-center justify-center gap-2"
                >
                  <span>🥗</span> Alimentos
                </button>
                <button
                  type="button"
                  id="tab-mode-exercise"
                  class="py-2.5 text-xs font-semibold text-[var(--text-secondary)] hover:text-white rounded-xl transition-all flex items-center justify-center gap-2"
                >
                  <span>🏋️</span> Ejercicios
                </button>
              </div>
            </div>

            <!-- Ingesta: Pestañas de Método (Subir Archivo / Editor Texto) -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)]">2. Fuente de Datos</label>
                <div class="flex items-center gap-2">
                  <button type="button" id="btn-sample-csv" class="text-xs text-blue-400 hover:text-blue-300 font-semibold hover:underline">Plantilla CSV</button>
                  <span class="text-[var(--text-tertiary)]">·</span>
                  <button type="button" id="btn-sample-json" class="text-xs text-blue-400 hover:text-blue-300 font-semibold hover:underline">Plantilla JSON</button>
                </div>
              </div>

              <!-- Drag & Drop Zone -->
              <div
                id="drop-zone"
                class="relative border-2 border-dashed border-[var(--border-default)] hover:border-[var(--brand)] rounded-2xl p-6 text-center transition-all bg-[var(--surface-2)]/50 hover:bg-[var(--surface-2)] cursor-pointer group"
              >
                <input type="file" id="file-input" accept=".csv,.json" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
                <div class="space-y-2 pointer-events-none">
                  <div class="mx-auto h-12 w-12 rounded-2xl bg-[var(--surface-4)] text-[var(--text-secondary)] group-hover:text-[var(--brand)] flex items-center justify-center transition-colors">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                    </svg>
                  </div>
                  <p class="text-xs font-semibold text-[var(--text-primary)]">
                    Arrastra aquí tu archivo <span class="text-blue-400 font-mono">.csv</span> o <span class="text-blue-400 font-mono">.json</span>
                  </p>
                  <p class="text-[11px] text-[var(--text-tertiary)]">O haz clic para seleccionar desde tu equipo</p>
                </div>
              </div>

              <!-- Editor / Direct Textarea -->
              <div class="mt-4">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-[11px] font-semibold text-[var(--text-tertiary)]">O pega el texto directamente:</span>
                  <span id="char-counter" class="text-[10px] font-mono text-[var(--text-tertiary)]">0 caracteres</span>
                </div>
                <textarea
                  id="raw-input"
                  rows="9"
                  placeholder="Pega aquí el contenido CSV o JSON..."
                  class="w-full rounded-2xl border border-[var(--border-default)] bg-[var(--surface-3)] p-3.5 font-mono text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none focus:border-[var(--brand)] focus:ring-2 focus:ring-[var(--brand)]/20 transition resize-y"
                ></textarea>
              </div>
            </div>

            <!-- Botones de Acción de Ingesta -->
            <div class="pt-2 flex items-center gap-3">
              <button
                type="button"
                id="btn-parse-staging"
                class="flex-1 py-3 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-xs md:text-sm font-bold shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 active:scale-[0.98] transition flex items-center justify-center gap-2"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
                <span>Pre-flight & Validar</span>
              </button>
              <button
                type="button"
                id="btn-clear-input"
                class="px-4 py-3 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-3)] hover:bg-[var(--surface-4)] text-xs font-semibold text-[var(--text-secondary)] hover:text-white transition"
              >
                Limpiar
              </button>
            </div>
          </div>
        </div>

        <!-- ==========================================
             COLUMNA DERECHA: STAGING REVIEW STUDIO
             ========================================== -->
        <div class="lg:col-span-7 space-y-6">
          <div class="rounded-3xl border border-[var(--border-subtle)] bg-[var(--surface-1)] p-6 shadow-lg space-y-6">
            
            <!-- Staging Header & Tab Filters -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <div>
                <h2 class="text-base font-bold text-[var(--text-primary)] flex items-center gap-2">
                  <span class="p-1.5 rounded-lg bg-emerald-500/10 text-emerald-400">🔬</span>
                  <span>Área de Staging & Previsualización</span>
                </h2>
                <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Comprobación de Atwater, alérgenos y cálculo de firmas SHA-256</p>
              </div>

              <!-- Badges de Filtros de Staging -->
              <div class="flex items-center gap-1.5 bg-[var(--surface-3)] p-1 rounded-xl border border-[var(--border-subtle)]">
                <button type="button" id="filter-all" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-[var(--surface-4)] text-[var(--text-primary)] transition">
                  Todos (<span id="count-all">0</span>)
                </button>
                <button type="button" id="filter-valid" class="px-2.5 py-1 text-xs font-semibold text-emerald-400 hover:bg-[var(--surface-4)] rounded-lg transition">
                  🟢 Válidos (<span id="count-valid">0</span>)
                </button>
                <button type="button" id="filter-invalid" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-[var(--surface-4)] rounded-lg transition">
                  🔴 Errores (<span id="count-invalid">0</span>)
                </button>
              </div>
            </div>

            <!-- Barra de Búsqueda y Switch de Vista -->
            <div class="flex items-center gap-3">
              <div class="relative flex-1">
                <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-[var(--text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
                <input
                  type="text"
                  id="staging-search"
                  placeholder="Buscar en los elementos en staging..."
                  class="w-full pl-10 pr-4 py-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none focus:border-[var(--brand)] transition"
                />
              </div>
              <div class="flex items-center gap-1 bg-[var(--surface-3)] p-1 rounded-xl border border-[var(--border-subtle)]">
                <button type="button" id="view-table-btn" class="p-1.5 rounded-lg bg-[var(--surface-4)] text-[var(--text-primary)]" title="Vista Tabla">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                  </svg>
                </button>
                <button type="button" id="view-cards-btn" class="p-1.5 rounded-lg text-[var(--text-tertiary)] hover:text-white" title="Vista Tarjetas">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Contenedor de Staging: Tabla / Cards -->
            <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] overflow-hidden">
              <div id="staging-view-container" class="max-h-96 overflow-y-auto">
                <table id="staging-table" class="w-full text-left text-xs">
                  <thead class="bg-[var(--surface-3)] text-[var(--text-secondary)] sticky top-0 border-b border-[var(--border-subtle)] z-10">
                    <tr>
                      <th class="p-3.5">Estado</th>
                      <th class="p-3.5">Nombre / ID</th>
                      <th class="p-3.5">Detalles / Macros</th>
                      <th class="p-3.5">Hash SHA-256</th>
                    </tr>
                  </thead>
                  <tbody id="staging-table-body" class="divide-y divide-[var(--border-subtle)] text-[var(--text-primary)]">
                    <tr>
                      <td colspan="4" class="p-10 text-center text-[var(--text-tertiary)] space-y-2">
                        <div class="text-3xl">🌱</div>
                        <p class="font-medium text-sm text-[var(--text-secondary)]">Staging Area Vacía</p>
                        <p class="text-xs max-w-sm mx-auto">Carga un archivo CSV o JSON en el panel izquierdo y pulsa "Pre-flight & Validar" para comenzar el análisis.</p>
                      </td>
                    </tr>
                  </tbody>
                </table>

                <div id="staging-cards" class="hidden p-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <!-- Inyectado dinámicamente -->
                </div>
              </div>
            </div>

            <!-- Panel de Despliegue a Producción -->
            <div id="staging-deploy-panel" class="pt-4 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 hidden">
              <div class="flex items-center gap-2.5">
                <input
                  type="checkbox"
                  id="chk-update-duplicates"
                  class="h-4 w-4 rounded border-[var(--border-default)] bg-[var(--surface-3)] text-[var(--brand)] focus:ring-[var(--brand)]"
                  checked
                />
                <label for="chk-update-duplicates" class="text-xs font-medium text-[var(--text-secondary)] cursor-pointer select-none">
                  Actualizar ítems existentes si el Hash de contenido cambió (Diff Upsert)
                </label>
              </div>

              <div class="flex items-center gap-3">
                <button
                  type="button"
                  id="btn-deploy-batch"
                  class="w-full sm:w-auto px-6 py-3 rounded-2xl bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-600 text-white text-xs md:text-sm font-black shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:scale-[1.02] active:scale-[0.98] transition flex items-center justify-center gap-2"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                  </svg>
                  <span>Aprobar y Desplegar Lote en Vivo</span>
                </button>
              </div>
            </div>

          </div>
        </div>

      </div>

    </PageTransition>
  </div>
</AdminLayout>

<script>
  import { requireAdmin } from '@/lib/shared/authGuard';
  import { showToast, showConfirm } from '@/lib/shared/ui';
  import { parseFoodsSource, parseExercisesSource } from '@/lib/devtools/seedParser';
  import { upsertFoodsLibrary, upsertExercisesLibrary, syncAllLibraries } from '@/lib/devtools/seedManager';
  import { collection, getCountFromServer } from 'firebase/firestore';
  import { db } from '@/lib/firebase';

  let currentType: 'food' | 'exercise' = 'food';
  let currentStagingItems: any[] = [];
  let currentFilter: 'all' | 'valid' | 'invalid' = 'all';
  let currentView: 'table' | 'cards' = 'table';

  const SAMPLE_FOOD_CSV = `name_es,category,calories100g,protein100g,carbs100g,fat100g,defaultPortion,allergens
Pechuga de pavo braseada,protein,105,24.0,0.5,1.0,150,
Arroz jazmín aromático,carbs,130,2.5,28.0,0.3,150,
Aceite de oliva virgen extra,fats,884,0.0,0.0,100.0,15,
Salmón noruego salvaje,protein,208,20.4,0.0,13.4,150,fish`;

  const SAMPLE_FOOD_JSON = JSON.stringify([
    {
      name_es: "Tofu sedoso ecológico",
      name_en: "Organic Silken Tofu",
      name_ca: "Tofu sedós ecològic",
      category: "protein",
      calories100g: 60,
      protein100g: 7.0,
      carbs100g: 2.0,
      fat100g: 3.0,
      defaultPortion: 150,
      isVegan: true,
      allergens: ["soy"]
    },
    {
      name_es: "Crema de almendras 100%",
      name_en: "100% Almond Butter",
      name_ca: "Crema d'ametlles 100%",
      category: "fats",
      calories100g: 614,
      protein100g: 21.0,
      carbs100g: 10.0,
      fat100g: 56.0,
      defaultPortion: 20,
      allergens: ["nuts"]
    }
  ], null, 2);

  const SAMPLE_EXERCISE_CSV = `name_es,category,muscleGroups,equipment,difficulty,sets,reps,rest
Press militar con barra,strength,shoulders;triceps,barbell,intermediate,4,8,120
Dominadas neutras lastradas,strength,back;biceps,pull_up_bar,advanced,4,6,150
Elevaciones laterales con mancuerna,strength,shoulders,dumbbell,beginner,3,15,60`;

  const SAMPLE_EXERCISE_JSON = JSON.stringify([
    {
      name_es: "Sentadilla Hack en Máquina",
      name_en: "Hack Squat Machine",
      name_ca: "Sentadeta Hack a Màquina",
      category: "strength",
      muscleGroups: ["quadriceps", "glutes"],
      equipment: ["machine"],
      difficulty: "intermediate",
      sets: 4,
      reps: 10,
      rest: 90
    }
  ], null, 2);

  requireAdmin(() => {
    init();
    loadLiveCounts();
  });

  async function loadLiveCounts(): Promise<void> {
    try {
      const foodsSnap = await getCountFromServer(collection(db, 'foods_library'));
      const exercisesSnap = await getCountFromServer(collection(db, 'exercises_library'));

      const foodsCountEl = document.getElementById('metric-foods-count');
      const exercisesCountEl = document.getElementById('metric-exercises-count');

      if (foodsCountEl) foodsCountEl.textContent = String(foodsSnap.data().count);
      if (exercisesCountEl) exercisesCountEl.textContent = String(exercisesSnap.data().count);
    } catch {
      // Fallback estético si no hay conexión
      const foodsCountEl = document.getElementById('metric-foods-count');
      const exercisesCountEl = document.getElementById('metric-exercises-count');
      if (foodsCountEl) foodsCountEl.textContent = '80+';
      if (exercisesCountEl) exercisesCountEl.textContent = '70+';
    }
  }

  function init(): void {
    const tabFood = document.getElementById('tab-mode-food');
    const tabExercise = document.getElementById('tab-mode-exercise');
    const rawInput = document.getElementById('raw-input') as HTMLTextAreaElement;
    const charCounter = document.getElementById('char-counter');
    const fileInput = document.getElementById('file-input') as HTMLInputElement;

    // Actualizador de contador de caracteres
    rawInput?.addEventListener('input', () => {
      if (charCounter) charCounter.textContent = `${rawInput.value.length} caracteres`;
    });

    // Selector de Tipo
    tabFood?.addEventListener('click', () => {
      currentType = 'food';
      tabFood.className = 'py-2.5 text-xs font-bold rounded-xl transition-all bg-[var(--brand)] text-white shadow-sm flex items-center justify-center gap-2';
      tabExercise!.className = 'py-2.5 text-xs font-semibold text-[var(--text-secondary)] hover:text-white rounded-xl transition-all flex items-center justify-center gap-2';
    });

    tabExercise?.addEventListener('click', () => {
      currentType = 'exercise';
      tabExercise.className = 'py-2.5 text-xs font-bold rounded-xl transition-all bg-[var(--brand)] text-white shadow-sm flex items-center justify-center gap-2';
      tabFood!.className = 'py-2.5 text-xs font-semibold text-[var(--text-secondary)] hover:text-white rounded-xl transition-all flex items-center justify-center gap-2';
    });

    // Carga de Plantillas
    document.getElementById('btn-sample-csv')?.addEventListener('click', () => {
      if (rawInput) {
        rawInput.value = currentType === 'food' ? SAMPLE_FOOD_CSV : SAMPLE_EXERCISE_CSV;
        rawInput.dispatchEvent(new Event('input'));
      }
    });

    document.getElementById('btn-sample-json')?.addEventListener('click', () => {
      if (rawInput) {
        rawInput.value = currentType === 'food' ? SAMPLE_FOOD_JSON : SAMPLE_EXERCISE_JSON;
        rawInput.dispatchEvent(new Event('input'));
      }
    });

    // Carga por Drag & Drop / File Input
    fileInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        const content = event.target?.result as string;
        if (rawInput) {
          rawInput.value = content;
          rawInput.dispatchEvent(new Event('input'));
          showToast({ message: `Archivo cargado: ${file.name}`, type: 'info' });
        }
      };
      reader.readAsText(file);
    });

    // Botón Limpiar
    document.getElementById('btn-clear-input')?.addEventListener('click', () => {
      if (rawInput) {
        rawInput.value = '';
        rawInput.dispatchEvent(new Event('input'));
      }
      currentStagingItems = [];
      renderStaging();
    });

    // Pre-flight Validation
    document.getElementById('btn-parse-staging')?.addEventListener('click', () => {
      const text = rawInput?.value || '';
      if (!text.trim()) {
        showToast({ message: 'Introduce contenido CSV o JSON para validar', type: 'error' });
        return;
      }

      try {
        if (currentType === 'food') {
          const result = parseFoodsSource(text);
          currentStagingItems = result.items;
          showToast({
            message: `Pre-flight completado: ${result.validCount} válidos, ${result.invalidCount} errores`,
            type: result.invalidCount > 0 ? 'warning' : 'success',
          });
        } else {
          const result = parseExercisesSource(text);
          currentStagingItems = result.items;
          showToast({
            message: `Pre-flight completado: ${result.validCount} válidos, ${result.invalidCount} errores`,
            type: result.invalidCount > 0 ? 'warning' : 'success',
          });
        }
        renderStaging();
      } catch (err) {
        showToast({ message: `Error de parseo: ${(err as Error).message}`, type: 'error' });
      }
    });

    // Filtros de Staging
    document.getElementById('filter-all')?.addEventListener('click', () => {
      currentFilter = 'all';
      updateFilterButtons();
      renderStaging();
    });

    document.getElementById('filter-valid')?.addEventListener('click', () => {
      currentFilter = 'valid';
      updateFilterButtons();
      renderStaging();
    });

    document.getElementById('filter-invalid')?.addEventListener('click', () => {
      currentFilter = 'invalid';
      updateFilterButtons();
      renderStaging();
    });

    // Búsqueda en Staging
    document.getElementById('staging-search')?.addEventListener('input', () => {
      renderStaging();
    });

    // Switch Tabla / Cards
    document.getElementById('view-table-btn')?.addEventListener('click', () => {
      currentView = 'table';
      document.getElementById('staging-table')?.classList.remove('hidden');
      document.getElementById('staging-cards')?.classList.add('hidden');
      document.getElementById('view-table-btn')!.className = 'p-1.5 rounded-lg bg-[var(--surface-4)] text-[var(--text-primary)]';
      document.getElementById('view-cards-btn')!.className = 'p-1.5 rounded-lg text-[var(--text-tertiary)] hover:text-white';
      renderStaging();
    });

    document.getElementById('view-cards-btn')?.addEventListener('click', () => {
      currentView = 'cards';
      document.getElementById('staging-table')?.classList.add('hidden');
      document.getElementById('staging-cards')?.classList.remove('hidden');
      document.getElementById('view-cards-btn')!.className = 'p-1.5 rounded-lg bg-[var(--surface-4)] text-[var(--text-primary)]';
      document.getElementById('view-table-btn')!.className = 'p-1.5 rounded-lg text-[var(--text-tertiary)] hover:text-white';
      renderStaging();
    });

    // Despliegue de Lote
    document.getElementById('btn-deploy-batch')?.addEventListener('click', async () => {
      if (currentStagingItems.length === 0) return;

      const validItems = currentStagingItems.filter((i) => i.isValid).map((i) => i.data);
      if (validItems.length === 0) {
        showToast({ message: 'No hay elementos válidos para desplegar.', type: 'error' });
        return;
      }

      const confirmed = await showConfirm({
        title: '¿Aprobar y desplegar lote a producción?',
        message: `Se sincronizarán ${validItems.length} elementos en ${currentType === 'food' ? 'foods_library' : 'exercises_library'}.`,
        confirmText: 'Desplegar Lote',
        variant: 'info',
      });

      if (!confirmed) return;

      try {
        const force = (document.getElementById('chk-update-duplicates') as HTMLInputElement)?.checked;
        let report;
        if (currentType === 'food') {
          report = await upsertFoodsLibrary(validItems, { force });
        } else {
          report = await upsertExercisesLibrary(validItems, { force });
        }

        showToast({
          message: `Despliegue exitoso: ${report.created} creados, ${report.updated} actualizados, ${report.skipped} omitidos`,
          type: 'success',
        });

        currentStagingItems = [];
        if (rawInput) {
          rawInput.value = '';
          rawInput.dispatchEvent(new Event('input'));
        }
        renderStaging();
        loadLiveCounts();
      } catch (e) {
        showToast({ message: `Error al desplegar: ${(e as Error).message}`, type: 'error' });
      }
    });

    // Sincronización Global de Canónicos
    document.getElementById('btn-sync-canonical-all')?.addEventListener('click', async () => {
      const confirmed = await showConfirm({
        title: '¿Sincronizar todos los catálogos canónicos?',
        message: 'Se sincronizarán más de 80 alimentos y 70 ejercicios canónicos con validación Atwater y SHA-256 en Firestore.',
        confirmText: 'Sincronizar Todo',
        variant: 'info',
      });

      if (!confirmed) return;

      try {
        showToast({ message: 'Iniciando sincronización idempotente...', type: 'info' });
        const res = await syncAllLibraries();
        showToast({
          message: `Sincronización completada en ${res.durationMs}ms (Alimentos: +${res.foodsReport.created} / ~${res.foodsReport.updated}; Ejercicios: +${res.exercisesReport.created} / ~${res.exercisesReport.updated})`,
          type: 'success',
        });
        loadLiveCounts();
      } catch (e) {
        showToast({ message: `Error en la sincronización: ${(e as Error).message}`, type: 'error' });
      }
    });
  }

  function updateFilterButtons(): void {
    const fAll = document.getElementById('filter-all')!;
    const fValid = document.getElementById('filter-valid')!;
    const fInvalid = document.getElementById('filter-invalid')!;

    fAll.className = currentFilter === 'all'
      ? 'px-2.5 py-1 text-xs font-bold rounded-lg bg-[var(--surface-4)] text-[var(--text-primary)] transition'
      : 'px-2.5 py-1 text-xs font-semibold text-[var(--text-secondary)] hover:bg-[var(--surface-4)] rounded-lg transition';

    fValid.className = currentFilter === 'valid'
      ? 'px-2.5 py-1 text-xs font-bold rounded-lg bg-emerald-500/20 text-emerald-300 transition'
      : 'px-2.5 py-1 text-xs font-semibold text-emerald-400 hover:bg-[var(--surface-4)] rounded-lg transition';

    fInvalid.className = currentFilter === 'invalid'
      ? 'px-2.5 py-1 text-xs font-bold rounded-lg bg-red-500/20 text-red-300 transition'
      : 'px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-[var(--surface-4)] rounded-lg transition';
  }

  function renderStaging(): void {
    const tbody = document.getElementById('staging-table-body');
    const cardsContainer = document.getElementById('staging-cards');
    const deployPanel = document.getElementById('staging-deploy-panel');
    const stagingMetricCount = document.getElementById('metric-staging-count');
    const stagingMetricStatus = document.getElementById('metric-staging-status');
    const searchVal = ((document.getElementById('staging-search') as HTMLInputElement)?.value || '').toLowerCase().trim();

    const validCount = currentStagingItems.filter((i) => i.isValid).length;
    const invalidCount = currentStagingItems.filter((i) => !i.isValid).length;

    // Actualizar contadores
    document.getElementById('count-all')!.textContent = String(currentStagingItems.length);
    document.getElementById('count-valid')!.textContent = String(validCount);
    document.getElementById('count-invalid')!.textContent = String(invalidCount);
    if (stagingMetricCount) stagingMetricCount.textContent = String(currentStagingItems.length);
    if (stagingMetricStatus) {
      stagingMetricStatus.textContent = invalidCount > 0 ? `${invalidCount} errores detectados` : validCount > 0 ? 'Listo para producción' : 'Listo para validar';
    }

    if (!tbody || !cardsContainer) return;

    if (currentStagingItems.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="4" class="p-10 text-center text-[var(--text-tertiary)] space-y-2">
            <div class="text-3xl">🌱</div>
            <p class="font-medium text-sm text-[var(--text-secondary)]">Staging Area Vacía</p>
            <p class="text-xs max-w-sm mx-auto">Carga un archivo CSV o JSON en el panel izquierdo y pulsa "Pre-flight & Validar" para comenzar el análisis.</p>
          </td>
        </tr>
      `;
      cardsContainer.innerHTML = '';
      deployPanel?.classList.add('hidden');
      return;
    }

    deployPanel?.classList.remove('hidden');

    let filtered = currentStagingItems.filter((item) => {
      if (currentFilter === 'valid' && !item.isValid) return false;
      if (currentFilter === 'invalid' && item.isValid) return false;
      if (searchVal) {
        const name = (item.data.translations?.es || item.id || '').toLowerCase();
        const cat = (item.data.category || '').toLowerCase();
        return name.includes(searchVal) || cat.includes(searchVal) || item.id.toLowerCase().includes(searchVal);
      }
      return true;
    });

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="4" class="p-8 text-center text-[var(--text-tertiary)]">
            No se encontraron elementos con los filtros aplicados.
          </td>
        </tr>
      `;
      cardsContainer.innerHTML = '<p class="text-xs text-[var(--text-tertiary)] col-span-2 text-center py-6">No se encontraron elementos.</p>';
      return;
    }

    // Render Tabla
    tbody.innerHTML = filtered
      .map((item) => {
        const statusBadge = item.isValid
          ? '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 font-bold text-[10px] border border-emerald-500/30">🟢 Válido</span>'
          : `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-red-500/15 text-red-400 font-bold text-[10px] border border-red-500/30" title="${item.issues.join('; ')}">🔴 Error</span>`;

        const name = item.data.translations?.es || item.id;
        const details =
          currentType === 'food'
            ? `${item.data.category} · ${item.data.calories100g} kcal/100g · P:${item.data.protein100g} C:${item.data.carbs100g} G:${item.data.fat100g}`
            : `${item.data.category} · ${(item.data.muscleGroups || []).join(', ')} · ${item.data.difficulty || 'beginner'}`;

        const issuesHtml = item.issues.length > 0
          ? `<div class="mt-1 text-[10px] text-red-400">${item.issues.join('<br/>')}</div>`
          : '';

        return `
          <tr class="hover:bg-[var(--surface-3)]/60 transition group">
            <td class="p-3.5 align-top">${statusBadge}</td>
            <td class="p-3.5 align-top">
              <div class="font-bold text-xs text-[var(--text-primary)]">${name}</div>
              <div class="text-[10px] font-mono text-[var(--text-tertiary)]">${item.id}</div>
              ${issuesHtml}
            </td>
            <td class="p-3.5 align-top text-[var(--text-secondary)]">${details}</td>
            <td class="p-3.5 align-top font-mono text-[10px] text-blue-400 group-hover:text-blue-300 select-all">${item.hash}</td>
          </tr>
        `;
      })
      .join('');

    // Render Cards
    cardsContainer.innerHTML = filtered
      .map((item) => {
        const statusBadge = item.isValid
          ? '<span class="px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 font-bold text-[10px]">🟢 Válido</span>'
          : '<span class="px-2 py-0.5 rounded-full bg-red-500/15 text-red-400 font-bold text-[10px]">🔴 Error</span>';

        const name = item.data.translations?.es || item.id;

        return `
          <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-4 space-y-2 hover:border-[var(--brand)] transition">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-[var(--text-primary)] truncate">${name}</span>
              ${statusBadge}
            </div>
            <div class="text-[11px] text-[var(--text-secondary)]">
              ${currentType === 'food' ? `${item.data.calories100g} kcal · ${item.data.category}` : `${(item.data.muscleGroups || []).join(', ')}`}
            </div>
            <div class="text-[10px] font-mono text-blue-400 truncate">Hash: ${item.hash}</div>
          </div>
        `;
      })
      .join('');
  }
</script>

<style>
  @keyframes spinSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spinSlow 12s linear infinite;
  }
</style>
