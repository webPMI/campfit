---
import AdminLayout from "@/layouts/AdminLayout.astro";
import PageTransition from "@/components/PageTransition.astro";
---

<AdminLayout>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-6 space-y-6">
    <PageTransition animation="fade-up" stagger>
      
      <!-- Top Welcome & System Pulse Banner -->
      <div class="rounded-3xl border border-[var(--border-subtle)] bg-gradient-to-r from-[var(--surface-1)] via-[var(--surface-2)] to-[var(--surface-1)] p-6 shadow-xl relative overflow-hidden">
        <div class="absolute -right-10 -top-10 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30">
                Centro de Mando
              </span>
              <span id="live-indicator" class="flex items-center gap-1 text-[11px] text-emerald-400 font-medium">
                <span class="h-2 w-2 rounded-full bg-emerald-500 animate-ping"></span>
                En vivo
              </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)] tracking-tight mt-1">
              Panel Administrativo CampFit
            </h1>
            <p class="text-xs sm:text-sm text-[var(--text-tertiary)] mt-1 max-w-xl">
              Control centralizado de atletas, entrenadores, catálogos multimedia y auditoría del sistema.
            </p>
          </div>

          <div class="flex items-center flex-wrap gap-2">
            <a
              href="/admin/users"
              class="px-4 py-2 rounded-xl bg-[var(--brand)] text-[var(--text-on-brand)] font-bold text-xs shadow-lg shadow-[var(--shadow-glow-sm)] hover:opacity-90 transition-all flex items-center gap-1.5"
            >
              <span>➕</span>
              <span>Gestionar Usuarios</span>
            </a>
            <a
              href="/admin/logs"
              class="px-3.5 py-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] text-[var(--text-primary)] font-semibold text-xs hover:bg-[var(--surface-3)] transition-all flex items-center gap-1.5"
            >
              <span>📜</span>
              <span>Auditoría</span>
            </a>
            <div id="last-update" class="hidden sm:block text-[11px] text-[var(--text-tertiary)] px-3 py-2 rounded-xl bg-[var(--surface-3)] font-mono">
              --:--
            </div>
          </div>
        </div>
      </div>

      <!-- Key Performance Metrics Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Metric 1: Total Users -->
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] p-4 sm:p-5 backdrop-blur-md relative group hover:border-[var(--brand)] transition-all shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-[var(--text-tertiary)]">Total Registros</span>
            <div class="h-8 w-8 rounded-xl bg-[var(--brand-dim)] flex items-center justify-center text-sm text-[var(--brand)]">
              👥
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span id="stat-total-users" class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)]">-</span>
            <span class="text-[10px] text-emerald-400 font-bold">Cuentas activas</span>
          </div>
          <div class="mt-3 pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11px] text-[var(--text-tertiary)]">
            <span>Atletas: <strong id="stat-sub-clients" class="text-[var(--text-primary)]">-</strong></span>
            <span>Coaches: <strong id="stat-sub-trainers" class="text-[var(--text-primary)]">-</strong></span>
          </div>
        </div>

        <!-- Metric 2: Clientes Activos -->
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] p-4 sm:p-5 backdrop-blur-md relative group hover:border-cyan-500/50 transition-all shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-[var(--text-tertiary)]">Atletas / Alumnos</span>
            <div class="h-8 w-8 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center text-sm font-bold">
              🏃
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span id="stat-total-clients" class="text-2xl sm:text-3xl font-extrabold text-cyan-400">-</span>
            <span class="text-[10px] text-[var(--text-tertiary)]">En seguimiento</span>
          </div>
          <div class="mt-3 pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11px] text-[var(--text-tertiary)]">
            <a href="/admin/users?role=client" class="text-cyan-400 hover:underline font-semibold flex items-center gap-1">
              Ver atletas →
            </a>
          </div>
        </div>

        <!-- Metric 3: Entrenadores -->
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] p-4 sm:p-5 backdrop-blur-md relative group hover:border-amber-500/50 transition-all shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-[var(--text-tertiary)]">Entrenadores (Staff)</span>
            <div class="h-8 w-8 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-sm font-bold">
              🏋️
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span id="stat-total-trainers" class="text-2xl sm:text-3xl font-extrabold text-amber-400">-</span>
            <span class="text-[10px] text-[var(--text-tertiary)]">Coaches asignados</span>
          </div>
          <div class="mt-3 pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11px] text-[var(--text-tertiary)]">
            <a href="/admin/users?role=trainer" class="text-amber-400 hover:underline font-semibold flex items-center gap-1">
              Ver entrenadores →
            </a>
          </div>
        </div>

        <!-- Metric 4: Alertas & Estado -->
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] p-4 sm:p-5 backdrop-blur-md relative group hover:border-rose-500/50 transition-all shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-[var(--text-tertiary)]">Estado & Alertas</span>
            <div class="h-8 w-8 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center text-sm font-bold">
              🚨
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span id="stat-total-alerts" class="text-2xl sm:text-3xl font-extrabold text-rose-400">0</span>
            <span class="text-[10px] text-[var(--text-tertiary)]">Incidencias</span>
          </div>
          <div class="mt-3 pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11px] text-[var(--text-tertiary)]">
            <span>Bloqueados: <strong id="stat-total-blocked" class="text-rose-400">0</strong></span>
            <span class="text-emerald-400 font-bold">R2 Conectado ☁️</span>
          </div>
        </div>
      </div>

      <!-- Quick Action Command Matrix -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--text-tertiary)]">
            Accesos Rápidos & Gestión
          </h2>
          <span class="text-xs text-[var(--text-tertiary)]">Módulos Administrativos</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <!-- 1. Gestor de Usuarios -->
          <a
            href="/admin/users"
            class="p-4 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] hover:bg-[var(--surface-2)] hover:border-[var(--brand)] transition-all flex items-start gap-3.5 group shadow-sm"
          >
            <div class="h-10 w-10 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
              👥
            </div>
            <div>
              <h3 class="text-xs font-bold text-[var(--text-primary)] group-hover:text-[var(--brand)] transition-colors">
                Usuarios & Clientes
              </h3>
              <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5 leading-relaxed">
                Asignación de entrenadores, estados de membresía y perfiles médicos.
              </p>
            </div>
          </a>

          <!-- 2. Catálogo de Ejercicios -->
          <a
            href="/admin/exercises"
            class="p-4 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] hover:bg-[var(--surface-2)] hover:border-emerald-500/50 transition-all flex items-start gap-3.5 group shadow-sm"
          >
            <div class="h-10 w-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
              🎯
            </div>
            <div>
              <h3 class="text-xs font-bold text-[var(--text-primary)] group-hover:text-emerald-400 transition-colors">
                Biblioteca de Ejercicios
              </h3>
              <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5 leading-relaxed">
                Creación de ejercicios globales, grupos musculares y vídeos técnicos R2.
              </p>
            </div>
          </a>

          <!-- 3. Base Nutricional -->
          <a
            href="/admin/foods"
            class="p-4 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] hover:bg-[var(--surface-2)] hover:border-amber-500/50 transition-all flex items-start gap-3.5 group shadow-sm"
          >
            <div class="h-10 w-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
              🥗
            </div>
            <div>
              <h3 class="text-xs font-bold text-[var(--text-primary)] group-hover:text-amber-400 transition-colors">
                Catálogo de Nutrición
              </h3>
              <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5 leading-relaxed">
                Base de datos de alimentos, macronutrientes, alérgenos y equivalencias.
              </p>
            </div>
          </a>

          <!-- 4. Visor de Logs -->
          <a
            href="/admin/logs"
            class="p-4 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] hover:bg-[var(--surface-2)] hover:border-purple-500/50 transition-all flex items-start gap-3.5 group shadow-sm"
          >
            <div class="h-10 w-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
              📜
            </div>
            <div>
              <h3 class="text-xs font-bold text-[var(--text-primary)] group-hover:text-purple-400 transition-colors">
                Logs del Sistema
              </h3>
              <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5 leading-relaxed">
                Auditoría en tiempo real de llamadas API, errores e interacciones de IA.
              </p>
            </div>
          </a>

          <!-- 5. Gestor de Semillas & Ingesta -->
          <a
            href="/admin/seeds"
            class="p-4 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] hover:bg-[var(--surface-2)] hover:border-emerald-500/50 transition-all flex items-start gap-3.5 group shadow-sm"
          >
            <div class="h-10 w-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
              🌱
            </div>
            <div>
              <h3 class="text-xs font-bold text-[var(--text-primary)] group-hover:text-emerald-400 transition-colors">
                Gestor de Semillas (Seeds)
              </h3>
              <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5 leading-relaxed">
                Ingesta masiva CSV/JSON, validación pre-flight Atwater y despliegue idempotente.
              </p>
            </div>
          </a>

          <!-- 6. DevTools & Panel -->
          <a
            href="/admin/devtools"
            class="p-4 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] hover:bg-[var(--surface-2)] hover:border-cyan-500/50 transition-all flex items-start gap-3.5 group shadow-sm"
          >
            <div class="h-10 w-10 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
              🛠️
            </div>
            <div>
              <h3 class="text-xs font-bold text-[var(--text-primary)] group-hover:text-cyan-400 transition-colors">
                DevTools & Diagnósticos
              </h3>
              <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5 leading-relaxed">
                Inyección de datos de prueba, diagnósticos de rendimiento y utilidades.
              </p>
            </div>
          </a>

          <!-- 6. Configuración Global -->
          <a
            href="/admin/settings"
            class="p-4 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] hover:bg-[var(--surface-2)] hover:border-zinc-400 transition-all flex items-start gap-3.5 group shadow-sm"
          >
            <div class="h-10 w-10 rounded-xl bg-zinc-500/10 text-zinc-300 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
              ⚙️
            </div>
            <div>
              <h3 class="text-xs font-bold text-[var(--text-primary)] group-hover:text-zinc-200 transition-colors">
                Configuración General
              </h3>
              <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5 leading-relaxed">
                Preferencias de la cuenta administradora, interfaz y seguridad.
              </p>
            </div>
          </a>
        </div>
      </div>

      <!-- Realtime Activity Radar & Recent Users -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-2">
        <!-- Recent Signups & Registrations -->
        <div class="rounded-3xl border border-[var(--border-subtle)] bg-[var(--surface-1)] p-5 space-y-4 shadow-sm">
          <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-3">
            <div class="flex items-center gap-2">
              <span class="text-base">✨</span>
              <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--text-primary)]">
                Últimos Registros
              </h2>
            </div>
            <a href="/admin/users" class="text-xs text-[var(--brand)] font-semibold hover:underline">
              Ver todos →
            </a>
          </div>

          <div id="recent-users" class="space-y-2.5">
            <div class="p-6 text-center text-xs text-[var(--text-tertiary)]">
              Cargando usuarios...
            </div>
          </div>
        </div>

        <!-- System Alerts & Audit Events -->
        <div class="rounded-3xl border border-[var(--border-subtle)] bg-[var(--surface-1)] p-5 space-y-4 shadow-sm">
          <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-3">
            <div class="flex items-center gap-2">
              <span class="text-base">🚨</span>
              <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--text-primary)]">
                Alertas de Salud y Cuentas
              </h2>
            </div>
            <a href="/admin/logs" class="text-xs text-rose-400 font-semibold hover:underline">
              Logs detallados →
            </a>
          </div>

          <div id="recent-alerts" class="space-y-2.5">
            <div class="p-6 text-center text-xs text-[var(--text-tertiary)]">
              Comprobando incidencias...
            </div>
          </div>
        </div>
      </div>

    </PageTransition>
  </div>

  <script>
    import { requireAdmin } from "@/lib/shared/authGuard";
    import { subscribeToUsers, renderUserCard } from "@/lib/admin/adminUtils";
    import { ICONS, renderEmptyState } from "@/lib/shared/ui";

    let unsubUsers: (() => void) | null = null;

    requireAdmin(() => initDashboard());

    window.addEventListener("beforeunload", () => unsubUsers?.());

    function initDashboard(): void {
      const statTotalUsers = document.getElementById("stat-total-users");
      const statTotalTrainers = document.getElementById("stat-total-trainers");
      const statTotalClients = document.getElementById("stat-total-clients");
      const statSubClients = document.getElementById("stat-sub-clients");
      const statSubTrainers = document.getElementById("stat-sub-trainers");
      const statTotalBlocked = document.getElementById("stat-total-blocked");
      const statTotalAlerts = document.getElementById("stat-total-alerts");
      const recentContainer = document.getElementById("recent-users");
      const alertsContainer = document.getElementById("recent-alerts");
      const lastUpdateEl = document.getElementById("last-update");

      function updateTimestamp(): void {
        if (!lastUpdateEl) return;
        const now = new Date();
        lastUpdateEl.textContent = `Actualizado: ${now.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}`;
      }

      unsubUsers = subscribeToUsers((users) => {
        const totalUsers = users.length;
        const totalTrainers = users.filter((u) => u.role === "trainer").length;
        const totalClients = users.filter((u) => u.role === "client").length;
        const totalBlocked = users.filter((u) => u.isBlocked).length;
        const usersWithAlerts = users.filter((u) => u.hasActiveAlert);

        if (statTotalUsers) statTotalUsers.textContent = String(totalUsers);
        if (statTotalTrainers) statTotalTrainers.textContent = String(totalTrainers);
        if (statTotalClients) statTotalClients.textContent = String(totalClients);
        if (statSubClients) statSubClients.textContent = String(totalClients);
        if (statSubTrainers) statSubTrainers.textContent = String(totalTrainers);
        if (statTotalBlocked) statTotalBlocked.textContent = String(totalBlocked);
        if (statTotalAlerts) statTotalAlerts.textContent = String(usersWithAlerts.length);

        updateTimestamp();

        if (alertsContainer) {
          if (usersWithAlerts.length === 0) {
            alertsContainer.innerHTML = `
              <div class="rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-4 flex items-center gap-3">
                <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-400 text-base font-bold flex-shrink-0">
                  ✓
                </div>
                <div>
                  <p class="text-xs font-bold text-[var(--text-primary)]">Sin incidencias activas</p>
                  <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5">Todas las cuentas y servicios se encuentran en estado saludable.</p>
                </div>
              </div>`;
          } else {
            alertsContainer.innerHTML = usersWithAlerts
              .slice(0, 5)
              .map((user) => `
              <div class="rounded-2xl border border-rose-500/30 bg-rose-500/10 p-3.5 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-rose-500/20 text-rose-300 text-sm flex-shrink-0">
                    ⚠️
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs font-bold text-[var(--text-primary)] truncate">${user.name || user.email}</p>
                    <p class="text-[10px] text-rose-300">Alerta médica o de cuenta pendiente</p>
                  </div>
                </div>
                <a href="/admin/users" class="px-2.5 py-1 rounded-lg bg-rose-500/20 text-rose-200 text-[10px] font-bold hover:bg-rose-500/30 transition-all flex-shrink-0">
                  Inspeccionar
                </a>
              </div>
            `)
              .join("");
          }
        }

        if (recentContainer) {
          const recentUsers = users.slice(0, 5);
          if (recentUsers.length === 0) {
            recentContainer.innerHTML = renderEmptyState(ICONS.users, "Sin usuarios registrados");
          } else {
            recentContainer.innerHTML = recentUsers.map((user) => renderUserCard(user)).join("");
          }
        }
      });
    }
  </script>
</AdminLayout>

