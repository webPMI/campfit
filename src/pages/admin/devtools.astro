---
import AdminLayout from '@/layouts/AdminLayout.astro';
import PageTransition from '@/components/PageTransition.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<AdminLayout>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <PageTransition animation="fade-up" stagger>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2"><span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-500 border border-amber-500/20">🛠️ Admin DevTools</span><span class="text-xs text-[var(--text-disabled)]">v1.0 Seed Manager</span></div>
          <h1 class="text-2xl font-bold mt-2 text-[var(--text-primary)]">{t('admin.diets')} Seed</h1>
          <p class="text-sm text-[var(--text-tertiary)] mt-1">Despliega bibliotecas preconfiguradas de ejercicios, comidas, dietas y rutinas para uso rápido por entrenadores.</p>
        </div>
        <div class="flex items-center gap-3 flex-wrap">
          <a
            href="/admin/seeds"
            class="px-4 py-2.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-sm font-semibold hover:bg-emerald-500/20 transition-all flex items-center gap-2"
          >
            <span>🌱</span>
            <span>Studio de Semillas (CSV/JSON)</span>
          </a>
          <button id="btn-sync-libraries" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-sm font-semibold hover:opacity-90 transition-all shadow-lg shadow-blue-500/20 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
            Sincronizar Bibliotecas (Upsert)
          </button>
          <button id="btn-purge-all" class="px-4 py-2.5 rounded-xl border border-red-500/30 bg-red-500/10 text-red-400 text-sm font-semibold hover:bg-red-500/20 transition-all flex items-center gap-2"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/></svg>Purgar Plantillas</button>
          <button id="btn-seed-all" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white text-sm font-semibold hover:opacity-90 transition-all shadow-lg shadow-emerald-500/20 flex items-center gap-2"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/></svg>Desplegar Todo</button>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5 backdrop-blur-md">
          <div class="flex items-center justify-between"><div class="h-10 w-10 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center font-bold text-lg">🏋️</div><button id="btn-seed-exercises" class="text-xs px-2.5 py-1 rounded-lg bg-[var(--surface-3)] hover:bg-[var(--surface-4)] text-[var(--text-secondary)] font-medium transition">Desplegar</button></div>
          <p id="cnt-exercises" class="text-3xl font-extrabold mt-3 text-[var(--text-primary)]">-</p><p class="text-xs text-[var(--text-tertiary)] mt-1 font-medium">Ejercicios</p>
        </div>
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5 backdrop-blur-md">
          <div class="flex items-center justify-between"><div class="h-10 w-10 rounded-xl bg-orange-500/10 text-orange-400 flex items-center justify-center font-bold text-lg">🥗</div><button id="btn-seed-meals" class="text-xs px-2.5 py-1 rounded-lg bg-[var(--surface-3)] hover:bg-[var(--surface-4)] text-[var(--text-secondary)] font-medium transition">Desplegar</button></div>
          <p id="cnt-meals" class="text-3xl font-extrabold mt-3 text-[var(--text-primary)]">-</p><p class="text-xs text-[var(--text-tertiary)] mt-1 font-medium">Comidas</p>
        </div>
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5 backdrop-blur-md">
          <div class="flex items-center justify-between"><div class="h-10 w-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-lg">🍽️</div><button id="btn-seed-diets" class="text-xs px-2.5 py-1 rounded-lg bg-[var(--surface-3)] hover:bg-[var(--surface-4)] text-[var(--text-secondary)] font-medium transition">Desplegar</button></div>
          <p id="cnt-diets" class="text-3xl font-extrabold mt-3 text-[var(--text-primary)]">-</p><p class="text-xs text-[var(--text-tertiary)] mt-1 font-medium">{t("admin.diets")}</p>
        </div>
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5 backdrop-blur-md">
          <div class="flex items-center justify-between"><div class="h-10 w-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-lg">📋</div><button id="btn-seed-workouts" class="text-xs px-2.5 py-1 rounded-lg bg-[var(--surface-3)] hover:bg-[var(--surface-4)] text-[var(--text-secondary)] font-medium transition">Desplegar</button></div>
          <p id="cnt-workouts" class="text-3xl font-extrabold mt-3 text-[var(--text-primary)]">-</p><p class="text-xs text-[var(--text-tertiary)] mt-1 font-medium">{t("admin.workouts")}</p>
        </div>
      </div>

      <div class="mt-8 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6"><div class="flex items-center justify-between mb-3"><h3 class="text-sm font-bold text-[var(--text-primary)] flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>Consola</h3><button id="btn-clear-log" class="text-xs text-[var(--text-tertiary)] hover:text-[var(--text-secondary)]">Limpiar Log</button></div><div id="console-log" class="h-40 rounded-xl bg-black/40 border border-white/5 p-4 font-mono text-xs text-emerald-400 overflow-y-auto"><p class="text-gray-500">// Consola lista.</p></div></div>
    </PageTransition>
  </div>
</AdminLayout>

<script>
  import { requireAdmin } from '@/lib/shared/authGuard';
  import { showConfirm } from '@/lib/shared/ui';
  import { seedExerciseTemplates, seedMealTemplates, seedDietTemplates, seedWorkoutTemplates, seedAllTemplates, purgeTemplates, getTemplateStats } from '@/lib/devtools/seedService';
  import { syncAllLibraries } from '@/lib/devtools/seedManager';

  requireAdmin(() => { init(); });

  type LogType = 'info' | 'success' | 'warn' | 'error';

  function log(m: string, t: LogType): void {
    const el = document.getElementById('console-log');
    if (!el) return;
    const c: Record<LogType, string> = {
      info: 'text-blue-400',
      success: 'text-emerald-400 font-bold',
      warn: 'text-amber-400',
      error: 'text-red-400 font-bold',
    };
    const l = document.createElement('p');
    l.className = c[t] || 'text-gray-300';
    l.textContent = `[${new Date().toLocaleTimeString()}] ${m}`;
    el.appendChild(l);
    el.scrollTop = el.scrollHeight;
  }

  async function rs(): Promise<void> {
    try {
      const s = await getTemplateStats();
      const cntExercises = document.getElementById('cnt-exercises');
      const cntMeals = document.getElementById('cnt-meals');
      const cntDiets = document.getElementById('cnt-diets');
      const cntWorkouts = document.getElementById('cnt-workouts');
      if (cntExercises) cntExercises.textContent = String(s.exerciseTemplatesCount);
      if (cntMeals) cntMeals.textContent = String(s.mealTemplatesCount);
      if (cntDiets) cntDiets.textContent = String(s.dietTemplatesCount);
      if (cntWorkouts) cntWorkouts.textContent = String(s.workoutTemplatesCount);
    } catch (e) {
      log(`Error stats: ${(e as Error).message}`, 'error');
    }
  }

  function init(): void {
    rs();
    document.getElementById('btn-sync-libraries')?.addEventListener('click', async () => {
      try {
        log('🔄 Iniciando Sincronización Inteligente de Bibliotecas...', 'info');
        const res = await syncAllLibraries();
        log(`🥦 Alimentos: ${res.foodsReport.created} creados, ${res.foodsReport.updated} actualizados, ${res.foodsReport.skipped} omitidos`, 'success');
        log(`🏋️ Ejercicios: ${res.exercisesReport.created} creados, ${res.exercisesReport.updated} actualizados, ${res.exercisesReport.skipped} omitidos`, 'success');
        log(`✨ Sincronización completada en ${res.durationMs}ms`, 'success');
        rs();
      } catch (e) {
        log(`❌ Error en sincronización: ${(e as Error).message}`, 'error');
      }
    });
    document.getElementById('btn-seed-exercises')?.addEventListener('click', async () => {
      try {
        const c = await seedExerciseTemplates();
        log(`✅ ${c} ejercicios`, 'success');
        rs();
      } catch (e) {
        log(`❌ ${(e as Error).message}`, 'error');
      }
    });
    document.getElementById('btn-seed-meals')?.addEventListener('click', async () => {
      try {
        const c = await seedMealTemplates();
        log(`✅ ${c} comidas`, 'success');
        rs();
      } catch (e) {
        log(`❌ ${(e as Error).message}`, 'error');
      }
    });
    document.getElementById('btn-seed-diets')?.addEventListener('click', async () => {
      try {
        const c = await seedDietTemplates();
        log(`✅ ${c} dietas`, 'success');
        rs();
      } catch (e) {
        log(`❌ ${(e as Error).message}`, 'error');
      }
    });
    document.getElementById('btn-seed-workouts')?.addEventListener('click', async () => {
      try {
        const c = await seedWorkoutTemplates();
        log(`✅ ${c.created} rutinas creadas (${c.skipped} omitidas)`, 'success');
        rs();
      } catch (e) {
        log(`❌ ${(e as Error).message}`, 'error');
      }
    });
    document.getElementById('btn-seed-all')?.addEventListener('click', async () => {
      try {
        const r = await seedAllTemplates();
        log(`🎉 Total: ${r.totalCreated} creadas (${r.totalSkipped} omitidas)`, 'success');
        rs();
      } catch (e) {
        log(`❌ ${(e as Error).message}`, 'error');
      }
    });
    document.getElementById('btn-purge-all')?.addEventListener('click', async () => {
      const confirmed = await showConfirm({
        title: "¿Purgar Todas las Plantillas?",
        message: "Esta acción eliminará todas las plantillas de ejercicios, comidas, dietas y rutinas predefinidas. ¿Estás seguro?",
        confirmText: "Purgar Todo",
        variant: "danger",
      });
      if (!confirmed) return;
      try {
        const d = await purgeTemplates();
        log(`🧹 ${d} eliminados`, 'success');
        rs();
      } catch (e) {
        log(`❌ ${(e as Error).message}`, 'error');
      }
    });
    document.getElementById('btn-clear-log')?.addEventListener('click', () => {
      const el = document.getElementById('console-log');
      if (el) el.innerHTML = '<p class="text-gray-500">// Consola limpia.</p>';
    });
  }
</script>