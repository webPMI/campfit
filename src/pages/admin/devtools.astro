---
import AdminLayout from '@/layouts/AdminLayout.astro';
import PageTransition from '@/components/PageTransition.astro';
import ConfirmModal from '@/components/ConfirmModal.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<AdminLayout>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <PageTransition animation="fade-up" stagger>
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-500 border border-amber-500/20">
              🛠️ Admin DevTools
            </span>
            <span class="text-xs text-[var(--text-disabled)]">v1.0 Seed Manager</span>
          </div>
          <h1 class="text-2xl font-bold mt-2 text-[var(--text-primary)]">Gestión de Plantillas Semilla</h1>
          <p class="text-sm text-[var(--text-tertiary)] mt-1">
            Despliega bibliotecas preconfiguradas de ejercicios, comidas, dietas y rutinas para uso rápido por entrenadores.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <button
            id="btn-purge-all"
            class="px-4 py-2.5 rounded-xl border border-red-500/30 bg-red-500/10 text-red-400 text-sm font-semibold hover:bg-red-500/20 transition-all flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
            Purgar Plantillas
          </button>

          <button
            id="btn-seed-all"
            class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white text-sm font-semibold hover:opacity-90 transition-all shadow-lg shadow-emerald-500/20 flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
            </svg>
            Desplegar Todo
          </button>
        </div>
      </div>

      <!-- Live Counters Grid -->
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
        <!-- Ejercicios -->
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5 backdrop-blur-md">
          <div class="flex items-center justify-between">
            <div class="h-10 w-10 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center font-bold text-lg">
              🏋️
            </div>
            <button id="btn-seed-exercises" class="text-xs px-2.5 py-1 rounded-lg bg-[var(--surface-3)] hover:bg-[var(--surface-4)] text-[var(--text-secondary)] font-medium transition">
              Desplegar
            </button>
          </div>
          <p id="cnt-exercises" class="text-3xl font-extrabold mt-3 text-[var(--text-primary)]">-</p>
          <p class="text-xs text-[var(--text-tertiary)] mt-1 font-medium">Ejercicios Semilla</p>
        </div>

        <!-- Comidas -->
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5 backdrop-blur-md">
          <div class="flex items-center justify-between">
            <div class="h-10 w-10 rounded-xl bg-orange-500/10 text-orange-400 flex items-center justify-center font-bold text-lg">
              🥗
            </div>
            <button id="btn-seed-meals" class="text-xs px-2.5 py-1 rounded-lg bg-[var(--surface-3)] hover:bg-[var(--surface-4)] text-[var(--text-secondary)] font-medium transition">
              Desplegar
            </button>
          </div>
          <p id="cnt-meals" class="text-3xl font-extrabold mt-3 text-[var(--text-primary)]">-</p>
          <p class="text-xs text-[var(--text-tertiary)] mt-1 font-medium">Comidas Semilla</p>
        </div>

        <!-- Dietas -->
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5 backdrop-blur-md">
          <div class="flex items-center justify-between">
            <div class="h-10 w-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-lg">
              🍽️
            </div>
            <button id="btn-seed-diets" class="text-xs px-2.5 py-1 rounded-lg bg-[var(--surface-3)] hover:bg-[var(--surface-4)] text-[var(--text-secondary)] font-medium transition">
              Desplegar
            </button>
          </div>
          <p id="cnt-diets" class="text-3xl font-extrabold mt-3 text-[var(--text-primary)]">-</p>
          <p class="text-xs text-[var(--text-tertiary)] mt-1 font-medium">Dietas Semilla</p>
        </div>

        <!-- Rutinas -->
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5 backdrop-blur-md">
          <div class="flex items-center justify-between">
            <div class="h-10 w-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-lg">
              📋
            </div>
            <button id="btn-seed-workouts" class="text-xs px-2.5 py-1 rounded-lg bg-[var(--surface-3)] hover:bg-[var(--surface-4)] text-[var(--text-secondary)] font-medium transition">
              Desplegar
            </button>
          </div>
          <p id="cnt-workouts" class="text-3xl font-extrabold mt-3 text-[var(--text-primary)]">-</p>
          <p class="text-xs text-[var(--text-tertiary)] mt-1 font-medium">Rutinas Semilla</p>
        </div>
      </div>

      <!-- Presets Included Info -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6">
          <h3 class="text-base font-bold text-[var(--text-primary)] flex items-center gap-2">
            <span>🥗</span> Dietas Semilla Incluidas
          </h3>
          <ul class="mt-3 space-y-2 text-sm text-[var(--text-secondary)]">
            <li class="flex items-center justify-between p-2.5 rounded-xl bg-[var(--surface-3)]">
              <span>Dieta de Definición / Pérdida de Grasa</span>
              <span class="text-xs px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 font-semibold">2000 kcal</span>
            </li>
            <li class="flex items-center justify-between p-2.5 rounded-xl bg-[var(--surface-3)]">
              <span>Dieta de Volumen / Ganancia Muscular</span>
              <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-semibold">3000 kcal</span>
            </li>
            <li class="flex items-center justify-between p-2.5 rounded-xl bg-[var(--surface-3)]">
              <span>Dieta Vegetariana Fitness</span>
              <span class="text-xs px-2 py-0.5 rounded bg-teal-500/10 text-teal-400 font-semibold">2200 kcal</span>
            </li>
          </ul>
        </div>

        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6">
          <h3 class="text-base font-bold text-[var(--text-primary)] flex items-center gap-2">
            <span>📋</span> Rutinas Semilla Incluidas
          </h3>
          <ul class="mt-3 space-y-2 text-sm text-[var(--text-secondary)]">
            <li class="flex items-center justify-between p-2.5 rounded-xl bg-[var(--surface-3)]">
              <span>FullBody Principiante (3 Días)</span>
              <span class="text-xs px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 font-semibold">Principiante</span>
            </li>
            <li class="flex items-center justify-between p-2.5 rounded-xl bg-[var(--surface-3)]">
              <span>Torso - Pierna Hipertrofia (4 Días)</span>
              <span class="text-xs px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 font-semibold">Intermedio</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Execution Console Log -->
      <div class="mt-8 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-bold text-[var(--text-primary)] flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Consola de Operaciones Semilla
          </h3>
          <button id="btn-clear-log" class="text-xs text-[var(--text-tertiary)] hover:text-[var(--text-secondary)]">
            Limpiar Log
          </button>
        </div>
        <div id="console-log" class="h-40 rounded-xl bg-black/40 border border-white/5 p-4 font-mono text-xs text-emerald-400 overflow-y-auto space-y-1 backdrop-blur-inner">
          <p class="text-gray-500">// Consola lista. Selecciona una acción para desplegar o purgar plantillas.</p>
        </div>
      </div>
    </PageTransition>
  </div>

  <ConfirmModal
    id="purge-modal"
    title="¿Purgar todas las plantillas?"
    message="Se eliminarán permanentemente todas las plantillas marcadas como semilla en Firestore. Los datos reales de clientes no se verán afectados."
    confirmText="Sí, Purgar"
    cancelText="Cancelar"
    variant="danger"
  />
</AdminLayout>

<script>
  import { requireAdmin } from '@/lib/shared/authGuard';
  import { showToast } from '@/lib/shared/ui';
  import {
    seedExerciseTemplates,
    seedMealTemplates,
    seedDietTemplates,
    seedWorkoutTemplates,
    seedAllTemplates,
    purgeTemplates,
    getTemplateStats,
  } from '@/lib/devtools/seedService';

  requireAdmin(() => {
    initDevTools();
  });

  function logMessage(msg: string, type: 'info' | 'success' | 'warn' | 'error' = 'info'): void {
    const consoleEl = document.getElementById('console-log');
    if (!consoleEl) return;

    const time = new Date().toLocaleTimeString();
    const colors = {
      info: 'text-blue-400',
      success: 'text-emerald-400 font-bold',
      warn: 'text-amber-400',
      error: 'text-red-400 font-bold',
    };

    const line = document.createElement('p');
    line.className = colors[type] || 'text-gray-300';
    line.textContent = `[${time}] ${msg}`;
    consoleEl.appendChild(line);
    consoleEl.scrollTop = consoleEl.scrollHeight;
  }

  async function refreshStats(): Promise<void> {
    try {
      const stats = await getTemplateStats();
      const elEx = document.getElementById('cnt-exercises');
      const elMeal = document.getElementById('cnt-meals');
      const elDiet = document.getElementById('cnt-diets');
      const elWork = document.getElementById('cnt-workouts');

      if (elEx) elEx.textContent = String(stats.exerciseTemplatesCount);
      if (elMeal) elMeal.textContent = String(stats.mealTemplatesCount);
      if (elDiet) elDiet.textContent = String(stats.dietTemplatesCount);
      if (elWork) elWork.textContent = String(stats.workoutTemplatesCount);
    } catch (err) {
      logMessage(`Error al obtener estadísticas: ${(err as Error).message}`, 'error');
    }
  }

  function initDevTools(): void {
    refreshStats();

    // Individual Seeds
    document.getElementById('btn-seed-exercises')?.addEventListener('click', async () => {
      logMessage('Iniciando despliegue de ejercicios semilla...', 'info');
      try {
        const count = await seedExerciseTemplates();
        logMessage(`✅ Se desplegaron ${count} ejercicios semilla.`, 'success');
        showToast({ message: `${count} ejercicios desplegados`, type: 'success' });
        await refreshStats();
      } catch (err) {
        logMessage(`❌ Error: ${(err as Error).message}`, 'error');
      }
    });

    document.getElementById('btn-seed-meals')?.addEventListener('click', async () => {
      logMessage('Iniciando despliegue de comidas semilla...', 'info');
      try {
        const count = await seedMealTemplates();
        logMessage(`✅ Se desplegaron ${count} comidas semilla.`, 'success');
        showToast({ message: `${count} comidas desplegadas`, type: 'success' });
        await refreshStats();
      } catch (err) {
        logMessage(`❌ Error: ${(err as Error).message}`, 'error');
      }
    });

    document.getElementById('btn-seed-diets')?.addEventListener('click', async () => {
      logMessage('Iniciando despliegue de dietas semilla...', 'info');
      try {
        const count = await seedDietTemplates();
        logMessage(`✅ Se desplegaron ${count} dietas semilla.`, 'success');
        showToast({ message: `${count} dietas desplegadas`, type: 'success' });
        await refreshStats();
      } catch (err) {
        logMessage(`❌ Error: ${(err as Error).message}`, 'error');
      }
    });

    document.getElementById('btn-seed-workouts')?.addEventListener('click', async () => {
      logMessage('Iniciando despliegue de rutinas semilla...', 'info');
      try {
        const count = await seedWorkoutTemplates();
        logMessage(`✅ Se desplegaron ${count} rutinas semilla.`, 'success');
        showToast({ message: `${count} rutinas desplegadas`, type: 'success' });
        await refreshStats();
      } catch (err) {
        logMessage(`❌ Error: ${(err as Error).message}`, 'error');
      }
    });

    // Seed All
    document.getElementById('btn-seed-all')?.addEventListener('click', async () => {
      logMessage('🚀 Ejecutando Despliegue Completo de Plantillas Semilla...', 'warn');
      try {
        const result = await seedAllTemplates();
        logMessage(`🎉 ¡Despliegue completado! Total: ${result.total} plantillas.`, 'success');
        logMessage(`  - Ejercicios: ${result.exercises}`, 'info');
        logMessage(`  - Comidas: ${result.meals}`, 'info');
        logMessage(`  - Dietas: ${result.diets}`, 'info');
        logMessage(`  - Rutinas: ${result.workouts}`, 'info');
        showToast({ message: `¡Pack Semilla Completo desplegado (${result.total} elementos)!`, type: 'success' });
        await refreshStats();
      } catch (err) {
        logMessage(`❌ Error en despliegue completo: ${(err as Error).message}`, 'error');
      }
    });

    // Purge
    document.getElementById('btn-purge-all')?.addEventListener('click', async () => {
      if (!confirm('¿Seguro que deseas purgar todas las plantillas semilla? Esta acción no se puede deshacer.')) return;

      logMessage('🧹 Purgando plantillas semilla de Firestore...', 'warn');
      try {
        const deleted = await purgeTemplates();
        logMessage(`🧹 Se eliminaron ${deleted} plantillas semilla correctamente.`, 'success');
        showToast({ message: `${deleted} plantillas eliminadas`, type: 'info' });
        await refreshStats();
      } catch (err) {
        logMessage(`❌ Error al purgar plantillas: ${(err as Error).message}`, 'error');
      }
    });

    // Clear log
    document.getElementById('btn-clear-log')?.addEventListener('click', () => {
      const consoleEl = document.getElementById('console-log');
      if (consoleEl) consoleEl.innerHTML = '<p class="text-gray-500">// Consola limpia.</p>';
    });
  }
</script>
