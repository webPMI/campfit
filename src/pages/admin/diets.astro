---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<AdminLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold">{t('admin.diets')}</h1>
          <p class="mt-1 text-sm theme-text-tertiary">
            <span id="diet-count" class="text-orange-400 font-medium">0</span> {t('admin.diets.total')}
          </p>
        </div>
        <button id="btn-create-diet" class="rounded-xl theme-brand/10 border theme-border-focus/20 px-4 py-2 text-sm font-medium theme-text-brand hover:theme-brand/20 transition-all active:scale-95">
          <svg class="h-4 w-4 inline-block mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Nueva Dieta
        </button>
      </div>

      <!-- Diet Editor -->
      <div id="diet-editor" class="hidden mt-8"></div>

      <!-- Filter by client -->
      <div class="mt-6">
        <select id="client-filter" class="w-full rounded-xl border theme-border theme-surface-secondary px-4 py-2.5 text-sm theme-text-secondary backdrop-blur-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/10">
          <option value="">Filtrar por alumno</option>
        </select>
      </div>

      <!-- Diets List -->
      <div id="diets-container" class="mt-6 space-y-3">
        <div class="rounded-xl border theme-border theme-surface-secondary p-6 text-center backdrop-blur-sm">
          <div class="flex items-center justify-center gap-3">
            <svg class="h-5 w-5 animate-spin theme-text-brand" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
            </svg>
            <p class="text-sm theme-text-tertiary">{t('admin.loading')}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { requireAdmin } from '@/lib/shared/authGuard';
  import { db } from '@/lib/firebase';
  import { collection, onSnapshot, query, orderBy, doc, deleteDoc, updateDoc, addDoc, serverTimestamp } from 'firebase/firestore';
  import { subscribeToUsersByRole, renderEmptyState, escapeHtml, ICONS } from '@/lib/admin/adminUtils';
  import { showToast } from '@/lib/shared/ui';
  import { logger } from '@/lib/shared/logger';

  interface Meal {
    id: string;
    name: 'breakfast' | 'lunch' | 'snack' | 'dinner' | 'other';
    description: string;
    calories: number;
    protein: number;
    carbs: number;
    fat: number;
    order: number;
  }

  interface Diet {
    id: string;
    clientId: string;
    trainerId: string;
    name: string;
    type: 'normal' | 'advanced';
    somatotype?: 'ectomorph' | 'mesomorph' | 'endomorph';
    totalCalories: number;
    meals: Meal[];
  }

  interface Client {
    uid: string;
    name: string;
  }

  let unsubClients: (() => void) | null = null;
  let unsubDiets: (() => void) | null = null;
  let allClients: Client[] = [];
  let allDiets: Diet[] = [];

  const unsubscribeAuth = requireAdmin(() => {
    initDiets();
  });

  document.addEventListener('astro:before-swap', () => {
    unsubscribeAuth?.();
    unsubClients?.();
    unsubDiets?.();
  });

  const TYPE_LABELS: Record<string, string> = {
    normal: 'Normal',
    advanced: 'Avanzada',
  };

  const SOMATOTYPE_LABELS: Record<string, string> = {
    ectomorph: 'Ectomorfo',
    mesomorph: 'Mesomorfo',
    endomorph: 'Endomorfo',
  };

  async function initDiets(): Promise<void> {
    const container = document.getElementById('diets-container')!;
    const editor = document.getElementById('diet-editor')!;
    const btnCreate = document.getElementById('btn-create-diet')!;
    const clientFilter = document.getElementById('client-filter') as HTMLSelectElement;
    const dietCount = document.getElementById('diet-count')!;

    // Subscribe to all clients
    unsubClients = subscribeToUsersByRole('client', (clients) => {
      allClients = clients.map(c => ({ uid: c.uid, name: c.name }));
      clientFilter.innerHTML = '<option value="">Todos los alumnos</option>' +
        allClients.map((c) => `<option value="${c.uid}">${escapeHtml(c.name)}</option>`).join('');
    });

    // Subscribe to all diets in the system
    const dietsQuery = query(collection(db, 'diets'), orderBy('createdAt', 'desc'));
    unsubDiets = onSnapshot(dietsQuery, (snapshot) => {
      allDiets = snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      })) as Diet[];
      dietCount.textContent = String(allDiets.length);
      applyFilters();
    }, (error) => {
      logger.error('AdminDiets', 'Error al suscribirse a dietas:', error);
      showToast({ message: 'Error al cargar dietas', type: 'error' });
    });

    clientFilter.addEventListener('change', () => applyFilters());

    btnCreate.addEventListener('click', () => {
      showEditor(null);
    });

    // Event delegation: handle edit/delete clicks via data attributes
    container.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const editBtn = target.closest('[data-action="edit-diet"]') as HTMLElement | null;
      const deleteBtn = target.closest('[data-action="delete-diet"]') as HTMLElement | null;
      if (editBtn) {
        const id = editBtn.dataset.id!;
        const diet = allDiets.find((d) => d.id === id);
        if (diet) showEditor(diet);
      } else if (deleteBtn) {
        showDeleteConfirm(deleteBtn.dataset.id!);
      }
    });
  }

  function showDeleteConfirm(id: string): void {
    const existing = document.getElementById('confirm-modal');
    if (existing) existing.remove();

    const modal = document.createElement('div');
    modal.id = 'confirm-modal';
    modal.className = 'fixed inset-0 z-50 flex items-center justify-center theme-bg-primary/60 backdrop-blur-sm';
    modal.innerHTML = `
      <div class="mx-4 w-full max-w-sm rounded-2xl border theme-border-strong theme-surface/95 p-6 shadow-2xl backdrop-blur-xl">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-500/10 mx-auto">
          <svg class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
          </svg>
        </div>
        <h3 class="text-center text-lg font-semibold theme-text-primary">Eliminar dieta</h3>
        <p class="mt-2 text-center text-sm theme-text-tertiary">¿Estás seguro? Esta acción no se puede deshacer y el alumno perderá su plan nutricional asignado.</p>
        <div class="mt-6 flex gap-3">
          <button id="btn-cancel-delete" class="flex-1 rounded-xl border theme-border-strong theme-surface-secondary/80 px-4 py-2.5 text-sm font-medium theme-text-secondary hover:theme-surface-active/80 transition-all">Cancelar</button>
          <button id="btn-confirm-delete" class="flex-1 rounded-xl bg-red-500/10 border border-red-500/20 px-4 py-2.5 text-sm font-medium text-red-400 hover:bg-red-500/20 transition-all">Eliminar</button>
        </div>
      </div>
    `;
    document.body.appendChild(modal);

    document.getElementById('btn-cancel-delete')!.addEventListener('click', () => modal.remove());
    document.getElementById('btn-confirm-delete')!.addEventListener('click', async () => {
      modal.remove();
      try {
        await deleteDoc(doc(db, 'diets', id));
        showToast({ message: 'Dieta eliminada correctamente', type: 'success' });
      } catch (err) {
        showToast({ message: 'Error al eliminar dieta', type: 'error' });
      }
    });
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.remove(); });
  }

  function applyFilters(): void {
    const container = document.getElementById('diets-container')!;
    const clientFilter = document.getElementById('client-filter') as HTMLSelectElement;
    const clientId = clientFilter.value;

    let filtered = allDiets;
    if (clientId) filtered = filtered.filter((d) => d.clientId === clientId);

    if (filtered.length === 0) {
      container.innerHTML = renderEmptyState(
        ICONS.diets,
        clientId ? 'Este alumno no tiene dietas asignadas' : 'No hay planes nutricionales registrados en la plataforma',
      );
      return;
    }

    container.innerHTML = filtered
      .map((d) => {
        const clientName = allClients.find((c) => c.uid === d.clientId)?.name || 'Sin asignar';
        const somato = d.somatotype ? `<span class="text-orange-400 bg-orange-500/10 border border-orange-500/20 px-2 py-0.5 rounded-md text-[10px]">${SOMATOTYPE_LABELS[d.somatotype] || d.somatotype}</span>` : '';
        return `
          <div class="rounded-xl border theme-border theme-surface-secondary p-4 backdrop-blur-sm transition-all hover:theme-border-strong/60">
            <div class="flex items-center justify-between">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <p class="text-sm font-medium theme-text-primary">${escapeHtml(d.name)}</p>
                  ${somato}
                </div>
                <p class="text-xs theme-text-tertiary mt-1">
                  <span class="theme-text-brand">Alumno: ${escapeHtml(clientName)}</span>
                  <span class="theme-text-tertiary mx-1">·</span>
                  ${d.meals?.length || 0} comidas
                  <span class="theme-text-tertiary mx-1">·</span>
                  ${d.totalCalories} kcal
                  <span class="theme-text-tertiary mx-1">·</span>
                  ${TYPE_LABELS[d.type] || d.type}
                </p>
              </div>
              <div class="flex items-center gap-2 shrink-0 ml-4">
                <button data-action="edit-diet" data-id="${d.id}" class="rounded-lg border theme-border-strong theme-surface-secondary/80 px-2.5 py-1.5 text-xs theme-text-secondary hover:theme-text-primary transition-all">
                  <svg class="h-3.5 w-3.5 inline-block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                  </svg>
                </button>
                <button data-action="delete-diet" data-id="${d.id}" class="rounded-lg border border-red-900/30 bg-red-500/10 px-2.5 py-1.5 text-xs text-red-400 hover:bg-red-500/20 transition-all">
                  <svg class="h-3.5 w-3.5 inline-block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        `;
      })
      .join('');
  }

  function showEditor(diet: Diet | null): void {
    const editor = document.getElementById('diet-editor')!;
    const isEditing = !!diet;
    editor.classList.remove('hidden');
    editor.scrollIntoView({ behavior: 'smooth', block: 'start' });

    const d = diet || {
      id: '',
      clientId: '',
      trainerId: 'admin',
      name: '',
      type: 'normal',
      somatotype: '',
      totalCalories: 0,
      meals: [] as Meal[],
    };

    const clientOptions = allClients
      .map((c) => `<option value="${c.uid}" ${c.uid === d.clientId ? 'selected' : ''}>${escapeHtml(c.name)}</option>`)
      .join('');

    editor.innerHTML = `
      <div class="rounded-xl border theme-border theme-surface-secondary p-5 backdrop-blur-sm mb-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold theme-text-primary">${isEditing ? 'Editar Dieta' : 'Nueva Dieta'}</h2>
          <button id="btn-close-editor" class="rounded-lg border theme-border-strong theme-surface-secondary/80 px-3 py-1.5 text-xs theme-text-secondary hover:theme-text-primary transition-all">Cancelar</button>
        </div>

        <div class="space-y-4">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label class="block text-xs theme-text-tertiary mb-1">Nombre de la dieta</label>
              <input id="diet-name" type="text" value="${escapeHtml(d.name)}" placeholder="Ej: Dieta de Volumen" class="w-full rounded-xl border theme-border theme-surface-secondary px-4 py-2.5 text-sm theme-text-primary placeholder-theme-text-tertiary focus:outline-none focus:ring-2 focus:ring-emerald-500/10" />
              <p id="diet-name-error" class="mt-1 hidden text-xs text-red-400">El nombre es obligatorio</p>
            </div>
            <div>
              <label class="block text-xs theme-text-tertiary mb-1">Alumno</label>
              <select id="diet-client" class="w-full rounded-xl border theme-border theme-surface-secondary px-4 py-2.5 text-sm theme-text-secondary focus:outline-none focus:ring-2 focus:ring-emerald-500/10">
                <option value="">Seleccionar alumno</option>
                ${clientOptions}
              </select>
              <p id="diet-client-error" class="mt-1 hidden text-xs text-red-400">Debes seleccionar un alumno</p>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label class="block text-xs theme-text-tertiary mb-1">Tipo</label>
              <select id="diet-type" class="w-full rounded-xl border theme-border theme-surface-secondary px-4 py-2.5 text-sm theme-text-secondary focus:outline-none focus:ring-2 focus:ring-emerald-500/10">
                <option value="normal" ${d.type === 'normal' ? 'selected' : ''}>Normal</option>
                <option value="advanced" ${d.type === 'advanced' ? 'selected' : ''}>Avanzada</option>
              </select>
            </div>
            <div>
              <label class="block text-xs theme-text-tertiary mb-1">Somatotipo</label>
              <select id="diet-somatotype" class="w-full rounded-xl border theme-border theme-surface-secondary px-4 py-2.5 text-sm theme-text-secondary focus:outline-none focus:ring-2 focus:ring-emerald-500/10">
                <option value="">No especificado</option>
                <option value="ectomorph" ${d.somatotype === 'ectomorph' ? 'selected' : ''}>Ectomorfo</option>
                <option value="mesomorph" ${d.somatotype === 'mesomorph' ? 'selected' : ''}>Mesomorfo</option>
                <option value="endomorph" ${d.somatotype === 'endomorph' ? 'selected' : ''}>Endomorfo</option>
              </select>
            </div>
            <div>
              <label class="block text-xs theme-text-tertiary mb-1">Calorías Totales <span id="cal-auto-badge" class="theme-text-brand/70 text-[10px]">(auto)</span></label>
              <input id="diet-calories" type="number" readonly value="${d.totalCalories || 0}" placeholder="Calculado de comidas" class="w-full rounded-xl border theme-border theme-surface-secondary px-4 py-2.5 text-sm theme-text-secondary placeholder-theme-text-tertiary focus:outline-none cursor-not-allowed" />
            </div>
          </div>

          <!-- Meals -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="text-xs theme-text-tertiary">Comidas <span id="meal-count-badge" class="theme-text-tertiary">(${d.meals.length})</span></label>
              <button id="btn-add-meal" class="text-xs theme-text-brand hover:text-emerald-300 transition-colors">
                + Agregar comida
              </button>
            </div>
            <div id="meals-list" class="space-y-2">
              ${d.meals.length === 0
                ? '<p class="text-xs theme-text-tertiary py-2">No hay comidas agregadas</p>'
                : d.meals.map((meal, i) => renderMealRow(meal, i)).join('')
              }
            </div>
          </div>

          <button id="btn-save-diet" class="w-full rounded-xl theme-brand/10 border theme-border-focus/20 px-4 py-3 text-sm font-medium theme-text-brand hover:theme-brand/20 transition-all active:scale-[0.99] disabled:opacity-50">
            <span id="save-btn-text">${isEditing ? 'Guardar Cambios' : 'Crear Dieta'}</span>
          </button>
        </div>
      </div>
    `;

    document.getElementById('btn-close-editor')!.addEventListener('click', () => closeEditor());

    const mealsList = document.getElementById('meals-list')!;
    const mealCountBadge = document.getElementById('meal-count-badge')!;

    function updateMealCount(): void {
      const count = mealsList.querySelectorAll('[data-meal-row]').length;
      mealCountBadge.textContent = `(${count})`;
    }

    document.getElementById('btn-add-meal')!.addEventListener('click', () => {
      const newMeal: Meal = {
        id: `meal-${Date.now()}`,
        name: 'other',
        description: '',
        calories: 0,
        protein: 0,
        carbs: 0,
        fat: 0,
        order: mealsList.querySelectorAll('[data-meal-row]').length + 1,
      };
      const wrapper = document.createElement('div');
      wrapper.innerHTML = renderMealRow(newMeal, mealsList.querySelectorAll('[data-meal-row]').length);
      if (mealsList.querySelector('p.theme-text-tertiary')) {
        mealsList.innerHTML = '';
      }
      mealsList.appendChild(wrapper.firstElementChild || wrapper);
      updateMealCount();
    });

    mealsList.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-remove-meal]')) {
        const row = target.closest('[data-meal-row]');
        if (row) {
          row.remove();
          updateMealCount();
          calculateTotalCalories();
        }
      }
    });

    function calculateTotalCalories(): void {
      const mealElements = mealsList.querySelectorAll('[data-meal-row]');
      let total = 0;
      mealElements.forEach((el) => {
        const inputs = el.querySelectorAll('input');
        const cal = parseInt((inputs[1] as HTMLInputElement).value) || 0;
        total += cal;
      });
      const calInput = document.getElementById('diet-calories') as HTMLInputElement;
      calInput.value = String(total);
    }

    mealsList.addEventListener('input', (e) => {
      const target = e.target as HTMLElement;
      if (target.tagName === 'INPUT') {
        // Si cambia proteína, carbohidratos o grasas, podemos recalcular calorías
        // O si cambian las calorías directamente, las recalculamos.
        const row = target.closest('[data-meal-row]') as HTMLElement;
        if (row) {
          const inputs = row.querySelectorAll('input');
          const p = parseInt((inputs[2] as HTMLInputElement).value) || 0;
          const c = parseInt((inputs[3] as HTMLInputElement).value) || 0;
          const g = parseInt((inputs[4] as HTMLInputElement).value) || 0;
          const calculatedCal = p * 4 + c * 4 + g * 9;
          if (calculatedCal > 0) {
            (inputs[1] as HTMLInputElement).value = String(calculatedCal);
          }
        }
        calculateTotalCalories();
      }
    });

    document.getElementById('btn-save-diet')!.addEventListener('click', async () => {
      const name = (document.getElementById('diet-name') as HTMLInputElement).value.trim();
      const clientId = (document.getElementById('diet-client') as HTMLSelectElement).value;
      const type = (document.getElementById('diet-type') as HTMLSelectElement).value as 'normal' | 'advanced';
      const somatotype = (document.getElementById('diet-somatotype') as HTMLSelectElement).value as Diet['somatotype'] || undefined;

      const mealElements = mealsList.querySelectorAll('[data-meal-row]');
      let totalCalories = 0;
      mealElements.forEach((el) => {
        const inputs = el.querySelectorAll('input');
        totalCalories += parseInt((inputs[1] as HTMLInputElement).value) || 0;
      });

      const nameError = document.getElementById('diet-name-error')!;
      const clientError = document.getElementById('diet-client-error')!;
      const btnSave = document.getElementById('btn-save-diet') as HTMLButtonElement;

      let hasError = false;
      if (!name) { nameError.classList.remove('hidden'); hasError = true; } else { nameError.classList.add('hidden'); }
      if (!clientId) { clientError.classList.remove('hidden'); hasError = true; } else { clientError.classList.add('hidden'); }
      if (hasError) return;

      btnSave.disabled = true;
      btnSave.textContent = 'Guardando...';

      const meals: Meal[] = Array.from(mealElements).map((el, idx) => {
        const select = el.querySelector('select') as HTMLSelectElement;
        const inputs = el.querySelectorAll('input');
        return {
          id: `meal-${Date.now()}-${idx}`,
          name: select.value as Meal['name'],
          description: (inputs[0] as HTMLInputElement).value,
          calories: parseInt((inputs[1] as HTMLInputElement).value) || 0,
          protein: parseInt((inputs[2] as HTMLInputElement).value) || 0,
          carbs: parseInt((inputs[3] as HTMLInputElement).value) || 0,
          fat: parseInt((inputs[4] as HTMLInputElement).value) || 0,
          order: idx + 1,
        };
      }).filter((m) => m.description.trim() !== '');

      try {
        if (isEditing && diet) {
          await updateDoc(doc(db, 'diets', diet.id), {
            name,
            clientId,
            type,
            somatotype: somatotype || null,
            totalCalories,
            meals,
            updatedAt: serverTimestamp()
          });
          showToast({ message: 'Dieta actualizada con éxito', type: 'success' });
        } else {
          await addDoc(collection(db, 'diets'), {
            name,
            clientId,
            trainerId: 'admin',
            type,
            somatotype: somatotype || null,
            totalCalories,
            meals,
            createdAt: serverTimestamp(),
            updatedAt: serverTimestamp()
          });
          showToast({ message: 'Dieta creada con éxito', type: 'success' });
        }
        closeEditor();
      } catch (error) {
        logger.error('AdminDiets', 'Error al guardar dieta:', error);
        showToast({ message: 'Error al guardar la dieta', type: 'error' });
      } finally {
        btnSave.disabled = false;
        btnSave.textContent = isEditing ? 'Guardar Cambios' : 'Crear Dieta';
      }
    });

    function closeEditor() {
      editor.classList.add('hidden');
      editor.innerHTML = '';
    }
  }

  function renderMealRow(meal: Meal, index: number): string {
    return `
      <div data-meal-row class="rounded-xl border theme-border theme-surface-secondary p-3 backdrop-blur-sm">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xs theme-text-tertiary font-medium w-5">#${index + 1}</span>
          <select class="flex-1 rounded-lg border theme-border theme-surface-secondary/60 px-2.5 py-1.5 text-xs theme-text-primary focus:outline-none focus:ring-2 focus:ring-emerald-500/10">
            <option value="breakfast" ${meal.name === 'breakfast' ? 'selected' : ''}>Desayuno</option>
            <option value="lunch" ${meal.name === 'lunch' ? 'selected' : ''}>Almuerzo</option>
            <option value="snack" ${meal.name === 'snack' ? 'selected' : ''}>Snack</option>
            <option value="dinner" ${meal.name === 'dinner' ? 'selected' : ''}>Cena</option>
            <option value="other" ${meal.name === 'other' ? 'selected' : ''}>Otro</option>
          </select>
          <button data-remove-meal class="rounded-lg border border-red-900/30 bg-red-500/10 px-2 py-1.5 text-xs text-red-400 hover:bg-red-500/20 transition-all">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <input type="text" value="${escapeHtml(meal.description)}" placeholder="Descripción (Ej: 150g pechuga de pollo, 100g arroz)" class="flex-1 min-w-[200px] rounded-lg border theme-border theme-surface-secondary/60 px-2.5 py-1.5 text-xs theme-text-primary placeholder-theme-text-tertiary focus:outline-none focus:ring-2 focus:ring-emerald-500/10" />
          <div class="flex items-center gap-1">
            <label class="text-[10px] theme-text-tertiary">Cal</label>
            <input type="number" value="${meal.calories || ''}" placeholder="0" class="w-14 rounded-lg border theme-border theme-surface-secondary/60 px-2 py-1.5 text-xs theme-text-primary text-center focus:outline-none focus:ring-2 focus:ring-emerald-500/10" title="Calorías" />
          </div>
          <div class="flex items-center gap-1">
            <label class="text-[10px] theme-text-tertiary">Prot</label>
            <input type="number" value="${meal.protein || ''}" placeholder="0" class="w-12 rounded-lg border theme-border theme-surface-secondary/60 px-2 py-1.5 text-xs theme-text-primary text-center focus:outline-none focus:ring-2 focus:ring-emerald-500/10" title="Proteínas" />
          </div>
          <div class="flex items-center gap-1">
            <label class="text-[10px] theme-text-tertiary">Carbs</label>
            <input type="number" value="${meal.carbs || ''}" placeholder="0" class="w-12 rounded-lg border theme-border theme-surface-secondary/60 px-2 py-1.5 text-xs theme-text-primary text-center focus:outline-none focus:ring-2 focus:ring-emerald-500/10" title="Carbohidratos" />
          </div>
          <div class="flex items-center gap-1">
            <label class="text-[10px] theme-text-tertiary">Grasas</label>
            <input type="number" value="${meal.fat || ''}" placeholder="0" class="w-12 rounded-lg border theme-border theme-surface-secondary/60 px-2 py-1.5 text-xs theme-text-primary text-center focus:outline-none focus:ring-2 focus:ring-emerald-500/10" title="Grasas" />
          </div>
        </div>
      </div>
    `;
  }
</script>
