---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<AdminLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold">Panel Clínico</h1>
          <p class="mt-1 text-sm text-zinc-500">Supervisión de datos médicos, intolerancias y condiciones de todos los clientes</p>
        </div>
        <div id="last-update" class="text-xs text-zinc-600">Actualizado: --</div>
      </div>

      <!-- Stats Row -->
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-xl border border-zinc-800/40 bg-zinc-900/40 p-4 backdrop-blur-sm">
          <p class="text-xs text-zinc-500">Con alergias</p>
          <p id="stat-allergies" class="mt-1 text-2xl font-bold text-yellow-400">-</p>
        </div>
        <div class="rounded-xl border border-zinc-800/40 bg-zinc-900/40 p-4 backdrop-blur-sm">
          <p class="text-xs text-zinc-500">Con intolerancias</p>
          <p id="stat-intolerances" class="mt-1 text-2xl font-bold text-red-400">-</p>
        </div>
        <div class="rounded-xl border border-zinc-800/40 bg-zinc-900/40 p-4 backdrop-blur-sm">
          <p class="text-xs text-zinc-500">Con lesiones</p>
          <p id="stat-injuries" class="mt-1 text-2xl font-bold text-orange-400">-</p>
        </div>
        <div class="rounded-xl border border-zinc-800/40 bg-zinc-900/40 p-4 backdrop-blur-sm">
          <p class="text-xs text-zinc-500">Con medicación</p>
          <p id="stat-medications" class="mt-1 text-2xl font-bold text-blue-400">-</p>
        </div>
      </div>

      <!-- Second stats row -->
      <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-zinc-800/40 bg-zinc-900/40 p-4 backdrop-blur-sm">
          <p class="text-xs text-zinc-500">Gluten-free</p>
          <p id="stat-gluten" class="mt-1 text-2xl font-bold text-emerald-400">-</p>
        </div>
        <div class="rounded-xl border border-zinc-800/40 bg-zinc-900/40 p-4 backdrop-blur-sm">
          <p class="text-xs text-zinc-500">Lactose-free</p>
          <p id="stat-lactose" class="mt-1 text-2xl font-bold text-emerald-400">-</p>
        </div>
        <div class="rounded-xl border border-zinc-800/40 bg-zinc-900/40 p-4 backdrop-blur-sm">
          <p class="text-xs text-zinc-500">Veganos/Vegetarianos</p>
          <p id="stat-vegan" class="mt-1 text-2xl font-bold text-emerald-400">-</p>
        </div>
      </div>

      <!-- Search -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <input
          type="text"
          id="searchInput"
          placeholder="Buscar por nombre, condición, alergia o intolerancia..."
          class="flex-1 rounded-xl border border-zinc-700/50 bg-zinc-800/50 px-4 py-2.5 text-sm text-zinc-200 placeholder-zinc-500 outline-none transition-all focus:border-emerald-500/50 focus:bg-zinc-800"
        />
        <button
          id="refreshBtn"
          class="rounded-xl border border-zinc-700/50 bg-zinc-800/50 px-4 py-2.5 text-sm text-zinc-300 transition-all hover:border-zinc-600 hover:text-white"
        >
          Actualizar
        </button>
      </div>

      <!-- Loading State -->
      <div id="loadingState" class="mt-6 space-y-4">
        <div class="animate-pulse rounded-xl border border-zinc-800/40 bg-zinc-900/40 p-5">
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-zinc-800"></div>
            <div class="flex-1 space-y-2">
              <div class="h-4 w-36 rounded bg-zinc-800"></div>
              <div class="h-3 w-56 rounded bg-zinc-800/60"></div>
            </div>
          </div>
        </div>
        <div class="animate-pulse rounded-xl border border-zinc-800/40 bg-zinc-900/40 p-5">
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-zinc-800"></div>
            <div class="flex-1 space-y-2">
              <div class="h-4 w-28 rounded bg-zinc-800"></div>
              <div class="h-3 w-48 rounded bg-zinc-800/60"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Empty State -->
      <div id="emptyState" class="mt-6 hidden rounded-xl border border-zinc-800/40 bg-zinc-900/40 p-12 text-center">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-zinc-800/50">
          <svg class="h-8 w-8 text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-zinc-400">No hay clientes con datos clínicos</h3>
        <p class="mt-1 text-sm text-zinc-600">Los clientes aún no han completado sus perfiles médicos</p>
      </div>

      <!-- Clinical Cards -->
      <div id="clinicalList" class="mt-6 hidden space-y-4"></div>

      <!-- Error Toast -->
      <div id="errorToast" class="fixed bottom-4 right-4 hidden rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400 backdrop-blur-xl">
        <span id="errorMessage"></span>
        <button id="dismissError" class="ml-3 text-red-400/70 hover:text-red-400">&times;</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { db } from '@/lib/firebase';
  import { collection, getDocs, query, where, type Timestamp } from 'firebase/firestore';
  import { logger } from '@/lib/shared/logger';

  interface ClinicalClient {
    uid: string;
    name: string;
    email: string;
    trainerName: string;
    medicalProfile: {
      height?: number;
      weight?: number;
      age?: number;
      gender?: string;
      bloodType?: string;
      allergies?: string;
      conditions?: string;
      medications?: string;
      injuries?: string;
      surgery?: string;
      dietaryRestrictions?: {
        glutenFree?: boolean;
        lactoseFree?: boolean;
        vegan?: boolean;
        vegetarian?: boolean;
        nutFree?: boolean;
        shellfishFree?: boolean;
        other?: string[];
      };
      intolerances?: Array<{ substance: string; severity: string; symptoms: string }>;
      goals?: string[];
      experience?: string;
      emergencyName?: string;
      emergencyPhone?: string;
    } | null;
  }

  const loadingState = document.getElementById('loadingState')!;
  const emptyState = document.getElementById('emptyState')!;
  const clinicalList = document.getElementById('clinicalList')!;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const refreshBtn = document.getElementById('refreshBtn')!;
  const lastUpdate = document.getElementById('last-update')!;
  const errorToast = document.getElementById('errorToast')!;
  const errorMessage = document.getElementById('errorMessage')!;
  const dismissError = document.getElementById('dismissError')!;

  let allClients: ClinicalClient[] = [];

  function showError(msg: string): void {
    errorMessage.textContent = msg;
    errorToast.classList.remove('hidden');
    logger.error('admin/clinical', msg);
  }

  dismissError.addEventListener('click', () => {
    errorToast.classList.add('hidden');
  });

  function severityBadge(s: string): string {
    const map: Record<string, string> = {
      mild: 'bg-yellow-500/10 text-yellow-400',
      moderate: 'bg-orange-500/10 text-orange-400',
      severe: 'bg-red-500/10 text-red-400',
    };
    return map[s] || 'bg-zinc-800 text-zinc-500';
  }

  function updateStats(): void {
    document.getElementById('stat-allergies')!.textContent = String(allClients.filter(c => c.medicalProfile?.allergies).length);
    document.getElementById('stat-intolerances')!.textContent = String(allClients.filter(c => (c.medicalProfile?.intolerances?.length || 0) > 0).length);
    document.getElementById('stat-injuries')!.textContent = String(allClients.filter(c => c.medicalProfile?.injuries).length);
    document.getElementById('stat-medications')!.textContent = String(allClients.filter(c => c.medicalProfile?.medications).length);
    document.getElementById('stat-gluten')!.textContent = String(allClients.filter(c => c.medicalProfile?.dietaryRestrictions?.glutenFree).length);
    document.getElementById('stat-lactose')!.textContent = String(allClients.filter(c => c.medicalProfile?.dietaryRestrictions?.lactoseFree).length);
    document.getElementById('stat-vegan')!.textContent = String(allClients.filter(c => c.medicalProfile?.dietaryRestrictions?.vegan || c.medicalProfile?.dietaryRestrictions?.vegetarian).length);
  }

  function renderClients(clients: ClinicalClient[]): void {
    clinicalList.innerHTML = '';
    if (clients.length === 0) {
      loadingState.classList.add('hidden');
      emptyState.classList.remove('hidden');
      clinicalList.classList.add('hidden');
      return;
    }
    loadingState.classList.add('hidden');
    emptyState.classList.add('hidden');
    clinicalList.classList.remove('hidden');

    clients.forEach(c => {
      const mp = c.medicalProfile;
      const hasData = mp && (mp.allergies || mp.conditions || mp.injuries || mp.medications || (mp.intolerances?.length || 0) > 0);

      const card = document.createElement('div');
      card.className = `rounded-xl border p-5 backdrop-blur-sm transition-all hover:border-zinc-700/60 ${hasData ? 'border-yellow-500/20 bg-yellow-500/5' : 'border-zinc-800/40 bg-zinc-900/40'}`;
      card.innerHTML = `
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-zinc-800 text-sm font-semibold">${(c.name || '?')[0]?.toUpperCase()}</div>
            <div>
              <h3 class="font-semibold text-zinc-200">${c.name}</h3>
              <p class="text-xs text-zinc-500">${c.email}${c.trainerName ? ` · Trainer: ${c.trainerName}` : ''}</p>
            </div>
          </div>
          ${hasData ? '<span class="rounded-full bg-yellow-500/10 px-2 py-1 text-xs text-yellow-400">Datos clínicos</span>' : '<span class="rounded-full bg-zinc-800 px-2 py-1 text-xs text-zinc-600">Sin datos</span>'}
        </div>

        ${mp ? `
        <div class="grid grid-cols-2 gap-2 text-sm">
          ${mp.bloodType ? `<div class="rounded-lg bg-zinc-800/50 px-3 py-1.5"><span class="text-zinc-500">Sangre:</span> <span class="text-zinc-300">${mp.bloodType}</span></div>` : ''}
          ${mp.gender ? `<div class="rounded-lg bg-zinc-800/50 px-3 py-1.5"><span class="text-zinc-500">Sexo:</span> <span class="text-zinc-300">${mp.gender === 'male' ? '♂' : mp.gender === 'female' ? '♀' : '⚧'}</span></div>` : ''}
          ${mp.height ? `<div class="rounded-lg bg-zinc-800/50 px-3 py-1.5"><span class="text-zinc-500">Altura:</span> <span class="text-zinc-300">${mp.height} cm</span></div>` : ''}
          ${mp.weight ? `<div class="rounded-lg bg-zinc-800/50 px-3 py-1.5"><span class="text-zinc-500">Peso:</span> <span class="text-zinc-300">${mp.weight} kg</span></div>` : ''}
          ${mp.age ? `<div class="rounded-lg bg-zinc-800/50 px-3 py-1.5"><span class="text-zinc-500">Edad:</span> <span class="text-zinc-300">${mp.age}</span></div>` : ''}
          ${mp.experience ? `<div class="rounded-lg bg-zinc-800/50 px-3 py-1.5"><span class="text-zinc-500">Exp:</span> <span class="text-zinc-300 capitalize">${mp.experience}</span></div>` : ''}
        </div>

        ${mp.dietaryRestrictions ? `
        <div class="mt-3 border-t border-zinc-800/40 pt-3">
          <p class="text-xs font-medium text-zinc-500 mb-2">Restricciones alimentarias</p>
          <div class="flex flex-wrap gap-1.5">
            ${mp.dietaryRestrictions.glutenFree ? '<span class="rounded-md bg-yellow-500/10 px-2 py-0.5 text-xs text-yellow-400">🌾 Sin gluten</span>' : ''}
            ${mp.dietaryRestrictions.lactoseFree ? '<span class="rounded-md bg-yellow-500/10 px-2 py-0.5 text-xs text-yellow-400">🥛 Sin lactosa</span>' : ''}
            ${mp.dietaryRestrictions.vegan ? '<span class="rounded-md bg-emerald-500/10 px-2 py-0.5 text-xs text-emerald-400">🌱 Vegano</span>' : ''}
            ${mp.dietaryRestrictions.vegetarian ? '<span class="rounded-md bg-emerald-500/10 px-2 py-0.5 text-xs text-emerald-400">🥬 Vegetariano</span>' : ''}
            ${mp.dietaryRestrictions.nutFree ? '<span class="rounded-md bg-yellow-500/10 px-2 py-0.5 text-xs text-yellow-400">🥜 Sin frutos secos</span>' : ''}
            ${mp.dietaryRestrictions.shellfishFree ? '<span class="rounded-md bg-yellow-500/10 px-2 py-0.5 text-xs text-yellow-400">🦐 Sin mariscos</span>' : ''}
            ${(mp.dietaryRestrictions.other || []).map(o => `<span class="rounded-md bg-zinc-800 px-2 py-0.5 text-xs text-zinc-400">${o}</span>`).join('')}
          </div>
        </div>` : ''}

        ${(mp.intolerances?.length || 0) > 0 ? `
        <div class="mt-3 border-t border-zinc-800/40 pt-3">
          <p class="text-xs font-medium text-zinc-500 mb-2">Intolerancias</p>
          <div class="space-y-1">
            ${(mp.intolerances || []).map(i => `
              <div class="flex items-center justify-between rounded-lg bg-zinc-800/50 px-3 py-1.5">
                <span class="text-sm text-zinc-300">${i.substance}</span>
                <div class="flex items-center gap-2">
                  <span class="rounded-full px-2 py-0.5 text-xs font-medium ${severityBadge(i.severity)}">${i.severity === 'mild' ? 'Leve' : i.severity === 'moderate' ? 'Moderada' : 'Severa'}</span>
                </div>
              </div>
            `).join('')}
          </div>
        </div>` : ''}

        ${mp.allergies ? `<div class="mt-2 rounded-lg bg-zinc-800/50 px-3 py-2"><span class="text-xs text-zinc-500">Alergias:</span> <span class="text-sm text-red-300">${mp.allergies}</span></div>` : ''}
        ${mp.conditions ? `<div class="mt-1 rounded-lg bg-zinc-800/50 px-3 py-2"><span class="text-xs text-zinc-500">Condiciones:</span> <span class="text-sm text-orange-300">${mp.conditions}</span></div>` : ''}
        ${mp.medications ? `<div class="mt-1 rounded-lg bg-zinc-800/50 px-3 py-2"><span class="text-xs text-zinc-500">Medicación:</span> <span class="text-sm text-blue-300">${mp.medications}</span></div>` : ''}
        ${mp.injuries ? `<div class="mt-1 rounded-lg bg-zinc-800/50 px-3 py-2"><span class="text-xs text-zinc-500">Lesiones:</span> <span class="text-sm text-orange-300">${mp.injuries}</span></div>` : ''}
        ${mp.surgery ? `<div class="mt-1 rounded-lg bg-zinc-800/50 px-3 py-2"><span class="text-xs text-zinc-500">Cirugías:</span> <span class="text-sm text-zinc-300">${mp.surgery}</span></div>` : ''}

        ${mp.emergencyName || mp.emergencyPhone ? `
        <div class="mt-3 border-t border-zinc-800/40 pt-3">
          <p class="text-xs font-medium text-zinc-500 mb-1">🚨 Emergencia</p>
          <p class="text-sm text-zinc-300">${mp.emergencyName || '-'} · ${mp.emergencyPhone || '-'}</p>
        </div>` : ''}
        ` : '<p class="text-sm text-zinc-600 italic">Perfil médico no completado</p>'}
      `;
      clinicalList.appendChild(card);
    });
  }

  function filterClients(): void {
    const searchTerm = searchInput.value.toLowerCase();
    let filtered = allClients;
    if (searchTerm) {
      filtered = filtered.filter(c =>
        c.name.toLowerCase().includes(searchTerm) ||
        c.email.toLowerCase().includes(searchTerm) ||
        (c.medicalProfile?.allergies || '').toLowerCase().includes(searchTerm) ||
        (c.medicalProfile?.conditions || '').toLowerCase().includes(searchTerm) ||
        (c.medicalProfile?.injuries || '').toLowerCase().includes(searchTerm) ||
        (c.medicalProfile?.intolerances || []).some(i => i.substance.toLowerCase().includes(searchTerm))
      );
    }
    renderClients(filtered);
  }

  searchInput.addEventListener('input', filterClients);

  async function loadClinical(): Promise<void> {
    loadingState.classList.remove('hidden');
    emptyState.classList.add('hidden');
    clinicalList.classList.add('hidden');

    try {
      // Load trainers map
      const allUsersSnap = await getDocs(collection(db, 'users'));
      const trainerMap = new Map<string, string>();
      allUsersSnap.forEach(d => {
        const data = d.data();
        if (data.role === 'trainer') {
          trainerMap.set(d.id, data.name || data.email || '');
        }
      });

      // Load clients
      const clientsSnap = await getDocs(query(collection(db, 'users'), where('role', '==', 'client')));
      allClients = clientsSnap.docs.map(doc => {
        const data = doc.data();
        const mp = data.medicalProfile;
        return {
          uid: doc.id,
          name: data.name || data.email || doc.id,
          email: data.email || '',
          trainerName: trainerMap.get(data.assignedTrainerId) || '',
          medicalProfile: mp || null,
        };
      });

      updateStats();
      renderClients(allClients);
      lastUpdate.textContent = `Actualizado: ${new Date().toLocaleTimeString()}`;
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Error desconocido';
      showError(`Error: ${msg}`);
      loadingState.classList.add('hidden');
      emptyState.classList.remove('hidden');
    }
  }

  refreshBtn.addEventListener('click', loadClinical);
  loadClinical();
  const interval = setInterval(loadClinical, 60000);
  document.addEventListener('astro:before-swap', () => clearInterval(interval));
</script>