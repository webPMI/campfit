---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<AdminLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold">{t('clinical.title.admin')}</h1>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t('clinical.desc.admin')}</p>
        </div>
        <div id="last-update" class="text-xs text-[var(--text-disabled)]">{t('clinical.updated')}: --</div>
      </div>

      <!-- Stats Row -->
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs text-[var(--text-tertiary)]">{t('clinical.stat.allergies')}</p>
          <p id="stat-allergies" class="mt-1 text-2xl font-bold text-[var(--warning)]">-</p>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs text-[var(--text-tertiary)]">{t('clinical.stat.intolerances')}</p>
          <p id="stat-intolerances" class="mt-1 text-2xl font-bold text-[var(--danger)]">-</p>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs text-[var(--text-tertiary)]">{t('clinical.stat.injuries')}</p>
          <p id="stat-injuries" class="mt-1 text-2xl font-bold text-[var(--warning)]">-</p>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs text-[var(--text-tertiary)]">{t('clinical.stat.medications')}</p>
          <p id="stat-medications" class="mt-1 text-2xl font-bold text-[var(--info)]">-</p>
        </div>
      </div>

      <!-- Second stats row -->
      <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs text-[var(--text-tertiary)]">{t('clinical.stat.glutenFree')}</p>
          <p id="stat-gluten" class="mt-1 text-2xl font-bold text-[var(--brand)]">-</p>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs text-[var(--text-tertiary)]">{t('clinical.stat.lactoseFree')}</p>
          <p id="stat-lactose" class="mt-1 text-2xl font-bold text-[var(--brand)]">-</p>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs text-[var(--text-tertiary)]">{t('clinical.stat.veganVegetarian')}</p>
          <p id="stat-vegan" class="mt-1 text-2xl font-bold text-[var(--brand)]">-</p>
        </div>
      </div>

      <!-- Search -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <input
          type="text"
          id="searchInput"
          placeholder={t('clinical.search.placeholder.admin')}
          class="flex-1 rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:bg-[var(--surface-3)]"
        />
        <button
          id="refreshBtn"
          class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-2.5 text-sm text-[var(--text-secondary)] transition-all hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]"
        >
          {t('clinical.refresh')}
        </button>
      </div>

      <!-- Loading State -->
      <div id="loadingState" class="mt-6 space-y-4">
        <div class="animate-pulse rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5">
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-[var(--surface-3)]"></div>
            <div class="flex-1 space-y-2">
              <div class="h-4 w-36 rounded bg-[var(--surface-3)]"></div>
              <div class="h-3 w-56 rounded bg-[var(--surface-3)]"></div>
            </div>
          </div>
        </div>
        <div class="animate-pulse rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5">
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-[var(--surface-3)]"></div>
            <div class="flex-1 space-y-2">
              <div class="h-4 w-28 rounded bg-[var(--surface-3)]"></div>
              <div class="h-3 w-48 rounded bg-[var(--surface-3)]"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Empty State -->
      <div id="emptyState" class="mt-6 hidden rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-12 text-center">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--surface-4)]">
          <svg class="h-8 w-8 text-[var(--text-disabled)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-[var(--text-secondary)]">{t('clinical.empty.admin')}</h3>
        <p class="mt-1 text-sm text-[var(--text-disabled)]">{t('clinical.empty.admin.desc')}</p>
      </div>

      <!-- Clinical Cards -->
      <div id="clinicalList" class="mt-6 hidden space-y-4"></div>

      <!-- Error Toast -->
      <div id="errorToast" class="fixed bottom-4 right-4 hidden rounded-xl border border-red-500/30 bg-[var(--danger-dim)] px-4 py-3 text-sm text-[var(--danger)] backdrop-blur-xl">
        <span id="errorMessage"></span>
        <button id="dismissError" class="ml-3 text-[var(--danger)]/70 hover:text-[var(--danger)]">&times;</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { requireAdmin } from '@/lib/shared/authGuard';
  import { db } from '@/lib/firebase';
  import { collection, getDocs, query, where } from 'firebase/firestore';
  import { logger } from '@/lib/shared/logger';
  import { translations } from '@/i18n/translations';

  const urlLang = new URLSearchParams(window.location.search).get('lang') || 'es';
  const t = (key: string) => translations[urlLang as 'es' | 'en']?.[key] || translations['es']?.[key] || key;

  requireAdmin(() => {
    loadClinical();
  });

  interface ClinicalClient {
    uid: string;
    name: string;
    email: string;
    trainerName: string;
    medicalProfile: {
      height?: number;
      weight?: number;
      age?: number;
      gender?: string;
      bloodType?: string;
      allergies?: string;
      conditions?: string;
      medications?: string;
      injuries?: string;
      surgery?: string;
      dietaryRestrictions?: {
        glutenFree?: boolean;
        lactoseFree?: boolean;
        vegan?: boolean;
        vegetarian?: boolean;
        nutFree?: boolean;
        shellfishFree?: boolean;
        other?: string[];
      };
      intolerances?: Array<{ substance: string; severity: string; symptoms: string }>;
      goals?: string[];
      experience?: string;
      emergencyName?: string;
      emergencyPhone?: string;
    } | null;
  }

  const loadingState = document.getElementById('loadingState')!;
  const emptyState = document.getElementById('emptyState')!;
  const clinicalList = document.getElementById('clinicalList')!;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const refreshBtn = document.getElementById('refreshBtn')!;
  const lastUpdate = document.getElementById('last-update')!;
  const errorToast = document.getElementById('errorToast')!;
  const errorMessage = document.getElementById('errorMessage')!;
  const dismissError = document.getElementById('dismissError')!;

  let allClients: ClinicalClient[] = [];

  function showError(msg: string): void {
    errorMessage.textContent = msg;
    errorToast.classList.remove('hidden');
    logger.error('admin/clinical', msg);
  }

  dismissError.addEventListener('click', () => {
    errorToast.classList.add('hidden');
  });

  function severityBadge(s: string): string {
    const map: Record<string, string> = {
      mild: 'bg-[var(--warning-dim)] text-[var(--warning)]',
      moderate: 'bg-[var(--warning-dim)] text-[var(--warning)]',
      severe: 'bg-[var(--danger-dim)] text-[var(--danger)]',
    };
    return map[s] || 'bg-[var(--surface-3)] text-[var(--text-tertiary)]';
  }

  function severityLabel(s: string): string {
    if (s === 'mild') return t('clinical.severity.mild');
    if (s === 'moderate') return t('clinical.severity.moderate');
    if (s === 'severe') return t('clinical.severity.severe');
    return s;
  }

  function genderLabel(g: string): string {
    if (g === 'male') return '♂';
    if (g === 'female') return '♀';
    return '⚧';
  }

  function updateStats(): void {
    document.getElementById('stat-allergies')!.textContent = String(allClients.filter(c => c.medicalProfile?.allergies).length);
    document.getElementById('stat-intolerances')!.textContent = String(allClients.filter(c => (c.medicalProfile?.intolerances?.length || 0) > 0).length);
    document.getElementById('stat-injuries')!.textContent = String(allClients.filter(c => c.medicalProfile?.injuries).length);
    document.getElementById('stat-medications')!.textContent = String(allClients.filter(c => c.medicalProfile?.medications).length);
    document.getElementById('stat-gluten')!.textContent = String(allClients.filter(c => c.medicalProfile?.dietaryRestrictions?.glutenFree).length);
    document.getElementById('stat-lactose')!.textContent = String(allClients.filter(c => c.medicalProfile?.dietaryRestrictions?.lactoseFree).length);
    document.getElementById('stat-vegan')!.textContent = String(allClients.filter(c => c.medicalProfile?.dietaryRestrictions?.vegan || c.medicalProfile?.dietaryRestrictions?.vegetarian).length);
  }

  function renderClients(clients: ClinicalClient[]): void {
    clinicalList.innerHTML = '';
    if (clients.length === 0) {
      loadingState.classList.add('hidden');
      emptyState.classList.remove('hidden');
      clinicalList.classList.add('hidden');
      return;
    }
    loadingState.classList.add('hidden');
    emptyState.classList.add('hidden');
    clinicalList.classList.remove('hidden');

    clients.forEach(c => {
      const mp = c.medicalProfile;
      const hasData = mp && (mp.allergies || mp.conditions || mp.injuries || mp.medications || (mp.intolerances?.length || 0) > 0);

      const card = document.createElement('div');
      card.className = `rounded-xl border p-5 backdrop-blur-sm transition-all hover:border-[var(--border-default)] ${hasData ? 'border-[var(--warning)] bg-[var(--warning-dim)]' : 'border-[var(--border-subtle)] bg-[var(--surface-2)]'}`;
      card.innerHTML = `
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--surface-3)] text-sm font-semibold">${(c.name || '?')[0]?.toUpperCase()}</div>
            <div>
              <h3 class="font-semibold text-[var(--text-primary)]">${c.name}</h3>
              <p class="text-xs text-[var(--text-tertiary)]">${c.email}${c.trainerName ? ` · Trainer: ${c.trainerName}` : ''}</p>
            </div>
          </div>
          ${hasData ? `<span class="rounded-full bg-[var(--warning-dim)] px-2 py-1 text-xs text-[var(--warning)]">${t('clinical.stat.withData')}</span>` : `<span class="rounded-full bg-[var(--surface-3)] px-2 py-1 text-xs text-[var(--text-disabled)]">${t('clinical.badge.noData')}</span>`}
        </div>

        ${mp ? `
        <div class="grid grid-cols-2 gap-2 text-sm">
          ${mp.bloodType ? `<div class="rounded-lg bg-[var(--surface-4)] px-3 py-1.5"><span class="text-[var(--text-tertiary)]">🩸</span> <span class="text-[var(--text-secondary)]">${mp.bloodType}</span></div>` : ''}
          ${mp.gender ? `<div class="rounded-lg bg-[var(--surface-4)] px-3 py-1.5"><span class="text-[var(--text-tertiary)]">${genderLabel(mp.gender)}</span></div>` : ''}
          ${mp.height ? `<div class="rounded-lg bg-[var(--surface-4)] px-3 py-1.5"><span class="text-[var(--text-tertiary)]">📏</span> <span class="text-[var(--text-secondary)]">${mp.height} cm</span></div>` : ''}
          ${mp.weight ? `<div class="rounded-lg bg-[var(--surface-4)] px-3 py-1.5"><span class="text-[var(--text-tertiary)]">⚖️</span> <span class="text-[var(--text-secondary)]">${mp.weight} kg</span></div>` : ''}
          ${mp.age ? `<div class="rounded-lg bg-[var(--surface-4)] px-3 py-1.5"><span class="text-[var(--text-tertiary)]">🎂</span> <span class="text-[var(--text-secondary)]">${mp.age} ${t('clinical.years')}</span></div>` : ''}
          ${mp.experience ? `<div class="rounded-lg bg-[var(--surface-4)] px-3 py-1.5"><span class="text-[var(--text-tertiary)]">💪</span> <span class="text-[var(--text-secondary)] capitalize">${mp.experience}</span></div>` : ''}
        </div>

        ${mp.dietaryRestrictions ? `
        <div class="mt-3 border-t border-[var(--border-subtle)] pt-3">
          <p class="text-xs font-medium text-[var(--text-tertiary)] mb-2">${t('clinical.section.restrictions')}</p>
          <div class="flex flex-wrap gap-1.5">
            ${mp.dietaryRestrictions.glutenFree ? `<span class="rounded-md bg-[var(--warning-dim)] px-2 py-0.5 text-xs text-[var(--warning)]">${t('clinical.diet.glutenFree')}</span>` : ''}
            ${mp.dietaryRestrictions.lactoseFree ? `<span class="rounded-md bg-[var(--warning-dim)] px-2 py-0.5 text-xs text-[var(--warning)]">${t('clinical.diet.lactoseFree')}</span>` : ''}
            ${mp.dietaryRestrictions.vegan ? `<span class="rounded-md bg-[var(--brand-dim)] px-2 py-0.5 text-xs text-[var(--brand)]">${t('clinical.diet.vegan')}</span>` : ''}
            ${mp.dietaryRestrictions.vegetarian ? `<span class="rounded-md bg-[var(--brand-dim)] px-2 py-0.5 text-xs text-[var(--brand)]">${t('clinical.diet.vegetarian')}</span>` : ''}
            ${mp.dietaryRestrictions.nutFree ? `<span class="rounded-md bg-[var(--warning-dim)] px-2 py-0.5 text-xs text-[var(--warning)]">${t('clinical.diet.nutFree')}</span>` : ''}
            ${mp.dietaryRestrictions.shellfishFree ? `<span class="rounded-md bg-[var(--warning-dim)] px-2 py-0.5 text-xs text-[var(--warning)]">${t('clinical.diet.shellfishFree')}</span>` : ''}
            ${(mp.dietaryRestrictions.other || []).map(o => `<span class="rounded-md bg-[var(--surface-3)] px-2 py-0.5 text-xs text-[var(--text-secondary)]">${o}</span>`).join('')}
          </div>
        </div>` : ''}

        ${(mp.intolerances?.length || 0) > 0 ? `
        <div class="mt-3 border-t border-[var(--border-subtle)] pt-3">
          <p class="text-xs font-medium text-[var(--text-tertiary)] mb-2">${t('clinical.section.intolerances')}</p>
          <div class="space-y-1">
            ${(mp.intolerances || []).map(i => `
              <div class="flex items-center justify-between rounded-lg bg-[var(--surface-4)] px-3 py-1.5">
                <span class="text-sm text-[var(--text-secondary)]">${i.substance}</span>
                <div class="flex items-center gap-2">
                  <span class="rounded-full px-2 py-0.5 text-xs font-medium ${severityBadge(i.severity)}">${severityLabel(i.severity)}</span>
                </div>
              </div>
            `).join('')}
          </div>
        </div>` : ''}

        ${mp.allergies ? `<div class="mt-2 rounded-lg bg-[var(--surface-4)] px-3 py-2"><span class="text-xs text-[var(--text-tertiary)]">${t('clinical.label.allergies')}:</span> <span class="text-sm text-[var(--danger)]">${mp.allergies}</span></div>` : ''}
        ${mp.conditions ? `<div class="mt-1 rounded-lg bg-[var(--surface-4)] px-3 py-2"><span class="text-xs text-[var(--text-tertiary)]">${t('clinical.label.conditions')}:</span> <span class="text-sm text-[var(--warning)]">${mp.conditions}</span></div>` : ''}
        ${mp.medications ? `<div class="mt-1 rounded-lg bg-[var(--surface-4)] px-3 py-2"><span class="text-xs text-[var(--text-tertiary)]">${t('clinical.label.medications')}:</span> <span class="text-sm text-blue-300">${mp.medications}</span></div>` : ''}
        ${mp.injuries ? `<div class="mt-1 rounded-lg bg-[var(--surface-4)] px-3 py-2"><span class="text-xs text-[var(--text-tertiary)]">${t('clinical.label.injuries')}:</span> <span class="text-sm text-[var(--warning)]">${mp.injuries}</span></div>` : ''}
        ${mp.surgery ? `<div class="mt-1 rounded-lg bg-[var(--surface-4)] px-3 py-2"><span class="text-xs text-[var(--text-tertiary)]">${t('clinical.label.surgery')}:</span> <span class="text-sm text-[var(--text-secondary)]">${mp.surgery}</span></div>` : ''}

        ${mp.emergencyName || mp.emergencyPhone ? `
        <div class="mt-3 border-t border-[var(--border-subtle)] pt-3">
          <p class="text-xs font-medium text-[var(--text-tertiary)] mb-1">${t('clinical.section.emergency')}</p>
          <p class="text-sm text-[var(--text-secondary)]">${mp.emergencyName || '-'} · ${mp.emergencyPhone || '-'}</p>
        </div>` : ''}
        ` : `<p class="text-sm text-[var(--text-disabled)] italic">${t('clinical.no.profile')}</p>`}
      `;
      clinicalList.appendChild(card);
    });
  }

  function filterClients(): void {
    const searchTerm = searchInput.value.toLowerCase();
    let filtered = allClients;
    if (searchTerm) {
      filtered = filtered.filter(c =>
        c.name.toLowerCase().includes(searchTerm) ||
        c.email.toLowerCase().includes(searchTerm) ||
        (c.medicalProfile?.allergies || '').toLowerCase().includes(searchTerm) ||
        (c.medicalProfile?.conditions || '').toLowerCase().includes(searchTerm) ||
        (c.medicalProfile?.injuries || '').toLowerCase().includes(searchTerm) ||
        (c.medicalProfile?.intolerances || []).some(i => i.substance.toLowerCase().includes(searchTerm))
      );
    }
    renderClients(filtered);
  }

  searchInput.addEventListener('input', filterClients);

  async function loadClinical(): Promise<void> {
    loadingState.classList.remove('hidden');
    emptyState.classList.add('hidden');
    clinicalList.classList.add('hidden');

    try {
      // Load trainers map
      const allUsersSnap = await getDocs(collection(db, 'users'));
      const trainerMap = new Map<string, string>();
      allUsersSnap.forEach(d => {
        const data = d.data();
        if (data.role === 'trainer') {
          trainerMap.set(d.id, data.name || data.email || '');
        }
      });

      // Load clients
      const clientsSnap = await getDocs(query(collection(db, 'users'), where('role', '==', 'client')));
      allClients = clientsSnap.docs.map(doc => {
        const data = doc.data();
        const mp = data.medicalProfile;
        return {
          uid: doc.id,
          name: data.name || data.email || doc.id,
          email: data.email || '',
          trainerName: trainerMap.get(data.assignedTrainerId) || '',
          medicalProfile: mp || null,
        };
      });

      updateStats();
      renderClients(allClients);
      lastUpdate.textContent = `${t('clinical.updated')}: ${new Date().toLocaleTimeString()}`;
    } catch (err) {
      const msg = err instanceof Error ? err.message : t('clinical.error.load');
      showError(`${t('clinical.error.load')}: ${msg}`);
      loadingState.classList.add('hidden');
      emptyState.classList.remove('hidden');
    }
  }

  refreshBtn.addEventListener('click', loadClinical);
  loadClinical();
  const interval = setInterval(loadClinical, 60000);
  document.addEventListener('astro:before-swap', () => clearInterval(interval));
</script>