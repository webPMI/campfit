---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<AdminLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold">{t('admin.workouts')}</h1>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">Supervisión global de rutinas de entrenamiento</p>
        </div>
        <div id="last-update" class="text-xs text-[var(--text-disabled)]">Actualizado: --</div>
      </div>

      <!-- Stats Row -->
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs text-[var(--text-tertiary)]">Total rutinas</p>
          <p id="stat-total" class="mt-1 text-2xl font-bold text-[var(--brand)]">-</p>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs text-[var(--text-tertiary)]">Activas esta semana</p>
          <p id="stat-active" class="mt-1 text-2xl font-bold text-[var(--info)]">-</p>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs text-[var(--text-tertiary)]">Ejercicios totales</p>
          <p id="stat-exercises" class="mt-1 text-2xl font-bold text-[var(--brand)]">-</p>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <p class="text-xs text-[var(--text-tertiary)]">Tasa de completado</p>
          <p id="stat-completion" class="mt-1 text-2xl font-bold text-[var(--info)]">-</p>
        </div>
      </div>

      <!-- Filters -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <input
          type="text"
          id="searchInput"
          placeholder="Buscar por nombre de rutina o cliente..."
          class="flex-1 rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:bg-[var(--surface-3)]"
        />
        <select
          id="filterTrainer"
          class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-2.5 text-sm text-[var(--text-primary)] outline-none transition-all focus:border-[var(--border-brand)]"
        >
          <option value="all">{t('trainer.filter.all')}</option>
        </select>
        <button
          id="refreshBtn"
          class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-2.5 text-sm text-[var(--text-secondary)] transition-all hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]"
        >
          Actualizar
        </button>
      </div>

      <!-- Loading State -->
      <div id="loadingState" class="mt-6 space-y-4">
        <div class="animate-pulse rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5">
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-lg bg-[var(--surface-3)]"></div>
            <div class="flex-1 space-y-2">
              <div class="h-4 w-48 rounded bg-[var(--surface-3)]"></div>
              <div class="h-3 w-32 rounded bg-[var(--surface-3)]"></div>
            </div>
          </div>
        </div>
        <div class="animate-pulse rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5">
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-lg bg-[var(--surface-3)]"></div>
            <div class="flex-1 space-y-2">
              <div class="h-4 w-40 rounded bg-[var(--surface-3)]"></div>
              <div class="h-3 w-28 rounded bg-[var(--surface-3)]"></div>
            </div>
          </div>
        </div>
        <div class="animate-pulse rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5">
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-lg bg-[var(--surface-3)]"></div>
            <div class="flex-1 space-y-2">
              <div class="h-4 w-44 rounded bg-[var(--surface-3)]"></div>
              <div class="h-3 w-36 rounded bg-[var(--surface-3)]"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Empty State -->
      <div id="emptyState" class="mt-6 hidden rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-12 text-center">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--surface-4)]">
          <svg class="h-8 w-8 text-[var(--text-disabled)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-[var(--text-secondary)]">No hay rutinas registradas</h3>
        <p class="mt-1 text-sm text-[var(--text-disabled)]">Los entrenadores aún no han creado rutinas de entrenamiento</p>
      </div>

      <!-- Workouts List -->
      <div id="workoutsList" class="mt-6 hidden space-y-3"></div>

      <!-- Error Toast -->
      <div id="errorToast" class="fixed bottom-4 right-4 hidden rounded-xl border border-red-500/30 bg-[var(--danger-dim)] px-4 py-3 text-sm text-[var(--danger)] backdrop-blur-xl">
        <span id="errorMessage"></span>
        <button id="dismissError" class="ml-3 text-[var(--danger)]/70 hover:text-[var(--danger)]">&times;</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { db } from '@/lib/firebase';
  import {
    collection, getDocs, doc, getDoc,
    query, orderBy, limit,
    type Timestamp,
  } from 'firebase/firestore';
  import { formatDate } from '@/lib/shared/ui';
  import { logger } from '@/lib/shared/logger';

  interface WorkoutItem {
    id: string;
    name: string;
    trainerId: string;
    trainerName: string;
    clientId?: string;
    clientName?: string;
    exercises: Array<{ name: string; completed: boolean }>;
    createdAt: Timestamp | null;
    updatedAt: Timestamp | null;
  }

  const loadingState = document.getElementById('loadingState')!;
  const emptyState = document.getElementById('emptyState')!;
  const workoutsList = document.getElementById('workoutsList')!;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const filterTrainer = document.getElementById('filterTrainer') as HTMLSelectElement;
  const refreshBtn = document.getElementById('refreshBtn')!;
  const lastUpdate = document.getElementById('last-update')!;
  const errorToast = document.getElementById('errorToast')!;
  const errorMessage = document.getElementById('errorMessage')!;
  const dismissError = document.getElementById('dismissError')!;

  let allWorkouts: WorkoutItem[] = [];
  let trainers: Array<{ uid: string; name: string }> = [];

  function showError(msg: string): void {
    errorMessage.textContent = msg;
    errorToast.classList.remove('hidden');
    logger.error('admin/workouts', msg);
  }

  dismissError.addEventListener('click', () => {
    errorToast.classList.add('hidden');
  });

  function updateStats(workouts: WorkoutItem[]): void {
    document.getElementById('stat-total')!.textContent = String(workouts.length);
    const totalExercises = workouts.reduce((sum, w) => sum + (w.exercises?.length || 0), 0);
    document.getElementById('stat-exercises')!.textContent = String(totalExercises);
    const allExercises = workouts.flatMap(w => w.exercises || []);
    const completed = allExercises.filter(e => e.completed).length;
    const pct = allExercises.length > 0 ? Math.round((completed / allExercises.length) * 100) : 0;
    document.getElementById('stat-completion')!.textContent = `${pct}%`;
    document.getElementById('stat-active')!.textContent = String(workouts.length);
  }

  function renderWorkouts(workouts: WorkoutItem[]): void {
    workoutsList.innerHTML = '';
    if (workouts.length === 0) {
      loadingState.classList.add('hidden');
      emptyState.classList.remove('hidden');
      workoutsList.classList.add('hidden');
      return;
    }
    loadingState.classList.add('hidden');
    emptyState.classList.add('hidden');
    workoutsList.classList.remove('hidden');

    workouts.forEach(workout => {
      const completed = workout.exercises?.filter(e => e.completed).length || 0;
      const total = workout.exercises?.length || 0;
      const pct = total > 0 ? Math.round((completed / total) * 100) : 0;
      const timestamp = workout.updatedAt || workout.createdAt;

      const card = document.createElement('div');
      card.className = 'rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5 backdrop-blur-sm transition-all hover:border-[var(--border-default)]';
      card.innerHTML = `
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--info-dim)]">
              <svg class="h-5 w-5 text-[var(--info)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-[var(--text-primary)]">${workout.name}</h3>
              ${workout.clientName ? `<p class="text-xs text-[var(--text-tertiary)]">Cliente: ${workout.clientName}</p>` : ''}
              <p class="text-xs text-[var(--text-disabled)]">Entrenador: ${workout.trainerName} &middot; ${formatDate(timestamp)}</p>
            </div>
          </div>
          <span class="rounded-full px-2.5 py-1 text-xs font-medium ${pct === 100 ? 'bg-[var(--brand-dim)] text-[var(--brand)]' : 'bg-[var(--warning-dim)] text-[var(--warning)]'}">${pct}%</span>
        </div>
        <div class="mt-4">
          <div class="h-2 overflow-hidden rounded-full bg-[var(--surface-3)]">
            <div class="h-full rounded-full bg-gradient-to-r from-blue-500 to-blue-400 transition-all" style="width: ${pct}%"></div>
          </div>
          <p class="mt-2 text-xs text-[var(--text-disabled)]">${completed}/${total} ejercicios completados</p>
        </div>
        <div class="mt-3 flex flex-wrap gap-1.5">
          ${(workout.exercises || []).map(e => `<span class="rounded-md px-2 py-0.5 text-xs ${e.completed ? 'bg-[var(--brand-dim)] text-[var(--brand)]' : 'bg-[var(--surface-3)] text-[var(--text-tertiary)]'}">${e.name}</span>`).join('')}
        </div>
      `;
      workoutsList.appendChild(card);
    });
  }

  function filterWorkouts(): void {
    const searchTerm = searchInput.value.toLowerCase();
    const trainerFilter = filterTrainer.value;

    let filtered = allWorkouts;
    if (searchTerm) {
      filtered = filtered.filter(w =>
        w.name.toLowerCase().includes(searchTerm) ||
        (w.clientName && w.clientName.toLowerCase().includes(searchTerm)) ||
        w.trainerName.toLowerCase().includes(searchTerm)
      );
    }
    if (trainerFilter !== 'all') {
      filtered = filtered.filter(w => w.trainerId === trainerFilter);
    }
    renderWorkouts(filtered);
  }

  searchInput.addEventListener('input', filterWorkouts);
  filterTrainer.addEventListener('change', filterWorkouts);

  async function loadWorkouts(): Promise<void> {
    loadingState.classList.remove('hidden');
    emptyState.classList.add('hidden');
    workoutsList.classList.add('hidden');

    try {
      // Load trainers for filter
      const trainersSnap = await getDocs(collection(db, 'users'));
      trainers = [];
      trainersSnap.forEach(d => {
        const data = d.data();
        if (data.role === 'trainer') {
          trainers.push({ uid: d.id, name: data.name || data.email || d.id });
        }
      });
      // Populate filter dropdown
      filterTrainer.innerHTML = '<option value="all">Todos los entrenadores</option>';
      trainers.forEach(tr => {
        filterTrainer.innerHTML += `<option value="${tr.uid}">${tr.name}</option>`;
      });

      // Load workouts
      const workoutsRef = collection(db, 'workouts');
      const q = query(workoutsRef, orderBy('updatedAt', 'desc'), limit(200));
      const snap = await getDocs(q);

      const workoutPromises = snap.docs.map(async (workoutDoc) => {
        const data = workoutDoc.data();
        const trainerDoc = trainers.find(t => t.uid === data.trainerId);
        let clientName = '';
        if (data.clientId) {
          try {
            const clientSnap = await getDoc(doc(db, 'users', data.clientId));
            if (clientSnap.exists()) {
              clientName = clientSnap.data().name || clientSnap.data().email || '';
            }
          } catch { /* ignore */ }
        }
        return {
          id: workoutDoc.id,
          name: data.name || 'Sin nombre',
          trainerId: data.trainerId || '',
          trainerName: trainerDoc?.name || 'Desconocido',
          clientId: data.clientId || undefined,
          clientName,
          exercises: data.exercises || [],
          createdAt: data.createdAt || null,
          updatedAt: data.updatedAt || data.createdAt || null,
        } satisfies WorkoutItem;
      });

      allWorkouts = await Promise.all(workoutPromises);
      updateStats(allWorkouts);
      renderWorkouts(allWorkouts);
      lastUpdate.textContent = `Actualizado: ${new Date().toLocaleTimeString()}`;
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Error desconocido';
      showError(`Error al cargar rutinas: ${msg}`);
      loadingState.classList.add('hidden');
      emptyState.classList.remove('hidden');
      emptyState.querySelector('p')!.textContent = 'Error al cargar las rutinas. Intenta de nuevo.';
    }
  }

  refreshBtn.addEventListener('click', loadWorkouts);

  // Initial load
  loadWorkouts();

  // Auto-refresh every 60s
  const interval = setInterval(loadWorkouts, 60000);
  document.addEventListener('astro:before-swap', () => clearInterval(interval));
</script>