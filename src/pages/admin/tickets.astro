---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<AdminLayout>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <!-- Header -->
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div>
        <h1 data-i18n="admin.tickets.title" class="text-2xl font-bold">{t('admin.tickets.title')}</h1>
        <p data-i18n="admin.tickets.desc" class="mt-1 text-sm text-[var(--text-tertiary)]">{t('admin.tickets.desc')}</p>
      </div>
      <div class="flex items-center gap-2 text-xs">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5">
          <span id="stat-open" class="font-semibold text-[var(--danger)]">0</span>
          <span class="text-[var(--text-tertiary)]"> {t('admin.tickets.open')}</span>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5">
          <span id="stat-review" class="font-semibold text-[var(--warning)]">0</span>
          <span class="text-[var(--text-tertiary)]"> {t('admin.tickets.inReview')}</span>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5">
          <span id="stat-resolved" class="font-semibold text-[var(--success)]">0</span>
          <span class="text-[var(--text-tertiary)]"> {t('admin.tickets.resolved')}</span>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5">
          <span id="stat-total" class="font-semibold text-[var(--text-primary)]">0</span>
          <span class="text-[var(--text-tertiary)]"> {t('admin.tickets.total')}</span>
        </div>
      </div>
    </div>

    <!-- Filtros -->
    <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-4">
      <!-- Búsqueda -->
      <div class="relative">
        <svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder={t('admin.search')}
          data-i18n-placeholder="admin.search"
          class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] py-2.5 pl-10 pr-4 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm transition-all focus:border-[var(--border-brand)] focus:outline-none focus:ring-1 focus:ring-[var(--brand-dim)]"
        />
      </div>
      <!-- Filtro por estado -->
      <select id="status-filter" class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2.5 text-sm text-[var(--text-secondary)] backdrop-blur-sm">
        <option value="all" data-i18n="admin.all">{t('admin.all')}</option>
        <option value="open" data-i18n="admin.tickets.open">{t('admin.tickets.open')}</option>
        <option value="in_review" data-i18n="admin.tickets.inReview">{t('admin.tickets.inReview')}</option>
        <option value="awaiting_response" data-i18n="admin.tickets.awaiting">{t('admin.tickets.awaiting')}</option>
        <option value="resolved" data-i18n="admin.tickets.resolved">{t('admin.tickets.resolved')}</option>
        <option value="closed" data-i18n="admin.tickets.closed">{t('admin.tickets.closed')}</option>
      </select>
      <!-- Filtro por categoría -->
      <select id="category-filter" class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2.5 text-sm text-[var(--text-secondary)] backdrop-blur-sm">
        <option value="all" data-i18n="admin.all">{t('admin.all')}</option>
        <option value="bug" data-i18n="report.category.bug">{t('report.category.bug')}</option>
        <option value="misconduct" data-i18n="report.category.misconduct">{t('report.category.misconduct')}</option>
        <option value="vulnerability" data-i18n="report.category.vulnerability">{t('report.category.vulnerability')}</option>
        <option value="inquiry" data-i18n="report.category.inquiry">{t('report.category.inquiry')}</option>
        <option value="suggestion" data-i18n="report.category.suggestion">{t('report.category.suggestion')}</option>
        <option value="other" data-i18n="report.category.other">{t('report.category.other')}</option>
      </select>
      <!-- Filtro por severidad -->
      <select id="severity-filter" class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2.5 text-sm text-[var(--text-secondary)] backdrop-blur-sm">
        <option value="all" data-i18n="admin.all">{t('admin.all')}</option>
        <option value="critical" data-i18n="report.severity.critical">{t('report.severity.critical')}</option>
        <option value="high" data-i18n="report.severity.high">{t('report.severity.high')}</option>
        <option value="medium" data-i18n="report.severity.medium">{t('report.severity.medium')}</option>
        <option value="low" data-i18n="report.severity.low">{t('report.severity.low')}</option>
      </select>
    </div>

    <!-- Lista de tickets -->
    <div class="mt-4 space-y-3">
      <!-- Skeleton carga -->
      <div id="loading-skeleton" class="grid grid-cols-1 gap-3">
        {[1, 2, 3].map(() => `
          <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5 animate-pulse">
            <div class="flex gap-4">
              <div class="h-3 w-24 rounded bg-[var(--surface-3)]"></div>
              <div class="h-3 w-16 rounded bg-[var(--surface-3)]"></div>
              <div class="h-3 w-20 rounded bg-[var(--surface-3)]"></div>
              <div class="flex-1"></div>
            </div>
          </div>
        `).join('')}
      </div>

      <!-- Contenedor vacío -->
      <div id="empty-state" class="hidden rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-8 text-center">
        <svg class="mx-auto h-12 w-12 text-[var(--text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 1.25L17.5 11.25l-2.25 2.25L12 13.5l-4.5 4.5L7.5 18l-1.5-1.5L10.5 10.5L6 6l1.25-1.25L11.25 7.5l2.25-2.25L15.75 4.5l4.5-4.5L18 3l1.5 1.5L12 10.5l4.5 4.5 3 3 1.5-1.5-1.25-1.25L12 7.5Z" />
        </svg>
        <p data-i18n="admin.tickets.empty" class="mt-3 text-lg font-semibold text-[var(--text-primary)]">{t('admin.tickets.empty')}</p>
        <p data-i18n="admin.tickets.emptyDesc" class="mt-1 text-sm text-[var(--text-tertiary)]">{t('admin.tickets.emptyDesc')}</p>
      </div>

      <!-- Lista -->
      <div id="tickets-list" class="hidden space-y-3"></div>
    </div>
  </div>
</AdminLayout>

<script>
  import { initPage } from '@/lib/shared/initPage';

  const loadingSkeleton = document.getElementById('loading-skeleton')!;
  const emptyState = document.getElementById('empty-state')!;
  const ticketsList = document.getElementById('tickets-list')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const statusFilter = document.getElementById('status-filter') as HTMLSelectElement | null;
  const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement | null;
  const severityFilter = document.getElementById('severity-filter') as HTMLSelectElement | null;

  const statOpen = document.getElementById('stat-open')!;
  const statReview = document.getElementById('stat-review')!;
  const statResolved = document.getElementById('stat-resolved')!;
  const statTotal = document.getElementById('stat-total')!;

  let allTickets: Array<{
    id: string;
    title: string;
    description: string;
    category: string;
    severity: string;
    status: string;
    createdAt: string;
    updatedAt: string;
    lastActivityAt: string;
    reporterName: string;
    reporterEmail: string;
    isAnonymous: boolean;
    adminNotes: Array<{ content: string; createdAt: string }>;
    adminContactMessages: Array<{ message: string; createdAt: string }>;
  }> = [];

  function showEmpty() {
    loadingSkeleton.classList.add('hidden');
    ticketsList.classList.add('hidden');
    emptyState.classList.remove('hidden');
  }

  function showList() {
    loadingSkeleton.classList.add('hidden');
    ticketsList.classList.remove('hidden');
    emptyState.classList.add('hidden');
  }

  function renderTicket(ticket: typeof allTickets[0]) {
    const statusColors: Record<string, string> = {
      open: 'bg-amber-500/20 text-amber-400 border-amber-500/30',
      in_review: 'bg-blue-500/20 text-blue-400 border-blue-500/30',
      awaiting_response: 'bg-purple-500/20 text-purple-400 border-purple-500/30',
      resolved: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30',
      closed: 'bg-gray-500/20 text-gray-400 border-gray-500/30',
    };
    const statusLabels: Record<string, string> = {
      open: 'Abierto',
      in_review: 'En revisión',
      awaiting_response: 'Esperando respuesta',
      resolved: 'Resuelto',
      closed: 'Cerrado',
    };
    const severityLabels: Record<string, string> = {
      low: 'Baja',
      medium: 'Media',
      high: 'Alta',
      critical: 'Crítica',
    };
    const severityColors: Record<string, string> = {
      low: 'text-gray-400',
      medium: 'text-amber-400',
      high: 'text-orange-400',
      critical: 'text-red-400',
    };

    const card = document.createElement('div');
    card.className = 'rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-5 backdrop-blur-xl transition-all hover:border-[var(--border-brand)]/50';
    card.dataset.id = ticket.id;
    card.innerHTML = `
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <select
              class="ticket-status-select rounded-lg px-2 py-0.5 text-xs font-semibold border focus:border-[var(--accent)] focus:outline-none ${statusColors[ticket.status] || 'bg-gray-500/20 text-gray-400 border-gray-500/30'}"
              data-id="${ticket.id}"
            >
              <option value="open" ${ticket.status === 'open' ? 'selected' : ''}>Abierto</option>
              <option value="in_review" ${ticket.status === 'in_review' ? 'selected' : ''}>En revisión</option>
              <option value="awaiting_response" ${ticket.status === 'awaiting_response' ? 'selected' : ''}>Esperando respuesta</option>
              <option value="resolved" ${ticket.status === 'resolved' ? 'selected' : ''}>Resuelto</option>
              <option value="closed" ${ticket.status === 'closed' ? 'selected' : ''}>Cerrado</option>
            </select>
            <span class="rounded-lg px-2 py-0.5 text-xs font-medium ${severityColors[ticket.severity] || 'text-gray-400'}">
              ${severityLabels[ticket.severity] || ticket.severity} · ${ticket.category}
            </span>
            ${ticket.isAnonymous ? '<span class="rounded-lg px-2 py-0.5 text-xs font-medium bg-gray-500/20 text-gray-400 border border-gray-500/30">Anónimo</span>' : ''}
          </div>
          <h3 class="text-base font-semibold text-[var(--text-primary)] truncate">${ticket.title}</h3>
          <p class="mt-1 text-sm text-[var(--text-tertiary)] line-clamp-2">${ticket.description}</p>
          <div class="mt-2 flex items-center gap-3 text-xs text-[var(--text-tertiary)]">
            <span>${new Date(ticket.createdAt).toLocaleDateString()}</span>
            <span>·</span>
            <span>Actualizado ${new Date(ticket.updatedAt).toLocaleDateString()}</span>
            ${ticket.reporterName ? `<span>·</span><span>De: ${ticket.reporterName}</span>` : ''}
          </div>
        </div>
        <div class="shrink-0 flex gap-2">
          <button
            class="ticket-detail-btn rounded-lg px-3 py-1.5 text-xs font-medium bg-[var(--surface-3)] text-[var(--text-secondary)] transition-all hover:bg-[var(--surface-4)] hover:text-[var(--text-primary)]"
            data-id="${ticket.id}"
          >
            Detalle
          </button>
        </div>
      </div>
      <!-- Panel detalle -->
      <div class="ticket-detail hidden mt-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)]/50 p-4 backdrop-blur-sm" data-id="${ticket.id}">
        <div class="space-y-3">
          <div class="grid grid-cols-2 gap-3 text-sm">
            <div>
              <p class="text-xs text-[var(--text-tertiary)]">Estado</p>
              <p class="text-[var(--text-primary)] font-medium">${statusLabels[ticket.status] || ticket.status}</p>
            </div>
            <div>
              <p class="text-xs text-[var(--text-tertiary)]">Severidad</p>
              <p class="text-[var(--text-primary)]">${severityLabels[ticket.severity] || ticket.severity}</p>
            </div>
            <div>
              <p class="text-xs text-[var(--text-tertiary)]">Creado</p>
              <p class="text-[var(--text-primary)]">${new Date(ticket.createdAt).toLocaleString()}</p>
            </div>
            <div>
              <p class="text-xs text-[var(--text-tertiary)]">Última actividad</p>
              <p class="text-[var(--text-primary)]">${new Date(ticket.lastActivityAt).toLocaleString()}</p>
            </div>
          </div>
          ${ticket.reporterName ? `
            <div>
              <p class="text-xs text-[var(--text-tertiary)]">Reportero</p>
              <p class="text-[var(--text-primary)]">${ticket.reporterName}</p>
              ${ticket.reporterEmail ? `<p class="text-xs text-[var(--text-tertiary)]">${ticket.reporterEmail}</p>` : ''}
            </div>
          ` : `
            <div class="rounded-lg bg-gray-500/10 border border-gray-500/20 p-3 text-xs text-gray-400">
              Este reporte fue enviado de forma anónima.
            </div>
          `}
          <div>
            <p class="text-xs font-medium text-[var(--text-tertiary)] uppercase tracking-wider">Descripción completa</p>
            <p class="mt-1 text-sm text-[var(--text-secondary)] leading-relaxed">${ticket.description}</p>
          </div>
          ${ticket.adminNotes.length > 0 ? `
            <div>
              <p class="text-xs font-medium text-[var(--text-tertiary)] uppercase tracking-wider">Notas internas (${ticket.adminNotes.length})</p>
              <div class="mt-1 space-y-2">
                ${ticket.adminNotes.map(n => `
                  <div class="rounded-lg bg-[var(--surface-3)] p-3 text-sm">
                    <p class="text-[var(--text-secondary)]">${n.content}</p>
                    <p class="mt-1 text-[10px] text-[var(--text-tertiary)]">${new Date(n.createdAt).toLocaleString()}</p>
                  </div>
                `).join('')}
              </div>
            </div>
          ` : ''}
          ${ticket.adminContactMessages.length > 0 ? `
            <div>
              <p class="text-xs font-medium text-[var(--text-tertiary)] uppercase tracking-wider">Mensajes al reporter (${ticket.adminContactMessages.length})</p>
              <div class="mt-1 space-y-2">
                ${ticket.adminContactMessages.map(m => `
                  <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/20 p-3 text-sm">
                    <p class="text-[var(--text-secondary)]">${m.message}</p>
                    <p class="mt-1 text-[10px] text-[var(--text-tertiary)]">${new Date(m.createdAt).toLocaleString()}</p>
                  </div>
                `).join('')}
              </div>
            </div>
          ` : ''}
          <div class="flex gap-2 pt-2 border-t border-[var(--border-subtle)]">
            <button
              class="ticket-contact-btn rounded-lg px-3 py-1.5 text-xs font-medium bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 transition-all hover:bg-emerald-500/30"
              data-id="${ticket.id}"
              ${ticket.isAnonymous ? 'disabled' : ''}
            >
              ${ticket.isAnonymous ? 'No contactable (anónimo)' : 'Contactar reporter'}
            </button>
            <button
              class="ticket-resolve-btn rounded-lg px-3 py-1.5 text-xs font-medium bg-[var(--brand)]/20 text-[var(--brand)] border border-[var(--brand)]/30 transition-all hover:bg-[var(--brand)]/30"
              data-id="${ticket.id}"
            >
              Resolver ticket
            </button>
          </div>
        </div>
      </div>
    `;

    const detailBtn = card.querySelector('.ticket-detail-btn')!;
    const detailPanel = card.querySelector('.ticket-detail')!;

    detailBtn.addEventListener('click', () => {
      detailPanel.classList.toggle('hidden');
      detailBtn.textContent = detailPanel.classList.contains('hidden') ? 'Detalle' : 'Ocultar';
    });

    // Cambio de estado
    const statusSelect = card.querySelector('.ticket-status-select') as HTMLSelectElement | null;
    statusSelect?.addEventListener('change', async (e) => {
      const newStatus = (e.target as HTMLSelectElement).value;
      const ticketId = statusSelect.dataset.id!;
      try {
        const res = await fetch(`/api/support/update`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'status_change', status: newStatus, ticketId }),
        });
        if (!res.ok) throw new Error('No se pudo actualizar');
        const data = await res.json();
        if (data.success) {
          // Actualizar estado local
          const ticket = allTickets.find(t => t.id === ticketId);
          if (ticket) ticket.status = newStatus;
          showToast(`Estado cambiado a: ${statusLabels[newStatus]}`, 'success');
          // Recargar lista para reflejar cambios
          loadTickets();
        } else {
          showToast('Error al actualizar el estado', 'error');
        }
      } catch (err) {
        showToast('Error de conexión', 'error');
      }
    });

    // Botón contactar
    const contactBtn = card.querySelector('.ticket-contact-btn') as HTMLButtonElement | null;
    if (contactBtn && !ticket.isAnonymous) {
      contactBtn.addEventListener('click', () => {
        const ticketId = contactBtn.dataset.id!;
        const msg = prompt('Mensaje para el reporter:');
        if (msg && msg.trim()) {
          fetch('/api/support/update', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'contact', contactMessage: msg.trim(), ticketId }),
          }).then(res => res.json()).then(data => {
            if (data.success) {
              showToast('Mensaje enviado al reporter', 'success');
              loadTickets();
            } else {
              showToast(data.error || 'Error al enviar mensaje', 'error');
            }
          }).catch(() => showToast('Error de conexión', 'error'));
        }
      });
    }

    // Botón resolver
    const resolveBtn = card.querySelector('.ticket-resolve-btn') as HTMLButtonElement | null;
    resolveBtn?.addEventListener('click', () => {
      const ticketId = resolveBtn.dataset.id!;
      const note = prompt('Nota de resolución (opcional):');
      fetch('/api/support/update', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'resolve', adminNote: note || '', ticketId }),
      }).then(res => res.json()).then(data => {
        if (data.success) {
          showToast('Ticket resuelto', 'success');
          loadTickets();
        } else {
          showToast(data.error || 'Error al resolver', 'error');
        }
      }).catch(() => showToast('Error de conexión', 'error'));
    });

    return card;
  }

  async function loadTickets() {
    try {
      const search = searchInput?.value || '';
      const status = statusFilter?.value || 'all';
      const category = categoryFilter?.value || 'all';
      const severity = severityFilter?.value || 'all';

      const params = new URLSearchParams();
      if (status !== 'all') params.set('status', status);
      if (category !== 'all') params.set('category', category);
      if (severity !== 'all') params.set('severity', severity);
      if (search) params.set('search', search);

      const res = await fetch(`/api/support/create?${params.toString()}`, {
        credentials: 'same-origin',
      });

      if (!res.ok) throw new Error('Error');

      const data = await res.json();
      allTickets = data.tickets || [];

      // Actualizar contadores
      const open = allTickets.filter(t => t.status === 'open').length;
      const review = allTickets.filter(t => t.status === 'in_review').length;
      const resolved = allTickets.filter(t => t.status === 'resolved' || t.status === 'closed').length;

      statOpen.textContent = String(open);
      statReview.textContent = String(review);
      statResolved.textContent = String(resolved);
      statTotal.textContent = String(allTickets.length);

      if (allTickets.length === 0) {
        showEmpty();
        return;
      }

      ticketsList.innerHTML = '';
      allTickets.forEach(ticket => {
        ticketsList.appendChild(renderTicket(ticket));
      });
      showList();
    } catch (err) {
      showEmpty();
      console.error('Error cargando tickets:', err);
    }
  }

  function showToast(message: string, type: 'success' | 'error') {
    const toast = document.createElement('div');
    toast.className = `fixed bottom-4 right-4 rounded-xl px-4 py-3 text-sm font-medium shadow-lg animate-fade-in ${type === 'success' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-red-500/20 text-red-300 border border-red-500/30'}`;
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => {
      toast.classList.add('opacity-0', 'transition-opacity');
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  const cleanup = initPage({
    allowedRoles: ['admin'],
    onReady: () => {
      loadTickets();
    },
  });

  document.addEventListener('astro:before-swap', cleanup);

  // Filtros en tiempo real
  searchInput?.addEventListener('input', debounce(loadTickets, 300));
  statusFilter?.addEventListener('change', loadTickets);
  categoryFilter?.addEventListener('change', loadTickets);
  severityFilter?.addEventListener('change', loadTickets);

  function debounce(fn: Function, delay: number) {
    let timer: ReturnType<typeof setTimeout>;
    return (...args: any[]) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn(...args), delay);
    };
  }
</script>
