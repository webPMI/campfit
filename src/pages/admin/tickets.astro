---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<AdminLayout>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <!-- Header -->
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div>
        <h1 data-i18n="admin.tickets.title" class="text-2xl font-bold">{t('admin.tickets.title')}</h1>
        <p data-i18n="admin.tickets.desc" class="mt-1 text-sm text-[var(--text-tertiary)]">{t('admin.tickets.desc')}</p>
      </div>
      <div class="flex items-center gap-2 text-xs">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5">
          <span id="stat-open" class="font-semibold text-[var(--danger)]">0</span>
          <span class="text-[var(--text-tertiary)]"> {t('admin.tickets.open')}</span>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5">
          <span id="stat-review" class="font-semibold text-[var(--warning)]">0</span>
          <span class="text-[var(--text-tertiary)]"> {t('admin.tickets.inReview')}</span>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5">
          <span id="stat-resolved" class="font-semibold text-[var(--success)]">0</span>
          <span class="text-[var(--text-tertiary)]"> {t('admin.tickets.resolved')}</span>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5">
          <span id="stat-total" class="font-semibold text-[var(--text-primary)]">0</span>
          <span class="text-[var(--text-tertiary)]"> {t('admin.tickets.total')}</span>
        </div>
      </div>
    </div>

    <!-- Filtros -->
    <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-4">
      <!-- Búsqueda -->
      <div class="relative">
        <svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder={t('admin.search')}
          data-i18n-placeholder="admin.search"
          class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] py-2.5 pl-10 pr-4 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm transition-all focus:border-[var(--border-brand)] focus:outline-none focus:ring-1 focus:ring-[var(--brand-dim)]"
        />
      </div>
      <!-- Filtro por estado -->
      <select id="status-filter" class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2.5 text-sm text-[var(--text-secondary)] backdrop-blur-sm">
        <option value="all" data-i18n="admin.all">{t('admin.all')}</option>
        <option value="open" data-i18n="admin.tickets.open">{t('admin.tickets.open')}</option>
        <option value="in_review" data-i18n="admin.tickets.inReview">{t('admin.tickets.inReview')}</option>
        <option value="awaiting_response" data-i18n="admin.tickets.awaiting">{t('admin.tickets.awaiting')}</option>
        <option value="resolved" data-i18n="admin.tickets.resolved">{t('admin.tickets.resolved')}</option>
        <option value="closed" data-i18n="admin.tickets.closed">{t('admin.tickets.closed')}</option>
      </select>
      <!-- Filtro por categoría -->
      <select id="category-filter" class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2.5 text-sm text-[var(--text-secondary)] backdrop-blur-sm">
        <option value="all" data-i18n="admin.all">{t('admin.all')}</option>
        <option value="bug" data-i18n="report.category.bug">{t('report.category.bug')}</option>
        <option value="misconduct" data-i18n="report.category.misconduct">{t('report.category.misconduct')}</option>
        <option value="vulnerability" data-i18n="report.category.vulnerability">{t('report.category.vulnerability')}</option>
        <option value="inquiry" data-i18n="report.category.inquiry">{t('report.category.inquiry')}</option>
        <option value="suggestion" data-i18n="report.category.suggestion">{t('report.category.suggestion')}</option>
        <option value="other" data-i18n="report.category.other">{t('report.category.other')}</option>
      </select>
      <!-- Filtro por severidad -->
      <select id="severity-filter" class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2.5 text-sm text-[var(--text-secondary)] backdrop-blur-sm">
        <option value="all" data-i18n="admin.all">{t('admin.all')}</option>
        <option value="critical" data-i18n="report.severity.critical">{t('report.severity.critical')}</option>
        <option value="high" data-i18n="report.severity.high">{t('report.severity.high')}</option>
        <option value="medium" data-i18n="report.severity.medium">{t('report.severity.medium')}</option>
        <option value="low" data-i18n="report.severity.low">{t('report.severity.low')}</option>
      </select>
    </div>

    <!-- Lista de tickets -->
    <div class="mt-4 space-y-3">
      <!-- Skeleton carga -->
      <div id="loading-skeleton" class="grid grid-cols-1 gap-3">
        {[1, 2, 3].map(() => `
          <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-5 animate-pulse">
            <div class="flex gap-4">
              <div class="h-3 w-24 rounded bg-[var(--surface-3)]"></div>
              <div class="h-3 w-16 rounded bg-[var(--surface-3)]"></div>
              <div class="h-3 w-20 rounded bg-[var(--surface-3)]"></div>
              <div class="flex-1"></div>
            </div>
          </div>
        `).join('')}
      </div>

      <!-- Contenedor vacío -->
      <div id="empty-state" class="hidden rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-8 text-center">
        <svg class="mx-auto h-12 w-12 text-[var(--text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 1.25L17.5 11.25l-2.25 2.25L12 13.5l-4.5 4.5L7.5 18l-1.5-1.5L10.5 10.5L6 6l1.25-1.25L11.25 7.5l2.25-2.25L15.75 4.5l4.5-4.5L18 3l1.5 1.5L12 10.5l4.5 4.5 3 3 1.5-1.5-1.25-1.25L12 7.5Z" />
        </svg>
        <p data-i18n="admin.tickets.empty" class="mt-3 text-lg font-semibold text-[var(--text-primary)]">{t('admin.tickets.empty')}</p>
        <p data-i18n="admin.tickets.emptyDesc" class="mt-1 text-sm text-[var(--text-tertiary)]">{t('admin.tickets.emptyDesc')}</p>
      </div>

      <!-- Lista -->
      <div id="tickets-list" class="hidden space-y-3"></div>
    </div>
  </div>

  <!-- Modal Contactar Reporter -->
  <div id="contact-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md hidden animate-fade-in">
    <div class="relative w-full max-w-md rounded-2xl border border-[var(--border-default)] bg-[var(--surface-2)] p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
        <h3 class="text-sm font-bold text-[var(--text-primary)]">💬 Enviar Mensaje al Reporter</h3>
        <button id="btn-close-contact-modal" class="text-zinc-400 hover:text-white text-lg font-bold">&times;</button>
      </div>
      <div class="space-y-3">
        <p class="text-xs text-[var(--text-tertiary)]" id="contact-modal-subtitle">Escribe un mensaje de respuesta para el usuario.</p>
        <textarea
          id="contact-message-input"
          rows="4"
          placeholder="Escribe aquí tu mensaje de respuesta oficial..."
          class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-3 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand)] resize-none"
        ></textarea>
      </div>
      <div class="flex items-center gap-2 pt-2 border-t border-[var(--border-subtle)]">
        <button
          id="btn-confirm-send-contact"
          class="flex-1 rounded-xl bg-emerald-500 hover:bg-emerald-600 px-4 py-2 text-xs font-bold text-white shadow-md transition-all active:scale-95"
        >
          Enviar Mensaje
        </button>
        <button
          id="btn-cancel-contact"
          class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-4)] px-4 py-2 text-xs font-semibold text-[var(--text-secondary)] hover:text-white"
        >
          Cancelar
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Resolver Ticket -->
  <div id="resolve-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md hidden animate-fade-in">
    <div class="relative w-full max-w-md rounded-2xl border border-[var(--border-default)] bg-[var(--surface-2)] p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
        <h3 class="text-sm font-bold text-[var(--text-primary)]">✅ Resolver Ticket</h3>
        <button id="btn-close-resolve-modal" class="text-zinc-400 hover:text-white text-lg font-bold">&times;</button>
      </div>
      <div class="space-y-3">
        <p class="text-xs text-[var(--text-tertiary)]">Añade una nota interna de resolución (opcional).</p>
        <textarea
          id="resolve-note-input"
          rows="3"
          placeholder="Ej: Problema solucionado tras reiniciar el servicio..."
          class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-3 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand)] resize-none"
        ></textarea>
      </div>
      <div class="flex items-center gap-2 pt-2 border-t border-[var(--border-subtle)]">
        <button
          id="btn-confirm-resolve"
          class="flex-1 rounded-xl bg-[var(--brand)] hover:bg-[var(--brand-hover)] px-4 py-2 text-xs font-bold text-[var(--text-on-brand)] shadow-md transition-all active:scale-95"
        >
          Marcar como Resuelto
        </button>
        <button
          id="btn-cancel-resolve"
          class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-4)] px-4 py-2 text-xs font-semibold text-[var(--text-secondary)] hover:text-white"
        >
          Cancelar
        </button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { initPage } from '@/lib/shared/initPage';
  import {
    subscribeToAllSupportTickets,
    updateSupportTicketStatus,
    sendAdminContactMessage,
    type SupportTicket,
    type TicketStatus,
  } from '@/lib/support/supportTicketService';
  import { showToast } from '@/lib/shared/ui';

  const loadingSkeleton = document.getElementById('loading-skeleton')!;
  const emptyState = document.getElementById('empty-state')!;
  const ticketsList = document.getElementById('tickets-list')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const statusFilter = document.getElementById('status-filter') as HTMLSelectElement | null;
  const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement | null;
  const severityFilter = document.getElementById('severity-filter') as HTMLSelectElement | null;

  const statOpen = document.getElementById('stat-open')!;
  const statReview = document.getElementById('stat-review')!;
  const statResolved = document.getElementById('stat-resolved')!;
  const statTotal = document.getElementById('stat-total')!;

  // Modales
  const contactModal = document.getElementById('contact-modal')!;
  const contactMessageInput = document.getElementById('contact-message-input') as HTMLTextAreaElement;
  const btnCloseContactModal = document.getElementById('btn-close-contact-modal')!;
  const btnCancelContact = document.getElementById('btn-cancel-contact')!;
  const btnConfirmSendContact = document.getElementById('btn-confirm-send-contact')!;

  const resolveModal = document.getElementById('resolve-modal')!;
  const resolveNoteInput = document.getElementById('resolve-note-input') as HTMLTextAreaElement;
  const btnCloseResolveModal = document.getElementById('btn-close-resolve-modal')!;
  const btnCancelResolve = document.getElementById('btn-cancel-resolve')!;
  const btnConfirmResolve = document.getElementById('btn-confirm-resolve')!;

  let selectedTicketId: string | null = null;
  let allTickets: SupportTicket[] = [];
  let currentAdminEmail = '';
  let unsubTickets: (() => void) | null = null;

  function showEmpty() {
    loadingSkeleton.classList.add('hidden');
    ticketsList.classList.add('hidden');
    emptyState.classList.remove('hidden');
  }

  function showList() {
    loadingSkeleton.classList.add('hidden');
    ticketsList.classList.remove('hidden');
    emptyState.classList.add('hidden');
  }

  function formatDate(val: any): string {
    if (!val) return 'Reciente';
    if (typeof val.toDate === 'function') return val.toDate().toLocaleDateString();
    if (typeof val === 'string' || typeof val === 'number') return new Date(val).toLocaleDateString();
    return 'Reciente';
  }

  function formatDateTime(val: any): string {
    if (!val) return 'Reciente';
    if (typeof val.toDate === 'function') return val.toDate().toLocaleString();
    if (typeof val === 'string' || typeof val === 'number') return new Date(val).toLocaleString();
    return 'Reciente';
  }

  function renderTicket(ticket: SupportTicket) {
    const statusColors: Record<string, string> = {
      open: 'bg-amber-500/20 text-amber-400 border-amber-500/30',
      in_review: 'bg-blue-500/20 text-blue-400 border-blue-500/30',
      awaiting_response: 'bg-purple-500/20 text-purple-400 border-purple-500/30',
      resolved: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30',
      closed: 'bg-gray-500/20 text-gray-400 border-gray-500/30',
    };
    const statusLabels: Record<string, string> = {
      open: 'Abierto',
      in_review: 'En revisión',
      awaiting_response: 'Esperando respuesta',
      resolved: 'Resuelto',
      closed: 'Cerrado',
    };
    const severityLabels: Record<string, string> = {
      low: 'Baja',
      medium: 'Media',
      high: 'Alta',
      critical: 'Crítica',
    };
    const severityColors: Record<string, string> = {
      low: 'text-gray-400',
      medium: 'text-amber-400',
      high: 'text-orange-400',
      critical: 'text-red-400',
    };

    const card = document.createElement('div');
    card.className = 'rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-5 backdrop-blur-xl transition-all hover:border-[var(--border-brand)]/50';
    card.dataset.id = ticket.id;
    card.innerHTML = `
      <div class="flex items-start justify-between gap-4 flex-wrap sm:flex-nowrap">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1 flex-wrap">
            <select
              class="ticket-status-select rounded-lg px-2 py-0.5 text-xs font-semibold border focus:border-[var(--brand)] focus:outline-none ${statusColors[ticket.status] || 'bg-gray-500/20 text-gray-400 border-gray-500/30'}"
              data-id="${ticket.id}"
            >
              <option value="open" ${ticket.status === 'open' ? 'selected' : ''}>Abierto</option>
              <option value="in_review" ${ticket.status === 'in_review' ? 'selected' : ''}>En revisión</option>
              <option value="awaiting_response" ${ticket.status === 'awaiting_response' ? 'selected' : ''}>Esperando respuesta</option>
              <option value="resolved" ${ticket.status === 'resolved' ? 'selected' : ''}>Resuelto</option>
              <option value="closed" ${ticket.status === 'closed' ? 'selected' : ''}>Cerrado</option>
            </select>
            <span class="rounded-lg px-2 py-0.5 text-xs font-medium ${severityColors[ticket.severity] || 'text-gray-400'}">
              ${severityLabels[ticket.severity] || ticket.severity} · ${ticket.category}
            </span>
            ${ticket.isAnonymous ? '<span class="rounded-lg px-2 py-0.5 text-xs font-medium bg-gray-500/20 text-gray-400 border border-gray-500/30">Anónimo</span>' : ''}
          </div>
          <h3 class="text-base font-semibold text-[var(--text-primary)] truncate">${ticket.title}</h3>
          <p class="mt-1 text-sm text-[var(--text-tertiary)] line-clamp-2">${ticket.description}</p>
          <div class="mt-2 flex items-center gap-3 text-xs text-[var(--text-tertiary)] flex-wrap">
            <span>Creado: ${formatDate(ticket.createdAt)}</span>
            <span>·</span>
            <span>Actualizado: ${formatDate(ticket.lastActivityAt || ticket.updatedAt)}</span>
            ${ticket.reporterName ? `<span>·</span><span>De: ${ticket.reporterName}</span>` : ''}
          </div>
        </div>
        <div class="shrink-0 flex items-center gap-2">
          <button
            class="ticket-copy-agent-btn rounded-lg px-2.5 py-1.5 text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 transition-all hover:bg-indigo-500/30 flex items-center gap-1 shadow-sm"
            data-id="${ticket.id}"
            title="Copiar reporte formateado para pasar a agentes de desarrollo"
          >
            📋 Copiar para Agente AI
          </button>
          <button
            class="ticket-detail-btn rounded-lg px-3 py-1.5 text-xs font-medium bg-[var(--surface-3)] text-[var(--text-secondary)] transition-all hover:bg-[var(--surface-4)] hover:text-[var(--text-primary)]"
            data-id="${ticket.id}"
          >
            Detalle
          </button>
        </div>
      </div>
      <!-- Panel detalle -->
      <div class="ticket-detail hidden mt-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)]/50 p-4 backdrop-blur-sm space-y-3" data-id="${ticket.id}">
        <div class="space-y-3">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div>
              <p class="text-[10px] text-[var(--text-tertiary)]">Estado</p>
              <p class="text-[var(--text-primary)] font-medium">${statusLabels[ticket.status] || ticket.status}</p>
            </div>
            <div>
              <p class="text-[10px] text-[var(--text-tertiary)]">Severidad</p>
              <p class="text-[var(--text-primary)]">${severityLabels[ticket.severity] || ticket.severity}</p>
            </div>
            <div>
              <p class="text-[10px] text-[var(--text-tertiary)]">Creado</p>
              <p class="text-[var(--text-primary)]">${formatDateTime(ticket.createdAt)}</p>
            </div>
            <div>
              <p class="text-[10px] text-[var(--text-tertiary)]">Última actividad</p>
              <p class="text-[var(--text-primary)]">${formatDateTime(ticket.lastActivityAt || ticket.updatedAt)}</p>
            </div>
          </div>
          ${ticket.reporterName ? `
            <div>
              <p class="text-[10px] text-[var(--text-tertiary)]">Reportero</p>
              <p class="text-xs text-[var(--text-primary)]">${ticket.reporterName} ${ticket.reporterEmail ? `(${ticket.reporterEmail})` : ''} · <span class="font-mono text-[10px] text-[var(--text-tertiary)]">UID: ${ticket.reporterUid}</span></p>
            </div>
          ` : `
            <div class="rounded-lg bg-gray-500/10 border border-gray-500/20 p-2.5 text-xs text-gray-400">
              Este reporte fue enviado de forma anónima.
            </div>
          `}
          <div>
            <p class="text-[10px] font-medium text-[var(--text-tertiary)] uppercase tracking-wider">Descripción completa</p>
            <p class="mt-1 text-xs text-[var(--text-secondary)] leading-relaxed">${ticket.description}</p>
          </div>
          ${ticket.snapshotData ? `
            <div class="rounded-xl border border-indigo-500/20 bg-indigo-500/5 p-3 space-y-1.5">
              <div class="flex items-center justify-between">
                <p class="text-[10px] font-bold text-indigo-400 uppercase tracking-wider flex items-center gap-1">
                  <span>🧬</span> Telemetría y Contexto Técnico Capturado
                </p>
                <span class="rounded bg-indigo-500/20 px-1.5 py-0.5 text-[9px] font-mono text-indigo-300 font-bold">
                  ${(ticket.snapshotData as any).appVersion || 'v0.011'}
                </span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] text-[var(--text-secondary)]">
                <div><b>URL:</b> <span class="font-mono text-[10px] text-cyan-300 truncate block">${(ticket.snapshotData as any).currentUrl || 'N/A'}</span></div>
                <div><b>Resolución:</b> <span>${(ticket.snapshotData as any).screenResolution || 'N/A'}</span></div>
                <div><b>Rol Usuario:</b> <span class="capitalize">${(ticket.snapshotData as any).userRole || 'client'}</span></div>
                <div><b>Conexión / RAM:</b> <span>${(ticket.snapshotData as any).connectionType || 'N/A'} • ${(ticket.snapshotData as any).deviceMemory || 'N/A'}</span></div>
                <div class="sm:col-span-2"><b>User-Agent:</b> <span class="font-mono text-[9px] text-[var(--text-tertiary)] block truncate">${(ticket.snapshotData as any).userAgent || 'N/A'}</span></div>
              </div>
            </div>
          ` : ''}
          ${ticket.adminNotes && ticket.adminNotes.length > 0 ? `
            <div>
              <p class="text-[10px] font-medium text-[var(--text-tertiary)] uppercase tracking-wider">Notas internas (${ticket.adminNotes.length})</p>
              <div class="mt-1 space-y-1.5">
                ${ticket.adminNotes.map(n => `
                  <div class="rounded-lg bg-[var(--surface-3)] p-2.5 text-xs text-zinc-300">
                    <p>${n.content}</p>
                    <p class="mt-1 text-[10px] text-zinc-500">${formatDateTime(n.createdAt)}</p>
                  </div>
                `).join('')}
              </div>
            </div>
          ` : ''}
          ${ticket.adminContactMessages && ticket.adminContactMessages.length > 0 ? `
            <div>
              <p class="text-[10px] font-medium text-[var(--text-tertiary)] uppercase tracking-wider">Mensajes de contacto (${ticket.adminContactMessages.length})</p>
              <div class="mt-1 space-y-1.5">
                ${ticket.adminContactMessages.map(m => `
                  <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/20 p-2.5 text-xs text-emerald-200">
                    <p>${m.message}</p>
                    <p class="mt-1 text-[10px] text-emerald-400/70">${formatDateTime(m.createdAt)}</p>
                  </div>
                `).join('')}
              </div>
            </div>
          ` : ''}
          <div class="flex gap-2 pt-2 border-t border-[var(--border-subtle)] flex-wrap">
            <button
              class="ticket-contact-btn rounded-lg px-3 py-1.5 text-xs font-medium bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 transition-all hover:bg-emerald-500/30 disabled:opacity-40"
              data-id="${ticket.id}"
              ${ticket.isAnonymous ? 'disabled' : ''}
            >
              ${ticket.isAnonymous ? 'No contactable (anónimo)' : '💬 Contactar reporter'}
            </button>
            <button
              class="ticket-resolve-btn rounded-lg px-3 py-1.5 text-xs font-medium bg-[var(--brand-dim)] text-[var(--brand)] border border-[var(--border-brand)] transition-all hover:bg-[var(--brand)] hover:text-white"
              data-id="${ticket.id}"
            >
              ✅ Resolver ticket
            </button>
          </div>
        </div>
      </div>
    `;

    const detailBtn = card.querySelector('.ticket-detail-btn')!;
    const detailPanel = card.querySelector('.ticket-detail')!;

    detailBtn.addEventListener('click', () => {
      detailPanel.classList.toggle('hidden');
      detailBtn.textContent = detailPanel.classList.contains('hidden') ? 'Detalle' : 'Ocultar';
    });

    // Botón Copiar para Agente AI
    const copyAgentBtn = card.querySelector('.ticket-copy-agent-btn');
    copyAgentBtn?.addEventListener('click', async () => {
      const snap = ticket.snapshotData as any;
      const markdownPrompt = [
        `🚨 [INCIDENCIA DE USUARIO / TICKET SOPORTE]`,
        `- **Ticket ID:** #${ticket.id}`,
        `- **Título:** ${ticket.title}`,
        `- **Categoría / Severidad:** ${ticket.category.toUpperCase()} | ${ticket.severity.toUpperCase()}`,
        `- **Estado Actual:** ${ticket.status.toUpperCase()}`,
        `- **Usuario:** ${ticket.reporterName || 'Anónimo'} (${ticket.reporterEmail || 'N/A'}) - UID: \`${ticket.reporterUid || 'N/A'}\``,
        `- **Fecha:** ${formatDateTime(ticket.createdAt)}`,
        ``,
        `### 📝 Descripción del Problema:`,
        `${ticket.description}`,
        ``,
        `### 🔍 Contexto Técnico y Telemetría:`,
        snap ? `- **App Version:** ${snap.appVersion || 'v0.011'}
- **URL donde ocurrió:** ${snap.currentUrl || 'N/A'}
- **Rol:** ${snap.userRole || 'client'}
- **Dispositivo / SO / Browser:** \`${snap.userAgent || 'N/A'}\`
- **Resolución:** ${snap.screenResolution || 'N/A'}
- **Conexión / Memoria:** ${snap.connectionType || 'N/A'} • ${snap.deviceMemory || 'N/A'}
- **Timestamp ISO:** ${snap.timestampIso || 'N/A'}` : `- Sin telemetría adicional.`,
      ].join('\n');

      try {
        await navigator.clipboard.writeText(markdownPrompt);
        showToast({ message: '📋 Resumen copiado al portapapeles para el Agente AI', type: 'success' });
      } catch {
        showToast({ message: 'No se pudo copiar automáticamente', type: 'error' });
      }
    });

    // Cambio de estado
    const statusSelect = card.querySelector('.ticket-status-select') as HTMLSelectElement | null;
    statusSelect?.addEventListener('change', async (e) => {
      const newStatus = (e.target as HTMLSelectElement).value as TicketStatus;
      const ticketId = statusSelect.dataset.id!;
      const success = await updateSupportTicketStatus(ticketId, newStatus, undefined, ticket.adminNotes);
      if (success) {
        showToast({ message: `Estado cambiado a: ${statusLabels[newStatus]}`, type: 'success' });
      } else {
        showToast({ message: 'Error al actualizar el estado', type: 'error' });
      }
    });

    // Botón contactar (Abre modal custom)
    const contactBtn = card.querySelector('.ticket-contact-btn') as HTMLButtonElement | null;
    if (contactBtn && !ticket.isAnonymous) {
      contactBtn.addEventListener('click', () => {
        selectedTicketId = ticket.id;
        contactMessageInput.value = '';
        contactModal.classList.remove('hidden');
      });
    }

    // Botón resolver (Abre modal custom)
    const resolveBtn = card.querySelector('.ticket-resolve-btn') as HTMLButtonElement | null;
    resolveBtn?.addEventListener('click', () => {
      selectedTicketId = ticket.id;
      resolveNoteInput.value = '';
      resolveModal.classList.remove('hidden');
    });

    return card;
  }

  // Modal contact listeners
  btnCloseContactModal?.addEventListener('click', () => contactModal.classList.add('hidden'));
  btnCancelContact?.addEventListener('click', () => contactModal.classList.add('hidden'));
  btnConfirmSendContact?.addEventListener('click', async () => {
    if (!selectedTicketId) return;
    const msg = contactMessageInput.value.trim();
    if (!msg) {
      showToast({ message: 'Escribe un mensaje antes de enviar', type: 'info' });
      return;
    }
    const currentTicket = allTickets.find(t => t.id === selectedTicketId);
    const success = await sendAdminContactMessage(selectedTicketId, msg, currentAdminEmail, currentTicket?.adminContactMessages);
    if (success) {
      showToast({ message: 'Mensaje enviado al reporter con éxito', type: 'success' });
      contactModal.classList.add('hidden');
    } else {
      showToast({ message: 'Error al enviar mensaje', type: 'error' });
    }
  });

  // Modal resolve listeners
  btnCloseResolveModal?.addEventListener('click', () => resolveModal.classList.add('hidden'));
  btnCancelResolve?.addEventListener('click', () => resolveModal.classList.add('hidden'));
  btnConfirmResolve?.addEventListener('click', async () => {
    if (!selectedTicketId) return;
    const note = resolveNoteInput.value.trim();
    const currentTicket = allTickets.find(t => t.id === selectedTicketId);
    const success = await updateSupportTicketStatus(selectedTicketId, 'resolved', note, currentTicket?.adminNotes);
    if (success) {
      showToast({ message: 'Ticket marcado como resuelto', type: 'success' });
      resolveModal.classList.add('hidden');
    } else {
      showToast({ message: 'Error al resolver ticket', type: 'error' });
    }
  });

  function applyFiltersAndRender() {
    const search = (searchInput?.value || '').toLowerCase().trim();
    const status = statusFilter?.value || 'all';
    const category = categoryFilter?.value || 'all';
    const severity = severityFilter?.value || 'all';

    const filtered = allTickets.filter((t) => {
      if (status !== 'all' && t.status !== status) return false;
      if (category !== 'all' && t.category !== category) return false;
      if (severity !== 'all' && t.severity !== severity) return false;
      if (search) {
        const matchesTitle = (t.title || '').toLowerCase().includes(search);
        const matchesDesc = (t.description || '').toLowerCase().includes(search);
        const matchesName = (t.reporterName || '').toLowerCase().includes(search);
        if (!matchesTitle && !matchesDesc && !matchesName) return false;
      }
      return true;
    });

    // Actualizar contadores
    const open = allTickets.filter(t => t.status === 'open').length;
    const review = allTickets.filter(t => t.status === 'in_review' || t.status === 'awaiting_response').length;
    const resolved = allTickets.filter(t => t.status === 'resolved' || t.status === 'closed').length;

    statOpen.textContent = String(open);
    statReview.textContent = String(review);
    statResolved.textContent = String(resolved);
    statTotal.textContent = String(allTickets.length);

    if (filtered.length === 0) {
      showEmpty();
      return;
    }

    ticketsList.innerHTML = '';
    filtered.forEach(ticket => {
      ticketsList.appendChild(renderTicket(ticket));
    });
    showList();
  }

  const cleanup = initPage({
    allowedRoles: ['admin'],
    onReady: async (firebaseUser, userData) => {
      currentAdminEmail = userData?.email || firebaseUser?.email || '';

      unsubTickets = subscribeToAllSupportTickets(
        (tickets) => {
          allTickets = tickets;
          applyFiltersAndRender();
        },
        (err) => {
          console.error('Error cargando tickets:', err);
          showEmpty();
        }
      );
    },
  });

  document.addEventListener('astro:before-swap', () => {
    cleanup();
    unsubTickets?.();
  });

  // Filtros en tiempo real
  searchInput?.addEventListener('input', () => applyFiltersAndRender());
  statusFilter?.addEventListener('change', () => applyFiltersAndRender());
  categoryFilter?.addEventListener('change', () => applyFiltersAndRender());
  severityFilter?.addEventListener('change', () => applyFiltersAndRender());
</script>
