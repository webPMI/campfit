---
import PublicPageLayout from '@/layouts/PublicPageLayout.astro';
import UILogoIcon from '@/components/UILogoIcon.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<PublicPageLayout currentPath="/recover">
  <div class="w-full max-w-sm animate-fade-in">
    <!-- Logo -->
    <div class="mb-8 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-[var(--brand-hover)] to-[var(--brand)] shadow-lg shadow-[var(--shadow-glow-sm)]">
        <UILogoIcon size="h-7 w-7" class="text-[var(--text-on-brand)]" />
      </div>
      <h1 class="text-2xl font-bold tracking-tight">{t('app.name')}</h1>
      <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t('app.tagline')}</p>
    </div>

    <!-- Card -->
    <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-8 backdrop-blur-xl">
      <h2 class="mb-2 text-center text-lg font-semibold">Recuperar Contraseña</h2>
      <p class="mb-8 text-center text-sm text-[var(--text-tertiary)]">Te enviaremos un enlace para restablecer tu contraseña</p>

      <!-- Formulario -->
      <form id="recoverForm" class="flex flex-col gap-5">
        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium text-[var(--text-secondary)]">{t('auth.email')}</label>
          <input
            id="email"
            type="email"
            placeholder={t('auth.email.placeholder')}
            required
            autocomplete="email"
            class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:bg-[var(--surface-3)] focus:ring-2 focus:ring-[var(--brand-dim)]"
          />
        </div>

        <button
          id="recoverBtn"
          type="submit"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand)] px-6 py-3 text-sm font-semibold text-[var(--text-on-brand)] shadow-lg shadow-[var(--shadow-glow-sm)] transition-all hover:from-[var(--brand-hover)] hover:to-[var(--brand)] hover:shadow-[var(--shadow-glow-md)] active:scale-[0.98]"
        >
          Enviar Enlace
        </button>
      </form>

      <!-- Success -->
      <div id="successMsg" class="mt-5 hidden items-center gap-2 rounded-xl bg-[var(--brand-dim)] border border-[var(--border-brand)] px-4 py-3 text-sm text-[var(--brand)]">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        <span id="successText">Revisa tu correo para restablecer tu contraseña</span>
      </div>

      <!-- Error -->
      <div id="errorMsg" class="mt-5 hidden items-center gap-2 rounded-xl bg-[var(--danger-dim)] border border-[var(--danger)] px-4 py-3 text-sm text-[var(--danger)]">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
        </svg>
        <span id="errorText"></span>
      </div>
    </div>

    <p class="mt-8 text-center text-sm text-[var(--text-disabled)]">
      <a href={`/login?lang=${lang}`} class="font-medium text-[var(--brand)] transition-colors hover:text-[var(--brand-hover)]">Volver a Iniciar Sesión</a>
    </p>
  </div>
</PublicPageLayout>

<script>
  import { authService } from '@/services/authService';
  import { isValidEmail } from '@/lib/validators';
  import { getStoredLanguage, t } from '@/i18n/client';
  import type { FirebaseError } from 'firebase/app';
  import { getAuth, onAuthStateChanged } from 'firebase/auth';
  import { getFirestore, doc, getDoc } from 'firebase/firestore';

  // Detectar sesion existente
  onAuthStateChanged(getAuth(), async (u) => {
    if (u) {
      const snap = await getDoc(doc(getFirestore(), 'users', u.uid));
      if (snap.exists()) {
        const role = snap.data().role || 'client';
        const routes: Record<string, string> = { admin: '/admin/dashboard', trainer: '/trainer/dashboard', client: '/client/dashboard' };
        window.location.href = routes[role] || '/client/dashboard';
      }
    }
  });

  const emailInput = document.getElementById('email') as HTMLInputElement;
  const recoverForm = document.getElementById('recoverForm') as HTMLFormElement;
  const recoverBtn = document.getElementById('recoverBtn') as HTMLButtonElement;
  const errorMsg = document.getElementById('errorMsg') as HTMLDivElement;
  const errorText = document.getElementById('errorText') as HTMLSpanElement;
  const successMsg = document.getElementById('successMsg') as HTMLDivElement;
  const successText = document.getElementById('successText') as HTMLSpanElement;

  function showError(msg: string) {
    successMsg.classList.add('hidden');
    successMsg.classList.remove('flex');
    errorText.textContent = msg;
    errorMsg.classList.remove('hidden');
    errorMsg.classList.add('flex');
  }

  function showSuccess(msg: string) {
    errorMsg.classList.add('hidden');
    errorMsg.classList.remove('flex');
    successText.textContent = msg;
    successMsg.classList.remove('hidden');
    successMsg.classList.add('flex');
  }

  function hideAll() {
    errorMsg.classList.add('hidden');
    errorMsg.classList.remove('flex');
    successMsg.classList.add('hidden');
    successMsg.classList.remove('flex');
  }

  recoverForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAll();

    const email = emailInput.value.trim();

    if (!email) {
      showError(t('error.required'));
      return;
    }

    if (!isValidEmail(email)) {
      showError(t('error.invalid-email'));
      return;
    }

    recoverBtn.disabled = true;
    recoverBtn.innerHTML = `<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg> Enviando...`;

    try {
      await authService.recoverPassword(email);
      showSuccess('Revisa tu correo para restablecer tu contraseña');
      emailInput.value = '';
    } catch (err: unknown) {
      const fbErr = err as FirebaseError & { message?: string };
      const code = fbErr.code || fbErr.message || '';
      const messages: Record<string, string> = {
        'auth/user-not-found': 'No existe una cuenta con este email',
        'auth/invalid-email': 'Email inválido',
        'auth/too-many-requests': 'Demasiados intentos. Intenta más tarde',
      };
      showError(messages[code] || 'Error al enviar el correo de recuperación');
    } finally {
      recoverBtn.disabled = false;
      recoverBtn.textContent = 'Enviar Enlace';
    }
  });
</script>
