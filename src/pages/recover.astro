---
import PublicPageLayout from '@/layouts/PublicPageLayout.astro';
import UICard from '@/components/UICard.astro';
import UILogoIcon from '@/components/UILogoIcon.astro';
import { translations, type Language } from '@/i18n/translations';

import { getLangFromRequest } from '@/lib/i18n/server';
const lang = getLangFromRequest(Astro) as Language;
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<PublicPageLayout currentPath="/recover">
  <div class="w-full max-w-sm animate-fade-in">
    <!-- Logo -->
    <div class="mb-8 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-[var(--brand-hover)] to-[var(--brand)] shadow-lg shadow-[var(--shadow-glow-sm)]">
        <UILogoIcon size="h-7 w-7" class="text-[var(--text-on-brand)]" />
      </div>
      <h1 data-i18n="app.name" class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">{t('app.name')}</h1>
      <p data-i18n="app.tagline" class="mt-1 text-sm text-[var(--text-tertiary)]">{t('app.tagline')}</p>
    </div>

    <!-- Card -->
    <UICard variant="elevated" padding="md" class="animate-pulse-glow">
      <h2 data-i18n="recover.title" class="mb-2 text-center text-lg font-semibold text-[var(--text-primary)]">{t('recover.title')}</h2>
      <p data-i18n="recover.description" class="mb-8 text-center text-sm text-[var(--text-tertiary)]">{t('recover.description')}</p>

      <!-- Formulario -->
      <form id="recoverForm" class="flex flex-col gap-4">
        <div>
          <label for="email" data-i18n="auth.email" class="mb-1.5 block text-sm font-medium text-[var(--text-secondary)]">{t('auth.email')}</label>
          <div class="relative">
            <input
              id="email"
              type="email"
              placeholder={t('auth.email.placeholder')}
              data-i18n-placeholder="auth.email.placeholder"
              required
              autocomplete="email"
              aria-describedby="emailHelp"
              class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-4 py-2.5 pr-10 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all duration-200 focus:border-[var(--brand)] focus:bg-[var(--surface-3)] focus:shadow-[0_0_0_3px_var(--brand-dim)]"
            />
            <svg id="emailCheck" class="hidden absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--success)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <p id="emailHelp" data-i18n="auth.help.email" class="mt-1 text-xs text-[var(--text-tertiary)]">{t('auth.help.email')}</p>
          <p id="emailError" class="mt-1 hidden text-xs text-[var(--danger)]"></p>
        </div>

        <button
          id="recoverBtn"
          type="submit"
          data-i18n="recover.btn"
          class="mt-2 flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-6 py-3 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all duration-200 hover:shadow-[var(--shadow-glow-md)] hover:brightness-105 active:scale-[0.98] disabled:opacity-50 disabled:pointer-events-none"
        >
          {t('recover.btn')}
        </button>
      </form>

      <!-- Success -->
      <div id="successMsg" class="mt-5 hidden items-center gap-2 rounded-xl bg-[var(--success-dim)] border border-[var(--success)] px-4 py-3 text-sm text-[var(--success)]">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        <span id="successText"></span>
      </div>

      <!-- Error -->
      <div id="errorMsg" class="mt-5 hidden items-center gap-2 rounded-xl bg-[var(--danger-dim)] border border-[var(--danger)] px-4 py-3 text-sm text-[var(--danger)]">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
        </svg>
        <span id="errorText"></span>
      </div>
    </UICard>

    <p class="mt-8 text-center text-sm text-[var(--text-tertiary)]">
      <a href="/login" data-i18n="recover.back" class="font-medium text-[var(--brand)] transition-colors duration-200 hover:text-[var(--brand-hover)]">{t('recover.back')}</a>
    </p>
  </div>
</PublicPageLayout>

<script>
  import { authService } from '@/services/authService';
  import { isValidEmail } from '@/lib/validators';
  import { t } from '@/i18n/client';
  import type { FirebaseError } from 'firebase/app';

  const emailInput = document.getElementById('email') as HTMLInputElement;
  const recoverForm = document.getElementById('recoverForm') as HTMLFormElement;
  const recoverBtn = document.getElementById('recoverBtn') as HTMLButtonElement;
  const errorMsg = document.getElementById('errorMsg') as HTMLDivElement;
  const errorText = document.getElementById('errorText') as HTMLSpanElement;
  const successMsg = document.getElementById('successMsg') as HTMLDivElement;
  const successText = document.getElementById('successText') as HTMLSpanElement;
  const emailCheck = document.getElementById('emailCheck');
  const emailError = document.getElementById('emailError') as HTMLParagraphElement;

  function showError(msg: string) {
    successMsg.classList.add('hidden');
    successMsg.classList.remove('flex');
    errorText.textContent = msg;
    errorMsg.classList.remove('hidden');
    errorMsg.classList.add('flex');
  }

  function showSuccess(msg: string) {
    errorMsg.classList.add('hidden');
    errorMsg.classList.remove('flex');
    successText.textContent = msg;
    successMsg.classList.remove('hidden');
    successMsg.classList.add('flex');
  }

  function hideAll() {
    errorMsg.classList.add('hidden');
    errorMsg.classList.remove('flex');
    successMsg.classList.add('hidden');
    successMsg.classList.remove('flex');
    emailError.classList.add('hidden');
  }

  // Validación de email en tiempo real
  emailInput.addEventListener('input', (e) => {
    const email = (e.target as HTMLInputElement).value.trim();
    if (email && isValidEmail(email)) {
      emailCheck?.classList.remove('hidden');
    } else {
      emailCheck?.classList.add('hidden');
    }
  });

  recoverForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAll();

    const email = emailInput.value.trim();

    if (!email) {
      emailError.textContent = t('auth.email.error.required');
      emailError.classList.remove('hidden');
      return;
    }

    if (!isValidEmail(email)) {
      emailError.textContent = t('auth.email.error.invalid');
      emailError.classList.remove('hidden');
      return;
    }

    recoverBtn.disabled = true;
    recoverBtn.innerHTML = `<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg> ${t('recover.loading')}`;

    try {
      await authService.recoverPassword(email);
      showSuccess(t('recover.success'));
      emailInput.value = '';
    } catch (err: unknown) {
      const fbErr = err as FirebaseError & { message?: string };
      const code = fbErr.code || fbErr.message || '';
      const messages: Record<string, string> = {
        'auth/user-not-found': t('error.user-not-found'),
        'auth/invalid-email': t('error.invalid-email'),
        'auth/too-many-requests': t('error.too-many-requests'),
      };
      showError(messages[code] || t('error.recover.default'));
    } finally {
      recoverBtn.disabled = false;
      recoverBtn.textContent = t('recover.btn');
    }
  });
</script>