---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<BaseLayout>
  <div class="flex min-h-screen flex-col items-center justify-center px-4 py-12">
    <div class="text-center animate-fade-in">
      <p class="text-8xl font-extrabold text-[var(--brand)] opacity-20">404</p>
      <h1 class="mt-4 text-2xl font-bold">{t("error.404.title")}</h1>
      <p class="mt-2 text-sm text-[var(--text-tertiary)]">{t("error.404.desc")}</p>
      <div class="mt-8 flex items-center gap-3 justify-center">
        <a href="/" class="rounded-xl bg-[var(--brand-dim)] border border-[var(--border-brand)] px-5 py-2.5 text-sm font-medium text-[var(--brand)] hover:bg-[var(--brand-dim)] transition-all">{t("error.404.goHome")}</a>
        <a href="/login" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-5 py-2.5 text-sm text-[var(--text-secondary)] hover:bg-[var(--surface-3)] transition-all">{t("error.404.goDashboard")}</a>
      </div>
    </div>
  </div>
</BaseLayout>