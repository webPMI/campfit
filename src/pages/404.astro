---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="flex min-h-screen flex-col items-center justify-center px-4 text-center">
    <!-- Código 404 -->
    <div class="relative">
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="h-40 w-40 rounded-full bg-[var(--brand-dim)] blur-3xl"></div>
      </div>
      <h1 class="relative text-8xl font-black text-[var(--text-primary)] select-none">404</h1>
    </div>

    <!-- Contenido -->
    <div class="mt-4 animate-fade-in">
      <h2 class="text-2xl font-bold text-[var(--text-primary)]">Página no encontrada</h2>
      <p class="mt-2 text-sm text-[var(--text-tertiary)] max-w-md">
        La página que buscas no existe o ha sido movida. 
        Verifica la URL o vuelve al inicio.
      </p>
    </div>

    <!-- Acciones -->
    <div class="mt-8 flex gap-3 animate-fade-in-delay">
      <a
        href="/"
        class="rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand)] px-6 py-3 text-sm font-semibold text-[var(--text-on-brand)] shadow-lg shadow-[var(--shadow-glow-sm)] transition-all hover:from-[var(--brand-hover)] hover:to-[var(--brand)] active:scale-[0.98]"
      >
        Volver al inicio
      </a>
      <button
        onclick="history.back()"
        class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-6 py-3 text-sm font-medium text-[var(--text-secondary)] transition-all hover:border-[var(--border-strong)] hover:bg-[var(--surface-3)] hover:text-[var(--text-primary)] active:scale-[0.98]"
      >
        Página anterior
      </button>
    </div>

    <!-- Ilustración decorativa -->
    <div class="mt-12 opacity-20">
      <svg class="mx-auto h-24 w-24 text-[var(--text-disabled)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
      </svg>
    </div>
  </div>
</BaseLayout>
