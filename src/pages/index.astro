---
import PublicPageLayout from '@/layouts/PublicPageLayout.astro';
import GoldParticlesCanvas from '@/components/landing/GoldParticlesCanvas.astro';
import HeroGold from '@/components/landing/HeroGold.astro';
import ScrollingVideoShowcase from '@/components/landing/ScrollingVideoShowcase.astro';
import FeatureBentoGrid from '@/components/landing/FeatureBentoGrid.astro';
import InteractivePreviewTabs from '@/components/landing/InteractivePreviewTabs.astro';
import TestimonialsGold from '@/components/landing/TestimonialsGold.astro';
import PublicFooter from '@/components/landing/PublicFooter.astro';
import { type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
---

<PublicPageLayout currentPath="/">
  <!-- Floating Gold Particles Canvas Layer -->
  <GoldParticlesCanvas density={50} />

  <!-- Main Landing Container -->
  <div class="relative z-10 w-full flex flex-col items-center">
    <!-- Hero Section -->
    <HeroGold lang={lang} />

    <!-- Cinematic Video & Scrolling Showcase Section -->
    <ScrollingVideoShowcase lang={lang} />

    <!-- Bento Grid Features Section -->
    <FeatureBentoGrid lang={lang} />

    <!-- Interactive Role Preview Tabs -->
    <InteractivePreviewTabs lang={lang} />

    <!-- VIP Athletes & Trainers Testimonials -->
    <TestimonialsGold lang={lang} />

    <!-- Enriched Gold Footer -->
    <PublicFooter lang={lang} />
  </div>
</PublicPageLayout>
