---
import PublicPageLayout from '@/layouts/PublicPageLayout.astro';
import UICard from '@/components/UICard.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<PublicPageLayout currentPath="/">
  <div class="w-full max-w-lg animate-fade-in-scale text-center">
    <!-- Logo -->
    <div class="mb-8 text-center">
      <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--brand-gradient)] shadow-[var(--shadow-glow-md)]">
        <svg class="h-8 w-8 text-[var(--text-on-brand)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
        </svg>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-[var(--text-primary)]">{t('app.name')}</h1>
      <p class="mt-1 text-sm font-medium text-[var(--text-secondary)]">{t('app.tagline')}</p>
    </div>

    <!-- Hero Card -->
    <UICard variant="glass" padding="lg" class="animate-pulse-glow">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl text-[var(--text-primary)]">
        {t('hero.title')}
        <span class="text-[var(--brand)]"> {t('hero.title.highlight')}</span>
      </h2>

      <p class="mt-3 text-base text-[var(--text-secondary)] leading-relaxed">
        {t('hero.description')}
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a
          href={`/register?lang=${lang}`}
          class="group inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--brand-gradient)] px-6 py-3 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all duration-200 hover:shadow-[var(--shadow-glow-md)] hover:brightness-105 active:scale-[0.98]"
        >
          {t('hero.cta')}
          <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a
          href={`/login?lang=${lang}`}
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-6 py-3 text-sm font-medium text-[var(--text-secondary)] transition-all duration-200 hover:border-[var(--border-strong)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-3)] active:scale-[0.98]"
        >
          {t('hero.login')}
        </a>
      </div>
    </UICard>

    <!-- Features -->
    <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-3">
      <div style="animation-delay: 0.1s" class="animate-slide-up">
        <UICard variant="interactive" padding="sm" class="text-left h-full">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--brand-dim)]">
            <svg class="h-5 w-5 text-[var(--brand)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">{t('feature.training')}</h3>
          <p class="mt-1 text-xs text-[var(--text-secondary)]">{t('feature.training.desc')}</p>
        </UICard>
      </div>

      <div style="animation-delay: 0.2s" class="animate-slide-up">
        <UICard variant="interactive" padding="sm" class="text-left h-full">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--info-dim)]">
            <svg class="h-5 w-5 text-[var(--info)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">{t('feature.tracking')}</h3>
          <p class="mt-1 text-xs text-[var(--text-secondary)]">{t('feature.tracking.desc')}</p>
        </UICard>
      </div>

      <div style="animation-delay: 0.3s" class="animate-slide-up">
        <UICard variant="interactive" padding="sm" class="text-left h-full">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--accent-purple-dim)]">
            <svg class="h-5 w-5 text-[var(--accent-purple)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">{t('feature.coach')}</h3>
          <p class="mt-1 text-xs text-[var(--text-secondary)]">{t('feature.coach.desc')}</p>
        </UICard>
      </div>
    </div>
  </div>
</PublicPageLayout>
</write_to_file>