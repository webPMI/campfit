---
import PublicPageLayout from "@/layouts/PublicPageLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
const currentPath = Astro.url.pathname;
---

<PublicPageLayout currentPath={currentPath} lang={lang}>
  <div class="mx-auto max-w-2xl px-4 py-16 text-[var(--text-secondary)]">
    <h1 class="text-2xl font-bold text-[var(--text-primary)] mb-8">{t("auth.terms.link")}</h1>
    <div class="prose prose-sm text-[var(--text-secondary)] space-y-4">
      <p>Bienvenido a {t("app.name")}. Al registrarte y utilizar nuestros servicios, aceptas los siguientes términos.</p>
      <h2 class="text-lg font-semibold text-[var(--text-primary)]">1. Servicio</h2>
      <p>{t("app.name")} es una plataforma de fitness que conecta entrenadores con sus alumnos para gestionar rutinas de entrenamiento, planes nutricionales y seguimiento de progreso.</p>
      <h2 class="text-lg font-semibold text-[var(--text-primary)]">2. Cuentas</h2>
      <p>Eres responsable de mantener la confidencialidad de tu cuenta y contraseña. Debes notificar inmediatamente cualquier uso no autorizado de tu cuenta.</p>
      <h2 class="text-lg font-semibold text-[var(--text-primary)]">3. Datos Personales</h2>
      <p>Tus datos personales y médicos se almacenan de forma segura y solo son accesibles por tu entrenador asignado y el administrador del sistema.</p>
      <h2 class="text-lg font-semibold text-[var(--text-primary)]">4. Responsabilidad</h2>
      <p>{t("app.name")} es una herramienta de apoyo. Siempre consulta con un profesional médico antes de comenzar cualquier programa de ejercicio o dieta.</p>
    </div>
  </div>
</PublicPageLayout>