---
import TrainerLayout from "@/layouts/TrainerLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<TrainerLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold">{t("trainer.clients")}</h1>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t("trainer.clients.desc")}</p>
        </div>
      </div>

      <div class="mt-6">
        <input id="client-search" type="text" placeholder={t("trainer.clients.search")} class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-4 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm focus:outline-none focus:border-[var(--border-brand)]" />
      </div>

      <div id="clients-container" class="mt-6 space-y-3">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 text-center backdrop-blur-sm">
          <svg class="mx-auto h-5 w-5 animate-spin text-[var(--brand)]" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <p class="mt-2 text-sm text-[var(--text-tertiary)]">{t("admin.loading")}</p>
        </div>
      </div>

      <div id="client-detail" class="hidden mt-8"></div>
    </div>
  </div>
</TrainerLayout>

<script>
  import { requireRole } from "@/lib/shared/authGuard";
  import { t } from "@/i18n/client";
  import { escapeHtml } from "@/lib/shared/ui";
  import { subscribeToClients, getClientProfile, type TrainerClient } from "@/lib/trainer/trainerUtils";

  let unsubClients: (() => void) | null = null;
  let allClients: TrainerClient[] = [];

  requireRole(["trainer", "admin"], async (user) => { initClients(user.uid); });
  window.addEventListener("beforeunload", () => { unsubClients?.(); });

  async function initClients(trainerId: string) {
    const container = document.getElementById("clients-container")!;
    const searchInput = document.getElementById("client-search") as HTMLInputElement;
    const detailPanel = document.getElementById("client-detail")!;

    unsubClients = subscribeToClients(trainerId, (clients) => {
      allClients = clients;
      applyFilter();
    });

    searchInput.addEventListener("input", () => applyFilter());

    function applyFilter() {
      const query = searchInput.value.toLowerCase();
      const filtered = allClients.filter(c => c.name.toLowerCase().includes(query));
      if (filtered.length === 0) {
        container.innerHTML = `<div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 text-center backdrop-blur-sm"><p class="text-sm text-[var(--text-tertiary)]">${t("common.noResults")}</p></div>`;
      } else {
        container.innerHTML = filtered.map(c => `<div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm cursor-pointer hover:bg-[var(--surface-3)] transition-all" data-client-id="${c.uid}"><div class="flex items-center justify-between"><div><p class="text-sm font-medium text-[var(--text-primary)]">${escapeHtml(c.name)}</p><p class="text-xs text-[var(--text-tertiary)]">${escapeHtml(c.email || "")}</p></div><svg class="h-4 w-4 text-[var(--text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg></div></div>`).join("");
      }
    }

    container.addEventListener("click", async (e) => {
      const card = (e.target as HTMLElement).closest("[data-client-id]");
      if (!card) return;
      const clientId = card.getAttribute("data-client-id")!;
      const client = allClients.find(c => c.uid === clientId);
      if (!client) return;

      detailPanel.innerHTML = `<div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 backdrop-blur-sm"><div class="text-center"><svg class="mx-auto h-5 w-5 animate-spin text-[var(--brand)]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg><p class="mt-2 text-sm text-[var(--text-tertiary)]">${t("common.loading")}</p></div></div>`;
      detailPanel.classList.remove("hidden");

      const profile = await getClientProfile(clientId);
      if (!profile) {
        detailPanel.innerHTML = `<div class="rounded-xl border border-red-900/30 bg-[var(--danger-dim)] p-6 text-center backdrop-blur-sm"><p class="text-sm text-[var(--danger)]">${t("error.loading")}</p></div>`;
        return;
      }

      renderDetailView(client, profile);
    });
  }

  function renderDetailView(client: TrainerClient, profile: Partial<TrainerClient>) {
    const detailPanel = document.getElementById("client-detail")!;
    const hasMedical = profile.medicalProfile;
    let medicalHTML = "";
    if (!hasMedical) {
      medicalHTML = `<div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm"><p class="text-xs text-[var(--text-disabled)]">${t("trainer.client.no.medical")}</p></div>`;
    } else {
      const mp = (profile.medicalProfile as unknown as Record<string, unknown>) || {};
      medicalHTML = `
        <h3 class="text-sm font-semibold text-[var(--text-secondary)] mb-2">${t("trainer.client.medical")}</h3>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm space-y-2 text-xs">
          ${mp.allergies ? `<p><span class="text-[var(--text-disabled)]">${t("clinical.label.allergies")}:</span> <span class="text-[var(--text-secondary)]">${escapeHtml(String(mp.allergies))}</span></p>` : ""}
          ${mp.injuries ? `<p><span class="text-[var(--text-disabled)]">${t("clinical.label.injuries")}:</span> <span class="text-[var(--text-secondary)]">${escapeHtml(String(mp.injuries))}</span></p>` : ""}
          ${mp.conditions ? `<p><span class="text-[var(--text-disabled)]">${t("clinical.label.conditions")}:</span> <span class="text-[var(--text-secondary)]">${escapeHtml(String(mp.conditions))}</span></p>` : ""}
          ${mp.goals ? `<p><span class="text-[var(--text-disabled)]">${t("onboarding.goals")}:</span> <span class="text-[var(--text-secondary)]">${escapeHtml(String(mp.goals))}</span></p>` : ""}
        </div>`;
    }

    detailPanel.innerHTML = `
      <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 backdrop-blur-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-semibold text-[var(--text-primary)]">${escapeHtml(client.name)}</h2>
            <p class="text-xs text-[var(--text-tertiary)]">${escapeHtml(client.email || "")}</p>
          </div>
          <a href="/trainer/chat" class="rounded-xl bg-[var(--brand-dim)] border border-[var(--border-brand)] px-3 py-1.5 text-xs font-medium text-[var(--brand)] hover:bg-[var(--brand-dim)] transition-all">${t("trainer.chat")}</a>
        </div>
        ${medicalHTML}
        <div class="mt-4 grid grid-cols-2 gap-2">
          <a href="/trainer/workouts?clientId=${client.uid}" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-3 text-sm text-[var(--text-secondary)] hover:bg-[var(--surface-4)] transition-all text-center">${t("trainer.workouts")}</a>
          <a href="/trainer/diets?clientId=${client.uid}" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-3 text-sm text-[var(--text-secondary)] hover:bg-[var(--surface-4)] transition-all text-center">${t("trainer.diets")}</a>
        </div>
      </div>`;
  }
</script>