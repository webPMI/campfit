---
import TrainerLayout from "@/layouts/TrainerLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<TrainerLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold" data-i18n="trainer.clients">{t("trainer.clients")}</h1>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]" data-i18n="trainer.clients.desc">{t("trainer.clients.desc")}</p>
        </div>
      </div>

      <div class="mt-6">
        <input
          id="client-search"
          type="text"
          placeholder={t("trainer.clients.search")}
          data-i18n-placeholder="trainer.clients.search"
          class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-4 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm focus:outline-none focus:border-[var(--border-brand)]"
        />
      </div>

      <div id="clients-container" class="mt-6 space-y-3">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 text-center backdrop-blur-sm">
          <svg class="mx-auto h-5 w-5 animate-spin text-[var(--brand)]" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <p class="mt-2 text-sm text-[var(--text-tertiary)]" data-i18n="admin.loading">{t("admin.loading")}</p>
        </div>
      </div>

      <div id="client-detail" class="hidden mt-8"></div>
    </div>
  </div>
</TrainerLayout>

<script>
  import { requireRole } from "@/lib/shared/authGuard";
  import { t } from "@/i18n/client";
  import { escapeHtml } from "@/lib/shared/ui";
  import { subscribeToClients, getClientProfile, type TrainerClient } from "@/lib/trainer/trainerUtils";

  let unsubClients: (() => void) | null = null;
  let allClients: TrainerClient[] = [];

  requireRole(["trainer", "admin"], async (user) => { initClients(user.uid); });
  window.addEventListener("beforeunload", () => { unsubClients?.(); });

  async function initClients(trainerId: string) {
    const container = document.getElementById("clients-container")!;
    const searchInput = document.getElementById("client-search") as HTMLInputElement;
    const detailPanel = document.getElementById("client-detail")!;

    unsubClients = subscribeToClients(trainerId, (clients) => {
      allClients = clients;
      applyFilter();
    });

    searchInput.addEventListener("input", () => applyFilter());

    function applyFilter() {
      const query = searchInput.value.toLowerCase();
      const filtered = allClients.filter(c => c.name.toLowerCase().includes(query) || (c.email && c.email.toLowerCase().includes(query)));
      if (filtered.length === 0) {
        container.innerHTML = `<div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 text-center backdrop-blur-sm"><p class="text-sm text-[var(--text-tertiary)]" data-i18n="common.noResults">${t("common.noResults")}</p></div>`;
      } else {
        container.innerHTML = filtered.map(c => `
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm cursor-pointer hover:bg-[var(--surface-3)] transition-all flex items-center justify-between" data-client-id="${c.uid}">
            <div>
              <p class="text-sm font-medium text-[var(--text-primary)]">${escapeHtml(c.name)}</p>
              <p class="text-xs text-[var(--text-tertiary)]">${escapeHtml(c.email || "")}</p>
            </div>
            <svg class="h-4 w-4 text-[var(--text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
            </svg>
          </div>
        `).join("");
      }
    }

    container.addEventListener("click", async (e) => {
      const card = (e.target as HTMLElement).closest("[data-client-id]");
      if (!card) return;
      const clientId = card.getAttribute("data-client-id")!;
      const client = allClients.find(c => c.uid === clientId);
      if (!client) return;

      detailPanel.innerHTML = `<div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 backdrop-blur-sm text-center"><svg class="mx-auto h-5 w-5 animate-spin text-[var(--brand)]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg><p class="mt-2 text-sm text-[var(--text-tertiary)]" data-i18n="common.loading">${t("common.loading")}</p></div>`;
      detailPanel.classList.remove("hidden");

      const profile = await getClientProfile(clientId);
      if (!profile) {
        detailPanel.innerHTML = `<div class="rounded-xl border border-red-900/30 bg-[var(--danger-dim)] p-6 text-center backdrop-blur-sm"><p class="text-sm text-[var(--danger)]" data-i18n="error.loading">${t("error.loading")}</p></div>`;
        return;
      }

      renderDetailView(client, profile);
    });
  }

  function formatMedicalValue(val: unknown): string {
    if (!val) return `<span class="text-[var(--text-disabled)] italic">${t("common.none")}</span>`;
    const str = String(val).trim();
    if (!str || str.toLowerCase() === 'nada' || str.toLowerCase() === 'ninguna' || str.toLowerCase() === 'ninguno' || str.toLowerCase() === 'none') {
      return `<span class="text-[var(--text-disabled)] italic">${t("common.none")}</span>`;
    }
    return `<span class="text-[var(--text-primary)] font-medium">${escapeHtml(str)}</span>`;
  }

  function formatGoalBadges(goalsVal: unknown): string {
    if (!goalsVal) return `<span class="text-[var(--text-disabled)] italic">${t("common.none")}</span>`;
    const list = Array.isArray(goalsVal)
      ? goalsVal
      : String(goalsVal).split(',').map(s => s.trim()).filter(Boolean);

    if (list.length === 0) return `<span class="text-[var(--text-disabled)] italic">${t("common.none")}</span>`;

    const goalMap: Record<string, { labelKey: string; icon: string }> = {
      lose_weight: { labelKey: "onboarding.goals.lose_weight", icon: "🔥" },
      gain_muscle: { labelKey: "onboarding.goals.gain_muscle", icon: "💪" },
      endurance: { labelKey: "onboarding.goals.endurance", icon: "🏃" },
      strength: { labelKey: "onboarding.goals.strength", icon: "🏋️" },
      health: { labelKey: "onboarding.goals.health", icon: "❤️" },
    };

    return `<div class="flex flex-wrap gap-1.5 mt-1.5">` + list.map(g => {
      const item = goalMap[g];
      const label = item ? `${item.icon} ${t(item.labelKey)}` : escapeHtml(g);
      return `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[var(--surface-3)] text-[var(--brand)] text-[11px] font-semibold border border-[var(--border-subtle)]">${label}</span>`;
    }).join('') + `</div>`;
  }

  function renderDetailView(client: TrainerClient, profile: Partial<TrainerClient>) {
    const detailPanel = document.getElementById("client-detail")!;
    const hasMedical = profile.medicalProfile;
    let medicalHTML = "";

    if (!hasMedical) {
      medicalHTML = `<div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm"><p class="text-xs text-[var(--text-disabled)]">${t("trainer.client.no.medical")}</p></div>`;
    } else {
      const mp = (profile.medicalProfile as unknown as Record<string, unknown>) || {};
      medicalHTML = `
        <h3 class="text-sm font-semibold text-[var(--text-secondary)] mb-2">${t("trainer.client.medical")}</h3>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm space-y-2.5 text-xs">
          <div class="flex items-start justify-between py-1 border-b border-[var(--border-subtle)]/50">
            <span class="text-[var(--text-tertiary)]">${t("clinical.label.allergies")}</span>
            <div>${formatMedicalValue(mp.allergies)}</div>
          </div>
          <div class="flex items-start justify-between py-1 border-b border-[var(--border-subtle)]/50">
            <span class="text-[var(--text-tertiary)]">${t("clinical.label.injuries")}</span>
            <div>${formatMedicalValue(mp.injuries)}</div>
          </div>
          <div class="flex items-start justify-between py-1 border-b border-[var(--border-subtle)]/50">
            <span class="text-[var(--text-tertiary)]">${t("clinical.label.conditions")}</span>
            <div>${formatMedicalValue(mp.conditions)}</div>
          </div>
          <div class="pt-1">
            <span class="text-[var(--text-tertiary)] font-medium">${t("onboarding.goals")}</span>
            ${formatGoalBadges(mp.goals)}
          </div>
        </div>`;
    }

    detailPanel.innerHTML = `
      <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 backdrop-blur-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-semibold text-[var(--text-primary)]">${escapeHtml(client.name)}</h2>
            <p class="text-xs text-[var(--text-tertiary)]">${escapeHtml(client.email || "")}</p>
          </div>
          <a href="/trainer/chat" class="rounded-xl bg-[var(--brand-dim)] border border-[var(--border-brand)] px-3.5 py-1.5 text-xs font-semibold text-[var(--brand)] hover:bg-[var(--brand)] hover:text-[var(--text-on-brand)] transition-all flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z"/>
            </svg>
            <span>${t("trainer.chat")}</span>
          </a>
        </div>
        ${medicalHTML}
        <div class="mt-5 grid grid-cols-2 gap-3">
          <a href="/trainer/workouts?clientId=${client.uid}" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-3 text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-4)] transition-all text-center flex items-center justify-center gap-2">
            <span>🏋️</span>
            <span>${t("trainer.workouts")}</span>
          </a>
          <a href="/trainer/diets?clientId=${client.uid}" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-3 text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-4)] transition-all text-center flex items-center justify-center gap-2">
            <span>🥗</span>
            <span>${t("trainer.diets")}</span>
          </a>
        </div>
      </div>`;
  }
</script>