                <p class="text-xs font-medium text-zinc-400">Peso (últimas ${weights.length} mediciones)</p>
                <p class="text-xs font-bold ${trendColor}">${latestW} kg ${trend}</p>
              </div>
              <svg viewBox="0 0 200 40" class="w-full h-10 overflow-visible">
                <polyline points="${pts}" fill="none" stroke="rgb(52 211 153 / 0.5)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="${(weights.length - 1) / (weights.length - 1) * W}" cy="${H - ((weights[weights.length - 1] - minW) / range) * (H - 6) - 3}" r="2.5" fill="rgb(52 211 153)" />
              </svg>
              <div class="flex justify-between text-[10px] text-zinc-600 mt-0.5">
                <span>Mín: ${minW} kg</span>
                <span>Máx: ${maxW} kg</span>
              </div>
            </div>
          `;
        }

        const recent = logs.slice(0, 5).map((log: any) => {
          const date = log.date?.toDate ? formatDate(log.date) : log.date || '-';
          let value: string;
          switch (log.type) {
            case 'weight': value = `${log.value?.weight || '-'} kg`; break;
            case 'workout': value = log.value?.completed ? '✅ Completado' : '⏳ Pendiente'; break;
            case 'meal': value = log.value?.completed ? '✅ Completada' : '⏳ Pendiente'; break;
            default: value = log.value ? JSON.stringify(log.value) : '-';
          }
          return `<div class="flex items-center justify-between py-1.5 border-b border-zinc-800/40 last:border-0">
            <span class="text-xs text-zinc-500">${date}</span>
            <span class="text-xs text-zinc-200">${value}</span>
          </div>`;
        }).join('');

        el.innerHTML = sparklineHtml + recent;
      });
    };

    (window as any).__hideClientDetail = () => {
      cleanupDetailSubscriptions();
      clientDetail.classList.add('hidden');
      clientDetail.innerHTML = '';
    };
  }
</script>