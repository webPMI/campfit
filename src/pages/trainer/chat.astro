---
import TrainerLayout from "@/layouts/TrainerLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<TrainerLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold">{t("trainer.chat")}</h1>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t("trainer.chat.desc")}</p>
        </div>
      </div>
      <div id="chat-container" class="mt-6 space-y-3">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 text-center backdrop-blur-sm">
          <svg class="mx-auto h-5 w-5 animate-spin text-[var(--brand)]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
          <p class="mt-2 text-sm text-[var(--text-tertiary)]">{t("admin.loading")}</p>
        </div>
      </div>
    </div>
  </div>
</TrainerLayout>

<script>
  import { logger } from "@/lib/shared/logger";
  import { requireAuth } from "@/lib/shared/authGuard";
  import { t } from "@/i18n/client";
  import { escapeHtml } from "@/lib/shared/ui";
  import { subscribeToConversations, sendMessage } from "@/lib/trainer/trainerUtils";

  let unsubMessages = null;
  let currentTrainerId = "";

  requireAuth(async (user) => { initChat(user.uid); });
  window.addEventListener("beforeunload", () => { unsubMessages?.(); });

  async function initChat(trainerId) {
    currentTrainerId = trainerId;
    const container = document.getElementById("chat-container")!;
    unsubMessages = subscribeToConversations(trainerId, (messages) => {
      if (messages.length === 0) {
        container.innerHTML = `<div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 text-center backdrop-blur-sm"><p class="text-sm text-[var(--text-tertiary)]">${t("trainer.chat.no.messages")}</p></div>`;
      } else {
        const grouped = {};
        messages.forEach(m => {
          const otherId = m.senderId === trainerId ? m.receiverId : m.senderId;
          if (!grouped[otherId]) grouped[otherId] = [];
          grouped[otherId].push(m);
        });
        container.innerHTML = Object.entries(grouped).map(([uid, msgs]) => {
          const last = msgs[msgs.length-1];
          const unread = msgs.filter(m => m.receiverId === trainerId && !m.isRead).length;
          return `<div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm cursor-pointer hover:bg-[var(--surface-3)] transition-all" onclick="window.location.href='/admin/chat?clientId=${uid}'"><div class="flex items-center justify-between"><div><p class="text-sm font-medium text-[var(--text-primary)]">${escapeHtml(last.senderName || t("common.client"))} ${unread ? `<span class="text-xs text-[var(--danger)]">(${unread})</span>` : ""}</p><p class="text-xs text-[var(--text-tertiary)]">${escapeHtml(last.content?.slice(0, 60) || "")}</p></div><svg class="h-4 w-4 text-[var(--text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg></div></div>`;
        }).join("");
      }
    });
  }
</script>