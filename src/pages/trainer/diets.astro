---
import TrainerLayout from "@/layouts/TrainerLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<TrainerLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
          <h1 class="text-2xl font-bold">{t("trainer.diets")}</h1>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t("trainer.diets.desc")}</p>
        </div>
        <button
          id="btn-create-diet"
          class="flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-4 py-2.5 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all hover:opacity-95 active:scale-95"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Nueva Dieta
        </button>
      </div>

      <!-- Buscador y filtro por cliente -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <input
          id="diet-search"
          type="text"
          placeholder="Buscar dietas..."
          class="flex-1 min-w-[200px] rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-4 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)]"
        />
        <select
          id="filter-client"
          class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-4 py-2.5 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]"
        >
          <option value="">Todos los clientes</option>
        </select>
      </div>

      <!-- Editor de Dieta -->
      <div id="diet-editor" class="hidden mt-6"></div>

      <!-- Lista de Dietas -->
      <div id="diets-container" class="mt-6 space-y-3">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 text-center backdrop-blur-sm">
          <svg class="mx-auto h-5 w-5 animate-spin text-[var(--brand)]" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
          </svg>
          <p class="mt-2 text-sm text-[var(--text-tertiary)]">{t("admin.loading")}</p>
        </div>
      </div>
    </div>
  </div>
</TrainerLayout>

<script>
  import { logger } from "@/lib/shared/logger";
  import { requireAuth } from "@/lib/shared/authGuard";
  import { ICONS, escapeHtml, renderEmptyState, showToast } from "@/lib/shared/ui";
  import {
    subscribeToClients,
    subscribeToDietsByTrainer,
    createDiet,
    updateDiet,
    deleteDiet,
  } from "@/lib/trainer/trainerUtils";
  import type { TrainerClient, TrainerDiet, Meal } from "@/lib/trainer/types";

  let unsubClients: (() => void) | null = null;
  let unsubDiets: (() => void) | null = null;
  let allClients: TrainerClient[] = [];
  let allDiets: TrainerDiet[] = [];
  let currentTrainerId = "";
  let editingDiet: TrainerDiet | null = null;
  let currentMeals: Meal[] = [];

  requireAuth(async (user) => {
    initDiets(user.uid);
  });

  window.addEventListener("beforeunload", () => {
    unsubClients?.();
    unsubDiets?.();
  });

  function initDiets(trainerId: string): void {
    currentTrainerId = trainerId;
    const container = document.getElementById("diets-container")!;
    const btnCreate = document.getElementById("btn-create-diet")!;
    const searchInput = document.getElementById("diet-search") as HTMLInputElement;
    const filterClientSelect = document.getElementById("filter-client") as HTMLSelectElement;

    unsubClients = subscribeToClients(trainerId, (clients) => {
      allClients = clients;
      populateClientFilter();
      renderDiets();
    });

    unsubDiets = subscribeToDietsByTrainer(trainerId, (diets) => {
      allDiets = diets;
      renderDiets();
    });

    btnCreate.addEventListener("click", () => showEditor(null));

    searchInput?.addEventListener("input", () => renderDiets());
    filterClientSelect?.addEventListener("change", () => renderDiets());

    container.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("[data-action]");
      if (!btn) return;
      const action = btn.getAttribute("data-action");
      const dietId = btn.getAttribute("data-diet-id");
      const diet = allDiets.find((d) => d.id === dietId);

      if (action === "edit" && diet) {
        showEditor(diet);
      }
      if (action === "delete" && diet) {
        if (confirm(`¿Eliminar la dieta "${diet.name}"?`)) {
          deleteDiet(diet.id)
            .then((ok) => {
              if (ok) showToast({ message: "Dieta eliminada correctamente", type: "success" });
            })
            .catch((err) => logger.error("TrainerDiets", "Error deleting diet", err));
        }
      }
    });
  }

  function populateClientFilter(): void {
    const filterClientSelect = document.getElementById("filter-client") as HTMLSelectElement;
    if (!filterClientSelect) return;
    const currentVal = filterClientSelect.value;
    filterClientSelect.innerHTML = `<option value="">Todos los clientes</option>` +
      allClients.map((c) => `<option value="${c.uid}">${escapeHtml(c.name)}</option>`).join("");
    filterClientSelect.value = currentVal;
  }

  function renderDiets(): void {
    const container = document.getElementById("diets-container")!;
    const searchVal = (document.getElementById("diet-search") as HTMLInputElement)?.value.toLowerCase().trim() || "";
    const filterClient = (document.getElementById("filter-client") as HTMLSelectElement)?.value || "";

    const filteredDiets = allDiets.filter((d) => {
      const client = allClients.find((c) => c.uid === d.clientId);
      const clientName = client ? client.name.toLowerCase() : "";
      const matchesSearch = d.name.toLowerCase().includes(searchVal) || clientName.includes(searchVal);
      const matchesClient = !filterClient || d.clientId === filterClient;
      return matchesSearch && matchesClient;
    });

    if (filteredDiets.length === 0) {
      container.innerHTML = renderEmptyState(ICONS.diets, "No hay dietas registradas.");
      return;
    }

    container.innerHTML = filteredDiets
      .map((d) => {
        const client = allClients.find((c) => c.uid === d.clientId);
        const clientName = client ? client.name : "Cliente sin asignar";
        const mealCount = d.meals?.length || 0;
        const calories = d.totalCalories || 0;

        const protein = d.meals?.reduce((sum, m) => sum + (m.protein || 0), 0) || d.totalProtein || 0;
        const carbs = d.meals?.reduce((sum, m) => sum + (m.carbs || 0), 0) || d.totalCarbs || 0;
        const fat = d.meals?.reduce((sum, m) => sum + (m.fat || 0), 0) || d.totalFat || 0;

        const typeLabels: Record<string, string> = {
          normal: "Normocalórica",
          definition: "Definición",
          volume: "Volumen",
          keto: "Keto",
          vegan: "Vegana",
          custom: "Personalizada",
        };
        const typeBadge = typeLabels[d.type] || d.type || "Personalizada";

        return `
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm transition-all hover:border-[var(--border-strong)]">
            <div class="flex items-start justify-between gap-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <p class="text-sm font-semibold text-[var(--text-primary)]">${escapeHtml(d.name)}</p>
                  <span class="rounded-full bg-[var(--brand-dim)] px-2 py-0.5 text-[10px] font-semibold text-[var(--brand)] border border-[var(--border-brand)]">${escapeHtml(typeBadge)}</span>
                </div>
                <p class="text-xs text-[var(--text-tertiary)] flex items-center gap-1.5">
                  <svg class="h-3.5 w-3.5 text-[var(--text-disabled)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                  </svg>
                  ${escapeHtml(clientName)}
                  <span>•</span>
                  <span>${mealCount} comida${mealCount !== 1 ? 's' : ''}</span>
                </p>

                <!-- Macros resume bar -->
                <div class="mt-2.5 flex items-center gap-2 text-xs flex-wrap">
                  <span class="rounded-md bg-amber-500/10 px-2 py-0.5 font-medium text-amber-400 border border-amber-500/20">${calories} kcal</span>
                  <span class="rounded-md bg-emerald-500/10 px-2 py-0.5 font-medium text-emerald-400 border border-emerald-500/20">Prot: ${protein}g</span>
                  <span class="rounded-md bg-blue-500/10 px-2 py-0.5 font-medium text-blue-400 border border-blue-500/20">Carbs: ${carbs}g</span>
                  <span class="rounded-md bg-purple-500/10 px-2 py-0.5 font-medium text-purple-400 border border-purple-500/20">Grasas: ${fat}g</span>
                </div>
              </div>

              <div class="flex items-center gap-1.5 shrink-0">
                <button
                  data-action="edit"
                  data-diet-id="${d.id}"
                  class="rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-all"
                >
                  Editar
                </button>
                <button
                  data-action="delete"
                  data-diet-id="${d.id}"
                  class="rounded-lg border border-red-500/30 bg-[var(--danger-dim)] px-3 py-1.5 text-xs font-medium text-[var(--danger)] hover:bg-[var(--danger-dim)] transition-all"
                >
                  Eliminar
                </button>
              </div>
            </div>
          </div>
        `;
      })
      .join("");
  }

  function showEditor(diet: TrainerDiet | null): void {
    const editor = document.getElementById("diet-editor")!;
    editingDiet = diet;
    currentMeals = diet && diet.meals ? JSON.parse(JSON.stringify(diet.meals)) : [];

    const isEditing = !!diet;

    editor.innerHTML = `
      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 shadow-2xl backdrop-blur-xl animate-fade-in space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
          <h3 class="text-lg font-bold text-[var(--text-primary)]">
            ${isEditing ? 'Editar Plan Nutricional' : 'Nuevo Plan Nutricional'}
          </h3>
          <button id="btn-cancel-diet-top" class="text-[var(--text-tertiary)] hover:text-white text-xl">&times;</button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">Nombre de la Dieta *</label>
            <input
              id="diet-name"
              type="text"
              value="${escapeHtml(diet?.name || '')}"
              placeholder="Ej: Dieta de Definición 2200 kcal"
              class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)]"
            />
          </div>

          <div>
            <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">Cliente Asignado *</label>
            <select
              id="diet-client"
              class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]"
            >
              <option value="">Selecciona un cliente...</option>
              ${allClients.map((c) => `<option value="${c.uid}" ${c.uid === diet?.clientId ? 'selected' : ''}>${escapeHtml(c.name)} (${escapeHtml(c.email)})</option>`).join('')}
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">Tipo de Dieta</label>
            <select
              id="diet-type"
              class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]"
            >
              <option value="normal" ${diet?.type === 'normal' ? 'selected' : ''}>Normocalórica</option>
              <option value="definition" ${diet?.type === 'definition' ? 'selected' : ''}>Definición Muscular</option>
              <option value="volume" ${diet?.type === 'volume' ? 'selected' : ''}>Volumen / Ganancia</option>
              <option value="keto" ${diet?.type === 'keto' ? 'selected' : ''}>Cetogénica (Keto)</option>
              <option value="vegan" ${diet?.type === 'vegan' ? 'selected' : ''}>Vegana / Vegetariana</option>
              <option value="custom" ${diet?.type === 'custom' ? 'selected' : ''}>Personalizada</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">Somatotipo Recomendado</label>
            <select
              id="diet-somatotype"
              class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]"
            >
              <option value="">Sin especificar</option>
              <option value="ectomorph" ${diet?.somatotype === 'ectomorph' ? 'selected' : ''}>Ectomorfo</option>
              <option value="mesomorph" ${diet?.somatotype === 'mesomorph' ? 'selected' : ''}>Mesomorfo</option>
              <option value="endomorph" ${diet?.somatotype === 'endomorph' ? 'selected' : ''}>Endomorfo</option>
            </select>
          </div>
        </div>

        <!-- Banner de Macronutrientes Calculados -->
        <div class="rounded-xl border border-[var(--border-brand)] bg-[var(--brand-dim)] p-4">
          <div class="flex items-center justify-between flex-wrap gap-2 text-xs">
            <span class="font-bold text-[var(--brand)] uppercase tracking-wider text-[10px]">Totales de la Dieta:</span>
            <div class="flex items-center gap-3 font-semibold text-[var(--text-primary)] flex-wrap">
              <span>🔥 <span id="calc-calories">0</span> kcal</span>
              <span>🥩 Prot: <span id="calc-protein">0</span>g</span>
              <span>🍚 Carbs: <span id="calc-carbs">0</span>g</span>
              <span>🥑 Grasas: <span id="calc-fat">0</span>g</span>
            </div>
          </div>
        </div>

        <!-- Sección de Comidas -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="text-sm font-bold text-[var(--text-primary)]">Desglose de Comidas Diarias</h4>
            <button
              type="button"
              id="btn-add-meal"
              class="flex items-center gap-1 text-xs font-semibold text-[var(--brand)] hover:underline"
            >
              + Añadir Comida
            </button>
          </div>

          <div id="meals-editor-container" class="space-y-3"></div>
        </div>

        <!-- Botones de Acción -->
        <div class="flex items-center gap-3 pt-3 border-t border-[var(--border-subtle)]">
          <button
            id="btn-save-diet"
            class="flex-1 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-5 py-2.5 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all hover:opacity-95"
          >
            ${isEditing ? 'Guardar Cambios' : 'Crear Plan Nutricional'}
          </button>
          <button
            id="btn-cancel-diet"
            class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-5 py-2.5 text-sm font-medium text-[var(--text-secondary)] hover:text-white"
          >
            Cancelar
          </button>
        </div>
      </div>
    `;

    editor.classList.remove("hidden");
    editor.scrollIntoView({ behavior: 'smooth' });

    renderMealsEditor();

    // Event listeners
    document.getElementById("btn-add-meal")!.addEventListener("click", () => {
      const newMeal: Meal = {
        id: 'm-' + Date.now() + '-' + Math.random().toString(36).substring(2, 5),
        name: 'Desayuno',
        description: '',
        calories: 400,
        protein: 25,
        carbs: 45,
        fat: 10,
        order: currentMeals.length + 1,
      };
      currentMeals.push(newMeal);
      renderMealsEditor();
    });

    document.getElementById("btn-cancel-diet-top")!.addEventListener("click", closeEditor);
    document.getElementById("btn-cancel-diet")!.addEventListener("click", closeEditor);

    document.getElementById("btn-save-diet")!.addEventListener("click", async () => {
      const nameInput = document.getElementById("diet-name") as HTMLInputElement;
      const clientSelect = document.getElementById("diet-client") as HTMLSelectElement;
      const typeSelect = document.getElementById("diet-type") as HTMLSelectElement;
      const somatotypeSelect = document.getElementById("diet-somatotype") as HTMLSelectElement;

      const name = nameInput.value.trim();
      const clientId = clientSelect.value;
      const type = typeSelect.value || "normal";
      const somatotype = somatotypeSelect.value || undefined;

      if (!name || !clientId) {
        showToast({ message: "Por favor completa el nombre de la dieta y selecciona un cliente.", type: "error" });
        if (!name) nameInput.classList.add("border-red-500");
        if (!clientId) clientSelect.classList.add("border-red-500");
        return;
      }

      // Guardar valores actuales de los inputs de comidas
      saveMealsFromDOM();

      const totalCalories = currentMeals.reduce((sum, m) => sum + (Number(m.calories) || 0), 0);
      const totalProtein = currentMeals.reduce((sum, m) => sum + (Number(m.protein) || 0), 0);
      const totalCarbs = currentMeals.reduce((sum, m) => sum + (Number(m.carbs) || 0), 0);
      const totalFat = currentMeals.reduce((sum, m) => sum + (Number(m.fat) || 0), 0);

      const payload = {
        name,
        clientId,
        trainerId: currentTrainerId,
        type,
        somatotype,
        totalCalories,
        totalProtein,
        totalCarbs,
        totalFat,
        meals: currentMeals,
      };

      try {
        if (isEditing && diet) {
          const ok = await updateDiet(diet.id, payload);
          if (ok) showToast({ message: "Dieta actualizada correctamente ✅", type: "success" });
        } else {
          const id = await createDiet(payload);
          if (id) showToast({ message: "Dieta creada correctamente ✅", type: "success" });
        }
        closeEditor();
      } catch (err) {
        logger.error("TrainerDiets", "Error saving diet", err);
        showToast({ message: "Error al guardar la dieta", type: "error" });
      }
    });
  }

  function closeEditor(): void {
    const editor = document.getElementById("diet-editor")!;
    editor.classList.add("hidden");
    editor.innerHTML = "";
    editingDiet = null;
    currentMeals = [];
  }

  function saveMealsFromDOM(): void {
    const container = document.getElementById("meals-editor-container");
    if (!container) return;

    const mealCards = container.querySelectorAll(".meal-card");
    mealCards.forEach((card, idx) => {
      const nameSelect = card.querySelector(".meal-name") as HTMLInputElement | HTMLSelectElement;
      const descInput = card.querySelector(".meal-desc") as HTMLInputElement;
      const kcalInput = card.querySelector(".meal-kcal") as HTMLInputElement;
      const protInput = card.querySelector(".meal-prot") as HTMLInputElement;
      const carbsInput = card.querySelector(".meal-carbs") as HTMLInputElement;
      const fatInput = card.querySelector(".meal-fat") as HTMLInputElement;

      if (currentMeals[idx]) {
        currentMeals[idx].name = nameSelect?.value || "Comida";
        currentMeals[idx].description = descInput?.value || "";
        currentMeals[idx].calories = Number(kcalInput?.value) || 0;
        currentMeals[idx].protein = Number(protInput?.value) || 0;
        currentMeals[idx].carbs = Number(carbsInput?.value) || 0;
        currentMeals[idx].fat = Number(fatInput?.value) || 0;
        currentMeals[idx].order = idx + 1;
      }
    });
  }

  function updateMacroTotals(): void {
    saveMealsFromDOM();
    const totKcal = currentMeals.reduce((sum, m) => sum + (Number(m.calories) || 0), 0);
    const totProt = currentMeals.reduce((sum, m) => sum + (Number(m.protein) || 0), 0);
    const totCarbs = currentMeals.reduce((sum, m) => sum + (Number(m.carbs) || 0), 0);
    const totFat = currentMeals.reduce((sum, m) => sum + (Number(m.fat) || 0), 0);

    const elKcal = document.getElementById("calc-calories");
    const elProt = document.getElementById("calc-protein");
    const elCarbs = document.getElementById("calc-carbs");
    const elFat = document.getElementById("calc-fat");

    if (elKcal) elKcal.textContent = String(totKcal);
    if (elProt) elProt.textContent = String(totProt);
    if (elCarbs) elCarbs.textContent = String(totCarbs);
    if (elFat) elFat.textContent = String(totFat);
  }

  function renderMealsEditor(): void {
    const container = document.getElementById("meals-editor-container");
    if (!container) return;

    if (currentMeals.length === 0) {
      container.innerHTML = `
        <div class="p-4 text-center border border-dashed border-[var(--border-subtle)] rounded-xl">
          <p class="text-xs text-[var(--text-tertiary)]">No has añadido comidas a esta dieta.</p>
        </div>
      `;
      updateMacroTotals();
      return;
    }

    const mealTypes = [
      "Desayuno",
      "Almuerzo",
      "Merienda",
      "Cena",
      "Snack",
      "Pre-entrenamiento",
      "Post-entrenamiento",
      "Otro",
    ];

    container.innerHTML = currentMeals
      .map((meal, idx) => `
        <div class="meal-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-4 space-y-3" data-index="${idx}">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[var(--brand-dim)] text-xs font-bold text-[var(--brand)]">${idx + 1}</span>
              <select class="meal-name rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-4)] px-2.5 py-1 text-xs font-semibold text-[var(--text-primary)]">
                ${mealTypes.map((t) => `<option value="${t}" ${meal.name === t ? 'selected' : ''}>${t}</option>`).join('')}
              </select>
            </div>
            <button
              type="button"
              data-action="remove-meal"
              data-index="${idx}"
              class="text-xs text-red-400 hover:text-red-300 transition-all font-medium"
            >
              &times; Eliminar
            </button>
          </div>

          <div>
            <input
              type="text"
              class="meal-desc w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-4)] px-3 py-1.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)]"
              placeholder="Descripción de alimentos (ej: 150g pechuga de pollo, 100g arroz integral)"
              value="${escapeHtml(meal.description || '')}"
            />
          </div>

          <div class="grid grid-cols-4 gap-2 text-xs">
            <div>
              <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">Kcal</label>
              <input type="number" class="meal-kcal w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-4)] px-2 py-1 text-xs text-[var(--text-primary)]" value="${meal.calories || 0}" />
            </div>
            <div>
              <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">Prot (g)</label>
              <input type="number" class="meal-prot w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-4)] px-2 py-1 text-xs text-[var(--text-primary)]" value="${meal.protein || 0}" />
            </div>
            <div>
              <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">Carbs (g)</label>
              <input type="number" class="meal-carbs w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-4)] px-2 py-1 text-xs text-[var(--text-primary)]" value="${meal.carbs || 0}" />
            </div>
            <div>
              <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">Grasas (g)</label>
              <input type="number" class="meal-fat w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-4)] px-2 py-1 text-xs text-[var(--text-primary)]" value="${meal.fat || 0}" />
            </div>
          </div>
        </div>
      `)
      .join("");

    // Listeners de inputs para recalcular totales en directo
    container.querySelectorAll("input, select").forEach((input) => {
      input.addEventListener("input", updateMacroTotals);
    });

    // Handler de eliminación de comidas
    container.querySelectorAll('[data-action="remove-meal"]').forEach((btn) => {
      btn.addEventListener("click", (e) => {
        saveMealsFromDOM();
        const index = Number((e.currentTarget as HTMLElement).getAttribute("data-index"));
        if (!isNaN(index) && index >= 0) {
          currentMeals.splice(index, 1);
          renderMealsEditor();
        }
      });
    });

    updateMacroTotals();
  }
</script>