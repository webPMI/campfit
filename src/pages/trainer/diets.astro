---
import TrainerLayout from "@/layouts/TrainerLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<TrainerLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
          <h1 class="text-2xl font-bold text-[var(--text-primary)]">{t("trainer.diets")}</h1>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t("trainer.diets.desc")}</p>
        </div>
        <button
          id="btn-create-diet"
          class="flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-4 py-2.5 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all hover:opacity-95 active:scale-95"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
          </svg>
          {t("trainer.diets.new")}
        </button>
      </div>

      <!-- Preset Diet Templates Quick-Deploy Banner -->
      <!-- Luxury Preset Diets & Smart Nutrition Assignment Hub -->
      <div
        id="template-banner"
        class="mt-6 rounded-2xl border border-amber-500/40 bg-zinc-900/90 p-5 backdrop-blur-xl shadow-[0_10px_30px_rgba(0,0,0,0.5),0_0_20px_rgba(245,158,11,0.15)] space-y-4"
      >
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-500/20 border border-amber-500/30 text-amber-400 text-lg shadow-inner">
              🥗
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h3
                  data-i18n="admin.quickDeploy.defaultDiets"
                  class="text-sm font-extrabold text-amber-300 tracking-wide"
                >
                  {t("admin.quickDeploy.defaultDiets")}
                </h3>
                <span class="rounded-full bg-amber-500/15 border border-amber-500/30 px-2 py-0.5 text-[10px] font-bold text-amber-300 uppercase tracking-widest">Smart Nutrition</span>
              </div>
              <p
                data-i18n="admin.quickDeploy.defaultDiets.desc"
                class="text-xs text-zinc-400 mt-0.5"
              >
                {t("admin.quickDeploy.defaultDiets.desc")}
              </p>
            </div>
          </div>
        </div>

        <div
          class="grid grid-cols-1 sm:grid-cols-12 gap-3 pt-3 border-t border-zinc-800"
        >
          <div class="sm:col-span-5">
            <label class="block text-[11px] font-semibold text-zinc-400 mb-1">📋 Plan Nutricional Prediseñado</label>
            <select
              id="preset-diet-template-select"
              class="w-full rounded-xl border border-zinc-700 bg-zinc-950 px-3.5 py-2.5 text-xs text-zinc-100 font-medium focus:outline-none focus:border-amber-400 transition-all"
            >
              <option value="" data-i18n="trainer.selectPresetDiet"
                >{t("trainer.selectPresetDiet")}</option
              >
            </select>
          </div>

          <div class="sm:col-span-4">
            <label class="block text-[11px] font-semibold text-zinc-400 mb-1">👤 Atleta Receptor</label>
            <select
              id="preset-diet-client-select"
              class="w-full rounded-xl border border-zinc-700 bg-zinc-950 px-3.5 py-2.5 text-xs text-zinc-100 font-medium focus:outline-none focus:border-amber-400 transition-all"
            >
              <option value="" data-i18n="diet.editor.client.select"
                >{t("diet.editor.client.select")}</option
              >
            </select>
          </div>

          <div class="sm:col-span-3 flex items-end">
            <button
              id="btn-apply-preset-diet"
              class="w-full rounded-xl bg-gradient-to-r from-amber-500 to-yellow-500 text-zinc-950 px-4 py-2.5 text-xs font-extrabold shadow-[0_0_15px_rgba(245,158,11,0.3)] hover:brightness-110 active:scale-95 transition-all flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span>🚀</span>
              <span id="apply-diet-btn-label">Asignar Dieta</span>
            </button>
          </div>
        </div>

        <!-- Real-Time Diet Template Preview & Allergen Conflict Box -->
        <div id="preset-diet-preview-box" class="hidden rounded-xl border border-amber-500/20 bg-black/60 p-3.5 text-xs space-y-2.5 transition-all">
          <div class="flex items-center justify-between flex-wrap gap-2 border-b border-zinc-800 pb-2">
            <span class="font-bold text-amber-300" id="preview-diet-title">Plan Nutricional</span>
            <div class="flex items-center gap-2" id="preview-diet-tags"></div>
          </div>
          <div id="preview-diet-meals" class="text-zinc-300 space-y-1 max-h-32 overflow-y-auto pr-1"></div>
          <div id="preset-diet-conflicts" class="hidden"></div>
        </div>
      </div>

      <!-- Search and filter -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <input
          id="diet-search"
          type="text"
          placeholder={t("admin.diets.search") || "Buscar dietas..."}
          class="flex-1 min-w-[200px] rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-4 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)]"
        />
        <select
          id="filter-client"
          class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-4 py-2.5 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]"
        >
          <option value="">{t("trainer.selectClient") || "Todos los clientes"}</option>
        </select>
      </div>

      <!-- Diet Editor -->
      <div id="diet-editor" class="hidden mt-6"></div>

      <!-- Diets List -->
      <div id="diets-container" class="mt-6 space-y-3">
        <div
          class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 text-center backdrop-blur-sm"
        >
          <svg
            class="mx-auto h-5 w-5 animate-spin text-[var(--brand)]"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
            ></circle><path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg
          ><p class="mt-2 text-sm text-[var(--text-tertiary)]">{t("admin.loading")}</p>
        </div>
      </div>
    </div>
  </div>
</TrainerLayout>

<script>
  import { logger } from "@/lib/shared/logger";
  import { requireRole } from "@/lib/shared/authGuard";
  import { t, getStoredLanguage } from "@/i18n/client";
  import { ICONS, escapeHtml, renderEmptyState, showToast } from "@/lib/shared/ui";
  import {
    subscribeToClients,
    subscribeToDietsByTrainer,
    createDiet,
    updateDiet,
    deleteDiet,
  } from "@/lib/trainer/trainerUtils";
  import {
    subscribeToDietTemplates,
    applyDietTemplateToClient,
  } from "@/lib/trainer/templateService";
  import {
    subscribeToFoods,
    getFoodName,
    calcMacrosForPortion,
    type FoodItem,
  } from "@/lib/shared/foodLibrary";
  import { checkDietConflicts, type DietConflict } from "@/lib/client/intoleranceChecker";
  import type { DietTemplate } from "@/lib/devtools/types";
  import type { TrainerClient, TrainerDiet, Meal } from "@/lib/trainer/types";
  import type { MedicalProfile } from "@/types";

  let unsubClients: (() => void) | null = null;
  let unsubDiets: (() => void) | null = null;
  let unsubTemplates: (() => void) | null = null;
  let unsubFoods: (() => void) | null = null;

  let allClients: TrainerClient[] = [];
  let allDiets: TrainerDiet[] = [];
  let allTemplates: DietTemplate[] = [];
  let allCatalogFoods: FoodItem[] = [];

  let currentTrainerId = "";
  let editingDiet: TrainerDiet | null = null;
  let currentMeals: Meal[] = [];

  requireRole(["trainer", "admin"], async (user) => {
    initDiets(user.uid);
  });

  window.addEventListener("beforeunload", () => {
    unsubClients?.();
    unsubDiets?.();
    unsubTemplates?.();
    unsubFoods?.();
  });

  function initDiets(trainerId: string): void {
    currentTrainerId = trainerId;
    const container = document.getElementById("diets-container")!;
    const btnCreate = document.getElementById("btn-create-diet")!;
    const searchInput = document.getElementById("diet-search") as HTMLInputElement;
    const filterClientSelect = document.getElementById("filter-client") as HTMLSelectElement;

    const presetDietTemplateSelect = document.getElementById(
      "preset-diet-template-select"
    ) as HTMLSelectElement;
    const presetDietClientSelect = document.getElementById(
      "preset-diet-client-select"
    ) as HTMLSelectElement;
    const btnApplyPresetDiet = document.getElementById(
      "btn-apply-preset-diet"
    ) as HTMLButtonElement;

    unsubFoods = subscribeToFoods((foods) => {
      allCatalogFoods = foods;
      if (!document.getElementById("diet-editor")?.classList.contains("hidden")) {
        renderMealsEditor();
        checkAndRenderConflicts();
      }
    });

    unsubClients = subscribeToClients(trainerId, (clients) => {
      allClients = clients;
      populateClientFilter();
      if (presetDietClientSelect) {
        presetDietClientSelect.innerHTML =
          `<option value="">${t("diet.editor.client.select")}</option>` +
          clients.map((c) => `<option value="${c.uid}">${escapeHtml(c.name)}</option>`).join("");
      }
      renderDiets();
    });

    unsubDiets = subscribeToDietsByTrainer(trainerId, (diets) => {
      allDiets = diets;
      renderDiets();
    });

    unsubTemplates = subscribeToDietTemplates((templates) => {
      allTemplates = templates;
      if (presetDietTemplateSelect) {
        if (templates.length === 0) {
          presetDietTemplateSelect.innerHTML = `<option value="">${t("trainer.noTemplates") || "Sin plantillas disponibles"}</option>`;
        } else {
          presetDietTemplateSelect.innerHTML =
            `<option value="">${t("trainer.selectPresetDiet")} (${templates.length})...</option>` +
            templates
              .map(
                (tmpl) =>
                  `<option value="${tmpl.id}">${escapeHtml(tmpl.name)} (${tmpl.totalCalories || 0} kcal)</option>`
              )
              .join("");
        }
      }
    });

    const updatePresetDietPreview = () => {
      const templateId = presetDietTemplateSelect?.value;
      const clientId = presetDietClientSelect?.value;
      const previewBox = document.getElementById("preset-diet-preview-box");
      const applyBtnLabel = document.getElementById("apply-diet-btn-label");

      const selectedClient = allClients.find((c) => c.uid === clientId);
      if (applyBtnLabel) {
        applyBtnLabel.textContent = selectedClient ? `Asignar a ${escapeHtml(selectedClient.name.split(" ")[0])}` : "Asignar Dieta";
      }

      if (!templateId || !previewBox) {
        previewBox?.classList.add("hidden");
        return;
      }

      const tmpl = allTemplates.find((t) => t.id === templateId);
      if (!tmpl) {
        previewBox.classList.add("hidden");
        return;
      }

      previewBox.classList.remove("hidden");
      const titleEl = document.getElementById("preview-diet-title");
      const tagsEl = document.getElementById("preview-diet-tags");
      const mealsEl = document.getElementById("preview-diet-meals");
      const conflictsEl = document.getElementById("preset-diet-conflicts");

      if (titleEl) titleEl.textContent = tmpl.name;
      if (tagsEl) {
        tagsEl.innerHTML = `
          <span class="px-2 py-0.5 rounded-md border border-amber-500/30 bg-amber-500/20 text-amber-300 text-[10px] font-bold">${tmpl.totalCalories || 0} kcal</span>
          <span class="px-2 py-0.5 rounded-md border border-zinc-700 bg-zinc-800 text-[10px] text-zinc-300 font-semibold">${tmpl.meals?.length || 0} Comidas</span>
        `;
      }

      if (mealsEl) {
        if (!tmpl.meals || tmpl.meals.length === 0) {
          mealsEl.innerHTML = `<p class="text-zinc-500 italic">Esta plantilla no contiene comidas aún.</p>`;
        } else {
          mealsEl.innerHTML = tmpl.meals.map((m, idx) => `
            <div class="flex items-center justify-between py-1 border-b border-zinc-800/60 last:border-0">
              <span class="font-medium text-zinc-200">#${idx + 1} ${escapeHtml(m.name)}</span>
              <span class="text-amber-400/90 font-mono text-[11px]">${m.calories || 0} kcal · P:${m.protein || 0}g C:${m.carbs || 0}g G:${m.fat || 0}g</span>
            </div>
          `).join("");
        }
      }

      // Check conflicts if client has medicalProfile
      if (conflictsEl) {
        if (selectedClient?.medicalProfile && tmpl.meals && tmpl.meals.length > 0) {
          const conflicts = checkDietConflicts(
            tmpl.meals as Meal[],
            allCatalogFoods,
            selectedClient.medicalProfile as MedicalProfile,
            getStoredLanguage()
          );
          if (conflicts.length > 0) {
            conflictsEl.classList.remove("hidden");
            conflictsEl.innerHTML = `
              <div class="mt-2 rounded-lg border border-rose-500/40 bg-rose-500/10 p-2.5 space-y-1">
                <div class="flex items-center gap-1.5 text-rose-400 font-bold text-[11px]">
                  <span>⚠️</span>
                  <span>Alertas de Alérgenos (${conflicts.length}) para ${escapeHtml(selectedClient.name)}</span>
                </div>
                <p class="text-[11px] text-rose-300">${escapeHtml(conflicts[0].message)}</p>
              </div>
            `;
          } else {
            conflictsEl.classList.add("hidden");
            conflictsEl.innerHTML = "";
          }
        } else {
          conflictsEl.classList.add("hidden");
          conflictsEl.innerHTML = "";
        }
      }
    };

    presetDietTemplateSelect?.addEventListener("change", updatePresetDietPreview);
    presetDietClientSelect?.addEventListener("change", updatePresetDietPreview);

    btnApplyPresetDiet?.addEventListener("click", async () => {
      const templateId = presetDietTemplateSelect.value;
      const clientId = presetDietClientSelect.value;
      if (!templateId || !clientId) {
        showToast({ message: "Por favor selecciona una plantilla y un cliente", type: "error" });
        return;
      }
      try {
        btnApplyPresetDiet.disabled = true;
        showToast({ message: "Desplegando dieta predeterminada...", type: "info" });
        await applyDietTemplateToClient(templateId, clientId, trainerId);
        showToast({
          message: "¡Dieta asignada exitosamente! Ya la puedes personalizar.",
          type: "success",
        });

        // Auto-filtrar por cliente asignado
        if (filterClientSelect) {
          filterClientSelect.value = clientId;
          renderDiets();
        }

        presetDietTemplateSelect.value = "";
        updatePresetDietPreview();
      } catch (err: unknown) {
        // 🔒 TIPADO: Sin `any` — se extrae el mensaje solo si es instancia de Error.
        // Si no es Error (ej: string lanzada), se muestra mensaje genérico al usuario.
        const errorMessage = err instanceof Error ? err.message : "Error al asignar plantilla";
        showToast({ message: errorMessage, type: "error" });
      } finally {
        btnApplyPresetDiet.disabled = false;
      }
    });

    btnCreate.addEventListener("click", () => showEditor(null));

    searchInput?.addEventListener("input", () => renderDiets());
    filterClientSelect?.addEventListener("change", () => renderDiets());

    container.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("[data-action]");
      if (!btn) return;
      const action = btn.getAttribute("data-action");
      const dietId = btn.getAttribute("data-diet-id");
      const diet = allDiets.find((d) => d.id === dietId);

      if (action === "edit" && diet) {
        showEditor(diet);
      }
      if (action === "delete" && diet) {
        if (confirm(t("trainer.deleteDiet") + ": " + diet.name + "?")) {
          deleteDiet(diet.id)
            .then((ok) => {
              if (ok) showToast({ message: t("trainer.diets.delete") + " OK", type: "success" });
            })
            .catch((err) => {
              logger.error("TrainerDiets", "Error deleting diet", err);
              showToast({ message: t("common.error"), type: "error" });
            });
        }
      }
    });
  }

  function populateClientFilter(): void {
    const select = document.getElementById("filter-client") as HTMLSelectElement;
    if (!select) return;
    const currentVal = select.value;
    select.innerHTML =
      `<option value="">${t("trainer.selectClient") || "Todos los clientes"}</option>` +
      allClients
        .map(
          (c) =>
            `<option value="${c.uid}" ${c.uid === currentVal ? "selected" : ""}>${escapeHtml(c.name)}</option>`
        )
        .join("");
  }

  function renderDiets(): void {
    const container = document.getElementById("diets-container")!;
    const searchVal = ((document.getElementById("diet-search") as HTMLInputElement)?.value || "")
      .toLowerCase()
      .trim();
    const filterClientId =
      (document.getElementById("filter-client") as HTMLSelectElement)?.value || "";

    const filteredDiets = allDiets.filter((d) => {
      if (filterClientId && d.clientId !== filterClientId) return false;
      if (searchVal) {
        const client = allClients.find((c) => c.uid === d.clientId);
        const clientName = (client?.name || "").toLowerCase();
        const dietName = (d.name || "").toLowerCase();
        return dietName.includes(searchVal) || clientName.includes(searchVal);
      }
      return true;
    });

    if (filteredDiets.length === 0) {
      container.innerHTML = renderEmptyState(ICONS.diets, t("trainer.client.no.diets"));
      return;
    }

    container.innerHTML = filteredDiets
      .map((d) => {
        const client = allClients.find((c) => c.uid === d.clientId);
        const clientName = client ? client.name : t("common.client");
        const mealCount = d.meals?.length || 0;
        const calories = d.totalCalories || 0;

        const protein =
          d.meals?.reduce((sum, m) => sum + (m.protein || 0), 0) || d.totalProtein || 0;
        const carbs = d.meals?.reduce((sum, m) => sum + (m.carbs || 0), 0) || d.totalCarbs || 0;
        const fat = d.meals?.reduce((sum, m) => sum + (m.fat || 0), 0) || d.totalFat || 0;

        const typeLabels: Record<string, string> = {
          normal: t("diet.editor.type.normal") || "Normocalórica",
          definition: t("diet.editor.type.definition") || "Definición",
          volume: t("diet.editor.type.volume") || "Volumen",
          keto: t("diet.editor.type.keto") || "Keto",
          vegan: t("diet.editor.type.vegan") || "Vegana",
          custom: t("diet.editor.type.custom") || "Personalizada",
        };
        const typeBadge = typeLabels[d.type] || d.type || t("diet.editor.type.custom");

        return `
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm transition-all hover:border-[var(--border-strong)]">
            <div class="flex items-start justify-between gap-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <p class="text-sm font-semibold text-[var(--text-primary)]">${escapeHtml(d.name)}</p>
                  <span class="rounded-full bg-[var(--brand-dim)] px-2 py-0.5 text-[10px] font-semibold text-[var(--brand)] border border-[var(--border-brand)]">${escapeHtml(typeBadge)}</span>
                </div>
                <p class="text-xs text-[var(--text-tertiary)] flex items-center gap-1.5">
                  <svg class="h-3.5 w-3.5 text-[var(--text-disabled)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                  </svg>
                  ${escapeHtml(clientName)}
                  <span>•</span>
                  <span>${mealCount} ${mealCount !== 1 ? t("diet.meals") || "comidas" : t("diet.meal") || "comida"}</span>
                </p>

                <!-- Macros resume bar -->
                <div class="mt-2.5 flex items-center gap-2 text-xs flex-wrap">
                  <span class="rounded-md bg-amber-500/10 px-2 py-0.5 font-medium text-amber-400 border border-amber-500/20">${calories} kcal</span>
                  <span class="rounded-md bg-emerald-500/10 px-2 py-0.5 font-medium text-emerald-400 border border-emerald-500/20">Prot: ${protein}g</span>
                  <span class="rounded-md bg-blue-500/10 px-2 py-0.5 font-medium text-blue-400 border border-blue-500/20">Carbs: ${carbs}g</span>
                  <span class="rounded-md bg-purple-500/10 px-2 py-0.5 font-medium text-purple-400 border border-purple-500/20">${t("client.macros.fat") || "Grasas"}: ${fat}g</span>
                </div>
              </div>

              <div class="flex items-center gap-1.5 shrink-0">
                <button
                  data-action="edit"
                  data-diet-id="${d.id}"
                  class="rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-all"
                >
                  ${t("common.edit")}
                </button>
                <button
                  data-action="delete"
                  data-diet-id="${d.id}"
                  class="rounded-lg border border-red-500/30 bg-[var(--danger-dim)] px-3 py-1.5 text-xs font-medium text-[var(--danger)] hover:bg-[var(--danger-dim)] transition-all"
                >
                  ${t("common.delete")}
                </button>
              </div>
            </div>
          </div>
        `;
      })
      .join("");
  }

  function checkAndRenderConflicts(): void {
    const clientSelect = document.getElementById("diet-client") as HTMLSelectElement;
    const conflictBox = document.getElementById("diet-conflicts-banner");
    if (!conflictBox || !clientSelect) return;

    const clientId = clientSelect.value;
    const client = allClients.find((c) => c.uid === clientId);
    if (!client || !client.medicalProfile) {
      conflictBox.classList.add("hidden");
      conflictBox.innerHTML = "";
      return;
    }

    const conflicts = checkDietConflicts(
      currentMeals,
      allCatalogFoods,
      client.medicalProfile as MedicalProfile,
      getStoredLanguage()
    );

    if (conflicts.length === 0) {
      conflictBox.classList.add("hidden");
      conflictBox.innerHTML = "";
      return;
    }

    conflictBox.classList.remove("hidden");
    conflictBox.innerHTML = `
      <div class="rounded-xl border border-rose-500/40 bg-rose-500/10 p-4 space-y-2 animate-fade-in">
        <div class="flex items-center gap-2 text-rose-400 font-bold text-xs uppercase tracking-wider">
          <span>⚠️</span>
          <span>Alertas de Conflicto con el Perfil del Cliente (${conflicts.length})</span>
        </div>
        <ul class="space-y-1 text-xs text-rose-300">
          ${conflicts
            .map(
              (c) => `
            <li class="flex items-start gap-1.5">
              <span class="text-rose-400 font-bold">•</span>
              <span><strong>[${c.mealName}]</strong> ${escapeHtml(c.message)}</span>
            </li>
          `
            )
            .join("")}
        </ul>
      </div>
    `;
  }

  function showEditor(diet: TrainerDiet | null): void {
    const editor = document.getElementById("diet-editor")!;
    editingDiet = diet;
    currentMeals = diet && diet.meals ? JSON.parse(JSON.stringify(diet.meals)) : [];

    const isEditing = !!diet;

    editor.innerHTML = `
      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 shadow-2xl backdrop-blur-xl animate-fade-in space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
          <h3 class="text-lg font-bold text-[var(--text-primary)]">
            ${isEditing ? t("diet.editor.title.edit") : t("diet.editor.title.new")}
          </h3>
          <button id="btn-cancel-diet-top" class="text-[var(--text-tertiary)] hover:text-white text-xl">&times;</button>
        </div>

        <!-- Banner de Conflictos Preventivos -->
        <div id="diet-conflicts-banner" class="hidden"></div>

        <!-- Template selection (only for new diets) -->
        ${
          !isEditing && allTemplates.length > 0
            ? `
          <div class="rounded-xl border border-[var(--border-brand)] bg-[var(--brand-dim)] p-4">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-sm font-semibold text-[var(--brand)]">${t("trainer.selectPresetDiet") || "Seleccionar plantilla"}</p>
                <p class="text-xs text-[var(--text-tertiary)]">${allTemplates.length} ${t("trainer.templates") || "plantillas disponibles"}</p>
              </div>
              <select id="diet-template" class="rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-sm">
                <option value="">${t("common.select") || "Seleccionar..."}</option>
                ${allTemplates.map((tmpl) => `<option value="${tmpl.id}">${escapeHtml(tmpl.name)} (${tmpl.totalCalories || 0} kcal)</option>`).join("")}
              </select>
            </div>
          </div>
        `
            : ""
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">${t("diet.editor.name.label")}</label>
            <input
              id="diet-name"
              type="text"
              value="${escapeHtml(diet?.name || "")}"
              placeholder="${t("diet.editor.name.placeholder")}"
              class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)]"
            />
            <p id="diet-name-error" class="mt-1 text-xs text-[var(--danger)] hidden">${t("diet.editor.name.error")}</p>
          </div>

          <div>
            <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">${t("diet.editor.client.label")}</label>
            <select
              id="diet-client"
              class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]"
            >
              <option value="">${t("diet.editor.client.select")}</option>
              ${allClients.map((c) => `<option value="${c.uid}" ${c.uid === diet?.clientId ? "selected" : ""}>${escapeHtml(c.name)} (${escapeHtml(c.email)})</option>`).join("")}
            </select>
            <p id="diet-client-error" class="mt-1 text-xs text-[var(--danger)] hidden">${t("diet.editor.client.error")}</p>
          </div>

          <div>
            <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">${t("diet.editor.type.label")}</label>
            <select
              id="diet-type"
              class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]"
            >
              <option value="normal" ${diet?.type === "normal" ? "selected" : ""}>${t("diet.editor.type.normal")}</option>
              <option value="definition" ${diet?.type === "definition" ? "selected" : ""}>${t("diet.editor.type.definition")}</option>
              <option value="volume" ${diet?.type === "volume" ? "selected" : ""}>${t("diet.editor.type.volume")}</option>
              <option value="keto" ${diet?.type === "keto" ? "selected" : ""}>${t("diet.editor.type.keto")}</option>
              <option value="vegan" ${diet?.type === "vegan" ? "selected" : ""}>${t("diet.editor.type.vegan")}</option>
              <option value="custom" ${diet?.type === "custom" ? "selected" : ""}>${t("diet.editor.type.custom")}</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">${t("diet.editor.somatotype.label")}</label>
            <select
              id="diet-somatotype"
              class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]"
            >
              <option value="">${t("diet.editor.somatotype.none")}</option>
              <option value="ectomorph" ${diet?.somatotype === "ectomorph" ? "selected" : ""}>${t("diet.editor.somatotype.ectomorph")}</option>
              <option value="mesomorph" ${diet?.somatotype === "mesomorph" ? "selected" : ""}>${t("diet.editor.somatotype.mesomorph")}</option>
              <option value="endomorph" ${diet?.somatotype === "endomorph" ? "selected" : ""}>${t("diet.editor.somatotype.endomorph")}</option>
            </select>
          </div>
        </div>

        <!-- Macronutrients banner -->
        <div class="rounded-xl border border-[var(--border-brand)] bg-[var(--brand-dim)] p-4">
          <div class="flex items-center justify-between flex-wrap gap-2 text-xs">
            <span class="font-bold text-[var(--brand)] uppercase tracking-wider text-[10px]">${t("diet.editor.calories.label")}:</span>
            <div class="flex items-center gap-3 font-semibold text-[var(--text-primary)] flex-wrap">
              <span>🔥 <span id="calc-calories">0</span> kcal</span>
              <span>🥩 Prot: <span id="calc-protein">0</span>g</span>
              <span>🍚 Carbs: <span id="calc-carbs">0</span>g</span>
              <span>🥑 Grasas: <span id="calc-fat">0</span>g</span>
            </div>
          </div>
        </div>

        <!-- Meals section -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="text-sm font-bold text-[var(--text-primary)]">${t("diet.editor.meals.title")}</h4>
            <button
              type="button"
              id="btn-add-meal"
              class="flex items-center gap-1 text-xs font-semibold text-[var(--brand)] hover:underline"
            >
              + {t("diet.editor.meals.addBtn")}
            </button>
          </div>

          <div id="meals-editor-container" class="space-y-3"></div>
        </div>

        <!-- Action buttons -->
        <div class="flex items-center gap-3 pt-3 border-t border-[var(--border-subtle)]">
          <button
            id="btn-save-diet"
            class="flex-1 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-5 py-2.5 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all hover:opacity-95"
          >
            ${isEditing ? t("diet.editor.save.edit") : t("diet.editor.save.new")}
          </button>
          <button
            id="btn-cancel-diet"
            class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-5 py-2.5 text-sm font-medium text-[var(--text-secondary)] hover:text-white"
          >
            {t("diet.editor.cancel")}
          </button>
        </div>
      </div>
    `;

    editor.classList.remove("hidden");
    editor.scrollIntoView({ behavior: "smooth" });

    renderMealsEditor();
    updateCalculatedMacros();
    checkAndRenderConflicts();

    const clientSelect = document.getElementById("diet-client") as HTMLSelectElement;
    clientSelect?.addEventListener("change", () => checkAndRenderConflicts());

    // Event listeners
    const templateSelect = document.getElementById("diet-template") as HTMLSelectElement;
    if (templateSelect) {
      templateSelect.addEventListener("change", async () => {
        const templateId = templateSelect.value;
        if (!templateId) return;

        const clientId = (document.getElementById("diet-client") as HTMLSelectElement).value;
        if (!clientId) {
          showToast({ message: t("diet.editor.client.error"), type: "error" });
          templateSelect.value = "";
          return;
        }

        try {
          showToast({ message: t("diet.editor.saving"), type: "info" });
          await applyDietTemplateToClient(templateId, clientId, currentTrainerId);
          showToast({
            message: t("trainer.templates.load") || "Plantilla cargada",
            type: "success",
          });
          closeEditor();
        } catch (err) {
          logger.error("TrainerDiets", "Error loading template", err);
          showToast({ message: t("common.error"), type: "error" });
        }
      });
    }

    document.getElementById("btn-add-meal")!.addEventListener("click", () => {
      const newMeal: Meal = {
        id: "m-" + Date.now() + "-" + Math.random().toString(36).substring(2, 5),
        name: "breakfast",
        description: "",
        calories: 350,
        protein: 20,
        carbs: 40,
        fat: 10,
        order: currentMeals.length + 1,
        portionGrams: 100,
      };
      currentMeals.push(newMeal);
      renderMealsEditor();
      updateCalculatedMacros();
      checkAndRenderConflicts();
    });

    document.getElementById("btn-cancel-diet-top")!.addEventListener("click", closeEditor);
    document.getElementById("btn-cancel-diet")!.addEventListener("click", closeEditor);

    document.getElementById("btn-save-diet")!.addEventListener("click", async () => {
      const nameInput = document.getElementById("diet-name") as HTMLInputElement;
      const clientSelectEl = document.getElementById("diet-client") as HTMLSelectElement;
      const typeSelect = document.getElementById("diet-type") as HTMLSelectElement;
      const somatotypeSelect = document.getElementById("diet-somatotype") as HTMLSelectElement;

      const name = nameInput.value.trim();
      const clientId = clientSelectEl.value;
      const type = typeSelect.value as TrainerDiet["type"];
      const somatotype = somatotypeSelect.value as TrainerDiet["somatotype"];

      let isValid = true;

      if (!name) {
        document.getElementById("diet-name-error")!.classList.remove("hidden");
        nameInput.classList.add("border-[var(--danger)]");
        isValid = false;
      } else {
        document.getElementById("diet-name-error")!.classList.add("hidden");
        nameInput.classList.remove("border-[var(--danger)]");
      }

      if (!clientId) {
        document.getElementById("diet-client-error")!.classList.remove("hidden");
        clientSelectEl.classList.add("border-[var(--danger)]");
        isValid = false;
      } else {
        document.getElementById("diet-client-error")!.classList.add("hidden");
        clientSelectEl.classList.remove("border-[var(--danger)]");
      }

      if (!isValid) {
        showToast({
          message: t("common.validationError") || "Por favor corrige los errores",
          type: "error",
        });
        return;
      }

      const client = allClients.find((c) => c.uid === clientId);
      if (client?.medicalProfile) {
        const conflicts = checkDietConflicts(
          currentMeals,
          allCatalogFoods,
          client.medicalProfile as MedicalProfile,
          getStoredLanguage()
        );
        if (conflicts.length > 0) {
          const proceed = confirm(
            `⚠️ Atención: Se han detectado ${conflicts.length} conflicto(s) con las restricciones del cliente.\n\n¿Deseas guardar el plan de todos modos?`
          );
          if (!proceed) return;
        }
      }

      const totalCalories = currentMeals.reduce((sum, m) => sum + (m.calories || 0), 0);
      const totalProtein = currentMeals.reduce((sum, m) => sum + (m.protein || 0), 0);
      const totalCarbs = currentMeals.reduce((sum, m) => sum + (m.carbs || 0), 0);
      const totalFat = currentMeals.reduce((sum, m) => sum + (m.fat || 0), 0);

      try {
        if (isEditing && diet) {
          await updateDiet(diet.id, {
            name,
            clientId,
            trainerId: currentTrainerId,
            type,
            somatotype,
            totalCalories,
            totalProtein,
            totalCarbs,
            totalFat,
            meals: currentMeals,
          });
          showToast({ message: t("diet.editor.save.edit") + " OK", type: "success" });
        } else {
          await createDiet({
            clientId,
            trainerId: currentTrainerId,
            name,
            type,
            somatotype,
            totalCalories,
            totalProtein,
            totalCarbs,
            totalFat,
            meals: currentMeals,
          });
          showToast({ message: t("diet.editor.save.new") + " OK", type: "success" });
        }
        closeEditor();
      } catch (err) {
        logger.error("TrainerDiets", "Error saving diet", err);
        showToast({ message: t("common.error"), type: "error" });
      }
    });
  }

  function renderMealsEditor(): void {
    const container = document.getElementById("meals-editor-container")!;
    if (currentMeals.length === 0) {
      container.innerHTML = `<p class="text-xs text-[var(--text-tertiary)] text-center py-4">${t("diet.editor.meals.empty")}</p>`;
      return;
    }

    container.innerHTML = currentMeals
      .map((meal, index) => {
        const selectedFood = meal.foodId ? allCatalogFoods.find((f) => f.id === meal.foodId) : null;
        return `
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-4 space-y-3 animate-fade-in">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-2">
                <select
                  class="meal-name rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5 text-xs font-medium text-[var(--text-primary)]"
                  data-meal-index="${index}"
                >
                  <option value="breakfast" ${meal.name === "breakfast" ? "selected" : ""}>${t("diet.editor.meal.breakfast")}</option>
                  <option value="lunch" ${meal.name === "lunch" ? "selected" : ""}>${t("diet.editor.meal.lunch")}</option>
                  <option value="snack" ${meal.name === "snack" ? "selected" : ""}>${t("diet.editor.meal.snack")}</option>
                  <option value="dinner" ${meal.name === "dinner" ? "selected" : ""}>${t("diet.editor.meal.dinner")}</option>
                  <option value="other" ${meal.name === "other" ? "selected" : ""}>${t("diet.editor.meal.other")}</option>
                </select>
                <span class="text-[11px] text-[var(--text-tertiary)] font-semibold">#${index + 1}</span>
              </div>
              <button
                class="text-xs text-[var(--danger)] hover:underline font-medium"
                data-action="remove-meal"
                data-meal-index="${index}"
              >
                ${t("common.delete")}
              </button>
            </div>

            <!-- Selector del catálogo de alimentos -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
              <div class="sm:col-span-2">
                <label class="block text-[10px] font-medium text-[var(--text-secondary)] mb-1">
                  🍎 Alimento del catálogo central:
                </label>
                <select
                  class="meal-food-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]"
                  data-meal-index="${index}"
                >
                  <option value="">Personalizado (texto libre / sin catálogo)</option>
                  ${allCatalogFoods
                    .map(
                      (f) => `
                    <option value="${f.id}" ${meal.foodId === f.id ? "selected" : ""}>
                      ${escapeHtml(getFoodName(f, getStoredLanguage()))} (${f.category}) — ${f.calories100g} kcal/100g
                    </option>
                  `
                    )
                    .join("")}
                </select>
              </div>

              <div>
                <label class="block text-[10px] font-medium text-[var(--text-secondary)] mb-1">
                  ⚖️ Cantidad (gramos):
                </label>
                <input
                  type="number"
                  class="meal-portion w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]"
                  value="${meal.portionGrams || (selectedFood ? selectedFood.defaultPortion : 100)}"
                  data-meal-index="${index}"
                  min="1"
                  step="5"
                />
              </div>
            </div>

            <div>
              <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">Descripción / Receta:</label>
              <textarea
                class="meal-desc w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-2 text-xs text-[var(--text-primary)] resize-none focus:outline-none focus:border-[var(--border-brand)]"
                rows="2"
                placeholder="${t("diet.editor.meal.descPlaceholder")}"
                data-meal-index="${index}"
              >${escapeHtml(meal.description || "")}</textarea>
            </div>

            <div class="grid grid-cols-4 gap-2">
              <div>
                <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">${t("diet.editor.meal.calories")}</label>
                <input
                  type="number"
                  class="meal-calories w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-2 py-1.5 text-xs text-[var(--text-primary)]"
                  value="${meal.calories || 0}"
                  data-meal-index="${index}"
                />
              </div>
              <div>
                <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">${t("diet.editor.meal.protein")}</label>
                <input
                  type="number"
                  step="0.1"
                  class="meal-protein w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-2 py-1.5 text-xs text-[var(--text-primary)]"
                  value="${meal.protein || 0}"
                  data-meal-index="${index}"
                />
              </div>
              <div>
                <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">${t("diet.editor.meal.carbs")}</label>
                <input
                  type="number"
                  step="0.1"
                  class="meal-carbs w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-2 py-1.5 text-xs text-[var(--text-primary)]"
                  value="${meal.carbs || 0}"
                  data-meal-index="${index}"
                />
              </div>
              <div>
                <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">${t("diet.editor.meal.fat")}</label>
                <input
                  type="number"
                  step="0.1"
                  class="meal-fat w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-2 py-1.5 text-xs text-[var(--text-primary)]"
                  value="${meal.fat || 0}"
                  data-meal-index="${index}"
                />
              </div>
            </div>

            <!-- Allergens -->
            <div class="pt-1">
              <label class="block text-[10px] text-[var(--text-tertiary)] mb-1">${t("diet.editor.meal.allergens")}</label>
              <div class="flex flex-wrap gap-2">
                ${["gluten", "lactose", "nuts", "shellfish", "egg", "soy", "fish"]
                  .map(
                    (allergen) => `
                  <label class="flex items-center gap-1 text-[10px] text-[var(--text-secondary)] cursor-pointer">
                    <input
                      type="checkbox"
                      class="meal-allergen accent-[var(--brand)]"
                      value="${allergen}"
                      data-meal-index="${index}"
                      ${(meal.allergens || []).includes(allergen) ? "checked" : ""}
                    />
                    ${allergen}
                  </label>
                `
                  )
                  .join("")}
              </div>
            </div>
          </div>
        `;
      })
      .join("");

    // Add event listeners
    container.querySelectorAll("[data-action='remove-meal']").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute("data-meal-index") || "0");
        currentMeals.splice(index, 1);
        renderMealsEditor();
        updateCalculatedMacros();
        checkAndRenderConflicts();
      });
    });

    container.querySelectorAll(".meal-food-select").forEach((select) => {
      select.addEventListener("change", (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute("data-meal-index") || "0");
        const foodId = (e.target as HTMLSelectElement).value;
        if (!currentMeals[index]) return;

        if (!foodId) {
          currentMeals[index].foodId = undefined;
          renderMealsEditor();
          checkAndRenderConflicts();
          return;
        }

        const food = allCatalogFoods.find((f) => f.id === foodId);
        if (food) {
          currentMeals[index].foodId = food.id;
          const grams = currentMeals[index].portionGrams || food.defaultPortion || 100;
          currentMeals[index].portionGrams = grams;
          const macros = calcMacrosForPortion(food, grams);
          currentMeals[index].calories = macros.calories;
          currentMeals[index].protein = macros.protein;
          currentMeals[index].carbs = macros.carbs;
          currentMeals[index].fat = macros.fat;
          currentMeals[index].allergens = [...(food.allergens || [])];
          if (!currentMeals[index].description) {
            currentMeals[index].description =
              `${grams}g de ${getFoodName(food, getStoredLanguage())}`;
          }
          renderMealsEditor();
          updateCalculatedMacros();
          checkAndRenderConflicts();
        }
      });
    });

    container.querySelectorAll(".meal-portion").forEach((input) => {
      input.addEventListener("input", (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute("data-meal-index") || "0");
        const grams = parseFloat((e.target as HTMLInputElement).value) || 0;
        const currentMeal = currentMeals[index];
        if (!currentMeal) return;
        currentMeal.portionGrams = grams;

        if (currentMeal.foodId) {
          const food = allCatalogFoods.find((f) => f.id === currentMeal.foodId);
          if (food && grams > 0) {
            const macros = calcMacrosForPortion(food, grams);
            currentMeal.calories = macros.calories;
            currentMeal.protein = macros.protein;
            currentMeal.carbs = macros.carbs;
            currentMeal.fat = macros.fat;

            const calInput = container.querySelector(
              `.meal-calories[data-meal-index="${index}"]`
            ) as HTMLInputElement;
            const protInput = container.querySelector(
              `.meal-protein[data-meal-index="${index}"]`
            ) as HTMLInputElement;
            const carbsInput = container.querySelector(
              `.meal-carbs[data-meal-index="${index}"]`
            ) as HTMLInputElement;
            const fatInput = container.querySelector(
              `.meal-fat[data-meal-index="${index}"]`
            ) as HTMLInputElement;

            if (calInput) calInput.value = String(macros.calories);
            if (protInput) protInput.value = String(macros.protein);
            if (carbsInput) carbsInput.value = String(macros.carbs);
            if (fatInput) fatInput.value = String(macros.fat);

            updateCalculatedMacros();
            checkAndRenderConflicts();
          }
        }
      });
    });

    container.querySelectorAll(".meal-name").forEach((select) => {
      select.addEventListener("change", (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute("data-meal-index") || "0");
        if (currentMeals[index]) {
          currentMeals[index].name = (e.target as HTMLSelectElement).value as Meal["name"];
          checkAndRenderConflicts();
        }
      });
    });

    container.querySelectorAll(".meal-desc").forEach((textarea) => {
      textarea.addEventListener("input", (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute("data-meal-index") || "0");
        if (currentMeals[index]) {
          currentMeals[index].description = (e.target as HTMLTextAreaElement).value;
        }
      });
    });

    container
      .querySelectorAll(".meal-calories, .meal-protein, .meal-carbs, .meal-fat")
      .forEach((input) => {
        input.addEventListener("input", (e) => {
          const index = parseInt((e.target as HTMLElement).getAttribute("data-meal-index") || "0");
          const field = (e.target as HTMLElement).classList.contains("meal-calories")
            ? "calories"
            : (e.target as HTMLElement).classList.contains("meal-protein")
              ? "protein"
              : (e.target as HTMLElement).classList.contains("meal-carbs")
                ? "carbs"
                : "fat";
          if (currentMeals[index]) {
            currentMeals[index][field] = parseFloat((e.target as HTMLInputElement).value) || 0;
          }
          updateCalculatedMacros();
        });
      });

    container.querySelectorAll(".meal-allergen").forEach((checkbox) => {
      checkbox.addEventListener("change", (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute("data-meal-index") || "0");
        const allergen = (e.target as HTMLInputElement).value;
        const checked = (e.target as HTMLInputElement).checked;
        if (!currentMeals[index]) return;
        const allergens = currentMeals[index].allergens || [];
        if (checked) {
          if (!allergens.includes(allergen)) allergens.push(allergen);
        } else {
          const idx = allergens.indexOf(allergen);
          if (idx !== -1) allergens.splice(idx, 1);
        }
        currentMeals[index].allergens = allergens;
        checkAndRenderConflicts();
      });
    });
  }

  function updateCalculatedMacros(): void {
    const totalCalories = currentMeals.reduce((sum, m) => sum + (m.calories || 0), 0);
    const totalProtein =
      Math.round(currentMeals.reduce((sum, m) => sum + (m.protein || 0), 0) * 10) / 10;
    const totalCarbs =
      Math.round(currentMeals.reduce((sum, m) => sum + (m.carbs || 0), 0) * 10) / 10;
    const totalFat = Math.round(currentMeals.reduce((sum, m) => sum + (m.fat || 0), 0) * 10) / 10;

    const calEl = document.getElementById("calc-calories");
    const protEl = document.getElementById("calc-protein");
    const carbsEl = document.getElementById("calc-carbs");
    const fatEl = document.getElementById("calc-fat");

    if (calEl) calEl.textContent = String(totalCalories);
    if (protEl) protEl.textContent = String(totalProtein);
    if (carbsEl) carbsEl.textContent = String(totalCarbs);
    if (fatEl) fatEl.textContent = String(totalFat);
  }

  function closeEditor(): void {
    const editor = document.getElementById("diet-editor")!;
    editor.classList.add("hidden");
    editor.innerHTML = "";
    editingDiet = null;
    currentMeals = [];
  }
</script>
