---
import TrainerLayout from "@/layouts/TrainerLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<TrainerLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in space-y-6">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h1 data-i18n="trainer.workouts" class="text-2xl font-bold">{t("trainer.workouts")}</h1>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">
            <span id="workout-count" class="text-[var(--info)] font-medium">0</span>
            <span data-i18n="admin.stat.createdWorkouts">{t("admin.stat.createdWorkouts")}</span>
          </p>
        </div>
        <button id="btn-create-workout" class="rounded-xl bg-[var(--brand)] text-[var(--text-on-brand)] px-4 py-2.5 text-sm font-bold shadow-md hover:opacity-90 transition-all active:scale-95 flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
          </svg>
          <span data-i18n="trainer.workouts.new">{t("trainer.workouts.new")}</span>
        </button>
      </div>

      <!-- Preset Templates Quick-Deploy Banner -->
      <div id="template-banner" class="rounded-2xl border border-[var(--border-brand)] bg-[var(--brand-dim)] p-4 backdrop-blur-xl space-y-3">
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div class="flex items-center gap-2">
            <span class="text-xl">⚡</span>
            <div>
              <h3 data-i18n="admin.quickDeploy.defaultWorkouts" class="text-sm font-bold text-[var(--brand)]">{t("admin.quickDeploy.defaultWorkouts")}</h3>
              <p data-i18n="admin.quickDeploy.defaultWorkouts.desc" class="text-xs text-[var(--text-tertiary)]">{t("admin.quickDeploy.defaultWorkouts.desc")}</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-2 border-t border-[var(--border-subtle)]">
          <select id="preset-template-select" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]">
            <option value="" data-i18n="trainer.loadingRoutineTemplates">{t("trainer.loadingRoutineTemplates")}</option>
          </select>

          <select id="preset-client-select" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]">
            <option value="" data-i18n="trainer.selectClient">{t("trainer.selectClient")}</option>
          </select>

          <button id="btn-apply-preset" class="rounded-xl bg-[var(--brand)] px-4 py-2 text-xs font-bold text-[var(--text-on-brand)] shadow-md hover:opacity-90 transition-all">
            🚀 <span data-i18n="admin.quickDeploy.defaultWorkouts.desc">{t("admin.quickDeploy.defaultWorkouts.desc")}</span>
          </button>
        </div>
      </div>

      <div id="workout-editor" class="hidden"></div>

      <div class="flex items-center gap-3">
        <select id="client-filter" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-4 py-2.5 text-sm text-[var(--text-secondary)] backdrop-blur-sm focus:outline-none focus:border-[var(--border-brand)]">
          <option value="">{t("trainer.filter.all")}</option>
        </select>
      </div>

      <div id="workouts-container" class="space-y-3">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 text-center backdrop-blur-sm">
          <div class="flex items-center justify-center gap-3">
            <svg class="h-5 w-5 animate-spin text-[var(--brand)]" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <p class="text-sm text-[var(--text-tertiary)]">{t("admin.loading")}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</TrainerLayout>

<script>
  import { logger } from "@/lib/shared/logger";
  import { requireAuth } from "@/lib/shared/authGuard";
  import { t } from "@/i18n/client";
  import { ICONS, escapeHtml, renderEmptyState, showToast } from "@/lib/shared/ui";
  import { subscribeToClients, subscribeToWorkoutsByTrainer, createWorkout, updateWorkout, deleteWorkout } from "@/lib/trainer/trainerUtils";
  import { subscribeToWorkoutTemplates, applyWorkoutTemplateToClient } from "@/lib/trainer/templateService";
  import type { TrainerClient, TrainerWorkout, Exercise } from "@/lib/trainer/trainerUtils";
  import type { WorkoutTemplate } from "@/lib/devtools/types";

  let unsubClients: (() => void) | null = null;
  let unsubWorkouts: (() => void) | null = null;
  let unsubTemplates: (() => void) | null = null;
  let allClients: TrainerClient[] = [];
  let allWorkouts: TrainerWorkout[] = [];
  let allTemplates: WorkoutTemplate[] = [];
  let currentTrainerId = "";

  requireAuth(async (user) => { initWorkouts(user.uid); });
  window.addEventListener("beforeunload", () => { unsubClients?.(); unsubWorkouts?.(); unsubTemplates?.(); });

  async function initWorkouts(trainerId: string) {
    currentTrainerId = trainerId;
    const container = document.getElementById("workouts-container")!;
    const editor = document.getElementById("workout-editor")!;
    const btnCreate = document.getElementById("btn-create-workout")!;
    const clientFilter = document.getElementById("client-filter") as HTMLSelectElement;
    const presetTemplateSelect = document.getElementById("preset-template-select") as HTMLSelectElement;
    const presetClientSelect = document.getElementById("preset-client-select") as HTMLSelectElement;
    const btnApplyPreset = document.getElementById("btn-apply-preset") as HTMLButtonElement;
    const workoutCount = document.getElementById("workout-count")!;

    unsubClients = subscribeToClients(trainerId, (clients) => {
      allClients = clients;
      const clientOpts = `<option value="">${t("trainer.filter.all")}</option>` + clients.map(c => `<option value="${c.uid}">${escapeHtml(c.name)}</option>`).join("");
      clientFilter.innerHTML = clientOpts;
      presetClientSelect.innerHTML = `<option value="">${t("diet.editor.client.select")}</option>` + clients.map(c => `<option value="${c.uid}">${escapeHtml(c.name)}</option>`).join("");
      
      const urlClientId = new URLSearchParams(window.location.search).get("clientId");
      if (urlClientId) {
        clientFilter.value = urlClientId;
        presetClientSelect.value = urlClientId;
      }
    });

    unsubWorkouts = subscribeToWorkoutsByTrainer(trainerId, (workouts) => {
      allWorkouts = workouts;
      workoutCount.textContent = String(workouts.length);
      applyFilters();
    });

    unsubTemplates = subscribeToWorkoutTemplates((templates) => {
      allTemplates = templates;
      if (templates.length === 0) {
        presetTemplateSelect.innerHTML = `<option value="">${t("trainer.noTemplates") || "Sin plantillas disponibles"}</option>`;
      } else {
        presetTemplateSelect.innerHTML = `<option value="">${t("trainer.selectPresetRoutine")} (${templates.length})...</option>` +
          templates.map(tmpl => `<option value="${tmpl.id}">${escapeHtml(tmpl.name)} (${tmpl.exercises?.length || 0} ${t("trainer.exercises").toLowerCase()})</option>`).join("");
      }
    });

    btnApplyPreset.addEventListener("click", async () => {
      const templateId = presetTemplateSelect.value;
      const clientId = presetClientSelect.value;
      if (!templateId || !clientId) {
        showToast({ message: t("common.validationError") || "Por favor selecciona una plantilla y un cliente", type: "error" });
        return;
      }
      try {
        btnApplyPreset.disabled = true;
        showToast({ message: t("common.saving") || "Desplegando rutina predeterminada...", type: "info" });
        await applyWorkoutTemplateToClient(templateId, clientId, trainerId);
        showToast({ message: t("common.saveChanges") || "¡Rutina asignada exitosamente!", type: "success" });
        presetTemplateSelect.value = "";
      } catch (err: any) {
        showToast({ message: err.message || t("common.error"), type: "error" });
      } finally {
        btnApplyPreset.disabled = false;
      }
    });

    clientFilter.addEventListener("change", () => applyFilters());
    btnCreate.addEventListener("click", () => { showEditor(null, trainerId, clientFilter.value || ""); });

    container.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest("[data-action]");
      if (!btn) return;
      const action = btn.getAttribute("data-action");
      const workoutId = btn.getAttribute("data-workout-id");
      const workout = allWorkouts.find(w => w.id === workoutId);
      if (action === "edit" && workout) showEditor(workout, trainerId, workout.clientId);
      if (action === "delete" && workout && confirm(t("trainer.deleteRoutine") + ": " + workout.name + "?")) {
        deleteWorkout(workout.id).then(() => showToast({ message: t("common.delete") + " OK", type: "success" }))
          .catch(err => logger.error("TrainerWorkouts", "Error deleting workout", err));
      }
    });
  }

  function applyFilters() {
    const container = document.getElementById("workouts-container")!;
    const clientId = (document.getElementById("client-filter") as HTMLSelectElement).value;
    let filtered = allWorkouts;
    if (clientId) filtered = filtered.filter(w => w.clientId === clientId);
    if (filtered.length === 0) {
      container.innerHTML = renderEmptyState(ICONS.workouts, t("trainer.client.no.workouts"));
    } else {
      container.innerHTML = filtered.map(w => {
        const client = allClients.find(c => c.uid === w.clientId);
        const clientName = client ? client.name : t("common.client");
        return `
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm flex items-center justify-between gap-4">
            <div class="space-y-1">
              <p class="text-sm font-semibold text-[var(--text-primary)]">${escapeHtml(w.name)}</p>
              <p class="text-xs text-[var(--text-tertiary)] font-medium">${w.exercises?.length || 0} ${t("trainer.exercises").toLowerCase()} · ${t("common.client")}: <span class="text-[var(--brand)] font-bold">${escapeHtml(clientName)}</span></p>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <button data-action="edit" data-workout-id="${w.id}" class="rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-semibold text-[var(--text-secondary)] hover:text-white transition-all">${t("common.edit")}</button>
              <button data-action="delete" data-workout-id="${w.id}" class="rounded-lg border border-red-500/30 bg-[var(--danger-dim)] px-3 py-1.5 text-xs font-semibold text-[var(--danger)] hover:bg-[var(--danger-dim)] transition-all">${t("common.delete")}</button>
            </div>
          </div>
        `;
      }).join("");
    }
  }

  function showEditor(workout: TrainerWorkout | null, trainerId: string, clientId: string) {
    const editor = document.getElementById("workout-editor")!;
    const isEditing = !!workout;
    const nameVal = workout ? escapeHtml(workout.name) : "";
    const descVal = workout ? escapeHtml(workout.description || "") : "";
    const diffVal = workout ? workout.difficulty || "intermediate" : "intermediate";
    const exercises = workout?.exercises || [];
    const clientOpts = allClients.map(c => `<option value="${c.uid}" ${c.uid === (workout?.clientId || clientId) ? "selected" : ""}>${escapeHtml(c.name)}</option>`).join("");

    const dayOptions = [1,2,3,4,5,6,7].map(d => `<option value="${d}">${t("client.stats.days")} ${d}</option>`).join("");

    const exercisesHTML = exercises.length === 0 ? `<p class="text-xs text-[var(--text-tertiary)] text-center py-4">${t("trainer.noExercises")}</p>` :
      exercises.map((ex,i) => renderExerciseRow(ex,i,dayOptions,ex.dayOfWeek || 1)).join("");

    editor.innerHTML = `
      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 backdrop-blur-xl shadow-2xl space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
          <h3 class="text-lg font-bold text-[var(--text-primary)]">${isEditing ? t("trainer.workouts.edit") : t("trainer.workouts.new")}</h3>
          <button id="btn-cancel-workout-top" class="text-[var(--text-tertiary)] hover:text-white text-xl">&times;</button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">Nombre de Rutina</label>
            <input id="workout-name" type="text" value="${nameVal}" placeholder="${t("trainer.routineName")}" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)]" />
          </div>

          <div>
            <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">Cliente Asignado</label>
            <select id="workout-client" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]">
              <option value="">Selecciona Cliente...</option>
              ${clientOpts}
            </select>
          </div>
        </div>

        <textarea id="workout-desc" rows="2" placeholder="${t("trainer.description")}" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)] resize-none">${descVal}</textarea>

        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="text-sm font-bold text-[var(--text-primary)]">Ejercicios de la Rutina</h4>
            <button id="btn-add-exercise" type="button" class="text-xs font-bold text-[var(--brand)] hover:underline">+ Agregar Ejercicio</button>
          </div>
          <div id="exercises-list" class="space-y-3">${exercisesHTML}</div>
        </div>

        <div class="flex items-center gap-3 pt-3 border-t border-[var(--border-subtle)]">
          <button id="btn-save-workout" class="flex-1 rounded-xl bg-[var(--brand)] px-5 py-2.5 text-xs font-bold text-[var(--text-on-brand)] shadow-md transition-all hover:opacity-90">
            ${isEditing ? "Guardar Cambios" : "Crear Rutina"}
          </button>
          <button id="btn-cancel-workout" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-5 py-2.5 text-xs font-bold text-[var(--text-secondary)]">
            Cancelar
          </button>
        </div>
      </div>
    `;

    editor.classList.remove("hidden");
    editor.scrollIntoView({ behavior: "smooth" });

    document.getElementById("btn-cancel-workout")?.addEventListener("click", () => editor.classList.add("hidden"));
    document.getElementById("btn-cancel-workout-top")?.addEventListener("click", () => editor.classList.add("hidden"));

    document.getElementById("btn-save-workout")?.addEventListener("click", async () => {
      const name = (document.getElementById("workout-name") as HTMLInputElement).value.trim();
      const targetClientId = (document.getElementById("workout-client") as HTMLSelectElement).value;
      const desc = (document.getElementById("workout-desc") as HTMLTextAreaElement).value.trim();

      if (!name || !targetClientId) {
        showToast({ message: "Nombre de rutina y cliente son obligatorios", type: "error" });
        return;
      }

      const exerciseRows = document.querySelectorAll(".exercise-row");
      const updatedExercises: Exercise[] = [];
      exerciseRows.forEach((row, idx) => {
        const exName = (row.querySelector(".ex-name") as HTMLInputElement).value.trim();
        const exSets = parseInt((row.querySelector(".ex-sets") as HTMLInputElement).value) || 3;
        const exReps = parseInt((row.querySelector(".ex-reps") as HTMLInputElement).value) || 10;
        const exRest = (row.querySelector(".ex-rest") as HTMLInputElement).value.trim() || "60s";
        const exDay = parseInt((row.querySelector(".ex-day") as HTMLSelectElement).value) || 1;
        if (exName) {
          updatedExercises.push({
            id: `ex-${Date.now()}-${idx}`,
            name: exName,
            sets: exSets,
            reps: exReps,
            restTime: exRest,
            videoUrl: "",
            description: "",
            order: idx + 1,
            dayOfWeek: exDay,
          });
        }
      });

      try {
        showToast({ message: "Guardando rutina...", type: "info" });
        if (isEditing && workout) {
          await updateWorkout(workout.id, {
            name,
            clientId: targetClientId,
            description: desc,
            exercises: updatedExercises,
          });
        } else {
          await createWorkout({
            trainerId,
            clientId: targetClientId,
            name,
            description: desc,
            difficulty: diffVal as any,
            exercises: updatedExercises,
          });
        }
        showToast({ message: "Rutina guardada correctamente", type: "success" });
        editor.classList.add("hidden");
      } catch (err: any) {
        showToast({ message: err.message || "Error al guardar rutina", type: "error" });
      }
    });
  }

  function renderExerciseRow(ex: Exercise, index: number, dayOptions: string, selectedDay: number): string {
    return `
      <div class="exercise-row rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-3 space-y-2">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <input type="text" value="${escapeHtml(ex.name)}" placeholder="Nombre del Ejercicio" class="ex-name w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-1)] px-3 py-1.5 text-xs text-[var(--text-primary)]" />
          <select class="ex-day w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-1)] px-3 py-1.5 text-xs text-[var(--text-primary)]">
            ${[1,2,3,4,5,6,7].map(d => `<option value="${d}" ${d === selectedDay ? "selected" : ""}>Día ${d}</option>`).join("")}
          </select>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <div><span class="text-[10px] text-[var(--text-tertiary)]">Series:</span><input type="number" value="${ex.sets || 3}" class="ex-sets w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-1)] px-2 py-1 text-xs text-[var(--text-primary)]" /></div>
          <div><span class="text-[10px] text-[var(--text-tertiary)]">Reps:</span><input type="number" value="${ex.reps || 10}" class="ex-reps w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-1)] px-2 py-1 text-xs text-[var(--text-primary)]" /></div>
          <div><span class="text-[10px] text-[var(--text-tertiary)]">Descanso:</span><input type="text" value="${escapeHtml(ex.restTime || "60s")}" class="ex-rest w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-1)] px-2 py-1 text-xs text-[var(--text-primary)]" /></div>
        </div>
      </div>
    `;
  }
</script>