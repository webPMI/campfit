---
import TrainerLayout from "@/layouts/TrainerLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<TrainerLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold">{t("trainer.workouts")}</h1>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">
            <span id="workout-count" class="text-[var(--info)] font-medium">0</span>
            {t("admin.workouts.total")}
          </p>
        </div>
        <button id="btn-create-workout" class="rounded-xl bg-[var(--brand-dim)] border border-[var(--border-brand)] px-4 py-2 text-sm font-medium text-[var(--brand)] hover:bg-[var(--brand-dim)] transition-all active:scale-95">
          <svg class="h-4 w-4 inline-block mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
          </svg>
          {t("trainer.workouts.new")}
        </button>
      </div>

      <div id="workout-editor" class="hidden mt-8"></div>

      <div class="mt-6">
        <select id="client-filter" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-4 py-2.5 text-sm text-[var(--text-secondary)] backdrop-blur-sm focus:outline-none focus:border-[var(--border-brand)]">
          <option value="">{t("trainer.filter.all")}</option>
        </select>
      </div>

      <div id="workouts-container" class="mt-6 space-y-3">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 text-center backdrop-blur-sm">
          <div class="flex items-center justify-center gap-3">
            <svg class="h-5 w-5 animate-spin text-[var(--brand)]" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <p class="text-sm text-[var(--text-tertiary)]">{t("admin.loading")}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</TrainerLayout>

<script>
  import { logger } from "@/lib/shared/logger";
  import { requireAuth } from "@/lib/shared/authGuard";
  import { t } from "@/i18n/client";
  import { ICONS, escapeHtml, renderEmptyState } from "@/lib/shared/ui";
  import { subscribeToClients, subscribeToWorkoutsByTrainer, createWorkout, updateWorkout, deleteWorkout } from "@/lib/trainer/trainerUtils";
  import type { TrainerClient, TrainerWorkout, Exercise } from "@/lib/trainer/trainerUtils";

  let unsubClients = null, unsubWorkouts = null, allClients = [], allWorkouts = [], currentTrainerId = "";

  requireAuth(async (user) => { initWorkouts(user.uid); });
  window.addEventListener("beforeunload", () => { unsubClients?.(); unsubWorkouts?.(); });

  async function initWorkouts(trainerId) {
    currentTrainerId = trainerId;
    const container = document.getElementById("workouts-container")!;
    const editor = document.getElementById("workout-editor")!;
    const btnCreate = document.getElementById("btn-create-workout")!;
    const clientFilter = document.getElementById("client-filter") as HTMLSelectElement;
    const workoutCount = document.getElementById("workout-count")!;

    unsubClients = subscribeToClients(trainerId, (clients) => {
      allClients = clients;
      clientFilter.innerHTML = `<option value="">${t("trainer.filter.all")}</option>` + clients.map(c => `<option value="${c.uid}">${escapeHtml(c.name)}</option>`).join("");
      const urlClientId = new URLSearchParams(window.location.search).get("clientId");
      if (urlClientId) clientFilter.value = urlClientId;
    });

    unsubWorkouts = subscribeToWorkoutsByTrainer(trainerId, (workouts) => {
      allWorkouts = workouts;
      workoutCount.textContent = String(workouts.length);
      applyFilters();
    });

    clientFilter.addEventListener("change", () => applyFilters());
    btnCreate.addEventListener("click", () => { showEditor(null, trainerId, clientFilter.value || ""); });

    container.addEventListener("click", (e) => {
      const target = e.target;
      const btn = target.closest("[data-action]");
      if (!btn) return;
      const action = btn.getAttribute("data-action");
      const workoutId = btn.getAttribute("data-workout-id");
      const workout = allWorkouts.find(w => w.id === workoutId);
      if (action === "edit" && workout) showEditor(workout, trainerId, workout.clientId);
      if (action === "delete" && workout && confirm(t("trainer.deleteRoutine") + ": " + workout.name + "?")) {
        deleteWorkout(workout.id).catch(err => logger.error("TrainerWorkouts", "Error deleting workout", err));
      }
    });
  }

  function applyFilters() {
    const container = document.getElementById("workouts-container")!;
    const clientId = document.getElementById("client-filter").value;
    let filtered = allWorkouts;
    if (clientId) filtered = filtered.filter(w => w.clientId === clientId);
    if (filtered.length === 0) {
      container.innerHTML = renderEmptyState(ICONS.workouts, t("trainer.client.no.workouts"));
    } else {
      container.innerHTML = filtered.map(w => `
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-[var(--text-primary)]">${escapeHtml(w.name)}</p>
              <p class="text-xs text-[var(--text-tertiary)]">${w.exercises?.length || 0} ${t("trainer.exercises").toLowerCase()} · ${escapeHtml(w.clientName || t("common.client"))}</p>
            </div>
            <div class="flex items-center gap-1.5">
              <button data-action="edit" data-workout-id="${w.id}" class="rounded-lg border border-[var(--border-subtle)] px-2.5 py-1.5 text-xs text-[var(--text-secondary)] hover:bg-[var(--surface-3)] transition-all">${t("common.edit")}</button>
              <button data-action="delete" data-workout-id="${w.id}" class="rounded-lg border border-red-900/30 bg-[var(--danger-dim)] px-2.5 py-1.5 text-xs text-[var(--danger)] hover:bg-[var(--danger-dim)] transition-all">${t("common.delete")}</button>
            </div>
          </div>
        </div>
      `).join("");
    }
  }

  function showEditor(workout, trainerId, clientId) {
    const editor = document.getElementById("workout-editor")!;
    const isEditing = !!workout;
    const nameVal = workout ? escapeHtml(workout.name) : "";
    const descVal = workout ? escapeHtml(workout.description || "") : "";
    const diffVal = workout ? workout.difficulty || "intermediate" : "intermediate";
    const exercises = workout?.exercises || [];
    const clientOpts = allClients.map(c => `<option value="${c.uid}" ${c.uid === clientId ? "selected" : ""}>${escapeHtml(c.name)}</option>`).join("");

    const dayOptions = [1,2,3,4,5,6,7].map(d => `<option value="${d}">${t("client.stats.days")} ${d}</option>`).join("");

    const exercisesHTML = exercises.length === 0 ? `<p class="text-xs text-[var(--text-tertiary)] text-center py-4">${t("trainer.noExercises")}</p>` :
      exercises.map((ex,i) => renderExerciseRow(ex,i,dayOptions,ex.dayOfWeek || 1)).join("");

    editor.innerHTML = `
      <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 backdrop-blur-xl">
        <h3 class="text-lg font-semibold text-[var(--text-primary)] mb-4">${isEditing ? t("trainer.workouts.edit") : t("trainer.workouts.new")}</h3>
        <div class="space-y-3">
          <input id="workout-name" type="text" value="${nameVal}" placeholder="${t("trainer.routineName")}" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)]" />
          <p id="workout-name-error" class="mt-1 hidden text-xs text-[var(--danger)]">${t("trainer.nameRequired")}</p>
          <textarea id="workout-desc" rows="2" placeholder="${t("trainer.description")}" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)] resize-none">${descVal}</textarea>
          <select id="workout-difficulty" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-sm text-[var(--text-secondary)] focus:outline-none focus:border-[var(--border-brand)]">
            <option value="beginner" ${diffVal==="beginner"?"selected":""}>${t("onboarding.experience.beginner")}</option>
            <option value="intermediate" ${diffVal==="intermediate"?"selected":""}>${t("onboarding.experience.intermediate")}</option>
            <option value="advanced" ${diffVal==="advanced"?"selected":""}>${t("onboarding.experience.advanced")}</option>
          </select>
          ${clientId ? `<input type="hidden" id="workout-client" value="${clientId}" />` : `<select id="workout-client" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-sm text-[var(--text-secondary)] focus:outline-none focus:border-[var(--border-brand)]"><option value="">${t("trainer.selectClient")}</option>${clientOpts}</select>`}
          <div>
            <div class="flex items-center justify-between mb-2"><label class="text-sm font-medium text-[var(--text-secondary)]">${t("trainer.exercises")}</label><button id="add-exercise-btn" class="rounded-lg bg-[var(--brand-dim)] border border-[var(--border-brand)] px-2.5 py-1 text-xs font-medium text-[var(--brand)] hover:bg-[var(--brand-dim)] transition-all">+ ${t("common.create")}</button></div>
            <div id="exercises-list" class="space-y-2">${exercisesHTML}</div>
          </div>
          <div class="flex items-center gap-2 pt-2">
            <button id="btn-save-workout" class="flex-1 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-4 py-2.5 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all hover:shadow-[var(--shadow-glow-md)] active:scale-[0.98]">
              <span id="save-btn-text">${isEditing ? t("trainer.workouts.edit") : t("trainer.workouts.create")}</span>
              <span id="save-btn-spinner" class="hidden"><svg class="h-4 w-4 animate-spin inline" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg></span>
            </button>
            <button id="btn-cancel-workout" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-4 py-2.5 text-sm text-[var(--text-secondary)] hover:bg-[var(--surface-4)] transition-all">${t("common.cancel")}</button>
          </div>
        </div>
      </div>`;

    editor.classList.remove("hidden");
    bindEditorEvents(trainerId, isEditing, workout, dayOptions);
  }

  function renderExerciseRow(exercise, index, dayOptions, selectedDay = 1) {
    const dayOptionsSelected = dayOptions.replace(`value="${selectedDay}"`, `value="${selectedDay}" selected`);
    return `<div data-exercise-row class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-3 backdrop-blur-sm">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xs text-[var(--text-disabled)] font-medium w-5">#${index+1}</span>
        <input type="text" value="${escapeHtml(exercise.name)}" placeholder="${t("workout.exercise.name.placeholder")}" class="flex-1 min-w-0 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)]" />
        <select class="w-24 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2 py-1.5 text-xs text-[var(--text-secondary)] focus:outline-none focus:border-[var(--border-brand)]">${dayOptionsSelected}</select>
        <button data-remove-exercise class="rounded-lg border border-red-900/30 bg-[var(--danger-dim)] px-2 py-1.5 text-xs text-[var(--danger)] hover:bg-[var(--danger-dim)] transition-all">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1.5"><label class="text-[10px] text-[var(--text-disabled)]">Series</label><input type="number" value="${exercise.sets||3}" min="1" max="10" class="w-14 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]" /></div>
        <div class="flex items-center gap-1.5"><label class="text-[10px] text-[var(--text-disabled)]">Reps</label><input type="number" value="${exercise.reps||10}" min="1" max="50" class="w-14 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]" /></div>
        <div class="flex items-center gap-1.5"><label class="text-[10px] text-[var(--text-disabled)]">Descanso</label><input type="text" value="${escapeHtml(exercise.restTime||"60s")}" class="w-16 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]" /></div>
      </div>
    </div>`;
  }

  function bindEditorEvents(trainerId, isEditing, workout, dayOptions) {
    const editor = document.getElementById("workout-editor")!;
    const addBtn = document.getElementById("add-exercise-btn");
    const saveBtn = document.getElementById("btn-save-workout") as HTMLButtonElement;
    const cancelBtn = document.getElementById("btn-cancel-workout");
    const saveText = document.getElementById("save-btn-text");
    const saveSpinner = document.getElementById("save-btn-spinner");
    const exercisesList = document.getElementById("exercises-list")!;

    addBtn?.addEventListener("click", () => {
      exercisesList.insertAdjacentHTML("beforeend", renderExerciseRow({name:"", sets:3, reps:10, restTime:"60s", order:0}, exercisesList.children.length, dayOptions));
    });

    exercisesList.addEventListener("click", (e) => {
      if (e.target.closest("[data-remove-exercise]")) e.target.closest("[data-exercise-row]").remove();
    });

    cancelBtn?.addEventListener("click", () => { editor.classList.add("hidden"); editor.innerHTML = ""; });

    saveBtn.addEventListener("click", async () => {
      const nameInput = document.getElementById("workout-name") as HTMLInputElement;
      const descInput = document.getElementById("workout-desc") as HTMLTextAreaElement;
      const diffInput = document.getElementById("workout-difficulty") as HTMLSelectElement;
      const clientInput = document.getElementById("workout-client") as HTMLSelectElement;
      const nameErr = document.getElementById("workout-name-error");

      const name = nameInput.value.trim();
      if (!name) { nameErr?.classList.remove("hidden"); return; }
      nameErr?.classList.add("hidden");

      const clientId = clientInput?.value || workout?.clientId || "";
      if (!clientId) { alert(t("trainer.mustSelectClient")); return; }

      const exercises = Array.from(exercisesList.querySelectorAll("[data-exercise-row]"))
        .map((el, idx) => {
          const inputs = el.querySelectorAll("input, select");
          return {
            id: `ex-${Date.now()}-${idx}`,
            name: (inputs[0] as HTMLInputElement).value,
            sets: parseInt((inputs[1] as HTMLInputElement).value) || 3,
            reps: parseInt((inputs[2] as HTMLInputElement).value) || 10,
            restTime: (inputs[3] as HTMLInputElement).value || "60s",
            videoUrl: "", description: (inputs[4] as HTMLInputElement)?.value || "",
            order: idx + 1,
            dayOfWeek: parseInt((inputs[5] as HTMLSelectElement)?.value) || 1,
          };
        }).filter(ex => ex.name.trim() !== "");

      saveText?.classList.add("hidden");
      saveSpinner?.classList.remove("hidden");
      saveBtn.disabled = true;

      try {
        if (isEditing && workout) await updateWorkout(workout.id, { name, clientId, trainerId, difficulty: diffInput.value, description: descInput.value, exercises });
        else await createWorkout({ clientId, trainerId, name, difficulty: diffInput.value, description: descInput.value, exercises });
        editor.classList.add("hidden");
        editor.innerHTML = "";
      } catch (err) {
        logger.error("TrainerWorkouts", "Error saving workout", err);
      } finally {
        saveBtn.disabled = false;
        saveText?.classList.remove("hidden");
        saveSpinner?.classList.add("hidden");
      }
    });
  }
</script>