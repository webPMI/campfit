---
import TrainerLayout from '@/layouts/TrainerLayout.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<TrainerLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold">{t('trainer.workouts')}</h1>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">
            <span id="workout-count" class="text-[var(--info)] font-medium">0</span> {t('admin.workouts.total')}
          </p>
        </div>
        <button id="btn-create-workout" class="rounded-xl bg-[var(--brand-dim)] border border-[var(--border-brand)] px-4 py-2 text-sm font-medium text-[var(--brand)] hover:bg-[var(--brand-dim)] transition-all active:scale-95">
          <svg class="h-4 w-4 inline-block mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          {t('trainer.workouts.new')}
        </button>
      </div>

      <!-- Workout Editor -->
      <div id="workout-editor" class="hidden mt-8"></div>

      <!-- Filter by client -->
      <div class="mt-6">
        <select id="client-filter" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-4 py-2.5 text-sm text-[var(--text-secondary)] backdrop-blur-sm focus:outline-none focus:border-[var(--border-brand)]">
          <option value="">{t('trainer.filter.all')}</option>
        </select>
      </div>

      <!-- Workouts List -->
      <div id="workouts-container" class="mt-6 space-y-3">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 text-center backdrop-blur-sm">
          <div class="flex items-center justify-center gap-3">
            <svg class="h-5 w-5 animate-spin text-[var(--brand)]" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
            </svg>
            <p class="text-sm text-[var(--text-tertiary)]">{t('admin.loading')}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</TrainerLayout>

<script>
  import { requireAuth } from '@/lib/shared/authGuard';
  import { ICONS, escapeHtml, renderEmptyState } from '@/lib/shared/ui';
  import {
    subscribeToClients,
    subscribeToWorkoutsByTrainer,
    createWorkout,
    updateWorkout,
    deleteWorkout,
  } from '@/lib/trainer/trainerUtils';
  import type { TrainerClient, TrainerWorkout, Exercise } from '@/lib/trainer/trainerUtils';
  import { logger } from '@/lib/shared/logger';

  let unsubClients: (() => void) | null = null;
  let unsubWorkouts: (() => void) | null = null;
  let allClients: TrainerClient[] = [];
  let allWorkouts: TrainerWorkout[] = [];

