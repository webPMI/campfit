---
import TrainerLayout from "@/layouts/TrainerLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<TrainerLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in space-y-6">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h1 data-i18n="trainer.workouts" class="text-2xl font-bold text-[var(--text-primary)]">{t("trainer.workouts")}</h1>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">
            <span id="workout-count" class="text-[var(--info)] font-medium">0</span>
            <span data-i18n="admin.stat.createdWorkouts">{t("admin.stat.createdWorkouts")}</span>
          </p>
        </div>
        <button id="btn-create-workout" class="rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] text-[var(--text-on-brand)] px-4 py-2.5 text-sm font-bold shadow-md hover:opacity-95 transition-all active:scale-95 flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
          </svg>
          <span data-i18n="trainer.workouts.new">{t("trainer.workouts.new")}</span>
        </button>
      </div>

      <!-- Navegación de Pestañas: Rutinas vs Correcciones de Técnica -->
      <div class="flex items-center gap-2 border-b border-[var(--border-subtle)] pb-2">
        <button id="tab-btn-routines" class="tab-btn active rounded-xl px-4 py-2 text-xs font-bold text-[var(--brand)] bg-[var(--brand-dim)] border border-[var(--border-brand)] transition-all flex items-center gap-2">
          <span>🏋️ Rutinas Asignadas</span>
        </button>
        <button id="tab-btn-corrections" class="tab-btn rounded-xl px-4 py-2 text-xs font-bold text-[var(--text-secondary)] hover:text-white bg-[var(--surface-2)] border border-[var(--border-subtle)] transition-all flex items-center gap-2">
          <span>📹 Correcciones de Técnica</span>
          <span id="pending-corrections-badge" class="hidden rounded-full bg-rose-500 text-white text-[10px] font-extrabold px-2 py-0.5 animate-pulse">0</span>
        </button>
      </div>

      <!-- Sección de Rutinas -->
      <div id="routines-section" class="space-y-6">
        <!-- Luxury Preset Templates & Smart Assignment Hub -->
        <div id="template-banner" class="rounded-2xl border border-amber-500/40 bg-zinc-900/90 p-5 backdrop-blur-xl shadow-[0_10px_30px_rgba(0,0,0,0.5),0_0_20px_rgba(245,158,11,0.15)] space-y-4">
          <div class="flex items-center justify-between flex-wrap gap-3">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-500/20 border border-amber-500/30 text-amber-400 text-lg shadow-inner">
                ⚡
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h3 data-i18n="admin.quickDeploy.defaultWorkouts" class="text-sm font-extrabold text-amber-300 tracking-wide">{t("admin.quickDeploy.defaultWorkouts")}</h3>
                  <span class="rounded-full bg-amber-500/15 border border-amber-500/30 px-2 py-0.5 text-[10px] font-bold text-amber-300 uppercase tracking-widest">Smart Assign</span>
                </div>
                <p data-i18n="admin.quickDeploy.defaultWorkouts.desc" class="text-xs text-zinc-400 mt-0.5">{t("admin.quickDeploy.defaultWorkouts.desc")}</p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 pt-3 border-t border-zinc-800">
            <div class="sm:col-span-5">
              <label class="block text-[11px] font-semibold text-zinc-400 mb-1">📋 Plantilla Prediseñada</label>
              <select id="preset-template-select" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 px-3.5 py-2.5 text-xs text-zinc-100 font-medium focus:outline-none focus:border-amber-400 transition-all">
                <option value="" data-i18n="trainer.loadingRoutineTemplates">{t("trainer.loadingRoutineTemplates")}</option>
              </select>
            </div>

            <div class="sm:col-span-4">
              <label class="block text-[11px] font-semibold text-zinc-400 mb-1">👤 Atleta Asignado</label>
              <select id="preset-client-select" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 px-3.5 py-2.5 text-xs text-zinc-100 font-medium focus:outline-none focus:border-amber-400 transition-all">
                <option value="" data-i18n="trainer.selectClient">{t("trainer.selectClient")}</option>
              </select>
            </div>

            <div class="sm:col-span-3 flex items-end">
              <button id="btn-apply-preset" class="w-full rounded-xl bg-gradient-to-r from-amber-500 to-yellow-500 text-zinc-950 px-4 py-2.5 text-xs font-extrabold shadow-[0_0_15px_rgba(245,158,11,0.3)] hover:brightness-110 active:scale-95 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
                <span>🚀</span>
                <span id="apply-btn-label">Asignar Rutina</span>
              </button>
            </div>
          </div>

          <!-- Real-Time Template & Client Preview Box -->
          <div id="preset-preview-box" class="hidden rounded-xl border border-amber-500/20 bg-black/60 p-3.5 text-xs space-y-2.5 transition-all">
            <div class="flex items-center justify-between flex-wrap gap-2 border-b border-zinc-800 pb-2">
              <span class="font-bold text-amber-300" id="preview-template-title">Rutina</span>
              <div class="flex items-center gap-2" id="preview-template-tags"></div>
            </div>
            <div id="preview-template-exercises" class="text-zinc-300 space-y-1 max-h-32 overflow-y-auto pr-1"></div>
          </div>
        </div>

        <div id="workout-editor" class="hidden"></div>

        <div class="flex items-center gap-3">
          <select id="client-filter" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] px-4 py-2.5 text-sm text-[var(--text-primary)] backdrop-blur-sm focus:outline-none focus:border-[var(--border-brand)]">
            <option value="">{t("trainer.filter.all")}</option>
          </select>
        </div>

        <div id="workouts-container" class="space-y-3">
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 text-center backdrop-blur-sm">
            <div class="flex items-center justify-center gap-3">
              <svg class="h-5 w-5 animate-spin text-[var(--brand)]" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              <p class="text-sm text-[var(--text-tertiary)]">{t("admin.loading")}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Sección de Correcciones de Técnica (R2 Video Feedback) -->
      <div id="corrections-section" class="hidden space-y-6">
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4">
          <div class="flex items-center justify-between flex-wrap gap-3">
            <div>
              <h3 class="text-base font-bold text-[var(--text-primary)]">📹 Vídeos de Ejecución Técnica</h3>
              <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Revisa grabaciones de tus alumnos, analiza su postura y envía correcciones en tiempo real.</p>
            </div>
            <div class="flex items-center gap-2">
              <select id="corrections-status-filter" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]">
                <option value="all">Todas las solicitudes</option>
                <option value="pending" selected>Pendientes de revisión</option>
                <option value="reviewed">Ya revisadas</option>
              </select>
            </div>
          </div>

          <div id="corrections-list" class="space-y-4">
            <div class="text-center py-8 text-xs text-[var(--text-disabled)]">Cargando solicitudes de técnica...</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Reproductor de Vídeo de Técnica -->
  <div id="video-player-modal" class="fixed inset-0 z-50 hidden bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="relative w-full max-w-2xl bg-zinc-900 border border-zinc-700 rounded-2xl overflow-hidden shadow-2xl space-y-3 p-4">
      <div class="flex items-center justify-between border-b border-zinc-800 pb-2">
        <h4 id="video-modal-title" class="text-sm font-bold text-white">Reproductor de Técnica</h4>
        <button id="btn-close-video-modal" class="text-zinc-400 hover:text-white text-lg font-bold">&times;</button>
      </div>
      <div class="relative aspect-video w-full bg-black rounded-xl overflow-hidden flex items-center justify-center">
        <video id="modal-video-element" controls class="w-full h-full object-contain"></video>
      </div>
      <div class="flex items-center justify-between text-xs text-zinc-400 pt-1">
        <div class="flex items-center gap-2">
          <span>Velocidad de reproducción:</span>
          <button type="button" class="btn-speed-toggle px-2 py-0.5 rounded bg-zinc-800 hover:bg-zinc-700 text-white font-mono text-[11px]" data-speed="0.5">0.5x</button>
          <button type="button" class="btn-speed-toggle px-2 py-0.5 rounded bg-zinc-800 hover:bg-zinc-700 text-white font-mono text-[11px]" data-speed="1.0">1.0x (Normal)</button>
        </div>
      </div>
    </div>
  </div>
</TrainerLayout>

<script>
  import { logger } from "@/lib/shared/logger";
  import { requireRole } from "@/lib/shared/authGuard";
  import { t } from "@/i18n/client";
  import { ICONS, escapeHtml, renderEmptyState, showToast, showConfirm, showSelectModal } from "@/lib/shared/ui";
  import { subscribeToClients, subscribeToWorkoutsByTrainer, createWorkout, updateWorkout, deleteWorkout, cloneWorkoutToClient } from "@/lib/trainer/trainerUtils";
  import { subscribeToWorkoutTemplates, applyWorkoutTemplateToClient } from "@/lib/trainer/templateService";
  import {
    subscribeToExercises,
    getExerciseName,
    MUSCLE_LABELS,
    type ExerciseItem,
  } from "@/lib/shared/exerciseLibrary";
  import {
    subscribeToUserExercisePreferences,
    acknowledgeExerciseRequest,
  } from "@/lib/client/exercisePreferencesService";
  import {
    subscribeToCorrectionsByTrainer,
    reviewTechniqueCorrection,
    deleteTechniqueCorrection,
    type ExerciseCorrection,
  } from "@/lib/shared/techniqueCorrectionService";
  import { uploadFileToR2, validateMediaFile } from "@/lib/storage/r2Service";
  import type { TrainerClient, TrainerWorkout, Exercise } from "@/lib/trainer/types";
  import type { WorkoutTemplate } from "@/lib/devtools/types";
  import type { UserExercisePreferences } from "@/types";

  let unsubClients: (() => void) | null = null;
  let unsubWorkouts: (() => void) | null = null;
  let unsubTemplates: (() => void) | null = null;
  let unsubCatalog: (() => void) | null = null;
  let unsubSelectedClientPrefs: (() => void) | null = null;
  let unsubCorrections: (() => void) | null = null;

  let allClients: TrainerClient[] = [];
  let allWorkouts: TrainerWorkout[] = [];
  let allTemplates: WorkoutTemplate[] = [];
  let allCatalogExercises: ExerciseItem[] = [];
  let allCorrections: ExerciseCorrection[] = [];
  let currentClientPrefs: UserExercisePreferences | null = null;

  let currentTrainerId = "";
  let editingExercises: Exercise[] = [];

  requireRole(["trainer", "admin"], async (user) => { initWorkouts(user.uid); });
  window.addEventListener("beforeunload", () => {
    unsubClients?.();
    unsubWorkouts?.();
    unsubTemplates?.();
    unsubCatalog?.();
    unsubSelectedClientPrefs?.();
    unsubCorrections?.();
  });

  async function initWorkouts(trainerId: string) {
    currentTrainerId = trainerId;
    const container = document.getElementById("workouts-container")!;
    const btnCreate = document.getElementById("btn-create-workout")!;
    const clientFilter = document.getElementById("client-filter") as HTMLSelectElement;
    const presetTemplateSelect = document.getElementById("preset-template-select") as HTMLSelectElement;
    const presetClientSelect = document.getElementById("preset-client-select") as HTMLSelectElement;
    const btnApplyPreset = document.getElementById("btn-apply-preset") as HTMLButtonElement;
    const workoutCount = document.getElementById("workout-count")!;

    // Pestañas
    const tabBtnRoutines = document.getElementById("tab-btn-routines");
    const tabBtnCorrections = document.getElementById("tab-btn-corrections");
    const routinesSection = document.getElementById("routines-section");
    const correctionsSection = document.getElementById("corrections-section");
    const pendingCorrectionsBadge = document.getElementById("pending-corrections-badge");
    const correctionsStatusFilter = document.getElementById("corrections-status-filter") as HTMLSelectElement | null;
    const correctionsList = document.getElementById("corrections-list");

    // Modal de vídeo
    const videoModal = document.getElementById("video-player-modal");
    const videoModalElement = document.getElementById("modal-video-element") as HTMLVideoElement | null;
    const videoModalTitle = document.getElementById("video-modal-title");
    const btnCloseVideoModal = document.getElementById("btn-close-video-modal");
    const speedButtons = document.querySelectorAll(".btn-speed-toggle");

    // Control de pestañas
    tabBtnRoutines?.addEventListener("click", () => {
      tabBtnRoutines.classList.add("active", "text-[var(--brand)]", "bg-[var(--brand-dim)]", "border-[var(--border-brand)]");
      tabBtnRoutines.classList.remove("text-[var(--text-secondary)]", "bg-[var(--surface-2)]", "border-[var(--border-subtle)]");
      tabBtnCorrections?.classList.remove("active", "text-[var(--brand)]", "bg-[var(--brand-dim)]", "border-[var(--border-brand)]");
      tabBtnCorrections?.classList.add("text-[var(--text-secondary)]", "bg-[var(--surface-2)]", "border-[var(--border-subtle)]");
      routinesSection?.classList.remove("hidden");
      correctionsSection?.classList.add("hidden");
    });

    tabBtnCorrections?.addEventListener("click", () => {
      tabBtnCorrections.classList.add("active", "text-[var(--brand)]", "bg-[var(--brand-dim)]", "border-[var(--border-brand)]");
      tabBtnCorrections.classList.remove("text-[var(--text-secondary)]", "bg-[var(--surface-2)]", "border-[var(--border-subtle)]");
      tabBtnRoutines?.classList.remove("active", "text-[var(--brand)]", "bg-[var(--brand-dim)]", "border-[var(--border-brand)]");
      tabBtnRoutines?.classList.add("text-[var(--text-secondary)]", "bg-[var(--surface-2)]", "border-[var(--border-subtle)]");
      routinesSection?.classList.add("hidden");
      correctionsSection?.classList.remove("hidden");
      renderCorrectionsList();
    });

    // Control de vídeo modal
    btnCloseVideoModal?.addEventListener("click", () => {
      if (videoModalElement) {
        videoModalElement.pause();
        videoModalElement.src = "";
      }
      videoModal?.classList.add("hidden");
    });

    videoModal?.addEventListener("click", (e) => {
      if (e.target === videoModal) {
        if (videoModalElement) {
          videoModalElement.pause();
          videoModalElement.src = "";
        }
        videoModal.classList.add("hidden");
      }
    });

    speedButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const speed = parseFloat((btn as HTMLElement).dataset.speed || "1.0");
        if (videoModalElement) videoModalElement.playbackRate = speed;
        speedButtons.forEach(b => b.classList.remove("border", "border-[var(--brand)]", "text-[var(--brand)]"));
        btn.classList.add("border", "border-[var(--brand)]", "text-[var(--brand)]");
      });
    });

    // Suscripción a correcciones de técnica
    unsubCorrections = subscribeToCorrectionsByTrainer(trainerId, (corrections) => {
      allCorrections = corrections;
      const pendingCount = corrections.filter(c => c.status === "pending").length;
      if (pendingCorrectionsBadge) {
        if (pendingCount > 0) {
          pendingCorrectionsBadge.textContent = String(pendingCount);
          pendingCorrectionsBadge.classList.remove("hidden");
        } else {
          pendingCorrectionsBadge.classList.add("hidden");
        }
      }
      renderCorrectionsList();
    });

    correctionsStatusFilter?.addEventListener("change", () => renderCorrectionsList());

    function renderCorrectionsList() {
      if (!correctionsList) return;
      const filter = correctionsStatusFilter?.value || "pending";
      const filtered = allCorrections.filter(c => {
        if (filter === "pending") return c.status === "pending";
        if (filter === "reviewed") return c.status === "reviewed";
        return true;
      });

      if (filtered.length === 0) {
        correctionsList.innerHTML = `<div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-8 text-center text-xs text-[var(--text-disabled)]">No hay solicitudes de corrección en esta categoría.</div>`;
        return;
      }

      correctionsList.innerHTML = filtered.map((c) => {
        const isPending = c.status === "pending";
        const dateStr = c.createdAt && typeof (c.createdAt as { toDate?: () => Date }).toDate === "function"
          ? (c.createdAt as { toDate: () => Date }).toDate().toLocaleDateString()
          : "Reciente";

        return `
          <div class="rounded-xl border ${isPending ? 'border-amber-500/30 bg-amber-500/5' : 'border-[var(--border-subtle)] bg-[var(--surface-2)]'} p-4 space-y-3 transition-all" data-corr-id="${c.id}">
            <div class="flex items-start justify-between flex-wrap gap-2">
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-bold text-sm text-[var(--text-primary)]">${escapeHtml(c.clientName)}</span>
                  <span class="rounded-md bg-purple-500/20 text-purple-300 border border-purple-500/30 px-2 py-0.5 text-[10px] font-bold">${escapeHtml(c.exerciseName)}</span>
                  <span class="text-xs text-[var(--text-tertiary)]">(${escapeHtml(c.workoutName)})</span>
                </div>
                <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5">Enviado el ${escapeHtml(dateStr)}</p>
              </div>
              <span class="rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider ${isPending ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30 animate-pulse' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'}">
                ${isPending ? '⏳ Pendiente' : '✅ Revisado'}
              </span>
            </div>

            ${c.clientNotes ? `<div class="rounded-lg bg-[var(--surface-3)] p-2.5 text-xs text-zinc-300"><span class="text-[var(--text-tertiary)] font-semibold">Nota del alumno:</span> "${escapeHtml(c.clientNotes)}"</div>` : ''}

            <!-- Reproductor & Botón -->
            <div class="flex items-center gap-3">
              <button type="button" class="btn-play-corr-video rounded-xl bg-[var(--brand)] hover:bg-[var(--brand-hover)] text-[var(--text-on-brand)] px-3.5 py-1.5 text-xs font-bold flex items-center gap-1.5 shadow transition-all" data-video-url="${escapeHtml(c.videoUrl)}" data-title="${escapeHtml(c.clientName)} - ${escapeHtml(c.exerciseName)}">
                <span>▶️ Reproducir Vídeo</span>
              </button>
            </div>

            <!-- Formulario de Retroalimentación -->
            <div class="pt-2 border-t border-[var(--border-subtle)] space-y-2">
              <label class="block text-[11px] font-semibold text-[var(--text-secondary)]">Retroalimentación / Corrección del Entrenador:</label>
              <textarea rows="2" class="corr-feedback-input w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--brand)] resize-none" placeholder="Escribe tus observaciones técnicas (ej: Mantén la espalda recta y no bloquees las rodillas arriba)...">${escapeHtml(c.trainerFeedback || '')}</textarea>
              <div class="flex items-center justify-between gap-2">
                <button type="button" class="btn-delete-corr text-xs text-rose-400 hover:text-rose-300 font-semibold p-1 hover:bg-rose-500/10 rounded-md transition-all flex items-center gap-1" data-id="${c.id}">
                  <span>🗑️ Eliminar</span>
                </button>
                <button type="button" class="btn-save-corr-feedback rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white px-4 py-1.5 text-xs font-bold shadow transition-all" data-id="${c.id}">
                  💾 Guardar Corrección
                </button>
              </div>
            </div>
          </div>
        `;
      }).join("");

      correctionsList.querySelectorAll(".btn-play-corr-video").forEach((btn) => {
        btn.addEventListener("click", () => {
          const url = (btn as HTMLElement).dataset.videoUrl;
          const title = (btn as HTMLElement).dataset.title;
          if (url && videoModal && videoModalElement) {
            videoModalElement.src = url;
            if (videoModalTitle) videoModalTitle.textContent = title || "Reproductor de Técnica";
            videoModal.classList.remove("hidden");
            videoModalElement.play().catch(() => {});
          }
        });
      });

      correctionsList.querySelectorAll(".btn-delete-corr").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const corrId = (btn as HTMLElement).dataset.id;
          if (!corrId) return;

          const confirmed = await showConfirm({
            title: '¿Eliminar corrección?',
            message: '¿Estás seguro de que deseas eliminar esta corrección de técnica? Se eliminará de tu bandeja.',
            confirmText: 'Sí, eliminar',
            cancelText: 'Cancelar',
            variant: 'danger',
          });

          if (confirmed) {
            try {
              await deleteTechniqueCorrection(corrId);
              showToast({ message: "Corrección eliminada con éxito", type: "success" });
            } catch (err) {
              logger.error("TechniqueCorrection", "Error al eliminar corrección:", err);
              showToast({ message: "Error al eliminar la corrección", type: "error" });
            }
          }
        });
      });

      correctionsList.querySelectorAll(".btn-save-corr-feedback").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const corrId = (btn as HTMLElement).dataset.id;
          const card = (btn as HTMLElement).closest("[data-corr-id]");
          const feedback = (card?.querySelector(".corr-feedback-input") as HTMLTextAreaElement)?.value?.trim() || "";
          if (!corrId) return;

          try {
            (btn as HTMLButtonElement).disabled = true;
            await reviewTechniqueCorrection(corrId, feedback);
            showToast({ message: "Corrección y feedback técnico guardados con éxito", type: "success" });
          } catch (err) {
            logger.error("TechniqueCorrection", "Error al guardar feedback:", err);
            showToast({ message: "Error al guardar la corrección", type: "error" });
          } finally {
            (btn as HTMLButtonElement).disabled = false;
          }
        });
      });
    }

    unsubCatalog = subscribeToExercises((exercises) => {
      allCatalogExercises = exercises;
      if (!document.getElementById("workout-editor")?.classList.contains("hidden")) {
        renderExercisesEditor();
      }
    });

    unsubClients = subscribeToClients(trainerId, (clients) => {
      allClients = clients;
      const clientOpts = `<option value="">${t("trainer.filter.all")}</option>` + clients.map(c => `<option value="${c.uid}">${escapeHtml(c.name)}</option>`).join("");
      clientFilter.innerHTML = clientOpts;
      presetClientSelect.innerHTML = `<option value="">${t("diet.editor.client.select")}</option>` + clients.map(c => `<option value="${c.uid}">${escapeHtml(c.name)}</option>`).join("");
      
      const urlClientId = new URLSearchParams(window.location.search).get("clientId");
      if (urlClientId) {
        clientFilter.value = urlClientId;
        presetClientSelect.value = urlClientId;
      }
    });

    unsubWorkouts = subscribeToWorkoutsByTrainer(trainerId, (workouts) => {
      allWorkouts = workouts;
      workoutCount.textContent = String(workouts.length);
      applyFilters();
    });

    unsubTemplates = subscribeToWorkoutTemplates((templates) => {
      allTemplates = templates;
      if (templates.length === 0) {
        presetTemplateSelect.innerHTML = `<option value="">${t("trainer.noTemplates") || "Sin plantillas disponibles"}</option>`;
      } else {
        presetTemplateSelect.innerHTML = `<option value="">${t("trainer.selectPresetRoutine")} (${templates.length})...</option>` +
          templates.map(tmpl => `<option value="${tmpl.id}">${escapeHtml(tmpl.name)} (${tmpl.exercises?.length || 0} ${t("trainer.exercises").toLowerCase()})</option>`).join("");
      }
    });

    const updatePresetPreview = () => {
      const templateId = presetTemplateSelect.value;
      const clientId = presetClientSelect.value;
      const previewBox = document.getElementById("preset-preview-box");
      const applyBtnLabel = document.getElementById("apply-btn-label");
      
      const selectedClient = allClients.find(c => c.uid === clientId);
      if (applyBtnLabel) {
        applyBtnLabel.textContent = selectedClient?.name ? `Asignar a ${escapeHtml(selectedClient.name.split(" ")[0] || "")}` : "Asignar Rutina";
      }

      if (!templateId) {
        previewBox?.classList.add("hidden");
        return;
      }

      const tmpl = allTemplates.find(t => t.id === templateId);
      if (!tmpl || !previewBox) {
        previewBox?.classList.add("hidden");
        return;
      }

      previewBox.classList.remove("hidden");
      const titleEl = document.getElementById("preview-template-title");
      const tagsEl = document.getElementById("preview-template-tags");
      const exercisesEl = document.getElementById("preview-template-exercises");

      const diffColors: Record<string, string> = {
        beginner: "bg-emerald-500/20 text-emerald-300 border-emerald-500/30",
        intermediate: "bg-amber-500/20 text-amber-300 border-amber-500/30",
        advanced: "bg-rose-500/20 text-rose-300 border-rose-500/30",
      };
      const diffLabel: Record<string, string> = {
        beginner: "Principiante",
        intermediate: "Intermedio",
        advanced: "Avanzado",
      };

      if (titleEl) titleEl.textContent = tmpl.name;
      if (tagsEl) {
        tagsEl.innerHTML = `
          <span class="px-2 py-0.5 rounded-md border text-[10px] font-bold uppercase tracking-wider ${diffColors[tmpl.difficulty || "beginner"]}">${diffLabel[tmpl.difficulty || "beginner"]}</span>
          <span class="px-2 py-0.5 rounded-md border border-zinc-700 bg-zinc-800 text-[10px] text-zinc-300 font-semibold">${tmpl.exercises?.length || 0} Ejercicios</span>
        `;
      }

      if (exercisesEl) {
        if (!tmpl.exercises || tmpl.exercises.length === 0) {
          exercisesEl.innerHTML = `<p class="text-zinc-500 italic">Esta plantilla no contiene ejercicios aún.</p>`;
        } else {
          exercisesEl.innerHTML = tmpl.exercises.map((ex: { name?: string; sets?: number; reps?: number; restTime?: string }, idx: number) => `
            <div class="flex items-center justify-between py-1 border-b border-zinc-800/60 last:border-0">
              <span class="font-medium text-zinc-200">#${idx + 1} ${escapeHtml(ex.name || "")}</span>
              <span class="text-amber-400/90 font-mono text-[11px]">${ex.sets || 3}x${ex.reps || 10} · ${ex.restTime || "60s"}</span>
            </div>
          `).join("");
        }
      }
    };

    presetTemplateSelect.addEventListener("change", updatePresetPreview);
    presetClientSelect.addEventListener("change", updatePresetPreview);

    btnApplyPreset.addEventListener("click", async () => {
      const templateId = presetTemplateSelect.value;
      const clientId = presetClientSelect.value;
      if (!templateId || !clientId) {
        showToast({ message: t("common.validationError") || "Por favor selecciona una plantilla y un cliente", type: "error" });
        return;
      }
      try {
        btnApplyPreset.disabled = true;
        showToast({ message: t("common.saving") || "Desplegando rutina predeterminada...", type: "info" });
        await applyWorkoutTemplateToClient(templateId, clientId, trainerId);
        showToast({ message: "¡Rutina asignada exitosamente al cliente!", type: "success" });
        
        // Auto-filtrar por el cliente asignado para visualizarla inmediatamente
        clientFilter.value = clientId;
        applyFilters();
        
        presetTemplateSelect.value = "";
        updatePresetPreview();
      } catch (err: unknown) {
        const errorMsg = err instanceof Error ? err.message : (t("common.error") || "Error al asignar plantilla");
        showToast({ message: errorMsg, type: "error" });
      } finally {
        btnApplyPreset.disabled = false;
      }
    });

    clientFilter.addEventListener("change", () => applyFilters());
    btnCreate.addEventListener("click", () => { showEditor(null, trainerId, clientFilter.value || ""); });

    container.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest("[data-action]");
      if (!btn) return;
      const action = btn.getAttribute("data-action");
      const workoutId = btn.getAttribute("data-workout-id");
      const workout = allWorkouts.find(w => w.id === workoutId);
      if (!workout) return;

      if (action === "print") {
        printWorkout(workout);
      }
      if (action === "clone") {
        const otherClients = allClients.filter(c => c.uid !== workout.clientId);
        if (otherClients.length === 0) {
          showToast({ message: "No tienes otros clientes a quienes clonar esta rutina", type: "error" });
          return;
        }
        showSelectModal({
          title: `Clonar "${workout.name}"`,
          message: "Selecciona el atleta al que deseas asignar una copia de esta rutina:",
          options: otherClients.map(c => ({
            value: c.uid,
            label: c.name,
            sublabel: c.email,
          })),
        }).then((targetClientId) => {
          if (!targetClientId) return;
          cloneWorkoutToClient(workout, targetClientId, trainerId).then((newId: string | null) => {
            if (newId) {
              clientFilter.value = targetClientId;
              applyFilters();
            }
          });
        });
      }
      if (action === "edit") showEditor(workout, trainerId, workout.clientId);
      if (action === "delete") {
        showConfirm({
          title: t("trainer.deleteRoutine") || "¿Eliminar rutina?",
          message: `¿Estás seguro de que deseas eliminar permanentemente la rutina "${workout.name}"?`,
          confirmText: t("common.delete") || "Eliminar",
          variant: "danger",
        }).then((confirmed) => {
          if (!confirmed) return;
          deleteWorkout(workout.id).then(() => showToast({ message: t("common.delete") + " OK", type: "success" }))
            .catch(err => logger.error("TrainerWorkouts", "Error deleting workout", err));
        });
      }
    });
  }

  function printWorkout(workout: TrainerWorkout) {
    const client = allClients.find(c => c.uid === workout.clientId);
    const printWindow = window.open('', '_blank');
    if (!printWindow) {
      showToast({ message: 'Permite las ventanas emergentes para imprimir la ficha', type: 'error' });
      return;
    }
    const html = `
      <!DOCTYPE html>
      <html>
      <head>
        <title>CampFit - Rutina: ${escapeHtml(workout.name)}</title>
        <style>
          body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 25px; color: #111; line-height: 1.5; }
          .header { border-bottom: 2px solid #d97706; padding-bottom: 12px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: flex-end; }
          .brand { font-size: 24px; font-weight: 800; color: #b45309; letter-spacing: -0.5px; }
          .meta { font-size: 13px; color: #555; }
          .workout-title { font-size: 20px; font-weight: bold; margin-bottom: 4px; }
          table { width: 100%; border-collapse: collapse; margin-top: 15px; }
          th { background: #fef3c7; color: #92400e; text-align: left; padding: 8px 12px; font-size: 12px; text-transform: uppercase; border-bottom: 1px solid #fcd34d; }
          td { padding: 10px 12px; border-bottom: 1px solid #e5e7eb; font-size: 13px; }
          tr:nth-child(even) { background: #f9fafb; }
          .footer { margin-top: 30px; text-align: center; font-size: 11px; color: #888; border-top: 1px solid #e5e7eb; padding-top: 10px; }
          @media print { button { display: none; } }
        </style>
      </head>
      <body>
        <div class="header">
          <div>
            <div class="brand">CAMPFIT ELITE</div>
            <div class="workout-title">${escapeHtml(workout.name)}</div>
            <div class="meta">Atleta: <strong>${escapeHtml(client?.name || 'Cliente')}</strong> · Dificultad: <strong>${workout.difficulty || 'Intermedio'}</strong></div>
          </div>
          <div class="meta" style="text-align: right;">
            <div>Fecha: ${new Date().toLocaleDateString()}</div>
            <div>${workout.exercises?.length || 0} Ejercicios Programados</div>
          </div>
        </div>

        <table>
          <thead>
            <tr>
              <th style="width: 40px;">#</th>
              <th>Ejercicio</th>
              <th style="width: 70px;">Series</th>
              <th style="width: 80px;">Reps</th>
              <th style="width: 90px;">Descanso</th>
              <th>Notas Técnicas</th>
            </tr>
          </thead>
          <tbody>
            ${(workout.exercises || []).map((ex, i) => `
              <tr>
                <td><strong>${i + 1}</strong></td>
                <td><strong>${escapeHtml(ex.name)}</strong></td>
                <td>${ex.sets || 3}</td>
                <td>${ex.reps || 10}</td>
                <td>${escapeHtml(ex.restTime || '60s')}</td>
                <td style="color: #666;">${escapeHtml(ex.description || '—')}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>

        <div class="footer">
          Generado automáticamente por CampFit Training Suite · Todos los derechos reservados.
        </div>
      </body>
      </html>
    `;
    printWindow.document.write(html);
    printWindow.document.close();
    printWindow.focus();
    setTimeout(() => { printWindow.print(); }, 250);
  }

  function applyFilters() {
    const container = document.getElementById("workouts-container")!;
    const clientId = (document.getElementById("client-filter") as HTMLSelectElement).value;
    let filtered = allWorkouts;
    if (clientId) filtered = filtered.filter(w => w.clientId === clientId);
    if (filtered.length === 0) {
      container.innerHTML = renderEmptyState(ICONS.workouts, t("trainer.client.no.workouts"));
    } else {
      container.innerHTML = filtered.map(w => {
        const client = allClients.find(c => c.uid === w.clientId);
        const clientName = client ? client.name : t("common.client");
        return `
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm flex items-center justify-between gap-4">
            <div class="space-y-1">
              <p class="text-sm font-semibold text-[var(--text-primary)]">${escapeHtml(w.name)}</p>
              <p class="text-xs text-[var(--text-tertiary)] font-medium">${w.exercises?.length || 0} ${t("trainer.exercises").toLowerCase()} · ${t("common.client")}: <span class="text-[var(--brand)] font-bold">${escapeHtml(clientName)}</span></p>
            </div>
            <div class="flex items-center gap-1.5 shrink-0 flex-wrap">
              <button data-action="print" data-workout-id="${w.id}" title="Imprimir / Exportar Ficha" class="rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2.5 py-1.5 text-xs font-semibold text-amber-400 hover:text-amber-300 transition-all flex items-center gap-1">🖨️ <span class="hidden sm:inline">PDF</span></button>
              <button data-action="clone" data-workout-id="${w.id}" title="Clonar a otro atleta" class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-2.5 py-1.5 text-xs font-semibold text-amber-300 hover:bg-amber-500/20 transition-all flex items-center gap-1">⚡ <span class="hidden sm:inline">Clonar</span></button>
              <button data-action="edit" data-workout-id="${w.id}" class="rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-1.5 text-xs font-semibold text-[var(--text-secondary)] hover:text-white transition-all">${t("common.edit")}</button>
              <button data-action="delete" data-workout-id="${w.id}" class="rounded-lg border border-red-500/30 bg-[var(--danger-dim)] px-3 py-1.5 text-xs font-semibold text-[var(--danger)] hover:bg-[var(--danger-dim)] transition-all">${t("common.delete")}</button>
            </div>
          </div>
        `;
      }).join("");
    }
  }

  function listenToClientPreferences(clientId: string) {
    unsubSelectedClientPrefs?.();
    if (!clientId) {
      currentClientPrefs = null;
      renderPendingRequestsBanner();
      renderExercisesEditor();
      return;
    }

    unsubSelectedClientPrefs = subscribeToUserExercisePreferences(clientId, (prefs) => {
      currentClientPrefs = prefs;
      renderPendingRequestsBanner();
      renderExercisesEditor();
    });
  }

  function renderPendingRequestsBanner() {
    const banner = document.getElementById("client-pending-requests-banner");
    if (!banner) return;

    const pending = currentClientPrefs?.pendingRequests?.filter(r => r.status === "pending") || [];
    if (pending.length === 0) {
      banner.classList.add("hidden");
      banner.innerHTML = "";
      return;
    }

    banner.classList.remove("hidden");
    banner.innerHTML = `
      <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 p-4 space-y-2 animate-fade-in">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">
            🔔 Solicitudes de Ejercicio Pendientes (${pending.length})
          </span>
        </div>
        <div class="space-y-2">
          ${pending.map(req => `
            <div class="flex items-center justify-between gap-3 text-xs bg-[var(--surface-2)] p-2.5 rounded-lg border border-[var(--border-subtle)]">
              <div>
                <strong class="text-[var(--text-primary)]">🚫 ${escapeHtml(req.exerciseName)}</strong>
                <p class="text-[11px] text-[var(--text-tertiary)]">
                  Motivo: ${escapeHtml((req.quickReasons || []).join(", ") || "No especificado")}${req.customReason ? ` (${escapeHtml(req.customReason)})` : ""}
                </p>
              </div>
              <button
                type="button"
                data-ack-ex-id="${req.exerciseId}"
                class="btn-ack-request px-3 py-1 bg-[var(--brand)] text-[var(--text-on-brand)] rounded-lg text-xs font-bold shadow hover:opacity-90 shrink-0"
              >
                ✓ Marcar visto
              </button>
            </div>
          `).join("")}
        </div>
      </div>
    `;

    banner.querySelectorAll("[data-ack-ex-id]").forEach(btn => {
      btn.addEventListener("click", async (e) => {
        const exId = (e.currentTarget as HTMLElement).getAttribute("data-ack-ex-id")!;
        const clientSelect = document.getElementById("workout-client") as HTMLSelectElement;
        if (clientSelect?.value && exId) {
          const ok = await acknowledgeExerciseRequest(clientSelect.value, exId);
          if (ok) showToast({ message: "Solicitud marcada como vista", type: "success" });
        }
      });
    });
  }

  function showEditor(workout: TrainerWorkout | null, trainerId: string, clientId: string) {
    const editor = document.getElementById("workout-editor")!;
    const isEditing = !!workout;
    const nameVal = workout ? escapeHtml(workout.name) : "";
    const descVal = workout ? escapeHtml(workout.description || "") : "";
    const diffVal = workout ? workout.difficulty || "intermediate" : "intermediate";
    const selectedClientId = workout?.clientId || clientId;

    editingExercises = workout?.exercises ? JSON.parse(JSON.stringify(workout.exercises)) : [];
    if (editingExercises.length === 0) {
      editingExercises.push({
        id: `ex-${Date.now()}-0`,
        name: "",
        sets: 4,
        reps: 10,
        restTime: "60s",
        videoUrl: "",
        description: "",
        order: 1,
        dayOfWeek: 1,
      });
    }

    const clientOpts = allClients.map(c => `<option value="${c.uid}" ${c.uid === selectedClientId ? "selected" : ""}>${escapeHtml(c.name)}</option>`).join("");

    editor.innerHTML = `
      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 backdrop-blur-xl shadow-2xl space-y-4 animate-fade-in">
        <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
          <h3 class="text-lg font-bold text-[var(--text-primary)]">${isEditing ? t("trainer.workouts.edit") : t("trainer.workouts.new")}</h3>
          <button id="btn-cancel-workout-top" class="text-[var(--text-tertiary)] hover:text-white text-xl">&times;</button>
        </div>

        <!-- Banner de Solicitudes y Alertas del Cliente -->
        <div id="client-pending-requests-banner" class="hidden"></div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">Nombre de Rutina</label>
            <input id="workout-name" type="text" value="${nameVal}" placeholder="${t("trainer.routineName")}" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)]" />
          </div>

          <div>
            <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">Cliente Asignado</label>
            <select id="workout-client" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]">
              <option value="">Selecciona Cliente...</option>
              ${clientOpts}
            </select>
          </div>
        </div>

        <textarea id="workout-desc" rows="2" placeholder="${t("trainer.description")}" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)] resize-none">${descVal}</textarea>

        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="text-sm font-bold text-[var(--text-primary)]">Ejercicios de la Rutina</h4>
            <button id="btn-add-exercise" type="button" class="text-xs font-bold text-[var(--brand)] hover:underline">+ Agregar Ejercicio</button>
          </div>
          <div id="exercises-list" class="space-y-3"></div>
        </div>

        <div class="flex items-center gap-3 pt-3 border-t border-[var(--border-subtle)]">
          <button id="btn-save-workout" class="flex-1 rounded-xl bg-[var(--brand)] px-5 py-2.5 text-xs font-bold text-[var(--text-on-brand)] shadow-md transition-all hover:opacity-90">
            ${isEditing ? "Guardar Cambios" : "Crear Rutina"}
          </button>
          <button id="btn-cancel-workout" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-5 py-2.5 text-xs font-bold text-[var(--text-secondary)]">
            Cancelar
          </button>
        </div>
      </div>
    `;

    editor.classList.remove("hidden");
    editor.scrollIntoView({ behavior: "smooth" });

    listenToClientPreferences(selectedClientId);

    const clientSelect = document.getElementById("workout-client") as HTMLSelectElement;
    clientSelect?.addEventListener("change", (e) => {
      const cid = (e.target as HTMLSelectElement).value;
      listenToClientPreferences(cid);
    });

    renderExercisesEditor();

    document.getElementById("btn-add-exercise")?.addEventListener("click", () => {
      editingExercises.push({
        id: `ex-${Date.now()}-${editingExercises.length}`,
        name: "",
        sets: 4,
        reps: 10,
        restTime: "60s",
        videoUrl: "",
        description: "",
        order: editingExercises.length + 1,
        dayOfWeek: 1,
      });
      renderExercisesEditor();
    });

    document.getElementById("btn-cancel-workout")?.addEventListener("click", () => editor.classList.add("hidden"));
    document.getElementById("btn-cancel-workout-top")?.addEventListener("click", () => editor.classList.add("hidden"));

    document.getElementById("btn-save-workout")?.addEventListener("click", async () => {
      const name = (document.getElementById("workout-name") as HTMLInputElement).value.trim();
      const targetClientId = (document.getElementById("workout-client") as HTMLSelectElement).value;
      const desc = (document.getElementById("workout-desc") as HTMLTextAreaElement).value.trim();

      if (!name || !targetClientId) {
        showToast({ message: "Nombre de rutina y cliente son obligatorios", type: "error" });
        return;
      }

      const validExercises = editingExercises.filter(ex => ex.name.trim().length > 0);
      if (validExercises.length === 0) {
        showToast({ message: "Debes añadir al menos un ejercicio a la rutina", type: "error" });
        return;
      }

      // Comprobar si hay ejercicios excluidos por el cliente
      if (currentClientPrefs?.excluded && currentClientPrefs.excluded.length > 0) {
        const hasExcluded = validExercises.some(ex => {
          const catalog = allCatalogExercises.find(c => c.id === ex.id || c.translations.es === ex.name);
          return catalog && currentClientPrefs!.excluded.includes(catalog.id);
        });
        if (hasExcluded) {
          const proceed = await showConfirm({
            title: "Ejercicios Excluidos Detectados",
            message: "Has incluido ejercicios que el cliente ha solicitado excluir expresamente por preferencias o limitaciones físicas. ¿Deseas guardarla de todos modos?",
            confirmText: "Continuar y Guardar",
            variant: "warning",
          });
          if (!proceed) return;
        }
      }

      try {
        showToast({ message: "Guardando rutina...", type: "info" });
        if (isEditing && workout) {
          await updateWorkout(workout.id, {
            name,
            clientId: targetClientId,
            description: desc,
            exercises: validExercises,
          });
        } else {
          await createWorkout({
            trainerId,
            clientId: targetClientId,
            name,
            description: desc,
            difficulty: diffVal as any,
            exercises: validExercises,
          });
        }
        showToast({ message: "Rutina guardada correctamente", type: "success" });
        editor.classList.add("hidden");
      } catch (err: unknown) {
        const errorMsg = err instanceof Error ? err.message : (t("common.error") || "Error al guardar rutina");
        showToast({ message: errorMsg, type: "error" });
      }
    });
  }

  function renderExercisesEditor() {
    const list = document.getElementById("exercises-list");
    if (!list) return;

    if (editingExercises.length === 0) {
      list.innerHTML = `<p class="text-xs text-[var(--text-tertiary)] text-center py-4">${t("trainer.noExercises")}</p>`;
      return;
    }

    list.innerHTML = editingExercises.map((ex, index) => {
      const catalogEx = allCatalogExercises.find(c => c.id === ex.id || c.translations.es === ex.name);
      const isFav = catalogEx && currentClientPrefs?.favorites?.includes(catalogEx.id);
      const isExcluded = catalogEx && currentClientPrefs?.excluded?.includes(catalogEx.id);

      return `
        <div class="exercise-row rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-4 space-y-3" data-index="${index}">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[var(--brand-dim)] text-[10px] font-bold text-[var(--brand)]">${index + 1}</span>
              <span class="text-xs font-bold text-[var(--text-primary)]">Ejercicio</span>
              ${isFav ? `<span class="text-xs text-amber-400 font-bold bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">⭐ Favorito del cliente</span>` : ""}
              ${isExcluded ? `<span class="text-xs text-rose-400 font-bold bg-rose-500/10 px-2 py-0.5 rounded-full border border-rose-500/20">🚫 Solicitud de exclusión</span>` : ""}
            </div>
            <button
              type="button"
              data-remove-exercise="${index}"
              class="text-xs text-[var(--danger)] hover:underline font-semibold"
            >
              ${t("common.delete")}
            </button>
          </div>

          <!-- Selector de Catálogo -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div>
              <label class="block text-[10px] text-[var(--text-secondary)] mb-0.5 font-medium">🏋️ Del catálogo central:</label>
              <select class="catalog-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]">
                <option value="">Personalizado (texto libre / fuera del catálogo)</option>
                ${allCatalogExercises.map(c => {
                  const mg = c.muscleGroups?.[0];
                  const mgLabel = mg ? (MUSCLE_LABELS[mg] || mg) : "";
                  return `
                    <option value="${c.id}" ${catalogEx?.id === c.id ? "selected" : ""}>
                      ${escapeHtml(getExerciseName(c, "es"))}${mgLabel ? ` (${mgLabel})` : ""}
                    </option>
                  `;
                }).join("")}
              </select>
            </div>

            <div>
              <label class="block text-[10px] text-[var(--text-secondary)] mb-0.5 font-medium">Nombre / Variante:</label>
              <input type="text" value="${escapeHtml(ex.name)}" placeholder="Nombre del Ejercicio" class="ex-name w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-3 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]" />
            </div>
          </div>

          <!-- Series, Reps, Descanso y Día -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
            <div>
              <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">Día de la semana:</label>
              <select class="ex-day w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-2 py-1.5 text-xs text-[var(--text-primary)]">
                ${[1,2,3,4,5,6,7].map(d => `<option value="${d}" ${d === (ex.dayOfWeek || 1) ? "selected" : ""}>Día ${d}</option>`).join("")}
              </select>
            </div>
            <div>
              <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">Series:</label>
              <input type="number" value="${ex.sets || 3}" class="ex-sets w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-2 py-1.5 text-xs text-[var(--text-primary)]" />
            </div>
            <div>
              <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">Reps:</label>
              <input type="number" value="${ex.reps || 10}" class="ex-reps w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-2 py-1.5 text-xs text-[var(--text-primary)]" />
            </div>
            <div>
              <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">Descanso:</label>
              <input type="text" value="${escapeHtml(ex.restTime || "60s")}" class="ex-rest w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-2 py-1.5 text-xs text-[var(--text-primary)]" />
            </div>
          </div>

          <!-- Vídeo Explicativo de Técnica -->
          <div class="pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between flex-wrap gap-2 text-xs">
            <div class="flex items-center gap-2 flex-1 min-w-[220px]">
              <span class="text-[11px] text-[var(--text-secondary)] font-medium">📹 Vídeo Técnica:</span>
              <input type="text" value="${escapeHtml(ex.videoUrl || "")}" placeholder="URL o sube vídeo explicativo..." class="ex-video-url flex-1 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-2)] px-2.5 py-1 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand)]" />
            </div>
            <div class="flex items-center gap-2">
              <input type="file" accept="video/mp4,video/webm" class="ex-video-file-input hidden" />
              <button type="button" class="btn-upload-ex-video rounded-lg bg-[var(--surface-4)] border border-[var(--border-subtle)] hover:border-[var(--border-brand)] text-[var(--text-primary)] px-2.5 py-1 text-[11px] font-semibold flex items-center gap-1.5 transition-all">
                <span>☁️ Subir Vídeo</span>
              </button>
              ${ex.videoUrl ? `
                <button type="button" class="btn-preview-ex-video text-xs text-[var(--brand)] hover:underline font-semibold" data-video-url="${escapeHtml(ex.videoUrl)}">▶️ Ver</button>
                <button type="button" class="btn-clear-ex-video text-xs text-rose-400 hover:text-rose-300 font-semibold p-1 hover:bg-rose-500/10 rounded-md transition-all" title="Eliminar vídeo de este ejercicio">🗑️ Quitar</button>
              ` : ""}
            </div>
          </div>
        </div>
      `;
    }).join("");

    list.querySelectorAll(".exercise-row").forEach(row => {
      const idx = parseInt(row.getAttribute("data-index") || "0");
      
      row.querySelector(".catalog-select")?.addEventListener("change", (e) => {
        const catId = (e.target as HTMLSelectElement).value;
        const catalogItem = allCatalogExercises.find(c => c.id === catId);
        if (catalogItem && editingExercises[idx]) {
          editingExercises[idx].id = catalogItem.id;
          editingExercises[idx].name = getExerciseName(catalogItem, "es");
          editingExercises[idx].sets = catalogItem.defaultSets || 3;
          editingExercises[idx].reps = catalogItem.defaultReps || 10;
          editingExercises[idx].restTime = `${catalogItem.defaultRestSeconds || 60}s`;
          renderExercisesEditor();
        }
      });

      row.querySelector(".ex-name")?.addEventListener("input", (e) => {
        if (editingExercises[idx]) editingExercises[idx].name = (e.target as HTMLInputElement).value;
      });
      row.querySelector(".ex-day")?.addEventListener("change", (e) => {
        if (editingExercises[idx]) editingExercises[idx].dayOfWeek = parseInt((e.target as HTMLSelectElement).value) || 1;
      });
      row.querySelector(".ex-sets")?.addEventListener("input", (e) => {
        if (editingExercises[idx]) editingExercises[idx].sets = parseInt((e.target as HTMLInputElement).value) || 3;
      });
      row.querySelector(".ex-reps")?.addEventListener("input", (e) => {
        if (editingExercises[idx]) editingExercises[idx].reps = parseInt((e.target as HTMLInputElement).value) || 10;
      });
      row.querySelector(".ex-rest")?.addEventListener("input", (e) => {
        if (editingExercises[idx]) editingExercises[idx].restTime = (e.target as HTMLInputElement).value;
      });
      row.querySelector(".ex-video-url")?.addEventListener("input", (e) => {
        if (editingExercises[idx]) editingExercises[idx].videoUrl = (e.target as HTMLInputElement).value;
      });

      // Subida de vídeo para este ejercicio
      const fileInput = row.querySelector(".ex-video-file-input") as HTMLInputElement | null;
      const uploadBtn = row.querySelector(".btn-upload-ex-video") as HTMLButtonElement | null;
      uploadBtn?.addEventListener("click", () => fileInput?.click());

      fileInput?.addEventListener("change", async () => {
        const file = fileInput.files?.[0];
        if (!file || !editingExercises[idx]) return;

        const val = validateMediaFile(file, 100);
        if (!val.valid) {
          showToast({ message: val.message || "Vídeo no válido", type: "error" });
          return;
        }

        try {
          if (uploadBtn) uploadBtn.innerHTML = "<span>⏳ Subiendo vídeo...</span>";
          const res = await uploadFileToR2(file, {
            folder: "exercises",
            entityId: editingExercises[idx].id || `ex-${idx}`,
          });

          if (res.url && editingExercises[idx]) {
            editingExercises[idx].videoUrl = res.url;
            showToast({ message: "Vídeo subido y vinculado correctamente al ejercicio", type: "success" });
            renderExercisesEditor();
          }
        } catch (err) {
          logger.error("TrainerWorkouts", "Error subiendo vídeo:", err);
          showToast({ message: "Error al subir el vídeo", type: "error" });
        } finally {
          if (uploadBtn) uploadBtn.innerHTML = "<span>☁️ Subir Vídeo</span>";
        }
      });

      // Quitar vídeo del ejercicio
      row.querySelector(".btn-clear-ex-video")?.addEventListener("click", () => {
        if (editingExercises[idx]) {
          editingExercises[idx].videoUrl = "";
          showToast({ message: "Vídeo desvinculado del ejercicio", type: "info" });
          renderExercisesEditor();
        }
      });

      // Previsualizar vídeo del ejercicio
      row.querySelector(".btn-preview-ex-video")?.addEventListener("click", () => {
        const url = editingExercises[idx]?.videoUrl;
        const videoModal = document.getElementById("video-player-modal");
        const videoModalElement = document.getElementById("modal-video-element") as HTMLVideoElement | null;
        const videoModalTitle = document.getElementById("video-modal-title");

        if (url && videoModal && videoModalElement) {
          videoModalElement.src = url;
          if (videoModalTitle) videoModalTitle.textContent = `Vídeo de Técnica: ${editingExercises[idx]?.name || 'Ejercicio'}`;
          videoModal.classList.remove("hidden");
          videoModalElement.play().catch(() => {});
        }
      });
    });

    list.querySelectorAll("[data-remove-exercise]").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute("data-remove-exercise") || "0");
        editingExercises.splice(idx, 1);
        renderExercisesEditor();
      });
    });
  }
</script>