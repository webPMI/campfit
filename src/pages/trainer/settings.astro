---
import TrainerLayout from '@/layouts/TrainerLayout.astro';
import { getT } from '@/lib/shared/i18n';

const t = getT(Astro.url.searchParams.get('lang'));

// Translations needed by client-side JS
const clientTranslations = {
  'admin.settings.profile': t('admin.settings.profile'),
  'admin.settings.profile.error': t('admin.settings.profile.error'),
  'admin.settings.profile.saving': t('admin.settings.profile.saving'),
  'admin.settings.profile.save': t('admin.settings.profile.save'),
  'admin.settings.profile.name.required': t('admin.settings.profile.name.required'),
  'admin.settings.password.saving': t('admin.settings.password.saving'),
  'admin.settings.password.btn': t('admin.settings.password.btn'),
  'admin.settings.password.minlength': t('admin.settings.password.minlength'),
  'admin.settings.password.mismatch': t('admin.settings.password.mismatch'),
  'admin.settings.logout.confirm': t('admin.settings.logout.confirm'),
  'admin.settings.logout.error': t('admin.settings.logout.error'),
};
---

<TrainerLayout>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="animate-fade-in">
      <h1 class="text-2xl font-bold">{t('trainer.settings') || 'Configuración'}</h1>
      <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t('trainer.settings.desc') || 'Configuración de tu cuenta'}</p>

      <div class="mt-8 space-y-6">
        <!-- Profile Section -->
        <div id="profile-section" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 backdrop-blur-sm">
          <div id="profile-loading" class="flex items-center justify-center py-8">
            <div class="flex items-center gap-3">
              <svg class="h-5 w-5 animate-spin text-[var(--brand)]" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
              </svg>
              <p class="text-sm text-[var(--text-tertiary)]">{t('admin.loading')}</p>
            </div>
          </div>
        </div>

        <!-- Edit Profile Form -->
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 backdrop-blur-sm">
          <h2 class="text-lg font-semibold text-[var(--text-primary)]">{t('admin.settings.profile')}</h2>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t('admin.settings.profile.desc')}</p>

          <form id="profile-form" class="mt-4 space-y-4">
            <div>
              <label for="edit-name" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5">{t('auth.name')}</label>
              <input
                id="edit-name"
                type="text"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm transition-all focus:border-[var(--border-brand)] focus:outline-none focus:ring-1 focus:ring-[var(--brand-dim)]"
              />
            </div>
            <div>
              <label for="edit-email" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5">{t('auth.email')}</label>
              <input
                id="edit-email"
                type="email"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm transition-all focus:border-[var(--border-brand)] focus:outline-none focus:ring-1 focus:ring-[var(--brand-dim)]"
              />
            </div>
            <button
              id="save-profile-btn"
              type="submit"
              class="rounded-xl bg-[var(--brand)] px-6 py-2.5 text-sm font-medium text-[var(--text-on-brand)] transition-all hover:bg-[var(--brand-hover)] active:scale-[0.98]"
            >
              {t('client.medical.save')}
            </button>
          </form>
        </div>

        <!-- Change Password -->
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-6 backdrop-blur-sm">
          <h2 class="text-lg font-semibold text-[var(--text-primary)]">{t('admin.settings.password')}</h2>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t('admin.settings.password.desc')}</p>

          <form id="password-form" class="mt-4 space-y-4">
            <div>
              <label for="new-password" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5">{t('admin.settings.password.new')}</label>
              <input
                id="new-password"
                type="password"
                placeholder="••••••••"
                minlength="6"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm transition-all focus:border-[var(--border-brand)] focus:outline-none focus:ring-1 focus:ring-[var(--brand-dim)]"
              />
            </div>
            <div>
              <label for="confirm-password" class="block text-xs font-medium text-[var(--text-secondary)] mb-1.5">{t('admin.settings.password.confirm')}</label>
              <input
                id="confirm-password"
                type="password"
                placeholder="••••••••"
                minlength="6"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] backdrop-blur-sm transition-all focus:border-[var(--border-brand)] focus:outline-none focus:ring-1 focus:ring-[var(--brand-dim)]"
              />
            </div>
            <button
              id="save-password-btn"
              type="submit"
              class="rounded-xl bg-[var(--brand)] px-6 py-2.5 text-sm font-medium text-[var(--text-on-brand)] transition-all hover:bg-[var(--brand-hover)] active:scale-[0.98]"
            >
              {t('admin.settings.password.btn')}
            </button>
          </form>
        </div>

        <!-- Danger Zone -->
        <div class="rounded-xl border border-red-900/30 bg-[var(--danger-dim)] p-6 backdrop-blur-sm">
          <h2 class="text-lg font-semibold text-[var(--danger)]">{t('admin.settings.danger')}</h2>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t('admin.settings.danger.desc')}</p>

          <div class="mt-4 space-y-3">
            <button id="btn-logout" class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-4 py-3 text-sm font-medium text-[var(--text-secondary)] backdrop-blur-sm transition-all hover:bg-[var(--surface-3)]">
              {t('admin.settings.logout')}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</TrainerLayout>

<script is:inline set:html={`window.__TRAINER_SETTINGS_TRANSLATIONS__ = ${JSON.stringify(clientTranslations)};`}></script>

<script>
  import { requireAuth, signOutUser } from '@/lib/shared/authGuard';
  import { showToast } from '@/lib/shared/ui';
  import { loadProfile, updateProfile, changePassword, renderProfileView, renderProfileLoadingState } from '@/lib/shared/profileService';
  import { logger } from '@/lib/shared/logger';

  const tr = (key: string): string =>
    (window as any).__TRAINER_SETTINGS_TRANSLATIONS__?.[key] || key;

  const unsubInit = requireAuth(async (user) => {
    await initSettings(user);
  });

  document.addEventListener('astro:before-swap', () => {
    unsubInit?.();
  });

  function renderProfileEmptyState(
    container: HTMLElement,
    user: import('firebase/auth').User,
    nameInput: HTMLInputElement,
    emailInput: HTMLInputElement
  ): void {
    container.innerHTML = `
      <h2 class="text-lg font-semibold text-[var(--text-primary)] mb-4">${tr('admin.settings.profile')}</h2>
      <div class="flex flex-col items-center justify-center py-8 text-center">
        <svg class="h-12 w-12 text-[var(--text-disabled)] mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
        <p class="text-sm text-[var(--text-tertiary)]">${tr('admin.settings.profile.error')}</p>
        <button id="btn-retry-profile" class="mt-3 rounded-xl bg-[var(--surface-3)] px-4 py-2 text-xs font-medium text-[var(--text-secondary)] transition-all hover:bg-[var(--surface-4)] active:scale-[0.98]">
          Reintentar
        </button>
      </div>
    `;
    document.getElementById('btn-retry-profile')?.addEventListener('click', async () => {
      container.innerHTML = renderProfileLoadingState();
      const retryProfile = await loadProfile(user.uid);
      if (retryProfile) {
        container.innerHTML = `
          <h2 class="text-lg font-semibold text-[var(--text-primary)] mb-4">${tr('admin.settings.profile')}</h2>
          ${renderProfileView(retryProfile)}
        `;
        nameInput.value = retryProfile.name;
        emailInput.value = retryProfile.email;
      }
    });
  }

  async function initSettings(user: import('firebase/auth').User): Promise<void> {
    const profileSection = document.getElementById('profile-section')!;
    const nameInput = document.getElementById('edit-name') as HTMLInputElement;
    const emailInput = document.getElementById('edit-email') as HTMLInputElement;

    profileSection.innerHTML = renderProfileLoadingState();
    const profile = await loadProfile(user.uid);

    if (profile) {
      profileSection.innerHTML = `
        <h2 class="text-lg font-semibold text-[var(--text-primary)] mb-4">${tr('admin.settings.profile')}</h2>
        ${renderProfileView(profile)}
      `;
      nameInput.value = profile.name;
      emailInput.value = profile.email;
    } else {
      // Empty state with retry button
      renderProfileEmptyState(profileSection, user, nameInput, emailInput);
    }

    document.getElementById('profile-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      if (!name) { showToast({ message: tr('admin.settings.profile.name.required'), type: 'error' }); return; }

      const btn = document.getElementById('save-profile-btn')!;
      btn.textContent = tr('admin.settings.profile.saving');
      (btn as HTMLButtonElement).disabled = true;

      const result = await updateProfile(user.uid, { name, email });
      showToast({ message: result.message, type: result.success ? 'success' : 'error' });

      if (result.success) {
        const refreshed = await loadProfile(user.uid);
        if (refreshed) {
          const container = profileSection.querySelector('.flex.items-center.gap-5');
          if (container) container.outerHTML = renderProfileView(refreshed);
        }
      }
      btn.textContent = tr('admin.settings.profile.save');
      (btn as HTMLButtonElement).disabled = false;
    });

    document.getElementById('password-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const newPwd = (document.getElementById('new-password') as HTMLInputElement).value;
      const confirmPwd = (document.getElementById('confirm-password') as HTMLInputElement).value;

      if (!newPwd || newPwd.length < 6) { showToast({ message: tr('admin.settings.password.minlength'), type: 'error' }); return; }
      if (newPwd !== confirmPwd) { showToast({ message: tr('admin.settings.password.mismatch'), type: 'error' }); return; }

      const btn = document.getElementById('save-password-btn')!;
      btn.textContent = tr('admin.settings.password.saving');
      (btn as HTMLButtonElement).disabled = true;

      const result = await changePassword(user, newPwd);
      showToast({ message: result.message, type: result.success ? 'success' : 'error' });
      if (result.success) {
        (document.getElementById('new-password') as HTMLInputElement).value = '';
        (document.getElementById('confirm-password') as HTMLInputElement).value = '';
      }
      btn.textContent = tr('admin.settings.password.btn');
      (btn as HTMLButtonElement).disabled = false;
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('btn-logout')?.addEventListener('click', async () => {
      if (!confirm(tr('admin.settings.logout.confirm'))) return;
      try {
        await signOutUser();
      } catch (err) {
        logger.error('TrainerSettings', 'Error signing out', err);
        showToast({ message: tr('admin.settings.logout.error'), type: 'error' });
      }
    });
  });
</script>
