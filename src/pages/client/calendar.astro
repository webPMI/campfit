---
import ClientLayout from "@/layouts/ClientLayout.astro";
import TimeGrid from "@/components/calendar/TimeGrid.astro";
import PageTransition from "@/components/PageTransition.astro";
import SkeletonGroup from "@/components/SkeletonGroup.astro";
---

<ClientLayout>
  <main class="mx-auto max-w-4xl px-4 py-6">
    <PageTransition animation="fade-up">
      <!-- Encabezado Pro-UX -->
      <header class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-2xl">📅</span>
            <h1 class="text-2xl font-black tracking-tight text-[var(--text-primary)]">Mi Agenda Diaria</h1>
          </div>
          <p class="text-xs text-[var(--text-tertiary)] mt-1 font-medium">Plan estructurado de comidas y entrenamientos de hoy</p>
        </div>

        <a
          href="/client/dashboard"
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] text-xs font-bold text-[var(--text-secondary)] hover:border-[var(--brand)] hover:text-[var(--brand)] transition-all shadow-sm"
        >
          <span>←</span>
          <span>Volver al Dashboard</span>
        </a>
      </header>

      <!-- Estado de Carga -->
      <div id="loading-state" class="min-h-[400px]">
        <SkeletonGroup variant="dashboard" />
      </div>

      <!-- Estado Empty Inteligente -->
      <div id="empty-state" class="hidden rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-8 text-center backdrop-blur-xl space-y-4">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-500/10 text-3xl text-amber-400 border border-amber-500/20">
          🗓️
        </div>
        <div class="space-y-1 max-w-md mx-auto">
          <h2 class="text-base font-bold text-[var(--text-primary)]">No tienes actividades asignadas para hoy</h2>
          <p class="text-xs text-[var(--text-tertiary)]">Tu entrenador aún no ha programado una rutina o plan nutricional para este día, o es tu día de descanso total.</p>
        </div>
        <div class="flex items-center justify-center gap-3 pt-2">
          <a
            href="/client/chat"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[var(--brand)] text-[var(--text-on-brand)] text-xs font-bold shadow-md hover:opacity-95 transition-all"
          >
            <span>💬</span>
            <span>Contactar a mi Entrenador</span>
          </a>
        </div>
      </div>

      <!-- Contenido Principal -->
      <div id="calendar-content" class="hidden">
        <TimeGrid />
      </div>
    </PageTransition>
  </main>
</ClientLayout>

<script>
  import { initPage } from '@/lib/shared/initPage';
  import { subscribeToDailySchedule } from '@/lib/client/dailyScheduleService';
  import { setDailySchedule } from '@/stores/dailyScheduleStore';

  const loadingState = document.getElementById('loading-state');
  const calendarContent = document.getElementById('calendar-content');
  const emptyState = document.getElementById('empty-state');

  let unsubSchedule: (() => void) | null = null;

  const cleanup = initPage({
    allowedRoles: ['client', 'admin', 'trainer'],
    onReady: async (firebaseUser, userData) => {
      // Modo espejo: si un admin/trainer especifica ?uid=xxx, ver la agenda de ese cliente
      const paramUid = new URLSearchParams(window.location.search).get('uid');
      const targetUid = (userData?.role === 'admin' || userData?.role === 'trainer') && paramUid
        ? paramUid
        : firebaseUser.uid;

      window.dispatchEvent(new CustomEvent('schedule:client-ready', { detail: { clientId: targetUid } }));

      unsubSchedule = subscribeToDailySchedule(
        targetUid,
        (data) => {
          if (loadingState) loadingState.classList.add('hidden');

          const allMeals = data.diets.flatMap((d) => d.meals || []);
          if (allMeals.length === 0 && data.workouts.length === 0) {
            calendarContent?.classList.add('hidden');
            emptyState?.classList.remove('hidden');
          } else {
            emptyState?.classList.add('hidden');
            calendarContent?.classList.remove('hidden');
            setDailySchedule(allMeals, data.workouts);
          }
        },
        (_err) => {
          if (loadingState) loadingState.classList.add('hidden');
          if (emptyState) emptyState.classList.remove('hidden');
        }
      );
    },
  });

  document.addEventListener('astro:before-swap', () => {
    unsubSchedule?.();
    cleanup();
  });
</script>
