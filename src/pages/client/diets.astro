---
import ClientLayout from "@/layouts/ClientLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<ClientLayout>
  <div id="loadingScreen" class="flex min-h-screen items-center justify-center">
    <div class="text-center animate-fade-in">
      <div
        class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-[var(--border-strong)] border-t-emerald-400"
      >
      </div>
      <p id="loadingText" class="mt-4 text-sm text-[var(--text-tertiary)]">
        {t("dashboard.loading")}
      </p>
    </div>
  </div>

  <div id="dietsContent" class="hidden">
    <main class="mx-auto max-w-4xl px-4 py-6">
      <div class="animate-fade-in space-y-6">
        <!-- Header -->
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div>
            <h2 data-i18n="client.nav.diets" class="text-xl font-bold text-[var(--text-primary)]">{t("client.nav.diets")}</h2>
            <p data-i18n="client.diet.sub" class="mt-1 text-sm text-[var(--text-tertiary)]">
              {t("client.diet.sub")}
            </p>
          </div>
          <div class="flex items-center gap-2">
            <button
              id="btn-open-diet-proposal-modal"
              class="rounded-xl border border-[var(--border-brand)] bg-[var(--brand-dim)] px-3.5 py-2 text-xs font-semibold text-[var(--brand)] hover:bg-[var(--brand)] hover:text-black transition-all flex items-center gap-1.5 shadow-sm"
            >
              <span>✨</span>
              <span data-i18n="proposal.customize.diet">{t("proposal.customize.diet")}</span>
            </button>
            <!-- Historial button -->
            <button
              id="btn-history"
              class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2 text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all hidden"
            >
              <svg
                class="h-3.5 w-3.5 inline-block mr-1 -mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
              </svg>
              <span data-i18n="client.diet.history">{t("client.diet.history")}</span>
            </button>
          </div>
        </div>

        <!-- Banner de Estado de Propuesta de Personalización de Dieta -->
        <div id="diet-proposal-status-banner" class="hidden rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4 backdrop-blur-xl space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-lg">🥗</span>
              <div>
                <h4 class="text-xs font-bold text-emerald-300">Propuesta de Dieta y Horarios</h4>
                <p id="diet-proposal-banner-desc" class="text-[11px] text-emerald-200/80">Tu propuesta está pendiente de revisión por tu entrenador.</p>
              </div>
            </div>
            <span id="diet-proposal-banner-status" class="rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider">Pendiente</span>
          </div>
          <div id="diet-proposal-banner-feedback" class="hidden text-xs bg-zinc-900/80 p-3 rounded-xl border border-zinc-700 text-zinc-300">
            <p class="font-bold text-amber-300 mb-0.5">💬 Consejo nutricional de tu entrenador:</p>
            <p id="diet-proposal-feedback-text"></p>
          </div>
        </div>

        <!-- Water Tracker (Control de Hidratación) -->
        <div
          class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-5 backdrop-blur-xl space-y-3"
        >
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-500/10 text-blue-400 border border-blue-500/20 text-lg"
              >
                💧
              </div>
              <div>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">
                  {t("client.waterTracker.title")}
                </h3>
                <p class="text-[11px] text-[var(--text-tertiary)]">
                  {t("client.waterTracker.goal")} (<span id="water-glasses">0</span> / 8 {
                    t("client.waterTracker.glasses")
                  })
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-sub-water"
                class="flex h-8 w-8 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] text-sm font-bold text-[var(--text-primary)] hover:bg-[var(--surface-4)] active:scale-95 transition-all"
              >
                -
              </button>
              <span
                id="water-current"
                class="text-base font-bold text-blue-400 min-w-[65px] text-center">0 ml</span
              >
              <button
                type="button"
                id="btn-add-water"
                class="flex h-8 w-8 items-center justify-center rounded-xl bg-blue-500 text-white text-sm font-bold shadow-md shadow-blue-500/20 hover:bg-blue-600 active:scale-95 transition-all"
              >
                +
              </button>
            </div>
          </div>

          <!-- Barra de agua -->
          <div class="h-2 overflow-hidden rounded-full bg-[var(--surface-3)]">
            <div
              id="water-bar-fill"
              class="h-full rounded-full bg-gradient-to-r from-blue-500 to-cyan-400 transition-all duration-500"
              style="width: 0%"
            >
            </div>
          </div>
        </div>

        <!-- Adherence Daily Bar (Progreso de comidas) -->
        <div
          id="adherence-bar"
          class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl hidden"
        >
          <div class="flex items-center justify-between text-xs mb-2">
            <span class="font-semibold text-[var(--text-secondary)]">Adherencia Diaria</span>
            <span id="adherence-text" class="font-bold text-[var(--brand)]">0%</span>
          </div>
          <div class="h-2 overflow-hidden rounded-full bg-[var(--surface-3)]">
            <div
              id="adherence-fill"
              class="h-full rounded-full bg-gradient-to-r from-[var(--brand)] to-emerald-400 transition-all duration-500"
              style="width: 0%"
            >
            </div>
          </div>
        </div>

        <!-- Macros Consumed vs Target -->
        <div
          class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center"
          id="macros-consumed-grid"
        >
          <div
            class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-1)] p-3 backdrop-blur-xl"
          >
            <span class="block text-[10px] uppercase font-bold text-[var(--text-tertiary)]"
              >Calorías</span
            >
            <div class="mt-1 text-sm font-bold text-amber-400">
              <span id="consumed-kcal">0</span> / <span id="target-kcal">0</span>
            </div>
            <span class="text-[10px] text-[var(--text-disabled)]">kcal</span>
          </div>
          <div
            class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-1)] p-3 backdrop-blur-xl"
          >
            <span class="block text-[10px] uppercase font-bold text-[var(--text-tertiary)]"
              >Proteínas</span
            >
            <div class="mt-1 text-sm font-bold text-emerald-400">
              <span id="consumed-protein">0</span> / <span id="target-protein">0</span>g
            </div>
            <span class="text-[10px] text-[var(--text-disabled)]">consumido</span>
          </div>
          <div
            class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-1)] p-3 backdrop-blur-xl"
          >
            <span class="block text-[10px] uppercase font-bold text-[var(--text-tertiary)]"
              >Carbohidratos</span
            >
            <div class="mt-1 text-sm font-bold text-blue-400">
              <span id="consumed-carbs">0</span> / <span id="target-carbs">0</span>g
            </div>
            <span class="text-[10px] text-[var(--text-disabled)]">consumido</span>
          </div>
          <div
            class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-1)] p-3 backdrop-blur-xl"
          >
            <span class="block text-[10px] uppercase font-bold text-[var(--text-tertiary)]"
              >Grasas</span
            >
            <div class="mt-1 text-sm font-bold text-purple-400">
              <span id="consumed-fat">0</span> / <span id="target-fat">0</span>g
            </div>
            <span class="text-[10px] text-[var(--text-disabled)]">consumido</span>
          </div>
        </div>

        <!-- Current Diet Plan Details -->
        <div id="dietCard" class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-6 hidden">
          <div class="flex items-start justify-between flex-wrap gap-4 border-b border-[var(--border-subtle)] pb-4">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h3 id="dietName" class="text-lg font-bold text-[var(--text-primary)]"></h3>
                <span id="dietType" class="rounded-full bg-[var(--brand-dim)] px-2.5 py-0.5 text-xs font-semibold text-[var(--brand)] border border-[var(--border-brand)]"></span>
                <span id="dietSomatotype" class="rounded-full bg-purple-500/10 px-2.5 py-0.5 text-xs font-semibold text-purple-400 border border-purple-500/20 hidden"></span>
              </div>
              <p id="dietCalories" class="mt-1 text-sm font-semibold text-amber-400"></p>
            </div>

            <!-- Macros target banner -->
            <div class="flex items-center gap-3 text-xs font-semibold flex-wrap">
              <span class="rounded-lg bg-emerald-500/10 px-2.5 py-1 text-emerald-400 border border-emerald-500/20">Prot: <span id="totalProtein">0</span>g</span>
              <span class="rounded-lg bg-blue-500/10 px-2.5 py-1 text-blue-400 border border-blue-500/20">Carbs: <span id="totalCarbs">0</span>g</span>
              <span class="rounded-lg bg-purple-500/10 px-2.5 py-1 text-purple-400 border border-purple-500/20">Grasas: <span id="totalFat">0</span>g</span>
              <span class="rounded-lg bg-amber-500/10 px-2.5 py-1 text-amber-400 border border-amber-500/20">Total: <span id="totalCal">0</span> kcal</span>
            </div>
          </div>

          <!-- Meals List -->
          <div class="space-y-4">
            <h4 class="text-sm font-bold uppercase tracking-wider text-[var(--text-secondary)]">Tomas y Comidas Asignadas</h4>
            <div id="mealsList" class="space-y-3"></div>
          </div>
        </div>

        <!-- History View -->
        <div id="historyView" class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4 hidden">
          <div class="flex items-center justify-between">
            <h3 data-i18n="client.diet.history" class="text-base font-bold text-[var(--text-primary)]">
              {t("client.diet.history")}
            </h3>
            <button
              id="btn-back-current"
              class="text-xs font-medium text-[var(--brand)] hover:underline flex items-center gap-1"
            >
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"></path>
              </svg>
              <span data-i18n="client.diet.current">{t("client.diet.current")}</span>
            </button>
          </div>
          <div id="historyList" class="space-y-2"></div>
        </div>

        <!-- Hub de Nutrición Autónoma & Calculadora Metabólica para Clientes Sin Dieta Asignada -->
        <div id="autonomy-nutrition-hub" class="hidden space-y-6">
          <!-- Tarjeta Calculadora Metabólica (BMR / TDEE / Macros) -->
          <div class="card-glow rounded-2xl border border-[var(--border-brand)]/40 bg-gradient-to-br from-[var(--surface-1)] to-[var(--brand-dim)]/20 p-6 backdrop-blur-xl space-y-5">
            <div class="flex items-center justify-between flex-wrap gap-3">
              <div class="flex items-center gap-3">
                <span class="text-3xl">🥗</span>
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="text-base font-bold text-[var(--text-primary)]">Nutrición Autónoma & Calculadora Metabólica</h3>
                    <span class="rounded-full bg-[var(--brand-dim)] text-[var(--brand)] border border-[var(--border-brand)] px-2 py-0.5 text-[10px] font-bold">Cálculo Científico</span>
                  </div>
                  <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                    Calcula tu gasto energético diario (TDEE) y la distribución óptima de macronutrientes adaptada a tu meta.
                  </p>
                </div>
              </div>
              <a
                href="/client/support/report"
                class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] hover:bg-[var(--surface-4)] px-3.5 py-2 text-xs font-bold text-[var(--text-primary)] transition-all flex items-center gap-1.5"
              >
                <span>👨‍⚕️ Solicitar Plan Nutricional</span>
                <span>→</span>
              </a>
            </div>

            <!-- Formulario de Parámetros Biológicos -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 pt-2">
              <div>
                <label class="block text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider mb-1">Peso (kg)</label>
                <input id="calc-weight" type="number" step="0.5" value="75" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-xs font-bold text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand)]" />
              </div>
              <div>
                <label class="block text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider mb-1">Altura (cm)</label>
                <input id="calc-height" type="number" value="175" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-xs font-bold text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand)]" />
              </div>
              <div>
                <label class="block text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider mb-1">Edad (años)</label>
                <input id="calc-age" type="number" value="26" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-xs font-bold text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand)]" />
              </div>
              <div>
                <label class="block text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider mb-1">Género</label>
                <select id="calc-gender" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2 py-2 text-xs font-bold text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand)]">
                  <option value="male">Hombre</option>
                  <option value="female">Mujer</option>
                </select>
              </div>
              <div>
                <label class="block text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider mb-1">Actividad</label>
                <select id="calc-activity" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2 py-2 text-xs font-bold text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand)]">
                  <option value="sedentary">Sedentario (Oficina)</option>
                  <option value="light">Ligero (1-2 días)</option>
                  <option value="moderate" selected>Moderado (3-5 días)</option>
                  <option value="active">Activo (6-7 días)</option>
                  <option value="very_active">Atleta Intenso</option>
                </select>
              </div>
              <div>
                <label class="block text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider mb-1">Objetivo</label>
                <select id="calc-goal" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2 py-2 text-xs font-bold text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand)]">
                  <option value="fat_loss">Pérdida / Definición</option>
                  <option value="maintenance" selected>Mantenimiento</option>
                  <option value="muscle_gain">Ganancia Muscular</option>
                </select>
              </div>
            </div>

            <!-- Resultados Calculados en Tiempo Real -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
              <div class="rounded-xl border border-[var(--border-brand)]/40 bg-[var(--surface-2)] p-3 text-center space-y-1">
                <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase">Calorías Diarias</span>
                <p id="res-target-kcal" class="text-xl font-extrabold text-[var(--brand)]">2,350 kcal</p>
                <p id="res-tdee-sub" class="text-[10px] text-[var(--text-tertiary)]">TDEE: 2,350 kcal</p>
              </div>
              <div class="rounded-xl border border-red-500/30 bg-red-500/5 p-3 text-center space-y-1">
                <span class="text-[10px] font-bold text-red-400 uppercase">🍗 Proteínas</span>
                <p id="res-protein" class="text-xl font-extrabold text-red-300">150g</p>
                <p id="res-protein-sub" class="text-[10px] text-red-400/70">600 kcal (26%)</p>
              </div>
              <div class="rounded-xl border border-amber-500/30 bg-amber-500/5 p-3 text-center space-y-1">
                <span class="text-[10px] font-bold text-amber-400 uppercase">🍚 Carbohidratos</span>
                <p id="res-carbs" class="text-xl font-extrabold text-amber-300">275g</p>
                <p id="res-carbs-sub" class="text-[10px] text-amber-400/70">1,100 kcal (47%)</p>
              </div>
              <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-3 text-center space-y-1">
                <span class="text-[10px] font-bold text-emerald-400 uppercase">🥑 Grasas</span>
                <p id="res-fat" class="text-xl font-extrabold text-emerald-300">68g</p>
                <p id="res-fat-sub" class="text-[10px] text-emerald-400/70">612 kcal (27%)</p>
              </div>
            </div>

            <div class="flex items-center justify-between gap-3 pt-2 border-t border-[var(--border-subtle)] flex-wrap">
              <span id="res-water-advice" class="text-xs text-blue-400 font-semibold flex items-center gap-1">
                💧 Hidratación recomendada: 2.6L diarios
              </span>
              <button
                type="button"
                id="btn-save-metabolic-goal"
                class="rounded-xl bg-[var(--brand)] hover:bg-[var(--brand-hover)] px-5 py-2 text-xs font-bold text-[var(--text-on-brand)] shadow-md transition-all active:scale-95 flex items-center gap-1.5"
              >
                <span>💾 Guardar Mi Objetivo Nutricional</span>
              </button>
            </div>
          </div>

          <!-- Explorador Interactivo de Alimentos & Alérgenos -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4">
            <div class="flex items-center justify-between flex-wrap gap-3">
              <div>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">🍎 Base de Datos de Alimentos & Alérgenos</h3>
                <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Consulta valores nutricionales por porción y filtros de intolerancias (gluten, lactosa, vegano).</p>
              </div>
              <div class="w-full sm:w-64">
                <input
                  id="foods-explorer-search"
                  type="text"
                  placeholder="Buscar alimento (ej: Pollo, Avena...)"
                  class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-1.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--brand)]"
                />
              </div>
            </div>

            <!-- Filtros por Categoría de Alimentos -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1" id="foods-category-filters">
              <button type="button" data-category="all" class="food-filter-btn active rounded-lg px-2.5 py-1 text-xs font-bold bg-[var(--brand)] text-[var(--text-on-brand)]">Todos</button>
              <button type="button" data-category="protein" class="food-filter-btn rounded-lg px-2.5 py-1 text-xs font-semibold bg-[var(--surface-3)] text-[var(--text-secondary)] hover:text-white">Proteínas</button>
              <button type="button" data-category="carbs" class="food-filter-btn rounded-lg px-2.5 py-1 text-xs font-semibold bg-[var(--surface-3)] text-[var(--text-secondary)] hover:text-white">Carbohidratos</button>
              <button type="button" data-category="fats" class="food-filter-btn rounded-lg px-2.5 py-1 text-xs font-semibold bg-[var(--surface-3)] text-[var(--text-secondary)] hover:text-white">Grasas</button>
              <button type="button" data-category="fruits" class="food-filter-btn rounded-lg px-2.5 py-1 text-xs font-semibold bg-[var(--surface-3)] text-[var(--text-secondary)] hover:text-white">Frutas</button>
              <button type="button" data-category="vegetables" class="food-filter-btn rounded-lg px-2.5 py-1 text-xs font-semibold bg-[var(--surface-3)] text-[var(--text-secondary)] hover:text-white">Verduras</button>
              <button type="button" data-category="dairy" class="food-filter-btn rounded-lg px-2.5 py-1 text-xs font-semibold bg-[var(--surface-3)] text-[var(--text-secondary)] hover:text-white">Lácteos</button>
            </div>

            <!-- Grid de Alimentos -->
            <div id="foods-explorer-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 max-h-80 overflow-y-auto pr-1"></div>
          </div>
        </div>

        <!-- Empty State -->
        <div
          id="emptyState"
          class="hidden flex flex-col items-center justify-center rounded-2xl border border-dashed border-[var(--border-default)] bg-[var(--surface-2)] p-12 text-center"
        >
          <div
            class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--surface-4)] text-2xl"
          >
            🥗
          </div>
          <h3
            data-i18n="client.no.diet"
            class="mt-4 text-lg font-semibold text-[var(--text-secondary)]"
          >
            {t("client.no.diet")}
          </h3>
          <p data-i18n="client.diet.assigned.desc" class="mt-2 text-sm text-[var(--text-disabled)]">
            {t("client.diet.assigned.desc")}
          </p>
        </div>
      </div>
    </main>
  </div>

  <!-- Modal de Sustitutos Sugeridos -->
  <div id="substitutes-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm hidden animate-fade-in">
    <div class="relative w-full max-w-lg rounded-2xl border border-[var(--border-default)] bg-[var(--surface-2)] p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
        <div>
          <h3 id="substitutes-modal-title" class="text-base font-bold text-[var(--text-primary)]">Sustitutos Sugeridos</h3>
          <p id="substitutes-modal-subtitle" class="text-xs text-[var(--text-tertiary)]"></p>
        </div>
        <button id="btn-close-substitutes" class="text-[var(--text-tertiary)] hover:text-white text-xl font-bold">&times;</button>
      </div>
      <div id="substitutes-modal-list" class="space-y-2.5 max-h-72 overflow-y-auto"></div>
    </div>
  </div>

  <!-- Modal para Personalizar Dieta y Horarios -->
  <div id="customize-diet-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md hidden animate-fade-in">
    <div class="relative w-full max-w-lg rounded-2xl border border-[var(--border-default)] bg-[var(--surface-2)] p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
        <div>
          <h3 class="text-base font-bold text-[var(--text-primary)]">✨ Personalizar Dieta y Horarios</h3>
          <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Adapta las horas de tus comidas para que tu nutricionista/coach las supervise.</p>
        </div>
        <button id="btn-close-diet-proposal-modal" class="text-[var(--text-tertiary)] hover:text-white text-xl font-bold">&times;</button>
      </div>

      <div class="space-y-4">
        <!-- Horarios de Comidas -->
        <div class="space-y-2.5">
          <label class="block text-xs font-bold text-[var(--text-secondary)]">⏰ Horarios de tus ingestas</label>
          <div class="grid grid-cols-2 gap-2.5 text-xs">
            <div class="rounded-xl border border-zinc-700 bg-zinc-800/60 p-2.5 space-y-1">
              <span class="text-[11px] font-semibold text-zinc-300">🍳 Desayuno</span>
              <input id="diet-time-breakfast" type="time" value="08:00" class="w-full rounded-lg border border-zinc-700 bg-zinc-900 px-2 py-1 text-xs text-white focus:outline-none focus:border-[var(--brand)]" />
            </div>
            <div class="rounded-xl border border-zinc-700 bg-zinc-800/60 p-2.5 space-y-1">
              <span class="text-[11px] font-semibold text-zinc-300">🥗 Almuerzo</span>
              <input id="diet-time-lunch" type="time" value="13:30" class="w-full rounded-lg border border-zinc-700 bg-zinc-900 px-2 py-1 text-xs text-white focus:outline-none focus:border-[var(--brand)]" />
            </div>
            <div class="rounded-xl border border-zinc-700 bg-zinc-800/60 p-2.5 space-y-1">
              <span class="text-[11px] font-semibold text-zinc-300">🍎 Merienda / Snack</span>
              <input id="diet-time-snack" type="time" value="17:00" class="w-full rounded-lg border border-zinc-700 bg-zinc-900 px-2 py-1 text-xs text-white focus:outline-none focus:border-[var(--brand)]" />
            </div>
            <div class="rounded-xl border border-zinc-700 bg-zinc-800/60 p-2.5 space-y-1">
              <span class="text-[11px] font-semibold text-zinc-300">🍲 Cena</span>
              <input id="diet-time-dinner" type="time" value="21:00" class="w-full rounded-lg border border-zinc-700 bg-zinc-900 px-2 py-1 text-xs text-white focus:outline-none focus:border-[var(--brand)]" />
            </div>
          </div>
        </div>

        <!-- Notas para el Nutricionista/Entrenador -->
        <div>
          <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">💬 Notas o preferencias para tu entrenador</label>
          <textarea
            id="proposal-diet-notes"
            rows="3"
            class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--brand)] resize-none"
            placeholder="Ej: He adaptado el horario por mi turno de trabajo y prefiero concentrar más carbohidratos al mediodía..."
          ></textarea>
        </div>
      </div>

      <div class="flex items-center gap-3 pt-3 border-t border-[var(--border-subtle)]">
        <button
          id="btn-submit-diet-proposal"
          class="flex-1 rounded-xl bg-[var(--brand)] hover:bg-[var(--brand-hover)] px-4 py-2.5 text-xs font-bold text-[var(--text-on-brand)] shadow-md transition-all flex items-center justify-center gap-1.5"
        >
          <span>🚀</span>
          <span id="btn-submit-diet-proposal-text">Enviar propuesta a mi entrenador</span>
        </button>
        <button
          id="btn-cancel-diet-proposal-modal"
          class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-4 py-2.5 text-xs font-medium text-[var(--text-secondary)] hover:text-white"
        >
          Cancelar
        </button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div
    id="diet-toast"
    class="fixed bottom-24 left-1/2 z-50 -translate-x-1/2 rounded-xl border px-6 py-3 text-sm font-medium backdrop-blur-xl shadow-2xl hidden"
  >
  </div>
</ClientLayout>

<script>
  import { initPage } from "@/lib/shared/initPage";
  import {
    subscribeToDiets,
    subscribeToDietHistory,
    subscribeToTodayMeals,
    registerMealComplete,
    type Diet,
    type Meal,
  } from "@/lib/client/dietService";
  import {
    createPlanProposal,
    subscribeToClientProposals,
    type PlanProposal,
  } from "@/lib/shared/planProposalService";
  import {
    subscribeToFoods,
    getFoodName,
    type FoodItem,
  } from "@/lib/shared/foodLibrary";
  import { suggestSubstitutes } from "@/lib/client/intoleranceChecker";
  import {
    calculateMetabolicProfile,
    saveUserMetabolicGoal,
    getCachedMetabolicProfile,
    type UserMetabolicInput,
    type MetabolicCalculationResult,
    type ActivityLevel,
    type NutritionalGoal,
    type BiologicalGender,
  } from "@/lib/client/metabolicCalculator";
  import { FOODS_CATALOG } from "@/lib/data/foodsCatalog";
  import { t } from "@/i18n/client";
  import { escapeHtml } from "@/lib/shared/ui";
  import type { MedicalProfile } from "@/types";

  // ─── DOM refs ────────────────────────────────────────────────────────────────
  const loadingScreen = document.getElementById("loadingScreen")!;
  const loadingText = document.getElementById("loadingText")!;
  const dietsContent = document.getElementById("dietsContent")!;
  const dietCard = document.getElementById("dietCard")!;
  const emptyState = document.getElementById("emptyState")!;
  const dietName = document.getElementById("dietName")!;
  const dietType = document.getElementById("dietType")!;
  const dietSomatotype = document.getElementById("dietSomatotype")!;
  const dietCalories = document.getElementById("dietCalories")!;
  const mealsList = document.getElementById("mealsList")!;
  const totalCal = document.getElementById("totalCal")!;
  const totalProtein = document.getElementById("totalProtein")!;
  const totalCarbs = document.getElementById("totalCarbs")!;
  const totalFat = document.getElementById("totalFat")!;
  const adherenceBar = document.getElementById("adherence-bar")!;
  const adherenceFill = document.getElementById("adherence-fill")!;
  const adherenceText = document.getElementById("adherence-text")!;
  const btnHistory = document.getElementById("btn-history")!;
  const historyView = document.getElementById("historyView")!;
  const historyList = document.getElementById("historyList")!;
  const btnBackCurrent = document.getElementById("btn-back-current")!;
  const toast = document.getElementById("diet-toast")!;

  // Autonomy Nutrition & Metabolic Hub refs
  const autonomyNutritionHub = document.getElementById("autonomy-nutrition-hub");
  const calcWeight = document.getElementById("calc-weight") as HTMLInputElement | null;
  const calcHeight = document.getElementById("calc-height") as HTMLInputElement | null;
  const calcAge = document.getElementById("calc-age") as HTMLInputElement | null;
  const calcGender = document.getElementById("calc-gender") as HTMLSelectElement | null;
  const calcActivity = document.getElementById("calc-activity") as HTMLSelectElement | null;
  const calcGoal = document.getElementById("calc-goal") as HTMLSelectElement | null;

  const resTargetKcal = document.getElementById("res-target-kcal");
  const resTdeeSub = document.getElementById("res-tdee-sub");
  const resProtein = document.getElementById("res-protein");
  const resProteinSub = document.getElementById("res-protein-sub");
  const resCarbs = document.getElementById("res-carbs");
  const resCarbsSub = document.getElementById("res-carbs-sub");
  const resFat = document.getElementById("res-fat");
  const resFatSub = document.getElementById("res-fat-sub");
  const resWaterAdvice = document.getElementById("res-water-advice");
  const btnSaveMetabolicGoal = document.getElementById("btn-save-metabolic-goal");

  // Foods Explorer refs
  const foodsExplorerSearch = document.getElementById("foods-explorer-search") as HTMLInputElement | null;
  const foodsCategoryFilterBtns = document.querySelectorAll(".food-filter-btn");
  const foodsExplorerGrid = document.getElementById("foods-explorer-grid");

  let activeFoodCategory = "all";
  let activeFoodSearch = "";
  let lastCalculatedProfile: MetabolicCalculationResult | null = null;

  // Sustitutos modal refs
  const substitutesModal = document.getElementById("substitutes-modal")!;
  const substitutesModalTitle = document.getElementById("substitutes-modal-title")!;
  const substitutesModalSubtitle = document.getElementById("substitutes-modal-subtitle")!;
  const substitutesModalList = document.getElementById("substitutes-modal-list")!;
  const btnCloseSubstitutes = document.getElementById("btn-close-substitutes")!;

  // Water Tracker refs
  const btnAddWater = document.getElementById("btn-add-water")!;
  const btnSubWater = document.getElementById("btn-sub-water")!;
  const waterCurrentEl = document.getElementById("water-current")!;
  const waterGlassesEl = document.getElementById("water-glasses")!;
  const waterBarFill = document.getElementById("water-bar-fill")!;

  // Consumed Macro refs
  const consumedKcalEl = document.getElementById("consumed-kcal")!;
  const targetKcalEl = document.getElementById("target-kcal")!;
  const consumedProtEl = document.getElementById("consumed-protein")!;
  const targetProtEl = document.getElementById("target-protein")!;
  const consumedCarbsEl = document.getElementById("consumed-carbs")!;
  const targetCarbsEl = document.getElementById("target-carbs")!;
  const consumedFatEl = document.getElementById("consumed-fat")!;
  const targetFatEl = document.getElementById("target-fat")!;

  // ─── State ───────────────────────────────────────────────────────────────────
  let currentDietId: string | null = null;
  let currentMealsCount = 0;
  let currentClientId = "";
  let currentUserRole = "";
  let clientMedicalProfile: MedicalProfile | null = null;
  let allCatalogFoods: FoodItem[] = [];

  let unsubDiets: (() => void) | null = null;
  let unsubHistory: (() => void) | null = null;
  let unsubTodayMeals: (() => void) | null = null;
  let unsubFoods: (() => void) | null = null;

  let allDiets: Diet[] = [];
  let currentDietObj: Diet | null = null;
  let activeCompletedMealIds: string[] = [];

  // Water Tracker State (2,500 ml target)
  const WATER_GOAL_ML = 2500;
  let currentWaterMl = 0;

  function getWaterStorageKey(): string {
    const todayStr = new Date().toISOString().substring(0, 10);
    return `cf_water_${currentClientId}_${todayStr}`;
  }

  function initWaterTracker(): void {
    if (!currentClientId) return;
    const key = getWaterStorageKey();
    const stored = localStorage.getItem(key);
    currentWaterMl = stored ? parseInt(stored, 10) || 0 : 0;
    renderWaterTracker();
  }

  function renderWaterTracker(): void {
    waterCurrentEl.textContent = `${currentWaterMl} ml`;
    const glasses = Math.floor(currentWaterMl / 300);
    waterGlassesEl.textContent = String(glasses);
    const pct = Math.min(100, Math.round((currentWaterMl / WATER_GOAL_ML) * 100));
    waterBarFill.style.width = `${pct}%`;
  }

  btnAddWater?.addEventListener("click", () => {
    currentWaterMl += 250;
    localStorage.setItem(getWaterStorageKey(), String(currentWaterMl));
    renderWaterTracker();
    showToast("💧 Vasos de agua añadidos");
  });

  btnSubWater?.addEventListener("click", () => {
    if (currentWaterMl >= 250) {
      currentWaterMl -= 250;
      localStorage.setItem(getWaterStorageKey(), String(currentWaterMl));
      renderWaterTracker();
    }
  });

  // ─── Toast helper ────────────────────────────────────────────────────────────
  function showToast(message: string, type: "success" | "error" | "info" = "success"): void {
    const colors = {
      success: "border-emerald-500/30 bg-[var(--brand-dim)] text-[var(--brand)]",
      error: "border-red-500/30 bg-[var(--danger-dim)] text-[var(--danger)]",
      info: "border-blue-500/30 bg-[var(--info-dim)] text-[var(--info)]",
    };
    toast.className = `fixed bottom-24 left-1/2 z-50 -translate-x-1/2 rounded-xl border px-6 py-3 text-sm font-medium backdrop-blur-xl shadow-2xl animate-slide-up ${colors[type]}`;
    toast.textContent = message;
    toast.classList.remove("hidden");

    setTimeout(() => {
      toast.classList.add("animate-fade-out");
      setTimeout(() => {
        toast.classList.add("hidden");
        toast.classList.remove("animate-fade-out");
      }, 300);
    }, 2500);
  }

  // ─── Modal Sustitutos ───────────────────────────────────────────────────────
  btnCloseSubstitutes?.addEventListener("click", () => {
    substitutesModal.classList.add("hidden");
  });

  function openSubstitutesModal(food: FoodItem) {
    const foodName = getFoodName(food, "es");
    substitutesModalTitle.textContent = `Alternativas para: ${foodName}`;
    substitutesModalSubtitle.textContent = `Porción estándar: ${food.defaultPortion}g (${food.defaultCalories} kcal)`;

    const substitutes = suggestSubstitutes(
      food,
      allCatalogFoods,
      clientMedicalProfile || undefined,
      "es",
      5
    );

    if (substitutes.length === 0) {
      substitutesModalList.innerHTML = `<div class="p-4 text-center text-xs text-[var(--text-tertiary)] italic">No se encontraron sustitutos compatibles con tus restricciones actuales.</div>`;
    } else {
      substitutesModalList.innerHTML = substitutes
        .map((sub) => {
          const subName = getFoodName(sub, "es");
          return `
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-3 space-y-1.5 hover:border-[var(--border-brand)] transition-all">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-[var(--text-primary)]">🔄 ${escapeHtml(subName)}</span>
                <span class="text-[10px] font-semibold text-[var(--brand)] uppercase tracking-wider">${sub.category}</span>
              </div>
              <div class="flex items-center gap-2 text-[11px] text-[var(--text-secondary)]">
                <span>Porción: <strong>${sub.defaultPortion}g</strong></span>
                <span>•</span>
                <span class="text-amber-400 font-semibold">${sub.defaultCalories} kcal</span>
                <span>•</span>
                <span class="text-emerald-400">P: ${sub.defaultProtein}g</span>
                <span>•</span>
                <span class="text-blue-400">C: ${sub.defaultCarbs}g</span>
                <span>•</span>
                <span class="text-purple-400">G: ${sub.defaultFat}g</span>
              </div>
            </div>
          `;
        })
        .join("");
    }

    substitutesModal.classList.remove("hidden");
  }

  function updateMetabolicCalculations() {
    if (!calcWeight || !calcHeight || !calcAge || !calcGender || !calcActivity || !calcGoal) return;

    const input: UserMetabolicInput = {
      weightKg: parseFloat(calcWeight.value) || 75,
      heightCm: parseFloat(calcHeight.value) || 175,
      ageYears: parseInt(calcAge.value, 10) || 26,
      gender: (calcGender.value as BiologicalGender) || "male",
      activityLevel: (calcActivity.value as ActivityLevel) || "moderate",
      goal: (calcGoal.value as NutritionalGoal) || "maintenance",
    };

    const res = calculateMetabolicProfile(input);
    lastCalculatedProfile = res;

    if (resTargetKcal) resTargetKcal.textContent = `${res.targetCalories.toLocaleString()} kcal`;
    if (resTdeeSub) resTdeeSub.textContent = `TDEE: ${res.tdee.toLocaleString()} kcal · BMR: ${res.bmr.toLocaleString()} kcal`;
    if (resProtein) resProtein.textContent = `${res.macros.proteinGrams}g`;
    if (resProteinSub) resProteinSub.textContent = `${res.macros.proteinKcal} kcal (${res.macros.percentages.protein}%)`;
    if (resCarbs) resCarbs.textContent = `${res.macros.carbsGrams}g`;
    if (resCarbsSub) resCarbsSub.textContent = `${res.macros.carbsKcal} kcal (${res.macros.percentages.carbs}%)`;
    if (resFat) resFat.textContent = `${res.macros.fatGrams}g`;
    if (resFatSub) resFatSub.textContent = `${res.macros.fatKcal} kcal (${res.macros.percentages.fat}%)`;
    if (resWaterAdvice) resWaterAdvice.textContent = `💧 Hidratación recomendada: ${res.waterLitersRecommended}L diarios`;
  }

  function renderFoodsExplorer() {
    if (!foodsExplorerGrid) return;

    const sourceList = allCatalogFoods.length > 0 ? allCatalogFoods : FOODS_CATALOG;
    const search = activeFoodSearch.toLowerCase().trim();

    const filtered = sourceList.filter((f) => {
      if (activeFoodCategory !== "all") {
        if (f.category !== activeFoodCategory) return false;
      }
      if (search) {
        const name = (f.translations?.es || f.id || "").toLowerCase();
        if (!name.includes(search)) return false;
      }
      return true;
    });

    if (filtered.length === 0) {
      foodsExplorerGrid.innerHTML = `
        <div class="col-span-full py-8 text-center text-xs text-[var(--text-tertiary)]">
          No se encontraron alimentos en esta categoría.
        </div>
      `;
      return;
    }

    foodsExplorerGrid.innerHTML = filtered.map((f) => {
      const name = f.translations?.es || f.id;
      const isVegan = f.isVegan;
      const isGlutenFree = f.isGlutenFree;
      const isLactoseFree = f.isLactoseFree;

      return `
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-3 space-y-1.5 hover:border-[var(--border-brand)]/50 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-1 mb-1">
              <span class="text-xs font-bold text-[var(--text-primary)] leading-snug">${escapeHtml(name)}</span>
              <span class="text-[10px] font-bold text-amber-400 bg-amber-500/10 border border-amber-500/20 px-1.5 py-0.5 rounded">${f.defaultCalories} kcal</span>
            </div>
            <div class="flex items-center gap-1.5 text-[10px] text-[var(--text-tertiary)] flex-wrap">
              <span class="text-emerald-400 font-semibold">P: ${f.defaultProtein}g</span>
              <span>•</span>
              <span class="text-amber-400 font-semibold">C: ${f.defaultCarbs}g</span>
              <span>•</span>
              <span class="text-purple-400 font-semibold">G: ${f.defaultFat}g</span>
              <span>•</span>
              <span>(${f.defaultPortion}g)</span>
            </div>
          </div>
          <div class="flex items-center gap-1 pt-1.5 border-t border-[var(--border-subtle)] flex-wrap">
            ${isVegan ? '<span class="rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 px-1.5 py-0.2 text-[9px] font-bold">🌱 Vegano</span>' : ''}
            ${isGlutenFree ? '<span class="rounded bg-amber-500/15 text-amber-300 border border-amber-500/30 px-1.5 py-0.2 text-[9px] font-bold">🌾 Sin Gluten</span>' : ''}
            ${isLactoseFree ? '<span class="rounded bg-blue-500/15 text-blue-300 border border-blue-500/30 px-1.5 py-0.2 text-[9px] font-bold">🥛 Sin Lactosa</span>' : ''}
          </div>
        </div>
      `;
    }).join("");
  }

  // Eventos de cálculo interactivo
  [calcWeight, calcHeight, calcAge, calcGender, calcActivity, calcGoal].forEach((input) => {
    input?.addEventListener("input", updateMetabolicCalculations);
    input?.addEventListener("change", updateMetabolicCalculations);
  });

  // Guardar Objetivo Nutricional
  btnSaveMetabolicGoal?.addEventListener("click", async () => {
    if (!currentClientId || !lastCalculatedProfile) return;
    const input: UserMetabolicInput = {
      weightKg: parseFloat(calcWeight?.value || "75") || 75,
      heightCm: parseFloat(calcHeight?.value || "175") || 175,
      ageYears: parseInt(calcAge?.value || "26", 10) || 26,
      gender: (calcGender?.value as BiologicalGender) || "male",
      activityLevel: (calcActivity?.value as ActivityLevel) || "moderate",
      goal: (calcGoal?.value as NutritionalGoal) || "maintenance",
    };

    await saveUserMetabolicGoal(currentClientId, input, lastCalculatedProfile);
    showToast("¡Objetivo nutricional guardado en tu perfil!", "success");
  });

  // Eventos de búsqueda y filtros de alimentos
  foodsExplorerSearch?.addEventListener("input", (e) => {
    activeFoodSearch = (e.target as HTMLInputElement).value;
    renderFoodsExplorer();
  });

  foodsCategoryFilterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      foodsCategoryFilterBtns.forEach((b) => {
        b.className = "food-filter-btn rounded-lg px-2.5 py-1 text-xs font-semibold bg-[var(--surface-3)] text-[var(--text-secondary)] hover:text-white";
      });
      btn.className = "food-filter-btn active rounded-lg px-2.5 py-1 text-xs font-bold bg-[var(--brand)] text-[var(--text-on-brand)]";
      activeFoodCategory = (btn as HTMLElement).dataset.category || "all";
      renderFoodsExplorer();
    });
  });

  // ─── Init ────────────────────────────────────────────────────────────────────
  loadingText.textContent = t("dashboard.loading");

  const cleanup = initPage({
    allowedRoles: ["client", "admin", "trainer"],
    onReady: async (firebaseUser, userData) => {
      const clientId = firebaseUser.uid;
      currentClientId = clientId;
      currentUserRole = userData?.role || "client";
      clientMedicalProfile = userData?.medicalProfile || null;

      initWaterTracker();

      // Cargar datos metabólicos previos si existen
      if (userData?.weight && calcWeight) calcWeight.value = String(userData.weight);
      if (userData?.height && calcHeight) calcHeight.value = String(userData.height);
      if (userData?.gender && calcGender) calcGender.value = userData.gender;

      updateMetabolicCalculations();

      // Suscribirse a los alimentos del catálogo
      unsubFoods = subscribeToFoods((foods) => {
        allCatalogFoods = foods;
        if (currentDietObj) {
          renderCurrentDiet(currentDietObj);
        }
        renderFoodsExplorer();
      });

      // Suscribirse a la dieta actual
      unsubDiets = subscribeToDiets(clientId, (diets) => {
        allDiets = diets;
        if (diets.length > 0 && diets[0]) {
          autonomyNutritionHub?.classList.add("hidden");
          emptyState.classList.add("hidden");
          renderCurrentDiet(diets[0]);
          btnHistory.classList.remove("hidden");
        } else {
          dietCard.classList.add("hidden");
          emptyState.classList.add("hidden");
          autonomyNutritionHub?.classList.remove("hidden");
          btnHistory.classList.add("hidden");
          updateMetabolicCalculations();
          renderFoodsExplorer();
        }
      });

      // Suscribirse a comidas completadas hoy para adherencia
      unsubTodayMeals = subscribeToTodayMeals(clientId, (completedIds) => {
        activeCompletedMealIds = completedIds;
        updateAdherence(completedIds);
      });

      // History toggle
      btnHistory.addEventListener("click", () => {
        showHistory(clientId);
      });

      btnBackCurrent.addEventListener("click", () => {
        historyView.classList.add("hidden");
        dietCard.classList.remove("hidden");
        btnHistory.classList.remove("hidden");
        if (unsubHistory) {
          unsubHistory();
          unsubHistory = null;
        }
      });

      // Suscribirse a las propuestas de personalización de dieta del alumno
      activeTrainerId = userData?.assignedTrainerId || "";
      activeUserName = userData?.name || "Cliente";

      unsubDietProposals = subscribeToClientProposals(clientId, (proposals) => {
        const dietProposal = proposals.find((p) => p.type === "diet");
        renderDietProposalStatus(dietProposal);
      });
    },
  });

  let activeTrainerId = "";
  let activeUserName = "Cliente";
  let unsubDietProposals: (() => void) | null = null;

  // Modal de propuesta de dieta
  const dietProposalModal = document.getElementById("customize-diet-modal") as HTMLDivElement;
  const btnOpenDietProposal = document.getElementById("btn-open-diet-proposal-modal") as HTMLButtonElement;
  const btnCloseDietProposal = document.getElementById("btn-close-diet-proposal-modal") as HTMLButtonElement;
  const btnCancelDietProposal = document.getElementById("btn-cancel-diet-proposal-modal") as HTMLButtonElement;
  const btnSubmitDietProposal = document.getElementById("btn-submit-diet-proposal") as HTMLButtonElement;

  btnOpenDietProposal?.addEventListener("click", () => {
    if (!activeTrainerId) {
      showToast("Aún no tienes un entrenador asignado para revisar tu propuesta de dieta.", "info");
      return;
    }
    dietProposalModal?.classList.remove("hidden");
  });

  const closeDietProposalModal = () => dietProposalModal?.classList.add("hidden");
  btnCloseDietProposal?.addEventListener("click", closeDietProposalModal);
  btnCancelDietProposal?.addEventListener("click", closeDietProposalModal);

  function renderDietProposalStatus(proposal?: PlanProposal) {
    const banner = document.getElementById("diet-proposal-status-banner");
    const desc = document.getElementById("diet-proposal-banner-desc");
    const statusBadge = document.getElementById("diet-proposal-banner-status");
    const feedbackBox = document.getElementById("diet-proposal-banner-feedback");
    const feedbackText = document.getElementById("diet-proposal-feedback-text");

    if (!banner || !proposal) {
      banner?.classList.add("hidden");
      return;
    }

    if (proposal.status === "pending_review") {
      banner.classList.remove("hidden");
      if (statusBadge) {
        statusBadge.textContent = "Pendiente";
        statusBadge.className = "rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider";
      }
      if (desc) desc.textContent = "Tu propuesta de horarios de comidas ha sido enviada a tu entrenador.";
      feedbackBox?.classList.add("hidden");
    } else if (proposal.status === "changes_requested") {
      banner.classList.remove("hidden");
      if (statusBadge) {
        statusBadge.textContent = "Cambios Sugeridos";
        statusBadge.className = "rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider";
      }
      if (desc) desc.textContent = "Tu entrenador ha revisado tu propuesta y te ha dejado consejos nutricionales.";
      if (proposal.trainerFeedback && feedbackBox && feedbackText) {
        feedbackBox.classList.remove("hidden");
        feedbackText.textContent = proposal.trainerFeedback;
      }
    } else {
      banner.classList.add("hidden");
    }
  }

  btnSubmitDietProposal?.addEventListener("click", async () => {
    if (!currentClientId || !activeTrainerId) return;

    const breakfastTime = (document.getElementById("diet-time-breakfast") as HTMLInputElement)?.value || "08:00";
    const lunchTime = (document.getElementById("diet-time-lunch") as HTMLInputElement)?.value || "13:30";
    const snackTime = (document.getElementById("diet-time-snack") as HTMLInputElement)?.value || "17:00";
    const dinnerTime = (document.getElementById("diet-time-dinner") as HTMLInputElement)?.value || "21:00";
    const notesVal = (document.getElementById("proposal-diet-notes") as HTMLTextAreaElement)?.value.trim() || "";

    try {
      btnSubmitDietProposal.disabled = true;
      const btnText = document.getElementById("btn-submit-diet-proposal-text");
      if (btnText) btnText.textContent = "Enviando propuesta...";

      const updatedMeals = (currentDietObj?.meals || []).map((m) => {
        let estTime = m.estimatedTime;
        if (m.name === "breakfast") estTime = breakfastTime;
        else if (m.name === "lunch") estTime = lunchTime;
        else if (m.name === "snack") estTime = snackTime;
        else if (m.name === "dinner") estTime = dinnerTime;
        return { ...m, estimatedTime: estTime };
      });

      await createPlanProposal({
        clientId: currentClientId,
        clientName: activeUserName,
        trainerId: activeTrainerId,
        type: "diet",
        clientNotes: notesVal,
        proposedSchedule: {
          estimatedTimes: {
            breakfast: breakfastTime,
            lunch: lunchTime,
            snack: snackTime,
            dinner: dinnerTime,
          },
        },
        proposedData: {
          name: currentDietObj?.name ? `${currentDietObj.name} (Personalizado)` : "Dieta Personalizada",
          type: currentDietObj?.type || "normal",
          somatotype: currentDietObj?.somatotype,
          totalCalories: currentDietObj?.totalCalories || 2000,
          meals: updatedMeals,
        },
        originalPlanId: currentDietId || undefined,
      });

      showToast("¡Propuesta de dieta enviada a tu entrenador!");
      closeDietProposalModal();
    } catch {
      showToast("Error al enviar la propuesta.", "error");
    } finally {
      btnSubmitDietProposal.disabled = false;
      const btnText = document.getElementById("btn-submit-diet-proposal-text");
      if (btnText) btnText.textContent = "Enviar propuesta a mi entrenador";
    }
  });

  // ─── Helper traducción de comidas ──────────────────────────────────────────
  function getMealLabel(name: string): string {
    const map: Record<string, string> = {
      breakfast: "Desayuno",
      lunch: "Almuerzo",
      snack: "Merienda",
      dinner: "Cena",
      other: "Otra toma",
    };
    return map[name] || name;
  }

  // ─── Render current diet ─────────────────────────────────────────────────────
  function renderCurrentDiet(d: Diet): void {
    currentDietObj = d;
    currentDietId = d.id;
    currentMealsCount = d.meals?.length || 0;

    dietName.textContent = d.name;

    const typeLabels: Record<string, string> = {
      normal: "Normocalórica",
      definition: "Definición Muscular",
      volume: "Volumen",
      keto: "Keto",
      vegan: "Vegana",
      custom: "Personalizada",
    };
    dietType.textContent = typeLabels[d.type] || d.type || "Personalizada";

    if (d.somatotype) {
      dietSomatotype.classList.remove("hidden");
      const somaLabels: Record<string, string> = {
        ectomorph: "Ectomorfo",
        mesomorph: "Mesomorfo",
        endomorph: "Endomorfo",
      };
      dietSomatotype.textContent = somaLabels[d.somatotype] || d.somatotype;
    } else {
      dietSomatotype.classList.add("hidden");
    }

    dietCalories.textContent = `${d.totalCalories || 0} kcal`;

    let sumCal = 0,
      sumP = 0,
      sumC = 0,
      sumF = 0;

    mealsList.innerHTML = "";
    if (d.meals && d.meals.length > 0) {
      d.meals.forEach((meal: Meal) => {
        sumCal += meal.calories || 0;
        sumP += meal.protein || 0;
        sumC += meal.carbs || 0;
        sumF += meal.fat || 0;

        const isCompleted = activeCompletedMealIds.includes(meal.id);
        const food = meal.foodId ? allCatalogFoods.find((f) => f.id === meal.foodId) : null;
        const localizedFoodName = food ? getFoodName(food, "es") : null;
        const allergensList = meal.allergens && meal.allergens.length > 0 ? meal.allergens : (food?.allergens || []);

        const div = document.createElement("div");
        div.className = `rounded-xl border p-4 backdrop-blur-sm transition-all animate-fade-in ${
          isCompleted
            ? "border-emerald-500/40 bg-[var(--brand-dim)]"
            : "border-[var(--border-subtle)] bg-[var(--surface-2)]"
        }`;
        div.id = `meal-${meal.id}`;
        div.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 space-y-1">
              <div class="flex items-center gap-2 flex-wrap">
                <h4 class="font-bold text-sm text-[var(--text-primary)] capitalize">${getMealLabel(meal.name)}</h4>
                <span class="text-[10px] text-[var(--text-disabled)] font-medium">#${meal.order || ""}</span>
                ${localizedFoodName ? `<span class="rounded-md bg-[var(--surface-3)] px-2 py-0.5 text-[11px] font-semibold text-[var(--brand)] border border-[var(--border-subtle)]">🍎 ${escapeHtml(localizedFoodName)}</span>` : ""}
                ${isCompleted ? `<span class="rounded-full bg-emerald-500/20 px-2 py-0.5 text-[10px] font-bold text-[var(--brand)]">${t("client.meal.completed")}</span>` : ""}
              </div>
              ${meal.description ? `<p class="text-xs text-[var(--text-tertiary)]">${escapeHtml(meal.description)}</p>` : ""}
              
              <!-- Macros y Alérgenos -->
              <div class="mt-2 flex flex-wrap items-center gap-2 text-xs font-semibold">
                <span class="rounded-md bg-amber-500/10 px-2 py-0.5 text-amber-400 border border-amber-500/20">${meal.calories || 0} kcal</span>
                <span class="rounded-md bg-emerald-500/10 px-2 py-0.5 text-emerald-400 border border-emerald-500/20">Prot: ${meal.protein || 0}g</span>
                <span class="rounded-md bg-blue-500/10 px-2 py-0.5 text-blue-400 border border-blue-500/20">Carbs: ${meal.carbs || 0}g</span>
                <span class="rounded-md bg-purple-500/10 px-2 py-0.5 text-purple-400 border border-purple-500/20">Grasas: ${meal.fat || 0}g</span>
                ${allergensList.length > 0 ? `<span class="text-[10px] text-rose-400 font-medium">⚠️ ${allergensList.join(", ")}</span>` : ""}
              </div>

              ${food ? `
                <button type="button" class="btn-substitutes mt-2 text-[11px] font-semibold text-[var(--brand)] hover:underline flex items-center gap-1" data-food-id="${food.id}">
                  <span>🔄</span> <span>Ver sustitutos recomendados</span>
                </button>
              ` : ""}
            </div>
            ${
              currentUserRole === "client"
                ? `
            <button data-meal-id="${meal.id}" data-meal-name="${meal.name}" class="btn-complete shrink-0 ml-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--brand)] hover:border-emerald-500/30 transition-all ${isCompleted ? "border-emerald-500 text-[var(--brand)] bg-emerald-500/10" : ""}">
              ${isCompleted ? t("client.meal.markDone") : t("client.meal.mark")}
            </button>
            `
                : ""
            }
          </div>
        `;
        mealsList.appendChild(div);
      });
    }

    totalCal.textContent = `${sumCal}`;
    totalProtein.textContent = `${sumP}`;
    totalCarbs.textContent = `${sumC}`;
    totalFat.textContent = `${sumF}`;

    targetKcalEl.textContent = `${d.totalCalories || sumCal}`;
    targetProtEl.textContent = `${sumP}`;
    targetCarbsEl.textContent = `${sumC}`;
    targetFatEl.textContent = `${sumF}`;

    dietCard.classList.remove("hidden");
    emptyState.classList.add("hidden");

    // Handler de completado de comidas
    mealsList.querySelectorAll(".btn-complete").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const mealId = btn.getAttribute("data-meal-id");
        const mealName = btn.getAttribute("data-meal-name");
        if (!mealId || !currentDietId) return;

        btn.setAttribute("disabled", "true");
        btn.classList.add("opacity-50");

        const result = await registerMealComplete(
          currentClientId,
          currentDietId,
          mealId,
          mealName || ""
        );

        if (result) {
          showToast(t("client.meal.registered"));
        } else {
          showToast(t("client.meal.error"), "error");
          btn.removeAttribute("disabled");
          btn.classList.remove("opacity-50");
        }
      });
    });

    // Handler de sustitutos
    mealsList.querySelectorAll(".btn-substitutes").forEach((btn) => {
      btn.addEventListener("click", () => {
        const foodId = btn.getAttribute("data-food-id");
        const food = allCatalogFoods.find((f) => f.id === foodId);
        if (food) {
          openSubstitutesModal(food);
        }
      });
    });

    updateMacroProgress();
  }

  function updateMacroProgress(): void {
    if (!currentDietObj || !currentDietObj.meals) return;

    let consumedKcal = 0,
      consumedP = 0,
      consumedC = 0,
      consumedF = 0;

    currentDietObj.meals.forEach((m) => {
      if (activeCompletedMealIds.includes(m.id)) {
        consumedKcal += m.calories || 0;
        consumedP += m.protein || 0;
        consumedC += m.carbs || 0;
        consumedF += m.fat || 0;
      }
    });

    consumedKcalEl.textContent = String(consumedKcal);
    consumedProtEl.textContent = String(consumedP);
    consumedCarbsEl.textContent = String(consumedC);
    consumedFatEl.textContent = String(consumedF);
  }

  function updateAdherence(completedIds: string[]): void {
    activeCompletedMealIds = completedIds;

    if (currentMealsCount === 0) {
      adherenceBar.classList.add("hidden");
      return;
    }

    adherenceBar.classList.remove("hidden");
    const pct = Math.min(100, Math.round((completedIds.length / currentMealsCount) * 100));

    adherenceFill.style.width = `${pct}%`;
    adherenceText.textContent = `${pct}% (${completedIds.length}/${currentMealsCount})`;

    if (currentDietObj) {
      renderCurrentDiet(currentDietObj);
    }
  }

  function showHistory(clientId: string): void {
    dietCard.classList.add("hidden");
    historyView.classList.remove("hidden");
    historyList.innerHTML = `<div class="p-4 text-center text-xs text-[var(--text-tertiary)]">${t("dashboard.loading")}</div>`;

    unsubHistory = subscribeToDietHistory(clientId, (diets) => {
      if (diets.length === 0) {
        historyList.innerHTML = `<div class="p-4 text-center text-xs text-[var(--text-disabled)]">${t("client.diet.noHistory")}</div>`;
        return;
      }

      historyList.innerHTML = diets
        .map((d) => {
          const isCurrent = d.id === currentDietId;
          const dateStr =
            d.createdAt && typeof (d.createdAt as any).toDate === "function"
              ? (d.createdAt as any).toDate().toLocaleDateString()
              : "Anterior";

          return `
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm flex items-center justify-between">
              <div>
                <p class="text-sm font-semibold text-[var(--text-primary)]">${escapeHtml(d.name)}</p>
                <p class="text-xs text-[var(--text-tertiary)]">${d.totalCalories} kcal · ${dateStr}</p>
              </div>
              ${isCurrent ? '<span class="rounded-full bg-[var(--brand-dim)] px-2.5 py-0.5 text-xs font-bold text-[var(--brand)]">Actual</span>' : ""}
            </div>
          `;
        })
        .join("");
    });
  }

  document.addEventListener("astro:before-swap", () => {
    unsubFoods?.();
    unsubDiets?.();
    unsubTodayMeals?.();
    unsubHistory?.();
    unsubDietProposals?.();
    cleanup?.();
  });
</script>
