---
import ClientLayout from "@/layouts/ClientLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<ClientLayout>
  <div id="loadingScreen" class="flex min-h-screen items-center justify-center">
    <div class="text-center animate-fade-in">
      <div
        class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-[var(--border-strong)] border-t-emerald-400"
      >
      </div>
      <p id="loadingText" class="mt-4 text-sm text-[var(--text-tertiary)]">
        {t("dashboard.loading")}
      </p>
    </div>
  </div>

  <div id="dietsContent" class="hidden">
    <main class="mx-auto max-w-4xl px-4 py-6">
      <div class="animate-fade-in space-y-6">
        <!-- Header -->
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div>
            <h2 data-i18n="client.nav.diets" class="text-xl font-bold text-[var(--text-primary)]">{t("client.nav.diets")}</h2>
            <p data-i18n="client.diet.sub" class="mt-1 text-sm text-[var(--text-tertiary)]">
              {t("client.diet.sub")}
            </p>
          </div>
          <!-- Historial button -->
          <button
            id="btn-history"
            class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2 text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all hidden"
          >
            <svg
              class="h-3.5 w-3.5 inline-block mr-1 -mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
            </svg>
            <span data-i18n="client.diet.history">{t("client.diet.history")}</span>
          </button>
        </div>

        <!-- Water Tracker (Control de Hidratación) -->
        <div
          class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-5 backdrop-blur-xl space-y-3"
        >
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-500/10 text-blue-400 border border-blue-500/20 text-lg"
              >
                💧
              </div>
              <div>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">
                  {t("client.waterTracker.title")}
                </h3>
                <p class="text-[11px] text-[var(--text-tertiary)]">
                  {t("client.waterTracker.goal")} (<span id="water-glasses">0</span> / 8 {
                    t("client.waterTracker.glasses")
                  })
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-sub-water"
                class="flex h-8 w-8 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] text-sm font-bold text-[var(--text-primary)] hover:bg-[var(--surface-4)] active:scale-95 transition-all"
              >
                -
              </button>
              <span
                id="water-current"
                class="text-base font-bold text-blue-400 min-w-[65px] text-center">0 ml</span
              >
              <button
                type="button"
                id="btn-add-water"
                class="flex h-8 w-8 items-center justify-center rounded-xl bg-blue-500 text-white text-sm font-bold shadow-md shadow-blue-500/20 hover:bg-blue-600 active:scale-95 transition-all"
              >
                +
              </button>
            </div>
          </div>

          <!-- Barra de agua -->
          <div class="h-2 overflow-hidden rounded-full bg-[var(--surface-3)]">
            <div
              id="water-bar-fill"
              class="h-full rounded-full bg-gradient-to-r from-blue-500 to-cyan-400 transition-all duration-500"
              style="width: 0%"
            >
            </div>
          </div>
        </div>

        <!-- Adherence Daily Bar (Progreso de comidas) -->
        <div
          id="adherence-bar"
          class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl hidden"
        >
          <div class="flex items-center justify-between text-xs mb-2">
            <span class="font-semibold text-[var(--text-secondary)]">Adherencia Diaria</span>
            <span id="adherence-text" class="font-bold text-[var(--brand)]">0%</span>
          </div>
          <div class="h-2 overflow-hidden rounded-full bg-[var(--surface-3)]">
            <div
              id="adherence-fill"
              class="h-full rounded-full bg-gradient-to-r from-[var(--brand)] to-emerald-400 transition-all duration-500"
              style="width: 0%"
            >
            </div>
          </div>
        </div>

        <!-- Macros Consumed vs Target -->
        <div
          class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center"
          id="macros-consumed-grid"
        >
          <div
            class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-1)] p-3 backdrop-blur-xl"
          >
            <span class="block text-[10px] uppercase font-bold text-[var(--text-tertiary)]"
              >Calorías</span
            >
            <div class="mt-1 text-sm font-bold text-amber-400">
              <span id="consumed-kcal">0</span> / <span id="target-kcal">0</span>
            </div>
            <span class="text-[10px] text-[var(--text-disabled)]">kcal</span>
          </div>
          <div
            class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-1)] p-3 backdrop-blur-xl"
          >
            <span class="block text-[10px] uppercase font-bold text-[var(--text-tertiary)]"
              >Proteínas</span
            >
            <div class="mt-1 text-sm font-bold text-emerald-400">
              <span id="consumed-protein">0</span> / <span id="target-protein">0</span>g
            </div>
            <span class="text-[10px] text-[var(--text-disabled)]">consumido</span>
          </div>
          <div
            class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-1)] p-3 backdrop-blur-xl"
          >
            <span class="block text-[10px] uppercase font-bold text-[var(--text-tertiary)]"
              >Carbohidratos</span
            >
            <div class="mt-1 text-sm font-bold text-blue-400">
              <span id="consumed-carbs">0</span> / <span id="target-carbs">0</span>g
            </div>
            <span class="text-[10px] text-[var(--text-disabled)]">consumido</span>
          </div>
          <div
            class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-1)] p-3 backdrop-blur-xl"
          >
            <span class="block text-[10px] uppercase font-bold text-[var(--text-tertiary)]"
              >Grasas</span
            >
            <div class="mt-1 text-sm font-bold text-purple-400">
              <span id="consumed-fat">0</span> / <span id="target-fat">0</span>g
            </div>
            <span class="text-[10px] text-[var(--text-disabled)]">consumido</span>
          </div>
        </div>

        <!-- Current Diet Plan Details -->
        <div id="dietCard" class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-6 hidden">
          <div class="flex items-start justify-between flex-wrap gap-4 border-b border-[var(--border-subtle)] pb-4">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h3 id="dietName" class="text-lg font-bold text-[var(--text-primary)]"></h3>
                <span id="dietType" class="rounded-full bg-[var(--brand-dim)] px-2.5 py-0.5 text-xs font-semibold text-[var(--brand)] border border-[var(--border-brand)]"></span>
                <span id="dietSomatotype" class="rounded-full bg-purple-500/10 px-2.5 py-0.5 text-xs font-semibold text-purple-400 border border-purple-500/20 hidden"></span>
              </div>
              <p id="dietCalories" class="mt-1 text-sm font-semibold text-amber-400"></p>
            </div>

            <!-- Macros target banner -->
            <div class="flex items-center gap-3 text-xs font-semibold flex-wrap">
              <span class="rounded-lg bg-emerald-500/10 px-2.5 py-1 text-emerald-400 border border-emerald-500/20">Prot: <span id="totalProtein">0</span>g</span>
              <span class="rounded-lg bg-blue-500/10 px-2.5 py-1 text-blue-400 border border-blue-500/20">Carbs: <span id="totalCarbs">0</span>g</span>
              <span class="rounded-lg bg-purple-500/10 px-2.5 py-1 text-purple-400 border border-purple-500/20">Grasas: <span id="totalFat">0</span>g</span>
              <span class="rounded-lg bg-amber-500/10 px-2.5 py-1 text-amber-400 border border-amber-500/20">Total: <span id="totalCal">0</span> kcal</span>
            </div>
          </div>

          <!-- Meals List -->
          <div class="space-y-4">
            <h4 class="text-sm font-bold uppercase tracking-wider text-[var(--text-secondary)]">Tomas y Comidas Asignadas</h4>
            <div id="mealsList" class="space-y-3"></div>
          </div>
        </div>

        <!-- History View -->
        <div id="historyView" class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4 hidden">
          <div class="flex items-center justify-between">
            <h3 data-i18n="client.diet.history" class="text-base font-bold text-[var(--text-primary)]">
              {t("client.diet.history")}
            </h3>
            <button
              id="btn-back-current"
              class="text-xs font-medium text-[var(--brand)] hover:underline flex items-center gap-1"
            >
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"></path>
              </svg>
              <span data-i18n="client.diet.current">{t("client.diet.current")}</span>
            </button>
          </div>
          <div id="historyList" class="space-y-2"></div>
        </div>

        <!-- Empty State -->
        <div
          id="emptyState"
          class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-[var(--border-default)] bg-[var(--surface-2)] p-12 text-center"
        >
          <div
            class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--surface-4)] text-2xl"
          >
            🥗
          </div>
          <h3
            data-i18n="client.no.diet"
            class="mt-4 text-lg font-semibold text-[var(--text-secondary)]"
          >
            {t("client.no.diet")}
          </h3>
          <p data-i18n="client.diet.assigned.desc" class="mt-2 text-sm text-[var(--text-disabled)]">
            {t("client.diet.assigned.desc")}
          </p>
        </div>
      </div>
    </main>
  </div>

  <!-- Modal de Sustitutos Sugeridos -->
  <div id="substitutes-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm hidden animate-fade-in">
    <div class="relative w-full max-w-lg rounded-2xl border border-[var(--border-default)] bg-[var(--surface-2)] p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
        <div>
          <h3 id="substitutes-modal-title" class="text-base font-bold text-[var(--text-primary)]">Sustitutos Sugeridos</h3>
          <p id="substitutes-modal-subtitle" class="text-xs text-[var(--text-tertiary)]"></p>
        </div>
        <button id="btn-close-substitutes" class="text-[var(--text-tertiary)] hover:text-white text-xl font-bold">&times;</button>
      </div>
      <div id="substitutes-modal-list" class="space-y-2.5 max-h-72 overflow-y-auto"></div>
    </div>
  </div>

  <!-- Toast -->
  <div
    id="diet-toast"
    class="fixed bottom-24 left-1/2 z-50 -translate-x-1/2 rounded-xl border px-6 py-3 text-sm font-medium backdrop-blur-xl shadow-2xl hidden"
  >
  </div>
</ClientLayout>

<script>
  import { initPage } from "@/lib/shared/initPage";
  import {
    subscribeToDiets,
    subscribeToDietHistory,
    subscribeToTodayMeals,
    registerMealComplete,
    type Diet,
    type Meal,
  } from "@/lib/client/dietService";
  import {
    subscribeToFoods,
    getFoodName,
    type FoodItem,
  } from "@/lib/shared/foodLibrary";
  import { suggestSubstitutes } from "@/lib/client/intoleranceChecker";
  import { t } from "@/i18n/client";
  import { escapeHtml } from "@/lib/shared/ui";
  import type { MedicalProfile } from "@/types";

  // ─── DOM refs ────────────────────────────────────────────────────────────────
  const loadingScreen = document.getElementById("loadingScreen")!;
  const loadingText = document.getElementById("loadingText")!;
  const dietsContent = document.getElementById("dietsContent")!;
  const dietCard = document.getElementById("dietCard")!;
  const emptyState = document.getElementById("emptyState")!;
  const dietName = document.getElementById("dietName")!;
  const dietType = document.getElementById("dietType")!;
  const dietSomatotype = document.getElementById("dietSomatotype")!;
  const dietCalories = document.getElementById("dietCalories")!;
  const mealsList = document.getElementById("mealsList")!;
  const totalCal = document.getElementById("totalCal")!;
  const totalProtein = document.getElementById("totalProtein")!;
  const totalCarbs = document.getElementById("totalCarbs")!;
  const totalFat = document.getElementById("totalFat")!;
  const adherenceBar = document.getElementById("adherence-bar")!;
  const adherenceFill = document.getElementById("adherence-fill")!;
  const adherenceText = document.getElementById("adherence-text")!;
  const btnHistory = document.getElementById("btn-history")!;
  const historyView = document.getElementById("historyView")!;
  const historyList = document.getElementById("historyList")!;
  const btnBackCurrent = document.getElementById("btn-back-current")!;
  const toast = document.getElementById("diet-toast")!;

  // Sustitutos modal refs
  const substitutesModal = document.getElementById("substitutes-modal")!;
  const substitutesModalTitle = document.getElementById("substitutes-modal-title")!;
  const substitutesModalSubtitle = document.getElementById("substitutes-modal-subtitle")!;
  const substitutesModalList = document.getElementById("substitutes-modal-list")!;
  const btnCloseSubstitutes = document.getElementById("btn-close-substitutes")!;

  // Water Tracker refs
  const btnAddWater = document.getElementById("btn-add-water")!;
  const btnSubWater = document.getElementById("btn-sub-water")!;
  const waterCurrentEl = document.getElementById("water-current")!;
  const waterGlassesEl = document.getElementById("water-glasses")!;
  const waterBarFill = document.getElementById("water-bar-fill")!;

  // Consumed Macro refs
  const consumedKcalEl = document.getElementById("consumed-kcal")!;
  const targetKcalEl = document.getElementById("target-kcal")!;
  const consumedProtEl = document.getElementById("consumed-protein")!;
  const targetProtEl = document.getElementById("target-protein")!;
  const consumedCarbsEl = document.getElementById("consumed-carbs")!;
  const targetCarbsEl = document.getElementById("target-carbs")!;
  const consumedFatEl = document.getElementById("consumed-fat")!;
  const targetFatEl = document.getElementById("target-fat")!;

  // ─── State ───────────────────────────────────────────────────────────────────
  let currentDietId: string | null = null;
  let currentMealsCount = 0;
  let currentClientId = "";
  let currentUserRole = "";
  let clientMedicalProfile: MedicalProfile | null = null;
  let allCatalogFoods: FoodItem[] = [];

  let unsubDiets: (() => void) | null = null;
  let unsubHistory: (() => void) | null = null;
  let unsubTodayMeals: (() => void) | null = null;
  let unsubFoods: (() => void) | null = null;

  let allDiets: Diet[] = [];
  let currentDietObj: Diet | null = null;
  let activeCompletedMealIds: string[] = [];

  // Water Tracker State (2,500 ml target)
  const WATER_GOAL_ML = 2500;
  let currentWaterMl = 0;

  function getWaterStorageKey(): string {
    const todayStr = new Date().toISOString().substring(0, 10);
    return `cf_water_${currentClientId}_${todayStr}`;
  }

  function initWaterTracker(): void {
    if (!currentClientId) return;
    const key = getWaterStorageKey();
    const stored = localStorage.getItem(key);
    currentWaterMl = stored ? parseInt(stored, 10) || 0 : 0;
    renderWaterTracker();
  }

  function renderWaterTracker(): void {
    waterCurrentEl.textContent = `${currentWaterMl} ml`;
    const glasses = Math.floor(currentWaterMl / 300);
    waterGlassesEl.textContent = String(glasses);
    const pct = Math.min(100, Math.round((currentWaterMl / WATER_GOAL_ML) * 100));
    waterBarFill.style.width = `${pct}%`;
  }

  btnAddWater?.addEventListener("click", () => {
    currentWaterMl += 250;
    localStorage.setItem(getWaterStorageKey(), String(currentWaterMl));
    renderWaterTracker();
    showToast("💧 Vasos de agua añadidos");
  });

  btnSubWater?.addEventListener("click", () => {
    if (currentWaterMl >= 250) {
      currentWaterMl -= 250;
      localStorage.setItem(getWaterStorageKey(), String(currentWaterMl));
      renderWaterTracker();
    }
  });

  // ─── Toast helper ────────────────────────────────────────────────────────────
  function showToast(message: string, type: "success" | "error" | "info" = "success"): void {
    const colors = {
      success: "border-emerald-500/30 bg-[var(--brand-dim)] text-[var(--brand)]",
      error: "border-red-500/30 bg-[var(--danger-dim)] text-[var(--danger)]",
      info: "border-blue-500/30 bg-[var(--info-dim)] text-[var(--info)]",
    };
    toast.className = `fixed bottom-24 left-1/2 z-50 -translate-x-1/2 rounded-xl border px-6 py-3 text-sm font-medium backdrop-blur-xl shadow-2xl animate-slide-up ${colors[type]}`;
    toast.textContent = message;
    toast.classList.remove("hidden");

    setTimeout(() => {
      toast.classList.add("animate-fade-out");
      setTimeout(() => {
        toast.classList.add("hidden");
        toast.classList.remove("animate-fade-out");
      }, 300);
    }, 2500);
  }

  // ─── Modal Sustitutos ───────────────────────────────────────────────────────
  btnCloseSubstitutes?.addEventListener("click", () => {
    substitutesModal.classList.add("hidden");
  });

  function openSubstitutesModal(food: FoodItem) {
    const foodName = getFoodName(food, "es");
    substitutesModalTitle.textContent = `Alternativas para: ${foodName}`;
    substitutesModalSubtitle.textContent = `Porción estándar: ${food.defaultPortion}g (${food.defaultCalories} kcal)`;

    const substitutes = suggestSubstitutes(
      food,
      allCatalogFoods,
      clientMedicalProfile || undefined,
      "es",
      5
    );

    if (substitutes.length === 0) {
      substitutesModalList.innerHTML = `<div class="p-4 text-center text-xs text-[var(--text-tertiary)] italic">No se encontraron sustitutos compatibles con tus restricciones actuales.</div>`;
    } else {
      substitutesModalList.innerHTML = substitutes
        .map((sub) => {
          const subName = getFoodName(sub, "es");
          return `
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-3 space-y-1.5 hover:border-[var(--border-brand)] transition-all">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-[var(--text-primary)]">🔄 ${escapeHtml(subName)}</span>
                <span class="text-[10px] font-semibold text-[var(--brand)] uppercase tracking-wider">${sub.category}</span>
              </div>
              <div class="flex items-center gap-2 text-[11px] text-[var(--text-secondary)]">
                <span>Porción: <strong>${sub.defaultPortion}g</strong></span>
                <span>•</span>
                <span class="text-amber-400 font-semibold">${sub.defaultCalories} kcal</span>
                <span>•</span>
                <span class="text-emerald-400">P: ${sub.defaultProtein}g</span>
                <span>•</span>
                <span class="text-blue-400">C: ${sub.defaultCarbs}g</span>
                <span>•</span>
                <span class="text-purple-400">G: ${sub.defaultFat}g</span>
              </div>
            </div>
          `;
        })
        .join("");
    }

    substitutesModal.classList.remove("hidden");
  }

  // ─── Init ────────────────────────────────────────────────────────────────────
  loadingText.textContent = t("dashboard.loading");

  const cleanup = initPage({
    allowedRoles: ["client", "admin", "trainer"],
    onReady: async (firebaseUser, userData) => {
      const clientId = firebaseUser.uid;
      currentClientId = clientId;
      currentUserRole = userData?.role || "client";
      clientMedicalProfile = userData?.medicalProfile || null;

      initWaterTracker();

      // Suscribirse a los alimentos del catálogo
      unsubFoods = subscribeToFoods((foods) => {
        allCatalogFoods = foods;
        if (currentDietObj) {
          renderCurrentDiet(currentDietObj);
        }
      });

      // Suscribirse a la dieta actual
      unsubDiets = subscribeToDiets(clientId, (diets) => {
        allDiets = diets;
        if (diets.length > 0 && diets[0]) {
          renderCurrentDiet(diets[0]);
          btnHistory.classList.remove("hidden");
        } else {
          dietCard.classList.add("hidden");
          emptyState.classList.remove("hidden");
          btnHistory.classList.add("hidden");
        }
      });

      // Suscribirse a comidas completadas hoy para adherencia
      unsubTodayMeals = subscribeToTodayMeals(clientId, (completedIds) => {
        activeCompletedMealIds = completedIds;
        updateAdherence(completedIds);
      });

      // History toggle
      btnHistory.addEventListener("click", () => {
        showHistory(clientId);
      });

      btnBackCurrent.addEventListener("click", () => {
        historyView.classList.add("hidden");
        dietCard.classList.remove("hidden");
        btnHistory.classList.remove("hidden");
        if (unsubHistory) {
          unsubHistory();
          unsubHistory = null;
        }
      });
    },
  });

  // ─── Helper traducción de comidas ──────────────────────────────────────────
  function getMealLabel(name: string): string {
    const map: Record<string, string> = {
      breakfast: "Desayuno",
      lunch: "Almuerzo",
      snack: "Merienda",
      dinner: "Cena",
      other: "Otra toma",
    };
    return map[name] || name;
  }

  // ─── Render current diet ─────────────────────────────────────────────────────
  function renderCurrentDiet(d: Diet): void {
    currentDietObj = d;
    currentDietId = d.id;
    currentMealsCount = d.meals?.length || 0;

    dietName.textContent = d.name;

    const typeLabels: Record<string, string> = {
      normal: "Normocalórica",
      definition: "Definición Muscular",
      volume: "Volumen",
      keto: "Keto",
      vegan: "Vegana",
      custom: "Personalizada",
    };
    dietType.textContent = typeLabels[d.type] || d.type || "Personalizada";

    if (d.somatotype) {
      dietSomatotype.classList.remove("hidden");
      const somaLabels: Record<string, string> = {
        ectomorph: "Ectomorfo",
        mesomorph: "Mesomorfo",
        endomorph: "Endomorfo",
      };
      dietSomatotype.textContent = somaLabels[d.somatotype] || d.somatotype;
    } else {
      dietSomatotype.classList.add("hidden");
    }

    dietCalories.textContent = `${d.totalCalories || 0} kcal`;

    let sumCal = 0,
      sumP = 0,
      sumC = 0,
      sumF = 0;

    mealsList.innerHTML = "";
    if (d.meals && d.meals.length > 0) {
      d.meals.forEach((meal: Meal) => {
        sumCal += meal.calories || 0;
        sumP += meal.protein || 0;
        sumC += meal.carbs || 0;
        sumF += meal.fat || 0;

        const isCompleted = activeCompletedMealIds.includes(meal.id);
        const food = meal.foodId ? allCatalogFoods.find((f) => f.id === meal.foodId) : null;
        const localizedFoodName = food ? getFoodName(food, "es") : null;
        const allergensList = meal.allergens && meal.allergens.length > 0 ? meal.allergens : (food?.allergens || []);

        const div = document.createElement("div");
        div.className = `rounded-xl border p-4 backdrop-blur-sm transition-all animate-fade-in ${
          isCompleted
            ? "border-emerald-500/40 bg-[var(--brand-dim)]"
            : "border-[var(--border-subtle)] bg-[var(--surface-2)]"
        }`;
        div.id = `meal-${meal.id}`;
        div.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 space-y-1">
              <div class="flex items-center gap-2 flex-wrap">
                <h4 class="font-bold text-sm text-[var(--text-primary)] capitalize">${getMealLabel(meal.name)}</h4>
                <span class="text-[10px] text-[var(--text-disabled)] font-medium">#${meal.order || ""}</span>
                ${localizedFoodName ? `<span class="rounded-md bg-[var(--surface-3)] px-2 py-0.5 text-[11px] font-semibold text-[var(--brand)] border border-[var(--border-subtle)]">🍎 ${escapeHtml(localizedFoodName)}</span>` : ""}
                ${isCompleted ? `<span class="rounded-full bg-emerald-500/20 px-2 py-0.5 text-[10px] font-bold text-[var(--brand)]">${t("client.meal.completed")}</span>` : ""}
              </div>
              ${meal.description ? `<p class="text-xs text-[var(--text-tertiary)]">${escapeHtml(meal.description)}</p>` : ""}
              
              <!-- Macros y Alérgenos -->
              <div class="mt-2 flex flex-wrap items-center gap-2 text-xs font-semibold">
                <span class="rounded-md bg-amber-500/10 px-2 py-0.5 text-amber-400 border border-amber-500/20">${meal.calories || 0} kcal</span>
                <span class="rounded-md bg-emerald-500/10 px-2 py-0.5 text-emerald-400 border border-emerald-500/20">Prot: ${meal.protein || 0}g</span>
                <span class="rounded-md bg-blue-500/10 px-2 py-0.5 text-blue-400 border border-blue-500/20">Carbs: ${meal.carbs || 0}g</span>
                <span class="rounded-md bg-purple-500/10 px-2 py-0.5 text-purple-400 border border-purple-500/20">Grasas: ${meal.fat || 0}g</span>
                ${allergensList.length > 0 ? `<span class="text-[10px] text-rose-400 font-medium">⚠️ ${allergensList.join(", ")}</span>` : ""}
              </div>

              ${food ? `
                <button type="button" class="btn-substitutes mt-2 text-[11px] font-semibold text-[var(--brand)] hover:underline flex items-center gap-1" data-food-id="${food.id}">
                  <span>🔄</span> <span>Ver sustitutos recomendados</span>
                </button>
              ` : ""}
            </div>
            ${
              currentUserRole === "client"
                ? `
            <button data-meal-id="${meal.id}" data-meal-name="${meal.name}" class="btn-complete shrink-0 ml-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--brand)] hover:border-emerald-500/30 transition-all ${isCompleted ? "border-emerald-500 text-[var(--brand)] bg-emerald-500/10" : ""}">
              ${isCompleted ? t("client.meal.markDone") : t("client.meal.mark")}
            </button>
            `
                : ""
            }
          </div>
        `;
        mealsList.appendChild(div);
      });
    }

    totalCal.textContent = `${sumCal}`;
    totalProtein.textContent = `${sumP}`;
    totalCarbs.textContent = `${sumC}`;
    totalFat.textContent = `${sumF}`;

    targetKcalEl.textContent = `${d.totalCalories || sumCal}`;
    targetProtEl.textContent = `${sumP}`;
    targetCarbsEl.textContent = `${sumC}`;
    targetFatEl.textContent = `${sumF}`;

    dietCard.classList.remove("hidden");
    emptyState.classList.add("hidden");

    // Handler de completado de comidas
    mealsList.querySelectorAll(".btn-complete").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const mealId = btn.getAttribute("data-meal-id");
        const mealName = btn.getAttribute("data-meal-name");
        if (!mealId || !currentDietId) return;

        btn.setAttribute("disabled", "true");
        btn.classList.add("opacity-50");

        const result = await registerMealComplete(
          currentClientId,
          currentDietId,
          mealId,
          mealName || ""
        );

        if (result) {
          showToast(t("client.meal.registered"));
        } else {
          showToast(t("client.meal.error"), "error");
          btn.removeAttribute("disabled");
          btn.classList.remove("opacity-50");
        }
      });
    });

    // Handler de sustitutos
    mealsList.querySelectorAll(".btn-substitutes").forEach((btn) => {
      btn.addEventListener("click", () => {
        const foodId = btn.getAttribute("data-food-id");
        const food = allCatalogFoods.find((f) => f.id === foodId);
        if (food) {
          openSubstitutesModal(food);
        }
      });
    });

    updateMacroProgress();
  }

  function updateMacroProgress(): void {
    if (!currentDietObj || !currentDietObj.meals) return;

    let consumedKcal = 0,
      consumedP = 0,
      consumedC = 0,
      consumedF = 0;

    currentDietObj.meals.forEach((m) => {
      if (activeCompletedMealIds.includes(m.id)) {
        consumedKcal += m.calories || 0;
        consumedP += m.protein || 0;
        consumedC += m.carbs || 0;
        consumedF += m.fat || 0;
      }
    });

    consumedKcalEl.textContent = String(consumedKcal);
    consumedProtEl.textContent = String(consumedP);
    consumedCarbsEl.textContent = String(consumedC);
    consumedFatEl.textContent = String(consumedF);
  }

  function updateAdherence(completedIds: string[]): void {
    activeCompletedMealIds = completedIds;

    if (currentMealsCount === 0) {
      adherenceBar.classList.add("hidden");
      return;
    }

    adherenceBar.classList.remove("hidden");
    const pct = Math.min(100, Math.round((completedIds.length / currentMealsCount) * 100));

    adherenceFill.style.width = `${pct}%`;
    adherenceText.textContent = `${pct}% (${completedIds.length}/${currentMealsCount})`;

    if (currentDietObj) {
      renderCurrentDiet(currentDietObj);
    }
  }

  function showHistory(clientId: string): void {
    dietCard.classList.add("hidden");
    historyView.classList.remove("hidden");
    historyList.innerHTML = `<div class="p-4 text-center text-xs text-[var(--text-tertiary)]">${t("dashboard.loading")}</div>`;

    unsubHistory = subscribeToDietHistory(clientId, (diets) => {
      if (diets.length === 0) {
        historyList.innerHTML = `<div class="p-4 text-center text-xs text-[var(--text-disabled)]">${t("client.diet.noHistory")}</div>`;
        return;
      }

      historyList.innerHTML = diets
        .map((d) => {
          const isCurrent = d.id === currentDietId;
          const dateStr =
            d.createdAt && typeof (d.createdAt as any).toDate === "function"
              ? (d.createdAt as any).toDate().toLocaleDateString()
              : "Anterior";

          return `
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 backdrop-blur-sm flex items-center justify-between">
              <div>
                <p class="text-sm font-semibold text-[var(--text-primary)]">${escapeHtml(d.name)}</p>
                <p class="text-xs text-[var(--text-tertiary)]">${d.totalCalories} kcal · ${dateStr}</p>
              </div>
              ${isCurrent ? '<span class="rounded-full bg-[var(--brand-dim)] px-2.5 py-0.5 text-xs font-bold text-[var(--brand)]">Actual</span>' : ""}
            </div>
          `;
        })
        .join("");
    });
  }

  document.addEventListener("astro:before-swap", () => {
    unsubFoods?.();
    cleanup?.();
  });
</script>
