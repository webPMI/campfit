---
import ClientLayout from "@/layouts/ClientLayout.astro";
import SkeletonGroup from "@/components/SkeletonGroup.astro";
import PageTransition from "@/components/PageTransition.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<ClientLayout>
  <!-- Pantalla de carga con Skeleton -->
  <div id="loadingScreen" class="min-h-screen">
    <SkeletonGroup variant="dashboard" />
  </div>

  <!-- Contenido Principal del Dashboard -->
  <div id="dashboardContent" class="hidden">
    <main class="mx-auto max-w-4xl px-4 py-4">
      <PageTransition animation="fade-up">
        <div class="space-y-6">
          
          <!-- Hero Banner de Bienvenida y Racha -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-gradient-to-br from-[var(--surface-1)] via-[var(--surface-2)] to-[var(--brand-dim)] p-6 backdrop-blur-xl space-y-3 relative overflow-hidden">
            <div class="flex items-center justify-between flex-wrap gap-3 relative z-10">
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="text-2xl font-black tracking-tight text-[var(--text-primary)]" id="greeting">
                    {t("client.greeting")}...
                  </h2>
                  <span class="inline-flex items-center gap-1 rounded-full bg-amber-500/10 px-2.5 py-0.5 text-xs font-bold text-amber-400 border border-amber-500/20 shadow-sm">
                    🔥 <span data-i18n="client.streak">{t("client.streak")}</span>: <span id="streak-days">3</span> <span data-i18n="client.stats.days">{t("client.stats.days")}</span>
                  </span>
                </div>
                <p data-i18n="app.tagline" class="text-xs text-[var(--text-tertiary)] mt-1 font-medium">{t("app.tagline")}</p>
              </div>

              <a href={`/client/progress?lang=${lang}`} class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[var(--brand)] text-[var(--text-on-brand)] text-xs font-bold shadow-md hover:opacity-95 transition-all">
                <span>📊</span>
                <span data-i18n="dashboard.progress">{t("dashboard.progress")}</span>
              </a>
            </div>

            <!-- Accesos Rápidos de Chequeo de Hábitos en el Hero -->
            <div class="pt-3 border-t border-[var(--border-subtle)] grid grid-cols-2 sm:grid-cols-5 gap-2">
              <button id="quick-habit-water" type="button" class="flex items-center justify-between p-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)]/60 text-xs font-semibold hover:border-blue-400/40 transition-all">
                <span class="flex items-center gap-1.5">💧 <span data-i18n="client.water">{t("client.water")}</span></span>
                <span id="quick-habit-water-val" class="text-[10px] text-blue-400 font-bold">0L</span>
              </button>
              <button id="quick-habit-workout" type="button" class="flex items-center justify-between p-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)]/60 text-xs font-semibold hover:border-emerald-400/40 transition-all">
                <span class="flex items-center gap-1.5">🏋️ <span data-i18n="client.workout">{t("client.workout")}</span></span>
                <span id="quick-habit-workout-st" data-i18n="client.today" class="text-[10px] text-emerald-400 font-bold">{t("client.today")}</span>
              </button>
              <button id="quick-habit-diet" type="button" class="flex items-center justify-between p-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)]/60 text-xs font-semibold hover:border-amber-400/40 transition-all">
                <span class="flex items-center gap-1.5">🥗 <span data-i18n="client.diet">{t("client.diet")}</span></span>
                <span id="quick-habit-diet-st" class="text-[10px] text-amber-400 font-bold">100%</span>
              </button>
              <button id="quick-habit-sleep" type="button" class="flex items-center justify-between p-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)]/60 text-xs font-semibold hover:border-purple-400/40 transition-all">
                <span class="flex items-center gap-1.5">🛌 <span data-i18n="client.sleep">{t("client.sleep")}</span></span>
                <span class="text-[10px] text-purple-400 font-bold">8h</span>
              </button>
              <button id="quick-habit-steps" type="button" class="flex items-center justify-between p-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)]/60 text-xs font-semibold hover:border-cyan-400/40 transition-all">
                <span class="flex items-center gap-1.5">🚶 <span data-i18n="client.steps">{t("client.steps")}</span></span>
                <span class="text-[10px] text-cyan-400 font-bold">10k</span>
              </button>
            </div>
          </div>

          <!-- Rejilla Principal de Métricas Clave (4 Cards) -->
          <div class="grid grid-cols-2 gap-3.5 sm:grid-cols-4">
            <!-- 1. Adherencia Rutina -->
            <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl space-y-2">
              <div class="flex items-center justify-between">
                <span data-i18n="client.workout.progress" class="text-xs font-semibold text-[var(--text-secondary)]">{t("client.workout.progress")}</span>
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[var(--brand-dim)] text-xs text-[var(--brand)]">🏋️</span>
              </div>
              <p class="text-2xl font-black text-[var(--brand)]" id="workoutProgress">--%</p>
              <div class="h-1.5 overflow-hidden rounded-full bg-[var(--surface-3)]">
                <div id="workoutBar" class="h-full rounded-full bg-gradient-to-r from-[var(--brand)] to-emerald-400 transition-all duration-500" style="width: 0%"></div>
              </div>
              <p data-i18n="client.workout.progress.desc" class="text-[10px] text-[var(--text-disabled)]">{t("client.workout.progress.desc")}</p>
            </div>

            <!-- 2. Adherencia Dieta -->
            <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl space-y-2">
              <div class="flex items-center justify-between">
                <span data-i18n="client.diet.adherence" class="text-xs font-semibold text-[var(--text-secondary)]">{t("client.diet.adherence")}</span>
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-500/10 text-xs text-amber-400">🥗</span>
              </div>
              <p class="text-2xl font-black text-amber-400" id="dietAdherence">--%</p>
              <div class="h-1.5 overflow-hidden rounded-full bg-[var(--surface-3)]">
                <div id="dietBar" class="h-full rounded-full bg-gradient-to-r from-amber-400 to-amber-500 transition-all duration-500" style="width: 0%"></div>
              </div>
              <p class="text-[10px] text-[var(--text-disabled)]" id="todayCalories">-- <span data-i18n="client.todayCalories">{t("client.todayCalories")}</span></p>
            </div>

            <!-- 3. Hidratación Diaria Interactiva -->
            <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl space-y-2">
              <div class="flex items-center justify-between">
                <span data-i18n="client.water" class="text-xs font-semibold text-[var(--text-secondary)]">{t("client.water")}</span>
                <div class="flex items-center gap-1">
                  <button id="dash-water-add-btn" class="h-6 w-6 rounded-md bg-blue-500 text-white font-bold text-xs flex items-center justify-center hover:bg-blue-600 transition-all">+</button>
                </div>
              </div>
              <p class="text-2xl font-black text-blue-400" id="dashWaterMl">0 ml</p>
              <div class="h-1.5 overflow-hidden rounded-full bg-[var(--surface-3)]">
                <div id="dashWaterBar" class="h-full rounded-full bg-gradient-to-r from-blue-500 to-cyan-400 transition-all duration-500" style="width: 0%"></div>
              </div>
              <p data-i18n="client.waterMeta" class="text-[10px] text-[var(--text-disabled)]">{t("client.waterMeta")}</p>
            </div>

            <!-- 4. Último Peso -->
            <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl space-y-2">
              <div class="flex items-center justify-between">
                <span data-i18n="client.stats.weight" class="text-xs font-semibold text-[var(--text-secondary)]">{t("client.stats.weight")}</span>
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-purple-500/10 text-xs text-purple-400">⚖️</span>
              </div>
              <p class="text-2xl font-black text-purple-400" id="lastWeight">-- kg</p>
              <p data-i18n="client.progress.history" class="text-[10px] text-[var(--text-disabled)]">{t("client.progress.history")}</p>
            </div>
          </div>

          <!-- Programación Semanal de Entrenamientos (Visual Tracker 7 Días) -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-5 backdrop-blur-xl space-y-3">
            <div class="flex items-center justify-between">
              <h3 data-i18n="client.weeklySchedule" class="text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider">{t("client.weeklySchedule")}</h3>
              <span id="current-day-badge" data-i18n="client.currentWeek" class="text-xs font-bold text-[var(--brand)]">{t("client.currentWeek")}</span>
            </div>
            <div class="grid grid-cols-7 gap-2 text-center" id="week-dots-grid">
              <div class="p-2 rounded-xl bg-[var(--surface-3)] border border-[var(--border-subtle)] space-y-1">
                <span data-i18n="day.mon" class="text-[10px] font-bold text-[var(--text-tertiary)] block">{t("day.mon")}</span>
                <span class="text-xs">🏋️</span>
              </div>
              <div class="p-2 rounded-xl bg-[var(--surface-3)] border border-[var(--border-subtle)] space-y-1">
                <span data-i18n="day.tue" class="text-[10px] font-bold text-[var(--text-tertiary)] block">{t("day.tue")}</span>
                <span class="text-xs">🏃</span>
              </div>
              <div class="p-2 rounded-xl bg-[var(--surface-3)] border border-[var(--border-subtle)] space-y-1">
                <span data-i18n="day.wed" class="text-[10px] font-bold text-[var(--text-tertiary)] block">{t("day.wed")}</span>
                <span class="text-xs">🏋️</span>
              </div>
              <div class="p-2 rounded-xl bg-[var(--surface-3)] border border-[var(--border-subtle)] space-y-1">
                <span data-i18n="day.thu" class="text-[10px] font-bold text-[var(--text-tertiary)] block">{t("day.thu")}</span>
                <span class="text-xs">🛌</span>
              </div>
              <div class="p-2 rounded-xl bg-[var(--surface-3)] border border-[var(--border-subtle)] space-y-1">
                <span data-i18n="day.fri" class="text-[10px] font-bold text-[var(--text-tertiary)] block">{t("day.fri")}</span>
                <span class="text-xs">🏋️</span>
              </div>
              <div class="p-2 rounded-xl bg-[var(--surface-3)] border border-[var(--border-subtle)] space-y-1">
                <span data-i18n="day.sat" class="text-[10px] font-bold text-[var(--text-tertiary)] block">{t("day.sat")}</span>
                <span class="text-xs">🏃</span>
              </div>
              <div class="p-2 rounded-xl bg-[var(--surface-3)] border border-[var(--border-subtle)] space-y-1">
                <span data-i18n="day.sun" class="text-[10px] font-bold text-[var(--text-tertiary)] block">{t("day.sun")}</span>
                <span class="text-xs">🛌</span>
              </div>
            </div>
          </div>

          <!-- Bloque de Resumen de Entrenamiento y Nutrición de Hoy -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Tarjeta de Entrenamiento del Día -->
            <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-5 backdrop-blur-xl space-y-3 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="text-lg">🏋️</span>
                    <h3 data-i18n="client.quick.workout" class="text-sm font-bold text-[var(--text-primary)]">{t("client.quick.workout")}</h3>
                  </div>
                  <span id="workout-day-badge" data-i18n="common.assigned" class="rounded-full bg-[var(--brand-dim)] px-2.5 py-0.5 text-[10px] font-bold text-[var(--brand)]">{t("common.assigned")}</span>
                </div>

                <div id="today-workout-box" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 space-y-2">
                  <p id="today-workout-title" class="text-sm font-bold text-[var(--text-primary)]">{t("client.no.workout")}</p>
                  <p id="today-workout-desc" class="text-xs text-[var(--text-tertiary)]">{t("client.workout.assigned.desc")}</p>
                </div>
              </div>

              <a
                href={`/client/workouts?lang=${lang}`}
                class="flex items-center justify-center gap-2 w-full rounded-xl bg-[var(--brand)] px-4 py-2.5 text-xs font-bold text-[var(--text-on-brand)] shadow-md transition-all hover:opacity-90 active:scale-95 mt-3"
              >
                <span data-i18n="client.viewFullWorkout">{t("client.viewFullWorkout")}</span>
              </a>
            </div>

            <!-- Tarjeta de Plan Nutricional del Día -->
            <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-5 backdrop-blur-xl space-y-3 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="text-lg">🥗</span>
                    <h3 data-i18n="client.quick.meal" class="text-sm font-bold text-[var(--text-primary)]">{t("client.quick.meal")}</h3>
                  </div>
                  <span id="diet-type-badge" data-i18n="client.prescribed" class="rounded-full bg-amber-500/10 px-2.5 py-0.5 text-[10px] font-bold text-amber-400 border border-amber-500/20">{t("client.prescribed")}</span>
                </div>

                <div id="today-diet-box" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 space-y-2">
                  <p id="today-diet-title" class="text-sm font-bold text-[var(--text-primary)]">{t("client.no.diet")}</p>
                  <p id="today-diet-desc" class="text-xs text-[var(--text-tertiary)]">{t("client.diet.assigned.desc")}</p>
                </div>
              </div>

              <a
                href={`/client/diets?lang=${lang}`}
                class="flex items-center justify-center gap-2 w-full rounded-xl bg-amber-500 px-4 py-2.5 text-xs font-bold text-white shadow-md transition-all hover:opacity-90 active:scale-95 mt-3"
              >
                <span data-i18n="client.viewFullDiet">{t("client.viewFullDiet")}</span>
              </a>
            </div>
          </div>

          <!-- Acciones Rápidas & Bienestar Humano -->
          <div class="space-y-3">
            <h3 data-i18n="client.quickHabitsTitle" class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider">{t("client.quickHabitsTitle")}</h3>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <a
                href={`/client/progress?lang=${lang}`}
                class="flex flex-col items-center justify-center p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] hover:bg-[var(--surface-3)] transition-all text-center space-y-1.5 shadow-sm"
              >
                <span class="text-2xl">📋</span>
                <span data-i18n="client.checklistDiario" class="text-xs font-bold text-[var(--text-primary)]">{t("client.checklistDiario")}</span>
                <span data-i18n="client.logHabits" class="text-[10px] text-[var(--text-tertiary)]">{t("client.logHabits")}</span>
              </a>

              <a
                href={`/client/progress?lang=${lang}`}
                class="flex flex-col items-center justify-center p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] hover:bg-[var(--surface-3)] transition-all text-center space-y-1.5 shadow-sm"
              >
                <span class="text-2xl">📸</span>
                <span data-i18n="client.fotosR2" class="text-xs font-bold text-[var(--text-primary)]">{t("client.fotosR2")}</span>
                <span data-i18n="client.uploadCloudPhotos" class="text-[10px] text-[var(--text-tertiary)]">{t("client.uploadCloudPhotos")}</span>
              </a>

              <a
                href={`/client/progress?lang=${lang}`}
                class="flex flex-col items-center justify-center p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] hover:bg-[var(--surface-3)] transition-all text-center space-y-1.5 shadow-sm"
              >
                <span class="text-2xl">⚖️</span>
                <span data-i18n="client.logWeight" class="text-xs font-bold text-[var(--text-primary)]">{t("client.logWeight")}</span>
                <span data-i18n="client.weightTrend" class="text-[10px] text-[var(--text-tertiary)]">{t("client.weightTrend")}</span>
              </a>

              <a
                href={`/client/chat?lang=${lang}`}
                class="flex flex-col items-center justify-center p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] hover:bg-[var(--surface-3)] transition-all text-center space-y-1.5 shadow-sm"
              >
                <span class="text-2xl">💬</span>
                <span data-i18n="client.chatTrainer" class="text-xs font-bold text-[var(--text-primary)]">{t("client.chatTrainer")}</span>
                <span data-i18n="client.directChat" class="text-[10px] text-[var(--text-tertiary)]">{t("client.directChat")}</span>
              </a>
            </div>
          </div>

          <!-- Tarjeta de Entrenador Asignado -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl flex items-center justify-between flex-wrap gap-3">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 text-white font-bold text-lg shadow-md">
                🏋️‍♂️
              </div>
              <div>
                <p data-i18n="client.assignedTrainer" class="text-xs font-bold text-[var(--text-tertiary)] uppercase tracking-wider">{t("client.assignedTrainer")}</p>
                <p class="text-sm font-bold text-[var(--text-primary)]" id="trainer-name">CampFit Pro Support</p>
              </div>
            </div>
            <a href={`/client/chat?lang=${lang}`} class="rounded-xl border border-[var(--border-brand)] bg-[var(--brand-dim)] px-4 py-2 text-xs font-bold text-[var(--brand)] hover:bg-[var(--brand)] hover:text-white transition-all shadow-sm">
              <span data-i18n="dashboard.messages">{t("dashboard.messages")}</span>
            </a>
          </div>

        </div>
      </PageTransition>
    </main>
  </div>

  <script>
    import { initPage } from "@/lib/shared/initPage";
    import { subscribeToWorkouts } from "@/lib/client/workoutService";
    import { subscribeToDiets, subscribeToTodayMeals } from "@/lib/client/dietService";
    import { subscribeToProgress } from "@/lib/client/progressService";
    import { t } from "@/i18n/client";

    const loadingScreen = document.getElementById("loadingScreen")!;
    const dashboardContent = document.getElementById("dashboardContent")!;
    const greeting = document.getElementById("greeting")!;

    const workoutProgress = document.getElementById("workoutProgress")!;
    const workoutBar = document.getElementById("workoutBar")!;
    const dietAdherence = document.getElementById("dietAdherence")!;
    const dietBar = document.getElementById("dietBar")!;
    const lastWeight = document.getElementById("lastWeight")!;
    const todayCalories = document.getElementById("todayCalories")!;

    const dashWaterMl = document.getElementById("dashWaterMl")!;
    const dashWaterBar = document.getElementById("dashWaterBar")!;
    const dashWaterAddBtn = document.getElementById("dash-water-add-btn");
    const quickHabitWaterVal = document.getElementById("quick-habit-water-val");

    const todayWorkoutTitle = document.getElementById("today-workout-title")!;
    const todayWorkoutDesc = document.getElementById("today-workout-desc")!;

    const todayDietTitle = document.getElementById("today-diet-title")!;
    const todayDietDesc = document.getElementById("today-diet-desc")!;

    let currentUserId = "";

    function getTodayWaterKey(uid: string): string {
      const todayStr = new Date().toISOString().substring(0, 10);
      return `cf_water_${uid}_${todayStr}`;
    }

    function updateDashWater(uid: string, addMl: number = 0): void {
      if (!uid) return;
      const key = getTodayWaterKey(uid);
      const stored = localStorage.getItem(key);
      let currentMl = stored ? parseInt(stored, 10) || 0 : 0;
      if (addMl > 0) {
        currentMl += addMl;
        localStorage.setItem(key, currentMl.toString());
      }

      dashWaterMl.textContent = `${currentMl} ml`;
      if (quickHabitWaterVal) quickHabitWaterVal.textContent = `${(currentMl / 1000).toFixed(1)}L`;
      const pct = Math.min(100, Math.round((currentMl / 2500) * 100));
      dashWaterBar.style.width = `${pct}%`;
    }

    const cleanup = initPage({
      allowedRoles: ["client", "admin", "trainer"],
      onReady: async (firebaseUser, userData) => {
        currentUserId = firebaseUser.uid;
        const userName = userData?.name || firebaseUser.displayName || firebaseUser.email || "Usuario";
        greeting.textContent = `${t("client.greeting")}, ${userName}! 👋`;

        loadingScreen.classList.add("hidden");
        dashboardContent.classList.remove("hidden");

        updateDashWater(currentUserId);

        let currentMealsCount = 0;
        let unsubTodayMeals: (() => void) | null = null;

        // Suscripción a Rutinas
        subscribeToWorkouts(firebaseUser.uid, (workouts) => {
          if (workouts.length > 0 && workouts[0]) {
            const workout = workouts[0];
            const exercisesCount = workout.exercises?.length || 0;

            todayWorkoutTitle.textContent = workout.name;
            todayWorkoutDesc.textContent = `${exercisesCount} ${t("workout.exercises")} · ${t("common.assigned")}`;

            const completed = workout.exercises?.filter((ex: any) => ex.completed)?.length || 0;
            const pct = exercisesCount > 0 ? Math.round((completed / exercisesCount) * 100) : 0;
            workoutProgress.textContent = `${pct}%`;
            workoutBar.style.width = `${pct}%`;
          } else {
            todayWorkoutTitle.textContent = t("client.no.workout");
            todayWorkoutDesc.textContent = t("client.workout.assigned.desc");
            workoutProgress.textContent = "0%";
            workoutBar.style.width = "0%";
          }
        });

        // Suscripción a Dietas
        subscribeToDiets(firebaseUser.uid, (diets) => {
          if (diets.length > 0 && diets[0]) {
            const diet = diets[0];
            currentMealsCount = diet.meals?.length || 0;

            todayDietTitle.textContent = diet.name;
            todayDietDesc.textContent = `${diet.totalCalories || 0} kcal · ${currentMealsCount} ${t("diet.meals")}`;
            todayCalories.textContent = `${diet.totalCalories || 0} ${t("client.todayCalories")}`;

            if (!unsubTodayMeals) {
              unsubTodayMeals = subscribeToTodayMeals(firebaseUser.uid, (completedIds) => {
                const pct = currentMealsCount > 0 ? Math.round((completedIds.length / currentMealsCount) * 100) : 0;
                dietAdherence.textContent = `${pct}%`;
                dietBar.style.width = `${pct}%`;
              });
            }
          } else {
            todayDietTitle.textContent = t("client.no.diet");
            todayDietDesc.textContent = t("client.diet.assigned.desc");
            dietAdherence.textContent = "0%";
            dietBar.style.width = "0%";
            todayCalories.textContent = `0 ${t("client.todayCalories")}`;
          }
        });

        // Suscripción a Registro de Peso
        subscribeToProgress(
          firebaseUser.uid,
          "weight",
          (logs) => {
            if (logs.length > 0 && logs[0]) {
              const w = logs[0].value?.weight;
              lastWeight.textContent = w ? `${w} kg` : "-- kg";
            } else {
              lastWeight.textContent = "-- kg";
            }
          },
          1
        );
      },
    });

    if (dashWaterAddBtn) {
      dashWaterAddBtn.addEventListener("click", () => {
        if (currentUserId) updateDashWater(currentUserId, 250);
      });
    }

    document.addEventListener("astro:before-swap", cleanup);
  </script>
</ClientLayout>
