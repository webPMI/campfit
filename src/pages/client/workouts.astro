---
import ClientLayout from "@/layouts/ClientLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<ClientLayout>
  <div id="loadingScreen" class="flex min-h-screen items-center justify-center">
    <div class="text-center animate-fade-in">
      <div class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-[var(--border-strong)] border-t-emerald-400"></div>
      <p id="loadingText" class="mt-4 text-sm text-[var(--text-tertiary)]">{t("dashboard.loading")}</p>
    </div>
  </div>

  <div id="workoutsContent" class="hidden">
    <main class="mx-auto max-w-4xl px-4 py-6">
      <div class="animate-fade-in space-y-6">
        <!-- Header -->
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div>
            <h2 data-i18n="dashboard.routines" class="text-xl font-bold text-[var(--text-primary)]">{t("dashboard.routines")}</h2>
            <p data-i18n="dashboard.routines.desc" class="mt-1 text-sm text-[var(--text-tertiary)]">{t("dashboard.routines.desc")}</p>
          </div>
          <button
            id="btn-open-proposal-modal"
            class="rounded-xl border border-[var(--border-brand)] bg-[var(--brand-dim)] px-3.5 py-2 text-xs font-semibold text-[var(--brand)] hover:bg-[var(--brand)] hover:text-black transition-all flex items-center gap-1.5 shadow-sm"
          >
            <span>✨</span>
            <span data-i18n="proposal.customize.workout">{t("proposal.customize.workout")}</span>
          </button>
        </div>

        <!-- Banner de Estado de Propuesta de Personalización -->
        <div id="proposal-status-banner" class="hidden rounded-2xl border border-blue-500/30 bg-blue-500/10 p-4 backdrop-blur-xl space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-lg">📋</span>
              <div>
                <h4 class="text-xs font-bold text-blue-300">Propuesta de Rutina en Revisión</h4>
                <p id="proposal-banner-desc" class="text-[11px] text-blue-200/80">Tu entrenador está revisando los días y horas que propusiste.</p>
              </div>
            </div>
            <span id="proposal-banner-status" class="rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/40 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider">Pendiente</span>
          </div>
          <div id="proposal-banner-feedback" class="hidden text-xs bg-zinc-900/80 p-3 rounded-xl border border-zinc-700 text-zinc-300">
            <p class="font-bold text-amber-300 mb-0.5">💬 Consejo de tu entrenador:</p>
            <p id="proposal-feedback-text"></p>
          </div>
        </div>

        <!-- Navegación por Días de la Semana (Lunes a Domingo) -->
        <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] p-3 backdrop-blur-xl">
          <div class="text-xs font-semibold text-[var(--text-tertiary)] uppercase tracking-wider mb-2 px-1 flex items-center justify-between">
            <span data-i18n="client.weeklySchedule">{t("client.weeklySchedule")}</span>
            <span id="active-day-label" class="text-[var(--brand)] font-bold text-xs"></span>
          </div>
          <div class="grid grid-cols-7 gap-1.5 text-center text-xs" id="days-tabs-container">
            <!-- Tabs renderizadas por JS -->
          </div>
        </div>

        <!-- Tarjeta Principal de Rutina -->
        <div id="workoutCard" class="hidden card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-6">
          <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-4 flex-wrap gap-2">
            <div>
              <div class="flex items-center gap-2">
                <h3 id="workoutName" class="text-lg font-bold text-[var(--text-primary)]"></h3>
                <span id="workoutDifficulty" class="rounded-full bg-[var(--brand-dim)] px-3 py-1 text-xs font-medium text-[var(--brand)] border border-[var(--border-brand)]"></span>
              </div>
              <p id="workoutDescription" class="mt-1 text-xs text-[var(--text-tertiary)]"></p>
            </div>
          </div>

          <!-- Banner de Resumen de Chequeo de la Sesión -->
          <div class="rounded-xl border border-[var(--border-brand)] bg-[var(--brand-dim)] p-3 flex items-center justify-between text-xs flex-wrap gap-2">
            <span data-i18n="workout.sessionProgress" class="font-bold text-[var(--brand)]">{t("workout.sessionProgress")}</span>
            <div class="flex items-center gap-3 font-medium text-[var(--text-primary)]">
              <span>✅ <span id="count-completed">0</span></span>
              <span>⚠️ <span id="count-partial">0</span></span>
              <span>❌ <span id="count-skipped">0</span></span>
            </div>
          </div>

          <!-- Lista de Ejercicios del Día -->
          <div class="space-y-4" id="exercisesList">
            <!-- Ejercicios renderizados por JS -->
          </div>

          <!-- Formulario Final de Registro de Sesión -->
          <div class="pt-4 border-t border-[var(--border-subtle)] space-y-3">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div>
                <label data-i18n="workout.rpeLabel" class="block text-xs font-medium text-[var(--text-secondary)] mb-1">{t("workout.rpeLabel")}</label>
                <select id="session-rpe" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]">
                  <option value="5">5 - Esfuerzo Moderado</option>
                  <option value="6">6 - Algo Duro</option>
                  <option value="7" selected>7 - Duro (Normal)</option>
                  <option value="8">8 - Muy Duro (Cerca del fallo)</option>
                  <option value="9">9 - Extremadamente Duro</option>
                  <option value="10">10 - Máximo Esfuerzo (Fallo total)</option>
                </select>
              </div>

              <div>
                <label data-i18n="workout.notesLabel" class="block text-xs font-medium text-[var(--text-secondary)] mb-1">{t("workout.notesLabel")}</label>
                <input id="session-notes" type="text" placeholder="Ej: Buenas sensaciones, aumenté peso en banca" class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)]" />
              </div>
            </div>

            <button
              id="completeWorkoutBtn"
              class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-6 py-3.5 text-sm font-semibold text-[var(--text-on-brand)] shadow-lg shadow-[var(--shadow-glow-sm)] transition-all hover:opacity-95 active:scale-[0.98]"
            >
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              <span data-i18n="workout.logSession">{t("workout.logSession")}</span>
            </button>
          </div>
        </div>

        <!-- Historial de Vídeos y Correcciones de Técnica del Entrenador -->
        <div id="techniqueCorrectionsCard" class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4">
          <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-3 flex-wrap gap-2">
            <div>
              <h3 class="text-sm font-bold text-[var(--text-primary)]">📹 Mis Vídeos de Técnica & Correcciones</h3>
              <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Grabaciones enviadas a tu entrenador con sus correcciones y consejos técnicos.</p>
            </div>
            <span id="corrections-count-badge" class="rounded-full bg-purple-500/20 border border-purple-500/30 text-purple-300 px-2.5 py-0.5 text-xs font-semibold">0 enviadas</span>
          </div>

          <div id="client-corrections-list" class="space-y-3">
            <p class="text-xs text-[var(--text-disabled)] text-center py-4">No has enviado vídeos de técnica aún. Usa el botón "📹 Enviar Vídeo" en cualquier ejercicio de tu rutina.</p>
          </div>
        </div>

        <!-- Estado de Día de Descanso o Sin Rutina -->
        <div id="emptyState" class="hidden flex flex-col items-center justify-center rounded-2xl border border-dashed border-[var(--border-default)] bg-[var(--surface-2)] p-12 text-center">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--surface-4)] text-2xl">
            🛌
          </div>
          <h3 id="empty-title" data-i18n="client.no.workout" class="mt-4 text-lg font-semibold text-[var(--text-secondary)]">{t("client.no.workout")}</h3>
          <p id="empty-desc" data-i18n="client.workout.assigned.desc" class="mt-2 text-sm text-[var(--text-disabled)]">{t("client.workout.assigned.desc")}</p>
        </div>
      </div>
    </main>
  </div>

  <!-- Modal para Enviar Vídeo de Técnica al Entrenador -->
  <div id="technique-submit-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md hidden animate-fade-in">
    <div class="relative w-full max-w-md rounded-2xl border border-[var(--border-default)] bg-[var(--surface-2)] p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
        <div>
          <h3 class="text-base font-bold text-[var(--text-primary)]">📹 Enviar Vídeo de Técnica</h3>
          <p id="technique-modal-exercise-name" class="text-xs text-[var(--brand)] font-semibold mt-0.5"></p>
        </div>
        <button id="btn-close-technique-modal" class="text-[var(--text-tertiary)] hover:text-white text-xl font-bold">&times;</button>
      </div>

      <div class="space-y-3">
        <p class="text-xs text-[var(--text-secondary)]">
          Sube una grabación de tu serie para que tu entrenador asignado analice tu postura, rango de movimiento y tempo.
        </p>

        <!-- Dropzone de Vídeo -->
        <div
          id="techniqueVideoDropzone"
          class="relative flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-[var(--border-default)] bg-[var(--surface-3)] p-5 text-center hover:border-[var(--brand)] transition-all cursor-pointer"
        >
          <input
            id="techniqueFileInput"
            type="file"
            accept="video/mp4,video/webm,video/quicktime"
            class="hidden"
          />
          <div id="techniquePrompt" class="space-y-1.5">
            <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--surface-4)] text-xl">
              🎥
            </div>
            <p class="text-xs font-semibold text-[var(--text-primary)]">Toca para seleccionar o grabar vídeo</p>
            <p class="text-[10px] text-[var(--text-tertiary)]">MP4, WebM o MOV hasta 50MB</p>
          </div>

          <div id="techniquePreviewContainer" class="hidden w-full flex-col items-center space-y-2">
            <video id="techniquePreviewVideo" controls class="max-h-48 w-full rounded-xl bg-black object-contain"></video>
            <button id="btn-remove-technique-file" type="button" class="text-xs font-semibold text-rose-400 hover:text-rose-300">✕ Cambiar vídeo</button>
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-medium text-[var(--text-secondary)] mb-1">Notas o sensaciones para tu coach (opcional):</label>
          <textarea
            id="technique-notes-input"
            rows="2"
            class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--brand)] resize-none"
            placeholder="Ej: Siento que en la 4ª repetición pierdo la curvatura lumbar..."
          ></textarea>
        </div>
      </div>

      <div class="flex items-center gap-3 pt-3 border-t border-[var(--border-subtle)]">
        <button
          id="btn-submit-technique-video"
          disabled
          class="flex-1 rounded-xl bg-[var(--brand)] hover:bg-[var(--brand-hover)] px-4 py-2.5 text-xs font-bold text-[var(--text-on-brand)] shadow-md transition-all disabled:opacity-40 disabled:cursor-not-allowed flex items-center justify-center gap-1.5"
        >
          <span>🚀</span>
          <span id="btn-submit-technique-text">Enviar a mi Entrenador</span>
        </button>
        <button
          id="btn-cancel-technique"
          class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-4 py-2.5 text-xs font-medium text-[var(--text-secondary)] hover:text-white"
        >
          Cancelar
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Reproductor de Vídeo de Técnica / Coach -->
  <div id="video-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md hidden animate-fade-in">
    <div class="relative w-full max-w-2xl bg-zinc-900 border border-zinc-700 rounded-2xl overflow-hidden shadow-2xl space-y-3 p-4">
      <div class="flex items-center justify-between border-b border-zinc-800 pb-2">
        <h4 id="video-modal-title" class="text-sm font-bold text-white">Vídeo Explicativo del Coach</h4>
        <button id="btn-close-video-modal" class="text-zinc-400 hover:text-white text-lg font-bold">&times;</button>
      </div>
      <div class="relative aspect-video w-full bg-black rounded-xl overflow-hidden flex items-center justify-center">
        <video id="client-video-player" controls class="w-full h-full object-contain"></video>
      </div>
    </div>
  </div>

  <!-- Modal de Solicitud de Exclusión de Ejercicio -->
  <div id="exclusion-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm hidden animate-fade-in">
    <div class="relative w-full max-w-md rounded-2xl border border-[var(--border-default)] bg-[var(--surface-2)] p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
        <div>
          <h3 class="text-base font-bold text-[var(--text-primary)]">🚫 Solicitar Exclusión</h3>
          <p id="exclusion-modal-exercise-name" class="text-xs text-[var(--brand)] font-semibold"></p>
        </div>
        <button id="btn-close-exclusion" class="text-[var(--text-tertiary)] hover:text-white text-xl font-bold">&times;</button>
      </div>

      <div class="space-y-3">
        <p class="text-xs text-[var(--text-secondary)]">
          Indica los motivos por los que necesitas cambiar o retirar este ejercicio de tu rutina. Tu entrenador recibirá una notificación:
        </p>

        <div class="space-y-2 text-xs" id="exclusion-reasons-checklist">
          <!-- Renderizado dinámico de motivos -->
        </div>

        <div>
          <label class="block text-[11px] font-medium text-[var(--text-secondary)] mb-1">Detalles adicionales (opcional):</label>
          <textarea
            id="exclusion-custom-reason"
            rows="2"
            class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)] resize-none"
            placeholder="Ej: Siento molestias en el hombro derecho al extender el brazo..."
          ></textarea>
        </div>
      </div>

      <div class="flex items-center gap-3 pt-3 border-t border-[var(--border-subtle)]">
        <button
          id="btn-confirm-exclusion"
          class="flex-1 rounded-xl bg-gradient-to-r from-rose-500 to-rose-600 px-4 py-2.5 text-xs font-bold text-white shadow-md hover:opacity-95 transition-all"
        >
          Enviar Solicitud
        </button>
        <button
          id="btn-cancel-exclusion"
          class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-4 py-2.5 text-xs font-medium text-[var(--text-secondary)] hover:text-white"
        >
          Cancelar
        </button>
      </div>
    </div>
  </div>

  <!-- Modal para Personalizar Rutina y Horarios -->
  <div id="customize-workout-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md hidden animate-fade-in">
    <div class="relative w-full max-w-lg rounded-2xl border border-[var(--border-default)] bg-[var(--surface-2)] p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--border-subtle)]">
        <div>
          <h3 class="text-base font-bold text-[var(--text-primary)]">✨ Personalizar Rutina y Horarios</h3>
          <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Adapta los días y horas a tu semana para que tu coach lo revise.</p>
        </div>
        <button id="btn-close-proposal-modal" class="text-[var(--text-tertiary)] hover:text-white text-xl font-bold">&times;</button>
      </div>

      <div class="space-y-4">
        <!-- Selector de Enfoque / Objetivo Atlético -->
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] p-3.5 space-y-3">
          <div>
            <label class="block text-xs font-bold text-[var(--text-primary)]">🎯 Enfoque y Objetivo Físico</label>
            <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5">Elige cómo quieres enfocar tu desarrollo muscular y rendimiento:</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <label class="focus-option-card flex flex-col p-2.5 rounded-xl border border-[var(--border-brand)] bg-[var(--brand-dim)] cursor-pointer hover:border-[var(--brand)] transition-all">
              <input type="radio" name="athletic-focus" value="balanced" class="sr-only" checked />
              <span class="text-base mb-1">⚖️</span>
              <span class="text-xs font-bold text-[var(--brand)]">Equilibrado</span>
              <span class="text-[10px] text-zinc-400 mt-0.5 leading-tight">Simetría, postura y salud articular</span>
            </label>

            <label class="focus-option-card flex flex-col p-2.5 rounded-xl border border-zinc-700 bg-zinc-800/40 cursor-pointer hover:border-[var(--brand)] transition-all">
              <input type="radio" name="athletic-focus" value="sport_performance" class="sr-only" />
              <span class="text-base mb-1">⚡</span>
              <span class="text-xs font-bold text-white">Deportivo</span>
              <span class="text-[10px] text-zinc-400 mt-0.5 leading-tight">Potencia máxima para tu deporte</span>
            </label>

            <label class="focus-option-card flex flex-col p-2.5 rounded-xl border border-zinc-700 bg-zinc-800/40 cursor-pointer hover:border-[var(--brand)] transition-all">
              <input type="radio" name="athletic-focus" value="hybrid" class="sr-only" />
              <span class="text-base mb-1">🔥</span>
              <span class="text-xs font-bold text-white">Híbrido</span>
              <span class="text-[10px] text-zinc-400 mt-0.5 leading-tight">Fuerza atlética + estética</span>
            </label>
          </div>

          <!-- Selector de Deporte Específico (solo si elige Deportivo) -->
          <div id="sport-selector-container" class="hidden pt-2 border-t border-zinc-700/60 space-y-1.5">
            <label class="block text-[11px] font-bold text-amber-300">🏅 Disciplina deportiva principal:</label>
            <select id="proposal-sport-select" class="w-full rounded-xl border border-zinc-700 bg-zinc-900 px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-400">
              <option value="football">⚽ Fútbol / Futsal</option>
              <option value="running">🏃 Running / Trail</option>
              <option value="padel_tennis">🎾 Pádel / Tenis</option>
              <option value="basketball">🏀 Baloncesto / Vóley</option>
              <option value="swimming">🏊 Natación</option>
              <option value="cycling">🚴 Ciclismo / Triatlón</option>
              <option value="martial_arts">🥊 Artes Marciales / Boxeo</option>
              <option value="strength">🏋️ Deportes de Fuerza / Powerlifting</option>
            </select>
          </div>

          <!-- Tarjeta Dinámica de Recomendación y Zonas a Fortalecer -->
          <div id="athletic-recommendation-box" class="rounded-xl border border-amber-500/30 bg-black/40 p-3 text-xs space-y-2">
            <div class="flex items-center justify-between">
              <span id="rec-title" class="font-bold text-amber-300">Plan de Armonía Funcional y Simetría</span>
              <span id="rec-badge" class="rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 px-2 py-0.5 text-[9px] font-bold uppercase">Recomendado</span>
            </div>
            
            <div>
              <p class="text-[10px] font-semibold text-zinc-400 mb-1">💪 Partes prioritarias a fortalecer:</p>
              <div id="rec-priority-muscles" class="flex flex-wrap gap-1.5">
                <!-- Badges de músculos prioritarios -->
              </div>
            </div>

            <p id="rec-biomechanical-advice" class="text-[11px] text-zinc-300 italic pt-1 border-t border-zinc-800">
              Prioriza ejercicios bilaterales compuestos combinados con trabajo unilateral para corregir asimetrías.
            </p>
          </div>
        </div>

        <!-- Días de la semana -->
        <div>
          <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">📅 Días programados de entreno</label>
          <div class="grid grid-cols-7 gap-1.5 text-center text-xs">
            <label class="day-checkbox-card flex flex-col items-center justify-center p-2 rounded-xl border border-zinc-700 bg-zinc-800/60 cursor-pointer hover:border-[var(--brand)] transition-all">
              <input type="checkbox" value="1" class="day-proposal-cb accent-[var(--brand)]" checked />
              <span class="text-[10px] text-zinc-400 mt-1">L</span>
            </label>
            <label class="day-checkbox-card flex flex-col items-center justify-center p-2 rounded-xl border border-zinc-700 bg-zinc-800/60 cursor-pointer hover:border-[var(--brand)] transition-all">
              <input type="checkbox" value="2" class="day-proposal-cb accent-[var(--brand)]" />
              <span class="text-[10px] text-zinc-400 mt-1">M</span>
            </label>
            <label class="day-checkbox-card flex flex-col items-center justify-center p-2 rounded-xl border border-zinc-700 bg-zinc-800/60 cursor-pointer hover:border-[var(--brand)] transition-all">
              <input type="checkbox" value="3" class="day-proposal-cb accent-[var(--brand)]" checked />
              <span class="text-[10px] text-zinc-400 mt-1">X</span>
            </label>
            <label class="day-checkbox-card flex flex-col items-center justify-center p-2 rounded-xl border border-zinc-700 bg-zinc-800/60 cursor-pointer hover:border-[var(--brand)] transition-all">
              <input type="checkbox" value="4" class="day-proposal-cb accent-[var(--brand)]" />
              <span class="text-[10px] text-zinc-400 mt-1">J</span>
            </label>
            <label class="day-checkbox-card flex flex-col items-center justify-center p-2 rounded-xl border border-zinc-700 bg-zinc-800/60 cursor-pointer hover:border-[var(--brand)] transition-all">
              <input type="checkbox" value="5" class="day-proposal-cb accent-[var(--brand)]" checked />
              <span class="text-[10px] text-zinc-400 mt-1">V</span>
            </label>
            <label class="day-checkbox-card flex flex-col items-center justify-center p-2 rounded-xl border border-zinc-700 bg-zinc-800/60 cursor-pointer hover:border-[var(--brand)] transition-all">
              <input type="checkbox" value="6" class="day-proposal-cb accent-[var(--brand)]" />
              <span class="text-[10px] text-zinc-400 mt-1">S</span>
            </label>
            <label class="day-checkbox-card flex flex-col items-center justify-center p-2 rounded-xl border border-zinc-700 bg-zinc-800/60 cursor-pointer hover:border-[var(--brand)] transition-all">
              <input type="checkbox" value="7" class="day-proposal-cb accent-[var(--brand)]" />
              <span class="text-[10px] text-zinc-400 mt-1">D</span>
            </label>
          </div>
        </div>

        <!-- Hora programada estimada -->
        <div>
          <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">⏰ Hora estimada de inicio</label>
          <input
            id="proposal-workout-time"
            type="time"
            value="18:30"
            class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand)]"
          />
        </div>

        <!-- Notas / Dudas para el Entrenador -->
        <div>
          <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5">💬 Notas o dudas para tu entrenador</label>
          <textarea
            id="proposal-workout-notes"
            rows="3"
            class="w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--brand)] resize-none"
            placeholder="Ej: He seleccionado potenciación para fútbol y me gustaría enfocarme en aceleración e isquiotibiales..."
          ></textarea>
        </div>
      </div>

      <div class="flex items-center gap-3 pt-3 border-t border-[var(--border-subtle)]">
        <button
          id="btn-submit-workout-proposal"
          class="flex-1 rounded-xl bg-[var(--brand)] hover:bg-[var(--brand-hover)] px-4 py-2.5 text-xs font-bold text-[var(--text-on-brand)] shadow-md transition-all flex items-center justify-center gap-1.5"
        >
          <span>🚀</span>
          <span id="btn-submit-workout-proposal-text">Enviar propuesta a mi entrenador</span>
        </button>
        <button
          id="btn-cancel-proposal-modal"
          class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-4 py-2.5 text-xs font-medium text-[var(--text-secondary)] hover:text-white"
        >
          Cancelar
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Notificaciones -->
  <div id="workout-toast" class="fixed bottom-24 left-1/2 z-50 -translate-x-1/2 rounded-xl border border-emerald-500/30 bg-[var(--brand-dim)] px-6 py-3 text-sm font-medium text-[var(--brand)] backdrop-blur-xl shadow-2xl hidden"></div>
</ClientLayout>

<script>
  import { initPage } from "@/lib/shared/initPage";
  import { subscribeToWorkouts, logWorkoutSession } from "@/lib/client/workoutService";
  import {
    createPlanProposal,
    subscribeToClientProposals,
    type PlanProposal,
  } from "@/lib/shared/planProposalService";
  import {
    subscribeToExercises,
    getExerciseName,
    EXCLUSION_REASON_LABELS,
    MUSCLE_LABELS,
    type ExerciseItem,
    type ExclusionReason,
  } from "@/lib/shared/exerciseLibrary";
  import {
    subscribeToUserExercisePreferences,
    rateExercise,
    toggleFavorite,
    requestExerciseExclusion,
  } from "@/lib/client/exercisePreferencesService";
  import {
    subscribeToCorrectionsByClient,
    submitTechniqueVideo,
    deleteTechniqueCorrection,
    type ExerciseCorrection,
  } from "@/lib/shared/techniqueCorrectionService";
  import { validateMediaFile } from "@/lib/storage/r2Service";
  import { checkExerciseInjuryConflicts } from "@/lib/client/injuryChecker";
  import {
    getAthleticRecommendation,
    type AthleticFocusType,
    type AthleticSport,
    MUSCLE_SPANISH_LABELS,
  } from "@/lib/shared/athleticAdvisorService";
  import type { Workout } from "@/lib/client/workoutService";
  import type { ExerciseExecutionLog } from "@/lib/trainer/types";
  import type { UserExercisePreferences, MedicalProfile } from "@/types";
  import { t } from "@/i18n/client";
  import { escapeHtml, showToast, showConfirm } from "@/lib/shared/ui";

  const loadingScreen = document.getElementById("loadingScreen")!;
  const loadingText = document.getElementById("loadingText")!;
  const workoutsContent = document.getElementById("workoutsContent")!;
  const workoutCard = document.getElementById("workoutCard")!;
  const emptyState = document.getElementById("emptyState")!;
  const emptyTitle = document.getElementById("empty-title")!;
  const emptyDesc = document.getElementById("empty-desc")!;
  const workoutName = document.getElementById("workoutName")!;
  const workoutDifficulty = document.getElementById("workoutDifficulty")!;
  const workoutDescription = document.getElementById("workoutDescription")!;
  const exercisesList = document.getElementById("exercisesList")!;
  const daysTabsContainer = document.getElementById("days-tabs-container")!;
  const activeDayLabel = document.getElementById("active-day-label")!;
  const completeWorkoutBtn = document.getElementById("completeWorkoutBtn")!;

  // Modales de Vídeo & Corrección
  const techniqueSubmitModal = document.getElementById("technique-submit-modal");
  const techniqueModalExerciseName = document.getElementById("technique-modal-exercise-name");
  const btnCloseTechniqueModal = document.getElementById("btn-close-technique-modal");
  const btnCancelTechnique = document.getElementById("btn-cancel-technique");
  const techniqueVideoDropzone = document.getElementById("techniqueVideoDropzone");
  const techniqueFileInput = document.getElementById("techniqueFileInput") as HTMLInputElement | null;
  const techniquePrompt = document.getElementById("techniquePrompt");
  const techniquePreviewContainer = document.getElementById("techniquePreviewContainer");
  const techniquePreviewVideo = document.getElementById("techniquePreviewVideo") as HTMLVideoElement | null;
  const btnRemoveTechniqueFile = document.getElementById("btn-remove-technique-file");
  const techniqueNotesInput = document.getElementById("technique-notes-input") as HTMLTextAreaElement | null;
  const btnSubmitTechniqueVideo = document.getElementById("btn-submit-technique-video") as HTMLButtonElement | null;
  const btnSubmitTechniqueText = document.getElementById("btn-submit-technique-text");

  // Reproductor Modal
  const videoModal = document.getElementById("video-modal");
  const videoModalTitle = document.getElementById("video-modal-title");
  const clientVideoPlayer = document.getElementById("client-video-player") as HTMLVideoElement | null;
  const btnCloseVideoModal = document.getElementById("btn-close-video-modal");

  // Historial de Correcciones
  const clientCorrectionsList = document.getElementById("client-corrections-list");
  const correctionsCountBadge = document.getElementById("corrections-count-badge");

  let unsubCatalog: (() => void) | null = null;
  let unsubPrefs: (() => void) | null = null;
  let unsubWorkouts: (() => void) | null = null;
  let unsubCorrections: (() => void) | null = null;

  let currentWorkout: Workout | null = null;
  let allCatalogExercises: ExerciseItem[] = [];
  let userPrefs: UserExercisePreferences | null = null;
  let activeUserUid = "";
  let activeUserName = "";
  let activeTrainerId = "";
  let currentUserMedicalProfile: MedicalProfile | null = null;
  let selectedDay = 1;
  let exerciseStatuses: Record<string, "completed" | "partial" | "skipped"> = {};

  let selectedTechniqueExercise: { id: string; name: string } | null = null;
  let selectedTechniqueFile: File | null = null;

  // Exclusion modal
  const exclusionModal = document.getElementById("exclusion-modal")!;
  const exclusionExerciseName = document.getElementById("exclusion-modal-exercise-name")!;
  const exclusionReasonsList = document.getElementById("exclusion-reasons-checklist")!;
  const exclusionCustomReason = document.getElementById("exclusion-custom-reason") as HTMLTextAreaElement;
  const btnCloseExclusion = document.getElementById("btn-close-exclusion");
  const btnCancelExclusion = document.getElementById("btn-cancel-exclusion");
  const btnConfirmExclusion = document.getElementById("btn-confirm-exclusion");
  let selectedExclusionExercise: { id: string; name: string; item?: ExerciseItem } | null = null;

  const dayKeys = [
    "common.day.monday",
    "common.day.tuesday",
    "common.day.wednesday",
    "common.day.thursday",
    "common.day.friday",
    "common.day.saturday",
    "common.day.sunday",
  ];

  // Controladores de modal de vídeo coach
  btnCloseVideoModal?.addEventListener("click", () => {
    if (clientVideoPlayer) {
      clientVideoPlayer.pause();
      clientVideoPlayer.src = "";
    }
    videoModal?.classList.add("hidden");
  });
  videoModal?.addEventListener("click", (e) => {
    if (e.target === videoModal) {
      if (clientVideoPlayer) {
        clientVideoPlayer.pause();
        clientVideoPlayer.src = "";
      }
      videoModal.classList.add("hidden");
    }
  });

  // Controladores de modal de subida de técnica
  function closeTechniqueModal() {
    techniqueSubmitModal?.classList.add("hidden");
    selectedTechniqueExercise = null;
    selectedTechniqueFile = null;
    if (techniqueFileInput) techniqueFileInput.value = "";
    if (techniqueNotesInput) techniqueNotesInput.value = "";
    techniquePrompt?.classList.remove("hidden");
    techniquePreviewContainer?.classList.add("hidden");
    if (techniquePreviewVideo) {
      techniquePreviewVideo.pause();
      techniquePreviewVideo.src = "";
    }
    if (btnSubmitTechniqueVideo) btnSubmitTechniqueVideo.disabled = true;
  }

  btnCloseTechniqueModal?.addEventListener("click", closeTechniqueModal);
  btnCancelTechnique?.addEventListener("click", closeTechniqueModal);
  techniqueSubmitModal?.addEventListener("click", (e) => {
    if (e.target === techniqueSubmitModal) closeTechniqueModal();
  });

  techniqueVideoDropzone?.addEventListener("click", () => {
    if (!selectedTechniqueFile) techniqueFileInput?.click();
  });

  techniqueFileInput?.addEventListener("change", () => {
    if (techniqueFileInput.files && techniqueFileInput.files[0]) {
      const file = techniqueFileInput.files[0];
      const val = validateMediaFile(file, 50);
      if (!val.valid) {
        showToast({ message: val.message || "Vídeo no válido", type: "error" });
        return;
      }

      selectedTechniqueFile = file;
      const objectUrl = URL.createObjectURL(file);
      if (techniquePreviewVideo) techniquePreviewVideo.src = objectUrl;

      techniquePrompt?.classList.add("hidden");
      techniquePreviewContainer?.classList.remove("hidden");
      if (btnSubmitTechniqueVideo) btnSubmitTechniqueVideo.disabled = false;
    }
  });

  btnRemoveTechniqueFile?.addEventListener("click", (e) => {
    e.stopPropagation();
    selectedTechniqueFile = null;
    if (techniqueFileInput) techniqueFileInput.value = "";
    techniquePrompt?.classList.remove("hidden");
    techniquePreviewContainer?.classList.add("hidden");
    if (techniquePreviewVideo) {
      techniquePreviewVideo.pause();
      techniquePreviewVideo.src = "";
    }
    if (btnSubmitTechniqueVideo) btnSubmitTechniqueVideo.disabled = true;
  });

  btnSubmitTechniqueVideo?.addEventListener("click", async () => {
    if (!selectedTechniqueFile || !selectedTechniqueExercise || !activeUserUid) return;

    try {
      btnSubmitTechniqueVideo.disabled = true;
      if (btnSubmitTechniqueText) btnSubmitTechniqueText.textContent = "Subiendo vídeo...";
      console.log('📹 [TechniqueVideo] Enviando vídeo de ejecución:', {
        ejercicio: selectedTechniqueExercise.name,
        archivo: selectedTechniqueFile.name,
        tamaño: `${(selectedTechniqueFile.size / (1024 * 1024)).toFixed(2)} MB`,
      });

      const notes = techniqueNotesInput?.value?.trim() || "";
      await submitTechniqueVideo({
        clientId: activeUserUid,
        clientName: activeUserName,
        trainerId: activeTrainerId || "default-trainer",
        workoutId: currentWorkout?.id || "general",
        workoutName: currentWorkout?.name || "Rutina",
        exerciseId: selectedTechniqueExercise.id,
        exerciseName: selectedTechniqueExercise.name,
        file: selectedTechniqueFile,
        notes,
      });

      console.log('✅ [TechniqueVideo] Vídeo enviado correctamente al entrenador');
      showToast({ message: "¡Vídeo enviado a tu entrenador con éxito!", type: "success" });
      closeTechniqueModal();
    } catch (err: unknown) {
      console.error('❌ [TechniqueVideo] Error al enviar vídeo:', err);
      const msg = err instanceof Error ? err.message : "Error al enviar el vídeo";
      showToast({ message: msg, type: "error" });
    } finally {
      if (btnSubmitTechniqueText) btnSubmitTechniqueText.textContent = "Enviar a mi Entrenador";
      if (btnSubmitTechniqueVideo) btnSubmitTechniqueVideo.disabled = false;
    }
  });

  function renderDayTabs(): void {
    const todayIndex = new Date().getDay();
    selectedDay = todayIndex === 0 ? 7 : todayIndex;

    daysTabsContainer.innerHTML = dayKeys
      .map((key, i) => {
        const dayNum = i + 1;
        const isToday = dayNum === selectedDay;
        const label = t(key).slice(0, 3).toUpperCase();
        return `
          <button
            type="button"
            data-day="${dayNum}"
            class="day-tab-btn flex flex-col items-center justify-center rounded-xl p-2 transition-all ${
              isToday
                ? "bg-[var(--brand)] text-[var(--text-on-brand)] font-bold shadow-lg shadow-[var(--shadow-glow-sm)] scale-105"
                : "border border-[var(--border-subtle)] bg-[var(--surface-3)] text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-4)]"
            }"
          >
            <span class="text-[10px] font-bold">${label}</span>
            <span class="text-xs font-mono font-bold">${dayNum}</span>
          </button>
        `;
      })
      .join("");

    updateActiveDayLabel();

    daysTabsContainer.querySelectorAll(".day-tab-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const day = Number((e.currentTarget as HTMLElement).getAttribute("data-day"));
        if (day) {
          selectedDay = day;
          daysTabsContainer.querySelectorAll(".day-tab-btn").forEach((b) => {
            b.className =
              "day-tab-btn flex flex-col items-center justify-center rounded-xl p-2 transition-all border border-[var(--border-subtle)] bg-[var(--surface-3)] text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-4)]";
          });
          (e.currentTarget as HTMLElement).className =
            "day-tab-btn flex flex-col items-center justify-center rounded-xl p-2 transition-all bg-[var(--brand)] text-[var(--text-on-brand)] font-bold shadow-lg shadow-[var(--shadow-glow-sm)] scale-105";

          updateActiveDayLabel();
          renderActiveWorkout();
        }
      });
    });
  }

  function updateActiveDayLabel(): void {
    const key = dayKeys[selectedDay - 1];
    if (activeDayLabel && key) {
      activeDayLabel.textContent = t(key);
    }
  }

  function updateSessionCounters(): void {
    let completed = 0, partial = 0, skipped = 0;
    Object.values(exerciseStatuses).forEach((st) => {
      if (st === "completed") completed++;
      if (st === "partial") partial++;
      if (st === "skipped") skipped++;
    });

    const elComp = document.getElementById("count-completed");
    const elPart = document.getElementById("count-partial");
    const elSkip = document.getElementById("count-skipped");
    if (elComp) elComp.textContent = String(completed);
    if (elPart) elPart.textContent = String(partial);
    if (elSkip) elSkip.textContent = String(skipped);
  }

  function openExclusionModal(exId: string, exName: string, item?: ExerciseItem) {
    selectedExclusionExercise = { id: exId, name: exName, item };
    exclusionExerciseName.textContent = exName;
    exclusionCustomReason.value = "";

    exclusionReasonsList.innerHTML = Object.entries(EXCLUSION_REASON_LABELS)
      .map(([key, label]) => `
        <label class="flex items-center gap-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] p-2.5 cursor-pointer hover:border-[var(--border-brand)] transition-all">
          <input type="checkbox" value="${key}" class="exclusion-checkbox accent-rose-500 rounded" />
          <span class="text-xs text-[var(--text-primary)]">${escapeHtml(label)}</span>
        </label>
      `)
      .join("");

    exclusionModal.classList.remove("hidden");
  }

  function closeExclusionModal() {
    exclusionModal.classList.add("hidden");
    selectedExclusionExercise = null;
  }

  btnCloseExclusion?.addEventListener("click", closeExclusionModal);
  btnCancelExclusion?.addEventListener("click", closeExclusionModal);

  btnConfirmExclusion?.addEventListener("click", async () => {
    if (!selectedExclusionExercise || !activeUserUid) return;

    const checkedBoxes = exclusionReasonsList.querySelectorAll(".exclusion-checkbox:checked");
    const reasons: ExclusionReason[] = Array.from(checkedBoxes).map(
      (cb) => (cb as HTMLInputElement).value as ExclusionReason
    );
    const customText = exclusionCustomReason.value.trim();

    if (reasons.length === 0 && !customText) {
      showToast({ message: "Por favor selecciona al menos un motivo o añade una descripción.", type: "error" });
      return;
    }

    try {
      btnConfirmExclusion.setAttribute("disabled", "true");
      btnConfirmExclusion.classList.add("opacity-50");

      const exItem = selectedExclusionExercise.item || {
        id: selectedExclusionExercise.id,
        translations: { es: selectedExclusionExercise.name, en: selectedExclusionExercise.name, ca: selectedExclusionExercise.name },
        searchIndex: [],
        muscleGroups: [],
        category: "strength" as const,
        equipment: [],
        difficulty: "intermediate" as const,
        defaultSets: 3,
        defaultReps: 10,
        defaultRestSeconds: 60,
        tags: [],
        isActive: true,
        createdBy: "system",
        createdAt: null,
        updatedAt: null,
      };

      await requestExerciseExclusion(
        activeUserUid,
        activeUserName,
        activeTrainerId,
        exItem,
        reasons,
        customText
      );

      showToast({ message: "✅ Solicitud enviada a tu entrenador exitosamente.", type: "success" });
      closeExclusionModal();
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : "Error al enviar la solicitud.";
      showToast({ message: msg, type: "error" });
    } finally {
      btnConfirmExclusion.removeAttribute("disabled");
      btnConfirmExclusion.classList.remove("opacity-50");
    }
  });

  function renderCorrectionsHistory(corrections: ExerciseCorrection[]) {
    if (!clientCorrectionsList) return;
    if (correctionsCountBadge) {
      correctionsCountBadge.textContent = `${corrections.length} ${corrections.length === 1 ? "enviada" : "enviadas"}`;
    }

    if (corrections.length === 0) {
      clientCorrectionsList.innerHTML = `<p class="text-xs text-[var(--text-disabled)] text-center py-4">No has enviado vídeos de técnica aún. Usa el botón "📹 Enviar Vídeo" en cualquier ejercicio de tu rutina.</p>`;
      return;
    }

    clientCorrectionsList.innerHTML = corrections.map((c) => {
      const isReviewed = c.status === "reviewed";
      const dateStr = c.createdAt && typeof (c.createdAt as { toDate?: () => Date }).toDate === "function"
        ? (c.createdAt as { toDate: () => Date }).toDate().toLocaleDateString()
        : "Reciente";

      return `
        <div class="rounded-xl border ${isReviewed ? 'border-emerald-500/30 bg-emerald-500/5' : 'border-[var(--border-subtle)] bg-[var(--surface-3)]'} p-3.5 space-y-2.5 transition-all">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <span class="font-bold text-xs text-[var(--text-primary)]">${escapeHtml(c.exerciseName)}</span>
              <span class="text-[10px] text-[var(--text-tertiary)]">(${escapeHtml(c.workoutName)})</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="rounded-full px-2 py-0.5 text-[10px] font-bold ${isReviewed ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-300 border border-amber-500/30'}">
                ${isReviewed ? '✅ Revisado por tu Coach' : '⏳ En Revisión'}
              </span>
              <button type="button" class="btn-play-my-corr text-xs text-[var(--brand)] hover:underline font-semibold" data-video-url="${escapeHtml(c.videoUrl)}" data-title="Mi ejecución: ${escapeHtml(c.exerciseName)}">
                ▶️ Ver vídeo
              </button>
              <button type="button" class="btn-delete-my-corr text-xs text-rose-400 hover:text-rose-300 font-semibold p-1 hover:bg-rose-500/10 rounded-md transition-all" data-corr-id="${escapeHtml(c.id)}" title="Eliminar grabación">
                🗑️
              </button>
            </div>
          </div>

          ${c.clientNotes ? `<p class="text-[11px] text-zinc-400 italic">"Tu nota: ${escapeHtml(c.clientNotes)}"</p>` : ''}

          ${isReviewed && c.trainerFeedback ? `
            <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/20 p-2.5 text-xs text-emerald-200">
              <div class="font-bold flex items-center gap-1 mb-1">
                <span>💬 Feedback de tu Coach:</span>
              </div>
              <p>${escapeHtml(c.trainerFeedback)}</p>
            </div>
          ` : !isReviewed ? `
            <p class="text-[10px] text-amber-400/80">Tu entrenador ha recibido la grabación y te responderá pronto con correcciones de técnica.</p>
          ` : ''}
        </div>
      `;
    }).join("");

    clientCorrectionsList.querySelectorAll(".btn-play-my-corr").forEach((btn) => {
      btn.addEventListener("click", () => {
        const url = (btn as HTMLElement).dataset.videoUrl;
        const title = (btn as HTMLElement).dataset.title;
        if (url && videoModal && clientVideoPlayer) {
          clientVideoPlayer.src = url;
          if (videoModalTitle) videoModalTitle.textContent = title || "Mi vídeo de técnica";
          videoModal.classList.remove("hidden");
          clientVideoPlayer.play().catch(() => {});
        }
      });
    });

    clientCorrectionsList.querySelectorAll(".btn-delete-my-corr").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const corrId = (btn as HTMLElement).dataset.corrId;
        if (!corrId) return;

        const confirmed = await showConfirm({
          title: '¿Eliminar vídeo de técnica?',
          message: '¿Estás seguro de que deseas eliminar este vídeo enviado? Tu entrenador ya no lo verá en su lista.',
          confirmText: 'Sí, eliminar',
          cancelText: 'Cancelar',
          variant: 'danger',
        });

        if (confirmed) {
          try {
            await deleteTechniqueCorrection(corrId);
            showToast({ message: 'Vídeo de técnica eliminado correctamente', type: 'success' });
          } catch (err) {
            showToast({ message: 'Error al eliminar el vídeo', type: 'error' });
          }
        }
      });
    });
  }

  function renderActiveWorkout(): void {
    if (!currentWorkout) {
      workoutCard.classList.add("hidden");
      emptyState.classList.remove("hidden");
      emptyTitle.textContent = t("client.no.workout");
      emptyDesc.textContent = t("client.workout.assigned.desc");
      return;
    }

    workoutName.textContent = currentWorkout.name;
    workoutDifficulty.textContent = currentWorkout.difficulty || "Intermedio";
    workoutDescription.textContent = currentWorkout.description || "";

    const dayExercises = (currentWorkout.exercises || []).filter(
      (ex) => !ex.dayOfWeek || ex.dayOfWeek === 0 || ex.dayOfWeek === selectedDay
    );

    if (dayExercises.length === 0) {
      workoutCard.classList.add("hidden");
      emptyState.classList.remove("hidden");
      const dayKey = dayKeys[selectedDay - 1];
      emptyTitle.textContent = `${t("client.restDay")} (${dayKey ? t(dayKey) : ""})`;
      emptyDesc.textContent = t("client.restDayDesc");
      return;
    }

    workoutCard.classList.remove("hidden");
    emptyState.classList.add("hidden");

    exercisesList.innerHTML = dayExercises
      .map((ex, i) => {
        const status = exerciseStatuses[ex.id] || "completed";
        const catalogEx = allCatalogExercises.find((c) => c.id === ex.id || c.translations.es === ex.name);
        const localizedName = catalogEx ? getExerciseName(catalogEx, "es") : ex.name;
        const currentRating = (userPrefs?.ratings && userPrefs.ratings[ex.id]) || 0;
        const isFavorite = (userPrefs?.favorites && userPrefs.favorites.includes(ex.id)) || false;
        const isExcluded = (userPrefs?.excluded && userPrefs.excluded.includes(ex.id)) || false;

        const muscleTags = catalogEx?.muscleGroups?.map((m) => t(`muscle.${m}`) || m).join(", ") || "";
        const injuryAudit = checkExerciseInjuryConflicts(catalogEx || ex, currentUserMedicalProfile);

        return `
          <div class="exercise-card rounded-xl border ${injuryAudit.hasConflict ? 'border-amber-500/40 bg-amber-500/5' : 'border-[var(--border-subtle)] bg-[var(--surface-2)]'} p-4 space-y-3 animate-fade-in" data-ex-id="${ex.id}">
            <div class="flex items-start justify-between gap-3 flex-wrap">
              <div class="flex items-start gap-2.5">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--brand-dim)] text-xs font-bold text-[var(--brand)]">${i + 1}</span>
                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <h4 class="font-bold text-sm text-[var(--text-primary)]">${escapeHtml(localizedName)}</h4>
                    ${muscleTags ? `<span class="text-[10px] rounded-full bg-[var(--surface-3)] px-2 py-0.5 text-[var(--text-tertiary)] border border-[var(--border-subtle)]">${escapeHtml(muscleTags)}</span>` : ""}
                    ${isFavorite ? `<span class="text-amber-400 text-xs" title="Favorito">⭐</span>` : ""}
                    ${isExcluded ? `<span class="text-[10px] bg-rose-500/20 text-rose-400 px-2 py-0.5 rounded-full font-semibold">🚫 Exclusión solicitada</span>` : ""}
                  </div>
                  ${ex.description ? `<p class="mt-0.5 text-xs text-[var(--text-tertiary)]">${escapeHtml(ex.description)}</p>` : ""}
                </div>
              </div>

              <!-- Status toggles -->
              <div class="flex items-center gap-1 bg-[var(--surface-3)] p-1 rounded-xl border border-[var(--border-subtle)] text-[11px] font-medium shrink-0">
                <button
                  type="button"
                  data-status-btn="completed"
                  class="status-btn px-2 py-1 rounded-lg transition-all ${status === "completed" ? "bg-emerald-500 text-white font-bold shadow" : "text-[var(--text-tertiary)] hover:text-white"}"
                >
                  ✅ 100%
                </button>
                <button
                  type="button"
                  data-status-btn="partial"
                  class="status-btn px-2 py-1 rounded-lg transition-all ${status === "partial" ? "bg-amber-500 text-white font-bold shadow" : "text-[var(--text-tertiary)] hover:text-white"}"
                >
                  ⚠️ Parcial
                </button>
                <button
                  type="button"
                  data-status-btn="skipped"
                  class="status-btn px-2 py-1 rounded-lg transition-all ${status === "skipped" ? "bg-red-500 text-white font-bold shadow" : "text-[var(--text-tertiary)] hover:text-white"}"
                >
                  ❌ Omitir
                </button>
              </div>
            </div>

            <!-- Advertencia Médica de Lesión -->
            ${injuryAudit.hasConflict ? `
              <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 p-3 text-xs text-amber-300 space-y-1">
                <div class="font-bold flex items-center gap-1.5 text-amber-400">
                  <span>⚠️</span>
                  <span>Alerta de Salud: Posible molestia en ${escapeHtml(injuryAudit.conflicts[0]?.affectedZone || "zona articular")}</span>
                </div>
                <p class="text-[11px] text-amber-200/90">${escapeHtml(injuryAudit.conflicts[0]?.warningMessage || "")}</p>
                <p class="text-[10px] text-amber-300/70 italic">${escapeHtml(injuryAudit.conflicts[0]?.recommendation || "")}</p>
              </div>
            ` : ''}

            <!-- Target metrics -->
            <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--text-tertiary)]">
              <span><span data-i18n="workout.target">${t("workout.target")}</span> <strong class="text-[var(--text-primary)]">${ex.sets} ${t("workout.sets")} × ${ex.reps} ${t("workout.reps")}</strong></span>
              <span>•</span>
              <span><span data-i18n="workout.rest">${t("workout.rest")}</span>: <strong class="text-[var(--text-primary)]">${ex.restTime || "60s"}</strong></span>
            </div>

            <!-- Feedback & Rating Bar -->
            <div class="flex items-center justify-between flex-wrap gap-2 pt-2 border-t border-[var(--border-subtle)] text-xs">
              <div class="flex items-center gap-2">
                <span class="text-[11px] text-[var(--text-tertiary)]">Tu valoración:</span>
                <div class="rating-stars flex items-center gap-1" data-ex-id="${ex.id}">
                  ${[1, 2, 3, 4, 5].map((star) => `
                    <button
                      type="button"
                      class="star-btn text-base transition-transform hover:scale-125 ${star <= currentRating ? "text-amber-400" : "text-[var(--text-disabled)]"}"
                      data-star="${star}"
                    >
                      ★
                    </button>
                  `).join("")}
                </div>
              </div>

              <div class="flex items-center gap-2">
                <button
                  type="button"
                  class="btn-toggle-fav px-2.5 py-1 rounded-lg text-xs font-semibold border transition-all ${isFavorite ? "border-amber-500/40 bg-amber-500/10 text-amber-400" : "border-[var(--border-subtle)] bg-[var(--surface-3)] text-[var(--text-tertiary)] hover:text-amber-400"}"
                  data-ex-id="${ex.id}"
                >
                  ⭐ ${isFavorite ? "Favorito" : "Marcar favorito"}
                </button>

                <button
                  type="button"
                  class="btn-request-exclude px-2.5 py-1 rounded-lg text-xs font-medium border border-rose-500/30 bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 transition-all"
                  data-ex-id="${ex.id}"
                  data-ex-name="${escapeHtml(localizedName)}"
                >
                  🚫 Excluir
                </button>
              </div>
            </div>

            <!-- Execution inputs -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2 pt-2 border-t border-[var(--border-subtle)] text-xs">
              <div>
                <label data-i18n="workout.actualWeight" class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">${t("workout.actualWeight")}</label>
                <input type="number" data-ex-field="actualWeight" placeholder="0" class="w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2 py-1 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]" />
              </div>
              <div>
                <label data-i18n="workout.actualReps" class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">${t("workout.actualReps")}</label>
                <input type="number" data-ex-field="actualReps" value="${ex.reps || 10}" class="w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2 py-1 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]" />
              </div>
              <div>
                <label class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">RPE (1-10)</label>
                <input type="number" data-ex-field="rpe" min="1" max="10" value="7" class="w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2 py-1 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--border-brand)]" />
              </div>
              <div>
                <label data-i18n="workout.exerciseNotes" class="block text-[10px] text-[var(--text-tertiary)] mb-0.5">${t("workout.exerciseNotes")}</label>
                <input type="text" data-ex-field="notes" placeholder="Ej: Aumenté carga" class="w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] px-2 py-1 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)]" />
              </div>
            </div>

            <!-- Botones de Técnica & Corrección de Vídeo (Cloudflare R2) -->
            <div class="flex items-center justify-between flex-wrap gap-2 pt-2 border-t border-[var(--border-subtle)]">
              <div class="flex items-center gap-2 flex-wrap">
                ${ex.videoUrl ? `
                  <button
                    type="button"
                    class="btn-watch-technique px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-500/15 border border-amber-500/30 text-amber-300 hover:bg-amber-500/25 transition-all flex items-center gap-1.5"
                    data-video-url="${escapeHtml(ex.videoUrl)}"
                    data-name="${escapeHtml(localizedName)}"
                  >
                    <span>▶️ Ver Técnica del Coach</span>
                  </button>
                ` : ""}
                <button
                  type="button"
                  class="btn-open-technique-modal px-2.5 py-1 rounded-lg text-xs font-bold bg-purple-500/15 border border-purple-500/30 text-purple-300 hover:bg-purple-500/25 transition-all flex items-center gap-1.5"
                  data-ex-id="${ex.id}"
                  data-ex-name="${escapeHtml(localizedName)}"
                >
                  <span>📹 Enviar Vídeo de mi Técnica</span>
                </button>
              </div>
            </div>
          </div>
        `;
      })
      .join("");

    // Ver vídeo de técnica del coach
    exercisesList.querySelectorAll(".btn-watch-technique").forEach((btn) => {
      btn.addEventListener("click", () => {
        const url = (btn as HTMLElement).dataset.videoUrl;
        const name = (btn as HTMLElement).dataset.name;
        if (url && videoModal && clientVideoPlayer) {
          clientVideoPlayer.src = url;
          if (videoModalTitle) videoModalTitle.textContent = `Técnica del Coach: ${name || "Ejercicio"}`;
          videoModal.classList.remove("hidden");
          clientVideoPlayer.play().catch(() => {});
        }
      });
    });

    // Abrir modal de envío de vídeo de técnica del alumno
    exercisesList.querySelectorAll(".btn-open-technique-modal").forEach((btn) => {
      btn.addEventListener("click", () => {
        const exId = (btn as HTMLElement).dataset.exId!;
        const exName = (btn as HTMLElement).dataset.exName!;
        selectedTechniqueExercise = { id: exId, name: exName };
        if (techniqueModalExerciseName) techniqueModalExerciseName.textContent = exName;
        techniqueSubmitModal?.classList.remove("hidden");
      });
    });

    // Star rating click handler
    exercisesList.querySelectorAll(".star-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const starVal = Number((e.currentTarget as HTMLElement).getAttribute("data-star")) as 1|2|3|4|5;
        const exId = (e.currentTarget as HTMLElement).closest(".rating-stars")?.getAttribute("data-ex-id");
        if (exId && activeUserUid && starVal) {
          const ok = await rateExercise(activeUserUid, exId, starVal);
          if (ok) {
            showToast({ message: `⭐ Calificación de ${starVal} estrellas guardada`, type: "success" });
          }
        }
      });
    });

    // Favorite toggle handler
    exercisesList.querySelectorAll(".btn-toggle-fav").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const exId = (e.currentTarget as HTMLElement).getAttribute("data-ex-id");
        if (exId && activeUserUid) {
          const ok = await toggleFavorite(activeUserUid, exId);
          if (ok) {
            showToast({ message: "⭐ Preferencia de favorito actualizada", type: "success" });
          }
        }
      });
    });

    // Exclusion request handler
    exercisesList.querySelectorAll(".btn-request-exclude").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const exId = (e.currentTarget as HTMLElement).getAttribute("data-ex-id")!;
        const exName = (e.currentTarget as HTMLElement).getAttribute("data-ex-name")!;
        const catalogItem = allCatalogExercises.find((c) => c.id === exId);
        openExclusionModal(exId, exName, catalogItem);
      });
    });

    exercisesList.querySelectorAll(".exercise-card").forEach((card) => {
      const exId = card.getAttribute("data-ex-id")!;
      if (!exerciseStatuses[exId]) exerciseStatuses[exId] = "completed";

      card.querySelectorAll("[data-status-btn]").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const st = (e.currentTarget as HTMLElement).getAttribute("data-status-btn") as "completed" | "partial" | "skipped";
          exerciseStatuses[exId] = st;

          card.querySelectorAll("[data-status-btn]").forEach((b) => {
            b.className = "status-btn px-2 py-1 rounded-lg transition-all text-[var(--text-tertiary)] hover:text-white";
          });
          const targetBtn = e.currentTarget as HTMLElement;
          if (st === "completed") {
            targetBtn.className = "status-btn px-2 py-1 rounded-lg transition-all bg-emerald-500 text-white font-bold shadow scale-105";
            showToast({ message: "🎉 " + (t("workout.goodJob") || "¡Buen trabajo! Ejercicio completado"), type: "success" });
          }
          if (st === "partial") targetBtn.className = "status-btn px-2 py-1 rounded-lg transition-all bg-amber-500 text-white font-bold shadow";
          if (st === "skipped") targetBtn.className = "status-btn px-2 py-1 rounded-lg transition-all bg-red-500 text-white font-bold shadow";

          updateSessionCounters();
        });
      });
    });

    updateSessionCounters();
  }

  const cleanup = initPage({
    allowedRoles: ["client", "admin", "trainer"],
    onReady: async (firebaseUser, userData) => {
      activeUserUid = firebaseUser.uid;
      activeUserName = userData?.name || "Cliente";
      activeTrainerId = userData?.assignedTrainerId || "";
      currentUserMedicalProfile = userData?.medicalProfile || null;
      renderDayTabs();

      // Suscribirse al catálogo de ejercicios
      unsubCatalog = subscribeToExercises((exercises) => {
        allCatalogExercises = exercises;
        if (currentWorkout) renderActiveWorkout();
      });

      // Suscribirse a las preferencias del usuario
      unsubPrefs = subscribeToUserExercisePreferences(firebaseUser.uid, (prefs) => {
        userPrefs = prefs;
        if (currentWorkout) renderActiveWorkout();
      });

      // Suscribirse a las rutinas
      unsubWorkouts = subscribeToWorkouts(firebaseUser.uid, (workouts) => {
        loadingScreen.classList.add("hidden");
        workoutsContent.classList.remove("hidden");

        if (workouts.length > 0 && workouts[0]) {
          currentWorkout = workouts[0];
          exerciseStatuses = {};
          (currentWorkout.exercises || []).forEach((ex) => {
            exerciseStatuses[ex.id] = "completed";
          });
        } else {
          currentWorkout = null;
        }
        renderActiveWorkout();
      });

      // Suscribirse al historial de correcciones del alumno
      unsubCorrections = subscribeToCorrectionsByClient(firebaseUser.uid, (corrections) => {
        renderCorrectionsHistory(corrections);
      });

      // Suscribirse a las propuestas de personalización del alumno
      unsubProposals = subscribeToClientProposals(firebaseUser.uid, (proposals) => {
        const workoutProposal = proposals.find((p) => p.type === "workout");
        renderProposalStatus(workoutProposal);
      });
    },
  });

  // Modal de propuesta de personalización
  const proposalModal = document.getElementById("customize-workout-modal") as HTMLDivElement;
  const btnOpenProposal = document.getElementById("btn-open-proposal-modal") as HTMLButtonElement;
  const btnCloseProposal = document.getElementById("btn-close-proposal-modal") as HTMLButtonElement;
  const btnCancelProposal = document.getElementById("btn-cancel-proposal-modal") as HTMLButtonElement;
  const btnSubmitProposal = document.getElementById("btn-submit-workout-proposal") as HTMLButtonElement;

  // Selector de Enfoque y Recomendaciones Atléticas
  const focusRadios = document.querySelectorAll('input[name="athletic-focus"]') as NodeListOf<HTMLInputElement>;
  const sportSelectorContainer = document.getElementById("sport-selector-container") as HTMLDivElement;
  const sportSelect = document.getElementById("proposal-sport-select") as HTMLSelectElement;
  const recTitle = document.getElementById("rec-title");
  const recPriorityMuscles = document.getElementById("rec-priority-muscles");
  const recBiomechanicalAdvice = document.getElementById("rec-biomechanical-advice");

  function getSelectedFocus(): AthleticFocusType {
    const checked = document.querySelector('input[name="athletic-focus"]:checked') as HTMLInputElement;
    return (checked?.value as AthleticFocusType) || "balanced";
  }

  function updateAthleticRecommendationUI() {
    const focus = getSelectedFocus();
    const sport = (sportSelect?.value as AthleticSport) || "football";

    if (focus === "sport_performance") {
      sportSelectorContainer?.classList.remove("hidden");
    } else {
      sportSelectorContainer?.classList.add("hidden");
    }

    // Update active card styling
    document.querySelectorAll(".focus-option-card").forEach((card) => {
      const input = card.querySelector("input") as HTMLInputElement;
      if (input.checked) {
        card.className = "focus-option-card flex flex-col p-2.5 rounded-xl border border-[var(--border-brand)] bg-[var(--brand-dim)] cursor-pointer hover:border-[var(--brand)] transition-all";
        const title = card.querySelector(".text-xs");
        if (title) title.className = "text-xs font-bold text-[var(--brand)]";
      } else {
        card.className = "focus-option-card flex flex-col p-2.5 rounded-xl border border-zinc-700 bg-zinc-800/40 cursor-pointer hover:border-[var(--brand)] transition-all";
        const title = card.querySelector(".text-xs");
        if (title) title.className = "text-xs font-bold text-white";
      }
    });

    const rec = getAthleticRecommendation(focus, sport);
    if (recTitle) recTitle.textContent = rec.title;
    if (recBiomechanicalAdvice) recBiomechanicalAdvice.textContent = rec.biomechanicalAdvice;

    if (recPriorityMuscles) {
      recPriorityMuscles.innerHTML = rec.priorityMuscles
        .map((m) => {
          const label = MUSCLE_SPANISH_LABELS[m] || m;
          return `<span class="rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/30 px-2 py-0.5 text-[10px] font-semibold">${label}</span>`;
        })
        .join("");
    }
  }

  focusRadios.forEach((radio) => {
    radio.addEventListener("change", updateAthleticRecommendationUI);
  });
  sportSelect?.addEventListener("change", updateAthleticRecommendationUI);
  updateAthleticRecommendationUI();

  btnOpenProposal?.addEventListener("click", () => {
    if (!activeTrainerId) {
      showToast({ message: "Aún no tienes un entrenador asignado para revisar tu propuesta.", type: "info" });
      return;
    }
    updateAthleticRecommendationUI();
    proposalModal?.classList.remove("hidden");
  });

  const closeProposalModal = () => proposalModal?.classList.add("hidden");
  btnCloseProposal?.addEventListener("click", closeProposalModal);
  btnCancelProposal?.addEventListener("click", closeProposalModal);

  function renderProposalStatus(proposal?: PlanProposal) {
    const banner = document.getElementById("proposal-status-banner");
    const desc = document.getElementById("proposal-banner-desc");
    const statusBadge = document.getElementById("proposal-banner-status");
    const feedbackBox = document.getElementById("proposal-banner-feedback");
    const feedbackText = document.getElementById("proposal-feedback-text");

    if (!banner || !proposal) {
      banner?.classList.add("hidden");
      return;
    }

    if (proposal.status === "pending_review") {
      banner.classList.remove("hidden");
      if (statusBadge) {
        statusBadge.textContent = "Pendiente";
        statusBadge.className = "rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/40 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider";
      }
      if (desc) desc.textContent = `Propuesta enviada. Días propuestos: ${(proposal.proposedSchedule?.scheduledDays || []).join(", ")}.`;
      feedbackBox?.classList.add("hidden");
    } else if (proposal.status === "changes_requested") {
      banner.classList.remove("hidden");
      if (statusBadge) {
        statusBadge.textContent = "Cambios Sugeridos";
        statusBadge.className = "rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider";
      }
      if (desc) desc.textContent = "Tu entrenador ha revisado tu propuesta y te ha dejado recomendaciones.";
      if (proposal.trainerFeedback && feedbackBox && feedbackText) {
        feedbackBox.classList.remove("hidden");
        feedbackText.textContent = proposal.trainerFeedback;
      }
    } else {
      banner.classList.add("hidden");
    }
  }

  btnSubmitProposal?.addEventListener("click", async () => {
    if (!activeUserUid || !activeTrainerId) return;

    const checkedBoxes = Array.from(document.querySelectorAll(".day-proposal-cb:checked")) as HTMLInputElement[];
    const scheduledDays = checkedBoxes.map((cb) => parseInt(cb.value));
    const timeVal = (document.getElementById("proposal-workout-time") as HTMLInputElement).value;
    const notesVal = (document.getElementById("proposal-workout-notes") as HTMLTextAreaElement).value.trim();

    if (scheduledDays.length === 0) {
      showToast({ message: "Selecciona al menos un día para tu entrenamiento.", type: "error" });
      return;
    }

    try {
      btnSubmitProposal.disabled = true;
      const btnText = document.getElementById("btn-submit-workout-proposal-text");
      if (btnText) btnText.textContent = "Enviando propuesta...";

      const athleticFocusType = getSelectedFocus();
      const athleticSport = (sportSelect?.value as AthleticSport) || "football";
      const athleticRec = getAthleticRecommendation(athleticFocusType, athleticSport);

      await createPlanProposal({
        clientId: activeUserUid,
        clientName: activeUserName,
        trainerId: activeTrainerId,
        type: "workout",
        clientNotes: notesVal,
        proposedSchedule: {
          scheduledDays,
          estimatedTimes: { workoutTime: timeVal },
        },
        proposedData: {
          name: currentWorkout?.name ? `${currentWorkout.name} (Personalizado)` : "Rutina Personalizada",
          scheduledDays,
          scheduledTime: timeVal,
          athleticFocus: {
            focusType: athleticFocusType,
            sport: athleticFocusType === "sport_performance" ? athleticSport : undefined,
            priorityMuscles: athleticRec.priorityMuscles,
            title: athleticRec.title,
            biomechanicalAdvice: athleticRec.biomechanicalAdvice,
          },
          exercises: currentWorkout?.exercises || [],
        },
        originalPlanId: currentWorkout?.id,
      });

      showToast({ message: "¡Propuesta de rutina y enfoque atlético enviada a tu entrenador!", type: "success" });
      closeProposalModal();
    } catch {
      showToast({ message: "Error al enviar la propuesta.", type: "error" });
    } finally {
      btnSubmitProposal.disabled = false;
      const btnText = document.getElementById("btn-submit-workout-proposal-text");
      if (btnText) btnText.textContent = "Enviar propuesta a mi entrenador";
    }
  });

  completeWorkoutBtn?.addEventListener("click", async () => {
    if (!currentWorkout || !activeUserUid) return;

    const rpeVal = parseInt((document.getElementById("session-rpe") as HTMLSelectElement).value) || 7;
    const notesVal = (document.getElementById("session-notes") as HTMLInputElement).value.trim();

    const dayExercises = (currentWorkout.exercises || []).filter(
      (ex) => !ex.dayOfWeek || ex.dayOfWeek === 0 || ex.dayOfWeek === selectedDay
    );

    const logs: ExerciseExecutionLog[] = dayExercises.map((ex) => {
      const card = document.querySelector(`.exercise-card[data-ex-id="${ex.id}"]`);
      const weight = parseFloat((card?.querySelector('[data-ex-field="actualWeight"]') as HTMLInputElement)?.value) || 0;
      const reps = parseInt((card?.querySelector('[data-ex-field="actualReps"]') as HTMLInputElement)?.value) || ex.reps || 10;
      const exRpe = parseInt((card?.querySelector('[data-ex-field="rpe"]') as HTMLInputElement)?.value) || rpeVal;
      const exNotes = (card?.querySelector('[data-ex-field="notes"]') as HTMLInputElement)?.value.trim() || "";

      return {
        exerciseId: ex.id,
        exerciseName: ex.name,
        status: exerciseStatuses[ex.id] || "completed",
        actualWeight: weight,
        actualReps: reps,
        rpe: exRpe,
        notes: exNotes,
      };
    });

    try {
      showToast({ message: t("diet.editor.saving") || "Guardando sesión...", type: "info" });
      await logWorkoutSession({
        clientId: activeUserUid,
        workoutId: currentWorkout.id,
        workoutName: currentWorkout.name,
        dayOfWeek: selectedDay,
        status: "completed",
        overallRpe: rpeVal,
        notes: notesVal,
        exercises: logs,
      });

      showToast({ message: "¡Sesión de entrenamiento registrada con éxito! 💪", type: "success" });
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : "Error al registrar entrenamiento";
      showToast({ message: msg, type: "error" });
    }
  });

  let unsubProposals: (() => void) | null = null;

  document.addEventListener("astro:before-swap", () => {
