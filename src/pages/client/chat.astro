---
import ClientLayout from "@/layouts/ClientLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<ClientLayout>
  <!-- Loading Screen -->
  <div id="loadingScreen" class="flex min-h-screen items-center justify-center">
    <div class="text-center animate-fade-in">
      <div class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-[var(--border-strong)] border-t-emerald-400"></div>
      <p id="loadingText" class="mt-4 text-sm text-[var(--text-tertiary)]">{t("dashboard.loading")}</p>
    </div>
  </div>

  <!-- Chat Content Container -->
  <div id="chatContent" class="hidden">
    <main class="mx-auto max-w-4xl px-4 py-6">
      <div class="animate-fade-in space-y-4">
        
        <!-- Header del Entrenador Asignado -->
        <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl flex items-center justify-between flex-wrap gap-3">
          <div class="flex items-center gap-3">
            <div id="trainerAvatar" class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-[var(--brand)] to-emerald-400 text-lg font-bold text-white shadow-md">
              💬
            </div>
            <div>
              <h2 id="trainerName" class="text-base font-bold text-[var(--text-primary)]">{t("client.assignedTrainer")}</h2>
              <p id="trainerStatus" class="text-xs text-[var(--brand)] font-semibold">{t("common.loading")}</p>
            </div>
          </div>
          <span data-i18n="client.chatOnline" class="rounded-full bg-[var(--brand-dim)] px-3 py-1 text-xs font-bold text-[var(--brand)] border border-[var(--border-brand)]">
            {t("client.chatOnline")}
          </span>
        </div>

        <!-- Caja de Mensajes -->
        <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl flex flex-col h-[540px]">
          <!-- Contenedor Scrollable de Mensajes -->
          <div id="messagesContainer" class="flex-1 overflow-y-auto space-y-3 pr-2 scrollbar-thin scrollbar-thumb-zinc-700">
            <div class="flex justify-center pt-8">
              <p data-i18n="chat.loading" class="text-sm text-[var(--text-tertiary)] font-medium">{t("chat.loading")}</p>
            </div>
          </div>

          <!-- Preview de archivo adjunto antes de enviar -->
          <div id="attachment-preview" class="hidden p-2 bg-[var(--surface-3)] rounded-xl border border-[var(--border-subtle)] flex items-center justify-between gap-3 text-xs mb-2">
            <div class="flex items-center gap-2 truncate">
              <span id="attachment-preview-icon">📎</span>
              <span id="attachment-preview-name" class="truncate font-semibold text-[var(--text-primary)]"></span>
            </div>
            <button id="btn-remove-attachment" type="button" class="text-rose-400 font-bold hover:underline">&times; Quitar</button>
          </div>

          <!-- Formulario de Envío de Mensaje -->
          <div class="pt-3 border-t border-[var(--border-subtle)] mt-1">
            <form id="chatForm" class="flex items-center gap-2">
              <input type="file" id="chatFileInput" accept="image/*,video/*" class="hidden" />
              <button
                type="button"
                id="btnAttachMedia"
                class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-3 py-2.5 text-sm text-[var(--text-tertiary)] hover:text-[var(--brand)] hover:border-[var(--border-brand)] transition-all"
                title="Adjuntar foto o vídeo de postura"
              >
                📎
              </button>
              <input
                id="chatInput"
                type="text"
                placeholder={t("chat.placeholderTrainer")}
                class="flex-1 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-4 py-2.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--border-brand)] transition-all"
                autocomplete="off"
              />
              <button
                id="sendBtn"
                type="submit"
                class="flex items-center justify-center gap-1.5 rounded-xl bg-[var(--brand)] px-5 py-2.5 text-xs font-bold text-[var(--text-on-brand)] shadow-md transition-all hover:opacity-90 active:scale-95 disabled:opacity-50"
              >
                <span data-i18n="chat.send">{t("chat.send")}</span>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                </svg>
              </button>
            </form>
          </div>
        </div>

      </div>
    </main>
  </div>
</ClientLayout>

<script>
  import { auth, db } from "@/lib/firebase";
  import { onAuthStateChanged } from "firebase/auth";
  import { doc, getDoc, collection, query, where, orderBy, onSnapshot, addDoc, updateDoc, serverTimestamp } from "firebase/firestore";
  import { t } from "@/i18n/client";
  import { escapeHtml } from "@/lib/shared/ui";
  import { setUser } from "@/stores/authStore";
  import { uploadChatMedia } from "@/lib/storage/r2Service";
  import { showLocalNotification } from "@/lib/notifications/notificationService";

  const loadingScreen = document.getElementById("loadingScreen")!;
  const loadingText = document.getElementById("loadingText")!;
  const chatContent = document.getElementById("chatContent")!;
  const messagesContainer = document.getElementById("messagesContainer")!;
  const chatForm = document.getElementById("chatForm") as HTMLFormElement;
  const chatInput = document.getElementById("chatInput") as HTMLInputElement;
  const sendBtn = document.getElementById("sendBtn") as HTMLButtonElement;
  const trainerAvatar = document.getElementById("trainerAvatar")!;
  const trainerName = document.getElementById("trainerName")!;
  const trainerStatus = document.getElementById("trainerStatus")!;

  const btnAttachMedia = document.getElementById("btnAttachMedia") as HTMLButtonElement;
  const chatFileInput = document.getElementById("chatFileInput") as HTMLInputElement;
  const attachmentPreview = document.getElementById("attachment-preview")!;
  const attachmentPreviewName = document.getElementById("attachment-preview-name")!;
  const btnRemoveAttachment = document.getElementById("btn-remove-attachment")!;

  let selectedFile: File | null = null;
  let currentUserData: any = null;

  loadingText.textContent = t("dashboard.loading");

  let unsubMessages: (() => void) | null = null;
  let activeTrainerId = "admin";
  let hasInitialLoaded = false;

  btnAttachMedia?.addEventListener("click", () => {
    chatFileInput?.click();
  });

  chatFileInput?.addEventListener("change", () => {
    if (chatFileInput.files && chatFileInput.files[0]) {
      selectedFile = chatFileInput.files[0];
      attachmentPreviewName.textContent = selectedFile.name;
      attachmentPreview.classList.remove("hidden");
    }
  });

  btnRemoveAttachment?.addEventListener("click", () => {
    selectedFile = null;
    chatFileInput.value = "";
    attachmentPreview.classList.add("hidden");
  });

  const unsubscribeAuth = onAuthStateChanged(auth, async (firebaseUser) => {
    if (!firebaseUser) {
      window.location.href = "/login";
      return;
    }

    try {
      const userDoc = await getDoc(doc(db, "users", firebaseUser.uid));
      if (!userDoc.exists()) {
        window.location.href = "/login";
        return;
      }

      const userData = userDoc.data();
      currentUserData = userData;
      setUser(userData as any);

      if (userData.assignedTrainerId) {
        activeTrainerId = userData.assignedTrainerId;
        const trainerDoc = await getDoc(doc(db, "users", activeTrainerId));
        if (trainerDoc.exists()) {
          const tData = trainerDoc.data();
          trainerName.textContent = tData.name || "Entrenador Asignado";
          trainerStatus.textContent = tData.email || "Online";
        } else {
          trainerName.textContent = "Entrenador Asignado";
          trainerStatus.textContent = "Online";
        }
      } else {
        activeTrainerId = "";
        trainerName.textContent = "Sin Entrenador Asignado";
        trainerStatus.textContent = "No tienes coach asignado";
        if (chatInput) {
          chatInput.disabled = true;
          chatInput.placeholder = "Para chatear necesitas tener un entrenador asignado...";
        }
        if (sendBtn) sendBtn.disabled = true;
        if (btnAttachMedia) btnAttachMedia.disabled = true;
      }

      loadingScreen.classList.add("hidden");
      chatContent.classList.remove("hidden");

      if (!activeTrainerId) {
        messagesContainer.innerHTML = `
          <div class="flex flex-col items-center justify-center h-full text-center space-y-3 py-12 px-4">
            <span class="text-4xl">👨‍🏫</span>
            <h3 class="text-sm font-bold text-white">Aún no tienes un entrenador asignado</h3>
            <p class="text-xs text-[var(--text-tertiary)] max-w-md">
              El chat directo conecta a los alumnos con su entrenador personal para dudas técnicas y seguimiento de rutinas.
              Para cualquier consulta sobre tu cuenta, sugerencias o incidencias, puedes contactar directamente con el equipo de soporte.
            </p>
            <div class="flex items-center gap-2 mt-2 flex-wrap justify-center">
              <a href="/client/support/report" class="rounded-xl bg-[var(--brand)] hover:bg-[var(--brand-hover)] px-4 py-2 text-xs font-bold text-[var(--text-on-brand)] transition-all shadow-md">
                📩 Abrir Ticket de Soporte
              </a>
              <a href="/client/workouts" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-4 py-2 text-xs font-semibold text-[var(--text-secondary)] hover:text-white transition-all">
                🏋️ Ver Ejercicios y Rutinas
              </a>
            </div>
          </div>
        `;
        return;
      }

      const chatQuery = query(
        collection(db, "messages"),
        where("participants", "array-contains", firebaseUser.uid),
        orderBy("createdAt", "asc")
      );

      if (unsubMessages) unsubMessages();

      unsubMessages = onSnapshot(chatQuery, (snapshot) => {
        messagesContainer.innerHTML = "";
        if (snapshot.empty) {
          messagesContainer.innerHTML = `
            <div class="flex flex-col items-center justify-center h-full text-center space-y-2 py-12">
              <span class="text-3xl">👋</span>
              <p class="text-sm font-bold text-[var(--text-secondary)]">${t("chat.noMessages")}</p>
              <p class="text-xs text-[var(--text-tertiary)]">${t("chat.firstMessagePrompt")}</p>
            </div>
          `;
          hasInitialLoaded = true;
          return;
        }

        const filteredDocs = snapshot.docs.filter((d) => {
          const p = d.data().participants || [];
          return p.includes(activeTrainerId);
        });

        filteredDocs.forEach((docSnap) => {
          const msg = docSnap.data();
          const isMine = msg.senderId === firebaseUser.uid;
          const time = msg.createdAt && msg.createdAt.toDate
            ? msg.createdAt.toDate().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
            : t("chat.justNow");

          if (!isMine && !msg.isRead) {
            updateDoc(doc(db, "messages", docSnap.id), { isRead: true }).catch(() => {});
            
            // Browser notification si la página no está enfocada
            if (hasInitialLoaded && document.hidden) {
              showLocalNotification("Nuevo mensaje de tu entrenador", {
                body: msg.content || "Has recibido un adjunto o mensaje nuevo.",
                category: "clientChat",
              }, currentUserData);
            }
          }

          const div = document.createElement("div");
          div.className = "flex " + (isMine ? "justify-end" : "justify-start");

          let bubbleClass = isMine
            ? "bg-[var(--brand)] text-[var(--text-on-brand)] font-medium rounded-br-none shadow-md"
            : "bg-[var(--surface-3)] text-[var(--text-primary)] border border-[var(--border-subtle)] rounded-bl-none";

          if (msg.type === "alert") {
            bubbleClass = isMine
              ? "bg-amber-600 text-white font-medium rounded-br-none shadow-md border border-amber-400/30"
              : "bg-amber-500/10 text-amber-300 border border-amber-500/30 rounded-bl-none font-medium";
          }

          const timeClass = isMine ? "text-right" : "text-left";

          const alertIconHtml = msg.type === "alert" ? `
            <div class="flex items-center gap-1.5 mb-1 text-xs font-bold text-amber-400">
              <span>⚠️ ${t("trainer.attentionAlert")}</span>
            </div>
          ` : "";

          const mediaHtml = msg.mediaUrl
            ? msg.mediaType === "video"
              ? `<div class="mt-2 overflow-hidden rounded-xl">
                   <video src="${escapeHtml(msg.mediaUrl)}" controls class="max-h-56 w-full rounded-xl object-contain bg-black"></video>
                 </div>`
              : `<div class="mt-2 overflow-hidden rounded-xl">
                   <img src="${escapeHtml(msg.mediaUrl)}" alt="Adjunto" class="max-h-56 w-full rounded-xl object-cover cursor-pointer hover:opacity-95" onclick="window.open('${escapeHtml(msg.mediaUrl)}', '_blank')" />
                 </div>`
            : "";

          div.innerHTML = `
            <div class="max-w-[80%] space-y-1">
              <div class="rounded-2xl px-4 py-2.5 text-xs leading-relaxed ${bubbleClass}">
                ${alertIconHtml}
                ${msg.content ? `<p class="break-words">${escapeHtml(msg.content)}</p>` : ""}
                ${mediaHtml}
              </div>
              <p class="text-[10px] text-[var(--text-tertiary)] px-1 ${timeClass}">${time}</p>
            </div>
          `;

          messagesContainer.appendChild(div);
        });

        hasInitialLoaded = true;

        setTimeout(() => {
          messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }, 50);
      }, (error) => {
        console.error("Error al escuchar mensajes:", error);
        messagesContainer.innerHTML = `
          <div class="flex justify-center p-6">
            <p class="text-xs text-[var(--danger)]">${t("chat.errorLoading")}</p>
          </div>
        `;
      });

    } catch (err) {
      console.error("Error inicializando chat cliente:", err);
      loadingScreen.classList.add("hidden");
      chatContent.classList.remove("hidden");
    }
  });

  async function handleSendMessage(e: Event) {
    e.preventDefault();
    if (!activeTrainerId) return;
    const content = chatInput.value.trim();
    if ((!content && !selectedFile) || !auth.currentUser) return;

    chatInput.value = "";
    sendBtn.disabled = true;

    try {
      const senderId = auth.currentUser.uid;
      const participants = [senderId, activeTrainerId].sort();

      let mediaPayload: { mediaUrl?: string; mediaType?: 'image' | 'video' } = {};

      if (selectedFile) {
        const uploadResult = await uploadChatMedia(selectedFile, senderId);
        mediaPayload = {
          mediaUrl: uploadResult.url,
          mediaType: uploadResult.type,
        };
        selectedFile = null;
        chatFileInput.value = "";
        attachmentPreview.classList.add("hidden");
      }

      await addDoc(collection(db, "messages"), {
        senderId,
        receiverId: activeTrainerId,
        participants,
        content: content || "",
        type: mediaPayload.mediaUrl ? "media" : "text",
        ...mediaPayload,
        isRead: false,
        createdAt: serverTimestamp(),
      });
    } catch (err) {
      console.error("Error al enviar mensaje:", err);
    } finally {
      sendBtn.disabled = false;
    }
  }

  chatForm.addEventListener("submit", handleSendMessage);

  document.addEventListener("astro:before-swap", () => {
    unsubscribeAuth();
    if (unsubMessages) unsubMessages();
  });
</script>