---
import ClientLayout from '@/layouts/ClientLayout.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<ClientLayout>
  <!-- Loading -->
  <div id="loadingScreen" class="flex min-h-screen items-center justify-center">
    <div class="text-center animate-fade-in">
      <div class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-[var(--border-strong)] border-t-emerald-400"></div>
      <p id="loadingText" class="mt-4 text-sm text-[var(--text-tertiary)]">{t('dashboard.loading')}</p>
    </div>
  </div>

  <!-- Support Content -->
  <div id="supportContent" class="hidden">
    <!-- Header -->
    <header class="border-b border-[var(--border-default)] bg-[var(--surface-1)]/50 backdrop-blur-xl">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-[var(--brand-hover)] to-[var(--brand)] shadow-lg shadow-[var(--shadow-glow-sm)]">
            <svg class="h-5 w-5 text-[var(--text-on-brand)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
            </svg>
          </div>
          <h1 data-i18n="client.support.title" class="text-lg font-bold text-[var(--brand)]">{t('client.support.title')}</h1>
        </div>
      </div>
    </header>

    <!-- Main -->
    <main class="mx-auto max-w-4xl px-4 py-6">
      <div class="animate-fade-in space-y-6">
        <!-- Description -->
        <div>
          <h2 data-i18n="client.support.title" class="text-xl font-bold text-[var(--text-primary)]">{t('client.support.title')}</h2>
          <p data-i18n="client.support.desc" class="mt-1 text-sm text-[var(--text-tertiary)]">{t('client.support.desc')}</p>
        </div>

        <!-- FAQ Section -->
        <div>
          <h3 data-i18n="client.support.faq" class="mb-4 text-sm font-semibold text-[var(--text-secondary)] uppercase tracking-wider">{t('client.support.faq')}</h3>
          <div class="space-y-3" id="faqContainer">
            <!-- FAQ items will be rendered by JS -->
          </div>
        </div>

        <!-- Support Options Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Card 1: Abrir Ticket de Soporte -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl flex flex-col justify-between space-y-4">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-orange-500/10 text-orange-400 text-xl border border-orange-500/20">
                📩
              </div>
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-[var(--text-primary)]">Reportar un Problema / Ticket</h4>
                <p class="text-xs text-[var(--text-tertiary)]">
                  Envía una incidencia técnica, consulta sobre tu cuenta o sugerencia directamente al equipo de administración.
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2 pt-2">
              <a
                href="/client/support/report"
                class="flex-1 rounded-xl bg-[var(--brand)] hover:bg-[var(--brand-hover)] px-4 py-2.5 text-xs font-bold text-[var(--text-on-brand)] text-center shadow-md transition-all active:scale-95"
              >
                Abrir Nuevo Ticket →
              </a>
              <a
                href="/client/support/my-tickets"
                class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] hover:bg-[var(--surface-4)] px-4 py-2.5 text-xs font-semibold text-[var(--text-secondary)] text-center transition-all"
              >
                Mis Tickets
              </a>
            </div>
          </div>

          <!-- Card 2: Chat con Entrenador -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl flex flex-col justify-between space-y-4">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-500/10 text-blue-400 text-xl border border-blue-500/20">
                💬
              </div>
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-[var(--text-primary)]">Chat con mi Entrenador</h4>
                <p class="text-xs text-[var(--text-tertiary)]">
                  Comunícate directamente con tu coach asignado para resolver dudas de técnica, ajustes de peso o sensaciones.
                </p>
              </div>
            </div>
            <div class="pt-2">
              <a
                href="/client/chat"
                id="btn-chat-trainer"
                class="flex items-center justify-center gap-1.5 w-full rounded-xl bg-blue-500 hover:bg-blue-600 px-4 py-2.5 text-xs font-bold text-white shadow-md transition-all active:scale-95"
              >
                <span>Ir al Chat con Entrenador</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Changelog / Registro de Versiones -->
        <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div class="flex items-center gap-2.5">
              <span class="text-xl">✨</span>
              <div>
                <h3 class="text-base font-bold text-[var(--text-primary)]">Historial de Novedades & Versiones</h3>
                <p class="text-xs text-[var(--text-tertiary)]">Transparencia total: consulta qué mejoras y correcciones añadimos en cada actualización.</p>
              </div>
            </div>
            <span class="rounded-full bg-emerald-500/15 border border-emerald-500/30 px-3 py-1 text-xs font-bold text-emerald-400 flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
              En Vivo: v0.012 Beta
            </span>
          </div>

          <div class="space-y-3 pt-2">
            <!-- Version 0.012 -->
            <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-4 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="rounded-md bg-emerald-500 px-2 py-0.5 text-[10px] font-black text-black uppercase">v0.012</span>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Onboarding Optimizado: Eliminación de Redundancias & Fricción</span>
                </div>
                <span class="text-[11px] text-[var(--text-tertiary)]">Actual</span>
              </div>
              <ul class="text-xs text-[var(--text-secondary)] space-y-1 list-disc list-inside">
                <li>Vinculación inteligente de identidad: el nombre del registro se auto-hereda con badge visual sin obligar a escribirlo de nuevo.</li>
                <li>Desacoplamiento clínico de alergias: separación estricta entre alergias farmacológicas/ambientales (Paso 2) y nutricionales (Paso 4).</li>
                <li>Buscador y exclusión unificada de alimentos: integración limpia entre catálogo interactivo y preferencias alimentarias.</li>
              </ul>
            </div>

            <!-- Version 0.011 -->
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="rounded-md bg-[var(--surface-4)] border border-[var(--border-subtle)] px-2 py-0.5 text-[10px] font-bold text-[var(--text-secondary)] uppercase">v0.011</span>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Gestión Integral de Soporte: Telemetría Automática & Copia para Agente AI</span>
                </div>
              </div>
              <ul class="text-xs text-[var(--text-secondary)] space-y-1 list-disc list-inside">
                <li>Integración total en el menú de navegación del Administrador (`/admin/tickets`) para acceso y gestión en tiempo real.</li>
                <li>Telemetría automática en reportes de incidencias: versión activa, URL de origen, sistema operativo, navegador, memoria y resolución.</li>
                <li>Botón de 1-click "📋 Copiar para Agente AI": exporta el reporte completo formateado en Markdown para acelerar el ciclo de resolución con los agentes de desarrollo.</li>
              </ul>
            </div>

            <!-- Version 0.010 -->
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="rounded-md bg-[var(--surface-4)] border border-[var(--border-subtle)] px-2 py-0.5 text-[10px] font-bold text-[var(--text-secondary)] uppercase">v0.010</span>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Motor de Análisis Fisiológico, Readiness Diario & Gráficos 7D</span>
                </div>
              </div>
              <ul class="text-xs text-[var(--text-secondary)] space-y-1 list-disc list-inside">
                <li>Motor de Promedio Móvil 7D (Moving Average): Gráfico interactivo que filtra la retención de agua/glucógeno y muestra la tendencia biológica real.</li>
                <li>Widget "Estado de Hoy & Readiness Score": Evaluación de 0 a 100 del estado de preparación diaria y recomendaciones de entrenamiento.</li>
                <li>Detector de Retención por Cortisol: Alerta preventiva si el estrés elevado y déficit de sueño enmascaran el progreso en báscula.</li>
                <li>Validación de Seguridad Fisiológica: Advertencia interactiva si se introduce una variación de peso &gt;5% en 24h para prevenir errores tipográficos.</li>
              </ul>
            </div>

            <!-- Version 0.009 -->
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="rounded-md bg-[var(--surface-4)] border border-[var(--border-subtle)] px-2 py-0.5 text-[10px] font-bold text-[var(--text-secondary)] uppercase">v0.009</span>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Suite de Seguimiento Élite: Antropometría, Perímetros & Bio-Feedback</span>
                </div>
              </div>
              <ul class="text-xs text-[var(--text-secondary)] space-y-1 list-disc list-inside">
                <li>Módulo de Perímetros Antropométricos: Pecho, Cintura, Cadera, Bíceps (izq/der), Muslos (izq/der) y Gemelos en centímetros con edición y KPIs.</li>
                <li>Módulo de Bio-Feedback & Recuperación Diaria: Registro de horas y calidad de sueño, energía (1-10), estrés percibido (1-10), nivel de agujetas (DOMS) e hidratación en litros.</li>
                <li>Navegación fluida de 4 pestañas de alto rendimiento con modales de corrección instantánea y protección anti-duplicados por día.</li>
              </ul>
            </div>

            <!-- Version 0.008 -->
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="rounded-md bg-[var(--surface-4)] border border-[var(--border-subtle)] px-2 py-0.5 text-[10px] font-bold text-[var(--text-secondary)] uppercase">v0.008</span>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Gestión Integral de Peso: Edición, Eliminación, KPIs & Anti-Duplicados</span>
                </div>
              </div>
              <ul class="text-xs text-[var(--text-secondary)] space-y-1 list-disc list-inside">
                <li>Edición directa de registros de peso erróneos mediante modal dedicado con fecha y notas de contexto.</li>
                <li>Eliminación segura con diálogo de confirmación interactivo.</li>
                <li>Protección inteligente contra doble clic y actualización automática del peso del mismo día sin crear registros duplicados.</li>
                <li>Dashboard de KPIs: Peso inicial, peso actual, variación neta (+/- kg) y promedio de los últimos 7 registros.</li>
              </ul>
            </div>

            <!-- Version 0.007 -->
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="rounded-md bg-[var(--surface-4)] border border-[var(--border-subtle)] px-2 py-0.5 text-[10px] font-bold text-[var(--text-secondary)] uppercase">v0.007</span>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Corrección de Consulta Resiliente en Mis Tickets</span>
                </div>
              </div>
              <ul class="text-xs text-[var(--text-secondary)] space-y-1 list-disc list-inside">
                <li>Eliminada la dependencia obligatoria de índices compuestos para la carga de tickets personales, permitiendo visualización inmediata sin errores.</li>
                <li>Despliegue de índices optimizados en Firestore para consultas de alta velocidad.</li>
              </ul>
            </div>

            <!-- Version 0.006 -->
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="rounded-md bg-[var(--surface-4)] border border-[var(--border-subtle)] px-2 py-0.5 text-[10px] font-bold text-[var(--text-secondary)] uppercase">v0.006</span>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Changelog Público & Control de Versiones Transparente</span>
                </div>
              </div>
              <ul class="text-xs text-[var(--text-secondary)] space-y-1 list-disc list-inside">
                <li>Visualización pública del historial de versiones y novedades en el Centro de Soporte.</li>
                <li>Actualización instantánea de badges de versión en tiempo real en cada despliegue.</li>
              </ul>
            </div>

            <!-- Version 0.005 -->
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="rounded-md bg-[var(--surface-4)] border border-[var(--border-subtle)] px-2 py-0.5 text-[10px] font-bold text-[var(--text-secondary)] uppercase">v0.005</span>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Trazabilidad Técnica en Soporte & Persistencia de Onboarding</span>
                </div>
              </div>
              <ul class="text-xs text-[var(--text-secondary)] space-y-1 list-disc list-inside">
                <li>Widget flotante global de feedback y reporte de bugs con captura de URL, dispositivo y resolución de pantalla.</li>
                <li>Persistencia de borrador en el Onboarding ("Nada se pierde al refrescar") para recuperar tus datos automáticamente.</li>
              </ul>
            </div>

            <!-- Version 0.004 -->
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="rounded-md bg-[var(--surface-4)] border border-[var(--border-subtle)] px-2 py-0.5 text-[10px] font-bold text-[var(--text-secondary)] uppercase">v0.004</span>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Hub de Autonomía & Modo Kickstart para Alumnos</span>
                </div>
              </div>
              <ul class="text-xs text-[var(--text-secondary)] space-y-1 list-disc list-inside">
                <li>3 Programas predeterminados de inicio (Full Body 3D, Torso/Pierna 4D, Movilidad/Core) listos para entrenar.</li>
                <li>Calculadora metabólica interactiva de TDEE/BMR con tracker de hidratación y explorador de ejercicios con vídeo.</li>
                <li>Sincronización automática de peso entre la Ficha Médica y las gráficas de evolución temporal.</li>
              </ul>
            </div>

            <!-- Version 0.003 -->
            <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-4 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="rounded-md bg-[var(--surface-4)] border border-[var(--border-subtle)] px-2 py-0.5 text-[10px] font-bold text-[var(--text-secondary)] uppercase">v0.003</span>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Gestión de Tickets de Soporte & Chat con Coach</span>
                </div>
              </div>
              <ul class="text-xs text-[var(--text-secondary)] space-y-1 list-disc list-inside">
                <li>Bandeja de seguimiento de tickets para clientes y panel de resolución para administración.</li>
                <li>Integración de avatares reales y foto de perfil en el chat interactivo.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</ClientLayout>

<script>
  import { initPage } from '@/lib/shared/initPage';
  import { t } from '@/i18n/client';

  const loadingScreen = document.getElementById('loadingScreen')!;
  const loadingText = document.getElementById('loadingText')!;
  const supportContent = document.getElementById('supportContent')!;
  const faqContainer = document.getElementById('faqContainer')!;

  loadingText.textContent = t('dashboard.loading');

  // FAQ data
  const faqItems = [
    {
      question: t('client.support.faq.workouts'),
      answer: t('client.support.faq.workouts.answer'),
    },
    {
      question: t('client.support.faq.diets'),
      answer: t('client.support.faq.diets.answer'),
    },
    {
      question: t('client.support.faq.progress'),
      answer: t('client.support.faq.progress.answer'),
    },
    {
      question: t('client.support.faq.chat'),
      answer: t('client.support.faq.chat.answer'),
    },
    {
      question: t('client.support.faq.medical'),
      answer: t('client.support.faq.medical.answer'),
    },
  ];

  function renderFaqs() {
    faqContainer.innerHTML = '';
    faqItems.forEach((item, index) => {
      const faqEl = document.createElement('div');
      faqEl.className = 'faq-item rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] backdrop-blur-sm overflow-hidden transition-all duration-200';

      faqEl.innerHTML = `
        <button
          class="faq-question flex w-full items-center justify-between px-5 py-4 text-left transition-all hover:bg-[var(--surface-4)]"
          data-index="${index}"
        >
          <span class="text-sm font-medium text-[var(--text-primary)] pr-4">${item.question}</span>
          <svg class="faq-chevron h-5 w-5 shrink-0 text-[var(--text-tertiary)] transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
          <div class="px-5 pb-4 pt-0">
            <p class="text-sm text-[var(--text-secondary)] leading-relaxed">${item.answer}</p>
          </div>
        </div>
      `;

      faqContainer.appendChild(faqEl);

      // Add click handler
      const questionBtn = faqEl.querySelector('.faq-question') as HTMLButtonElement;
      questionBtn.addEventListener('click', () => {
        const answer = faqEl.querySelector('.faq-answer') as HTMLDivElement;
        const chevron = faqEl.querySelector('.faq-chevron') as SVGElement;
        const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';

        // Close all other FAQs
        document.querySelectorAll('.faq-answer').forEach((el) => {
          (el as HTMLDivElement).style.maxHeight = '0px';
        });
        document.querySelectorAll('.faq-chevron').forEach((el) => {
          (el as SVGElement).classList.remove('rotate-180');
        });

        if (!isOpen) {
          answer.style.maxHeight = answer.scrollHeight + 'px';
          chevron.classList.add('rotate-180');
        }
      });
    });
  }

  const cleanup = initPage({
    allowedRoles: ['client', 'admin', 'trainer'],
    onReady: async () => {
      renderFaqs();
    },
  });

  document.addEventListener('astro:before-swap', cleanup);
</script>
