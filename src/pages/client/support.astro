---
import ClientLayout from '@/layouts/ClientLayout.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<ClientLayout>
  <!-- Loading -->
  <div id="loadingScreen" class="flex min-h-screen items-center justify-center">
    <div class="text-center animate-fade-in">
      <div class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-[var(--border-strong)] border-t-emerald-400"></div>
      <p id="loadingText" class="mt-4 text-sm text-[var(--text-tertiary)]">{t('dashboard.loading')}</p>
    </div>
  </div>

  <!-- Support Content -->
  <div id="supportContent" class="hidden">
    <!-- Header -->
    <header class="border-b border-[var(--border-default)] bg-[var(--surface-1)]/50 backdrop-blur-xl">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-[var(--brand-hover)] to-[var(--brand)] shadow-lg shadow-[var(--shadow-glow-sm)]">
            <svg class="h-5 w-5 text-[var(--text-on-brand)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
            </svg>
          </div>
          <h1 data-i18n="client.support.title" class="text-lg font-bold text-[var(--brand)]">{t('client.support.title')}</h1>
        </div>
      </div>
    </header>

    <!-- Main -->
    <main class="mx-auto max-w-4xl px-4 py-6">
      <div class="animate-fade-in space-y-6">
        <!-- Description -->
        <div>
          <h2 data-i18n="client.support.title" class="text-xl font-bold text-[var(--text-primary)]">{t('client.support.title')}</h2>
          <p data-i18n="client.support.desc" class="mt-1 text-sm text-[var(--text-tertiary)]">{t('client.support.desc')}</p>
        </div>

        <!-- FAQ Section -->
        <div>
          <h3 data-i18n="client.support.faq" class="mb-4 text-sm font-semibold text-[var(--text-secondary)] uppercase tracking-wider">{t('client.support.faq')}</h3>
          <div class="space-y-3" id="faqContainer">
            <!-- FAQ items will be rendered by JS -->
          </div>
        </div>

        <!-- Support Options Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Card 1: Abrir Ticket de Soporte -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl flex flex-col justify-between space-y-4">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-orange-500/10 text-orange-400 text-xl border border-orange-500/20">
                📩
              </div>
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-[var(--text-primary)]">Reportar un Problema / Ticket</h4>
                <p class="text-xs text-[var(--text-tertiary)]">
                  Envía una incidencia técnica, consulta sobre tu cuenta o sugerencia directamente al equipo de administración.
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2 pt-2">
              <a
                href="/client/support/report"
                class="flex-1 rounded-xl bg-[var(--brand)] hover:bg-[var(--brand-hover)] px-4 py-2.5 text-xs font-bold text-[var(--text-on-brand)] text-center shadow-md transition-all active:scale-95"
              >
                Abrir Nuevo Ticket →
              </a>
              <a
                href="/client/support/my-tickets"
                class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] hover:bg-[var(--surface-4)] px-4 py-2.5 text-xs font-semibold text-[var(--text-secondary)] text-center transition-all"
              >
                Mis Tickets
              </a>
            </div>
          </div>

          <!-- Card 2: Chat con Entrenador -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl flex flex-col justify-between space-y-4">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-500/10 text-blue-400 text-xl border border-blue-500/20">
                💬
              </div>
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-[var(--text-primary)]">Chat con mi Entrenador</h4>
                <p class="text-xs text-[var(--text-tertiary)]">
                  Comunícate directamente con tu coach asignado para resolver dudas de técnica, ajustes de peso o sensaciones.
                </p>
              </div>
            </div>
            <div class="pt-2">
              <a
                href="/client/chat"
                id="btn-chat-trainer"
                class="flex items-center justify-center gap-1.5 w-full rounded-xl bg-blue-500 hover:bg-blue-600 px-4 py-2.5 text-xs font-bold text-white shadow-md transition-all active:scale-95"
              >
                <span>Ir al Chat con Entrenador</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</ClientLayout>

<script>
  import { initPage } from '@/lib/shared/initPage';
  import { t } from '@/i18n/client';

  const loadingScreen = document.getElementById('loadingScreen')!;
  const loadingText = document.getElementById('loadingText')!;
  const supportContent = document.getElementById('supportContent')!;
  const faqContainer = document.getElementById('faqContainer')!;

  loadingText.textContent = t('dashboard.loading');

  // FAQ data
  const faqItems = [
    {
      question: t('client.support.faq.workouts'),
      answer: t('client.support.faq.workouts.answer'),
    },
    {
      question: t('client.support.faq.diets'),
      answer: t('client.support.faq.diets.answer'),
    },
    {
      question: t('client.support.faq.progress'),
      answer: t('client.support.faq.progress.answer'),
    },
    {
      question: t('client.support.faq.chat'),
      answer: t('client.support.faq.chat.answer'),
    },
    {
      question: t('client.support.faq.medical'),
      answer: t('client.support.faq.medical.answer'),
    },
  ];

  function renderFaqs() {
    faqContainer.innerHTML = '';
    faqItems.forEach((item, index) => {
      const faqEl = document.createElement('div');
      faqEl.className = 'faq-item rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] backdrop-blur-sm overflow-hidden transition-all duration-200';

      faqEl.innerHTML = `
        <button
          class="faq-question flex w-full items-center justify-between px-5 py-4 text-left transition-all hover:bg-[var(--surface-4)]"
          data-index="${index}"
        >
          <span class="text-sm font-medium text-[var(--text-primary)] pr-4">${item.question}</span>
          <svg class="faq-chevron h-5 w-5 shrink-0 text-[var(--text-tertiary)] transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
          <div class="px-5 pb-4 pt-0">
            <p class="text-sm text-[var(--text-secondary)] leading-relaxed">${item.answer}</p>
          </div>
        </div>
      `;

      faqContainer.appendChild(faqEl);

      // Add click handler
      const questionBtn = faqEl.querySelector('.faq-question') as HTMLButtonElement;
      questionBtn.addEventListener('click', () => {
        const answer = faqEl.querySelector('.faq-answer') as HTMLDivElement;
        const chevron = faqEl.querySelector('.faq-chevron') as SVGElement;
        const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';

        // Close all other FAQs
        document.querySelectorAll('.faq-answer').forEach((el) => {
          (el as HTMLDivElement).style.maxHeight = '0px';
        });
        document.querySelectorAll('.faq-chevron').forEach((el) => {
          (el as SVGElement).classList.remove('rotate-180');
        });

        if (!isOpen) {
          answer.style.maxHeight = answer.scrollHeight + 'px';
          chevron.classList.add('rotate-180');
        }
      });
    });
  }

  const cleanup = initPage({
    allowedRoles: ['client', 'admin', 'trainer'],
    onReady: async () => {
      renderFaqs();
    },
  });

  document.addEventListener('astro:before-swap', cleanup);
</script>
