  // --- BIO-FEEDBACK LOGIC ---
  function renderBiofeedbackLogs(logs: ProgressLog[]) {
    cachedBioLogs = logs;
    if (bioCountBadge) {
      bioCountBadge.textContent = `${logs.length} ${logs.length === 1 ? 'registro' : 'registros'}`;
    }

    if (!logs || logs.length === 0) {
      biofeedbackHistory.innerHTML = '<p class="text-sm text-[var(--text-disabled)]">Sin registros de bio-feedback aún.</p>';
      if (kpiSleep) kpiSleep.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">h</span>';
      if (kpiEnergy) kpiEnergy.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">/10</span>';
      if (kpiStress) kpiStress.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">/10</span>';
      if (kpiWater) kpiWater.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">L</span>';
      return;
    }

    const chronoLogs = [...logs].sort((a, b) => getLogDateObject(a.date).getTime() - getLogDateObject(b.date).getTime());
    const recentLogs = chronoLogs.slice(-7);

    // Update Readiness Card and Cortisol Alert
    const newestBio = chronoLogs[chronoLogs.length - 1];
    if (newestBio?.value) {
      const evaluation = calculateReadinessScore(newestBio.value as BioFeedback);
      if (readinessScoreVal) readinessScoreVal.textContent = String(evaluation.score);
      if (readinessLevelBadge) {
        readinessLevelBadge.textContent = evaluation.label;
        readinessLevelBadge.className = `rounded-full bg-[var(--surface-3)] px-2.5 py-0.5 text-[11px] font-bold ${evaluation.colorClass}`;
      }
      if (readinessLabel) {
        readinessLabel.textContent = `${evaluation.label} (${evaluation.score}/100)`;
        readinessLabel.className = `text-xs font-bold ${evaluation.colorClass}`;
      }
      if (readinessRecommendation) {
        readinessRecommendation.textContent = evaluation.recommendation;
      }
    }

    const cortisolCheck = detectCortisolRetentionAlert(cachedWeightLogs, cachedBioLogs);
    if (cortisolCheck.hasAlert && cortisolAlertBanner) {
      cortisolAlertBanner.classList.remove('hidden');
      if (cortisolAlertMessage && cortisolCheck.message) {
        cortisolAlertMessage.textContent = cortisolCheck.message;
      }
    } else if (cortisolAlertBanner) {
      cortisolAlertBanner.classList.add('hidden');
    }

    const avgSleep = recentLogs.reduce((acc, l) => acc + (Number((l.value as any)?.sleepHours) || 0), 0) / recentLogs.length;
    const avgEnergy = recentLogs.reduce((acc, l) => acc + (Number((l.value as any)?.energyLevel) || 0), 0) / recentLogs.length;
    const avgStress = recentLogs.reduce((acc, l) => acc + (Number((l.value as any)?.stressLevel) || 0), 0) / recentLogs.length;
    const avgWater = recentLogs.reduce((acc, l) => acc + (Number((l.value as any)?.waterLitres) || 0), 0) / recentLogs.length;

    if (kpiSleep) kpiSleep.innerHTML = avgSleep > 0 ? `${avgSleep.toFixed(1)} <span class="text-xs font-normal text-[var(--text-tertiary)]">h</span>` : '--';
    if (kpiEnergy) kpiEnergy.innerHTML = avgEnergy > 0 ? `${avgEnergy.toFixed(1)} <span class="text-xs font-normal text-[var(--text-tertiary)]">/10</span>` : '--';
    if (kpiStress) kpiStress.innerHTML = avgStress > 0 ? `${avgStress.toFixed(1)} <span class="text-xs font-normal text-[var(--text-tertiary)]">/10</span>` : '--';
    if (kpiWater) kpiWater.innerHTML = avgWater > 0 ? `${avgWater.toFixed(1)} <span class="text-xs font-normal text-[var(--text-tertiary)]">L</span>` : '--';

    biofeedbackHistory.innerHTML = "";
    const descLogs = [...logs].sort((a, b) => getLogDateObject(b.date).getTime() - getLogDateObject(a.date).getTime());

    descLogs.forEach((log) => {
      const d = getLogDateObject(log.date);
      const formattedDate = d.toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' });
      const b = (log.value || {}) as BioFeedback;

      const domsBadge = b.doms === 'none'
        ? '<span class="rounded bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 px-2 py-0.5 text-[10px] font-bold">🟢 Sin Agujetas</span>'
        : b.doms === 'mild'
        ? '<span class="rounded bg-amber-500/10 text-amber-300 border border-amber-500/20 px-2 py-0.5 text-[10px] font-bold">🟡 Agujetas Leves</span>'
        : b.doms === 'moderate'
        ? '<span class="rounded bg-orange-500/10 text-orange-300 border border-orange-500/20 px-2 py-0.5 text-[10px] font-bold">🟠 Agujetas Medias</span>'
        : '<span class="rounded bg-rose-500/10 text-rose-300 border border-rose-500/20 px-2 py-0.5 text-[10px] font-bold">🔴 Sobrecarga</span>';

      const itemEl = document.createElement("div");
      itemEl.className = "flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-xl bg-[var(--surface-2)] border border-[var(--border-subtle)] p-4 hover:border-[var(--border-default)] transition-all";
      itemEl.innerHTML = `
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="rounded-md bg-amber-500/10 border border-amber-500/20 text-amber-400 px-2 py-0.5 text-[10px] font-bold">⚡ Bio-Feedback</span>
            <span class="text-xs font-bold text-[var(--text-primary)]">${formattedDate}</span>
            ${domsBadge}
          </div>
          <div class="flex flex-wrap gap-2 text-xs text-[var(--text-secondary)]">
            ${b.sleepHours ? `<span>😴 Sueño: <b>${b.sleepHours}h</b></span>` : ''}
            ${b.energyLevel ? `<span>⚡ Energía: <b>${b.energyLevel}/10</b></span>` : ''}
            ${b.stressLevel ? `<span>🧘 Estrés: <b>${b.stressLevel}/10</b></span>` : ''}
            ${b.waterLitres ? `<span>💧 Agua: <b>${b.waterLitres}L</b></span>` : ''}
          </div>
          ${b.notes ? `<p class="text-xs text-[var(--text-tertiary)] italic">"${escapeHtml(b.notes)}"</p>` : ''}
        </div>
        <div class="flex items-center justify-end gap-1.5 shrink-0">
          <button type="button" class="btn-edit-bio rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] hover:bg-[var(--surface-4)] p-1.5 text-xs text-[var(--text-secondary)] hover:text-white transition-all" title="Editar check-in">✏️</button>
          <button type="button" class="btn-delete-bio rounded-lg border border-rose-500/20 bg-rose-500/10 hover:bg-rose-500/20 p-1.5 text-xs text-rose-300 transition-all" title="Eliminar check-in">🗑️</button>
        </div>
      `;

      itemEl.querySelector('.btn-edit-bio')?.addEventListener('click', () => openEditBioModal(log));
      itemEl.querySelector('.btn-delete-bio')?.addEventListener('click', () => confirmAndDeleteBiofeedback(log.id));

      biofeedbackHistory.appendChild(itemEl);
    });
  }

