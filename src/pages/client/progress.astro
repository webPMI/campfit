---
import ClientLayout from '@/layouts/ClientLayout.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<ClientLayout>
  <div id="loadingScreen" class="flex min-h-screen items-center justify-center">
    <div class="text-center animate-fade-in">
      <div class="mx-auto h-10 w-10 animate-spin rounded-full border-4 theme-border-strong border-t-emerald-400"></div>
      <p id="loadingText" class="mt-4 text-sm theme-text-tertiary">{t('dashboard.loading')}</p>
    </div>
  </div>

  <div id="progressContent" class="hidden">
    <main class="mx-auto max-w-4xl px-4 py-6">
      <div class="animate-fade-in space-y-6">
        <!-- Header -->
        <div>
          <h2 class="text-xl font-bold">{t('dashboard.progress')}</h2>
          <p class="mt-1 text-sm theme-text-tertiary">{t('dashboard.progress.desc')}</p>
        </div>

        <!-- Tabs -->
        <div class="flex gap-2 border-b theme-border pb-2">
          <button id="tabWeight" class="tab-btn active rounded-lg px-4 py-2 text-sm font-medium theme-text-brand theme-brand/10 transition-all">Peso</button>
          <button id="tabPhotos" class="tab-btn rounded-lg px-4 py-2 text-sm font-medium theme-text-tertiary hover:theme-text-secondary transition-all">Fotos</button>
        </div>

        <!-- Weight Tab -->
        <div id="weightTab" class="space-y-4">
          <!-- Register Weight -->
          <div class="card-glow rounded-2xl border theme-border theme-surface p-6 backdrop-blur-xl">
            <h3 class="text-sm font-semibold theme-text-secondary mb-4">Registrar peso</h3>
            <div class="flex gap-3">
              <input
                id="weightInput"
                type="number"
                step="0.1"
                placeholder="75.5"
                class="flex-1 rounded-xl border theme-border-strong theme-surface-secondary px-4 py-3 text-sm theme-text-primary placeholder-theme-text-tertiary outline-none transition-all focus:ring-2 focus:ring-emerald-500/10 focus:ring-2 focus:ring-emerald-500/10"
              />
              <span class="flex items-center text-sm theme-text-tertiary">{t('client.stats.kg')}</span>
              <button
                id="saveWeightBtn"
                class="rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 px-6 py-3 text-sm font-semibold theme-text-primary shadow-lg shadow-emerald-500/20 transition-all hover:from-emerald-400 hover:to-emerald-500 active:scale-[0.98]"
              >
                Guardar
              </button>
            </div>
          </div>

          <!-- Weight Chart -->
          <div class="rounded-2xl border theme-border theme-surface p-6 backdrop-blur-xl">
            <h3 class="text-sm font-semibold theme-text-secondary mb-4">Evolución de Peso</h3>
            <div id="chartContainer" class="flex h-56 w-full items-center justify-center rounded-xl theme-bg-primary/20 p-2">
              <p class="text-xs theme-text-tertiary">Cargando gráfico...</p>
            </div>
          </div>

          <!-- Weight History -->
          <div class="rounded-2xl border theme-border theme-surface p-6 backdrop-blur-xl">
            <h3 class="text-sm font-semibold theme-text-secondary mb-4">Historial</h3>
            <div id="weightHistory" class="space-y-2">
              <p class="text-sm theme-text-tertiary">Sin registros de peso aún.</p>
            </div>
          </div>
        </div>

        <!-- Photos Tab (hidden by default) -->
        <div id="photosTab" class="hidden space-y-4">
          <!-- Upload Photo Card -->
          <div class="rounded-2xl border theme-border theme-surface p-6 backdrop-blur-xl">
            <h3 class="text-sm font-semibold theme-text-secondary mb-4">Añadir foto de evolución</h3>
            <div id="dropZone" class="flex flex-col items-center justify-center rounded-xl border-2 border-dashed theme-border-strong theme-surface-secondary p-8 text-center cursor-pointer hover:theme-border-focus/40 transition-all">
              <svg class="h-8 w-8 theme-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z" />
              </svg>
              <p class="mt-2 text-xs theme-text-secondary">Arrastra una imagen aquí o haz clic para seleccionarla</p>
              <input type="file" id="photoInput" accept="image/*" class="hidden" />
            </div>

            <!-- Preview & Notes -->
            <div id="photoPreviewContainer" class="hidden mt-4 space-y-4">
              <div class="flex items-center justify-center rounded-xl theme-bg-primary/20 p-2">
                <img id="photoPreview" class="max-h-48 rounded-lg object-contain shadow-lg" />
              </div>
              <input type="text" id="photoNotes" placeholder="Añade notas (ej: Peso 74kg, ayunas)" class="w-full rounded-xl border theme-border-strong theme-surface-secondary px-4 py-3 text-xs theme-text-primary outline-none focus:ring-2 focus:ring-emerald-500/10" />
              <div class="flex gap-2">
                <button id="cancelPhotoBtn" class="flex-1 rounded-xl border theme-border-strong theme-surface-secondary py-3 text-xs font-semibold theme-text-secondary hover:theme-text-primary transition-all">Cancelar</button>
                <button id="savePhotoBtn" class="flex-1 rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 py-3 text-xs font-semibold theme-text-primary shadow-lg shadow-emerald-500/20 hover:from-emerald-400 hover:to-emerald-500 transition-all active:scale-[0.98]">Guardar foto</button>
              </div>
            </div>
          </div>

          <!-- Photo Gallery -->
          <div class="rounded-2xl border theme-border theme-surface p-6 backdrop-blur-xl">
            <h3 class="text-sm font-semibold theme-text-secondary mb-4">Mi evolución visual</h3>
            <div id="photoGallery" class="grid grid-cols-2 gap-4">
              <p class="col-span-2 text-sm theme-text-tertiary">Sin fotos cargadas aún.</p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</ClientLayout>

