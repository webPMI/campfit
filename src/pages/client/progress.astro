  // --- MEASUREMENTS LOGIC ---
  function renderMeasurementsLogs(logs: ProgressLog[]) {
    cachedMeasLogs = logs;
    if (measCountBadge) {
      measCountBadge.textContent = `${logs.length} ${logs.length === 1 ? 'registro' : 'registros'}`;
    }

    if (!logs || logs.length === 0) {
      measurementsHistory.innerHTML = '<p class="text-sm text-[var(--text-disabled)]">Sin registros de perímetros aún.</p>';
      if (kpiChest) kpiChest.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">cm</span>';
      if (kpiWaist) kpiWaist.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">cm</span>';
      if (kpiHips) kpiHips.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">cm</span>';
      if (kpiArms) kpiArms.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">cm</span>';
      return;
    }

    const chronoLogs = [...logs].sort((a, b) => getLogDateObject(a.date).getTime() - getLogDateObject(b.date).getTime());
    const newestLog = chronoLogs[chronoLogs.length - 1];
    const val = (newestLog?.value || {}) as BodyMeasurements;

    if (kpiChest) kpiChest.innerHTML = val.chest ? `${val.chest} <span class="text-xs font-normal text-[var(--text-tertiary)]">cm</span>` : '--';
    if (kpiWaist) kpiWaist.innerHTML = val.waist ? `${val.waist} <span class="text-xs font-normal text-[var(--text-tertiary)]">cm</span>` : '--';
    if (kpiHips) kpiHips.innerHTML = val.hips ? `${val.hips} <span class="text-xs font-normal text-[var(--text-tertiary)]">cm</span>` : '--';
    const armAvg = (val.leftArm || val.rightArm) ? (((val.leftArm || 0) + (val.rightArm || 0)) / (val.leftArm && val.rightArm ? 2 : 1)).toFixed(1) : null;
    if (kpiArms) kpiArms.innerHTML = armAvg ? `${armAvg} <span class="text-xs font-normal text-[var(--text-tertiary)]">cm</span>` : '--';

    measurementsHistory.innerHTML = "";
    const descLogs = [...logs].sort((a, b) => getLogDateObject(b.date).getTime() - getLogDateObject(a.date).getTime());

    descLogs.forEach((log) => {
      const d = getLogDateObject(log.date);
      const formattedDate = d.toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' });
      const m = (log.value || {}) as BodyMeasurements;

      const pills: string[] = [];
      if (m.chest) pills.push(`<span class="rounded bg-[var(--surface-3)] px-2 py-0.5 text-[11px] font-semibold text-[var(--text-primary)]">Pecho: <b>${m.chest}cm</b></span>`);
      if (m.waist) pills.push(`<span class="rounded bg-amber-500/10 text-amber-300 border border-amber-500/20 px-2 py-0.5 text-[11px] font-semibold">Cintura: <b>${m.waist}cm</b></span>`);
      if (m.hips) pills.push(`<span class="rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/20 px-2 py-0.5 text-[11px] font-semibold">Cadera: <b>${m.hips}cm</b></span>`);
      if (m.leftArm || m.rightArm) pills.push(`<span class="rounded bg-purple-500/10 text-purple-300 border border-purple-500/20 px-2 py-0.5 text-[11px] font-semibold">Bíceps: <b>${m.leftArm || '-'}/${m.rightArm || '-'}cm</b></span>`);
      if (m.leftThigh || m.rightThigh) pills.push(`<span class="rounded bg-[var(--surface-3)] px-2 py-0.5 text-[11px] font-semibold text-[var(--text-secondary)]">Muslo: <b>${m.leftThigh || '-'}/${m.rightThigh || '-'}cm</b></span>`);
      if (m.calves) pills.push(`<span class="rounded bg-[var(--surface-3)] px-2 py-0.5 text-[11px] font-semibold text-[var(--text-secondary)]">Gemelos: <b>${m.calves}cm</b></span>`);

      const itemEl = document.createElement("div");
      itemEl.className = "flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-xl bg-[var(--surface-2)] border border-[var(--border-subtle)] p-4 hover:border-[var(--border-default)] transition-all";
      itemEl.innerHTML = `
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="rounded-md bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 px-2 py-0.5 text-[10px] font-bold">📏 Medición</span>
            <span class="text-xs font-bold text-[var(--text-primary)]">${formattedDate}</span>
            ${m.notes ? `<span class="text-xs text-[var(--text-tertiary)] italic">• "${escapeHtml(m.notes)}"</span>` : ''}
