---
import ClientLayout from "@/layouts/ClientLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<ClientLayout>
  <div id="loadingScreen" class="flex min-h-screen items-center justify-center">
    <div class="text-center animate-fade-in">
      <div
        class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-[var(--border-strong)] border-t-emerald-400"
      >
      </div>
      <p id="loadingText" class="mt-4 text-sm text-[var(--text-tertiary)]">
        {t("dashboard.loading")}
      </p>
    </div>
  </div>

  <div id="progressContent" class="hidden">
    <main class="mx-auto max-w-4xl px-4 py-6">
      <div class="animate-fade-in space-y-6">
        <!-- Header -->
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div>
            <h2 data-i18n="dashboard.progress" class="text-xl font-bold text-[var(--text-primary)]">{t("dashboard.progress")}</h2>
            <p data-i18n="dashboard.progress.desc" class="mt-1 text-sm text-[var(--text-tertiary)]">{t("dashboard.progress.desc") || "Seguimiento de peso corporal y evolución física"}</p>
          </div>
          <div class="flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-400">
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Almacenamiento Seguro</span>
          </div>
        </div>

        <!-- Tabs -->
        <!-- Tabs -->
        <div class="flex gap-2 border-b border-[var(--border-default)] pb-2 overflow-x-auto scrollbar-none">
          <button
            id="tabWeight"
            class="tab-btn active rounded-xl px-4 py-2 text-xs font-bold text-[var(--brand)] bg-[var(--brand-dim)] transition-all whitespace-nowrap"
          >
            ⚖️ Peso & Composición
          </button>
          <button
            id="tabMeasurements"
            class="tab-btn rounded-xl px-4 py-2 text-xs font-bold text-[var(--text-tertiary)] hover:text-[var(--text-secondary)] transition-all whitespace-nowrap"
          >
            📏 Perímetros & Medidas
          </button>
          <button
            id="tabBiofeedback"
            class="tab-btn rounded-xl px-4 py-2 text-xs font-bold text-[var(--text-tertiary)] hover:text-[var(--text-secondary)] transition-all whitespace-nowrap"
          >
            ⚡ Bio-Feedback Diario
          </button>
          <button
            id="tabPhotos"
            class="tab-btn rounded-xl px-4 py-2 text-xs font-bold text-[var(--text-tertiary)] hover:text-[var(--text-secondary)] transition-all whitespace-nowrap"
          >
            📸 Fotos de Evolución
          </button>
        </div>

        <!-- Weight Tab -->
        <div id="weightTab" class="space-y-5">
          <!-- Cortisol & Retention Alert Banner -->
          <div id="cortisolAlertBanner" class="hidden rounded-2xl border border-amber-500/30 bg-gradient-to-r from-amber-500/10 to-orange-500/10 p-4 backdrop-blur-xl animate-fade-in">
            <div class="flex items-start gap-3">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-amber-500/20 text-amber-300 text-lg border border-amber-500/30">
                🧬
              </div>
              <div class="space-y-1">
                <h4 class="text-xs font-bold text-amber-300 uppercase tracking-wider">Aviso Fisiológico de Retención (Cortisol)</h4>
                <p id="cortisolAlertMessage" class="text-xs text-[var(--text-secondary)] leading-relaxed">
                  Tus marcadores recientes de estrés o déficit de descanso pueden provocar retención hídrica temporal. El promedio móvil de 7 días te mostrará tu tendencia real.
                </p>
              </div>
            </div>
          </div>

          <!-- Readiness & Vitals Summary Widget -->
          <div id="readinessCard" class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-5 backdrop-blur-xl space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[var(--brand-dim)] text-xs text-[var(--brand)] border border-[var(--border-brand)]/20">⚡</span>
                <h3 class="text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider">Estado de Hoy & Readiness Score</h3>
              </div>
              <span id="readinessLevelBadge" class="rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2.5 py-0.5 text-[11px] font-bold">
                Calculando...
              </span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center">
              <div class="sm:col-span-3 flex items-center gap-3">
                <div class="relative flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--surface-3)] border border-[var(--border-subtle)]">
                  <span id="readinessScoreVal" class="text-2xl font-black text-[var(--brand)]">--</span>
                  <span class="absolute -bottom-1 text-[9px] font-bold text-[var(--text-tertiary)] uppercase">Score</span>
                </div>
                <div>
                  <p class="text-[11px] font-semibold text-[var(--text-tertiary)]">Nivel de Recuperación</p>
                  <p id="readinessLabel" class="text-xs font-bold text-[var(--text-primary)]">--</p>
                </div>
              </div>
              <div class="sm:col-span-9 bg-[var(--surface-2)] border border-[var(--border-subtle)] rounded-xl p-3">
                <p id="readinessRecommendation" class="text-xs text-[var(--text-secondary)] leading-relaxed italic">
                  Registra tu bio-feedback diario para obtener recomendaciones de intensidad y volumen en tiempo real.
                </p>
              </div>
            </div>
          </div>

          <!-- Weight KPI Summary Cards -->
          <div id="weightSummaryCards" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Peso Inicial</span>
              <p id="kpiInitialWeight" class="mt-1 text-lg font-black text-[var(--text-primary)]">-- <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span></p>
            </div>
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Peso Actual</span>
              <p id="kpiCurrentWeight" class="mt-1 text-lg font-black text-emerald-400">-- <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span></p>
            </div>
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Variación Total</span>
              <p id="kpiWeightDiff" class="mt-1 text-lg font-black text-[var(--text-primary)]">--</p>
            </div>
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Tendencia 7D (Media)</span>
              <p id="kpiAvgWeight" class="mt-1 text-lg font-black text-cyan-400">-- <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span></p>
            </div>
          </div>

          <!-- Interactive Trend Chart Card -->
          <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-5 backdrop-blur-xl space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">Curva de Peso Real vs Promedio Móvil 7D</h3>
                <p class="text-xs text-[var(--text-tertiary)] mt-0.5">El promedio móvil (línea cyan) filtra las retenciones de agua y muestra tu progreso real</p>
              </div>
              <div class="flex items-center gap-1.5 self-start sm:self-auto">
                <button type="button" class="chart-range-btn active rounded-lg bg-[var(--surface-3)] px-2.5 py-1 text-[11px] font-bold text-[var(--brand)] border border-[var(--border-brand)]/30" data-range="7">7D</button>
                <button type="button" class="chart-range-btn rounded-lg bg-[var(--surface-4)] px-2.5 py-1 text-[11px] font-medium text-[var(--text-tertiary)] hover:text-white" data-range="30">30D</button>
                <button type="button" class="chart-range-btn rounded-lg bg-[var(--surface-4)] px-2.5 py-1 text-[11px] font-medium text-[var(--text-tertiary)] hover:text-white" data-range="all">Todo</button>
              </div>
            </div>
            <div class="relative h-48 w-full">
              <canvas id="weightTrendCanvas" class="h-full w-full"></canvas>
            </div>
            <div class="flex items-center justify-center gap-6 pt-1 text-[11px] text-[var(--text-tertiary)]">
              <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-emerald-400"></span> Peso Diario</span>
              <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-cyan-400"></span> Tendencia 7D (Media Móvil)</span>
            </div>
          </div>

          <!-- Register Weight Card -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">Registrar Peso Corporal</h3>
                <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Controla tu evolución diaria con notas de contexto y protección anti-duplicados</p>
              </div>
              <span class="rounded-full bg-[var(--brand-dim)] text-[var(--brand)] px-2.5 py-0.5 text-[10px] font-bold border border-[var(--border-brand)]/30">⚖️ Seguimiento</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
              <div class="sm:col-span-3">
                <label for="weightDateInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Fecha</label>
                <input
                  id="weightDateInput"
                  type="date"
                  class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none transition-all focus:border-[var(--border-brand)]"
                />
              </div>
              <div class="sm:col-span-3">
                <label for="weightInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Peso (kg) *</label>
                <input
                  id="weightInput"
                  type="number"
                  step="0.1"
                  min="20"
                  max="350"
                  placeholder="Ej: 75.5"
                  class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)]"
                />
              </div>
              <div class="sm:col-span-4">
                <label for="weightNotesInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Notas / Contexto (Opcional)</label>
                <input
                  id="weightNotesInput"
                  type="text"
                  placeholder="Ej: En ayunas tras cardio"
                  class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)]"
                />
              </div>
              <div class="sm:col-span-2 flex items-end">
                <button
                  id="saveWeightBtn"
                  type="button"
                  class="w-full flex items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-[var(--brand)] to-emerald-400 py-2.5 text-xs font-bold text-[var(--text-on-brand)] shadow-md transition-all hover:opacity-90 active:scale-95 disabled:opacity-50"
                >
                  <span id="saveWeightBtnText">Guardar</span>
                  <span>⚖️</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Weight History -->
          <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">Historial de Registros</h3>
                <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Edita valores erróneos o elimina registros no deseados</p>
              </div>
              <span id="weightCountBadge" class="text-xs font-bold text-[var(--text-tertiary)] bg-[var(--surface-3)] px-2.5 py-1 rounded-lg">0 registros</span>
            </div>
            <div id="weightHistory" class="space-y-2.5">
              <p class="text-sm text-[var(--text-disabled)]">Sin registros de peso aún.</p>
            </div>
          </div>
        </div>

        <!-- Measurements Tab -->
        <div id="measurementsTab" class="hidden space-y-5">
          <!-- Measurements KPI Summary -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Pecho / Torso</span>
              <p id="kpiChest" class="mt-1 text-lg font-black text-[var(--text-primary)]">-- <span class="text-xs font-normal text-[var(--text-tertiary)]">cm</span></p>
            </div>
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Cintura</span>
              <p id="kpiWaist" class="mt-1 text-lg font-black text-amber-400">-- <span class="text-xs font-normal text-[var(--text-tertiary)]">cm</span></p>
            </div>
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Cadera / Glúteo</span>
              <p id="kpiHips" class="mt-1 text-lg font-black text-cyan-400">-- <span class="text-xs font-normal text-[var(--text-tertiary)]">cm</span></p>
            </div>
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Bíceps Promedio</span>
              <p id="kpiArms" class="mt-1 text-lg font-black text-purple-400">-- <span class="text-xs font-normal text-[var(--text-tertiary)]">cm</span></p>
            </div>
          </div>

          <!-- Register Measurements Card -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">Registrar Perímetros Corporales</h3>
                <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Medición antropométrica en centímetros (cm) con cinta métrica</p>
              </div>
              <span class="rounded-full bg-cyan-500/10 text-cyan-400 px-2.5 py-0.5 text-[10px] font-bold border border-cyan-500/20">📏 Antropometría</span>
            </div>

            <form id="measurementsForm" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label for="measDateInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Fecha de Medición</label>
                  <input id="measDateInput" type="date" required class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
                </div>
                <div>
                  <label for="measChestInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Pecho / Pectoral (cm)</label>
                  <input id="measChestInput" type="number" step="0.5" min="40" max="250" placeholder="Ej: 102.5" class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
                </div>
                <div>
                  <label for="measWaistInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Cintura (cm) *</label>
                  <input id="measWaistInput" type="number" step="0.5" min="40" max="250" required placeholder="Ej: 82.0" class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
                </div>
              </div>

              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                  <label for="measHipsInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Cadera (cm)</label>
                  <input id="measHipsInput" type="number" step="0.5" min="40" max="250" placeholder="Ej: 98.0" class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
                </div>
                <div>
                  <label for="measArmLeftInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Bíceps Izq (cm)</label>
                  <input id="measArmLeftInput" type="number" step="0.5" min="15" max="80" placeholder="Ej: 36.5" class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
                </div>
                <div>
                  <label for="measArmRightInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Bíceps Der (cm)</label>
                  <input id="measArmRightInput" type="number" step="0.5" min="15" max="80" placeholder="Ej: 37.0" class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
                </div>
                <div>
                  <label for="measThighLeftInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Muslo Izq (cm)</label>
                  <input id="measThighLeftInput" type="number" step="0.5" min="20" max="120" placeholder="Ej: 58.0" class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label for="measThighRightInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Muslo Der (cm)</label>
                  <input id="measThighRightInput" type="number" step="0.5" min="20" max="120" placeholder="Ej: 58.5" class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
                </div>
                <div>
                  <label for="measCalvesInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Gemelos (cm)</label>
                  <input id="measCalvesInput" type="number" step="0.5" min="20" max="80" placeholder="Ej: 38.0" class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
                </div>
                <div>
                  <label for="measNotesInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Notas (Opcional)</label>
                  <input id="measNotesInput" type="text" placeholder="Ej: En ayunas, post descanso" class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
                </div>
              </div>

              <div class="flex justify-end pt-1">
                <button
                  id="saveMeasBtn"
                  type="submit"
                  class="flex items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-500 px-6 py-2.5 text-xs font-bold text-white shadow-md transition-all hover:opacity-90 active:scale-95 disabled:opacity-50"
                >
                  <span id="saveMeasBtnText">Guardar Medidas</span>
                  <span>📏</span>
                </button>
              </div>
            </form>
          </div>

          <!-- Measurements History -->
          <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">Historial de Perímetros</h3>
                <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Control de ganancias y reducción por grupo muscular</p>
              </div>
              <span id="measCountBadge" class="text-xs font-bold text-[var(--text-tertiary)] bg-[var(--surface-3)] px-2.5 py-1 rounded-lg">0 registros</span>
            </div>
            <div id="measurementsHistory" class="space-y-2.5">
              <p class="text-sm text-[var(--text-disabled)]">Sin registros de perímetros aún.</p>
            </div>
          </div>
        </div>

        <!-- Bio-Feedback Tab -->
        <div id="biofeedbackTab" class="hidden space-y-5">
          <!-- Bio-Feedback KPI Summary -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Sueño Promedio</span>
              <p id="kpiSleep" class="mt-1 text-lg font-black text-indigo-400">-- <span class="text-xs font-normal text-[var(--text-tertiary)]">h</span></p>
            </div>
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Nivel de Energía</span>
              <p id="kpiEnergy" class="mt-1 text-lg font-black text-amber-400">-- <span class="text-xs font-normal text-[var(--text-tertiary)]">/10</span></p>
            </div>
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Estrés Percibido</span>
