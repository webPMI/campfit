---
import ClientLayout from '@/layouts/ClientLayout.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<ClientLayout>
  <div id="loadingScreen" class="flex min-h-screen items-center justify-center">
    <div class="text-center animate-fade-in">
      <div class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-[var(--border-strong)] border-t-emerald-400"></div>
      <p id="loadingText" class="mt-4 text-sm text-[var(--text-tertiary)]">{t('dashboard.loading')}</p>
    </div>
  </div>

  <div id="progressContent" class="hidden">
    <main class="mx-auto max-w-4xl px-4 py-6">
      <div class="animate-fade-in space-y-6">
        <!-- Header -->
        <div>
          <h2 class="text-xl font-bold">{t('dashboard.progress')}</h2>
          <p class="mt-1 text-sm text-[var(--text-tertiary)]">{t('dashboard.progress.desc')}</p>
        </div>

        <!-- Tabs -->
        <div class="flex gap-2 border-b border-[var(--border-default)] pb-2">
          <button id="tabWeight" class="tab-btn active rounded-lg px-4 py-2 text-sm font-medium text-[var(--brand)] bg-[var(--brand-dim)] transition-all">Peso</button>
          <button id="tabPhotos" class="tab-btn rounded-lg px-4 py-2 text-sm font-medium text-[var(--text-tertiary)] hover:text-[var(--text-secondary)] transition-all">Fotos</button>
        </div>

        <!-- Weight Tab -->
        <div id="weightTab" class="space-y-4">
          <!-- Register Weight -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl">
            <h3 class="text-sm font-semibold text-[var(--text-secondary)] mb-4">Registrar peso</h3>
            <div class="flex gap-3">
              <input
                id="weightInput"
                type="number"
                step="0.1"
                placeholder="75.5"
                class="flex-1 rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)]"
              />
              <span class="flex items-center text-sm text-[var(--text-tertiary)]">{t('client.stats.kg')}</span>
              <button
                id="saveWeightBtn"
                class="rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand)] px-6 py-3 text-sm font-semibold text-[var(--text-on-brand)] shadow-lg shadow-[var(--shadow-glow-sm)] transition-all hover:from-[var(--brand-hover)] hover:to-[var(--brand)] active:scale-[0.98]"
              >
                Guardar
              </button>
            </div>
          </div>

          <!-- Weight History -->
          <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl">
            <h3 class="text-sm font-semibold text-[var(--text-secondary)] mb-4">Historial</h3>
            <div id="weightHistory" class="space-y-2">
              <p class="text-sm text-[var(--text-disabled)]">Sin registros de peso aún.</p>
            </div>
          </div>
        </div>

        <!-- Photos Tab (hidden by default) -->
        <div id="photosTab" class="hidden space-y-4">
          <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-[var(--border-default)] bg-[var(--surface-2)] p-12 text-center">
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--surface-4)]">
              <svg class="h-8 w-8 text-[var(--text-disabled)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z" />
              </svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-[var(--text-secondary)]">Próximamente</h3>
            <p class="mt-2 text-sm text-[var(--text-disabled)]">La subida de fotos de progreso estará disponible pronto.</p>
          </div>
        </div>
      </div>
    </main>
  </div>
</ClientLayout>

<script>
  import { initPage } from '@/lib/shared/initPage';
  import { subscribeToProgress, registerWeight } from '@/lib/client/progressService';
  import { t } from '@/i18n/client';

  const loadingScreen = document.getElementById('loadingScreen')!;
  const loadingText = document.getElementById('loadingText')!;
  const progressContent = document.getElementById('progressContent')!;
  const tabWeight = document.getElementById('tabWeight')!;
  const tabPhotos = document.getElementById('tabPhotos')!;
  const weightTab = document.getElementById('weightTab')!;
  const photosTab = document.getElementById('photosTab')!;
  const weightInput = document.getElementById('weightInput') as HTMLInputElement;
  const saveWeightBtn = document.getElementById('saveWeightBtn')!;
  const weightHistory = document.getElementById('weightHistory')!;

  loadingText.textContent = t('dashboard.loading');

  // Tab switching
  function switchTab(tab: 'weight' | 'photos') {
    [tabWeight, tabPhotos].forEach(btn => {
      btn.classList.remove('text-[var(--brand)]', 'bg-[var(--brand-dim)]');
      btn.classList.add('text-[var(--text-tertiary)]');
    });
    if (tab === 'weight') {
      tabWeight.classList.add('text-[var(--brand)]', 'bg-[var(--brand-dim)]');
      tabWeight.classList.remove('text-[var(--text-tertiary)]');
      weightTab.classList.remove('hidden');
      photosTab.classList.add('hidden');
    } else {
      tabPhotos.classList.add('text-[var(--brand)]', 'bg-[var(--brand-dim)]');
      tabPhotos.classList.remove('text-[var(--text-tertiary)]');
      weightTab.classList.add('hidden');
      photosTab.classList.remove('hidden');
    }
  }

  tabWeight.addEventListener('click', () => switchTab('weight'));
  tabPhotos.addEventListener('click', () => switchTab('photos'));

  const cleanup = initPage({
    allowedRoles: ['client', 'admin', 'trainer'],
    onReady: async (firebaseUser) => {
      // Subscribe to weight logs
      subscribeToProgress(firebaseUser.uid, 'weight', (logs) => {
        if (logs.length > 0) {
          weightHistory.innerHTML = '';
          logs.forEach((log) => {
            const w = log.value?.weight;
            if (w) {
              const div = document.createElement('div');
              div.className = 'flex items-center justify-between rounded-lg bg-[var(--surface-4)] px-4 py-3';
              const date = (log.date && typeof (log.date as { toDate?: () => Date }).toDate === 'function'
                ? (log.date as { toDate: () => Date }).toDate().toLocaleDateString()
                : log.date instanceof Date
                  ? log.date.toLocaleDateString()
                  : 'Fecha');
              div.innerHTML = `
                <span class="text-sm text-[var(--text-secondary)]">${date}</span>
                <span class="text-sm font-semibold text-[var(--text-primary)]">${w} ${t('client.stats.kg')}</span>
              `;
              weightHistory.appendChild(div);
            }
          });
        } else {
          weightHistory.innerHTML = '<p class="text-sm text-[var(--text-disabled)]">Sin registros de peso aún.</p>';
        }
      });

      // Save weight
      saveWeightBtn.addEventListener('click', async () => {
        const val = parseFloat(weightInput.value);
        if (!val || val <= 0) return;
        try {
          await registerWeight(firebaseUser.uid, val);
          weightInput.value = '';
        } catch (err) {
          console.error('Error saving weight:', err);
        }
      });
    },
  });

  document.addEventListener('astro:before-swap', cleanup);
</script>
