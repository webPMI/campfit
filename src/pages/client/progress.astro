  function renderPhotosGallery(logs: ProgressLog[]) {
    cachedPhotoLogs = logs;
    renderFilteredGallery();
  }

  function getLogDateObject(logDate: any): Date {
    if (logDate && typeof logDate.toDate === "function") return logDate.toDate();
    if (logDate instanceof Date) return logDate;
    if (typeof logDate === "string" || typeof logDate === "number") return new Date(logDate);
    return new Date();
  }

  function drawWeightTrendChart(logs: ProgressLog[], range: '7' | '30' | 'all') {
    if (!weightTrendCanvas) return;
    const ctx = weightTrendCanvas.getContext('2d');
    if (!ctx) return;

    // Retina HiDPI scaling
    const rect = weightTrendCanvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    weightTrendCanvas.width = rect.width * dpr;
    weightTrendCanvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);

    const w = rect.width;
    const h = rect.height;
    ctx.clearRect(0, 0, w, h);

    if (!logs || logs.length === 0) {
      ctx.fillStyle = '#71717a';
      ctx.font = '12px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Añade registros de peso para visualizar la curva de tendencia', w / 2, h / 2);
      return;
    }

    // Sort chronologically ascending
    const chrono = [...logs]
      .filter(l => Number(l.value?.weight) > 0)
      .sort((a, b) => getLogDateObject(a.date).getTime() - getLogDateObject(b.date).getTime());

    if (chrono.length === 0) return;

    // Filter by selected range
    let filtered = chrono;
    if (range === '7') {
      const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
      filtered = chrono.filter(l => getLogDateObject(l.date) >= sevenDaysAgo);
      if (filtered.length < 2) filtered = chrono.slice(-7);
    } else if (range === '30') {
      const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
      filtered = chrono.filter(l => getLogDateObject(l.date) >= thirtyDaysAgo);
      if (filtered.length < 2) filtered = chrono.slice(-30);
    }

    const dataPoints = filtered.map(l => ({ date: getLogDateObject(l.date), value: Number(l.value?.weight) }));
    const maPoints = calculateMovingAverage(dataPoints, 7);

    // Find min and max for scaling
    const allValues = [
      ...dataPoints.map(p => p.value),
      ...maPoints.map(p => p.movingAverage)
    ];
    const minVal = Math.floor(Math.min(...allValues) - 1);
    const maxVal = Math.ceil(Math.max(...allValues) + 1);
    const rangeVal = Math.max(2, maxVal - minVal);

    const padding = { top: 20, right: 25, bottom: 25, left: 35 };
    const chartW = w - padding.left - padding.right;
    const chartH = h - padding.top - padding.bottom;

    const getX = (idx: number, total: number) => {
      if (total <= 1) return padding.left + chartW / 2;
      return padding.left + (idx / (total - 1)) * chartW;
    };

    const getY = (val: number) => {
      return padding.top + chartH - ((val - minVal) / rangeVal) * chartH;
    };

    // Draw grid lines
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.06)';
    ctx.lineWidth = 1;
    ctx.fillStyle = '#71717a';
    ctx.font = '10px Inter, sans-serif';
    ctx.textAlign = 'right';

    const gridSteps = 4;
    for (let i = 0; i <= gridSteps; i++) {
      const val = minVal + (i / gridSteps) * rangeVal;
      const y = getY(val);
      ctx.beginPath();
      ctx.moveTo(padding.left, y);
      ctx.lineTo(w - padding.right, y);
      ctx.stroke();
      ctx.fillText(`${val.toFixed(0)}k`, padding.left - 6, y + 3);
    }

    // 1. Draw Moving Average Line (Cyan with Glow)
    if (maPoints.length > 1) {
      ctx.save();
      ctx.strokeStyle = '#22d3ee';
      ctx.lineWidth = 2.5;
      ctx.shadowColor = 'rgba(34, 211, 238, 0.4)';
      ctx.shadowBlur = 8;
      ctx.beginPath();
      maPoints.forEach((p, idx) => {
        const x = getX(idx, maPoints.length);
        const y = getY(p.movingAverage);
        if (idx === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.restore();
    }

    // 2. Draw Daily Weight Line & Dots (Emerald)
    if (dataPoints.length > 0) {
      // Area Fill gradient
      const grad = ctx.createLinearGradient(0, padding.top, 0, h - padding.bottom);
      grad.addColorStop(0, 'rgba(52, 211, 153, 0.15)');
      grad.addColorStop(1, 'rgba(52, 211, 153, 0.0)');

      ctx.beginPath();
      dataPoints.forEach((p, idx) => {
        const x = getX(idx, dataPoints.length);
        const y = getY(p.value);
        if (idx === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.lineTo(getX(dataPoints.length - 1, dataPoints.length), h - padding.bottom);
      ctx.lineTo(getX(0, dataPoints.length), h - padding.bottom);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();

      // Stroke Line
      ctx.strokeStyle = '#34d399';
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      dataPoints.forEach((p, idx) => {
        const x = getX(idx, dataPoints.length);
        const y = getY(p.value);
        if (idx === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.stroke();

      // Point circles
      dataPoints.forEach((p, idx) => {
        const x = getX(idx, dataPoints.length);
        const y = getY(p.value);
        ctx.fillStyle = '#09090b';
        ctx.beginPath();
        ctx.arc(x, y, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#34d399';
        ctx.lineWidth = 2;
        ctx.stroke();
      });
    }

    // Draw date labels on X axis
    if (dataPoints.length > 0) {
      ctx.fillStyle = '#71717a';
      ctx.font = '9px Inter, sans-serif';
      ctx.textAlign = 'center';
      const firstX = getX(0, dataPoints.length);
      const lastX = getX(dataPoints.length - 1, dataPoints.length);
      const firstD = dataPoints[0]?.date.toLocaleDateString(undefined, { day: '2-digit', month: 'short' });
      const lastD = dataPoints[dataPoints.length - 1]?.date.toLocaleDateString(undefined, { day: '2-digit', month: 'short' });
      if (firstD) ctx.fillText(firstD, firstX + 8, h - 8);
      if (lastD && dataPoints.length > 1) ctx.fillText(lastD, lastX - 8, h - 8);
    }
  }

  // Chart range buttons listeners
  chartRangeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      chartRangeBtns.forEach(b => {
        b.classList.remove('active', 'bg-[var(--surface-3)]', 'text-[var(--brand)]', 'border', 'border-[var(--border-brand)]/30');
        b.classList.add('bg-[var(--surface-4)]', 'text-[var(--text-tertiary)]');
      });
      btn.classList.add('active', 'bg-[var(--surface-3)]', 'text-[var(--brand)]', 'border', 'border-[var(--border-brand)]/30');
      btn.classList.remove('bg-[var(--surface-4)]', 'text-[var(--text-tertiary)]');

      currentChartRange = (btn.dataset.range as '7' | '30' | 'all') || '7';
      drawWeightTrendChart(cachedWeightLogs, currentChartRange);
    });
  });

  function renderWeightLogs(logs: ProgressLog[]) {
    cachedWeightLogs = logs;

    if (weightCountBadge) {
      weightCountBadge.textContent = `${logs.length} ${logs.length === 1 ? 'registro' : 'registros'}`;
    }

    if (!logs || logs.length === 0) {
      weightHistory.innerHTML = '<p class="text-sm text-[var(--text-disabled)]">Sin registros de peso aún.</p>';
      if (kpiInitialWeight) kpiInitialWeight.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span>';
      if (kpiCurrentWeight) kpiCurrentWeight.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span>';
      if (kpiWeightDiff) kpiWeightDiff.textContent = '--';
      if (kpiAvgWeight) kpiAvgWeight.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span>';
      drawWeightTrendChart([], currentChartRange);
      return;
    }

    // Sort chronologically ascending for stats and moving average
    const chronoLogs = [...logs].sort((a, b) => getLogDateObject(a.date).getTime() - getLogDateObject(b.date).getTime());
    const oldestLog = chronoLogs[0];
    const newestLog = chronoLogs[chronoLogs.length - 1];

    const initialW = Number(oldestLog?.value?.weight) || 0;
    const currentW = Number(newestLog?.value?.weight) || 0;
    const diff = currentW - initialW;

    // Moving average of 7 days
    const dataPoints = chronoLogs
      .filter(l => Number(l.value?.weight) > 0)
      .map(l => ({ date: getLogDateObject(l.date), value: Number(l.value?.weight) }));
    
    const maPoints = calculateMovingAverage(dataPoints, 7);
    const latestMA = maPoints.length > 0 ? maPoints[maPoints.length - 1]?.movingAverage : currentW;

    if (kpiInitialWeight) kpiInitialWeight.innerHTML = `${initialW.toFixed(1)} <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span>`;
    if (kpiCurrentWeight) kpiCurrentWeight.innerHTML = `${currentW.toFixed(1)} <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span>`;
    
    if (kpiWeightDiff) {
      if (diff > 0) {
        kpiWeightDiff.className = "mt-1 text-lg font-black text-amber-400";
        kpiWeightDiff.textContent = `+${diff.toFixed(1)} kg`;
      } else if (diff < 0) {
        kpiWeightDiff.className = "mt-1 text-lg font-black text-emerald-400";
        kpiWeightDiff.textContent = `${diff.toFixed(1)} kg`;
      } else {
        kpiWeightDiff.className = "mt-1 text-lg font-black text-[var(--text-primary)]";
        kpiWeightDiff.textContent = `0.0 kg`;
      }
    }

    if (kpiAvgWeight && latestMA != null) {
      kpiAvgWeight.innerHTML = `${latestMA.toFixed(1)} <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span>`;
    }

    // Draw interactive trend chart
    drawWeightTrendChart(chronoLogs, currentChartRange);

    // Render list (descending)
    weightHistory.innerHTML = "";
    const descLogs = [...logs].sort((a, b) => getLogDateObject(b.date).getTime() - getLogDateObject(a.date).getTime());

    descLogs.forEach((log, idx) => {
      const w = Number(log.value?.weight);
      if (!w) return;
      const d = getLogDateObject(log.date);
      const formattedDate = d.toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' });
      const notes = (log.value?.notes as string) || '';

      // Delta compared to previous in chronological order
      const nextOlderLog = descLogs[idx + 1];
      let deltaBadge = '';
      if (nextOlderLog && nextOlderLog.value?.weight) {
        const prevW = Number(nextOlderLog.value.weight);
        const dW = w - prevW;
        if (dW > 0) {
          deltaBadge = `<span class="rounded bg-amber-500/10 px-1.5 py-0.5 text-[10px] font-bold text-amber-400 border border-amber-500/20">+${dW.toFixed(1)} kg</span>`;
        } else if (dW < 0) {
          deltaBadge = `<span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-[10px] font-bold text-emerald-400 border border-emerald-500/20">${dW.toFixed(1)} kg</span>`;
        } else {
          deltaBadge = `<span class="rounded bg-[var(--surface-3)] px-1.5 py-0.5 text-[10px] font-medium text-[var(--text-tertiary)]">= 0.0</span>`;
        }
      }

      const itemEl = document.createElement("div");
      itemEl.className = "flex items-center justify-between rounded-xl bg-[var(--surface-2)] border border-[var(--border-subtle)] px-4 py-3 hover:border-[var(--border-default)] transition-all";
      itemEl.innerHTML = `
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[var(--brand-dim)] text-xs font-bold text-[var(--brand)] border border-[var(--border-brand)]/20">
            ⚖️
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-sm font-bold text-[var(--text-primary)]">${w.toFixed(1)} kg</span>
              ${deltaBadge}
            </div>
            <p class="text-xs text-[var(--text-tertiary)]">${formattedDate}${notes ? ` • <span class="italic text-[var(--text-secondary)]">"${escapeHtml(notes)}"</span>` : ''}</p>
          </div>
        </div>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            class="btn-edit-weight rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] hover:bg-[var(--surface-4)] p-1.5 text-xs text-[var(--text-secondary)] hover:text-white transition-all"
            data-id="${log.id}"
            title="Editar registro"
          >
            ✏️
          </button>
          <button
            type="button"
            class="btn-delete-weight rounded-lg border border-rose-500/20 bg-rose-500/10 hover:bg-rose-500/20 p-1.5 text-xs text-rose-300 transition-all"
            data-id="${log.id}"
            title="Eliminar registro"
          >
            🗑️
          </button>
        </div>
      `;

      itemEl.querySelector('.btn-edit-weight')?.addEventListener('click', () => openEditWeightModal(log));
      itemEl.querySelector('.btn-delete-weight')?.addEventListener('click', () => confirmAndDeleteWeight(log.id));

      weightHistory.appendChild(itemEl);
    });
  }

  function openEditWeightModal(log: ProgressLog) {
    if (!editWeightModal || !editWeightLogId || !editWeightValue || !editWeightDate) return;
    editWeightLogId.value = log.id;
    editWeightValue.value = String(log.value?.weight || '');
    if (editWeightNotes) editWeightNotes.value = (log.value?.notes as string) || '';
    const d = getLogDateObject(log.date);
    editWeightDate.value = d.toISOString().split('T')[0] || '';
    editWeightModal.classList.remove('hidden');
  }

  function closeEditModal() {
    editWeightModal?.classList.add('hidden');
    editWeightForm?.reset();
  }

  closeEditWeightModal?.addEventListener('click', closeEditModal);
  cancelEditWeightBtn?.addEventListener('click', closeEditModal);

  editWeightForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const logId = editWeightLogId?.value;
    const newWeight = parseFloat(editWeightValue?.value || '0');
    const newNotes = editWeightNotes?.value || '';
    const dateStr = editWeightDate?.value;

    if (!logId || !newWeight || newWeight <= 0) {
      showToast({ message: 'Introduce un peso válido', type: 'error' });
      return;
    }

    if (submitEditWeightBtn) {
      submitEditWeightBtn.disabled = true;
      submitEditWeightBtn.textContent = 'Guardando...';
    }

    try {
      const newDate = dateStr ? new Date(dateStr + 'T12:00:00') : undefined;
      await updateWeightLog(logId, newWeight, newNotes, newDate);
      showToast({ message: 'Registro de peso actualizado con éxito', type: 'success' });
      closeEditModal();
