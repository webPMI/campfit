  const cleanup = initPage({
    allowedRoles: ["client", "admin", "trainer"],
    onReady: async (firebaseUser) => {
      currentUserId = firebaseUser.uid;

      const todayStr = new Date().toISOString().split('T')[0] || '';
      if (weightDateInput && !weightDateInput.value) weightDateInput.value = todayStr;
      if (measDateInput && !measDateInput.value) measDateInput.value = todayStr;
      if (bioDateInput && !bioDateInput.value) bioDateInput.value = todayStr;

      // Subscriptions
      subscribeToProgress(firebaseUser.uid, "weight", (logs) => {
        renderWeightLogs(logs);
      });

      subscribeToProgress(firebaseUser.uid, "measurements", (logs) => {
        renderMeasurementsLogs(logs);
      });

      subscribeToProgress(firebaseUser.uid, "biofeedback", (logs) => {
        renderBiofeedbackLogs(logs);
      });

      subscribeToProgress(firebaseUser.uid, "photo", (logs) => {
        renderPhotosGallery(logs);
      });

      // Save Weight
      saveWeightBtn?.addEventListener("click", async () => {
        const val = parseFloat(weightInput.value);
        const notes = weightNotesInput?.value?.trim() || '';
        const dateStr = weightDateInput?.value || todayStr;

        if (!val || val <= 0) {
          showToast({ message: 'Por favor, introduce un peso válido.', type: 'error' });
          weightInput.focus();
          return;
        }

        // Physiological validation check (>5% in 24h)
        const latestWeight = cachedWeightLogs.length > 0 ? Number(cachedWeightLogs[0]?.value?.weight) : null;
        if (latestWeight && latestWeight > 0) {
          const validation = validateWeightChangeSafety(latestWeight, val);
          if (validation.isSignificantChange && validation.warning) {
            const confirmed = await showConfirm({
              title: 'Aviso de Variación Fisiológica',
              message: validation.warning,
              confirmText: 'Sí, es correcto',
              cancelText: 'Revisar valor',
              variant: 'warning',
            });
            if (!confirmed) {
              return;
            }
          }
        }

        saveWeightBtn.setAttribute('disabled', 'true');
        if (saveWeightBtnText) saveWeightBtnText.textContent = 'Guardando...';

        try {
          const targetDateStr = dateStr;
          const existingSameDayLog = cachedWeightLogs.find(l => {
            const d = getLogDateObject(l.date);
            return (d.toISOString().split('T')[0] || '') === targetDateStr;
          });

          if (existingSameDayLog) {
            const logDate = new Date(targetDateStr + 'T12:00:00');
            await updateWeightLog(existingSameDayLog.id, val, notes, logDate);
            showToast({ message: 'Peso actualizado correctamente (sin duplicados)', type: 'success' });
          } else {
            await registerWeight(firebaseUser.uid, val, notes);
            showToast({ message: 'Peso registrado correctamente', type: 'success' });
          }

          weightInput.value = "";
          if (weightNotesInput) weightNotesInput.value = "";
        } catch (err) {
          logger.error("Progress", "Error saving weight:", err);
          showToast({ message: 'Error al registrar peso', type: 'error' });
        } finally {
          saveWeightBtn.removeAttribute('disabled');
          if (saveWeightBtnText) saveWeightBtnText.textContent = 'Guardar';
        }
      });

      // Save Measurements
      measurementsForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const dateStr = measDateInput?.value || todayStr;
        const waist = parseFloat(measWaistInput?.value || '0');

        if (!waist || waist <= 0) {
          showToast({ message: 'El perímetro de cintura es obligatorio', type: 'error' });
          return;
        }

        if (saveMeasBtn) {
          saveMeasBtn.disabled = true;
          if (saveMeasBtnText) saveMeasBtnText.textContent = 'Guardando...';
        }

        const measData: BodyMeasurements = {
          chest: measChestInput?.value ? parseFloat(measChestInput.value) : undefined,
          waist,
          hips: measHipsInput?.value ? parseFloat(measHipsInput.value) : undefined,
          leftArm: measArmLeftInput?.value ? parseFloat(measArmLeftInput.value) : undefined,
          rightArm: measArmRightInput?.value ? parseFloat(measArmRightInput.value) : undefined,
          leftThigh: measThighLeftInput?.value ? parseFloat(measThighLeftInput.value) : undefined,
          rightThigh: measThighRightInput?.value ? parseFloat(measThighRightInput.value) : undefined,
          calves: measCalvesInput?.value ? parseFloat(measCalvesInput.value) : undefined,
          notes: measNotesInput?.value?.trim() || undefined,
        };

        try {
          const targetDate = new Date(dateStr + 'T12:00:00');
          const existingSameDayLog = cachedMeasLogs.find(l => {
            const d = getLogDateObject(l.date);
            return (d.toISOString().split('T')[0] || '') === dateStr;
          });

          if (existingSameDayLog) {
            await updateMeasurementsLog(existingSameDayLog.id, measData, targetDate);
            showToast({ message: 'Medidas de hoy actualizadas (sin duplicados)', type: 'success' });
          } else {
            await registerMeasurements(firebaseUser.uid, measData, targetDate);
            showToast({ message: 'Medidas guardadas con éxito', type: 'success' });
          }

          measurementsForm.reset();
          if (measDateInput) measDateInput.value = todayStr;
        } catch (err) {
          logger.error('Progress', 'Error guardando medidas:', err);
          showToast({ message: 'Error al guardar medidas', type: 'error' });
        } finally {
          if (saveMeasBtn) {
            saveMeasBtn.disabled = false;
            if (saveMeasBtnText) saveMeasBtnText.textContent = 'Guardar Medidas';
          }
        }
      });

      // Save Bio-Feedback
      biofeedbackForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const dateStr = bioDateInput?.value || todayStr;

        if (saveBioBtn) {
          saveBioBtn.disabled = true;
          if (saveBioBtnText) saveBioBtnText.textContent = 'Guardando...';
        }

        const bioData: BioFeedback = {
          sleepHours: bioSleepInput?.value ? parseFloat(bioSleepInput.value) : undefined,
          sleepQuality: bioSleepQualInput?.value ? parseInt(bioSleepQualInput.value) : undefined,
          energyLevel: bioEnergyInput?.value ? parseInt(bioEnergyInput.value) : undefined,
          stressLevel: bioStressInput?.value ? parseInt(bioStressInput.value) : undefined,
          doms: (bioDomsInput?.value as any) || 'mild',
          waterLitres: bioWaterInput?.value ? parseFloat(bioWaterInput.value) : undefined,
          notes: bioNotesInput?.value?.trim() || undefined,
        };

        try {
          const targetDate = new Date(dateStr + 'T12:00:00');
          const existingSameDayLog = cachedBioLogs.find(l => {
            const d = getLogDateObject(l.date);
            return (d.toISOString().split('T')[0] || '') === dateStr;
          });

          if (existingSameDayLog) {
            await updateBioFeedbackLog(existingSameDayLog.id, bioData, targetDate);
            showToast({ message: 'Bio-Feedback de hoy actualizado (sin duplicados)', type: 'success' });
          } else {
            await registerBioFeedback(firebaseUser.uid, bioData, targetDate);
            showToast({ message: 'Bio-Feedback registrado correctamente', type: 'success' });
          }

          biofeedbackForm.reset();
          if (bioDateInput) bioDateInput.value = todayStr;
        } catch (err) {
          logger.error('Progress', 'Error guardando bio-feedback:', err);
          showToast({ message: 'Error al guardar bio-feedback', type: 'error' });
        } finally {
          if (saveBioBtn) {
            saveBioBtn.disabled = false;
            if (saveBioBtnText) saveBioBtnText.textContent = 'Guardar Bio-Feedback';
          }
        }
      });
    },
  });

  document.addEventListener("astro:before-swap", cleanup);
</script>
