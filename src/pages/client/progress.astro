---
import ClientLayout from "@/layouts/ClientLayout.astro";
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<ClientLayout>
  <div id="loadingScreen" class="flex min-h-screen items-center justify-center">
    <div class="text-center animate-fade-in">
      <div
        class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-[var(--border-strong)] border-t-emerald-400"
      >
      </div>
      <p id="loadingText" class="mt-4 text-sm text-[var(--text-tertiary)]">
        {t("dashboard.loading")}
      </p>
    </div>
  </div>

  <div id="progressContent" class="hidden">
    <main class="mx-auto max-w-4xl px-4 py-6">
      <div class="animate-fade-in space-y-6">
        <!-- Header -->
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div>
            <h2 data-i18n="dashboard.progress" class="text-xl font-bold text-[var(--text-primary)]">{t("dashboard.progress")}</h2>
            <p data-i18n="dashboard.progress.desc" class="mt-1 text-sm text-[var(--text-tertiary)]">{t("dashboard.progress.desc") || "Seguimiento de peso corporal y evolución física"}</p>
          </div>
          <div class="flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-400">
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Almacenamiento Seguro</span>
          </div>
        </div>

        <!-- Tabs -->
        <div class="flex gap-2 border-b border-[var(--border-default)] pb-2">
          <button
            id="tabWeight"
            data-i18n="client.progress.tabWeight"
            class="tab-btn active rounded-lg px-4 py-2 text-sm font-medium text-[var(--brand)] bg-[var(--brand-dim)] transition-all"
            >{t('client.progress.tabWeight') || "Peso Corporal"}</button
          >
          <button
            id="tabPhotos"
            data-i18n="client.progress.tabPhotos"
            class="tab-btn rounded-lg px-4 py-2 text-sm font-medium text-[var(--text-tertiary)] hover:text-[var(--text-secondary)] transition-all"
            >{t('client.progress.tabPhotos') || "Fotos de Evolución"}</button
          >
        </div>

        <!-- Weight Tab -->
        <div id="weightTab" class="space-y-5">
          <!-- Weight KPI Summary Cards -->
          <div id="weightSummaryCards" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Peso Inicial</span>
              <p id="kpiInitialWeight" class="mt-1 text-lg font-black text-[var(--text-primary)]">-- <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span></p>
            </div>
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Peso Actual</span>
              <p id="kpiCurrentWeight" class="mt-1 text-lg font-black text-emerald-400">-- <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span></p>
            </div>
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Variación Total</span>
              <p id="kpiWeightDiff" class="mt-1 text-lg font-black text-[var(--text-primary)]">--</p>
            </div>
            <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-4 backdrop-blur-xl shadow-sm">
              <span class="text-[10px] font-bold text-[var(--text-tertiary)] uppercase tracking-wider">Media Reciente</span>
              <p id="kpiAvgWeight" class="mt-1 text-lg font-black text-cyan-400">-- <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span></p>
            </div>
          </div>

          <!-- Register Weight Card -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">Registrar Peso Corporal</h3>
                <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Controla tu evolución diaria con notas de contexto y protección anti-duplicados</p>
              </div>
              <span class="rounded-full bg-[var(--brand-dim)] text-[var(--brand)] px-2.5 py-0.5 text-[10px] font-bold border border-[var(--border-brand)]/30">⚖️ Seguimiento</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
              <div class="sm:col-span-3">
                <label for="weightDateInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Fecha</label>
                <input
                  id="weightDateInput"
                  type="date"
                  class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none transition-all focus:border-[var(--border-brand)]"
                />
              </div>
              <div class="sm:col-span-3">
                <label for="weightInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Peso (kg) *</label>
                <input
                  id="weightInput"
                  type="number"
                  step="0.1"
                  min="20"
                  max="350"
                  placeholder="Ej: 75.5"
                  class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)]"
                />
              </div>
              <div class="sm:col-span-4">
                <label for="weightNotesInput" class="block text-[11px] font-semibold text-[var(--text-secondary)] mb-1">Notas / Contexto (Opcional)</label>
                <input
                  id="weightNotesInput"
                  type="text"
                  placeholder="Ej: En ayunas tras cardio"
                  class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)]"
                />
              </div>
              <div class="sm:col-span-2 flex items-end">
                <button
                  id="saveWeightBtn"
                  type="button"
                  class="w-full flex items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-[var(--brand)] to-emerald-400 py-2.5 text-xs font-bold text-[var(--text-on-brand)] shadow-md transition-all hover:opacity-90 active:scale-95 disabled:opacity-50"
                >
                  <span id="saveWeightBtnText">Guardar</span>
                  <span>⚖️</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Weight History -->
          <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">Historial de Registros</h3>
                <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Edita valores erróneos o elimina registros no deseados</p>
              </div>
              <span id="weightCountBadge" class="text-xs font-bold text-[var(--text-tertiary)] bg-[var(--surface-3)] px-2.5 py-1 rounded-lg">0 registros</span>
            </div>
            <div id="weightHistory" class="space-y-2.5">
              <p class="text-sm text-[var(--text-disabled)]">Sin registros de peso aún.</p>
            </div>
          </div>
        </div>

        <!-- Photos Tab -->
        <div id="photosTab" class="hidden space-y-6">
          <!-- Upload Photo Card -->
          <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="text-sm font-bold text-[var(--text-primary)]">Subir Nueva Foto de Evolución</h3>
                <p class="text-xs text-[var(--text-tertiary)] mt-0.5">Seguimiento visual de tu cambio físico</p>
              </div>
              <span class="rounded bg-purple-500/20 px-2 py-0.5 text-[10px] font-bold text-purple-300 border border-purple-500/30">Privado y Seguro</span>
            </div>

            <!-- Angle Selector -->
            <div class="mb-5">
              <div class="flex items-center justify-between mb-2">
                <label class="block text-xs font-bold text-[var(--text-primary)]">1. Selecciona el ángulo de la pose:</label>
                <span id="selectedAngleLabel" class="text-[11px] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md border border-emerald-500/20">🧍 Frontal (De Frente)</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <button
                  type="button"
                  data-angle="front"
                  class="photo-angle-btn active rounded-xl border-2 border-emerald-500 bg-emerald-500/15 p-3.5 text-left transition-all relative overflow-hidden group shadow-sm"
                >
                  <div class="flex items-center justify-between">
                    <span class="text-2xl">🧍</span>
                    <span class="angle-check text-[11px] font-bold text-emerald-400 bg-emerald-950/60 px-1.5 py-0.5 rounded border border-emerald-500/30">✓ ACTIVO</span>
                  </div>
                  <p class="mt-2 text-xs font-bold text-emerald-300">Foto Frontal</p>
                  <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5 leading-tight">De frente, brazos a los costados y postura erguida</p>
                </button>

                <button
                  type="button"
                  data-angle="side"
                  class="photo-angle-btn rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] p-3.5 text-left transition-all relative overflow-hidden group hover:border-cyan-500/60"
                >
                  <div class="flex items-center justify-between">
                    <span class="text-2xl">🚶</span>
                    <span class="angle-check hidden text-[11px] font-bold text-cyan-400 bg-cyan-950/60 px-1.5 py-0.5 rounded border border-cyan-500/30">✓ ACTIVO</span>
                  </div>
                  <p class="mt-2 text-xs font-bold text-[var(--text-primary)] group-hover:text-cyan-300">Foto de Perfil</p>
                  <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5 leading-tight">Giro lateral 90°, postura neutra y hombros alineados</p>
                </button>

                <button
                  type="button"
                  data-angle="back"
                  class="photo-angle-btn rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] p-3.5 text-left transition-all relative overflow-hidden group hover:border-purple-500/60"
                >
                  <div class="flex items-center justify-between">
                    <span class="text-2xl">👤</span>
                    <span class="angle-check hidden text-[11px] font-bold text-purple-400 bg-purple-950/60 px-1.5 py-0.5 rounded border border-purple-500/30">✓ ACTIVO</span>
                  </div>
                  <p class="mt-2 text-xs font-bold text-[var(--text-primary)] group-hover:text-purple-300">Foto de Espalda</p>
                  <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5 leading-tight">De espaldas a la cámara, dorsal y hombros relajados</p>
                </button>
              </div>
            </div>

            <!-- Drag & Drop Zone -->
            <div class="mb-2">
              <label class="block text-xs font-bold text-[var(--text-primary)] mb-2">2. Carga tu imagen:</label>
              <div
                id="photoDropzone"
                class="relative flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-[var(--border-default)] bg-[var(--surface-3)] p-6 text-center hover:border-[var(--brand)] transition-all cursor-pointer"
              >
                <input
                  id="photoFileInput"
                  type="file"
                  accept="image/jpeg,image/png,image/webp,image/heic"
                  class="hidden"
                />
                <div id="dropzonePrompt" class="space-y-2">
                  <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[var(--surface-4)] text-3xl shadow-inner">
                    📸
                  </div>
                  <p class="text-xs font-bold text-[var(--text-primary)]" id="dropzonePromptTitle">Toca para seleccionar tu Foto Frontal</p>
                  <p class="text-[11px] text-[var(--text-tertiary)]">Formatos JPG, PNG, HEIC o WebP hasta 20MB</p>
                </div>

                <!-- Preview -->
                <div id="photoPreviewContainer" class="hidden w-full flex-col items-center space-y-3">
                  <div id="previewAngleBadge" class="flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                    <span>🧍</span>
                    <span id="previewAngleText">Foto Frontal seleccionada</span>
                  </div>
                  <img id="photoPreviewImg" class="max-h-64 rounded-xl object-contain shadow-2xl border border-[var(--border-subtle)]" />
                  <button id="btnRemoveSelectedPhoto" type="button" class="text-xs font-semibold text-rose-400 hover:text-rose-300 bg-rose-500/10 px-3 py-1 rounded-lg border border-rose-500/20">✕ Cambiar foto</button>
                </div>
              </div>
            </div>

            <!-- Notes -->
            <div class="mt-4">
              <label class="block text-xs font-medium text-[var(--text-secondary)] mb-1">3. Notas de sensaciones o medidas (opcional):</label>
              <input
                id="photoNotesInput"
                type="text"
                placeholder="Ej: Semana 4 de definición, en ayunas..."
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--brand)]"
              />
            </div>

            <!-- Submit Button -->
            <div class="mt-4 flex justify-end">
              <button
                id="btnUploadPhoto"
                disabled
                class="rounded-xl bg-[var(--brand)] hover:bg-[var(--brand-hover)] px-6 py-2.5 text-xs font-bold text-[var(--text-on-brand)] shadow-lg shadow-[var(--shadow-glow-sm)] transition-all disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-2"
              >
                <span>☁️</span>
                <span id="btnUploadPhotoText">Guardar Foto Frontal</span>
              </button>
            </div>
          </div>

          <!-- Photo Gallery & Timeline -->
          <div class="rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 backdrop-blur-xl space-y-4">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <div>
                <h3 class="text-sm font-bold text-[var(--text-secondary)]">Galería de Evolución</h3>
                <p class="text-[11px] text-[var(--text-tertiary)]">Historial clasificado de poses</p>
              </div>
              <span id="photoCount" class="text-xs text-[var(--text-tertiary)] font-mono">0 fotos</span>
            </div>

            <!-- Filtro de Galería por Ángulo -->
            <div class="flex items-center gap-1.5 flex-wrap border-b border-[var(--border-subtle)] pb-3">
              <button type="button" data-filter-angle="all" class="gallery-filter-btn active rounded-lg px-3 py-1 text-xs font-bold bg-[var(--brand-dim)] text-[var(--brand)] border border-[var(--border-brand)] transition-all">
                Todas
              </button>
              <button type="button" data-filter-angle="front" class="gallery-filter-btn rounded-lg px-3 py-1 text-xs font-medium text-[var(--text-tertiary)] hover:text-white bg-[var(--surface-3)] border border-[var(--border-subtle)] transition-all">
                🧍 Frontal
              </button>
              <button type="button" data-filter-angle="side" class="gallery-filter-btn rounded-lg px-3 py-1 text-xs font-medium text-[var(--text-tertiary)] hover:text-white bg-[var(--surface-3)] border border-[var(--border-subtle)] transition-all">
                🚶 Perfil
              </button>
              <button type="button" data-filter-angle="back" class="gallery-filter-btn rounded-lg px-3 py-1 text-xs font-medium text-[var(--text-tertiary)] hover:text-white bg-[var(--surface-3)] border border-[var(--border-subtle)] transition-all">
                👤 Espalda
              </button>
            </div>
            
            <div id="photosGallery" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              <p class="col-span-full py-8 text-center text-xs text-[var(--text-disabled)]">Sin fotos de evolución registradas aún.</p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Fullscreen Photo Modal -->
  <div id="photoModal" class="fixed inset-0 z-50 hidden bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="relative max-w-3xl max-h-[90vh] flex flex-col items-center">
      <button id="closePhotoModal" class="absolute -top-10 right-0 text-white hover:text-zinc-300 text-sm font-bold">
        ✕ Cerrar
      </button>
      <img id="photoModalImg" src="" alt="Foto de evolución" class="max-h-[75vh] rounded-2xl object-contain shadow-2xl border border-zinc-700" />
      <div class="mt-3 flex items-center justify-between w-full px-2">
        <p id="photoModalCaption" class="text-xs text-zinc-300 font-medium"></p>
        <button
          id="btnDeletePhotoFromModal"
          type="button"
          class="rounded-lg bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 border border-rose-500/30 px-3 py-1 text-xs font-bold transition-all flex items-center gap-1.5"
        >
          <span>🗑️</span>
          <span>Eliminar foto</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Edit Weight Modal -->
  <div id="editWeightModal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
    <div class="relative w-full max-w-md rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-6 shadow-2xl backdrop-blur-2xl animate-scale-up">
      <button id="closeEditWeightModal" type="button" class="absolute top-4 right-4 text-[var(--text-tertiary)] hover:text-white text-sm font-bold p-1">✕</button>
      <div class="flex items-center gap-3 mb-4">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-400 text-xl border border-emerald-500/20">
          ✏️
        </div>
        <div>
          <h3 class="text-base font-bold text-[var(--text-primary)]">Editar Registro de Peso</h3>
          <p class="text-xs text-[var(--text-tertiary)]">Corrige la fecha, el valor o añade notas</p>
        </div>
      </div>
      <form id="editWeightForm" class="space-y-4">
        <input type="hidden" id="editWeightLogId" />
        <div>
          <label for="editWeightDate" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1">Fecha del registro</label>
          <input id="editWeightDate" type="date" required class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
        </div>
        <div>
          <label for="editWeightValue" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1">Peso (kg) *</label>
          <input id="editWeightValue" type="number" step="0.1" min="20" max="350" required class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
        </div>
        <div>
          <label for="editWeightNotes" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1">Notas / Contexto (Opcional)</label>
          <input id="editWeightNotes" type="text" placeholder="Ej: Tras cardio en ayunas" class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3.5 py-2.5 text-xs text-[var(--text-primary)] outline-none focus:border-[var(--border-brand)]" />
        </div>
        <div class="flex items-center justify-end gap-2 pt-2 border-t border-[var(--border-subtle)]">
          <button id="cancelEditWeightBtn" type="button" class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] px-4 py-2 text-xs font-medium text-[var(--text-secondary)] hover:bg-[var(--surface-4)] transition-all">Cancelar</button>
          <button id="submitEditWeightBtn" type="submit" class="rounded-xl bg-gradient-to-r from-[var(--brand)] to-emerald-400 px-4 py-2 text-xs font-bold text-[var(--text-on-brand)] shadow-md transition-all hover:opacity-90 active:scale-95">Guardar Cambios</button>
        </div>
      </form>
    </div>
  </div>
</ClientLayout>

<script>
  import { logger } from "@/lib/shared/logger";
  import { initPage } from "@/lib/shared/initPage";
  import { subscribeToProgress, registerWeight, updateWeightLog, registerProgressPhoto, deleteProgressLog, type ProgressLog } from "@/lib/client/progressService";
  import { uploadProgressPhotoToR2, validateImageFile } from "@/lib/storage/r2Service";
  import { showToast, showConfirm, escapeHtml } from "@/lib/shared/ui";
  import { t } from "@/i18n/client";

  const loadingScreen = document.getElementById("loadingScreen")!;
  const loadingText = document.getElementById("loadingText")!;
  const progressContent = document.getElementById("progressContent")!;
  const tabWeight = document.getElementById("tabWeight")!;
  const tabPhotos = document.getElementById("tabPhotos")!;
  const weightTab = document.getElementById("weightTab")!;
  const photosTab = document.getElementById("photosTab")!;

  // Weight form & KPI elements
  const weightInput = document.getElementById("weightInput") as HTMLInputElement;
  const weightDateInput = document.getElementById("weightDateInput") as HTMLInputElement | null;
  const weightNotesInput = document.getElementById("weightNotesInput") as HTMLInputElement | null;
  const saveWeightBtn = document.getElementById("saveWeightBtn")!;
  const saveWeightBtnText = document.getElementById("saveWeightBtnText") as HTMLSpanElement | null;
  const weightHistory = document.getElementById("weightHistory")!;
  const weightCountBadge = document.getElementById("weightCountBadge") as HTMLSpanElement | null;

  const kpiInitialWeight = document.getElementById("kpiInitialWeight") as HTMLParagraphElement | null;
  const kpiCurrentWeight = document.getElementById("kpiCurrentWeight") as HTMLParagraphElement | null;
  const kpiWeightDiff = document.getElementById("kpiWeightDiff") as HTMLParagraphElement | null;
  const kpiAvgWeight = document.getElementById("kpiAvgWeight") as HTMLParagraphElement | null;

  // Edit Weight Modal elements
  const editWeightModal = document.getElementById("editWeightModal") as HTMLDivElement | null;
  const closeEditWeightModal = document.getElementById("closeEditWeightModal") as HTMLButtonElement | null;
  const cancelEditWeightBtn = document.getElementById("cancelEditWeightBtn") as HTMLButtonElement | null;
  const editWeightForm = document.getElementById("editWeightForm") as HTMLFormElement | null;
  const editWeightLogId = document.getElementById("editWeightLogId") as HTMLInputElement | null;
  const editWeightDate = document.getElementById("editWeightDate") as HTMLInputElement | null;
  const editWeightValue = document.getElementById("editWeightValue") as HTMLInputElement | null;
  const editWeightNotes = document.getElementById("editWeightNotes") as HTMLInputElement | null;
  const submitEditWeightBtn = document.getElementById("submitEditWeightBtn") as HTMLButtonElement | null;

  let cachedWeightLogs: ProgressLog[] = [];

  // Photos elements
  const photoAngleBtns = document.querySelectorAll<HTMLButtonElement>('.photo-angle-btn');
  const photoDropzone = document.getElementById('photoDropzone');
  const photoFileInput = document.getElementById('photoFileInput') as HTMLInputElement | null;
  const dropzonePrompt = document.getElementById('dropzonePrompt');
  const photoPreviewContainer = document.getElementById('photoPreviewContainer');
  const photoPreviewImg = document.getElementById('photoPreviewImg') as HTMLImageElement | null;
  const btnRemoveSelectedPhoto = document.getElementById('btnRemoveSelectedPhoto');
  const photoNotesInput = document.getElementById('photoNotesInput') as HTMLInputElement | null;
  const btnUploadPhoto = document.getElementById('btnUploadPhoto') as HTMLButtonElement | null;
  const btnUploadPhotoText = document.getElementById('btnUploadPhotoText');
  const photosGallery = document.getElementById('photosGallery');
  const photoCount = document.getElementById('photoCount');

  // Modal elements
  const photoModal = document.getElementById('photoModal');
  const photoModalImg = document.getElementById('photoModalImg') as HTMLImageElement | null;
  const photoModalCaption = document.getElementById('photoModalCaption');
  const closePhotoModal = document.getElementById('closePhotoModal');

  let selectedAngle: 'front' | 'side' | 'back' = 'front';
  let selectedPhotoFile: File | null = null;
  let currentUserId = '';

  loadingText.textContent = t("dashboard.loading");

  // Tab switching
  function switchTab(tab: "weight" | "photos") {
    [tabWeight, tabPhotos].forEach((btn) => {
      btn.classList.remove("text-[var(--brand)]", "bg-[var(--brand-dim)]");
      btn.classList.add("text-[var(--text-tertiary)]");
    });
    if (tab === "weight") {
      tabWeight.classList.add("text-[var(--brand)]", "bg-[var(--brand-dim)]");
      tabWeight.classList.remove("text-[var(--text-tertiary)]");
      weightTab.classList.remove("hidden");
      photosTab.classList.add("hidden");
    } else {
      tabPhotos.classList.add("text-[var(--brand)]", "bg-[var(--brand-dim)]");
      tabPhotos.classList.remove("text-[var(--text-tertiary)]");
      weightTab.classList.add("hidden");
      photosTab.classList.remove("hidden");
    }
  }

  tabWeight?.addEventListener("click", () => switchTab("weight"));
  tabPhotos?.addEventListener("click", () => switchTab("photos"));

  // Angle selector details configuration
  const angleConfigs: Record<'front' | 'side' | 'back', {
    label: string;
    sublabel: string;
    emoji: string;
    btnText: string;
    promptTitle: string;
    badgeClass: string;
    borderClass: string;
    bgClass: string;
    textClass: string;
  }> = {
    front: {
      label: '🧍 Frontal (De Frente)',
      sublabel: 'Foto Frontal seleccionada',
      emoji: '🧍',
      btnText: 'Guardar Foto Frontal 🧍',
      promptTitle: 'Toca para seleccionar tu Foto Frontal',
      badgeClass: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30',
      borderClass: 'border-emerald-500',
      bgClass: 'bg-emerald-500/15',
      textClass: 'text-emerald-300',
    },
    side: {
      label: '🚶 Perfil (Lateral 90°)',
      sublabel: 'Foto de Perfil seleccionada',
      emoji: '🚶',
      btnText: 'Guardar Foto de Perfil 🚶',
      promptTitle: 'Toca para seleccionar tu Foto de Perfil',
      badgeClass: 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30',
      borderClass: 'border-cyan-500',
      bgClass: 'bg-cyan-500/15',
      textClass: 'text-cyan-300',
    },
    back: {
      label: '👤 Espalda (Posterior)',
      sublabel: 'Foto de Espalda seleccionada',
      emoji: '👤',
      btnText: 'Guardar Foto de Espalda 👤',
      promptTitle: 'Toca para seleccionar tu Foto de Espalda',
      badgeClass: 'bg-purple-500/20 text-purple-300 border-purple-500/30',
      borderClass: 'border-purple-500',
      bgClass: 'bg-purple-500/15',
      textClass: 'text-purple-300',
    },
  };

  const selectedAngleLabel = document.getElementById('selectedAngleLabel');
  const dropzonePromptTitle = document.getElementById('dropzonePromptTitle');
  const previewAngleBadge = document.getElementById('previewAngleBadge');
  const previewAngleText = document.getElementById('previewAngleText');
  const galleryFilterBtns = document.querySelectorAll<HTMLButtonElement>('.gallery-filter-btn');

  let activeFilterAngle: 'all' | 'front' | 'side' | 'back' = 'all';
  let cachedPhotoLogs: ProgressLog[] = [];

  function updateAngleUI(angle: 'front' | 'side' | 'back') {
    selectedAngle = angle;
    const config = angleConfigs[angle];

    // Actualizar botones de pose
    photoAngleBtns.forEach((b) => {
      const bAngle = b.dataset.angle as 'front' | 'side' | 'back';
      const check = b.querySelector('.angle-check');
      const bTitle = b.querySelector('p:first-of-type');

      b.className = 'photo-angle-btn rounded-xl p-3.5 text-left transition-all relative overflow-hidden group border-2 border-[var(--border-default)] bg-[var(--surface-3)]';
      check?.classList.add('hidden');
      if (bTitle) bTitle.className = 'mt-2 text-xs font-bold text-[var(--text-primary)]';

      if (bAngle === angle) {
        b.className = `photo-angle-btn active rounded-xl p-3.5 text-left transition-all relative overflow-hidden group border-2 ${config.borderClass} ${config.bgClass} shadow-sm`;
        check?.classList.remove('hidden');
        if (bTitle) bTitle.className = `mt-2 text-xs font-bold ${config.textClass}`;
      }
    });

    // Actualizar etiqueta superior
    if (selectedAngleLabel) {
      selectedAngleLabel.textContent = config.label;
      selectedAngleLabel.className = `text-[11px] font-bold px-2 py-0.5 rounded-md border ${config.badgeClass}`;
    }

    // Actualizar texto del dropzone
    if (dropzonePromptTitle) {
      dropzonePromptTitle.textContent = config.promptTitle;
    }

    // Actualizar badge de la previsualización
    if (previewAngleBadge && previewAngleText) {
      previewAngleBadge.className = `flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold border ${config.badgeClass}`;
      previewAngleText.textContent = `${config.emoji} ${config.sublabel}`;
    }

    // Actualizar texto del botón de subida
    if (btnUploadPhotoText && !btnUploadPhoto?.disabled) {
      btnUploadPhotoText.textContent = config.btnText;
    } else if (btnUploadPhotoText && btnUploadPhoto?.disabled) {
      btnUploadPhotoText.textContent = config.btnText;
    }
  }

  // Angle selector click handlers
  photoAngleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const angle = (btn.dataset.angle as 'front' | 'side' | 'back') || 'front';
      updateAngleUI(angle);
    });
  });

  // Filtro de galería por ángulo
  galleryFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      galleryFilterBtns.forEach((b) => {
        b.classList.remove('active', 'bg-[var(--brand-dim)]', 'text-[var(--brand)]', 'border-[var(--border-brand)]', 'font-bold');
        b.classList.add('bg-[var(--surface-3)]', 'text-[var(--text-tertiary)]', 'border-[var(--border-subtle)]', 'font-medium');
      });
      btn.classList.add('active', 'bg-[var(--brand-dim)]', 'text-[var(--brand)]', 'border-[var(--border-brand)]', 'font-bold');
      btn.classList.remove('bg-[var(--surface-3)]', 'text-[var(--text-tertiary)]', 'border-[var(--border-subtle)]', 'font-medium');
      
      activeFilterAngle = (btn.dataset.filterAngle as 'all' | 'front' | 'side' | 'back') || 'all';
      renderFilteredGallery();
    });
  });

  // Dropzone interactions
  photoDropzone?.addEventListener('click', () => {
    if (!selectedPhotoFile) {
      photoFileInput?.click();
    }
  });

  photoFileInput?.addEventListener('change', () => {
    if (photoFileInput.files && photoFileInput.files[0]) {
      handleFileSelected(photoFileInput.files[0]);
    }
  });

  function handleFileSelected(file: File) {
    const val = validateImageFile(file, 20);
    if (!val.valid) {
      showToast({ message: val.message || 'Archivo no válido', type: 'error' });
      return;
    }

    selectedPhotoFile = file;
    const objectUrl = URL.createObjectURL(file);
    if (photoPreviewImg) photoPreviewImg.src = objectUrl;

    const config = angleConfigs[selectedAngle];
    if (previewAngleBadge && previewAngleText) {
      previewAngleBadge.className = `flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold border ${config.badgeClass}`;
      previewAngleText.textContent = `${config.emoji} ${config.sublabel}`;
    }

    dropzonePrompt?.classList.add('hidden');
    photoPreviewContainer?.classList.remove('hidden');
    if (btnUploadPhoto) {
      btnUploadPhoto.disabled = false;
      if (btnUploadPhotoText) btnUploadPhotoText.textContent = config.btnText;
    }
  }

  btnRemoveSelectedPhoto?.addEventListener('click', (e) => {
    e.stopPropagation();
    selectedPhotoFile = null;
    if (photoFileInput) photoFileInput.value = '';
    dropzonePrompt?.classList.remove('hidden');
    photoPreviewContainer?.classList.add('hidden');
    if (btnUploadPhoto) btnUploadPhoto.disabled = true;
  });

  // Modal interactions
  closePhotoModal?.addEventListener('click', () => {
    photoModal?.classList.add('hidden');
  });
  photoModal?.addEventListener('click', (e) => {
    if (e.target === photoModal) photoModal.classList.add('hidden');
  });

  // Upload handler
  btnUploadPhoto?.addEventListener('click', async () => {
    if (!selectedPhotoFile || !currentUserId) return;

    const config = angleConfigs[selectedAngle];
    try {
      btnUploadPhoto.disabled = true;
      if (btnUploadPhotoText) btnUploadPhotoText.textContent = 'Subiendo foto...';
      console.log('📸 [ProgressPhotos] Subiendo foto de progreso:', {
        angulo: selectedAngle,
        nombre: selectedPhotoFile.name,
        tamaño: `${(selectedPhotoFile.size / (1024 * 1024)).toFixed(2)} MB`,
      });

      // 1. Subir imagen
      const uploadResult = await uploadProgressPhotoToR2(selectedPhotoFile, currentUserId, selectedAngle);

      // 2. Registrar en Firestore progress_logs
      const notes = photoNotesInput?.value?.trim() || '';
      await registerProgressPhoto(currentUserId, uploadResult.photoUrl, selectedAngle, notes);

      console.log('✅ [ProgressPhotos] Foto registrada exitosamente');
      showToast({ message: `Foto ${selectedAngle === 'front' ? 'frontal' : selectedAngle === 'side' ? 'de perfil' : 'de espalda'} guardada con éxito`, type: 'success' });

      // Reset form
      selectedPhotoFile = null;
      if (photoFileInput) photoFileInput.value = '';
      if (photoNotesInput) photoNotesInput.value = '';
      dropzonePrompt?.classList.remove('hidden');
      photoPreviewContainer?.classList.add('hidden');
      btnUploadPhoto.disabled = true;
    } catch (err) {
      console.error('❌ [ProgressPhotos] Error al subir foto:', err);
      logger.error('Progress', 'Error subiendo foto de evolución:', err);
      showToast({ message: 'Error al subir la foto de progreso', type: 'error' });
    } finally {
      if (btnUploadPhotoText) btnUploadPhotoText.textContent = config.btnText;
    }
  });

  function renderFilteredGallery() {
    if (!photosGallery) return;

    const filtered = activeFilterAngle === 'all'
      ? cachedPhotoLogs
      : cachedPhotoLogs.filter(log => (log.value?.angle as string) === activeFilterAngle);

    if (photoCount) {
      photoCount.textContent = `${filtered.length} ${filtered.length === 1 ? 'foto' : 'fotos'}${activeFilterAngle !== 'all' ? ' (' + activeFilterAngle + ')' : ''}`;
    }

    if (!filtered.length) {
      photosGallery.innerHTML = '<p class="col-span-full py-8 text-center text-xs text-[var(--text-disabled)]">Sin fotos en esta pose aún.</p>';
      return;
    }

    const angleBadgesMap: Record<string, { label: string; badge: string }> = {
      front: { label: '🧍 Frontal', badge: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30' },
      side: { label: '🚶 Perfil', badge: 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30' },
      back: { label: '👤 Espalda', badge: 'bg-purple-500/20 text-purple-300 border-purple-500/30' },
    };

    photosGallery.innerHTML = filtered.map((log) => {
      const pUrl = (log.value?.photoUrl as string) || '';
      const angle = (log.value?.angle as string) || 'front';
      const notes = (log.value?.notes as string) || '';
      const badgeInfo = angleBadgesMap[angle] || { label: angle, badge: 'bg-zinc-800 text-zinc-300 border-zinc-700' };

      const dateStr =
        log.date && typeof (log.date as { toDate?: () => Date }).toDate === "function"
          ? (log.date as { toDate: () => Date }).toDate().toLocaleDateString()
          : log.date instanceof Date
            ? log.date.toLocaleDateString()
            : "Fecha";

      return `
        <div class="group relative overflow-hidden rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-3)] hover:border-[var(--border-brand)] transition-all cursor-pointer shadow-md" data-log-id="${escapeHtml(log.id)}" data-url="${escapeHtml(pUrl)}" data-caption="${escapeHtml(badgeInfo.label)} · ${escapeHtml(dateStr)} ${notes ? '· ' + escapeHtml(notes) : ''}">
          <div class="aspect-[3/4] w-full overflow-hidden bg-black/50 relative">
            <img
              src="${escapeHtml(pUrl)}"
              alt="${escapeHtml(badgeInfo.label)}"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
            <span class="absolute top-2 left-2 rounded-md px-2 py-0.5 text-[10px] font-bold border backdrop-blur-md ${badgeInfo.badge}">${escapeHtml(badgeInfo.label)}</span>
            <button
              type="button"
              class="btn-delete-card-photo absolute top-2 right-2 h-7 w-7 rounded-lg bg-black/60 hover:bg-rose-600/90 text-white/80 hover:text-white transition-all flex items-center justify-center backdrop-blur-md border border-white/10 shadow-sm opacity-80 hover:opacity-100"
              data-log-id="${escapeHtml(log.id)}"
              title="Eliminar foto"
            >
              🗑️
            </button>
          </div>
          <div class="p-3">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono text-[var(--text-tertiary)]">${escapeHtml(dateStr)}</span>
            </div>
            ${notes ? `<p class="mt-1.5 text-xs text-[var(--text-secondary)] line-clamp-2">${escapeHtml(notes)}</p>` : ''}
          </div>
        </div>
      `;
    }).join('');

    photosGallery.querySelectorAll('[data-url]').forEach((card) => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.btn-delete-card-photo')) return;
        const url = (card as HTMLElement).dataset.url;
        const caption = (card as HTMLElement).dataset.caption;
        const logId = (card as HTMLElement).dataset.logId;
        currentModalPhotoId = logId || null;
        if (url && photoModal && photoModalImg) {
          photoModalImg.src = url;
          if (photoModalCaption) photoModalCaption.textContent = caption || '';
          photoModal.classList.remove('hidden');
        }
      });
    });

    photosGallery.querySelectorAll('.btn-delete-card-photo').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const logId = (btn as HTMLElement).dataset.logId;
        if (!logId) return;
        await confirmAndDeletePhoto(logId);
      });
    });
  }

  let currentModalPhotoId: string | null = null;
  const btnDeletePhotoFromModal = document.getElementById('btnDeletePhotoFromModal');

  btnDeletePhotoFromModal?.addEventListener('click', async () => {
    if (!currentModalPhotoId) return;
    const deleted = await confirmAndDeletePhoto(currentModalPhotoId);
    if (deleted) {
      photoModal?.classList.add('hidden');
    }
  });

  async function confirmAndDeletePhoto(logId: string): Promise<boolean> {
    const confirmed = await showConfirm({
      title: '¿Eliminar foto de evolución?',
      message: '¿Estás seguro de que deseas eliminar esta fotografía? Esta acción no se puede deshacer.',
      confirmText: 'Sí, eliminar',
      cancelText: 'Cancelar',
      variant: 'danger',
    });

    if (!confirmed) return false;

    try {
      await deleteProgressLog(logId);
      showToast({ message: 'Foto eliminada con éxito', type: 'success' });
      return true;
    } catch (err) {
      logger.error('Progress', 'Error al eliminar foto:', err);
      showToast({ message: 'Error al eliminar la fotografía', type: 'error' });
      return false;
    }
  }

  function renderPhotosGallery(logs: ProgressLog[]) {
    cachedPhotoLogs = logs;
    renderFilteredGallery();
  }

  function getLogDateObject(logDate: any): Date {
    if (logDate && typeof logDate.toDate === "function") return logDate.toDate();
    if (logDate instanceof Date) return logDate;
    if (typeof logDate === "string" || typeof logDate === "number") return new Date(logDate);
    return new Date();
  }

  function renderWeightLogs(logs: ProgressLog[]) {
    cachedWeightLogs = logs;

    if (weightCountBadge) {
      weightCountBadge.textContent = `${logs.length} ${logs.length === 1 ? 'registro' : 'registros'}`;
    }

    if (!logs || logs.length === 0) {
      weightHistory.innerHTML = '<p class="text-sm text-[var(--text-disabled)]">Sin registros de peso aún.</p>';
      if (kpiInitialWeight) kpiInitialWeight.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span>';
      if (kpiCurrentWeight) kpiCurrentWeight.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span>';
      if (kpiWeightDiff) kpiWeightDiff.textContent = '--';
      if (kpiAvgWeight) kpiAvgWeight.innerHTML = '-- <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span>';
      return;
    }

    // Sort chronologically ascending for stats
    const chronoLogs = [...logs].sort((a, b) => getLogDateObject(a.date).getTime() - getLogDateObject(b.date).getTime());
    const oldestLog = chronoLogs[0];
    const newestLog = chronoLogs[chronoLogs.length - 1];

    const initialW = Number(oldestLog?.value?.weight) || 0;
    const currentW = Number(newestLog?.value?.weight) || 0;
    const diff = currentW - initialW;

    // Recent 7 entries average
    const recentLogs = chronoLogs.slice(-7);
    const avgW = recentLogs.reduce((acc, l) => acc + (Number(l.value?.weight) || 0), 0) / recentLogs.length;

    if (kpiInitialWeight) kpiInitialWeight.innerHTML = `${initialW.toFixed(1)} <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span>`;
    if (kpiCurrentWeight) kpiCurrentWeight.innerHTML = `${currentW.toFixed(1)} <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span>`;
    
    if (kpiWeightDiff) {
      if (diff > 0) {
        kpiWeightDiff.className = "mt-1 text-lg font-black text-amber-400";
        kpiWeightDiff.textContent = `+${diff.toFixed(1)} kg`;
      } else if (diff < 0) {
        kpiWeightDiff.className = "mt-1 text-lg font-black text-emerald-400";
        kpiWeightDiff.textContent = `${diff.toFixed(1)} kg`;
      } else {
        kpiWeightDiff.className = "mt-1 text-lg font-black text-[var(--text-primary)]";
        kpiWeightDiff.textContent = `0.0 kg`;
      }
    }

    if (kpiAvgWeight) kpiAvgWeight.innerHTML = `${avgW.toFixed(1)} <span class="text-xs font-normal text-[var(--text-tertiary)]">kg</span>`;

    // Render list (descending)
    weightHistory.innerHTML = "";
    const descLogs = [...logs].sort((a, b) => getLogDateObject(b.date).getTime() - getLogDateObject(a.date).getTime());

    descLogs.forEach((log, idx) => {
      const w = Number(log.value?.weight);
      if (!w) return;
      const d = getLogDateObject(log.date);
      const formattedDate = d.toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' });
      const notes = (log.value?.notes as string) || '';

      // Delta compared to previous in chronological order
      const nextOlderLog = descLogs[idx + 1];
      let deltaBadge = '';
      if (nextOlderLog && nextOlderLog.value?.weight) {
        const prevW = Number(nextOlderLog.value.weight);
        const dW = w - prevW;
        if (dW > 0) {
          deltaBadge = `<span class="rounded bg-amber-500/10 px-1.5 py-0.5 text-[10px] font-bold text-amber-400 border border-amber-500/20">+${dW.toFixed(1)} kg</span>`;
        } else if (dW < 0) {
          deltaBadge = `<span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-[10px] font-bold text-emerald-400 border border-emerald-500/20">${dW.toFixed(1)} kg</span>`;
        } else {
          deltaBadge = `<span class="rounded bg-[var(--surface-3)] px-1.5 py-0.5 text-[10px] font-medium text-[var(--text-tertiary)]">= 0.0</span>`;
        }
      }

      const itemEl = document.createElement("div");
      itemEl.className = "flex items-center justify-between rounded-xl bg-[var(--surface-2)] border border-[var(--border-subtle)] px-4 py-3 hover:border-[var(--border-default)] transition-all";
      itemEl.innerHTML = `
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[var(--brand-dim)] text-xs font-bold text-[var(--brand)] border border-[var(--border-brand)]/20">
            ⚖️
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-sm font-bold text-[var(--text-primary)]">${w.toFixed(1)} kg</span>
              ${deltaBadge}
            </div>
            <p class="text-xs text-[var(--text-tertiary)]">${formattedDate}${notes ? ` • <span class="italic text-[var(--text-secondary)]">"${escapeHtml(notes)}"</span>` : ''}</p>
          </div>
        </div>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            class="btn-edit-weight rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] hover:bg-[var(--surface-4)] p-1.5 text-xs text-[var(--text-secondary)] hover:text-white transition-all"
            data-id="${log.id}"
            title="Editar registro"
          >
            ✏️
          </button>
          <button
            type="button"
            class="btn-delete-weight rounded-lg border border-rose-500/20 bg-rose-500/10 hover:bg-rose-500/20 p-1.5 text-xs text-rose-300 transition-all"
            data-id="${log.id}"
            title="Eliminar registro"
          >
            🗑️
          </button>
        </div>
      `;

      itemEl.querySelector('.btn-edit-weight')?.addEventListener('click', () => openEditWeightModal(log));
      itemEl.querySelector('.btn-delete-weight')?.addEventListener('click', () => confirmAndDeleteWeight(log.id));

      weightHistory.appendChild(itemEl);
    });
  }

  function openEditWeightModal(log: ProgressLog) {
    if (!editWeightModal || !editWeightLogId || !editWeightValue || !editWeightDate) return;
    editWeightLogId.value = log.id;
    editWeightValue.value = String(log.value?.weight || '');
    if (editWeightNotes) editWeightNotes.value = (log.value?.notes as string) || '';
    const d = getLogDateObject(log.date);
    editWeightDate.value = d.toISOString().split('T')[0] || '';
    editWeightModal.classList.remove('hidden');
  }

  function closeEditModal() {
    editWeightModal?.classList.add('hidden');
    editWeightForm?.reset();
  }

  closeEditWeightModal?.addEventListener('click', closeEditModal);
  cancelEditWeightBtn?.addEventListener('click', closeEditModal);

  editWeightForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const logId = editWeightLogId?.value;
    const newWeight = parseFloat(editWeightValue?.value || '0');
    const newNotes = editWeightNotes?.value || '';
    const dateStr = editWeightDate?.value;

    if (!logId || !newWeight || newWeight <= 0) {
      showToast({ message: 'Introduce un peso válido', type: 'error' });
      return;
    }

    if (submitEditWeightBtn) {
      submitEditWeightBtn.disabled = true;
      submitEditWeightBtn.textContent = 'Guardando...';
    }

    try {
      const newDate = dateStr ? new Date(dateStr + 'T12:00:00') : undefined;
      await updateWeightLog(logId, newWeight, newNotes, newDate);
      showToast({ message: 'Registro de peso actualizado con éxito', type: 'success' });
      closeEditModal();
    } catch (err) {
      logger.error('Progress', 'Error al actualizar peso:', err);
      showToast({ message: 'Error al actualizar el registro', type: 'error' });
    } finally {
      if (submitEditWeightBtn) {
        submitEditWeightBtn.disabled = false;
        submitEditWeightBtn.textContent = 'Guardar Cambios';
      }
    }
  });

  async function confirmAndDeleteWeight(logId: string): Promise<boolean> {
    const confirmed = await showConfirm({
      title: '¿Eliminar registro de peso?',
      message: '¿Estás seguro de que deseas eliminar este registro? Esta acción no se puede deshacer.',
      confirmText: 'Sí, eliminar',
      cancelText: 'Cancelar',
      variant: 'danger',
    });

    if (!confirmed) return false;

    try {
      await deleteProgressLog(logId);
      showToast({ message: 'Registro de peso eliminado', type: 'success' });
      return true;
    } catch (err) {
      logger.error('Progress', 'Error al eliminar peso:', err);
      showToast({ message: 'Error al eliminar el registro', type: 'error' });
      return false;
    }
  }

  const cleanup = initPage({
    allowedRoles: ["client", "admin", "trainer"],
    onReady: async (firebaseUser) => {
      currentUserId = firebaseUser.uid;

      if (weightDateInput && !weightDateInput.value) {
        weightDateInput.value = new Date().toISOString().split('T')[0] || '';
      }

      // Subscribe to weight logs
      subscribeToProgress(firebaseUser.uid, "weight", (logs) => {
        renderWeightLogs(logs);
      });

      // Subscribe to photo evolution logs
      subscribeToProgress(firebaseUser.uid, "photo", (logs) => {
        renderPhotosGallery(logs);
      });

      // Save weight with debounce and duplicate protection
      saveWeightBtn.addEventListener("click", async () => {
        const val = parseFloat(weightInput.value);
        const notes = weightNotesInput?.value?.trim() || '';
        const dateStr = weightDateInput?.value || new Date().toISOString().split('T')[0];

        if (!val || val <= 0) {
          showToast({ message: 'Por favor, introduce un peso válido.', type: 'error' });
          weightInput.focus();
          return;
        }

        saveWeightBtn.setAttribute('disabled', 'true');
        if (saveWeightBtnText) saveWeightBtnText.textContent = 'Guardando...';

        try {
          // Anti-duplicados: Comprobar si ya existe un registro en la misma fecha
          const targetDateStr = dateStr;
          const existingSameDayLog = cachedWeightLogs.find(l => {
            const d = getLogDateObject(l.date);
            return d.toISOString().split('T')[0] === targetDateStr;
          });

          if (existingSameDayLog) {
            // Actualizar el registro existente de ese día
            const logDate = new Date(targetDateStr + 'T12:00:00');
            await updateWeightLog(existingSameDayLog.id, val, notes, logDate);
            showToast({ message: 'Peso de hoy actualizado correctamente (sin duplicados)', type: 'success' });
          } else {
            // Crear nuevo registro
            await registerWeight(firebaseUser.uid, val, notes);
            showToast({ message: 'Peso registrado correctamente', type: 'success' });
          }

          weightInput.value = "";
          if (weightNotesInput) weightNotesInput.value = "";
        } catch (err) {
          logger.error("Progress", "Error saving weight:", err);
          showToast({ message: 'Error al registrar peso', type: 'error' });
        } finally {
          saveWeightBtn.removeAttribute('disabled');
          if (saveWeightBtnText) saveWeightBtnText.textContent = 'Guardar';
        }
      });
    },
  });

  document.addEventListener("astro:before-swap", cleanup);
</script>
