        <div class="flex items-center justify-end gap-1.5 shrink-0">
          <button type="button" class="btn-edit-meas rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-3)] hover:bg-[var(--surface-4)] p-1.5 text-xs text-[var(--text-secondary)] hover:text-white transition-all" title="Editar perímetros">✏️</button>
          <button type="button" class="btn-delete-meas rounded-lg border border-rose-500/20 bg-rose-500/10 hover:bg-rose-500/20 p-1.5 text-xs text-rose-300 transition-all" title="Eliminar perímetros">🗑️</button>
        </div>
      `;

