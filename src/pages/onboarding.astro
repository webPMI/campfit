---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DecorativeBackground from '@/components/DecorativeBackground.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import UILogoIcon from '@/components/UILogoIcon.astro';
import { translations, type Language } from '@/i18n/translations';

import { getLangFromRequest } from '@/lib/i18n/server';
const lang = getLangFromRequest(Astro) as Language;
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
const currentPath = Astro.url.pathname;
---

<BaseLayout>
  <div class="flex min-h-screen flex-col items-center justify-center px-4 py-12">
    <DecorativeBackground />
    <LanguageSwitcher currentPath={currentPath} lang={lang} />

    <div class="w-full max-w-lg animate-fade-in" id="onboardingContainer" data-lang={lang}>
      <!-- Header -->
      <div class="mb-8 text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-[var(--brand-hover)] to-[var(--brand)] shadow-lg shadow-[var(--shadow-glow-sm)]">
          <UILogoIcon size="h-7 w-7" class="text-[var(--text-on-brand)]" />
        </div>
        <h1 data-i18n="onboarding.title" class="text-2xl font-bold tracking-tight">{t('onboarding.title')}</h1>
        <p data-i18n="onboarding.subtitle" class="mt-1 text-sm text-[var(--text-tertiary)]">{t('onboarding.subtitle')}</p>
      </div>

      <!-- Progress Bar -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs text-[var(--text-tertiary)]">
            <span id="stepLabel"><span data-i18n="onboarding.step">{t('onboarding.step')}</span> <span id="currentStep">1</span> <span data-i18n="onboarding.of">{t('onboarding.of')}</span> <span id="totalSteps">4</span></span>
          </span>
          <button id="skipBtn" data-i18n="onboarding.skip" class="text-xs text-[var(--text-disabled)] hover:text-[var(--text-secondary)] transition-colors">
            {t('onboarding.skip')}
          </button>
        </div>
        <div class="h-1.5 overflow-hidden rounded-full bg-[var(--surface-3)]">
          <div id="progressBar" class="h-full rounded-full bg-gradient-to-r from-[var(--brand)] to-emerald-400 transition-all duration-500" style="width: 25%"></div>
        </div>
      </div>

      <!-- Card Container -->
      <div class="card-glow rounded-2xl border border-[var(--border-default)] bg-[var(--surface-1)] p-8 backdrop-blur-xl">
        <!-- Step 1: Personal Info -->
        <div id="step1" class="step-content">
          <h2 data-i18n="onboarding.personal.title" class="text-lg font-semibold mb-1">{t('onboarding.personal.title')}</h2>
          <p data-i18n="onboarding.personal.desc" class="text-sm text-[var(--text-tertiary)] mb-6">{t('onboarding.personal.desc')}</p>

          <div class="space-y-4">
            <div>
              <label for="name" data-i18n="onboarding.name" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('onboarding.name')}</label>
              <input
                id="name"
                type="text"
                placeholder="Ej: Juan Pérez"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)]"
              />
            </div>
            <div>
              <label for="birthdate" data-i18n="onboarding.birthdate" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('onboarding.birthdate')}</label>
              <input
                id="birthdate"
                type="date"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)]"
              />
            </div>

            <div>
              <label for="height" data-i18n="client.medical.height" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('client.medical.height')}</label>
              <input
                id="height"
                type="number"
                step="0.1"
                placeholder="175"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)]"
              />
            </div>

            <div>
              <label for="weight" data-i18n="client.medical.weight" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('client.medical.weight')}</label>
              <input
                id="weight"
                type="number"
                step="0.1"
                placeholder="75"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)]"
              />
            </div>

            <div>
              <label for="experience" data-i18n="onboarding.experience" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('onboarding.experience')}</label>
              <select
                id="experience"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)]"
              >
                <option value="">Seleccionar</option>
                <option value="beginner" data-i18n="onboarding.experience.beginner">{t('onboarding.experience.beginner')}</option>
                <option value="intermediate" data-i18n="onboarding.experience.intermediate">{t('onboarding.experience.intermediate')}</option>
                <option value="advanced" data-i18n="onboarding.experience.advanced">{t('onboarding.experience.advanced')}</option>
              </select>
            </div>

            <div>
              <label data-i18n="onboarding.goals" class="block text-sm font-medium text-[var(--text-secondary)] mb-2">{t('onboarding.goals')}</label>
              <div class="grid grid-cols-2 gap-2">
                <label class="flex items-center gap-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3 py-2.5 cursor-pointer transition-all hover:border-[var(--border-strong)] has-[:checked]:border-[var(--border-brand)] has-[:checked]:bg-[var(--brand-dim)]">
                  <input type="checkbox" value="lose_weight" class="accent-emerald-500" />
                  <span data-i18n="onboarding.goals.lose_weight" class="text-sm text-[var(--text-secondary)]">{t('onboarding.goals.lose_weight')}</span>
                </label>
                <label class="flex items-center gap-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3 py-2.5 cursor-pointer transition-all hover:border-[var(--border-strong)] has-[:checked]:border-[var(--border-brand)] has-[:checked]:bg-[var(--brand-dim)]">
                  <input type="checkbox" value="gain_muscle" class="accent-emerald-500" />
                  <span data-i18n="onboarding.goals.gain_muscle" class="text-sm text-[var(--text-secondary)]">{t('onboarding.goals.gain_muscle')}</span>
                </label>
                <label class="flex items-center gap-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3 py-2.5 cursor-pointer transition-all hover:border-[var(--border-strong)] has-[:checked]:border-[var(--border-brand)] has-[:checked]:bg-[var(--brand-dim)]">
                  <input type="checkbox" value="endurance" class="accent-emerald-500" />
                  <span data-i18n="onboarding.goals.endurance" class="text-sm text-[var(--text-secondary)]">{t('onboarding.goals.endurance')}</span>
                </label>
                <label class="flex items-center gap-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3 py-2.5 cursor-pointer transition-all hover:border-[var(--border-strong)] has-[:checked]:border-[var(--border-brand)] has-[:checked]:bg-[var(--brand-dim)]">
                  <input type="checkbox" value="strength" class="accent-emerald-500" />
                  <span data-i18n="onboarding.goals.strength" class="text-sm text-[var(--text-secondary)]">{t('onboarding.goals.strength')}</span>
                </label>
                <label class="col-span-2 flex items-center gap-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-3 py-2.5 cursor-pointer transition-all hover:border-[var(--border-strong)] has-[:checked]:border-[var(--border-brand)] has-[:checked]:bg-[var(--brand-dim)]">
                  <input type="checkbox" value="health" class="accent-emerald-500" />
                  <span data-i18n="onboarding.goals.health" class="text-sm text-[var(--text-secondary)]">{t('onboarding.goals.health')}</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2: Medical Profile -->
        <div id="step2" class="step-content hidden">
          <h2 data-i18n="onboarding.medical.title" class="text-lg font-semibold mb-1">{t('onboarding.medical.title')}</h2>
          <p data-i18n="onboarding.medical.desc" class="text-sm text-[var(--text-tertiary)] mb-6">{t('onboarding.medical.desc')}</p>

          <div class="space-y-4">
            <div>
              <label for="conditions" data-i18n="onboarding.conditions" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('onboarding.conditions')}</label>
              <textarea
                id="conditions"
                rows="2"
                placeholder="Ej: Asma, diabetes, hipertensión"
                data-i18n-placeholder="client.medical.conditions.placeholder"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)] resize-none"
              ></textarea>
            </div>
            <div>
              <label for="medications" data-i18n="onboarding.medications" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('onboarding.medications')}</label>
              <textarea
                id="medications"
                rows="2"
                placeholder="Ej: Ibuprofeno, omeprazol"
                data-i18n-placeholder="client.medical.medications.placeholder"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)] resize-none"
              ></textarea>
            </div>
            <div>
              <label for="allergies" data-i18n="onboarding.allergies" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('onboarding.allergies')}</label>
              <textarea
                id="allergies"
                rows="2"
                placeholder="Ej: Polen, mariscos, penicilina"
                data-i18n-placeholder="client.medical.allergies.placeholder"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)] resize-none"
              ></textarea>
            </div>
            <div>
              <label for="injuries" data-i18n="onboarding.injuries" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('onboarding.injuries')}</label>
              <textarea
                id="injuries"
                rows="2"
                placeholder="Ej: Esguince de tobillo, fractura"
                data-i18n-placeholder="client.medical.injuries.placeholder"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)] resize-none"
              ></textarea>
            </div>
            <div>
              <label for="surgery" data-i18n="onboarding.surgery" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('onboarding.surgery')}</label>
              <textarea
                id="surgery"
                rows="2"
                placeholder="Ej: Cirugía de rodilla, apendicitis"
                data-i18n-placeholder="client.medical.surgery.placeholder"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)] resize-none"
              ></textarea>
            </div>
          </div>
        </div>

        <!-- Step 3: Emergency Contact -->
        <div id="step3" class="step-content hidden">
          <h2 data-i18n="onboarding.emergency.title" class="text-lg font-semibold mb-1">{t('onboarding.emergency.title')}</h2>
          <p data-i18n="onboarding.emergency.desc" class="text-sm text-[var(--text-tertiary)] mb-6">{t('onboarding.emergency.desc')}</p>

          <div class="space-y-4">
            <div>
              <label for="emergencyName" data-i18n="client.medical.emergency.name" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('client.medical.emergency.name')}</label>
              <input
                id="emergencyName"
                type="text"
                placeholder="María García"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)]"
              />
            </div>
            <div>
              <label for="emergencyPhone" data-i18n="client.medical.emergency.phone" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('client.medical.emergency.phone')}</label>
              <input
                id="emergencyPhone"
                type="tel"
                placeholder="+34 600 000 000"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)]"
              />
            </div>
          </div>
        </div>

        <!-- Step 4: Dietary Restrictions -->
        <div id="step4" class="step-content hidden">
          <h2 data-i18n="onboarding.dietary.title" class="text-lg font-semibold mb-1">{t('onboarding.dietary.title')}</h2>
          <p data-i18n="onboarding.dietary.desc" class="text-sm text-[var(--text-tertiary)] mb-6">{t('onboarding.dietary.desc')}</p>

          <div class="space-y-4">
            <!-- Global Dietary Restrictions -->
            <div>
              <label data-i18n="onboarding.dietary.restrictions" class="block text-sm font-medium text-[var(--text-secondary)] mb-2">{t('onboarding.dietary.restrictions')}</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] cursor-pointer hover:border-[var(--border-brand)] transition-all">
                  <input type="checkbox" id="glutenFreeCheck" class="rounded border-[var(--border-default)] text-[var(--brand)] focus:ring-[var(--brand)]" />
                  <span class="text-xs font-medium text-[var(--text-primary)]">🌾 {t('clinical.diet.glutenFree')}</span>
                </label>
                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] cursor-pointer hover:border-[var(--border-brand)] transition-all">
                  <input type="checkbox" id="lactoseFreeCheck" class="rounded border-[var(--border-default)] text-[var(--brand)] focus:ring-[var(--brand)]" />
                  <span class="text-xs font-medium text-[var(--text-primary)]">🥛 {t('clinical.diet.lactoseFree')}</span>
                </label>
                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] cursor-pointer hover:border-[var(--border-brand)] transition-all">
                  <input type="checkbox" id="veganCheck" class="rounded border-[var(--border-default)] text-[var(--brand)] focus:ring-[var(--brand)]" />
                  <span class="text-xs font-medium text-[var(--text-primary)]">🌱 {t('clinical.diet.vegan')}</span>
                </label>
                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] cursor-pointer hover:border-[var(--border-brand)] transition-all">
                  <input type="checkbox" id="vegetarianCheck" class="rounded border-[var(--border-default)] text-[var(--brand)] focus:ring-[var(--brand)]" />
                  <span class="text-xs font-medium text-[var(--text-primary)]">🥬 {t('clinical.diet.vegetarian')}</span>
                </label>
                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] cursor-pointer hover:border-[var(--border-brand)] transition-all">
                  <input type="checkbox" id="nutFreeCheck" class="rounded border-[var(--border-default)] text-[var(--brand)] focus:ring-[var(--brand)]" />
                  <span class="text-xs font-medium text-[var(--text-primary)]">🥜 {t('clinical.diet.nutFree')}</span>
                </label>
                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] cursor-pointer hover:border-[var(--border-brand)] transition-all">
                  <input type="checkbox" id="shellfishFreeCheck" class="rounded border-[var(--border-default)] text-[var(--brand)] focus:ring-[var(--brand)]" />
                  <span class="text-xs font-medium text-[var(--text-primary)]">🦐 {t('clinical.diet.shellfishFree')}</span>
                </label>
              </div>
            </div>

            <!-- Other Dietary Restrictions -->
            <div>
              <label for="otherDietaryInput" data-i18n="onboarding.dietary.other" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('onboarding.dietary.other')}</label>
              <input
                id="otherDietaryInput"
                type="text"
                placeholder="Ej: piña, café, cerdo"
                class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)]"
              />
            </div>

            <!-- Excluded Foods -->
            <div>
              <label data-i18n="onboarding.dietary.excludedFoods" class="block text-sm font-medium text-[var(--text-secondary)] mb-1.5">{t('onboarding.dietary.excludedFoods')}</label>
              <p data-i18n="onboarding.dietary.excludedFoods.desc" class="text-xs text-[var(--text-tertiary)] mb-2">{t('onboarding.dietary.excludedFoods.desc')}</p>
              
              <div class="relative">
                <input
                  id="foodSearchInput"
                  type="text"
                  placeholder={t('onboarding.dietary.searchPlaceholder')}
                  autocomplete="off"
                  class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-4 py-2.5 pl-10 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all focus:border-[var(--border-brand)] focus:ring-2 focus:ring-[var(--brand-dim)]"
                />
                <svg class="absolute left-3.5 top-3 h-4 w-4 text-[var(--text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <div id="foodSearchResults" class="hidden absolute top-full left-0 right-0 z-20 mt-1 max-h-48 overflow-y-auto rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] shadow-xl divide-y divide-[var(--border-subtle)]">
                </div>
              </div>

              <!-- Excluded Foods List -->
              <div class="mt-3">
                <div class="text-xs font-medium text-[var(--text-secondary)] mb-2" data-i18n="onboarding.dietary.selected">{t('onboarding.dietary.selected')}</div>
                <div id="excludedFoodsList" class="flex flex-wrap gap-2 min-h-[36px] p-2 rounded-xl border border-dashed border-[var(--border-subtle)] bg-[var(--surface-3)]/40">
                  <span id="noExcludedFoodsText" class="text-xs text-[var(--text-tertiary)] italic self-center" data-i18n="onboarding.dietary.none">{t('onboarding.dietary.none')}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="mt-8 flex items-center gap-3">
          <button
            id="backBtn"
            data-i18n="onboarding.back"
            class="hidden rounded-xl border border-[var(--border-default)] bg-[var(--surface-4)] px-5 py-3 text-sm font-medium text-[var(--text-secondary)] transition-all hover:border-[var(--border-strong)] hover:bg-[var(--surface-3)] active:scale-[0.98]"
          >
            {t('onboarding.back')}
          </button>
          <button
            id="nextBtn"
            data-i18n="onboarding.next"
            class="flex-1 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand)] px-6 py-3 text-sm font-semibold text-[var(--text-on-brand)] shadow-lg shadow-[var(--shadow-glow-sm)] transition-all hover:from-[var(--brand-hover)] hover:to-[var(--brand)] active:scale-[0.98]"
          >
            {t('onboarding.next')}
          </button>
        </div>

        <!-- Error -->
        <div id="errorMsg" class="mt-4 hidden items-center gap-2 rounded-xl bg-[var(--danger-dim)] border border-[var(--danger)] px-4 py-3 text-sm text-[var(--danger)]">
          <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
          <span id="errorText"></span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { authService } from '@/services/authService';
  import { doc, updateDoc, serverTimestamp } from 'firebase/firestore';
  import { db } from '@/lib/firebase';
  import { t, getStoredLanguage, setStoredLanguage } from '@/i18n/client';
  import type { Language } from '@/i18n/client';
  import {
    subscribeToFoods,
    getFoodName,
    searchFoodsLocal,
    type FoodItem,
    type FoodCategory,
  } from '@/lib/shared/foodLibrary';

  // Sincronizar idioma: leer de URL o de localStorage
  const onboardingContainer = document.getElementById('onboardingContainer')!;
  const urlLang = onboardingContainer.dataset.lang as Language;
  if (urlLang && urlLang !== getStoredLanguage()) {
    setStoredLanguage(urlLang);
  }

  // ============================================================
  // State
  // ============================================================

  const TOTAL_STEPS = 4;
  let currentStep = 1;
  let currentUser: import('firebase/auth').User | null = null;

  // DOM refs
  const step1 = document.getElementById('step1')!;
  const step2 = document.getElementById('step2')!;
  const step3 = document.getElementById('step3')!;
  const step4 = document.getElementById('step4')!;
  const backBtn = document.getElementById('backBtn') as HTMLButtonElement;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;
  const skipBtn = document.getElementById('skipBtn')!;
  const progressBar = document.getElementById('progressBar')!;
  const currentStepEl = document.getElementById('currentStep')!;
  const totalStepsEl = document.getElementById('totalSteps')!;
  const errorMsg = document.getElementById('errorMsg') as HTMLDivElement;
  const errorText = document.getElementById('errorText') as HTMLSpanElement;

  // Dietary restrictions DOM refs
  const glutenFreeCheck = document.getElementById('glutenFreeCheck') as HTMLInputElement;
  const lactoseFreeCheck = document.getElementById('lactoseFreeCheck') as HTMLInputElement;
  const veganCheck = document.getElementById('veganCheck') as HTMLInputElement;
  const vegetarianCheck = document.getElementById('vegetarianCheck') as HTMLInputElement;
  const nutFreeCheck = document.getElementById('nutFreeCheck') as HTMLInputElement;
  const shellfishFreeCheck = document.getElementById('shellfishFreeCheck') as HTMLInputElement;
  const otherDietaryInput = document.getElementById('otherDietaryInput') as HTMLInputElement;
  const foodSearchInput = document.getElementById('foodSearchInput') as HTMLInputElement;
  const foodSearchResults = document.getElementById('foodSearchResults')!;
  const excludedFoodsList = document.getElementById('excludedFoodsList')!;
  const noExcludedFoodsText = document.getElementById('noExcludedFoodsText')!;

  // Food library state
  let allCatalogFoods: FoodItem[] = [];
  let excludedFoodIds: string[] = [];
  let unsubFoods: (() => void) | null = null;

  totalStepsEl.textContent = String(TOTAL_STEPS);

  // ============================================================
  // Auth guard
  // ============================================================

  authService.onAuthChange(async (firebaseUser) => {
    if (!firebaseUser) {
      window.location.href = '/login';
      return;
    }
    currentUser = firebaseUser;
  });

  // ============================================================
  // Helpers
  // ============================================================

  function hideError(): void {
    errorMsg.classList.add('hidden');
    errorMsg.classList.remove('flex');
  }

  function showError(msg: string): void {
    errorText.textContent = msg;
    errorMsg.classList.remove('hidden');
    errorMsg.classList.add('flex');
  }

  function updateProgress(): void {
    const pct = (currentStep / TOTAL_STEPS) * 100;
    progressBar.style.width = `${pct}%`;
    currentStepEl.textContent = String(currentStep);

    // Show/hide back button
    if (currentStep === 1) {
      backBtn.classList.add('hidden');
    } else {
      backBtn.classList.remove('hidden');
    }

    // Update next button text
    if (currentStep === TOTAL_STEPS) {
      nextBtn.textContent = t('onboarding.finish');
    } else {
      nextBtn.textContent = t('onboarding.next');
    }
  }

  function showStep(step: number): void {
    hideError();
    [step1, step2, step3, step4].forEach((el, i) => {
      el.classList.toggle('hidden', i + 1 !== step);
    });
    currentStep = step;
    updateProgress();
  }

  // ============================================================
  // Food Library Functions
  // ============================================================

  function renderExcludedFoods() {
    excludedFoodsList.innerHTML = '';
    if (excludedFoodIds.length === 0) {
      noExcludedFoodsText.classList.remove('hidden');
      excludedFoodsList.appendChild(noExcludedFoodsText);
      return;
    }

    noExcludedFoodsText.classList.add('hidden');
    excludedFoodIds.forEach((foodId) => {
      const food = allCatalogFoods.find((f) => f.id === foodId);
      const name = food ? getFoodName(food, urlLang) : foodId;
      const chip = document.createElement('div');
      chip.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs font-medium animate-fade-in';
      chip.innerHTML = `
        <span>🚫 ${name}</span>
        <button type="button" class="text-rose-400 hover:text-rose-200 ml-1 font-bold">×</button>
      `;
      chip.querySelector('button')?.addEventListener('click', () => {
        excludedFoodIds = excludedFoodIds.filter((id) => id !== foodId);
        renderExcludedFoods();
      });
      excludedFoodsList.appendChild(chip);
    });
  }

  function setupFoodSearch() {
    foodSearchInput.addEventListener('input', () => {
      const q = foodSearchInput.value.trim();
      if (!q) {
        foodSearchResults.classList.add('hidden');
        return;
      }
      const matches = searchFoodsLocal(q, allCatalogFoods).slice(0, 8);
      if (matches.length === 0) {
        foodSearchResults.innerHTML = `<div class="p-3 text-xs text-[var(--text-tertiary)] italic">${t('onboarding.dietary.noResults')}</div>`;
        foodSearchResults.classList.remove('hidden');
        return;
      }

      foodSearchResults.innerHTML = matches
        .map((food) => {
          const isSelected = excludedFoodIds.includes(food.id);
          return `
            <button type="button" data-id="${food.id}" class="w-full text-left px-3 py-2 text-xs flex items-center justify-between hover:bg-[var(--surface-3)] transition-colors ${
              isSelected ? 'opacity-50 pointer-events-none' : ''
            }">
              <span class="font-medium text-[var(--text-primary)]">${getFoodName(food, urlLang)}</span>
              <span class="text-[10px] text-[var(--text-tertiary)] uppercase tracking-wider">${food.category}</span>
            </button>
          `;
        })
        .join('');

      foodSearchResults.querySelectorAll('button').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          if (id && !excludedFoodIds.includes(id)) {
            excludedFoodIds.push(id);
            renderExcludedFoods();
            foodSearchInput.value = '';
            foodSearchResults.classList.add('hidden');
          }
        });
      });

      foodSearchResults.classList.remove('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!foodSearchInput.contains(e.target as Node) && !foodSearchResults.contains(e.target as Node)) {
        foodSearchResults.classList.add('hidden');
      }
    });
  }

  // ============================================================
  // Load Food Library
  // ============================================================

  unsubFoods = subscribeToFoods((foods) => {
    allCatalogFoods = foods;
    if (currentStep === 4) {
      setupFoodSearch();
    }
  });

  import { saveOnboardingProfile, skipOnboarding, type OnboardingData } from '@/lib/client/onboardingService';

  // ============================================================
  // Collect data from all steps
  // ============================================================

  function collectData(): OnboardingData {
    const name = (document.getElementById('name') as HTMLInputElement).value;
    const birthdate = (document.getElementById('birthdate') as HTMLInputElement).value;
    const height = (document.getElementById('height') as HTMLInputElement).value;
    const weight = (document.getElementById('weight') as HTMLInputElement).value;
    const experience = (document.getElementById('experience') as HTMLSelectElement).value;
    const goals = Array.from(
      document.querySelectorAll('#step1 input[type="checkbox"]:checked')
    ).map((cb) => (cb as HTMLInputElement).value);

    const conditions = (document.getElementById('conditions') as HTMLTextAreaElement).value;
    const medications = (document.getElementById('medications') as HTMLTextAreaElement).value;
    const allergies = (document.getElementById('allergies') as HTMLTextAreaElement).value;
    const injuries = (document.getElementById('injuries') as HTMLTextAreaElement).value;
    const surgery = (document.getElementById('surgery') as HTMLTextAreaElement).value;

    const emergencyName = (document.getElementById('emergencyName') as HTMLInputElement).value;
    const emergencyPhone = (document.getElementById('emergencyPhone') as HTMLInputElement).value;

    // Dietary restrictions
    const dietaryRestrictions: string[] = [];
    if (glutenFreeCheck.checked) dietaryRestrictions.push('glutenFree');
    if (lactoseFreeCheck.checked) dietaryRestrictions.push('lactoseFree');
    if (veganCheck.checked) dietaryRestrictions.push('vegan');
    if (vegetarianCheck.checked) dietaryRestrictions.push('vegetarian');
    if (nutFreeCheck.checked) dietaryRestrictions.push('nutFree');
    if (shellfishFreeCheck.checked) dietaryRestrictions.push('shellfishFree');

    const otherDietary = otherDietaryInput.value || null;

    return {
      name: name || null,
      birthdate: birthdate || null,
      height: height ? parseFloat(height) : null,
      initialWeight: weight ? parseFloat(weight) : null,
      experience: experience || null,
      goals: goals.length > 0 ? goals : null,
      conditions: conditions || null,
      medications: medications || null,
      allergies: allergies || null,
      injuries: injuries || null,
      surgery: surgery || null,
      emergencyName: emergencyName || null,
      emergencyPhone: emergencyPhone || null,
      dietaryRestrictions: dietaryRestrictions.length > 0 ? dietaryRestrictions : null,
      otherDietary: otherDietary,
      excludedFoodIds: excludedFoodIds.length > 0 ? excludedFoodIds : null,
    };
  }

  async function handleSaveOnboarding(): Promise<boolean> {
    if (!currentUser) {
      showError('Debes iniciar sesión');
      return false;
    }
    const data = collectData();
    const success = await saveOnboardingProfile(currentUser.uid, data);
    if (!success) {
      showError(t('onboarding.error'));
    }
    return success;
  }

  // ============================================================
  // Navigation
  // ============================================================

  const currentLang = onboardingContainer.dataset.lang || 'es';

  nextBtn.addEventListener('click', async () => {
    hideError();

    if (currentStep < TOTAL_STEPS) {
      showStep(currentStep + 1);
    } else {
      // Final step - save
      nextBtn.disabled = true;
      nextBtn.textContent = t('onboarding.saving');

      const success = await handleSaveOnboarding();
      if (success) {
        window.location.href = `/client/dashboard?lang=${currentLang}`;
      } else {
        nextBtn.disabled = false;
        nextBtn.textContent = t('onboarding.finish');
      }
    }
  });

  backBtn.addEventListener('click', () => {
    if (currentStep > 1) {
      showStep(currentStep - 1);
    }
  });

  skipBtn.addEventListener('click', async () => {
    if (currentUser) {
      await skipOnboarding(currentUser.uid);
    }
    if (unsubFoods) {
      unsubFoods();
    }
    window.location.href = `/client/dashboard?lang=${currentLang}`;
  });
</script>