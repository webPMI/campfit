---
import PublicPageLayout from '@/layouts/PublicPageLayout.astro';
import UICard from '@/components/UICard.astro';
import UILogoIcon from '@/components/UILogoIcon.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<PublicPageLayout currentPath="/login">
  <div class="w-full max-w-sm animate-fade-in-scale">
      <!-- Logo -->
      <div class="mb-8 text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-[var(--brand-hover)] to-[var(--brand)] shadow-[var(--shadow-glow-md)]">
          <UILogoIcon size="h-7 w-7" class="text-[var(--text-on-brand)]" />
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">{t('app.name')}</h1>
        <p class="mt-1 text-sm font-medium text-[var(--text-secondary)]">{t('app.tagline')}</p>
      </div>

      <!-- Card -->
      <UICard variant="elevated" padding="md" class="animate-pulse-glow">
        <h2 class="mb-8 text-center text-lg font-semibold text-[var(--text-primary)]">{t('auth.login.title')}</h2>

        <!-- Botón Google -->
        <button
          id="googleBtn"
          class="group flex w-full items-center justify-center gap-3 rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-6 py-3 text-sm font-medium text-[var(--text-secondary)] transition-all duration-200 hover:border-[var(--border-strong)] hover:bg-[var(--surface-3)] hover:text-[var(--text-primary)] active:scale-[0.98]"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          {t('auth.google.login')}
        </button>

        <!-- Separador -->
        <div class="my-6 flex items-center gap-3">
          <div class="flex-1 border-t border-[var(--border-subtle)]" />
          <span class="text-xs font-medium uppercase tracking-wider text-[var(--text-tertiary)]">{t('auth.or')}</span>
          <div class="flex-1 border-t border-[var(--border-subtle)]" />
        </div>

        <!-- Formulario Email -->
        <form id="loginForm" class="flex flex-col gap-5">
          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium text-[var(--text-secondary)]">{t('auth.email')}</label>
            <input
              id="email"
              type="email"
              placeholder={t('auth.email.placeholder')}
              required
              autocomplete="email"
              class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all duration-200 focus:border-[var(--brand)] focus:bg-[var(--surface-3)] focus:shadow-[0_0_0_3px_var(--brand-dim)]"
            />
          </div>

          <div>
            <label for="password" class="mb-1.5 block text-sm font-medium text-[var(--text-secondary)]">{t('auth.password')}</label>
            <input
              id="password"
              type="password"
              placeholder={t('auth.password.placeholder')}
              required
              autocomplete="current-password"
              class="w-full rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-4 py-3 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] outline-none transition-all duration-200 focus:border-[var(--brand)] focus:bg-[var(--surface-3)] focus:shadow-[0_0_0_3px_var(--brand-dim)]"
            />
          </div>

          <button
            id="loginBtn"
            type="submit"
            class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-6 py-3 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all duration-200 hover:shadow-[var(--shadow-glow-md)] hover:brightness-105 active:scale-[0.98] disabled:opacity-50 disabled:pointer-events-none"
          >
            {t('auth.login.btn')}
          </button>
        </form>

        <!-- Error -->
        <div id="errorMsg" class="mt-5 hidden items-center gap-2 rounded-xl bg-[var(--danger-dim)] border border-[var(--danger)] px-4 py-3 text-sm text-[var(--danger)]">
          <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
          <span id="errorText"></span>
        </div>
      </UICard>

      <p class="mt-6 text-center text-sm">
        <a href={`/recover?lang=${lang}`} class="text-sm text-[var(--text-tertiary)] transition-colors duration-200 hover:text-[var(--text-primary)]">¿Olvidaste tu contraseña?</a>
      </p>

      <p class="mt-4 text-center text-sm text-[var(--text-tertiary)]">
        {t('auth.no.account')}
        <a href={`/register?lang=${lang}`} class="font-medium text-[var(--brand)] transition-colors duration-200 hover:text-[var(--brand-hover)]">{t('auth.create.link')}</a>
      </p>
  </div>
</PublicPageLayout>

<script>
  import { authService } from '@/services/authService';
  import { setUser, setAuthLoading } from '@/stores/authStore';
  import { isValidEmail } from '@/lib/validators';
  import { t } from '@/i18n/client';
  import type { FirebaseError } from 'firebase/app';

  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const loginForm = document.getElementById('loginForm') as HTMLFormElement;
  const loginBtn = document.getElementById('loginBtn') as HTMLButtonElement;
  const googleBtn = document.getElementById('googleBtn') as HTMLButtonElement;
  const errorMsg = document.getElementById('errorMsg') as HTMLDivElement;
  const errorText = document.getElementById('errorText') as HTMLSpanElement;

  function showError(msg: string) {
    errorText.textContent = msg;
    errorMsg.classList.remove('hidden');
    errorMsg.classList.add('flex');
  }

  function hideError() {
    errorMsg.classList.add('hidden');
    errorMsg.classList.remove('flex');
  }

  function redirectByRole(role: string) {
    const routes: Record<string, string> = {
      admin: '/admin/dashboard',
      trainer: '/trainer/dashboard',
      client: '/client/dashboard',
    };
    window.location.href = routes[role] || '/client/dashboard';
  }

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    logger.info('Login', 'Formulario de login enviado');

    const email = emailInput.value.trim();
    const password = passwordInput.value;

    if (!email || !password) {
      logger.warn('Login', 'Campos vacíos en formulario de login');
      showError(t('error.required'));
      return;
    }

    if (!isValidEmail(email)) {
      logger.warn('Login', `Email inválido: ${email}`);
      showError(t('error.invalid-email'));
      return;
    }

    loginBtn.disabled = true;
    loginBtn.innerHTML = `<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg> ${t('auth.loading.login')}`;
    logger.info('Login', `Intentando login con email: ${email}`);

    try {
      const user = await authService.loginUser(email, password);
      logger.info('Login', `Login exitoso para usuario: ${user.uid}, rol: ${user.role}`);
      setUser(user);
      setAuthLoading(false);
      redirectByRole(user.role);
    } catch (err: unknown) {
      const fbErr = err as FirebaseError & { message?: string };
      const code = fbErr.code || fbErr.message || '';
      const messages: Record<string, string> = {
        'auth/invalid-credential': t('error.invalid-credential'),
        'auth/user-not-found': t('error.user-not-found'),
        'auth/wrong-password': t('error.wrong-password'),
        'auth/invalid-email': t('error.invalid-email'),
        'auth/user-disabled': t('error.user-disabled'),
        'auth/too-many-requests': t('error.too-many-requests'),
      };
      showError(messages[code] || t('error.default.login'));
    } finally {
      loginBtn.disabled = false;
      loginBtn.textContent = t('auth.login.btn');
      logger.info('Login', 'Botón de login restaurado');
    }
  });

  // Procesar resultado de redirect de Google al cargar la página
  // Intenta handleRedirectResult primero, y si no hay resultado pero el
  // usuario está autenticado (por onAuthStateChanged), lo procesa igual.
  (async () => {
    try {
      const user = await authService.handleRedirectResult();
      if (user) {
        logger.step('Auth:Google', 1, 1, 'Redirect de Google procesado - usuario autenticado', 'success', {
          uid: user.uid,
          role: user.role,
          email: user.email,
        });
        setUser(user);
        setAuthLoading(false);
        redirectByRole(user.role);
      } else {
        // Si no hay redirect, suscribirse a cambios de auth para detectar
        // si el usuario ya estaba logueado (ej: recarga de página)
        authService.onAuthChange((firebaseUser) => {
          if (firebaseUser) {
            logger.debug('Auth:Google', 'Usuario ya autenticado detectado por onAuthStateChanged');
            // Re-check handleRedirectResult por si getRedirectResult resuelve tarde
            authService.handleRedirectResult().then((redirectUser) => {
              if (redirectUser) {
                setUser(redirectUser);
                setAuthLoading(false);
                redirectByRole(redirectUser.role);
              }
            });
          } else {
            setAuthLoading(false);
          }
        });
      }
    } catch (err: unknown) {
      const errorObj = err as { code?: string; message?: string };
      const code = errorObj?.code || 'unknown';
      logger.error('Auth:Google', 'Error al procesar redirect de Google en login', {
        code,
        message: errorObj?.message || 'Sin mensaje',
      });
      showError(t('error.google.login'));
      setAuthLoading(false);
    }
  })();

  googleBtn.addEventListener('click', async () => {
    hideError();
    googleBtn.disabled = true;
    googleBtn.textContent = t('auth.loading.google');
    logger.info('Login', 'Botón de Google presionado');

    logger.group('Auth:Google - Login page');
    logger.step('Auth:Google', 1, 2, 'Redirigiendo a Google para autenticación...', 'pending');

    try {
      await authService.loginWithGoogle();
      // El navegador redirige a Google - el código no continúa aquí
    } catch (err: unknown) {
      const errorObj = err as { code?: string; message?: string };
      const code = errorObj?.code || 'unknown';

      logger.error('Auth:Google', 'Error al iniciar redirect de Google', {
        code,
        message: errorObj?.message || 'Sin mensaje',
      });
      logger.step('Auth:Google', 2, 2, 'Error al iniciar redirect de Google', 'error', { code });
      logger.groupEnd();

      const googleMessages: Record<string, string> = {
        'auth/unauthorized-domain': 'Este dominio no está autorizado para login con Google. Contacta al administrador.',
        'auth/operation-not-allowed': 'El login con Google no está habilitado. Contacta al administrador.',
        'auth/network-request-failed': 'Error de conexión. Verifica tu internet e intenta de nuevo.',
      };
      showError(googleMessages[code] || t('error.google.login'));
    } finally {
      googleBtn.disabled = false;
      googleBtn.innerHTML = `
        <svg class="h-5 w-5" viewBox="0 0 24 24">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        ${t('auth.google.login')}
      `;
      logger.info('Login', 'Botón de Google restaurado');
    }
  });
</script>
</write_to_file>