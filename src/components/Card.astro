---
/**
 * Card.astro - Componente card genérico con theming dark/light.
 *
 * @prop {string}  [class]  - Clases CSS adicionales
 * @prop {string}  [padding] - 'none' | 'sm' | 'md' | 'lg' (default: 'md')
 * @prop {boolean} [hover]  - Activar efecto hover
 */
export interface Props {
  class?: string;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  hover?: boolean;
}
const { class: className, padding = 'md', hover } = Astro.props;
const padClass = { none: '', sm: 'p-3', md: 'p-5', lg: 'p-7' }[padding];
---

<div class="rounded-2xl border border-zinc-800/40 bg-zinc-900/40 backdrop-blur-sm transition-all ${padClass} ${hover ? 'hover:border-zinc-700/60 hover:bg-zinc-800/30' : ''} ${className || ''}">
  <slot />
</div>