---
/**
 * ThemeToggle
 *
 * Botón flotante que alterna entre dark/light mode.
 * Persiste en localStorage y actualiza data-theme en <html>.
 *
 * @component
 * @example
 *   <ThemeToggle />
 */
---

<div id="theme-toggle-wrapper" class="fixed bottom-36 left-4 z-50">
  <button
    id="btn-floating-theme-toggle"
    class="inline-flex items-center gap-1.5 rounded-xl border border-zinc-700/50 bg-zinc-900/90 px-2.5 py-1.5 text-[10px] font-medium text-zinc-400 backdrop-blur-sm shadow-lg transition-all hover:border-zinc-600 hover:text-zinc-200"
    role="switch"
    aria-checked="true"
  >
    <svg id="theme-toggle-icon" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path id="theme-toggle-path" stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
    </svg>
    <span id="theme-toggle-label">Tema</span>
  </button>
</div>

<script>
  const STORAGE_KEY = 'campfit_theme';

  function getStoredTheme(): string {
    try {
      return localStorage.getItem(STORAGE_KEY) || 'dark';
    } catch {
      return 'dark';
    }
  }

  function applyTheme(theme: string): void {
    document.documentElement.setAttribute('data-theme', theme);
    try { localStorage.setItem(STORAGE_KEY, theme); } catch { /* no-op */ }

    const icon = document.getElementById('theme-toggle-icon');
    const path = document.getElementById('theme-toggle-path');
    const label = document.getElementById('theme-toggle-label');
    const btn = document.getElementById('btn-floating-theme-toggle');

    if (!icon || !path || !label || !btn) return;

    if (theme === 'light') {
      path.setAttribute('d', 'M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z');
      label.textContent = 'Oscuro';
      btn.setAttribute('aria-checked', 'false');
    } else {
      path.setAttribute('d', 'M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z');
      label.textContent = 'Tema';
      btn.setAttribute('aria-checked', 'true');
    }
  }

  // Inicializar
  const initial = getStoredTheme();
  applyTheme(initial);

  // Toggle al hacer clic
  document.getElementById('btn-floating-theme-toggle')?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    applyTheme(current === 'dark' ? 'light' : 'dark');
  });
</script>