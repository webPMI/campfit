---
/**
 * ThemeToggle
 *
 * Botón que alterna entre dark/light/auto mode utilizando themeStore.
 * Persiste en localStorage y actualiza atributos en <html>.
 *
 * @component
 * @example
 *   <ThemeToggle />
 */

export interface Props {
  /** Clases CSS adicionales */
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
  type="button"
  data-theme-toggle-btn
  class={`inline-flex items-center gap-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-2 text-xs font-medium text-[var(--text-primary)] backdrop-blur-sm transition-all hover:bg-[var(--surface-hover)] hover:border-[var(--border-strong)] active:scale-[0.98] ${className}`}
  role="switch"
  aria-checked="true"
  aria-label="Cambiar modo de tema"
>
  <svg data-theme-toggle-icon class="h-4 w-4 text-[var(--brand)] transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path data-theme-toggle-path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
  </svg>
  <span data-theme-toggle-label>Oscuro</span>
</button>

<script>
  import { $themeMode, toggleThemeMode, type ThemeMode } from '@/stores/themeStore';

  const icons: Record<ThemeMode, string> = {
    dark: 'M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z',
    light: 'M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z',
    auto: 'M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0v12',
  };

  const labels: Record<ThemeMode, string> = {
    dark: 'Oscuro',
    light: 'Claro',
    auto: 'Automático',
  };

  function updateAllToggles(mode: ThemeMode) {
    document.querySelectorAll('[data-theme-toggle-btn]').forEach((btn) => {
      const path = btn.querySelector('[data-theme-toggle-path]');
      const label = btn.querySelector('[data-theme-toggle-label]');
      if (path) path.setAttribute('d', icons[mode] || icons.dark);
      if (label) label.textContent = labels[mode] || 'Oscuro';
      btn.setAttribute('aria-checked', mode === 'dark' ? 'true' : 'false');
    });
  }

  document.querySelectorAll('[data-theme-toggle-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      toggleThemeMode();
    });
  });

  $themeMode.subscribe((mode: ThemeMode) => {
    updateAllToggles(mode);
  });
</script>
