---
/**
 * Skeleton.astro — Placeholder con shimmer elegante para estados de carga.
 *
 * @prop { 'text' | 'circle' | 'rect' | 'card' } variant - Forma del skeleton.
 * @prop { string } [width] - Ancho CSS personalizado (ej: '100%', '200px').
 * @prop { string } [height] - Alto CSS personalizado (ej: '20px', '40px').
 * @prop { number } [lines] - Número de líneas a renderizar (solo variant='text').
 * @prop { string } [className] - Clases adicionales.
 * @prop { string } [ariaLabel] - Label accesible.
 */

export interface Props {
  variant?: "text" | "circle" | "rect" | "card";
  width?: string;
  height?: string;
  lines?: number;
  className?: string;
  ariaLabel?: string;
}

const {
  variant = "text",
  width,
  height,
  lines = 1,
  className = "",
  ariaLabel = "Cargando contenido...",
} = Astro.props;

const variantStyles: Record<string, string> = {
  text: `height: ${height || "14px"}; width: ${width || "100%"};`,
  circle: `height: ${height || "40px"}; width: ${width || "40px"}; border-radius: 50%;`,
  rect: `height: ${height || "80px"}; width: ${width || "100%"};`,
  card: `height: ${height || "120px"}; width: ${width || "100%"};`,
};

const isText = variant === "text" && lines > 1;
---

{
  isText ? (
    <div class={`cf-skeleton-group ${className}`} role="status" aria-label={ariaLabel}>
      {Array.from({ length: lines }).map((_, i) => (
        <div
          class="cf-skeleton cf-skeleton-line"
          style={`height: ${height || "14px"}; width: ${i === lines - 1 ? "60%" : "100%"};`}
        />
      ))}
    </div>
  ) : (
    <div
      class={`cf-skeleton ${className}`}
      style={variantStyles[variant]}
      role="status"
      aria-label={ariaLabel}
    />
  )
}


