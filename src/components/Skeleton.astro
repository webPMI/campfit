---
/**
 * Skeleton - Loading placeholder component.
 * Theme-aware shimmer animation using surface colors.
 */
export interface Props {
  /** Variante de skeleton */
  variant?: 'text' | 'circular' | 'rectangular' | 'card';
  /** Ancho (ej: '100%', '200px', 'w-full') */
  width?: string;
  /** Alto (ej: '16px', 'h-4') */
  height?: string;
  /** Clases adicionales */
  class?: string;
  /** Número de líneas (solo variant='text') */
  lines?: number;
  /** Espaciado entre líneas */
  gap?: string;
}

const {
  variant = 'text',
  width,
  height,
  lines = 3,
  gap = '0.625rem',
} = Astro.props;

const variantStyles: Record<string, string> = {
  text: 'rounded-lg',
  circular: 'rounded-full',
  rectangular: 'rounded-xl',
  card: 'rounded-2xl',
};

const defaultSizes: Record<string, { w: string; h: string }> = {
  text: { w: '100%', h: '0.875rem' },
  circular: { w: '2.5rem', h: '2.5rem' },
  rectangular: { w: '100%', h: '8rem' },
  card: { w: '100%', h: '12rem' },
};

const sizes = defaultSizes[variant]!;
const w = width || sizes.w;
const h = height || sizes.h;

// Build inline style
const inlineStyle = [
  `width: ${w}`,
  `height: ${h}`,
].join('; ');
---

{
  variant === 'text' ? (
    <div style={`display: flex; flex-direction: column; gap: ${gap};`} class={Astro.props.class ?? ''}>
      {Array.from({ length: lines }).map((_, i) => {
        const isLast = i === lines - 1;
        const lineWidth = isLast ? '60%' : i === lines - 2 && lines > 2 ? '85%' : '100%';
        return (
          <div
            class={`skeleton ${variantStyles[variant]}`}
            style={`width: ${lineWidth}; height: ${h};`}
          ></div>
        );
      })}
    </div>
  ) : (
    <div
      class={['skeleton', variantStyles[variant], Astro.props.class ?? ''].join(' ')}
      style={inlineStyle}
    >
      <slot />
    </div>
  )
}
</write_to_file>