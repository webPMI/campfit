---
/**
 * Button.astro - Botón premium con variantes, tamaños y loading state.
 *
 * @prop {'primary' | 'secondary' | 'danger' | 'ghost'} [variant='primary']
 * @prop {'sm' | 'md' | 'lg'} [size='md']
 * @prop {boolean} [loading=false]
 * @prop {boolean} [disabled=false]
 * @prop {string}  [class]
 * @prop {'button' | 'submit' | 'reset'} [type='button']
 */
export interface Props {
  variant?: 'primary' | 'secondary' | 'danger' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  loading?: boolean;
  disabled?: boolean;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  variant = 'primary',
  size = 'md',
  loading = false,
  disabled = false,
  class: className,
  type = 'button',
} = Astro.props;

const isDisabled = disabled || loading;

const sizeClasses: Record<string, string> = {
  sm: 'px-4 py-2 text-xs gap-1.5',
  md: 'px-5 py-2.5 text-sm gap-2',
  lg: 'px-7 py-3.5 text-base gap-2.5',
};

const variantClasses: Record<string, string> = {
  primary: 'bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/30 hover:from-emerald-400 hover:to-emerald-500 active:shadow-md',
  secondary: 'border border-zinc-700/50 bg-zinc-800/50 text-zinc-200 hover:bg-zinc-700/50 hover:border-emerald-500/30 hover:text-emerald-400 active:bg-zinc-700/70',
  danger: 'bg-gradient-to-r from-red-500 to-red-600 text-white shadow-lg shadow-red-500/20 hover:shadow-red-500/30 hover:from-red-400 hover:to-red-500 active:shadow-md',
  ghost: 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/30 active:bg-zinc-800/50',
};
---

<button
  type={type}
  disabled={isDisabled}
  class="inline-flex items-center justify-center rounded-xl font-semibold transition-all duration-300 active:scale-[0.97] disabled:opacity-50 disabled:cursor-not-allowed disabled:active:scale-100 ${sizeClasses[size]} ${variantClasses[variant]} ${className || ''}"
>
  {loading && (
    <svg class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
    </svg>
  )}
  {!loading && <slot name="icon" />}
  <slot />
</button>