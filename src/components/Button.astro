---
/**
 * Button.astro - Botón premium con variantes, tamaños y loading state.
 *
 * @prop {'primary' | 'secondary' | 'danger' | 'ghost'} [variant='primary']
 * @prop {'sm' | 'md' | 'lg'} [size='md']
 * @prop {boolean} [loading=false]
 * @prop {boolean} [disabled=false]
 * @prop {string}  [class]
 * @prop {'button' | 'submit' | 'reset'} [type='button']
 */
export interface Props {
  variant?: 'primary' | 'secondary' | 'danger' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  loading?: boolean;
  disabled?: boolean;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  variant = 'primary',
  size = 'md',
  loading = false,
  disabled = false,
  class: className,
  type = 'button',
} = Astro.props;

const isDisabled = disabled || loading;

const sizeClasses: Record<string, string> = {
  sm: 'px-4 py-2 text-xs gap-1.5',
  md: 'px-5 py-2.5 text-sm gap-2',
  lg: 'px-7 py-3.5 text-base gap-2.5',
};

const variantClasses: Record<string, string> = {
  primary: 'theme-brand-gradient text-white theme-glow-brand hover:theme-shadow-brand-lg',
  secondary: 'theme-surface theme-border theme-text-secondary hover:theme-surface-hover hover:theme-border-hover hover:theme-text-brand',
  danger: 'theme-error-bg theme-error-text',
  ghost: 'theme-text-tertiary hover:theme-text-primary hover:theme-surface-hover active:theme-surface-active',
};
---

<button
  type={type}
  disabled={isDisabled}
  class="inline-flex items-center justify-center rounded-xl font-semibold transition-all duration-300 active:scale-[0.97] disabled:opacity-50 disabled:cursor-not-allowed disabled:active:scale-100 ${sizeClasses[size]} ${variantClasses[variant]} ${className || ''}"
>
  {loading && (
    <svg class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
    </svg>
  )}
  {!loading && <slot name="icon" />}
  <slot />
</button>