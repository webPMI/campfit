/**
 * LanguageSwitcher - Client-side island
 * Gestiona cambio ES↔EN vía localStorage + URL param.
 * Funciona en modo static (SSG).
 */

export interface Props {
  currentPath: string;
  lang: 'es' | 'en';
}

const { currentPath, lang } = Astro.props;
const opposite = lang === 'es' ? 'en' : 'es';
