</div>

<script>
  const btn = document.getElementById('lang-switcher-btn') as HTMLAnchorElement;
  const label = document.getElementById('lang-label')!;
  if (btn && label) {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const url = new URL(btn.href);
      const next = url.searchParams.get('lang') === 'es' ? 'es' : 'en';
      localStorage.setItem('campfit_lang', next);
      document.documentElement.lang = next;
      window.location.href = btn.href;
    });
  }
</script>
