---
/**
 * PageTransition.astro — Wrapper para transiciones suaves entre vistas.
 *
 * @prop { 'fade' | 'fade-up' | 'fade-down' | 'scale' | 'slide-right' } [animation] - Tipo de entrada.
 * @prop { string } [className] - Clases adicionales para el contenedor.
 * @prop { string } [transitionName] - Nombre para View Transitions API nombrada.
 * @prop { boolean } [stagger] - Si true, aplica stagger a hijos con .stagger-item.
 */

export interface Props {
  animation?: 'fade' | 'fade-up' | 'fade-down' | 'scale' | 'slide-right';
  className?: string;
  transitionName?: string;
  stagger?: boolean;
}

const {
  animation = 'fade-up',
  className = '',
  transitionName = 'main-content',
  stagger = false,
} = Astro.props;

const animationClass: Record<string, string> = {
  fade: 'animate-fade-in',
  'fade-up': 'animate-fade-in-up',
  'fade-down': 'animate-fade-in-down',
  scale: 'animate-scale-in',
  'slide-right': 'animate-fade-in-right',
};

const staggerAttr = stagger ? 'data-stagger' : '';
---

<div
  class={`cf-page-transition ${animationClass[animation]} ${className}`}
  style={`view-transition-name: ${transitionName};`}
  data-stagger={staggerAttr}
>
  <slot />
</div>

<style>
  .cf-page-transition {
    width: 100%;
  }

  .cf-page-transition[data-stagger] .stagger-item {
    animation: cf-fade-in-up var(--duration-normal) var(--ease-out-expo) both;
  }

  .cf-page-transition[data-stagger] .stagger-item:nth-child(1) {
    animation-delay: var(--stagger-1);
  }
  .cf-page-transition[data-stagger] .stagger-item:nth-child(2) {
    animation-delay: var(--stagger-2);
  }
  .cf-page-transition[data-stagger] .stagger-item:nth-child(3) {
    animation-delay: var(--stagger-3);
  }
  .cf-page-transition[data-stagger] .stagger-item:nth-child(4) {
    animation-delay: var(--stagger-4);
  }
  .cf-page-transition[data-stagger] .stagger-item:nth-child(5) {
    animation-delay: var(--stagger-5);
  }
  .cf-page-transition[data-stagger] .stagger-item:nth-child(6) {
    animation-delay: var(--stagger-6);
  }
  .cf-page-transition[data-stagger] .stagger-item:nth-child(7) {
    animation-delay: var(--stagger-7);
  }
  .cf-page-transition[data-stagger] .stagger-item:nth-child(8) {
    animation-delay: var(--stagger-8);
  }
</style>
