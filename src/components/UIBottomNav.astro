---
/**
 * UIBottomNav - Futuristic Material Bottom Navigation Bar
 * Mobile-first, theme-aware, with floating action button support.
 */
export interface NavItem {
  label: string;
  href: string;
  icon: string;        // SVG path string
  badge?: string;      // Optional notification count
  active?: boolean;
}

export interface Props {
  items: NavItem[];
  /** ID de la ruta actual para marcar activa */
  currentRoute?: string;
  class?: string;
}

const { items = [], currentRoute = '' } = Astro.props;

function isActive(item: NavItem): boolean {
  if (item.active) return true;
  if (!currentRoute) return false;
  return currentRoute.startsWith(item.href) || currentRoute === item.href;
}
---

<nav
  class="fixed bottom-0 left-0 right-0 z-50 safe-area-bottom"
>
  <!-- Glass background with top border glow -->
  <div class="absolute inset-0 glass border-t border-[var(--border-subtle)]"></div>
  
  <!-- Gradient top line -->
  <div class="absolute top-0 left-1/4 right-1/4 h-[1px] bg-gradient-to-r from-transparent via-[var(--brand)] to-transparent opacity-40"></div>

  <!-- Nav items -->
  <div class="relative flex items-center justify-around h-16 px-2">
    {items.map((item) => {
      const active = isActive(item);
      return (
        <a
          href={item.href}
          class={[
            'relative flex flex-col items-center justify-center gap-0.5',
            'min-w-[3.5rem] h-full px-1',
            'transition-all duration-200 ease-out',
            'group',
            active
              ? 'text-[var(--brand)]'
              : 'text-[var(--text-tertiary)] hover:text-[var(--text-secondary)]',
          ].join(' ')}
          aria-label={item.label}
          aria-current={active ? 'page' : undefined}
        >
          {/* Active indicator pill */}
          {active && (
            <span class="absolute -top-0.5 left-1/2 -translate-x-1/2 w-8 h-[3px] rounded-full bg-[var(--brand)] shadow-[0_0_8px_var(--brand-glow)]"></span>
          )}

          {/* Icon container */}
          <span class={[
            'relative flex items-center justify-center w-7 h-7 transition-transform duration-200',
            active ? 'scale-110' : 'group-hover:scale-105',
          ].join(' ')}>
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill={active ? 'currentColor' : 'none'} stroke="currentColor" stroke-width={active ? '2.5' : '2'} stroke-linecap="round" stroke-linejoin="round">
              {item.icon}
            </svg>

            {/* Badge */}
            {item.badge && (
              <span class={[
                'absolute -top-1 -right-2 min-w-[18px] h-[18px]',
                'flex items-center justify-center',
                'rounded-full text-[10px] font-bold leading-none',
                'bg-[var(--danger)] text-white',
                'shadow-[var(--shadow-sm)]',
                'px-1',
              ].join(' ')}>
                {item.badge}
              </span>
            )}
          </span>

          {/* Label */}
          <span class={[
            'text-[10px] font-medium leading-tight transition-all duration-200',
            active ? 'opacity-100' : 'opacity-70 group-hover:opacity-100',
          ].join(' ')}>
            {item.label}
          </span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  .safe-area-bottom {
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
</style>
</write_to_file>