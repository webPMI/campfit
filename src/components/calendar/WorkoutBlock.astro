---
interface Props {
  workout: {
    name: string;
    description?: string;
    estimatedTime?: string;
    isCompleted?: boolean;
  };
}

const { workout } = Astro.props;
---

<div 
  class={`p-3 rounded-lg border shadow-sm transition-all duration-300 z-10 ${
    workout.isCompleted ? 'bg-zinc-100 border-zinc-200 dark:bg-zinc-800 dark:border-zinc-700 opacity-60' : 'bg-amber-50 border-amber-200 dark:bg-amber-900/20 dark:border-amber-800/30'
  }`}
>
  <div class="flex justify-between items-start">
    <span class={`font-bold text-sm ${workout.isCompleted ? 'text-zinc-500' : 'text-amber-700 dark:text-amber-400'}`}>{workout.name}</span>
    {workout.isCompleted && (
      <span class="text-green-600 text-xs font-bold">✓ Completado</span>
    )}
  </div>
  {workout.description && <p class="text-xs text-zinc-500 line-clamp-1">{workout.description}</p>}
</div>
