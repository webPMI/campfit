---
/**
 * ChatNotificationListener
 * Escucha en tiempo real los mensajes no leídos del usuario autenticado.
 * Actualiza las insignias (badges) en la navegación e informa mediante toast/sonido/notificaciones locales.
 */
---

<div id="chat-notification-listener-root" style="display:none;" aria-hidden="true"></div>

<script>
  import { onAuthStateChanged } from 'firebase/auth';
  import { auth } from '@/lib/firebase';
  import { subscribeToUnreadCount } from '@/lib/shared/chat';
  import { showToast } from '@/lib/shared/ui';
  import { showLocalNotification } from '@/lib/notifications/notificationService';

  let unsubscribeListener: (() => void) | null = null;
  let prevUnreadCount: number | null = null;
  let isInitialLoad = true;

  function playNotificationChime(): void {
    try {
      const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioContextClass) return;
      const ctx = new AudioContextClass();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      osc.type = 'sine';
      osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
      osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.15); // A5

      gain.gain.setValueAtTime(0.15, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);

      osc.connect(gain);
      gain.connect(ctx.destination);

      osc.start();
      osc.stop(ctx.currentTime + 0.3);
    } catch (e) {
      // Ignorar restricciones de autoplay de audio
    }
  }

  function updateNavBadges(count: number): void {
    // Buscar todos los enlaces de navegación a chat (/client/chat, /trainer/chat, /admin/chat)
    const chatLinks = document.querySelectorAll<HTMLAnchorElement>('a[href*="/chat"]');

    chatLinks.forEach((link) => {
      // Asegurar posición relativa en el enlace o en su icono contenedor
      const iconContainer = link.querySelector('.w-5, .h-5, svg')?.parentElement || link;
      if (iconContainer && !iconContainer.classList.contains('relative')) {
        iconContainer.classList.add('relative');
      }

      let badge = link.querySelector('.chat-nav-badge') as HTMLElement | null;

      if (count > 0) {
        const text = count > 99 ? '99+' : count.toString();
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'chat-nav-badge absolute -top-1.5 -right-2.5 min-w-[18px] h-[18px] flex items-center justify-center rounded-full text-[10px] font-bold leading-none bg-[var(--danger)] text-white shadow-[0_0_8px_var(--danger)] px-1 animate-pulse z-20 pointer-events-none';
          (iconContainer || link).appendChild(badge);
        }
        badge.textContent = text;
        badge.style.display = 'flex';
      } else if (badge) {
        badge.style.display = 'none';
      }
    });
  }

  function initChatListener(uid: string): void {
    if (unsubscribeListener) {
      unsubscribeListener();
      unsubscribeListener = null;
    }

    isInitialLoad = true;
    prevUnreadCount = null;

    unsubscribeListener = subscribeToUnreadCount(uid, (count, messages) => {
      updateNavBadges(count);

      const currentPath = window.location.pathname;
      const isCurrentlyInChat = currentPath.includes('/chat');

      // Si llegó un nuevo mensaje mientras no se estaba en la página de chat
      if (!isInitialLoad && prevUnreadCount !== null && count > prevUnreadCount) {
        if (!isCurrentlyInChat) {
          playNotificationChime();

          const latestMsg = messages[messages.length - 1];
          const snippet = latestMsg?.content
            ? (latestMsg.content.length > 50 ? latestMsg.content.substring(0, 50) + '...' : latestMsg.content)
            : 'Tienes un nuevo mensaje';

          showToast({
            message: `💬 ${snippet}`,
            type: 'info',
            duration: 4500,
          });

          showLocalNotification('CampFit — Nuevo mensaje', {
            body: snippet,
            tag: 'chat-unread',
          });
        }
      }

      prevUnreadCount = count;
      isInitialLoad = false;
    });
  }

  onAuthStateChanged(auth, (user) => {
    if (user) {
      initChatListener(user.uid);
    } else {
      if (unsubscribeListener) {
        unsubscribeListener();
        unsubscribeListener = null;
      }
      updateNavBadges(0);
      prevUnreadCount = null;
      isInitialLoad = true;
    }
  });

  // Re-aplicar insignias cuando la vista se actualice
  document.addEventListener('DOMContentLoaded', () => {
    if (prevUnreadCount !== null) {
      updateNavBadges(prevUnreadCount);
    }
  });

  document.addEventListener('astro:after-swap', () => {
    if (prevUnreadCount !== null) {
      updateNavBadges(prevUnreadCount);
    }
  });
</script>
