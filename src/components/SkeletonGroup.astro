---
/**
 * SkeletonGroup.astro — Composiciones de skeleton pre-construidas.
 *
 * @prop { string } variant - Tipo de composición: 'dashboard' | 'list' | 'card-grid' | 'form' | 'profile' | 'table'
 * @prop { number } [items] - Número de items a renderizar.
 * @prop { string } [className] - Clases adicionales.
 */

import Skeleton from './Skeleton.astro';

export interface Props {
  variant: 'dashboard' | 'list' | 'card-grid' | 'form' | 'profile' | 'table';
  items?: number;
  className?: string;
}

const { variant, items = 5, className = '' } = Astro.props;
const itemCount = Math.min(items, 12);
---

{variant === 'dashboard' && (
  <div class={`cf-sg-dashboard ${className}`} role="status" aria-label="Cargando panel...">
    <div class="cf-sg-header">
      <Skeleton variant="circle" width="48px" height="48px" />
      <div class="cf-sg-header-text">
        <Skeleton variant="text" height="20px" width="60%" />
        <Skeleton variant="text" height="14px" width="40%" />
      </div>
    </div>
    <div class="cf-sg-stats">
      {Array.from({ length: 3 }).map((_, i) => (
        <div class="cf-sg-stat-card stagger-item" style={`animation-delay: var(--stagger-${i + 1})`}>
          <Skeleton variant="text" height="12px" width="50px" />
          <Skeleton variant="text" height="24px" width="80px" />
        </div>
      ))}
    </div>
    <div class="cf-sg-actions">
      {Array.from({ length: 4 }).map((_, i) => (
        <div class="cf-sg-action stagger-item" style={`animation-delay: var(--stagger-${i + 1})`}>
          <Skeleton variant="circle" width="40px" height="40px" />
          <Skeleton variant="text" height="12px" width="60px" />
        </div>
      ))}
    </div>
    <div class="cf-sg-content">
      <Skeleton variant="rect" height="180px" />
    </div>
  </div>
)}

{variant === 'list' && (
  <div class={`cf-sg-list ${className}`} role="status" aria-label="Cargando lista...">
    {Array.from({ length: itemCount }).map((_, i) => (
      <div class="cf-sg-list-item stagger-item" style={`animation-delay: var(--stagger-${Math.min(i + 1, 8)})`}>
        <Skeleton variant="circle" width="44px" height="44px" />
        <div class="cf-sg-list-text">
          <Skeleton variant="text" height="16px" width="70%" />
          <Skeleton variant="text" height="12px" width="50%" />
        </div>
        <Skeleton variant="rect" width="60px" height="24px" />
      </div>
    ))}
  </div>
)}

{variant === 'card-grid' && (
  <div class={`cf-sg-card-grid ${className}`} role="status" aria-label="Cargando tarjetas...">
    {Array.from({ length: itemCount }).map((_, i) => (
      <div class="cf-sg-card stagger-item" style={`animation-delay: var(--stagger-${Math.min(i + 1, 8)})`}>
        <Skeleton variant="rect" height="120px" />
        <div class="cf-sg-card-body">
          <Skeleton variant="text" height="16px" width="80%" />
          <Skeleton variant="text" height="12px" width="60%" />
          <Skeleton variant="text" height="12px" width="40%" />
        </div>
      </div>
    ))}
  </div>
)}

{variant === 'form' && (
  <div class={`cf-sg-form ${className}`} role="status" aria-label="Cargando formulario...">
    {Array.from({ length: itemCount }).map((_, i) => (
      <div class="cf-sg-form-field stagger-item" style={`animation-delay: var(--stagger-${Math.min(i + 1, 8)})`}>
        <Skeleton variant="text" height="14px" width="100px" />
        <Skeleton variant="rect" height="44px" width="100%" />
      </div>
    ))}
    <div class="cf-sg-form-actions">
      <Skeleton variant="rect" width="120px" height="44px" />
    </div>
  </div>
)}

{variant === 'profile' && (
  <div class={`cf-sg-profile ${className}`} role="status" aria-label="Cargando perfil...">
    <div class="cf-sg-profile-header">
      <Skeleton variant="circle" width="80px" height="80px" />
      <div class="cf-sg-profile-info">
        <Skeleton variant="text" height="22px" width="50%" />
        <Skeleton variant="text" height="14px" width="35%" />
      </div>
    </div>
    <div class="cf-sg-profile-fields">
      {Array.from({ length: 4 }).map((_, i) => (
        <div class="cf-sg-profile-field stagger-item" style={`animation-delay: var(--stagger-${i + 1})`}>
          <Skeleton variant="text" height="12px" width="80px" />
          <Skeleton variant="text" height="16px" width="100%" />
        </div>
      ))}
    </div>
  </div>
)}

{variant === 'table' && (
  <div class={`cf-sg-table ${className}`} role="status" aria-label="Cargando tabla...">
    <div class="cf-sg-table-header">
      {Array.from({ length: 4 }).map(() => (
        <Skeleton variant="text" height="14px" width="80px" />
      ))}
    </div>
    {Array.from({ length: itemCount }).map((_, i) => (
      <div class="cf-sg-table-row stagger-item" style={`animation-delay: var(--stagger-${Math.min(i + 1, 8)})`}>
        {Array.from({ length: 4 }).map(() => (
          <Skeleton variant="text" height="14px" width="90%" />
        ))}
      </div>
    ))}
  </div>
)}


