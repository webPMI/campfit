---
/**
 * DecorativeBackground - Theme-aware ambient background with floating orbs.
 * Uses CSS variables for dark/light compatibility.
 * Subtle 3D depth with layered gradients and animated floating elements.
 */
---

<div class="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
  <!-- Primary orb - top left -->
  <div class="absolute -left-20 -top-20 h-72 w-72 rounded-full bg-[var(--brand)] opacity-[0.04] blur-3xl animate-[float_8s_ease-in-out_infinite]"></div>

  <!-- Secondary orb - bottom right -->
  <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-[var(--accent-purple)] opacity-[0.03] blur-3xl animate-[float_10s_ease-in-out_infinite_2s]"></div>

  <!-- Tertiary orb - center -->
  <div class="absolute left-1/3 top-1/2 h-64 w-64 rounded-full bg-[var(--info)] opacity-[0.02] blur-3xl animate-[float_12s_ease-in-out_infinite_4s]"></div>

  <!-- Subtle moving highlight -->
  <div class="absolute left-1/2 top-0 h-40 w-[600px] -translate-x-1/2 rounded-full bg-[var(--brand)] opacity-[0.015] blur-3xl animate-[float_6s_ease-in-out_infinite_1s]"></div>
</div>


</write_to_file>