---
/**
 * ErrorState Component — Estado de error para secciones con fallos.
 *
 * @description Muestra un estado visual cuando ocurre un error,
 * con mensaje descriptivo, código opcional y botón de reintentar.
 *
 * @usage
 * ```astro
 * <ErrorState
 *   title="Error al cargar"
 *   message="No se pudieron cargar los datos del cliente."
 *   errorCode={500}
 *   retryHref="/dashboard"
 * />
 * ```
 *
 * @param {string}        [icon="alert"]    - Nombre del icono de error
 * @param {string}        [title]           - Título del error
 * @param {string}        [message]         - Mensaje descriptivo del error
 * @param {string|number} [errorCode]       - Código de error (HTTP, etc.)
 * @param {string}        [retryHref]       - URL para reintentar (recarga)
 * @param {string}        [retryLabel]      - Texto del botón reintentar
 * @param {string}        [class=""]         - Clases CSS adicionales
 *
 * @accessibility
 * - role="alert" para notificar inmediatamente a screen readers
 * - focus en el botón de reintentar si está presente
 * - Contraste suficiente en colores de error
 */

import Icon from './Icon.astro';

export interface Props {
  /** Nombre del icono a mostrar. Default: "alert" */
  icon?: string;
  /** Título del error. Default: "Algo salió mal" */
  title?: string;
  /** Mensaje descriptivo del error */
  message?: string;
  /** Código de error (HTTP, interno, etc.) */
  errorCode?: string | number;
  /** URL para reintentar (navegación) */
  retryHref?: string;
  /** Texto del botón reintentar. Default: "Reintentar" */
  retryLabel?: string;
  /** Clases CSS adicionales */
  class?: string;
}

const {
  icon = 'alert',
  title = 'Algo salió mal',
  message,
  errorCode,
  retryHref,
  retryLabel = 'Reintentar',
  class: className = '',
} = Astro.props;
---

<div
  role="alert"
  class="flex flex-col items-center justify-center py-12 px-6 text-center {className}"
>
  <div class="mb-4 theme-text-error">
    <Icon name={icon} size={48} />
  </div>

  <h3 class="text-lg font-semibold theme-text-primary mb-2">
    {title}
  </h3>

  {message && (
    <p class="text-sm theme-text-secondary max-w-md mb-2">
      {message}
    </p>
  )}

  {errorCode && (
    <p class="text-xs theme-text-tertiary font-mono mb-6">
      Error: {errorCode}
    </p>
  )}

  {retryHref && (
    <a
      href={retryHref}
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg theme-brand text-sm font-medium transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2"
    >
      <Icon name="refresh" size={16} />
      {retryLabel}
    </a>
  )}
</div>