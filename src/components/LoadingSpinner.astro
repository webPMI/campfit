---
/**
 * LoadingSpinner Component — Indicador de carga animado.
 *
 * @description Spinner circular CSS puro para indicar carga de contenido.
 * Respeta prefers-reduced-motion y es accesible por defecto.
 *
 * @usage
 * ```astro
 * <LoadingSpinner size="md" />
 * <LoadingSpinner size="lg" class="text-brand" />
 * ```
 *
 * @param {'sm'|'md'|'lg'} [size="md"] - Tamaño del spinner
 * @param {string}         [class=""]   - Clases CSS adicionales
 * @param {string}         [label]      - Texto accesible para screen readers
 *
 * @accessibility
 * - aria-busy="true" en el contenedor
 * - role="status" para anunciar carga
 * - sr-only text descriptivo
 * - Respeta prefers-reduced-motion (pausa animación)
 */

export interface Props {
  /** Tamaño del spinner: 'sm' (16px), 'md' (24px), 'lg' (36px). Default: 'md' */
  size?: 'sm' | 'md' | 'lg';
  /** Clases CSS adicionales */
  class?: string;
  /** Texto accesible para screen readers. Default: "Cargando..." */
  label?: string;
}

const { size = 'md', class: className = '', label = 'Cargando...' } = Astro.props;

const sizeMap: Record<string, string> = {
  sm: 'w-4 h-4',
  md: 'w-6 h-6',
  lg: 'w-9 h-9',
};

const borderMap: Record<string, string> = {
  sm: 'border-2',
  md: 'border-2',
  lg: 'border-3',
};
---

<div
  role="status"
  aria-busy="true"
  class="inline-flex items-center justify-center {className}"
>
  <span class="sr-only">{label}</span>
  <div
    class="
      {sizeMap[size] || sizeMap.md}
      {borderMap[size] || borderMap.md}
      rounded-full
      border-current
      border-r-transparent
      animate-spin
      theme-text-brand
    "
    style="
      animation-duration: 700ms;
    "
  ></div>
</div>

