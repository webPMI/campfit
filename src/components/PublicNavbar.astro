---
import UILogoIcon from '@/components/UILogoIcon.astro';
import UIThemeSwitcher from '@/components/UIThemeSwitcher.astro';
import { translations, type Language } from '@/i18n/translations';

export interface Props {
  currentPath: string;
  lang?: Language;
}

const { currentPath } = Astro.props;
const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
const altLang = lang === 'es' ? 'en' : 'es';
---

<header class="sticky top-0 z-50 w-full border-b border-[var(--border-default)] bg-[var(--surface-1)]/85 backdrop-blur-md transition-colors duration-200">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href={`/?lang=${lang}`} class="flex items-center gap-2.5 group">
      <UILogoIcon size="md" />
      <span class="text-xl font-bold tracking-tight text-[var(--text-primary)] group-hover:text-[var(--brand)] transition-colors">
        Camp<span class="bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] bg-clip-text text-transparent">Fit</span>
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <a href={`/?lang=${lang}`} class={`transition-colors hover:text-[var(--brand)] ${currentPath === '/' ? 'text-[var(--brand)] font-semibold' : 'text-[var(--text-secondary)]'}`}>
        {t('public.nav.home')}
      </a>
      <a href={`/?lang=${lang}#features`} class="text-[var(--text-secondary)] hover:text-[var(--brand)] transition-colors">
        {t('public.nav.features')}
      </a>
      <a href={`/contact?lang=${lang}`} class={`transition-colors hover:text-[var(--brand)] ${currentPath === '/contact' ? 'text-[var(--brand)] font-semibold' : 'text-[var(--text-secondary)]'}`}>
        {t('public.nav.contact')}
      </a>
      <a href={`/privacy?lang=${lang}`} class={`transition-colors hover:text-[var(--brand)] ${currentPath === '/privacy' ? 'text-[var(--brand)] font-semibold' : 'text-[var(--text-secondary)]'}`}>
        {t('public.nav.privacy')}
      </a>
    </nav>

    <!-- Desktop Controls & CTAs -->
    <div class="hidden md:flex items-center gap-3">
      <UIThemeSwitcher />
      
      <!-- Language Selector Button -->
      <a
        href={`${currentPath}?lang=${altLang}`}
        aria-label="Cambiar idioma"
        class="inline-flex items-center gap-1.5 rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-3 py-1.5 text-xs font-semibold text-[var(--text-secondary)] transition-all hover:border-[var(--border-strong)] hover:text-[var(--text-primary)] active:scale-95"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
        </svg>
        {altLang === 'en' ? 'EN' : 'ES'}
      </a>

      <!-- Auth CTAs -->
      <a
        href={`/login?lang=${lang}`}
        class="inline-flex items-center rounded-xl px-3.5 py-1.5 text-xs font-semibold text-[var(--text-secondary)] transition-all hover:text-[var(--text-primary)] hover:bg-[var(--surface-2)]"
      >
        {t('public.nav.login')}
      </a>
      <a
        href={`/register?lang=${lang}`}
        class="inline-flex items-center rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-4 py-1.5 text-xs font-semibold text-white shadow-md transition-all hover:shadow-lg hover:opacity-95 active:scale-95"
      >
        {t('public.nav.register')}
      </a>
    </div>

    <!-- Mobile Controls & Hamburger Toggle -->
    <div class="flex items-center gap-2 md:hidden">
      <UIThemeSwitcher />
      <button
        id="public-mobile-menu-btn"
        type="button"
        aria-label="Abrir menú de navegación"
        class="inline-flex items-center justify-center rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] p-2 text-[var(--text-secondary)] hover:text-[var(--text-primary)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--brand)]"
      >
        <svg id="hamburger-icon" class="h-5 w-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="close-icon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="public-mobile-menu" class="hidden md:hidden border-t border-[var(--border-default)] bg-[var(--surface-1)] px-4 pb-6 pt-4">
    <div class="flex flex-col gap-3 font-medium text-sm">
      <a href={`/?lang=${lang}`} class="rounded-lg px-3 py-2 text-[var(--text-primary)] hover:bg-[var(--surface-2)]">
        {t('public.nav.home')}
      </a>
      <a href={`/?lang=${lang}#features`} class="rounded-lg px-3 py-2 text-[var(--text-secondary)] hover:bg-[var(--surface-2)] hover:text-[var(--text-primary)]">
        {t('public.nav.features')}
      </a>
      <a href={`/contact?lang=${lang}`} class="rounded-lg px-3 py-2 text-[var(--text-secondary)] hover:bg-[var(--surface-2)] hover:text-[var(--text-primary)]">
        {t('public.nav.contact')}
      </a>
      <a href={`/privacy?lang=${lang}`} class="rounded-lg px-3 py-2 text-[var(--text-secondary)] hover:bg-[var(--surface-2)] hover:text-[var(--text-primary)]">
        {t('public.nav.privacy')}
      </a>
      <a href={`/terms?lang=${lang}`} class="rounded-lg px-3 py-2 text-[var(--text-secondary)] hover:bg-[var(--surface-2)] hover:text-[var(--text-primary)]">
        {t('public.nav.terms')}
      </a>

      <div class="my-2 border-t border-[var(--border-default)]"></div>

      <div class="flex items-center justify-between px-3 py-1">
        <span class="text-xs text-[var(--text-tertiary)]">Idioma / Language</span>
        <a
          href={`${currentPath}?lang=${altLang}`}
          class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border-default)] bg-[var(--surface-2)] px-3 py-1 text-xs font-semibold text-[var(--text-primary)]"
        >
          {altLang === 'en' ? 'English' : 'Español'}
        </a>
      </div>

      <div class="flex flex-col gap-2 pt-2">
        <a
          href={`/login?lang=${lang}`}
          class="flex items-center justify-center rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] py-2.5 text-xs font-semibold text-[var(--text-primary)]"
        >
          {t('public.nav.login')}
        </a>
        <a
          href={`/register?lang=${lang}`}
          class="flex items-center justify-center rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] py-2.5 text-xs font-semibold text-white shadow-md"
        >
          {t('public.nav.register')}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('public-mobile-menu-btn');
  const menu = document.getElementById('public-mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && menu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        hamburgerIcon.classList.remove('block');
        closeIcon.classList.remove('hidden');
        closeIcon.classList.add('block');
      } else {
        menu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        hamburgerIcon.classList.add('block');
        closeIcon.classList.add('hidden');
        closeIcon.classList.remove('block');
      }
    });
  }
</script>
