---
interface Props {
  id?: string;
  initialTime?: string;
  placeholder?: string;
  class?: string;
}

const {
  id = 'time-picker',
  initialTime = '',
  placeholder = 'Asignar hora',
  class: className = '',
} = Astro.props;
---

<div data-time-picker class={`relative inline-block ${className}`} id={id}>
  <input
    type="time"
    value={initialTime}
    class="rounded-lg border border-[var(--border-default)] bg-[var(--surface-3)] px-3 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--brand)]"
    placeholder={placeholder}
  />
</div>
