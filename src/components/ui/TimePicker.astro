<script>
  let { onSelect } = $props();
  let isOpen = false;
  let selectedTime = "";

  // Cerrar si se hace clic fuera
  const handleClickOutside = (event) => {
    if (!event.target.closest('[data-time-picker]')) {
      isOpen = false;
    }
  };

  document.addEventListener('click', handleClickOutside);

  function selectTime(hour, minute) {
    const time = `${hour.toString().padStart(2, '0')}:${minute.toString().padStart(2, '0')}`;
    selectedTime = time;
    isOpen = false;
    if (onSelect) onSelect(time);
  }
</script>

<div 
  data-time-picker
  class="relative inline-block"
  id="time-picker-container"
>
  <button 
    type="button"
    class="px-3 py-1 text-xs font-medium bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
    onclick="isOpen = !isOpen"
  >
    {selectedTime ? selectedTime : 'Asignar hora'}
  </button>

  {#if isOpen}
    <div class="absolute z-50 mt-2 p-4 bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 shadow-xl rounded-xl w-48">
      <div class="grid grid-cols-4 gap-2">
        {Array.from({ length: 24 }, (_, h) => h).map((h) => (
          <button 
            class="p-2 text-xs hover:bg-blue-100 dark:hover:bg-blue-900/30 rounded-md transition-colors"
            onclick="selectTime({h: h, m: 0})"
          >
            {h.toString().padStart(2, '0')}
          </button>
        ))}
      </div>
      <div class="mt-4 pt-4 border-t border-zinc-200 dark:border-zinc-700">
        <button 
          class="w-full py-2 text-xs font-bold text-red-600 hover:text-red-700"
          onclick="isOpen = false"
        >
          Cancelar
        </button>
      </div>
      </div>
    </div>
  {/if}
</div>
