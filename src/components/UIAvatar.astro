---
/**
 * UIAvatar - Theme-aware avatar component.
 * Supports image, initials, and status indicator.
 */
export interface Props {
  /** URL de imagen de avatar */
  src?: string;
  /** Nombre para generar iniciales */
  name?: string;
  /** Tamaño */
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  /** Estado online/offline */
  status?: 'online' | 'offline' | 'away' | 'busy';
  /** Clases adicionales */
  class?: string;
}

const { src, name = '', size = 'md', status } = Astro.props;

const sizeClasses: Record<string, string> = {
  xs: 'h-6 w-6 text-[10px]',
  sm: 'h-8 w-8 text-xs',
  md: 'h-10 w-10 text-sm',
  lg: 'h-12 w-12 text-base',
  xl: 'h-16 w-16 text-lg',
};

const statusSizes: Record<string, string> = {
  xs: 'h-1.5 w-1.5 ring-1',
  sm: 'h-2 w-2 ring-1',
  md: 'h-2.5 w-2.5 ring-[1.5px]',
  lg: 'h-3 w-3 ring-2',
  xl: 'h-3.5 w-3.5 ring-2',
};

const statusColors: Record<string, string> = {
  online: 'bg-[var(--success)]',
  offline: 'bg-[var(--text-disabled)]',
  away: 'bg-[var(--warning)]',
  busy: 'bg-[var(--danger)]',
};

const init = (name || '?').charAt(0).toUpperCase();
---

<span class={['relative inline-flex shrink-0', Astro.props.class ?? ''].join(' ')}>
  {src ? (
    <img
      src={src}
      alt={name || 'Avatar'}
      class={['rounded-full object-cover', sizeClasses[size]].join(' ')}
      loading="lazy"
    />
  ) : (
    <span class={[
      'rounded-full flex items-center justify-center font-semibold',
      'bg-gradient-to-br from-[var(--brand-hover)] to-[var(--brand)] text-[var(--text-on-brand)]',
      'shadow-[var(--shadow-sm)]',
      sizeClasses[size],
    ].join(' ')}>
      {init}
    </span>
  )}

  {status && (
    <span class={[
      'absolute bottom-0 right-0 rounded-full',
      'ring-[var(--surface-0)]',
      statusColors[status],
      statusSizes[size],
    ].join(' ')}
    aria-label={status}
    ></span>
  )}
</span>
</write_to_file>