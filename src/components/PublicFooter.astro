---
import UILogoIcon from '@/components/UILogoIcon.astro';
import { translations, type Language } from '@/i18n/translations';

export interface Props {
  lang?: Language;
}

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<footer class="w-full border-t border-[var(--border-default)] bg-[var(--surface-1)] transition-colors duration-200 mt-auto">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <!-- Col 1: Brand & Bio -->
      <div class="md:col-span-2 flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <UILogoIcon size="md" />
          <span class="text-xl font-bold tracking-tight text-[var(--text-primary)]">
            Camp<span class="bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] bg-clip-text text-transparent">Fit</span>
          </span>
        </div>
        <p class="text-xs text-[var(--text-secondary)] max-w-sm leading-relaxed">
          {t('public.footer.desc')}
        </p>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="flex flex-col gap-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-primary)]">
          {t('public.footer.quickLinks')}
        </h3>
        <ul class="flex flex-col gap-2 text-xs font-medium text-[var(--text-secondary)]">
          <li>
            <a href={`/?lang=${lang}`} class="hover:text-[var(--brand)] transition-colors">{t('public.nav.home')}</a>
          </li>
          <li>
            <a href={`/?lang=${lang}#features`} class="hover:text-[var(--brand)] transition-colors">{t('public.nav.features')}</a>
          </li>
          <li>
            <a href={`/login?lang=${lang}`} class="hover:text-[var(--brand)] transition-colors">{t('public.nav.login')}</a>
          </li>
          <li>
            <a href={`/register?lang=${lang}`} class="hover:text-[var(--brand)] transition-colors">{t('public.nav.register')}</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Legal & Support -->
      <div class="flex flex-col gap-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-primary)]">
          {t('public.footer.legal')}
        </h3>
        <ul class="flex flex-col gap-2 text-xs font-medium text-[var(--text-secondary)]">
          <li>
            <a href={`/privacy?lang=${lang}`} class="hover:text-[var(--brand)] transition-colors">{t('public.nav.privacy')}</a>
          </li>
          <li>
            <a href={`/terms?lang=${lang}`} class="hover:text-[var(--brand)] transition-colors">{t('public.nav.terms')}</a>
          </li>
          <li>
            <a href={`/cookies?lang=${lang}`} class="hover:text-[var(--brand)] transition-colors">{t('public.nav.cookies')}</a>
          </li>
          <li>
            <a href={`/contact?lang=${lang}`} class="hover:text-[var(--brand)] transition-colors">{t('public.nav.contact')}</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-10 pt-6 border-t border-[var(--border-default)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--text-tertiary)]">
      <p>© {new Date().getFullYear()} CampFit. {t('public.footer.rights')}</p>
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Sistema Operativo
        </span>
        <span>•</span>
        <span>WCAG 2.1 AA Compliance</span>
      </div>
    </div>
  </div>
</footer>
