---
import { type Language } from "@/i18n/translations";

interface Props {
  currentPath?: string;
  lang?: Language;
}

const { lang = "es" } = Astro.props;

const languages = [
  { code: "es" as const, label: "ES", name: "Español", flag: "🇪🇸" },
  { code: "en" as const, label: "EN", name: "English", flag: "🇬🇧" },
];

const currentLang = languages.find((l) => l.code === lang) ?? languages[0]!;
---

<div class="relative inline-block text-left" data-ui-lang-dropdown>
  <button
    type="button"
    class="inline-flex items-center gap-1.5 rounded-xl border border-[var(--border-default)] bg-[var(--surface-1)] px-3 py-2 text-xs font-semibold text-[var(--text-secondary)] backdrop-blur-sm transition-all duration-200 hover:border-[var(--border-strong)] hover:text-[var(--text-primary)] active:scale-95"
    data-lang-btn
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span data-lang-flag class="text-sm shrink-0">{currentLang.flag}</span>
    <span data-lang-label>{currentLang.label}</span>
    <svg class="h-3 w-3 text-[var(--text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </button>

  <div
    data-lang-menu
    class="hidden absolute right-0 mt-2 w-40 origin-top-right rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)] p-1.5 shadow-2xl backdrop-blur-xl ring-1 ring-black/5 focus:outline-none z-50 animate-fade-in"
    role="menu"
  >
    {languages.map((l) => (
      <button
        type="button"
        data-lang-code={l.code}
        class={`flex items-center gap-2.5 rounded-xl px-3 py-2 text-xs font-medium transition-all duration-150 w-full text-left ${
          l.code === lang
            ? "bg-[var(--brand-dim)] text-[var(--brand)] font-bold"
            : "text-[var(--text-secondary)] hover:bg-[var(--surface-2)] hover:text-[var(--text-primary)]"
        }`}
      >
        <span class="text-sm shrink-0">{l.flag}</span>
        <span>{l.name}</span>
      </button>
    ))}
  </div>
</div>

<script>
  import { getStoredLanguage, setStoredLanguage } from "@/i18n/client";

  const langConfig: Record<string, { label: string; flag: string }> = {
    es: { label: "ES", flag: "🇪🇸" },
    en: { label: "EN", flag: "🇬🇧" },
  };

  document.querySelectorAll("[data-ui-lang-dropdown]").forEach((container) => {
    const btn = container.querySelector("[data-lang-btn]") as HTMLButtonElement | null;
    const menu = container.querySelector("[data-lang-menu]") as HTMLElement | null;
    const flagSpan = container.querySelector("[data-lang-flag]") as HTMLElement | null;
    const labelSpan = container.querySelector("[data-lang-label]") as HTMLElement | null;

    if (!btn || !menu) return;

    // Sincronizar botón del selector con el idioma almacenado en localStorage al cargar la página
    const activeLang = getStoredLanguage();
    if (langConfig[activeLang]) {
      if (flagSpan) flagSpan.textContent = langConfig[activeLang].flag;
      if (labelSpan) labelSpan.textContent = langConfig[activeLang].label;
    }

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isExpanded));
      menu.classList.toggle("hidden");
    });

    document.addEventListener("click", (e) => {
      if (!container.contains(e.target as Node)) {
        btn.setAttribute("aria-expanded", "false");
        menu.classList.add("hidden");
      }
    });

    container.querySelectorAll("[data-lang-code]").forEach((langBtn) => {
      langBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const code = langBtn.getAttribute("data-lang-code") as "es" | "en";
        if (code) {
          setStoredLanguage(code);
          document.cookie = "cf_lang=" + code + ";path=/;max-age=31536000;SameSite=Lax";
          const url = new URL(window.location.href);
          url.searchParams.delete("lang");
          window.location.href = url.toString();
        }
      });
    });
  });
</script>