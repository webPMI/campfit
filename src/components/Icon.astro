---
/**
 * Icon Component — Sistema de iconos SVG basado en Lucide/Feather.
 *
 * @description Proporciona un conjunto de iconos SVG accesibles con tamaño
 * y clase personalizables. Todos los iconos incluyen aria-hidden="true"
 * y focusable="false" para accesibilidad.
 *
 * @usage
 * ```astro
 * <Icon name="home" size={24} class="text-brand" />
 * <Icon name="search" size={20} />
 * ```
 *
 * @param {string} name - Nombre del icono a renderizar
 * @param {number} [size=20] - Tamaño en píxeles (ancho y alto)
 * @param {string} [class=""] - Clases CSS adicionales
 *
 * @accessibility
 * - aria-hidden="true" para evitar que screen readers lean los iconos
 * - focusable="false" para evitar focus en elementos decorativos
 * - Fallback visual "?" si el icono no existe
 */

export interface Props {
  /** Nombre del icono (ver lista completa en la documentación) */
  name: string;
  /** Tamaño en píxeles (ancho y alto). Default: 20 */
  size?: number;
  /** Clases CSS adicionales */
  class?: string;
}

