---
/**
 * EmptyState Component — Estado vacío para listas y secciones sin datos.
 *
 * @description Muestra un estado visual cuando no hay contenido disponible,
 * con un icono grande, título, descripción y un botón de acción opcional.
 *
 * @usage
 * ```astro
 * <EmptyState
 *   title="Sin entrenadores"
 *   description="No hay entrenadores asignados todavía."
 *   actionLabel="Añadir entrenador"
 *   actionHref="/admin/trainers/new"
 * />
 * ```
 *
 * @param {string}  [icon="inbox"]    - Nombre del icono (ver Icon.astro)
 * @param {string}  [title]           - Título del estado vacío (requerido)
 * @param {string}  [description]     - Descripción del estado vacío (requerido)
 * @param {string}  [actionLabel]     - Texto del botón de acción
 * @param {string}  [actionHref]      - URL del botón de acción
 * @param {string}  [class=""]         - Clases CSS adicionales
 *
 * @accessibility
 * - role="status" para que screen readers anuncien el estado
 * - Botón con texto descriptivo
 * - Contraste suficiente entre el texto y el fondo
 */

import Icon from './Icon.astro';

export interface Props {
  /** Nombre del icono a mostrar. Default: "inbox" */
  icon?: string;
  /** Título del estado vacío */
  title: string;
  /** Descripción del estado vacío */
  description: string;
  /** Texto del botón de acción (opcional) */
  actionLabel?: string;
  /** URL del botón de acción (opcional) */
  actionHref?: string;
  /** Clases CSS adicionales */
  class?: string;
}

const {
  icon = 'inbox',
  title,
  description,
  actionLabel,
  actionHref,
  class: className = '',
} = Astro.props;
---

<div
  role="status"
  class="flex flex-col items-center justify-center py-12 px-6 text-center {className}"
>
  <div class="mb-4 theme-text-tertiary">
    <Icon name={icon} size={48} />
  </div>

  <h3 class="text-lg font-semibold theme-text-primary mb-2">
    {title}
  </h3>

  <p class="text-sm theme-text-secondary max-w-md mb-6">
    {description}
  </p>

  {actionLabel && actionHref && (
    <a
      href={actionHref}
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg theme-brand text-sm font-medium transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2"
    >
      <Icon name="plus" size={16} />
      {actionLabel}
    </a>
  )}
</div>