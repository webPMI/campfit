---
import { translations, type Language } from '@/i18n/translations';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<section class="relative pt-8 pb-16 sm:pt-12 sm:pb-24 w-full">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
      
      <!-- Left Column: Copy & Actions -->
      <div class="flex flex-col items-center text-center lg:col-span-7 lg:items-start lg:text-left z-10">
        
        <!-- Gold Luxury Badge -->
        <div class="inline-flex items-center gap-2.5 rounded-full border border-amber-500/30 bg-gradient-to-r from-amber-500/10 via-yellow-500/15 to-amber-500/10 px-4 py-1.5 shadow-[0_0_20px_rgba(245,158,11,0.2)] backdrop-blur-xl animate-fade-in">
          <span class="text-base">👑</span>
          <span class="text-xs font-bold uppercase tracking-widest text-amber-300" data-i18n="hero.badge">
            {t('hero.badge')}
          </span>
          <span class="h-1.5 w-1.5 rounded-full bg-amber-400 animate-ping"></span>
        </div>

        <!-- Headline -->
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-5xl xl:text-6xl leading-[1.1] animate-fade-in-up">
          <span data-i18n="hero.title">{t('hero.title')}</span><br/>
          <span class="bg-gradient-to-r from-amber-200 via-amber-400 to-yellow-500 bg-clip-text text-transparent drop-shadow-[0_2px_15px_rgba(245,158,11,0.35)]" data-i18n="hero.title.highlight">
            {t('hero.title.highlight')}
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="mt-5 max-w-xl text-base sm:text-lg text-zinc-300 leading-relaxed font-normal animate-fade-in-up stagger-2" data-i18n="hero.description">
          {t('hero.description')}
        </p>

        <!-- CTA Action Cluster -->
        <div class="mt-8 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto animate-fade-in-up stagger-3">
          <a
            href="/register"
            class="group relative inline-flex w-full sm:w-auto items-center justify-center gap-3 overflow-hidden rounded-2xl bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-500 bg-[length:200%_auto] px-8 py-4 text-base font-bold text-zinc-950 shadow-[0_0_25px_rgba(245,158,11,0.4)] transition-all duration-300 hover:bg-right hover:shadow-[0_0_35px_rgba(245,158,11,0.6)] hover:scale-[1.02] active:scale-95"
          >
            <span data-i18n="hero.cta">{t('hero.cta')}</span>
            <svg class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
            <!-- Shimmer effect -->
            <div class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/30 to-transparent transition-transform duration-1000 group-hover:translate-x-full"></div>
          </a>

          <a
            href="#video-experience"
            class="inline-flex w-full sm:w-auto items-center justify-center gap-2.5 rounded-2xl border border-amber-500/30 bg-zinc-900/80 px-6 py-4 text-base font-semibold text-zinc-200 shadow-[0_4px_15px_rgba(0,0,0,0.5)] backdrop-blur-xl transition-all duration-200 hover:border-amber-400 hover:bg-zinc-800 hover:text-white active:scale-95"
          >
            <div class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-500/20 text-amber-400">
              <svg class="h-3.5 w-3.5 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
            <span data-i18n="hero.watchDemo">{t('hero.watchDemo')}</span>
          </a>
        </div>

        <!-- Live Metrics Strip -->
        <div class="mt-10 grid grid-cols-3 gap-3 sm:gap-6 border-t border-amber-500/20 pt-6 w-full animate-fade-in-up stagger-4">
          <div class="flex flex-col">
            <span class="text-2xl sm:text-3xl font-extrabold text-white">98.7%</span>
            <span class="text-xs text-zinc-400" data-i18n="hero.stat.adherence">Adherencia Media</span>
          </div>
          <div class="flex flex-col border-x border-zinc-800 px-2 sm:px-4">
            <span class="text-2xl sm:text-3xl font-extrabold text-amber-400">+5,000</span>
            <span class="text-xs text-zinc-400" data-i18n="hero.stat.workouts">Planes Activos</span>
          </div>
          <div class="flex flex-col">
            <span class="text-2xl sm:text-3xl font-extrabold text-white">4.9 ★</span>
            <span class="text-xs text-zinc-400" data-i18n="hero.stat.rating">Valoración Élite</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Frame with Floating Cards -->
      <div class="relative lg:col-span-5 flex justify-center animate-fade-in-scale">
        
        <!-- Background Glow -->
        <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-amber-600/30 via-yellow-500/20 to-amber-400/20 opacity-70 blur-2xl"></div>

        <!-- Main Card Container -->
        <div class="relative w-full max-w-md overflow-hidden rounded-3xl border border-amber-500/40 bg-zinc-950/80 p-3 shadow-[0_25px_50px_rgba(0,0,0,0.9),0_0_35px_rgba(245,158,11,0.25)] backdrop-blur-2xl transition-transform duration-500 hover:scale-[1.01]">
          
          <!-- Image Frame -->
          <div class="relative aspect-[4/5] sm:aspect-square w-full overflow-hidden rounded-2xl">
            <img
              src="/images/landing/hero_elite_training.jpg"
              alt="CampFit Elite Training"
              class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
              loading="eager"
            />
            
            <!-- Vignette & Gold lighting gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>

            <!-- Floating Pill 1: Coach Status -->
            <div class="absolute top-4 left-4 flex items-center gap-2.5 rounded-full border border-amber-500/40 bg-zinc-950/80 px-3.5 py-1.5 shadow-[0_8px_20px_rgba(0,0,0,0.6)] backdrop-blur-md">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              </span>
              <span class="text-xs font-semibold text-zinc-200" data-i18n="hero.pill.coach">Coach Asignado 1-a-1</span>
            </div>

            <!-- Floating Pill 2: Daily Goal Progress -->
            <div class="absolute bottom-4 left-4 right-4 rounded-2xl border border-amber-500/30 bg-zinc-950/90 p-3.5 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl">
              <div class="flex items-center justify-between text-xs">
                <span class="font-semibold text-amber-300" data-i18n="hero.pill.todayRoutine">Rutina de Hoy • Hipertrofia A</span>
                <span class="font-mono font-bold text-white">85% Completado</span>
              </div>
              <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-zinc-800">
                <div class="h-full w-[85%] rounded-full bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-300 shadow-[0_0_10px_rgba(245,158,11,0.5)]"></div>
              </div>
              <div class="mt-2 flex items-center justify-between text-[11px] text-zinc-400">
                <span>4 de 5 Ejercicios</span>
                <span class="text-amber-400 font-medium">RPE 8.5 • Óptimo</span>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </div>
</section>
