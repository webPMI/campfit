---
interface Props {
  density?: number;
  class?: string;
}

const { density = 45, class: className = '' } = Astro.props;
---

<div class={`pointer-events-none fixed inset-0 z-0 overflow-hidden ${className}`} aria-hidden="true">
  <!-- Glowing ambient radial halos -->
  <div class="absolute -top-32 left-1/4 h-[500px] w-[500px] rounded-full bg-[radial-gradient(circle,rgba(245,158,11,0.12)_0%,transparent_70%)] blur-3xl"></div>
  <div class="absolute top-1/3 -right-32 h-[600px] w-[600px] rounded-full bg-[radial-gradient(circle,rgba(217,119,6,0.08)_0%,transparent_70%)] blur-3xl"></div>
  <div class="absolute bottom-10 left-1/3 h-[500px] w-[500px] rounded-full bg-[radial-gradient(circle,rgba(251,191,36,0.09)_0%,transparent_70%)] blur-3xl"></div>

  <!-- Gold Particles Canvas -->
  <canvas id="goldParticlesCanvas" data-density={density} class="h-full w-full opacity-90"></canvas>
</div>

<script>
  function initGoldParticles() {
    const canvas = document.getElementById('goldParticlesCanvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Check reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    const densityAttr = parseInt(canvas.dataset.density || '45', 10);
    const particleCount = Math.min(Math.floor((width * height) / 22000), densityAttr * 1.5);

    interface Particle {
      x: number;
      y: number;
      size: number;
      speedY: number;
      speedX: number;
      opacity: number;
      targetOpacity: number;
      pulseSpeed: number;
      color: string;
      blur: number;
    }

    const goldColors = [
      '245, 158, 11',   // Amber gold
      '251, 191, 36',   // Bright gold
      '217, 119, 6',    // Deep bronze
      '254, 240, 138',  // Champagne
      '212, 175, 55',   // Metallic gold
    ];

    const particles: Particle[] = [];

    function createParticle(): Particle {
      const color = goldColors[Math.floor(Math.random() * goldColors.length)] ?? '245, 158, 11';
      return {
        x: Math.random() * width,
        y: Math.random() * height,
        size: Math.random() * 2.2 + 0.6,
        speedY: -(Math.random() * 0.45 + 0.15),
        speedX: (Math.random() - 0.5) * 0.3,
        opacity: Math.random() * 0.6 + 0.2,
        targetOpacity: Math.random() * 0.7 + 0.3,
        pulseSpeed: Math.random() * 0.02 + 0.008,
        color,
        blur: Math.random() > 0.7 ? 4 : 0,
      };
    }

    for (let i = 0; i < particleCount; i++) {
      particles.push(createParticle());
    }

    let mouseX = width / 2;
    let mouseY = height / 2;
    let targetMouseX = mouseX;
    let targetMouseY = mouseY;

    window.addEventListener('mousemove', (e) => {
      targetMouseX = e.clientX;
      targetMouseY = e.clientY;
    }, { passive: true });

    let animationFrameId: number;
    let isVisible = true;

    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible) {
        animate();
      } else {
        cancelAnimationFrame(animationFrameId);
      }
    });

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }, { passive: true });

    function animate() {
      if (!isVisible) return;
      if (!ctx) return;

      // Soft mouse lerp
      mouseX += (targetMouseX - mouseX) * 0.05;
      mouseY += (targetMouseY - mouseY) * 0.05;

      ctx.clearRect(0, 0, width, height);

      for (const p of particles) {
        // Move particle
        p.y += p.speedY;
        p.x += p.speedX + Math.sin(p.y * 0.01) * 0.2;

        // Pulse opacity
        p.opacity += p.pulseSpeed;
        if (p.opacity > 0.85 || p.opacity < 0.15) {
          p.pulseSpeed = -p.pulseSpeed;
        }

        // Wrap around boundaries
        if (p.y < -10) {
          p.y = height + 10;
          p.x = Math.random() * width;
        }
        if (p.x < -10) p.x = width + 10;
        if (p.x > width + 10) p.x = -10;

        // Proximity glow to cursor
        const dx = mouseX - p.x;
        const dy = mouseY - p.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        let boost = 0;
        if (dist < 150) {
          boost = (1 - dist / 150) * 0.4;
        }

        // Draw particle
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size + boost * 1.5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${p.color}, ${Math.min(p.opacity + boost, 1)})`;

        if (p.blur > 0 || boost > 0.2) {
          ctx.shadowBlur = 8 + boost * 10;
          ctx.shadowColor = `rgba(${p.color}, 0.8)`;
        } else {
          ctx.shadowBlur = 0;
        }

        ctx.fill();
      }

      animationFrameId = requestAnimationFrame(animate);
    }

    animate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGoldParticles);
  } else {
    initGoldParticles();
  }
</script>
