---
import { translations, type Language } from '@/i18n/translations';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<section class="relative my-20 w-full px-4 sm:px-6">
  <div class="mx-auto max-w-6xl">
    
    <!-- Section Header -->
    <div class="mb-12 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-amber-300 shadow-[0_0_15px_rgba(245,158,11,0.2)]">
        <span>⚡</span>
        <span data-i18n="bento.badge">{t('bento.badge')}</span>
      </div>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
        <span data-i18n="bento.title">{t('bento.title')}</span>{' '}
        <span class="bg-gradient-to-r from-amber-200 via-amber-400 to-yellow-500 bg-clip-text text-transparent">
          Excelencia Absoluta
        </span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-base text-zinc-400 sm:text-lg" data-i18n="bento.subtitle">
        {t('bento.subtitle')}
      </p>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
      
      <!-- Card 1: Entrenamiento de Élite (8 Cols on Desktop) -->
      <div class="group relative overflow-hidden rounded-3xl border border-amber-500/30 bg-gradient-to-br from-zinc-950/90 to-zinc-900/90 p-6 sm:p-8 shadow-[0_15px_35px_rgba(0,0,0,0.7)] backdrop-blur-2xl transition-all duration-300 hover:border-amber-400/60 hover:shadow-[0_20px_45px_rgba(245,158,11,0.2)] md:col-span-7 flex flex-col justify-between">
        
        <!-- Ambient hover glow -->
        <div class="pointer-events-none absolute -right-20 -top-20 h-60 w-60 rounded-full bg-amber-500/15 blur-3xl transition-opacity duration-500 group-hover:opacity-100"></div>

        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-amber-500/40 bg-amber-500/10 text-amber-400 shadow-[0_0_15px_rgba(245,158,11,0.3)]">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
            </svg>
          </div>

          <h3 class="mt-5 text-2xl font-bold text-white" data-i18n="bento.card1.title">
            Entrenamiento de Alta Precisión
          </h3>
          <p class="mt-2 text-sm text-zinc-300 leading-relaxed" data-i18n="bento.card1.desc">
            Rutinas estructuradas con biblioteca técnica, control de sobrecarga progresiva, RPE, descansos cronometrados y registro inmediato por serie.
          </p>
        </div>

        <!-- Interactive Workout Preview Pill Mockup -->
        <div class="mt-6 rounded-2xl border border-white/10 bg-zinc-900/80 p-4 backdrop-blur-xl">
          <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
            <div class="flex items-center gap-2.5">
              <span class="flex h-2.5 w-2.5 rounded-full bg-amber-400"></span>
              <span class="text-xs font-semibold text-zinc-200">Press Militar con Barra</span>
            </div>
            <span class="rounded bg-amber-500/20 px-2 py-0.5 text-[10px] font-bold text-amber-300">4 Series • RIR 1-2</span>
          </div>
          <div class="mt-3 grid grid-cols-4 gap-2 text-center text-xs">
            <div class="rounded-lg bg-zinc-950/60 p-2"><span class="text-zinc-500 block text-[10px]">Serie 1</span><span class="font-bold text-white">70 kg × 8</span></div>
            <div class="rounded-lg bg-zinc-950/60 p-2"><span class="text-zinc-500 block text-[10px]">Serie 2</span><span class="font-bold text-white">72.5 kg × 8</span></div>
            <div class="rounded-lg bg-zinc-950/60 p-2"><span class="text-zinc-500 block text-[10px]">Serie 3</span><span class="font-bold text-white">75 kg × 6</span></div>
            <div class="rounded-lg border border-amber-500/30 bg-amber-500/10 p-2"><span class="text-amber-400 block text-[10px]">Serie 4 (PR)</span><span class="font-bold text-amber-300">77.5 kg × 5</span></div>
          </div>
        </div>

      </div>

      <!-- Card 2: Nutrición Inteligente & Alérgenos (5 Cols on Desktop) -->
      <div class="group relative overflow-hidden rounded-3xl border border-amber-500/30 bg-gradient-to-br from-zinc-950/90 to-zinc-900/90 p-6 sm:p-8 shadow-[0_15px_35px_rgba(0,0,0,0.7)] backdrop-blur-2xl transition-all duration-300 hover:border-amber-400/60 hover:shadow-[0_20px_45px_rgba(245,158,11,0.2)] md:col-span-5 flex flex-col justify-between">
        
        <div class="pointer-events-none absolute -left-20 -bottom-20 h-60 w-60 rounded-full bg-yellow-500/15 blur-3xl transition-opacity duration-500 group-hover:opacity-100"></div>

        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-amber-500/40 bg-amber-500/10 text-amber-400 shadow-[0_0_15px_rgba(245,158,11,0.3)]">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>

          <h3 class="mt-5 text-2xl font-bold text-white" data-i18n="bento.card2.title">
            Nutrición Inteligente
          </h3>
          <p class="mt-2 text-sm text-zinc-300 leading-relaxed" data-i18n="bento.card2.desc">
            Planes dietéticos personalizados con cálculo automático de macros y sistema avanzado de detección de alérgenos e intolerancias.
          </p>
        </div>

        <!-- Visual Thumbnail with Gold Cutlery -->
        <div class="mt-6 relative aspect-[16/10] w-full overflow-hidden rounded-2xl border border-amber-500/20">
          <img
            src="/images/landing/smart_nutrition_gold.jpg"
            alt="CampFit Smart Nutrition"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-center justify-between rounded-xl bg-black/80 px-3 py-1.5 backdrop-blur-md text-xs">
            <span class="text-amber-300 font-semibold">2,450 kcal • 185g Proteína</span>
            <span class="text-emerald-400 font-bold">✓ Sin Gluten</span>
          </div>
        </div>

      </div>

      <!-- Card 3: Biometría & Analítica de Lujo (5 Cols on Desktop) -->
      <div class="group relative overflow-hidden rounded-3xl border border-amber-500/30 bg-gradient-to-br from-zinc-950/90 to-zinc-900/90 p-6 sm:p-8 shadow-[0_15px_35px_rgba(0,0,0,0.7)] backdrop-blur-2xl transition-all duration-300 hover:border-amber-400/60 hover:shadow-[0_20px_45px_rgba(245,158,11,0.2)] md:col-span-5 flex flex-col justify-between">
        
        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-amber-500/40 bg-amber-500/10 text-amber-400 shadow-[0_0_15px_rgba(245,158,11,0.3)]">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
            </svg>
          </div>

          <h3 class="mt-5 text-2xl font-bold text-white" data-i18n="bento.card3.title">
            Analítica Biométrica
          </h3>
          <p class="mt-2 text-sm text-zinc-300 leading-relaxed" data-i18n="bento.card3.desc">
            Seguimiento de composición corporal, pesaje periódico, adherencia semanal y progreso visual documentado.
          </p>
        </div>

        <div class="mt-6 relative aspect-[16/10] w-full overflow-hidden rounded-2xl border border-amber-500/20">
          <img
            src="/images/landing/analytics_biometrics_gold.jpg"
            alt="CampFit Biometrics Dashboard"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
          <div class="absolute bottom-3 left-3 text-xs font-semibold text-amber-300">
            Gráficas de Rendimiento en Tiempo Real
          </div>
        </div>

      </div>

      <!-- Card 4: Coach 1-a-1 & Chat Instantáneo (7 Cols on Desktop) -->
      <div class="group relative overflow-hidden rounded-3xl border border-amber-500/30 bg-gradient-to-br from-zinc-950/90 to-zinc-900/90 p-6 sm:p-8 shadow-[0_15px_35px_rgba(0,0,0,0.7)] backdrop-blur-2xl transition-all duration-300 hover:border-amber-400/60 hover:shadow-[0_20px_45px_rgba(245,158,11,0.2)] md:col-span-7 flex flex-col justify-between">
        
        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-amber-500/40 bg-amber-500/10 text-amber-400 shadow-[0_0_15px_rgba(245,158,11,0.3)]">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a.75.75 0 0 1-.974-.94 4.316 4.316 0 0 0 .548-1.572C3.398 16.924 2.25 14.598 2.25 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
            </svg>
          </div>

          <h3 class="mt-5 text-2xl font-bold text-white" data-i18n="bento.card4.title">
            Conexión Directa con tu Coach
          </h3>
          <p class="mt-2 text-sm text-zinc-300 leading-relaxed" data-i18n="bento.card4.desc">
            Comunicación instantánea, revisión de videos de ejecución, ajustes sobre la marcha y motivación continua sin intermediarios.
          </p>
        </div>

        <!-- Chat Bubble Simulation -->
        <div class="mt-6 space-y-2.5 rounded-2xl border border-white/10 bg-zinc-900/70 p-4 backdrop-blur-xl">
          <div class="flex items-start gap-3">
            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-amber-500 font-bold text-xs text-zinc-950">
              TR
            </div>
            <div class="rounded-2xl rounded-tl-none bg-zinc-800 px-3.5 py-2 text-xs text-zinc-200">
              ¡Excelente técnica en la sentadilla de hoy! He incrementado 2.5kg para el próximo microciclo.
            </div>
          </div>
          <div class="flex items-start justify-end gap-3">
            <div class="rounded-2xl rounded-tr-none bg-gradient-to-r from-amber-500 to-yellow-500 px-3.5 py-2 text-xs font-medium text-zinc-950">
              ¡Recibido! Me sentí con gran estabilidad. Listo para el siguiente bloque.
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
