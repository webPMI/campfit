---
import { translations, type Language } from '@/i18n/translations';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<section class="relative my-24 w-full px-4 sm:px-6">
  <div class="mx-auto max-w-6xl">
    
    <!-- Section Header -->
    <div class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-amber-300 shadow-[0_0_15px_rgba(245,158,11,0.2)]">
        <span>✨</span>
        <span data-i18n="tabs.badge">{t('tabs.badge')}</span>
      </div>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
        <span data-i18n="tabs.title">{t('tabs.title')}</span>{' '}
        <span class="bg-gradient-to-r from-amber-200 via-amber-400 to-yellow-500 bg-clip-text text-transparent">
          Cada Rol
        </span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-base text-zinc-400 sm:text-lg" data-i18n="tabs.subtitle">
        {t('tabs.subtitle')}
      </p>
    </div>

    <!-- Tab Switcher Navigation -->
    <div class="mx-auto flex max-w-lg items-center justify-center rounded-2xl border border-amber-500/30 bg-zinc-950/80 p-1.5 shadow-[0_10px_25px_rgba(0,0,0,0.5)] backdrop-blur-xl">
      <button
        type="button"
        class="role-tab-btn active w-1/3 rounded-xl py-2.5 text-xs sm:text-sm font-bold transition-all duration-200 bg-gradient-to-r from-amber-500 to-yellow-400 text-zinc-950 shadow-[0_0_15px_rgba(245,158,11,0.4)]"
        data-target="tab-athlete"
      >
        <span data-i18n="tabs.role.athlete">{t('tabs.role.athlete')}</span>
      </button>
      <button
        type="button"
        class="role-tab-btn w-1/3 rounded-xl py-2.5 text-xs sm:text-sm font-semibold text-zinc-400 transition-all duration-200 hover:text-white"
        data-target="tab-trainer"
      >
        <span data-i18n="tabs.role.trainer">{t('tabs.role.trainer')}</span>
      </button>
      <button
        type="button"
        class="role-tab-btn w-1/3 rounded-xl py-2.5 text-xs sm:text-sm font-semibold text-zinc-400 transition-all duration-200 hover:text-white"
        data-target="tab-nutrition"
      >
        <span data-i18n="tabs.role.nutrition">{t('tabs.role.nutrition')}</span>
      </button>
    </div>

    <!-- Tab Contents Window -->
    <div class="mt-8 overflow-hidden rounded-3xl border border-amber-500/30 bg-zinc-950/90 p-4 sm:p-8 shadow-[0_25px_60px_rgba(0,0,0,0.9),0_0_40px_rgba(245,158,11,0.15)] backdrop-blur-2xl">
      
      <!-- Tab 1: Athlete View -->
      <div id="tab-athlete" class="tab-panel grid grid-cols-1 gap-8 lg:grid-cols-12 items-center">
        <div class="lg:col-span-6 space-y-4">
          <div class="inline-flex items-center gap-2 rounded-lg bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-300">
            <span>🏋️</span> Interfaz Móvil & Web del Atleta
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white">
            Tu centro de mando diario, simple y enfocado.
          </h3>
          <p class="text-zinc-300 text-sm leading-relaxed">
            Visualiza tu rutina del día, temporiza descansos entre series, registra pesos y RPE al instante, y mantén tu racha de adherencia activa con recordatorios motivacionales.
          </p>
          <ul class="space-y-2.5 pt-2 text-sm text-zinc-300">
            <li class="flex items-center gap-3">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-500/20 text-amber-400 text-xs">✓</div>
              <span>Modo entreno interactivo con timer de descanso automático</span>
            </li>
            <li class="flex items-center gap-3">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-500/20 text-amber-400 text-xs">✓</div>
              <span>Control fotográfico y registro biométrico semanal</span>
            </li>
            <li class="flex items-center gap-3">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-500/20 text-amber-400 text-xs">✓</div>
              <span>Plan nutricional dinámico con verificación de intolerancias</span>
            </li>
          </ul>
        </div>
        <div class="lg:col-span-6 rounded-2xl border border-zinc-800 bg-zinc-900/90 p-5 shadow-2xl">
          <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
            <div>
              <div class="text-xs text-zinc-400">Hoy • Jueves</div>
              <div class="text-base font-bold text-white">Fuerza & Hipertrofia: Torso A</div>
            </div>
            <span class="rounded-full bg-emerald-500/20 px-3 py-1 text-xs font-semibold text-emerald-400">En Curso</span>
          </div>
          <div class="mt-4 space-y-3">
            <div class="flex items-center justify-between rounded-xl bg-zinc-950 p-3">
              <div class="flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500/20 text-amber-400 font-bold text-xs">1</div>
                <div>
                  <div class="text-sm font-semibold text-white">Press Banca Plano</div>
                  <div class="text-xs text-zinc-400">4 series • 6-8 reps • RPE 8</div>
                </div>
              </div>
              <span class="text-xs font-mono font-bold text-amber-400">85 kg</span>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-zinc-950 p-3">
              <div class="flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500/20 text-amber-400 font-bold text-xs">2</div>
                <div>
                  <div class="text-sm font-semibold text-white">Remo con Barra Pendlay</div>
                  <div class="text-xs text-zinc-400">4 series • 8 reps • RPE 8</div>
                </div>
              </div>
              <span class="text-xs font-mono font-bold text-amber-400">75 kg</span>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-zinc-950 p-3">
              <div class="flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500/20 text-amber-400 font-bold text-xs">3</div>
                <div>
                  <div class="text-sm font-semibold text-white">Elevaciones Laterales</div>
                  <div class="text-xs text-zinc-400">3 series • 12-15 reps • RPE 9</div>
                </div>
              </div>
              <span class="text-xs font-mono font-bold text-amber-400">14 kg</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 2: Trainer View (Hidden by default) -->
      <div id="tab-trainer" class="tab-panel hidden grid grid-cols-1 gap-8 lg:grid-cols-12 items-center">
        <div class="lg:col-span-6 space-y-4">
          <div class="inline-flex items-center gap-2 rounded-lg bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-300">
            <span>📋</span> Panel de Alto Rendimiento para Entrenadores
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white">
            Gestiona decenas de atletas con precisión quirúrgica.
          </h3>
          <p class="text-zinc-300 text-sm leading-relaxed">
            Crea plantillas modulares de entrenamiento y nutrición, supervisa la adherencia de tu lista de clientes en tiempo real y recibe alertas de estancamiento o riesgo de lesión.
          </p>
          <ul class="space-y-2.5 pt-2 text-sm text-zinc-300">
            <li class="flex items-center gap-3">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-500/20 text-amber-400 text-xs">✓</div>
              <span>Sistema de plantillas reusables con asignación 1-click</span>
            </li>
            <li class="flex items-center gap-3">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-500/20 text-amber-400 text-xs">✓</div>
              <span>Monitoreo de fatiga, volumen acumulado y RPE</span>
            </li>
            <li class="flex items-center gap-3">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-500/20 text-amber-400 text-xs">✓</div>
              <span>Módulo de mensajería directa integrada con historial</span>
            </li>
          </ul>
        </div>
        <div class="lg:col-span-6 rounded-2xl border border-zinc-800 bg-zinc-900/90 p-5 shadow-2xl">
          <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
            <span class="text-sm font-bold text-white">Atletas Asignados Activos</span>
            <span class="rounded bg-amber-500/20 px-2 py-0.5 text-xs font-bold text-amber-300">24 Atletas</span>
          </div>
          <div class="mt-4 space-y-3">
            <div class="flex items-center justify-between rounded-xl bg-zinc-950 p-3">
              <div class="flex items-center gap-3">
                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-500 font-bold text-xs text-zinc-950">MC</div>
                <div>
                  <div class="text-sm font-semibold text-white">Marcos Castro</div>
                  <div class="text-xs text-emerald-400 font-medium">100% Adherencia esta semana</div>
                </div>
              </div>
              <span class="rounded-lg border border-amber-500/40 bg-amber-500/10 px-2.5 py-1 text-xs text-amber-300">Revisado</span>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-zinc-950 p-3">
              <div class="flex items-center gap-3">
                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-zinc-700 font-bold text-xs text-white">ER</div>
                <div>
                  <div class="text-sm font-semibold text-white">Elena Ramos</div>
                  <div class="text-xs text-amber-400 font-medium">Nueva marca personal en Sentadilla</div>
                </div>
              </div>
              <span class="rounded-lg border border-zinc-700 bg-zinc-800 px-2.5 py-1 text-xs text-zinc-300">Feedback</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 3: Nutrition Engine (Hidden by default) -->
      <div id="tab-nutrition" class="tab-panel hidden grid grid-cols-1 gap-8 lg:grid-cols-12 items-center">
        <div class="lg:col-span-6 space-y-4">
          <div class="inline-flex items-center gap-2 rounded-lg bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-300">
            <span>🥗</span> Motor Nutricional Inteligente
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white">
            Nutrición calculada al gramo con protección total.
          </h3>
          <p class="text-zinc-300 text-sm leading-relaxed">
            Configura dietas por tomas (desayuno, almuerzo, merienda, cena), ajusta macronutrientes al instante y activa el escudo de alérgenos que bloquea automáticamente ingredientes incompatibles.
          </p>
          <ul class="space-y-2.5 pt-2 text-sm text-zinc-300">
            <li class="flex items-center gap-3">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-500/20 text-amber-400 text-xs">✓</div>
              <span>Base de datos curada de alimentos y equivalencias</span>
            </li>
            <li class="flex items-center gap-3">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-500/20 text-amber-400 text-xs">✓</div>
              <span>Detector inteligente de alérgenos e intolerancias</span>
            </li>
            <li class="flex items-center gap-3">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-500/20 text-amber-400 text-xs">✓</div>
              <span>Generación de PDF y vista interactiva para el cliente</span>
            </li>
          </ul>
        </div>
        <div class="lg:col-span-6 rounded-2xl border border-zinc-800 bg-zinc-900/90 p-5 shadow-2xl">
          <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
            <span class="text-sm font-bold text-white">Distribución de Macronutrientes</span>
            <span class="text-xs font-mono font-bold text-amber-400">2,600 kcal Objetivo</span>
          </div>
          <div class="mt-4 grid grid-cols-3 gap-3 text-center">
            <div class="rounded-xl bg-zinc-950 p-3">
              <span class="text-[11px] text-zinc-400 block">Proteínas</span>
              <span class="text-lg font-bold text-amber-400">195 g</span>
              <span class="text-[10px] text-zinc-500 block">30% total</span>
            </div>
            <div class="rounded-xl bg-zinc-950 p-3">
              <span class="text-[11px] text-zinc-400 block">Carbohidratos</span>
              <span class="text-lg font-bold text-yellow-300">290 g</span>
              <span class="text-[10px] text-zinc-500 block">45% total</span>
            </div>
            <div class="rounded-xl bg-zinc-950 p-3">
              <span class="text-[11px] text-zinc-400 block">Grasas</span>
              <span class="text-lg font-bold text-amber-200">72 g</span>
              <span class="text-[10px] text-zinc-500 block">25% total</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function initInteractiveTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.role-tab-btn');
    const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        
        tabButtons.forEach((b) => {
          b.classList.remove('active', 'bg-gradient-to-r', 'from-amber-500', 'to-yellow-400', 'text-zinc-950', 'shadow-[0_0_15px_rgba(245,158,11,0.4)]');
          b.classList.add('text-zinc-400');
        });

        btn.classList.add('active', 'bg-gradient-to-r', 'from-amber-500', 'to-yellow-400', 'text-zinc-950', 'shadow-[0_0_15px_rgba(245,158,11,0.4)]');
        btn.classList.remove('text-zinc-400');

        tabPanels.forEach((panel) => {
          if (panel.id === targetId) {
            panel.classList.remove('hidden');
            panel.classList.add('animate-fade-in');
          } else {
            panel.classList.add('hidden');
            panel.classList.remove('animate-fade-in');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInteractiveTabs);
  } else {
    initInteractiveTabs();
  }
</script>
