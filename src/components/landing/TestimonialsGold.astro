---
import { translations, type Language } from '@/i18n/translations';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---

<section class="relative my-24 w-full px-4 sm:px-6">
  <div class="mx-auto max-w-6xl">
    
    <!-- Section Header -->
    <div class="mb-14 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-amber-300 shadow-[0_0_15px_rgba(245,158,11,0.2)]">
        <span>⭐</span>
        <span data-i18n="testimonials.badge">{t('testimonials.badge')}</span>
      </div>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
        <span data-i18n="testimonials.title">{t('testimonials.title')}</span>{' '}
        <span class="bg-gradient-to-r from-amber-200 via-amber-400 to-yellow-500 bg-clip-text text-transparent">
          Mejores Atletas
        </span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-base text-zinc-400 sm:text-lg" data-i18n="testimonials.subtitle">
        {t('testimonials.subtitle')}
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      
      <!-- Testimonial 1 -->
      <div class="group relative flex flex-col justify-between rounded-3xl border border-amber-500/30 bg-zinc-950/80 p-6 sm:p-8 shadow-[0_15px_35px_rgba(0,0,0,0.7)] backdrop-blur-2xl transition-all duration-300 hover:border-amber-400/60 hover:shadow-[0_20px_45px_rgba(245,158,11,0.2)] hover:-translate-y-1">
        <div>
          <!-- Stars -->
          <div class="flex items-center gap-1 text-amber-400 text-sm">
            ★★★★★
          </div>
          <p class="mt-4 text-sm text-zinc-300 leading-relaxed italic">
            "La claridad para registrar mis series y la sincronización en directo con mi entrenador cambiaron por completo mi enfoque. Pasé de entrenar sin rumbo a conseguir mi mejor condición física en 6 meses."
          </p>
        </div>

        <div class="mt-6 flex items-center justify-between border-t border-zinc-800/80 pt-4">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-tr from-amber-600 to-yellow-400 font-bold text-xs text-zinc-950 shadow-md">
              DR
            </div>
            <div>
              <div class="text-sm font-bold text-white">David Ruiz</div>
              <div class="text-xs text-zinc-400">Atleta de Fuerza • 28 años</div>
            </div>
          </div>
          <span class="rounded-lg bg-amber-500/15 px-2.5 py-1 text-[11px] font-bold text-amber-300 border border-amber-500/30">
            -8kg Grasa
          </span>
        </div>
      </div>

      <!-- Testimonial 2 (Featured VIP) -->
      <div class="group relative flex flex-col justify-between rounded-3xl border border-amber-400/50 bg-gradient-to-b from-zinc-900/90 to-zinc-950/90 p-6 sm:p-8 shadow-[0_20px_45px_rgba(245,158,11,0.25)] backdrop-blur-2xl transition-all duration-300 hover:border-amber-300 hover:shadow-[0_25px_55px_rgba(245,158,11,0.35)] hover:-translate-y-1">
        <div class="absolute -top-3 right-6 rounded-full bg-gradient-to-r from-amber-500 to-yellow-400 px-3 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-zinc-950 shadow-lg">
          Coach Pro
        </div>
        <div>
          <div class="flex items-center gap-1 text-amber-400 text-sm">
            ★★★★★
          </div>
          <p class="mt-4 text-sm text-zinc-200 leading-relaxed italic font-medium">
            "Como preparador físico, CampFit me permite gestionar más de 35 atletas con una atención hiper-personalizada. El editor de dietas con filtro de intolerancias nos ahorra horas cada semana."
          </p>
        </div>

        <div class="mt-6 flex items-center justify-between border-t border-amber-500/20 pt-4">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-tr from-amber-500 to-yellow-300 font-bold text-xs text-zinc-950 shadow-md">
              SM
            </div>
            <div>
              <div class="text-sm font-bold text-white">Sergio Morales</div>
              <div class="text-xs text-amber-400 font-medium">Entrenador NSCA-CPT</div>
            </div>
          </div>
          <span class="rounded-lg bg-amber-500/20 px-2.5 py-1 text-[11px] font-bold text-amber-300 border border-amber-500/40">
            35+ Atletas
          </span>
        </div>
      </div>

      <!-- Testimonial 3 -->
      <div class="group relative flex flex-col justify-between rounded-3xl border border-amber-500/30 bg-zinc-950/80 p-6 sm:p-8 shadow-[0_15px_35px_rgba(0,0,0,0.7)] backdrop-blur-2xl transition-all duration-300 hover:border-amber-400/60 hover:shadow-[0_20px_45px_rgba(245,158,11,0.2)] hover:-translate-y-1">
        <div>
          <div class="flex items-center gap-1 text-amber-400 text-sm">
            ★★★★★
          </div>
          <p class="mt-4 text-sm text-zinc-300 leading-relaxed italic">
            "Tengo intolerancia al gluten y lactosa, y siempre sufría con las dietas estándar. Con el sistema de alérgenos de CampFit mi coach me diseña menús deliciosos y 100% seguros sin complicaciones."
          </p>
        </div>

        <div class="mt-6 flex items-center justify-between border-t border-zinc-800/80 pt-4">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-tr from-amber-600 to-yellow-400 font-bold text-xs text-zinc-950 shadow-md">
              CP
            </div>
            <div>
              <div class="text-sm font-bold text-white">Clara Pons</div>
              <div class="text-xs text-zinc-400">CrossFit & Nutrición</div>
            </div>
          </div>
          <span class="rounded-lg bg-amber-500/15 px-2.5 py-1 text-[11px] font-bold text-amber-300 border border-amber-500/30">
            +6kg Músculo
          </span>
        </div>
      </div>

    </div>

  </div>
</section>
