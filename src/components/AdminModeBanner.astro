---
/**
 * AdminModeBanner - Shows a banner when admin is previewing as another role.
 */
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<div id="admin-mode-banner" class="hidden">
  <a
    href="/admin/dashboard"
    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30 text-[11px] font-bold hover:bg-amber-500 hover:text-black transition-all shadow-sm"
    title={t("admin.interactAsClient")}
  >
    <span>🛡️</span>
    <span data-i18n="admin.mode.preview">{t("admin.mode.preview")}</span>
    <span class="opacity-75 font-normal hidden sm:inline">| <span data-i18n="admin.mode.return">{t("admin.mode.return")}</span> →</span>
  </a>
</div>

<script>
  import { authService } from "@/services/authService";

  authService.onAuthChange(async (firebaseUser) => {
    const banner = document.getElementById("admin-mode-banner");
    if (!banner) return;
    if (!firebaseUser) {
      banner.classList.add("hidden");
      return;
    }
    try {
      const { db } = await import("@/lib/firebase");
      const { doc, getDoc } = await import("firebase/firestore");
      const snap = await getDoc(doc(db, "users", firebaseUser.uid));
      const role = snap.exists() ? snap.data().role : null;
      const isClientPath = window.location.pathname.startsWith("/client");
      if (role === "admin" && isClientPath) {
        banner.classList.remove("hidden");
      } else if (role === "admin" && window.location.pathname.startsWith("/trainer")) {
        banner.classList.remove("hidden");
      } else {
        banner.classList.add("hidden");
      }
    } catch {
      banner.classList.add("hidden");
    }
  });
</script>
