---
/**
 * AdminModeBanner - Shows a banner when admin is previewing as another role.
 */
import { translations, type Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
---

<div
  id="admin-mode-banner"
  class="hidden fixed top-0 left-0 right-0 z-50 bg-[var(--warning-dim)] border-b border-[var(--warning)] px-4 py-2 text-center text-xs text-[var(--warning)] backdrop-blur-xl"
>
  <span>{t("admin.interactAsClient")} · </span>
  <a href="/admin/dashboard" class="font-bold underline hover:text-[var(--warning)] transition-colors">{t("public.nav.dashboard")}</a>
</div>

<script>
  import { authService } from "@/services/authService";

  authService.onAuthChange(async (firebaseUser) => {
    const banner = document.getElementById("admin-mode-banner");
    if (!banner) return;
    if (!firebaseUser) { banner.classList.add("hidden"); return; }
    try {
      const { db } = await import("@/lib/firebase");
      const { doc, getDoc } = await import("firebase/firestore");
      const snap = await getDoc(doc(db, "users", firebaseUser.uid));
      const role = snap.exists() ? snap.data().role : null;
      const isClientPath = window.location.pathname.startsWith("/client");
      if (role === "admin" && isClientPath) {
        banner.classList.remove("hidden");
      } else if (role === "admin" && window.location.pathname.startsWith("/trainer")) {
        banner.classList.remove("hidden");
      } else {
        banner.classList.add("hidden");
      }
    } catch { banner.classList.add("hidden"); }
  });
</script>