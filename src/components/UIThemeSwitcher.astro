---
/**
 * Theme Switcher - Toggle between dark / light mode.
 * Stores preference in localStorage and applies immediately.
 * Futuristic Material-style toggle button.
 */
---

<button
  id="theme-switcher"
  type="button"
  class="relative h-9 w-9 rounded-xl flex items-center justify-center
         text-[var(--text-secondary)] hover:text-[var(--text-primary)]
         hover:bg-[var(--surface-3)] active:scale-90
         transition-all duration-200 ease-out
         focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
  aria-label="Toggle theme"
  title="Toggle theme"
>
  <!-- Sun icon (visible in dark mode) -->
  <svg id="theme-icon-sun" class="h-5 w-5 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>

  <!-- Moon icon (visible in light mode) -->
  <svg id="theme-icon-moon" class="h-5 w-5 absolute opacity-0 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  const KEY = 'campfit_theme';

  function getTheme(): string {
    return localStorage.getItem(KEY) || 'dark';
  }

  function setTheme(theme: string): void {
    localStorage.setItem(KEY, theme);
    document.documentElement.setAttribute('data-theme', theme);
    document.documentElement.style.colorScheme = theme;
    updateIcons(theme);
  }

  function toggleTheme(): void {
    const current = getTheme();
    setTheme(current === 'dark' ? 'light' : 'dark');
  }

  function updateIcons(theme: string): void {
    const sun = document.getElementById('theme-icon-sun');
    const moon = document.getElementById('theme-icon-moon');
    if (!sun || !moon) return;

    if (theme === 'dark') {
      sun.style.opacity = '1';
      moon.style.opacity = '0';
    } else {
      sun.style.opacity = '0';
      moon.style.opacity = '1';
    }
  }

  // Init on load
  const btn = document.getElementById('theme-switcher');
  if (btn) {
    updateIcons(getTheme());
    btn.addEventListener('click', toggleTheme);
  }

  // Listen for system preference changes
  if (window.matchMedia) {
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if (!localStorage.getItem(KEY)) {
        setTheme(e.matches ? 'dark' : 'light');
      }
    });
  }
</script>
</write_to_file>