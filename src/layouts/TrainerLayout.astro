---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DecorativeBackground from '@/components/DecorativeBackground.astro';
import LanguageSwitcherDropdown from '@/components/LanguageSwitcherDropdown.astro';
import AdminModeBanner from '@/components/AdminModeBanner.astro';
import ChatNotificationListener from '@/components/ChatNotificationListener.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
const currentPath = Astro.url.pathname;
---

  <BaseLayout>
    <DecorativeBackground />
    <ChatNotificationListener />
    
    <!-- Top Header Bar -->
    <header class="fixed top-0 left-0 right-0 z-40 border-b border-[var(--border-subtle)] bg-[var(--surface-1)]/80 backdrop-blur-xl h-14 flex items-center justify-between px-4">
      <a href="/trainer/dashboard" class="flex items-center gap-2 font-bold text-sm text-[var(--text-primary)]">
        <div class="flex h-6 w-6 items-center justify-center rounded-lg bg-gradient-to-br from-[var(--brand-hover)] to-[var(--brand)]">
          <svg class="h-3 w-3 text-[var(--text-on-brand)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
        </div>
        CampFit
      </a>
      <div class="flex items-center gap-2">
        <AdminModeBanner />
        <LanguageSwitcherDropdown currentPath={currentPath} lang={lang} />
      </div>
    </header>

    <!-- Page content with top offset padding -->
    <div class="pt-14 pb-20">
      <slot />
    </div>

    <!-- Bottom Navigation Trainer -->
  <nav class="fixed bottom-0 left-0 right-0 z-40 border-t border-[var(--border-default)] glass backdrop-blur-xl">
    <div class="mx-auto flex max-w-lg items-center justify-around px-2 py-2">
      <a
        href="/trainer/dashboard"
        class={`flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-xl transition-all ${
          currentPath === '/trainer/dashboard' || currentPath === '/trainer/dashboard/'
            ? 'text-[var(--brand)]'
            : 'text-[var(--text-tertiary)] hover:text-[var(--text-secondary)]'
        }`}
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        <span data-i18n="trainer.dashboard" class="text-[10px] font-medium">{t('trainer.dashboard')}</span>
      </a>

      <a
        href="/trainer/clients"
        class={`flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-xl transition-all ${
          currentPath.startsWith('/trainer/clients')
            ? 'text-[var(--brand)]'
            : 'text-[var(--text-tertiary)] hover:text-[var(--text-secondary)]'
        }`}
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
        </svg>
        <span data-i18n="trainer.clients" class="text-[10px] font-medium">{t('trainer.clients')}</span>
      </a>

      <a
        href="/trainer/workouts"
        class={`flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-xl transition-all ${
          currentPath.startsWith('/trainer/workouts')
            ? 'text-[var(--brand)]'
            : 'text-[var(--text-tertiary)] hover:text-[var(--text-secondary)]'
        }`}
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
        </svg>
        <span data-i18n="trainer.workouts" class="text-[10px] font-medium">{t('trainer.workouts')}</span>
      </a>

      <a
        href="/trainer/diets"
        class={`flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-xl transition-all ${
          currentPath.startsWith('/trainer/diets')
            ? 'text-[var(--brand)]'
            : 'text-[var(--text-tertiary)] hover:text-[var(--text-secondary)]'
        }`}
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.871c1.355 0 2.697.056 4.024.166C17.155 8.51 18 9.473 18 10.608v2.513M15 8.25v-1.5m-6 1.5v-1.5m12 9.75-1.5.75a3.354 3.354 0 0 1-3 0 3.354 3.354 0 0 0-3 0 3.354 3.354 0 0 1-3 0 3.354 3.354 0 0 0-3 0 3.354 3.354 0 0 1-3 0L3 16.5m15-3.38a48.474 48.474 0 0 0-6-.37c-2.032 0-4.034.125-6 .37m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.169c0 .621-.504 1.125-1.125 1.125H4.125A1.125 1.125 0 0 1 3 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 0 1 6 13.12M12.265 3.11a.375.375 0 1 1-.53 0L12 2.845l.265.265Zm-3 0a.375.375 0 1 1-.53 0L9 2.845l.265.265Zm6 0a.375.375 0 1 1-.53 0L15 2.845l.265.265Z" />
        </svg>
        <span data-i18n="trainer.diets" class="text-[10px] font-medium">{t('trainer.diets')}</span>
      </a>

      <a
        href="/trainer/chat"
        class={`flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-xl transition-all relative ${
          currentPath.startsWith('/trainer/chat')
            ? 'text-[var(--brand)]'
            : 'text-[var(--text-tertiary)] hover:text-[var(--text-secondary)]'
        }`}
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a.598.598 0 0 1-.762-.762c.162-.486.294-1.001.378-1.527A8.204 8.204 0 0 1 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
        </svg>
        <span data-i18n="trainer.chat" class="text-[10px] font-medium">{t('trainer.chat')}</span>
      </a>
    </div>
  </nav>
  </BaseLayout>
