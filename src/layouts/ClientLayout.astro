---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DecorativeBackground from '@/components/DecorativeBackground.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import Icon from '@/components/Icon.astro';
import { translations, type Language } from '@/i18n/translations';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
const currentPath = Astro.url.pathname;
---

  <BaseLayout>
    <DecorativeBackground />
    <LanguageSwitcher currentPath={currentPath} altLang={lang === 'es' ? 'en' : 'es'} />
    <ThemeToggle />

    <!-- Admin Client Preview Switcher Bar -->
    <div id="admin-preview-banner" class="hidden fixed top-3 left-3 z-50">
      <a
        href={`/admin/dashboard?lang=${lang}`}
        class="inline-flex items-center gap-2 rounded-xl border border-purple-500/30 bg-purple-950/80 px-3 py-1.5 text-xs font-medium text-purple-300 backdrop-blur-md shadow-lg transition-all hover:bg-purple-900/80 active:scale-95"
      >
        <span class="flex h-2 w-2 rounded-full bg-purple-400 animate-pulse"></span>
        <span>👑 Modo Vista Admin</span>
        <span class="text-zinc-400">|</span>
        <span class="text-purple-200 underline">Volver al Admin</span>
      </a>
    </div>

    <!-- Page content -->
    <slot />

<script>
  import { auth, db } from '@/lib/firebase';
  import { onAuthStateChanged } from 'firebase/auth';
  import { doc, getDoc, onSnapshot, query, where, collection } from 'firebase/firestore';
  import { showToast } from '@/lib/shared/ui';
  import { logger } from '@/lib/shared/logger';

  let unsubMessages: (() => void) | null = null;
  let unsubLayoutAuth: (() => void) | null = null;

  unsubLayoutAuth = onAuthStateChanged(auth, async (user) => {
    if (!user) return;
    try {
      const email = (user.email || '').toLowerCase();
      const isBootstrapAdmin = email === 'servicioweb.pmi@gmail.com' || email === 'sevicioweb.pmi@gmail.com';

      const userDocSnap = await getDoc(doc(db, 'users', user.uid));
      const role = userDocSnap.data()?.role;

      if (role === 'admin' || isBootstrapAdmin) {
        document.getElementById('admin-preview-banner')?.classList.remove('hidden');
      }

      // Limpiar suscripción anterior si existe
      if (unsubMessages) {
        unsubMessages();
        unsubMessages = null;
      }

      // Suscribirse a mensajes no leídos en tiempo real
      const messagesRef = collection(db, 'messages');
      const q = query(
        messagesRef,
        where('receiverId', '==', user.uid),
        where('isRead', '==', false)
      );

      unsubMessages = onSnapshot(q, (snapshot) => {
        const unreadCount = snapshot.size;
        const badge = document.getElementById('chat-badge');

        if (unreadCount > 0) {
          badge?.classList.remove('hidden');
          if (badge) {
            badge.textContent = unreadCount > 99 ? '99+' : unreadCount.toString();
          }

          const isOnChatPage = window.location.pathname.includes('/client/chat');
          if (!isOnChatPage && snapshot.docChanges().some(change => change.type === 'added') && snapshot.docs.length > 0) {
            const latestMsg = snapshot.docs[0]?.data();
            if (latestMsg) {
              showToast({
                message: `Nuevo mensaje de ${latestMsg.senderId === user.uid ? 'ti' : 'tu entrenador'}`,
                type: 'info',
                duration: 3000,
                position: 'bottom'
              });
            }
          }
        } else {
          badge?.classList.add('hidden');
        }
      });
    } catch (e) {
      logger.error('ClientLayout', 'Error en layout:', e);
    }
  });

  // Cleanup con astro:before-swap (compatible con Astro 7)
  document.addEventListener('astro:before-swap', () => {
    if (unsubLayoutAuth) {
      unsubLayoutAuth();
      unsubLayoutAuth = null;
    }
    if (unsubMessages) {
      unsubMessages();
      unsubMessages = null;
    }
  });

  // Fallback cleanup para navegación tradicional
  window.addEventListener('beforeunload', () => {
    unsubMessages?.();
    unsubLayoutAuth?.();
  });
</script>

    <!-- Bottom Navigation -->
  <nav class="fixed bottom-0 left-0 right-0 z-40 border-t border-zinc-800/60 bg-zinc-900/90 backdrop-blur-xl">
    <div class="mx-auto flex max-w-lg items-center justify-around px-2 py-2">
      <a
        href={`/client/dashboard?lang=${lang}`}
        class={`flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-xl transition-all ${
          currentPath === '/client/dashboard' || currentPath === '/client/dashboard/'
            ? 'text-emerald-400'
            : 'text-zinc-500 hover:text-zinc-300'
        }`}
      >
        <Icon name="home" class="h-5 w-5" />
        <span class="text-[10px] font-medium">{t('client.nav.home')}</span>
      </a>

      <a
        href={`/client/workouts?lang=${lang}`}
        class={`flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-xl transition-all ${
          currentPath.startsWith('/client/workouts')
            ? 'text-emerald-400'
            : 'text-zinc-500 hover:text-zinc-300'
        }`}
      >
        <Icon name="workouts" class="h-5 w-5" />
        <span class="text-[10px] font-medium">{t('client.nav.workouts')}</span>
      </a>

      <a
        href={`/client/diets?lang=${lang}`}
        class={`flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-xl transition-all ${
          currentPath.startsWith('/client/diets')
            ? 'text-emerald-400'
            : 'text-zinc-500 hover:text-zinc-300'
        }`}
      >
        <Icon name="diets" class="h-5 w-5" />
        <span class="text-[10px] font-medium">{t('client.nav.diets')}</span>
      </a>

      <a
        href={`/client/progress?lang=${lang}`}
        class={`flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-xl transition-all ${
          currentPath.startsWith('/client/progress')
            ? 'text-emerald-400'
            : 'text-zinc-500 hover:text-zinc-300'
        }`}
      >
        <Icon name="progress" class="h-5 w-5" />
        <span class="text-[10px] font-medium">{t('client.nav.progress')}</span>
      </a>

      <a
        href={`/client/chat?lang=${lang}`}
        class={`flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-xl transition-all relative ${
          currentPath.startsWith('/client/chat')
            ? 'text-emerald-400'
            : 'text-zinc-500 hover:text-zinc-300'
        }`}
      >
        <div class="relative">
          <Icon name="chat" class="h-5 w-5" />
          <span id="chat-badge" class="hidden absolute -top-1.5 -right-2 flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500 text-[9px] font-bold text-white shadow-lg">0</span>
        </div>
        <span class="text-[10px] font-medium">{t('client.nav.chat')}</span>
      </a>

      <a
        href={`/client/settings?lang=${lang}`}
        class={`flex flex-col items-center gap-0.5 px-3 py-1.5 rounded-xl transition-all ${
          currentPath.startsWith('/client/settings')
            ? 'text-emerald-400'
            : 'text-zinc-500 hover:text-zinc-300'
        }`}
      >
        <Icon name="settings" class="h-5 w-5" />
        <span class="text-[10px] font-medium">Config</span>
      </a>
    </div>
  </nav>
</BaseLayout>