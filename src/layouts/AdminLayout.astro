  <script>
    import { authService } from "@/services/authService";
    import { auth } from "@/lib/firebase";
    import { onAuthStateChanged } from "firebase/auth";

    // Update email in sidebar
    onAuthStateChanged(auth, (user) => {
      const emailEl = document.getElementById('admin-user-email');
      if (emailEl && user?.email) {
        emailEl.textContent = user.email;
      }
    });

    // Mobile drawer toggle
    const btnMore = document.getElementById('btn-mobile-more-menu');
    const drawer = document.getElementById('mobile-more-drawer');
    const btnCloseDrawer = document.getElementById('btn-close-more-drawer');

    btnMore?.addEventListener('click', () => drawer?.classList.remove('hidden'));
    btnCloseDrawer?.addEventListener('click', () => drawer?.classList.add('hidden'));
    drawer?.addEventListener('click', (e) => {
      if (e.target === drawer) drawer.classList.add('hidden');
    });

    // Logout handlers
    const logoutTop = document.getElementById('admin-logout-top-btn');
    const logoutMobile = document.getElementById('admin-mobile-logout-btn');

    const handleLogout = async () => {
      await authService.logoutUser();
      window.location.href = '/login';
    };

    logoutTop?.addEventListener('click', handleLogout);
    logoutMobile?.addEventListener('click', handleLogout);
  </script>
</BaseLayout>