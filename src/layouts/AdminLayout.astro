<script>
  import { auth, db } from '@/lib/firebase';
  import { onAuthStateChanged } from 'firebase/auth';
  import { onSnapshot, query, where, collection } from 'firebase/firestore';
  import { showToast } from '@/lib/shared/ui';
  import { logger } from '@/lib/shared/logger';

  let unsubMessages: (() => void) | null = null;
  let unsubAuth: (() => void) | null = null;

  unsubAuth = onAuthStateChanged(auth, async (user) => {
    if (!user) return;

    try {
      // Limpiar suscripción anterior si existe
      if (unsubMessages) {
        unsubMessages();
        unsubMessages = null;
      }

      // Suscribirse a mensajes no leídos en tiempo real
      const messagesRef = collection(db, 'messages');
      const q = query(
        messagesRef,
        where('receiverId', '==', user.uid),
        where('isRead', '==', false)
      );

      unsubMessages = onSnapshot(q, (snapshot) => {
        const unreadCount = snapshot.size;
        const badge = document.getElementById('admin-chat-badge');

        if (unreadCount > 0) {
          badge?.classList.remove('hidden');
          if (badge) {
            badge.textContent = unreadCount > 99 ? '99+' : unreadCount.toString();
          }

          const isOnChatPage = window.location.pathname.includes('/admin/chat');
          if (!isOnChatPage && snapshot.docChanges().some(change => change.type === 'added') && snapshot.docs.length > 0) {
            const latestMsg = snapshot.docs[0]?.data();
            if (latestMsg && latestMsg.senderId) {
              showToast({
                message: `Nuevo mensaje de ${latestMsg.senderId === user.uid ? 'ti' : 'usuario'}`,
                type: 'info',
                duration: 3000,
                position: 'bottom'
              });
            }
          }
        } else {
          badge?.classList.add('hidden');
        }
      });
    } catch (e) {
      logger.error('AdminLayout', 'Error setting up notifications:', e);
    }
  });

  // Cleanup SPA navigation
  document.addEventListener('astro:before-swap', () => {
    unsubAuth?.();
    unsubMessages?.();
  });

  // Fallback cleanup for traditional navigation
  window.addEventListener('beforeunload', () => {
    unsubMessages?.();
    unsubAuth?.();
  });
</script>
