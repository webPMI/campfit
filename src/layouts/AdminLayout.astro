---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DecorativeBackground from "@/components/DecorativeBackground.astro";
import LanguageSwitcherDropdown from "@/components/LanguageSwitcherDropdown.astro";
import ChatNotificationListener from "@/components/ChatNotificationListener.astro";
import VersionBadge from "@/components/VersionBadge.astro";
import { translations } from "@/i18n/translations";
import type { Language } from "@/i18n/translations";

const lang = (Astro.url.searchParams.get("lang") as Language) || "es";
const t = (key: string) => translations[lang]?.[key] || translations["es"]?.[key] || key;
const currentPath = Astro.url.pathname;

// Determinación de dominios activos para indicadores fuertes
const isGestionActive = currentPath.startsWith("/admin/users") || currentPath.startsWith("/admin/trainers") || currentPath.startsWith("/admin/workouts") || currentPath.startsWith("/admin/diets") || currentPath.startsWith("/admin/clinical");
const isCatalogosActive = currentPath.startsWith("/admin/exercises") || currentPath.startsWith("/admin/foods") || currentPath.startsWith("/admin/seeds");
const isSistemaActive = currentPath.startsWith("/admin/logs") || currentPath.startsWith("/admin/devtools") || currentPath.startsWith("/admin/settings");
const isDashboardActive = currentPath === "/admin/dashboard" || currentPath === "/admin/dashboard/";
---
<BaseLayout>
  <DecorativeBackground />
  <ChatNotificationListener />

  <!-- Top Header Bar con Jerarquía Modular Ejecutiva -->
  <header
    class="fixed top-0 left-0 right-0 z-40 border-b border-[var(--border-subtle)] bg-[var(--surface-1)]/95 backdrop-blur-2xl h-14 flex items-center justify-between px-4 sm:px-6 shadow-sm"
  >
    <!-- Left: Brand Logo & Executive Badge -->
    <div class="flex items-center gap-3">
      <a
        href="/admin/dashboard"
        class="flex items-center gap-2.5 font-bold text-sm text-[var(--text-primary)] transition-all hover:opacity-90 group"
      >
        <div
          class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-[var(--brand-hover)] to-[var(--brand)] shadow-md shadow-[var(--shadow-glow-sm)] group-hover:scale-105 transition-transform"
        >
          <svg
            class="h-3.5 w-3.5 text-[var(--text-on-brand)]"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
            ></path>
          </svg>
        </div>
        <span class="font-extrabold tracking-tight text-white">CampFit</span>
        <span class="rounded-md bg-amber-500/15 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-amber-300 border border-amber-500/30 flex items-center gap-1">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Admin Suite
        </span>
        <VersionBadge />
      </a>

      <!-- Center: Domain-Based Clustered Navigation (Desktop) -->
      <nav class="hidden lg:flex items-center gap-1.5 pl-6 border-l border-[var(--border-subtle)] text-xs font-semibold">
        <!-- 1. Dashboard -->
        <a
          href="/admin/dashboard"
          class={`relative px-3 py-1.5 rounded-xl transition-all flex items-center gap-1.5 ${
            isDashboardActive
              ? "bg-[var(--brand)]/15 text-white font-black border border-[var(--brand)]/40 shadow-sm shadow-[var(--brand)]/20"
              : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
          }`}
        >
          <span>📊</span>
          <span>Dashboard</span>
        </a>

        <!-- 2. Bloque Gestión -->
        <div class="relative group">
          <button
            type="button"
            class={`relative px-3 py-1.5 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer ${
              isGestionActive
                ? "bg-[var(--brand)]/15 text-white font-black border border-[var(--brand)]/40 shadow-sm shadow-[var(--brand)]/20"
                : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
            }`}
          >
            <span>👥</span>
            <span>Gestión</span>
            <svg class="h-3 w-3 opacity-60 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </button>

          <!-- Dropdown Gestión -->
          <div class="absolute left-0 top-full mt-1.5 w-52 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)]/98 backdrop-blur-2xl p-1.5 shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
            <a
              href="/admin/users"
              class={`flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                currentPath.startsWith("/admin/users")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] font-bold"
                  : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
              }`}
            >
              <span>👥</span>
              <span>Usuarios & Atletas</span>
            </a>
            <a
              href="/admin/trainers"
              class={`flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                currentPath.startsWith("/admin/trainers")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] font-bold"
                  : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
              }`}
            >
              <span>🏋️</span>
              <span>Entrenadores (Staff)</span>
            </a>
            <a
              href="/admin/workouts"
              class={`flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                currentPath.startsWith("/admin/workouts")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] font-bold"
                  : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
              }`}
            >
              <span>📋</span>
              <span>Rutinas & Workouts</span>
            </a>
            <a
              href="/admin/diets"
              class={`flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                currentPath.startsWith("/admin/diets")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] font-bold"
                  : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
              }`}
            >
              <span>🍽️</span>
              <span>Dietas & Nutrición</span>
            </a>
          </div>
        </div>

        <!-- 3. Bloque Catálogos -->
        <div class="relative group">
          <button
            type="button"
            class={`relative px-3 py-1.5 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer ${
              isCatalogosActive
                ? "bg-[var(--brand)]/15 text-white font-black border border-[var(--brand)]/40 shadow-sm shadow-[var(--brand)]/20"
                : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
            }`}
          >
            <span>📚</span>
            <span>Catálogos</span>
            <svg class="h-3 w-3 opacity-60 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </button>

          <!-- Dropdown Catálogos -->
          <div class="absolute left-0 top-full mt-1.5 w-56 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)]/98 backdrop-blur-2xl p-1.5 shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
            <a
              href="/admin/seeds"
              class={`flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                currentPath.startsWith("/admin/seeds")
                  ? "bg-emerald-500/20 text-emerald-300 font-bold border border-emerald-500/30"
                  : "text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10"
              }`}
            >
              <span>🌱</span>
              <span>Gestor de Semillas (CSV/JSON)</span>
            </a>
            <a
              href="/admin/exercises"
              class={`flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                currentPath.startsWith("/admin/exercises")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] font-bold"
                  : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
              }`}
            >
              <span>🏋️</span>
              <span>Biblioteca Ejercicios</span>
            </a>
            <a
              href="/admin/foods"
              class={`flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                currentPath.startsWith("/admin/foods")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] font-bold"
                  : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
              }`}
            >
              <span>🥗</span>
              <span>Base Nutricional</span>
            </a>
          </div>
        </div>

        <!-- 4. Bloque Sistema -->
        <div class="relative group">
          <button
            type="button"
            class={`relative px-3 py-1.5 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer ${
              isSistemaActive
                ? "bg-[var(--brand)]/15 text-white font-black border border-[var(--brand)]/40 shadow-sm shadow-[var(--brand)]/20"
                : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
            }`}
          >
            <span>⚙️</span>
            <span>Sistema</span>
            <svg class="h-3 w-3 opacity-60 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </button>

          <!-- Dropdown Sistema -->
          <div class="absolute left-0 top-full mt-1.5 w-52 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-1)]/98 backdrop-blur-2xl p-1.5 shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
            <a
              href="/admin/logs"
              class={`flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                currentPath.startsWith("/admin/logs")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] font-bold"
                  : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
              }`}
            >
              <span>📜</span>
              <span>Logs & Auditoría</span>
            </a>
            <a
              href="/admin/devtools"
              class={`flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                currentPath.startsWith("/admin/devtools")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] font-bold"
                  : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
              }`}
            >
              <span>🛠️</span>
              <span>DevTools Studio</span>
            </a>
            <a
              href="/admin/settings"
              class={`flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                currentPath.startsWith("/admin/settings")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] font-bold"
                  : "text-[var(--text-secondary)] hover:text-white hover:bg-[var(--surface-2)]"
              }`}
            >
              <span>🔧</span>
              <span>Configuración Global</span>
            </a>
          </div>
        </div>
      </nav>
    </div>

    <!-- Right: Quick Portal Switchers & Profile Controls -->
    <div class="flex items-center gap-2.5">
      <!-- Portal Switchers -->
      <div class="hidden sm:flex items-center gap-1.5 bg-[var(--surface-2)] p-1 rounded-xl border border-[var(--border-subtle)] text-xs">
        <a
          href="/client/dashboard"
          class="px-2.5 py-1 rounded-lg text-[var(--text-tertiary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-3)] transition-all flex items-center gap-1 font-medium"
          title="Ver portal como Atleta / Alumno"
        >
          <span>👁️</span>
          <span class="hidden md:inline">Vista Cliente</span>
        </a>
        <a
          href="/trainer/dashboard"
          class="px-2.5 py-1 rounded-lg text-[var(--text-tertiary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-3)] transition-all flex items-center gap-1 font-medium"
          title="Ver portal como Entrenador"
        >
          <span>🏋️</span>
          <span class="hidden md:inline">Vista Coach</span>
        </a>
      </div>

      <LanguageSwitcherDropdown currentPath={currentPath} lang={lang} />

      <button
        id="admin-logout-top-btn"
        type="button"
        class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-rose-500/30 bg-rose-500/10 text-rose-300 hover:bg-rose-500/20 text-xs font-semibold transition-all cursor-pointer"
        title="Cerrar sesión de administrador"
      >
        <span>🚪</span>
        <span class="hidden lg:inline">Salir</span>
      </button>
    </div>
  </header>

  <!-- Page Layout with Desktop Sidebar -->
  <div class="pt-14 pb-20 md:pb-8">
    <div class="flex md:flex-row md:min-h-[calc(100vh-3.5rem)]">
      <!-- ===== DESKTOP SIDEBAR (~240px) ===== -->
      <aside
        class="hidden md:flex md:w-60 md:flex-col md:border-r md:border-[var(--border-subtle)] md:bg-[var(--surface-1)]/95 md:backdrop-blur-xl md:self-stretch select-none flex-shrink-0"
        style="min-height: calc(100vh - 3.5rem);"
      >
        <div class="flex flex-col flex-1 p-3 gap-5">

          <!-- 1. GESTIÓN CENTRAL -->
          <div class="space-y-1">
            <div class="px-3 pb-1 text-[10px] font-black uppercase tracking-wider text-[var(--text-tertiary)]">
              Gestión Central
            </div>
            
            <!-- Dashboard -->
            <a
              href="/admin/dashboard"
              class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs transition-all ${
                isDashboardActive
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] border-l-2 border-[var(--brand)] shadow-sm font-extrabold"
                  : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-2)] font-semibold"
              }`}
            >
              <span class="text-sm">📊</span>
              <span>Dashboard</span>
            </a>

            <!-- Users & Clientes -->
            <a
              href="/admin/users"
              class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs transition-all ${
                currentPath.startsWith("/admin/users") || currentPath.startsWith("/admin/clients")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] border-l-2 border-[var(--brand)] shadow-sm font-extrabold"
                  : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-2)] font-semibold"
              }`}
            >
              <span class="text-sm">👥</span>
              <span>Usuarios & Atletas</span>
            </a>

            <!-- Trainers -->
            <a
              href="/admin/trainers"
              class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs transition-all ${
                currentPath.startsWith("/admin/trainers")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] border-l-2 border-[var(--brand)] shadow-sm font-extrabold"
                  : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-2)] font-semibold"
              }`}
            >
              <span class="text-sm">🏋️</span>
              <span>Entrenadores</span>
            </a>

            <!-- Workouts -->
            <a
              href="/admin/workouts"
              class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs transition-all ${
                currentPath.startsWith("/admin/workouts")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] border-l-2 border-[var(--brand)] shadow-sm font-extrabold"
                  : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-2)] font-semibold"
              }`}
            >
              <span class="text-sm">📋</span>
              <span>Rutinas & Workouts</span>
            </a>

            <!-- Diets -->
            <a
              href="/admin/diets"
              class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs transition-all ${
                currentPath.startsWith("/admin/diets")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] border-l-2 border-[var(--brand)] shadow-sm font-extrabold"
                  : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-2)] font-semibold"
              }`}
            >
              <span class="text-sm">🍽️</span>
              <span>Dietas & Nutrición</span>
            </a>
          </div>

          <!-- 2. CATÁLOGOS & SEMILLAS -->
          <div class="space-y-1">
            <div class="px-3 pb-1 text-[10px] font-black uppercase tracking-wider text-[var(--text-tertiary)]">
              Catálogos & Semillas
            </div>

            <!-- Gestor de Semillas -->
            <a
              href="/admin/seeds"
              class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs transition-all ${
                currentPath.startsWith("/admin/seeds")
                  ? "bg-emerald-500/20 text-emerald-300 border-l-2 border-emerald-400 shadow-sm font-extrabold"
                  : "text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10 font-semibold"
              }`}
            >
              <span class="text-sm">🌱</span>
              <span>Gestor de Semillas</span>
            </a>

            <!-- Ejercicios -->
            <a
              href="/admin/exercises"
              class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs transition-all ${
                currentPath.startsWith("/admin/exercises")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] border-l-2 border-[var(--brand)] shadow-sm font-extrabold"
                  : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-2)] font-semibold"
              }`}
            >
              <span class="text-sm">🏋️</span>
              <span>Biblioteca Ejercicios</span>
            </a>

            <!-- Nutrición / Alimentos -->
            <a
              href="/admin/foods"
              class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs transition-all ${
                currentPath.startsWith("/admin/foods")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] border-l-2 border-[var(--brand)] shadow-sm font-extrabold"
                  : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-2)] font-semibold"
              }`}
            >
              <span class="text-sm">🥗</span>
              <span>Base Nutricional</span>
            </a>
          </div>

          <!-- 3. SISTEMA & AUDITORÍA -->
          <div class="space-y-1">
            <div class="px-3 pb-1 text-[10px] font-black uppercase tracking-wider text-[var(--text-tertiary)]">
              Sistema & Auditoría
            </div>

            <!-- Logs -->
            <a
              href="/admin/logs"
              class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs transition-all ${
                currentPath.startsWith("/admin/logs")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] border-l-2 border-[var(--brand)] shadow-sm font-extrabold"
                  : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-2)] font-semibold"
              }`}
            >
              <span class="text-sm">📜</span>
              <span>Logs & Auditoría</span>
            </a>

            <!-- DevTools -->
            <a
              href="/admin/devtools"
              class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs transition-all ${
                currentPath.startsWith("/admin/devtools")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] border-l-2 border-[var(--brand)] shadow-sm font-extrabold"
                  : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-2)] font-semibold"
              }`}
            >
              <span class="text-sm">🛠️</span>
              <span>DevTools Studio</span>
            </a>

            <!-- Settings -->
            <a
              href="/admin/settings"
              class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs transition-all ${
                currentPath.startsWith("/admin/settings")
                  ? "bg-[var(--brand-dim)] text-[var(--brand)] border-l-2 border-[var(--brand)] shadow-sm font-extrabold"
                  : "text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-2)] font-semibold"
              }`}
            >
              <span class="text-sm">⚙️</span>
              <span>Configuración</span>
            </a>
          </div>

          <!-- Bottom Footer Card in Sidebar -->
          <div class="mt-auto rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-2)] p-3 space-y-2">
            <div class="flex items-center gap-2.5">
              <div class="h-8 w-8 rounded-lg bg-[var(--brand-dim)] text-[var(--brand)] font-bold flex items-center justify-center text-xs">
                ⚡
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[11px] font-bold text-[var(--text-primary)] truncate" id="admin-user-email">Administrador</p>
                <p class="text-[10px] text-[var(--brand)] font-medium">Super Administrador</p>
              </div>
            </div>
            <div class="text-[10px] text-[var(--text-tertiary)] pt-1 border-t border-[var(--border-subtle)] flex items-center justify-between">
              <span>Auditoría: <kbd class="px-1 py-0.5 rounded bg-[var(--surface-3)] font-mono text-[9px]">Ctrl+Shift+L</kbd></span>
            </div>
          </div>
        </div>
      </aside>

      <!-- Content Area -->
      <main class="flex-1 min-w-0 overflow-x-hidden">
        <slot />
      </main>
    </div>

    <!-- ===== MÓVIL (< md): Bottom Nav Moderna ===== -->
    <nav
      class="fixed bottom-0 left-0 right-0 z-40 border-t border-[var(--border-subtle)] bg-[var(--surface-1)]/95 glass backdrop-blur-xl md:hidden"
    >
      <div class="grid grid-cols-5 items-center px-1 py-1 text-center">
        <!-- Dashboard -->
        <a
          href="/admin/dashboard"
          class={`flex flex-col items-center gap-0.5 py-1 rounded-lg transition-all ${
            isDashboardActive
              ? "text-[var(--brand)] font-bold"
              : "text-[var(--text-tertiary)] hover:text-[var(--text-secondary)]"
          }`}
        >
          <span class="text-base">📊</span>
          <span class="text-[9px]">Inicio</span>
        </a>

        <!-- Users -->
        <a
          href="/admin/users"
          class={`flex flex-col items-center gap-0.5 py-1 rounded-lg transition-all ${
            currentPath.startsWith("/admin/users")
              ? "text-[var(--brand)] font-bold"
              : "text-[var(--text-tertiary)] hover:text-[var(--text-secondary)]"
          }`}
        >
          <span class="text-base">👥</span>
          <span class="text-[9px]">Usuarios</span>
        </a>

        <!-- Semillas -->
        <a
