---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LanguageSwitcherDropdown from '@/components/LanguageSwitcherDropdown.astro';
import VersionBadge from '@/components/VersionBadge.astro';
import { type Language, translations } from '@/i18n/translations';

export interface Props { currentPath: string; lang?: Language; }
const { currentPath } = Astro.props;
const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const t = (key: string) => translations[lang]?.[key] || translations['es']?.[key] || key;
---
<BaseLayout>
  <div class="flex min-h-[calc(100vh+5rem)] -mb-20 flex-col bg-[var(--surface-0)] text-[var(--text-primary)] transition-colors duration-200">
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="absolute -left-40 -top-40 h-80 w-80 rounded-full bg-[var(--brand)] opacity-[0.04] blur-3xl"></div>
      <div class="absolute -bottom-40 -right-40 h-80 w-80 rounded-full bg-[var(--brand)] opacity-[0.04] blur-3xl"></div>
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-96 w-96 rounded-full bg-[var(--brand)] opacity-[0.02] blur-3xl"></div>
    </div>
    <nav class="relative z-20 border-b border-[var(--border-subtle)] bg-[var(--surface-1)]/80 backdrop-blur-xl">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2 font-bold text-lg text-[var(--text-primary)] shrink-0"><div class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-[var(--brand-hover)] to-[var(--brand)]"><svg class="h-4 w-4 text-[var(--text-on-brand)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg></div><span data-i18n="app.name">{t('app.name')}</span><VersionBadge /></a>
        <div class="hidden md:flex items-center gap-3">
          <LanguageSwitcherDropdown currentPath={currentPath} lang={lang} />
          <div id="navActionsDesktop" class="flex items-center gap-3">
            <a id="navLoginDesktop" href="/login" data-i18n="public.nav.login" class="inline-flex items-center justify-center gap-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-4 py-2 text-sm font-medium text-[var(--text-secondary)] transition-all duration-200 hover:border-[var(--border-strong)] hover:bg-[var(--surface-3)] hover:text-[var(--text-primary)] active:scale-95">{t('public.nav.login')}</a>
            <a id="navRegisterDesktop" href="/register" data-i18n="public.nav.register" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-4 py-2 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all duration-200 hover:shadow-[var(--shadow-glow-md)] hover:brightness-105 active:scale-95">{t('public.nav.register')}<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg></a>
            <a id="navDashboardDesktop" href="/client/dashboard" class="hidden inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-4 py-2 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all duration-200 hover:shadow-[var(--shadow-glow-md)] hover:brightness-105 active:scale-95"><span id="navDashboardTextDesktop" data-i18n="public.nav.dashboard">{t('public.nav.dashboard')}</span><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg></a>
          </div>
        </div>
        <div class="flex md:hidden items-center gap-2">
          <LanguageSwitcherDropdown currentPath={currentPath} lang={lang} />
          <button id="mobileMenuBtn" class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] p-2 text-[var(--text-secondary)] transition-all hover:border-[var(--border-strong)] hover:bg-[var(--surface-3)] hover:text-[var(--text-primary)] active:scale-95" aria-label="Menu">
            <svg id="menuIconOpen" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
            <svg id="menuIconClose" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      <div id="mobileMenu" class="hidden md:hidden border-t border-[var(--border-subtle)] bg-[var(--surface-1)]/95 backdrop-blur-xl animate-slide-down">
        <div class="flex flex-col gap-2 px-4 py-4" id="navActionsMobile">
          <a id="navLoginMobile" href="/login" data-i18n="public.nav.login" class="flex items-center justify-center gap-2 rounded-xl border border-[var(--border-default)] bg-[var(--surface-2)] px-4 py-2.5 text-sm font-medium text-[var(--text-secondary)] transition-all duration-200 hover:border-[var(--border-strong)] hover:bg-[var(--surface-3)] hover:text-[var(--text-primary)] active:scale-95">{t('public.nav.login')}</a>
          <a id="navRegisterMobile" href="/register" data-i18n="public.nav.register" class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-4 py-2.5 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all duration-200 hover:shadow-[var(--shadow-glow-md)] hover:brightness-105 active:scale-95">{t('public.nav.register')}<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg></a>
          <a id="navDashboardMobile" href="/client/dashboard" class="hidden flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[var(--brand)] to-[var(--brand-hover)] px-4 py-2.5 text-sm font-semibold text-[var(--text-on-brand)] shadow-[var(--shadow-glow-sm)] transition-all duration-200 hover:shadow-[var(--shadow-glow-md)] hover:brightness-105 active:scale-95"><span id="navDashboardTextMobile" data-i18n="public.nav.dashboard">{t('public.nav.dashboard')}</span><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg></a>
        </div>
      </div>
    </nav>
    <main class="flex-1 flex flex-col items-center justify-center px-4 py-8 relative z-10 w-full max-w-7xl mx-auto"><slot /></main>
  </div>
  <script>
    import { auth } from '@/lib/firebase'; import { onAuthStateChanged } from 'firebase/auth'; import { setStoredLanguage } from '@/i18n/client';
    const nd=document.getElementById('navLoginDesktop'),rd=document.getElementById('navRegisterDesktop'),dd=document.getElementById('navDashboardDesktop'),dt=document.getElementById('navDashboardTextDesktop'),nm=document.getElementById('navLoginMobile'),rm=document.getElementById('navRegisterMobile'),dm=document.getElementById('navDashboardMobile'),tm=document.getElementById('navDashboardTextMobile');
    const R: Record<string, string> = {admin:'/admin/dashboard',trainer:'/trainer/dashboard',client:'/client/dashboard'},L: Record<string, string> = {admin:'Panel Admin',trainer:'Panel Trainer',client:'Mi Dashboard'};
    function u(n: { role: string } | null){if(!n){if(nd){nd.classList.remove('hidden');nd.style.display=''}if(rd){rd.classList.remove('hidden');rd.style.display=''}if(dd){dd.classList.add('hidden');dd.style.display='none'}if(nm){nm.classList.remove('hidden');nm.style.display=''}if(rm){rm.classList.remove('hidden');rm.style.display=''}if(dm){dm.classList.add('hidden');dm.style.display='none'}}else{if(nd){nd.classList.add('hidden');nd.style.display='none'}if(rd){rd.classList.add('hidden');rd.style.display='none'}if(dd){dd.classList.remove('hidden');dd.style.display=''}if(nm){nm.classList.add('hidden');nm.style.display='none'}if(rm){rm.classList.add('hidden');rm.style.display='none'}if(dm){dm.classList.remove('hidden');dm.style.display=''}const role = n.role as 'admin' | 'trainer' | 'client'; const l=L[role]||'Dashboard',r=R[role]||'/client/dashboard';if(dt)dt.textContent=l;if(dd)dd.setAttribute('href',r);if(tm)tm.textContent=l;if(dm)dm.setAttribute('href',r)}}
    onAuthStateChanged(auth,async(f)=>{if(!f){u(null);return}try{const{db}=await import('@/lib/firebase'),{doc,getDoc}=await import('firebase/firestore'),s=await getDoc(doc(db,'users',f.uid)),r=s.exists()?(s.data().role||'client'):'client';u({role:r})}catch{u(null)}});
    const p=new URLSearchParams(window.location.search),l=p.get('lang');if(l==='es'||l==='en')setStoredLanguage(l);
    const b=document.getElementById('mobileMenuBtn'),m=document.getElementById('mobileMenu'),o=document.getElementById('menuIconOpen'),c=document.getElementById('menuIconClose');if(b&&m&&o&&c){b.addEventListener('click',()=>{const i=!m.classList.contains('hidden');m.classList.toggle('hidden',i);o.classList.toggle('hidden',!i);c.classList.toggle('hidden',i)});m.querySelectorAll('a').forEach(x=>x.addEventListener('click',()=>{m.classList.add('hidden');o.classList.remove('hidden');c.classList.add('hidden')}))}
  </script>
</BaseLayout>