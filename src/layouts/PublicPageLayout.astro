---
import BaseLayout from '@/layouts/BaseLayout.astro';
import UIThemeSwitcher from '@/components/UIThemeSwitcher.astro';
import { type Language } from '@/i18n/translations';

export interface Props {
  currentPath: string;
  lang?: Language;
}

const { currentPath } = Astro.props;
const lang = (Astro.url.searchParams.get('lang') as Language) || 'es';
const altLang = lang === 'es' ? 'en' : 'es';
---

<BaseLayout>
  <div class="flex min-h-screen flex-col bg-[var(--surface-0)] text-[var(--text-primary)] transition-colors duration-200">
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="absolute -left-40 -top-40 h-80 w-80 rounded-full bg-[var(--brand)] opacity-[0.04] blur-3xl"></div>
      <div class="absolute -bottom-40 -right-40 h-80 w-80 rounded-full bg-[var(--brand)] opacity-[0.04] blur-3xl"></div>
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-96 w-96 rounded-full bg-[var(--brand)] opacity-[0.02] blur-3xl"></div>
    </div>
    <div class="fixed right-4 top-4 z-50 flex items-center gap-2">
      <UIThemeSwitcher />
      <a href={`${currentPath}?lang=${altLang}`} class="inline-flex items-center gap-1.5 rounded-xl border border-[var(--border-default)] bg-[var(--surface-1)] px-3 py-2 text-xs font-medium text-[var(--text-secondary)] backdrop-blur-sm transition-all duration-200 hover:border-[var(--border-strong)] hover:text-[var(--text-primary)] active:scale-95">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3"/></svg>
        {altLang === 'en' ? 'EN' : 'ES'}
      </a>
    </div>
    <!-- Navbar -->
    <nav class="relative z-20 border-b border-[var(--border-subtle)] bg-[var(--surface-1)]/80 backdrop-blur-xl">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <a href={`/?lang=${lang}`} class="flex items-center gap-2 font-bold text-lg text-[var(--text-primary)]">
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-[var(--brand-hover)] to-[var(--brand)]">
            <svg class="h-4 w-4 text-[var(--text-on-brand)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          CampFit
        </a>
        <div class="flex items-center gap-3">
          <a href={`/login?lang=${lang}`} class="text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors">Iniciar Sesión</a>
          <a href={`/register?lang=${lang}`} class="rounded-lg bg-[var(--brand)] px-3 py-1.5 text-sm font-medium text-[var(--text-on-brand)] hover:bg-[var(--brand-hover)] transition-colors">Registrarse</a>
        </div>
      </div>
    </nav>

    <main class="flex-1 flex flex-col items-center justify-center px-4 py-12 relative z-10 w-full max-w-7xl mx-auto">
      <slot />
    </main>
  </div>
</BaseLayout>