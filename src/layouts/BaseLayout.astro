---
export interface Props {
  title?: string;
}

export type Language = "es" | "en";
const { title = "CampFit" } = Astro.props;
const lang = Astro.params.lang || "es";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="CampFit — Tu plataforma de entrenamiento personal. Rutinas, dietas y seguimiento de progreso."
    />
    <meta name="theme-color" content="#10b981" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CampFit" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="CampFit" />

    <!-- PWA Manifest & Icons -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="192x192" href="/pwa-icon-192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/pwa-icon-512.png" />

    <!-- Open Graph -->
    <meta property="og:title" content="CampFit" />
    <meta property="og:description" content="Tu plataforma de entrenamiento personal" />
    <meta property="og:image" content="/logo-full.png" />
    <meta property="og:type" content="website" />

    <!-- Service Worker (solo en producción) -->
    <script>
      if ("serviceWorker" in navigator && import.meta.env.PROD) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch((err) => {
            console.error("[SW] Registration failed:", err);
          });
        });
      }
    </script>

    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style="font-family: 'Inter', sans-serif;">
    <script>
      (function () {
        try {
          var oldKey = localStorage.getItem("campfit_theme");
          var mode, flavor;
          if (oldKey) {
            mode = oldKey;
            flavor = "emerald";
            localStorage.removeItem("campfit_theme");
            localStorage.setItem("campfit_theme_mode", mode);
            localStorage.setItem("campfit_theme_flavor", flavor);
          } else {
            mode = localStorage.getItem("campfit_theme_mode") || "dark";
            flavor = localStorage.getItem("campfit_theme_flavor") || "onyx";
          }
          document.documentElement.setAttribute("data-theme-mode", mode);
          document.documentElement.setAttribute("data-theme-flavor", flavor);
          document.documentElement.style.colorScheme = mode;
        } catch (e) {
          document.documentElement.setAttribute("data-theme-mode", "dark");
          document.documentElement.setAttribute("data-theme-flavor", "emerald");
        }
      })();
      (function () {
        try {
          var url = new URL(window.location.href);
          var urlLang = url.searchParams.get("lang");
          var storedLang = localStorage.getItem("campfit_lang");
          var cookieLang = document.cookie.split("; ").find((r) => r.startsWith("cf_lang="));
          cookieLang = cookieLang ? cookieLang.split("=")[1] : undefined;

          var finalLang;
          if (urlLang === "es" || urlLang === "en") {
            finalLang = urlLang;
            localStorage.setItem("campfit_lang", finalLang);
          } else if (storedLang === "es" || storedLang === "en") {
            finalLang = storedLang;
          } else if (cookieLang === "es" || cookieLang === "en") {
            finalLang = cookieLang;
            localStorage.setItem("campfit_lang", finalLang);
          } else {
            finalLang = "es";
            localStorage.setItem("campfit_lang", finalLang);
          }

          document.cookie = "cf_lang=" + finalLang + ";path=/;max-age=31536000;SameSite=Lax";
          document.documentElement.lang = finalLang;
        } catch (e) {}
      })();
    </script>
    <script>
      import { translateDOM } from "@/i18n/client";
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => translateDOM());
      } else {
        translateDOM();
      }
    </script>
    <div class="app-shell">
      <slot />
    </div>
    <!-- 🛠 DevTools (solo en desarrollo) -->
    <script>
      import { initDevTools } from "@/lib/devtools";
      initDevTools();
    </script>
  </body>
</html>

<script>
  import "@/lib/debug/consoleFileLogger";
  import "@/lib/debug/firestoreDebug";

  // Interceptar clicks en enlaces locales para inyectar automáticamente ?lang= si falta
  document.addEventListener("click", (e) => {
    const anchor = (e.target as HTMLElement).closest("a");
    if (anchor && anchor.href && anchor.host === window.location.host) {
      try {
        const url = new URL(anchor.href);
        // Omitir si es un link de logout, auth especial o vacío
        if (url.pathname.startsWith("/api/") || anchor.getAttribute("download") !== null) return;

        if (!url.searchParams.has("lang")) {
          const currentLang = localStorage.getItem("campfit_lang") || "es";
          url.searchParams.set("lang", currentLang);
          anchor.href = url.toString();
        }
      } catch (err) {}
    }
  });
</script>

<style is:global>
  @import "tailwindcss";
  @import "../styles/theme.css";

  /* ============================================================
   * CAMPFIT DESIGN SYSTEM TOKENS v2 — WCAG AA contrast optimized
   * ============================================================ */
  :root,
  [data-theme-mode="dark"] {
    color-scheme: dark;

    /* Map flavor-aware tokens from theme.css to the v2 surface system */
    --brand: var(--color-brand-primary, #10b981);
    --brand-hover: var(--color-brand-primary-hover, #34d399);
    --brand-dim: var(--color-brand-light, color-mix(in srgb, var(--brand) 15%, transparent));
    --brand-glow: color-mix(in srgb, var(--brand) 25%, transparent);
    --brand-gradient: linear-gradient(
      135deg,
      var(--brand) 0%,
      var(--brand-hover) 50%,
      var(--color-brand-secondary, var(--brand-hover)) 100%
    );
    --brand-gradient-subtle: linear-gradient(
      135deg,
      color-mix(in srgb, var(--brand) 30%, transparent) 0%,
      color-mix(in srgb, var(--brand) 15%, transparent) 100%
    );

    --surface-0: var(--color-bg-primary, #09090b);
    --surface-1: #131316;
    --surface-2: var(--color-bg-secondary, #18181b);
    --surface-3: #1f1f24;
    --surface-4: #27272d;
    --surface-5: #2f2f36;
    --surface-glass: oklch(0.15 0.01 260 / 0.6);

    --accent-blue: #3b82f6;
    --accent-blue-hover: #60a5fa;
    --accent-blue-dim: #1e3a6f;
    --accent-purple: #8b5cf6;
    --accent-purple-hover: #a78bfa;
    --accent-purple-dim: #2e1a4f;
    --accent-amber: #f59e0b;
    --accent-amber-hover: #fbbf24;
    --accent-amber-dim: #5c3d00;

    --text-primary: #fafafa;
    --text-secondary: #a1a1aa;
    --text-tertiary: #909099;
    --text-disabled: #6b6b73;
    --text-on-brand: var(--color-text-inverse, #ffffff);

    --border-default: oklch(0.28 0.01 260);
    --border-subtle: oklch(0.22 0.01 260);
    --border-strong: oklch(0.35 0.01 260);
    --border-brand: color-mix(in srgb, var(--brand) 40%, transparent);

    --success: #10b981;
    --success-dim: #064e3b;
    --warning: #f59e0b;
    --warning-dim: #5c3d00;
    --danger: #ef4444;
    --danger-dim: #581c1c;
    --info: #3b82f6;
    --info-dim: #1e3a6f;

    --shadow-xs: 0 1px 2px oklch(0 0 0 / 0.4);
    --shadow-sm: 0 1px 3px oklch(0 0 0 / 0.5), 0 1px 2px oklch(0 0 0 / 0.4);
    --shadow-md: 0 4px 6px oklch(0 0 0 / 0.5), 0 2px 4px oklch(0 0 0 / 0.4);
    --shadow-lg: 0 10px 15px oklch(0 0 0 / 0.55), 0 4px 6px oklch(0 0 0 / 0.4);
    --shadow-xl: 0 20px 25px oklch(0 0 0 / 0.6), 0 8px 10px oklch(0 0 0 / 0.4);
    --shadow-glow-sm: 0 0 12px var(--brand-glow);
    --shadow-glow-md: 0 0 24px var(--brand-glow);
    --shadow-glow-lg: 0 0 40px var(--brand-glow), 0 0 80px oklch(0.75 0.2 160 / 0.12);

    --radius-xs: 0.25rem;
    --radius-sm: 0.375rem;
    --radius-md: 0.625rem;
    --radius-lg: 0.875rem;
    --radius-xl: 1.125rem;
    --radius-2xl: 1.5rem;
    --radius-full: 9999px;

    --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-base: 200ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 300ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-spring: 400ms cubic-bezier(0.34, 1.56, 0.64, 1);

    --glass-bg: oklch(0.12 0.01 260 / 0.7);
    --glass-border: oklch(0.28 0.01 260 / 0.5);
    --glass-blur: 16px;
  }

  [data-theme-mode="light"] {
    color-scheme: light;

    /* Map flavor-aware tokens from theme.css to the v2 surface system */
    --brand: var(--color-brand-primary, #059669);
    --brand-hover: var(--color-brand-primary-hover, #047857);
    --brand-dim: var(--color-brand-light, color-mix(in srgb, var(--brand) 12%, transparent));
    --brand-glow: color-mix(in srgb, var(--brand) 20%, transparent);
    --brand-gradient: linear-gradient(
      135deg,
      var(--brand) 0%,
      var(--brand-hover) 50%,
      var(--color-brand-secondary, var(--brand-hover)) 100%
    );
    --brand-gradient-subtle: linear-gradient(
      135deg,
      color-mix(in srgb, var(--brand) 20%, transparent) 0%,
      color-mix(in srgb, var(--brand) 10%, transparent) 100%
    );

    --surface-0: var(--color-bg-primary, #fafafa);
    --surface-1: #ffffff;
    --surface-2: var(--color-bg-secondary, #f4f4f6);
    --surface-3: #eaeaed;
    --surface-4: #dfdfe3;
    --surface-5: #d4d4d8;
    --surface-glass: oklch(0.98 0.002 260 / 0.65);

    --accent-blue: #2563eb;
    --accent-blue-hover: #1d4ed8;
    --accent-blue-dim: #dbeafe;
    --accent-purple: #7c3aed;
    --accent-purple-hover: #6d28d9;
    --accent-purple-dim: #ede9fe;
    --accent-amber: #d97706;
    --accent-amber-hover: #b45309;
    --accent-amber-dim: #fef3c7;

    --text-primary: #18181b;
    --text-secondary: #52525b;
    --text-tertiary: #6b6b73;
    --text-disabled: #787882;
    --text-on-brand: #fafafa;

    --border-default: oklch(0.85 0.01 260);
    --border-subtle: oklch(0.92 0.005 260);
    --border-strong: oklch(0.75 0.01 260);
    --border-brand: color-mix(in srgb, var(--brand) 35%, transparent);

    --success-dim: #d1fae5;
    --warning-dim: #fef3c7;
    --danger-dim: #fee2e2;
    --info-dim: #dbeafe;

    --shadow-xs: 0 1px 2px oklch(0 0 0 / 0.05);
    --shadow-sm: 0 1px 3px oklch(0 0 0 / 0.08), 0 1px 2px oklch(0 0 0 / 0.04);
    --shadow-md: 0 4px 6px oklch(0 0 0 / 0.06), 0 2px 4px oklch(0 0 0 / 0.04);
    --shadow-lg: 0 10px 15px oklch(0 0 0 / 0.08), 0 4px 6px oklch(0 0 0 / 0.03);
    --shadow-xl: 0 20px 25px oklch(0 0 0 / 0.1), 0 8px 10px oklch(0 0 0 / 0.04);
    --shadow-glow-sm: 0 0 12px var(--brand-glow);
    --shadow-glow-md: 0 0 20px var(--brand-glow);
    --shadow-glow-lg: 0 0 36px var(--brand-glow);

    --glass-bg: oklch(0.99 0.002 260 / 0.75);
    --glass-border: oklch(0.85 0.01 260 / 0.6);
  }

  @theme {
    --color-surface-0: var(--surface-0);
    --color-surface-1: var(--surface-1);
    --color-surface-2: var(--surface-2);
    --color-surface-3: var(--surface-3);
    --color-surface-4: var(--surface-4);
    --color-surface-5: var(--surface-5);
    --color-surface-glass: var(--surface-glass);

    --color-brand: var(--brand);
    --color-brand-hover: var(--brand-hover);
    --color-brand-dim: var(--brand-dim);

    --color-accent-blue: var(--accent-blue);
    --color-accent-blue-hover: var(--accent-blue-hover);
    --color-accent-blue-dim: var(--accent-blue-dim);
    --color-accent-purple: var(--accent-purple);
    --color-accent-purple-hover: var(--accent-purple-hover);
    --color-accent-purple-dim: var(--accent-purple-dim);
    --color-accent-amber: var(--accent-amber);
    --color-accent-amber-hover: var(--accent-amber-hover);
    --color-accent-amber-dim: var(--accent-amber-dim);

    --color-text-primary: var(--text-primary);
    --color-text-secondary: var(--text-secondary);
    --color-text-tertiary: var(--text-tertiary);
    --color-text-disabled: var(--text-disabled);
    --color-text-on-brand: var(--text-on-brand);

    --color-border-default: var(--border-default);
    --color-border-subtle: var(--border-subtle);
    --color-border-strong: var(--border-strong);
    --color-border-brand: var(--border-brand);

    --color-success: var(--success);
    --color-success-dim: var(--success-dim);
    --color-warning: var(--warning);
    --color-warning-dim: var(--warning-dim);
    --color-danger: var(--danger);
    --color-danger-dim: var(--danger-dim);
    --color-info: var(--info);
    --color-info-dim: var(--info-dim);
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    background-color: var(--surface-0);
    color: var(--text-primary);
    min-height: 100vh;
    transition:
      background-color var(--transition-base),
      color var(--transition-base);
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0.012;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  }

  body::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 9998;
    pointer-events: none;
    opacity: 0.03;
    background-image:
      linear-gradient(var(--border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-subtle) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 70%);
  }

  @view-transition {
    navigation: auto;
  }
  ::view-transition-old(root) {
    animation: fadeOutScale 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  ::view-transition-new(root) {
    animation: fadeInScale 0.3s cubic-bezier(0.4, 0, 1, 1) 0.1s forwards;
  }

  @keyframes fadeOutScale {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(0.98);
    }
  }

  .app-shell {
    padding-bottom: 5rem;
    min-height: 100vh;
  }

  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--surface-4);
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--surface-5);
  }

  :focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  ::selection {
    background: oklch(0.65 0.18 160 / 0.3);
    color: var(--text-primary);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes pulseGlow {
    0%,
    100% {
      box-shadow: var(--shadow-glow-sm);
    }
    50% {
      box-shadow: var(--shadow-glow-md);
    }
  }
  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes toastIn {
    from {
      opacity: 0;
      transform: translate(-50%, 16px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }
  @keyframes toastOut {
    from {
      opacity: 1;
      transform: translate(-50%, 0);
    }
    to {
      opacity: 0;
      transform: translate(-50%, -8px);
    }
  }

  .animate-fade-in {
    animation: fadeIn var(--transition-base) ease-out forwards;
  }
  .animate-fade-in-delay {
    animation: fadeIn var(--transition-base) ease-out 0.15s forwards;
    opacity: 0;
  }
  .animate-fade-in-scale {
    animation: fadeInScale var(--transition-spring) ease-out forwards;
  }
  .animate-slide-up {
    animation: slideUp var(--transition-base) ease-out forwards;
  }
  .animate-slide-down {
    animation: slideDown var(--transition-base) ease-out forwards;
  }
  .animate-pulse-glow {
    animation: pulseGlow 3s ease-in-out infinite;
  }

  .skeleton {
    background: linear-gradient(
      90deg,
      var(--surface-2) 25%,
      var(--surface-3) 50%,
      var(--surface-2) 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s ease-in-out infinite;
    border-radius: var(--radius-md);
  }

  .glass {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
  }

  /* ============================================================
   * CAMPFIT MOTION SYSTEM — Tokens, Keyframes, Utilities
   * ============================================================ */

  /* Motion tokens */
  :root {
    --duration-instant: 80ms;
    --duration-fast: 150ms;
    --duration-normal: 250ms;
    --duration-slow: 400ms;
    --duration-slower: 600ms;

    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    --ease-soft: cubic-bezier(0.25, 0.46, 0.45, 0.94);

    --stagger-1: 50ms;
    --stagger-2: 100ms;
    --stagger-3: 150ms;
    --stagger-4: 200ms;
    --stagger-5: 250ms;
    --stagger-6: 300ms;
    --stagger-7: 350ms;
    --stagger-8: 400ms;

    --slide-offset-sm: 8px;
    --slide-offset-md: 16px;
    --slide-offset-lg: 24px;
  }

  /* Keyframes */
  @keyframes cf-fade-in-up {
    from {
      opacity: 0;
      transform: translateY(var(--slide-offset-md));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes cf-fade-in-left {
    from {
      opacity: 0;
      transform: translateX(var(--slide-offset-md));
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes cf-fade-in-right {
    from {
      opacity: 0;
      transform: translateX(calc(-1 * var(--slide-offset-md)));
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes cf-scale-in {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes cf-scale-in-pop {
    0% {
      opacity: 0;
      transform: scale(0.8);
    }
    60% {
      opacity: 1;
      transform: scale(1.03);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes cf-ripple {
    to {
      transform: scale(2.5);
      opacity: 0;
    }
  }

  @keyframes cf-bounce-subtle {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(calc(-1 * var(--slide-offset-sm)));
    }
  }

  @keyframes cf-shake {
    10%,
    90% {
      transform: translateX(-2px);
    }
    20%,
    80% {
      transform: translateX(3px);
    }
    30%,
    50%,
    70% {
      transform: translateX(-4px);
    }
    40%,
    60% {
      transform: translateX(4px);
    }
  }

  /* Utility classes */
  .animate-fade-in-up {
    animation: cf-fade-in-up var(--duration-normal) var(--ease-out-expo) both;
  }

  .animate-fade-in-left {
    animation: cf-fade-in-left var(--duration-normal) var(--ease-out-expo) both;
  }

  .animate-fade-in-right {
    animation: cf-fade-in-right var(--duration-normal) var(--ease-out-expo) both;
  }

  .animate-scale-in {
    animation: cf-scale-in var(--duration-normal) var(--ease-out-expo) both;
  }

  .animate-scale-in-pop {
    animation: cf-scale-in-pop var(--duration-slow) var(--ease-spring) both;
  }

  .animate-shake {
    animation: cf-shake var(--duration-slow) var(--ease-in-out) both;
