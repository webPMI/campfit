---
export type Language = 'es' | 'en';
const lang = Astro.params.lang || 'es';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>CampFit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body style="font-family: 'Inter', sans-serif;">
    <script>
      // Apply theme immediately to prevent flash (FOUC)
      (function() {
        const saved = localStorage.getItem('campfit_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', saved);
        document.documentElement.style.colorScheme = saved;
      })();
    </script>
    <div class="app-shell">
      <slot />
    </div>
  </body>
</html>

<!-- Firestore Debug System (Ctrl+Shift+D) -->
<script>
  import '@/lib/debug/firestoreDebug';
</script>

<style>
  @import "tailwindcss";

  /* ============================================================
   * CAMPFIT DESIGN SYSTEM TOKENS
   * ============================================================
   * Futuristic Material-inspired theme system.
   * All colors, shadows, and animations are controlled via
   * CSS custom properties with data-theme toggling.
   */

  /* ── Base Theme (Dark by default) ──────────────────────── */
  :root,
  [data-theme="dark"] {
    color-scheme: dark;

    /* Surface colors - Layered depth system */
    --surface-0: #09090b;
    --surface-1: #131316;
    --surface-2: #18181b;
    --surface-3: #1f1f24;
    --surface-4: #27272d;
    --surface-5: #2f2f36;
    --surface-glass: oklch(0.15 0.01 260 / 0.6);

    /* Brand colors */
    --brand: #10b981;
    --brand-hover: #34d399;
    --brand-dim: #064e3b;
    --brand-glow: oklch(0.75 0.2 160 / 0.25);
    --brand-gradient: linear-gradient(135deg, #10b981 0%, #34d399 50%, #6ee7b7 100%);
    --brand-gradient-subtle: linear-gradient(135deg, oklch(0.35 0.08 160) 0%, oklch(0.30 0.06 160) 100%);

    /* Accent colors */
    --accent-blue: #3b82f6;
    --accent-blue-hover: #60a5fa;
    --accent-blue-dim: #1e3a5f;
    --accent-purple: #8b5cf6;
    --accent-purple-hover: #a78bfa;
    --accent-purple-dim: #2e1a4f;
    --accent-amber: #f59e0b;
    --accent-amber-hover: #fbbf24;
    --accent-amber-dim: #4a3000;

    /* Text hierarchy */
    --text-primary: #fafafa;
    --text-secondary: #a1a1aa;
    --text-tertiary: #71717a;
    --text-disabled: #52525b;
    --text-on-brand: #022c22;

    /* Borders */
    --border-default: oklch(0.28 0.01 260);
    --border-subtle: oklch(0.22 0.01 260);
    --border-strong: oklch(0.35 0.01 260);
    --border-brand: oklch(0.45 0.12 160 / 0.5);

    /* Status colors */
    --success: #10b981;
    --success-dim: #064e3b;
    --warning: #f59e0b;
    --warning-dim: #4a3000;
    --danger: #ef4444;
    --danger-dim: #450a0a;
    --info: #3b82f6;
    --info-dim: #1e3a5f;

    /* Shadows - Modern layered elevation */
    --shadow-xs: 0 1px 2px oklch(0 0 0 / 0.4);
    --shadow-sm: 0 1px 3px oklch(0 0 0 / 0.5), 0 1px 2px oklch(0 0 0 / 0.4);
    --shadow-md: 0 4px 6px oklch(0 0 0 / 0.5), 0 2px 4px oklch(0 0 0 / 0.4);
    --shadow-lg: 0 10px 15px oklch(0 0 0 / 0.55), 0 4px 6px oklch(0 0 0 / 0.4);
    --shadow-xl: 0 20px 25px oklch(0 0 0 / 0.6), 0 8px 10px oklch(0 0 0 / 0.4);
    --shadow-glow-sm: 0 0 12px var(--brand-glow);
    --shadow-glow-md: 0 0 24px var(--brand-glow);
    --shadow-glow-lg: 0 0 40px var(--brand-glow), 0 0 80px oklch(0.75 0.2 160 / 0.12);

    /* Radius scale */
    --radius-xs: 0.25rem;
    --radius-sm: 0.375rem;
    --radius-md: 0.625rem;
    --radius-lg: 0.875rem;
    --radius-xl: 1.125rem;
    --radius-2xl: 1.5rem;
    --radius-full: 9999px;

    /* Typography scale */
    --font-xs: 0.75rem;
    --font-sm: 0.8125rem;
    --font-base: 0.9375rem;
    --font-lg: 1.0625rem;
    --font-xl: 1.25rem;
    --font-2xl: 1.5rem;
    --font-3xl: 1.875rem;
    --font-4xl: 2.25rem;

    --font-weight-normal: 400;
    --font-weight-medium: 500;
    --font-weight-semibold: 600;
    --font-weight-bold: 700;
    --font-weight-extrabold: 800;

    /* Spacing scale */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-20: 5rem;

    /* Transitions */
    --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-base: 200ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 300ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-spring: 400ms cubic-bezier(0.34, 1.56, 0.64, 1);

    /* Glass morphism */
    --glass-bg: oklch(0.12 0.01 260 / 0.7);
    --glass-border: oklch(0.28 0.01 260 / 0.5);
    --glass-blur: 16px;
  }

  /* ── Light Theme ────────────────────────────────────────── */
  [data-theme="light"] {
    color-scheme: light;

    --surface-0: #fafafa;
    --surface-1: #ffffff;
    --surface-2: #f4f4f6;
    --surface-3: #eaeaed;
    --surface-4: #dfdfe3;
    --surface-5: #d4d4d8;
    --surface-glass: oklch(0.98 0.002 260 / 0.65);

    --brand: #059669;
    --brand-hover: #047857;
    --brand-dim: #d1fae5;
    --brand-glow: oklch(0.65 0.18 160 / 0.2);
    --brand-gradient: linear-gradient(135deg, #059669 0%, #10b981 50%, #34d399 100%);
    --brand-gradient-subtle: linear-gradient(135deg, oklch(0.88 0.06 160) 0%, oklch(0.92 0.04 160) 100%);

    --accent-blue: #2563eb;
    --accent-blue-hover: #1d4ed8;
    --accent-blue-dim: #dbeafe;
    --accent-purple: #7c3aed;
    --accent-purple-hover: #6d28d9;
    --accent-purple-dim: #ede9fe;
    --accent-amber: #d97706;
    --accent-amber-hover: #b45309;
    --accent-amber-dim: #fef3c7;

    --text-primary: #18181b;
    --text-secondary: #52525b;
    --text-tertiary: #71717a;
    --text-disabled: #a1a1aa;
    --text-on-brand: #fafafa;

    --border-default: oklch(0.85 0.01 260);
    --border-subtle: oklch(0.92 0.005 260);
    --border-strong: oklch(0.75 0.01 260);
    --border-brand: oklch(0.5 0.12 160 / 0.45);

    --success-dim: #d1fae5;
    --warning-dim: #fef3c7;
    --danger-dim: #fee2e2;
    --info-dim: #dbeafe;

    --shadow-xs: 0 1px 2px oklch(0 0 0 / 0.05);
    --shadow-sm: 0 1px 3px oklch(0 0 0 / 0.08), 0 1px 2px oklch(0 0 0 / 0.04);
    --shadow-md: 0 4px 6px oklch(0 0 0 / 0.06), 0 2px 4px oklch(0 0 0 / 0.04);
    --shadow-lg: 0 10px 15px oklch(0 0 0 / 0.08), 0 4px 6px oklch(0 0 0 / 0.03);
    --shadow-xl: 0 20px 25px oklch(0 0 0 / 0.1), 0 8px 10px oklch(0 0 0 / 0.04);
    --shadow-glow-sm: 0 0 12px var(--brand-glow);
    --shadow-glow-md: 0 0 20px var(--brand-glow);
    --shadow-glow-lg: 0 0 36px var(--brand-glow);

    --glass-bg: oklch(0.99 0.002 260 / 0.75);
    --glass-border: oklch(0.85 0.01 260 / 0.6);
  }

  /* ── Tailwind v4 Theme Integration ──────────────────────── */
  @theme {
    --color-surface-0: var(--surface-0);
    --color-surface-1: var(--surface-1);
    --color-surface-2: var(--surface-2);
    --color-surface-3: var(--surface-3);
    --color-surface-4: var(--surface-4);
    --color-surface-5: var(--surface-5);
    --color-brand: var(--brand);
    --color-brand-hover: var(--brand-hover);
    --color-brand-dim: var(--brand-dim);
    --color-accent-blue: var(--accent-blue);
    --color-accent-purple: var(--accent-purple);
    --color-accent-amber: var(--accent-amber);
    --color-text-primary: var(--text-primary);
    --color-text-secondary: var(--text-secondary);
    --color-text-tertiary: var(--text-tertiary);
    --color-border-default: var(--border-default);
    --color-border-subtle: var(--border-subtle);
    --color-success: var(--success);
    --color-warning: var(--warning);
    --color-danger: var(--danger);
    --color-info: var(--info);
  }

  /* ── Global Styles ──────────────────────────────────────── */
  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    background-color: var(--surface-0);
    color: var(--text-primary);
    min-height: 100vh;
    transition: background-color var(--transition-base), color var(--transition-base);
  }

  /* Subtle noise texture overlay for depth */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0.012;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  }

  /* 3D grid pattern for depth perception */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 9998;
    pointer-events: none;
    opacity: 0.03;
    background-image:
      linear-gradient(var(--border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-subtle) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 70%);
  }

  /* Smooth page transition */
  @view-transition {
    navigation: auto;
  }

  ::view-transition-old(root) {
    animation: fadeOutScale 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  ::view-transition-new(root) {
    animation: fadeInScale 0.3s cubic-bezier(0.4, 0, 1, 1) 0.1s forwards;
  }

  @keyframes fadeOutScale {
    from { opacity: 1; transform: scale(1); }
    to { opacity: 0; transform: scale(0.98); }
  }

  /* App shell - bottom nav spacing */
  .app-shell {
    padding-bottom: 5rem;
    min-height: 100vh;
  }

  /* ── Scrollbar (themed) ─────────────────────────────────── */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb {
    background: var(--surface-4);
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--surface-5);
  }

  /* ── Focus ring (accessible, brand-colored) ─────────────── */
  :focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ── Selection color ────────────────────────────────────── */
  ::selection {
    background: oklch(0.65 0.18 160 / 0.3);
    color: var(--text-primary);
  }

  /* ── Animations ─────────────────────────────────────────── */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeInScale {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(16px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes pulseGlow {
    0%, 100% { box-shadow: var(--shadow-glow-sm); }
    50% { box-shadow: var(--shadow-glow-md); }
  }

  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @keyframes toastIn {
    from { opacity: 0; transform: translate(-50%, 16px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  @keyframes toastOut {
    from { opacity: 1; transform: translate(-50%, 0); }
    to { opacity: 0; transform: translate(-50%, -8px); }
  }

  .animate-fade-in         { animation: fadeIn var(--transition-base) ease-out forwards; }
  .animate-fade-in-delay   { animation: fadeIn var(--transition-base) ease-out 0.15s forwards; opacity: 0; }
  .animate-fade-in-scale   { animation: fadeInScale var(--transition-spring) ease-out forwards; }
  .animate-slide-up        { animation: slideUp var(--transition-base) ease-out forwards; }
  .animate-slide-down      { animation: slideDown var(--transition-base) ease-out forwards; }
  .animate-pulse-glow      { animation: pulseGlow 3s ease-in-out infinite; }

  /* ── Utility: Shimmer loading ───────────────────────────── */
  .skeleton {
    background: linear-gradient(
      90deg,
      var(--surface-2) 25%,
      var(--surface-3) 50%,
      var(--surface-2) 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s ease-in-out infinite;
    border-radius: var(--radius-md);
  }

  /* ── Utility: Glass panel ───────────────────────────────── */
  .glass {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
  }
</style>
</write_to_file>