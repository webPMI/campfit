---
export type Language = 'es' | 'en';
const lang = Astro.params.lang || 'es';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>CampFit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen antialiased" style="font-family: 'Inter', sans-serif;">
    <script>
      // Apply theme immediately to prevent flash
      (function() {
        const theme = localStorage.getItem('campfit_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <div class="pb-20">
      <slot />
    </div>
  </body>
</html>

<!-- Firestore Debug System (Ctrl+Shift+D) -->
<script>
  import '@/lib/debug/firestoreDebug';
</script>

<style>
  @import "tailwindcss";

  @theme {
    --color-emerald-400: #34d399;
    --color-emerald-500: #10b981;
    --color-emerald-900: #064e3b;
  }

  /* ─── Dark mode (default) ──────────────────────────────────── */
  [data-theme="dark"] body {
    background: linear-gradient(to bottom right, #09090b, #18181b, #09090b);
    color: #f4f4f5;
  }
  [data-theme="dark"] ::-webkit-scrollbar-thumb { background: #27272a; }
  [data-theme="dark"] ::-webkit-scrollbar-thumb:hover { background: #3f3f46; }

  /* ─── Light mode ───────────────────────────────────────────── */
  [data-theme="light"] body {
    background: linear-gradient(to bottom right, #f4f4f5, #ffffff, #f4f4f5);
    color: #18181b;
  }
  [data-theme="light"] ::-webkit-scrollbar-thumb { background: #d4d4d8; }
  [data-theme="light"] ::-webkit-scrollbar-thumb:hover { background: #a1a1aa; }

  /* Animaciones personalizadas */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 20px rgba(52, 211, 153, 0.1); }
    50% { box-shadow: 0 0 30px rgba(52, 211, 153, 0.2); }
  }

  .animate-fade-in {
    animation: fadeIn 0.5s ease-out forwards;
  }

  .animate-fade-in-delay {
    animation: fadeIn 0.5s ease-out 0.2s forwards;
    opacity: 0;
  }

  .card-glow {
    animation: pulse-glow 3s ease-in-out infinite;
  }

  /* Scrollbar personalizada */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { }
</style>
