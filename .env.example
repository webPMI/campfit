# Firebase - Proyecto: mallorca-campfit
PUBLIC_FIREBASE_API_KEY=tu-firebase-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=tu-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu-sender-id
PUBLIC_FIREBASE_APP_ID=tu-app-id

# Cloudflare R2 Object Storage (S3 API Compatible)
R2_ACCOUNT_ID=tu-cloudflare-account-id-32-chars
R2_ACCESS_KEY_ID=tu-r2-access-key-id
R2_SECRET_ACCESS_KEY=tu-r2-secret-access-key
R2_BUCKET_NAME=campfit-storage
PUBLIC_R2_PUBLIC_DOMAIN=https://cdn.campfit.app
PUBLIC_R2_UPLOAD_URL=/api/storage/upload

# Monitoreo (opcional)
PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
PUBLIC_POSTHOG_KEY=phc_xxx
PUBLIC_POSTHOG_HOST=https://app.posthog.com